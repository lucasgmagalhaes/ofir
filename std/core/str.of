/**
 * @module
 * The methods of `str` (docs/std/strings.md).
 */

extern "C" {
    fn memcpy(dst: *mut u8, src: *u8, n: u64) *mut u8
    fn memcmp(a: *u8, b: *u8, n: u64) i32
    fn ofir_alloc(size: int) *mut u8
    fn ofir_realloc(p: *mut u8, size: int) *mut u8
    fn ofir_free(p: *mut u8)
    fn memchr(s: *u8, c: i32, n: u64) *u8
}

/**
 * An owned, growable UTF-8 string (spec 2.3).
 *
 * A literal points to read-only memory and has `cap == 0`; it is copied
 * to the heap on its first modification, so literals cost nothing until
 * then. `s[i]` is the byte at offset `i`, bounds checked, and `+` and
 * interpolation (`"{x}"`) build new strings. The compiler and the runtime
 * share the layout of the fields: `ptr`, `len`, `cap`.
 *
 * @example
 * ```ofir
 * let greeting = "hello"
 * greeting.push(", world")
 * println("{greeting.len()} {greeting.toUpper()}")   // 12 HELLO, WORLD
 * ```
 */
@lang("str")
@threadsafe
pub struct str {
    ptr: *u8
    len: int
    cap: int

    /**
     * An empty string; nothing is allocated.
     *
     * @returns `""`
     */
    pub fn new() str {
        return ""
    }

    /**
     * An empty string with room for `n` bytes, to avoid reallocations
     * when the final length is known.
     *
     * @param n the number of bytes to make room for
     * @returns `""`, with a capacity of at least `n`
     * @panics when the system is out of memory
     */
    pub fn withCapacity(n: int) str {
        let s = ""
        if n > 0 {
            s.reserve(n)
        }
        return s
    }

    /**
     * A string that takes over a buffer of `len` bytes of UTF-8 text: it
     * is freed when the string is dropped.
     *
     * @param ptr the first byte
     * @param len the number of bytes
     * @param cap the size of the buffer; with 0 the buffer is freed now
     * @returns the string
     * @safety `ptr` must come from `ofir_alloc` with room for `cap`
     * bytes (or be null), hold valid UTF-8, and nothing else may free it
     */
    pub unsafe fn fromParts(ptr: *mut u8, len: int, cap: int) str {
        if cap == 0 {
            ofir_free(ptr)
            return ""
        }
        let s = ""
        s.ptr = ptr as *u8
        s.len = len
        s.cap = cap
        return s
    }

    /**
     * A copy of `len` bytes of UTF-8 text, as from C.
     *
     * @param ptr the first byte
     * @param len the number of bytes
     * @returns the new string
     * @safety `ptr` must point to `len` readable bytes of valid UTF-8
     */
    pub unsafe fn fromRaw(ptr: *u8, len: int) str {
        let s = str.withCapacity(len)
        if len > 0 {
            memcpy(s.ptr as *mut u8, ptr, len as u64)
        }
        s.len = len
        return s
    }

    /**
     * The address of the first byte, for C functions that read the text.
     * It is not followed by a NUL.
     *
     * @returns the pointer; reading through it requires `unsafe`
     */
    pub fn asPtr(self) *u8 {
        return self.ptr
    }

    /**
     * A NUL-terminated copy of the text, for C functions that take a
     * `const char *` (spec 11.3).
     *
     * @returns the copy; `ptr()` gives its address
     * @panics when the text contains a NUL byte, which C would read as
     * the end of the string
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * extern "C" {
     *     fn strlen(s: *u8) int
     * }
     *
     * const c = "hello".toCString()
     * assert(unsafe { strlen(c.ptr()) } == 5)
     * ```
     */
    pub fn toCString(self) CString {
        let bytes = str.withCapacity(self.len + 1)
        for i in 0..self.len {
            if unsafe { *self.ptr.add(i) } == 0 {
                panic("toCString: the string contains a NUL byte at {i}")
            }
        }
        bytes.push(self)
        bytes.pushByte(0)
        return CString{bytes: bytes}
    }

    /**
     * The length in bytes, not in characters: `"é".len()` is 2.
     *
     * @returns the number of bytes
     */
    pub fn len(self) int {
        return self.len
    }

    /**
     * Whether the string has no bytes.
     *
     * @returns true for `""`
     */
    pub fn isEmpty(self) bool {
        return self.len == 0
    }

    /**
     * Appends a string at the end. The capacity doubles when it runs out,
     * so pushing in a loop takes amortized constant time per byte.
     *
     * @param t the string to append
     * @panics when the system is out of memory
     * @example
     * ```ofir
     * let s = "a"
     * s.push("bc")   // "abc"
     * ```
     */
    pub fn push(mut self, t: str) {
        if t.len == 0 {
            return
        }
        self.reserve(t.len)
        unsafe {
            memcpy(self.ptr.add(self.len) as *mut u8, t.ptr, t.len as u64)
        }
        self.len += t.len
    }

    /**
     * Appends a Unicode scalar value, encoded as UTF-8 (1 to 4 bytes).
     *
     * @param c the scalar value
     * @panics when `c` is above `0x10FFFF` or a surrogate (`0xD800` to
     * `0xDFFF`)
     * @example
     * ```ofir
     * let s = "caf"
     * s.pushChar(0xE9)   // "café", 5 bytes
     * ```
     */
    pub fn pushChar(mut self, c: u32) {
        if c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF) {
            panic("pushChar: {c} is not a Unicode scalar value")
        }
        if c < 0x80 {
            self.pushByte(c as u8)
        } else if c < 0x800 {
            self.pushByte((0xC0 | (c >> 6)) as u8)
            self.pushByte((0x80 | (c & 0x3F)) as u8)
        } else if c < 0x10000 {
            self.pushByte((0xE0 | (c >> 12)) as u8)
            self.pushByte((0x80 | ((c >> 6) & 0x3F)) as u8)
            self.pushByte((0x80 | (c & 0x3F)) as u8)
        } else {
            self.pushByte((0xF0 | (c >> 18)) as u8)
            self.pushByte((0x80 | ((c >> 12) & 0x3F)) as u8)
            self.pushByte((0x80 | ((c >> 6) & 0x3F)) as u8)
            self.pushByte((0x80 | (c & 0x3F)) as u8)
        }
    }

    /**
     * Empties the string. A heap buffer keeps its capacity, for reuse.
     */
    pub fn clear(mut self) {
        if self.cap == 0 {
            self.ptr = "".ptr
        }
        self.len = 0
    }

    /**
     * Whether the string begins with `prefix`.
     *
     * @param prefix the bytes to look for at the start
     * @returns true if the first bytes equal `prefix`; always for `""`
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * assert("main.of".startsWith("main"))
     * ```
     */
    pub fn startsWith(self, prefix: str) bool {
        return prefix.len <= self.len && sameBytes(self.ptr, prefix.ptr, prefix.len)
    }

    /**
     * Whether the string ends with `suffix`.
     *
     * @param suffix the bytes to look for at the end
     * @returns true if the last bytes equal `suffix`; always for `""`
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * assert("main.of".endsWith(".of"))
     * ```
     */
    pub fn endsWith(self, suffix: str) bool {
        if suffix.len > self.len {
            return false
        }
        const start = unsafe { self.ptr.add(self.len - suffix.len) }
        return sameBytes(start, suffix.ptr, suffix.len)
    }

    /**
     * Whether `part` occurs in the string, by a direct search: O(n * m).
     *
     * @param part the bytes to look for
     * @returns true if some substring equals `part`; always for `""`
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * assert("hello".contains("ell"))
     * ```
     */
    pub fn contains(self, part: str) bool {
        return findFrom(self, part, 0).isSome()
    }

    /**
     * The string repeated, in one allocation.
     *
     * @param n how many copies
     * @returns `n` copies one after the other; `""` when `n <= 0`
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * assert("ab".repeat(3) == "ababab")
     * ```
     */
    pub fn repeat(self, n: int) str {
        let out = ""
        if n > 0 && self.len > 0 {
            out.reserve(self.len * n)
        }
        for _ in 0..n {
            out.push(self)
        }
        return out
    }

    /**
     * A view of part of the string: `s[lo..hi]`. Nothing is copied: the
     * view has no capacity of its own, so modifying it copies it first.
     *
     * @param lo the offset of the first byte
     * @param hi the offset after the last byte
     * @returns the bytes `lo` to `hi - 1`
     * @panics unless `0 <= lo <= hi <= len()`, or when `lo` or `hi` is not
     * on a character boundary of the UTF-8 text
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * const s = "hello, world"
     * assert(s[0..5] == "hello")
     * ```
     */
    pub fn slice(self, lo: int, hi: int) str {
        checkRange(lo, hi, self.len)
        if !self.isBoundary(lo) || !self.isBoundary(hi) {
            boundaryPanic(lo, hi)
        }
        let view = ""
        view.ptr = unsafe { self.ptr.add(lo) }
        view.len = hi - lo
        return view
    }

    /**
     * A view of part of the string without the checks of `slice`.
     *
     * @param lo the offset of the first byte
     * @param hi the offset after the last byte
     * @returns the bytes `lo` to `hi - 1`
     * @safety `0 <= lo <= hi <= len()`, and `lo` and `hi` are on character
     * boundaries of the UTF-8 text
     */
    pub unsafe fn sliceUnchecked(self, lo: int, hi: int) str {
        let view = ""
        view.ptr = self.ptr.add(lo)
        view.len = hi - lo
        return view
    }

    /**
     * A view of the end of the string: `s[lo..]`.
     *
     * @param lo the offset of the first byte
     * @returns the bytes from `lo` to the end
     * @panics unless `0 <= lo <= len()` and `lo` is on a character boundary
     */
    pub fn sliceFrom(self, lo: int) str {
        return self.slice(lo, self.len)
    }

    /**
     * The offset of the first occurrence of `part`.
     *
     * @param part the bytes to look for
     * @returns `Some(offset)` of the first match, `None` when there is none;
     * `Some(0)` for `""`
     * @example
     * ```ofir
     * const at = "key=value".find("=") ?? -1   // 3
     * ```
     */
    pub fn find(self, part: str) Option<int> {
        return findFrom(self, part, 0)
    }

    /**
     * A view without the ASCII whitespace at both ends (space, `\t`, `\n`,
     * `\r`, form feed and vertical tab).
     *
     * @returns the trimmed bytes, borrowed from this string
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * assert("  hi \n".trim() == "hi")
     * ```
     */
    pub fn trim(self) str {
        return self.trimStart().trimEnd()
    }

    /**
     * A view without the ASCII whitespace at the start.
     *
     * @returns the trimmed bytes, borrowed from this string
     */
    pub fn trimStart(self) str {
        let lo = 0
        for lo < self.len && isSpace(self[lo]) {
            lo += 1
        }
        return self.sliceFrom(lo)
    }

    /**
     * A view without the ASCII whitespace at the end.
     *
     * @returns the trimmed bytes, borrowed from this string
     */
    pub fn trimEnd(self) str {
        let hi = self.len
        for hi > 0 && isSpace(self[hi - 1]) {
            hi -= 1
        }
        return self.slice(0, hi)
    }

    /**
     * A copy with every occurrence of `from` replaced by `to`, scanning
     * left to right without overlaps.
     *
     * @param from the bytes to replace; `""` replaces nothing
     * @param to the replacement
     * @returns the new string
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * assert("a-b-c".replace("-", ", ") == "a, b, c")
     * ```
     */
    pub fn replace(self, from: str, to: str) str {
        let out = ""
        let at = 0
        for from.len > 0 {
            const Option.Some(i) = findFrom(self, from, at) else {
                break
            }
            out.push(self.slice(at, i))
            out.push(to)
            at = i + from.len
        }
        out.push(self.sliceFrom(at))
        return out
    }

    /**
     * The parts between the occurrences of `sep`, as views of this string.
     * Separators next to each other give empty parts.
     *
     * @param sep the separator
     * @returns an iterator over the parts: one part `""` for `""`
     * @panics when `sep` is `""`
     * @example
     * ```ofir
     * for field in "a,b,,c".split(",") {
     *     println("[{field}]")   // [a] [b] [] [c]
     * }
     * ```
     */
    pub fn split(self, sep: str) StrSplit {
        return StrSplit.on(self, sep)
    }

    /**
     * The words: the parts between runs of ASCII whitespace, never empty.
     *
     * @returns an iterator over the words, as views of this string
     * @example
     * ```ofir
     * for word in "  to be  or\tnot ".splitWhitespace() {
     *     println(word)   // to, be, or, not
     * }
     * ```
     */
    pub fn splitWhitespace(self) StrSplit {
        return StrSplit.words(self)
    }

    /**
     * The lines: the parts between `\n`, without a `\r` at their end. A
     * final `\n` does not start another line.
     *
     * @returns an iterator over the lines, as views of this string
     * @example
     * ```ofir
     * for line in "one\r\ntwo\n".lines() {
     *     println(line)   // one, two
     * }
     * ```
     */
    pub fn lines(self) StrSplit {
        return StrSplit.lines(self)
    }

    /**
     * The bytes, in order.
     *
     * @returns an iterator over the bytes
     * @example
     * ```ofir
     * let sum = 0
     * for b in "abc".bytes() {
     *     sum += b as int   // 97 + 98 + 99
     * }
     * ```
     */
    pub fn bytes(self) StrBytes {
        return StrBytes.of(self)
    }

    /**
     * The Unicode scalar values, in order, decoded from the UTF-8 bytes.
     *
     * @returns an iterator over the characters
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * let count = 0
     * for c in "añb".chars() {
     *     count += 1
     * }
     * assert(count == 3 && "añb".len() == 4)
     * ```
     */
    pub fn chars(self) StrChars {
        return StrChars.of(self)
    }

    /**
     * A copy with the ASCII letters in lower case; other bytes, including
     * non-ASCII letters, are unchanged.
     *
     * @returns the new string
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * assert("Ofir 1.0".toLower() == "ofir 1.0")
     * ```
     */
    pub fn toLower(self) str {
        return self.mapAscii(b'A', b'Z')
    }

    /**
     * A copy with the ASCII letters in upper case; other bytes are
     * unchanged.
     *
     * @returns the new string
     */
    pub fn toUpper(self) str {
        return self.mapAscii(b'a', b'z')
    }

    /**
     * A copy on the heap, owned by the caller, also for a literal.
     *
     * @returns the new string
     */
    pub fn toOwned(self) str {
        let out = ""
        out.push(self)
        return out
    }

    /**
     * A copy on the heap, owned by the caller: the same as `toOwned`.
     *
     * @returns the new string
     */
    pub fn clone(self) str {
        return self.toOwned()
    }

    // Frees the heap buffer when the string is dropped (spec 5.2); a
    // literal or a view (`cap == 0`) has none.
    fn drop(mut self) {
        if self.cap > 0 {
            unsafe {
                ofir_free(self.ptr as *mut u8)
            }
        }
    }

    // Whether a character starts at byte `i` (or `i` is the end): UTF-8
    // continuation bytes are 0b10xxxxxx.
    fn isBoundary(self, i: int) bool {
        return i == self.len || unsafe { *self.ptr.add(i) } & 0xC0 != 0x80
    }

    fn pushByte(mut self, b: u8) {
        self.reserve(1)
        unsafe {
            *(self.ptr.add(self.len) as *mut u8) = b
        }
        self.len += 1
    }

    // Makes room for `extra` more bytes; a literal moves to the heap.
    fn reserve(mut self, extra: int) {
        const needed = self.len + extra
        if needed <= self.cap {
            return
        }
        let cap = if self.cap > 0 { self.cap * 2 } else { 16 }
        for cap < needed {
            cap *= 2
        }
        unsafe {
            if self.cap == 0 {
                const heap = ofir_alloc(cap)
                if self.len > 0 {
                    memcpy(heap, self.ptr, self.len as u64)
                }
                self.ptr = heap
            } else {
                self.ptr = ofir_realloc(self.ptr as *mut u8, cap)
            }
        }
        self.cap = cap
    }

    // A copy where the bytes in `from..=to` have their ASCII case flipped.
    fn mapAscii(self, from: u8, to: u8) str {
        let out = self.toOwned()
        for i in 0..out.len {
            unsafe {
                const at = out.ptr.add(i) as *mut u8
                if *at >= from && *at <= to {
                    *at = *at ^ 0x20
                }
            }
        }
        return out
    }
}

/**
 * An owned, NUL-terminated copy of a `str`, made by `s.toCString()`, to
 * pass text to C. It frees its buffer when dropped, so the pointer from
 * `ptr()` is valid only while the `CString` lives.
 */
pub struct CString {
    bytes: str   // the text followed by one NUL byte

    /**
     * The address of the first byte; the text ends with a NUL.
     *
     * @returns the pointer; reading through it requires `unsafe`
     */
    pub fn ptr(self) *u8 {
        return self.bytes.ptr
    }

    /**
     * The length in bytes, without the NUL.
     *
     * @returns the number of bytes C's `strlen` reports
     */
    pub fn len(self) int {
        return self.bytes.len - 1
    }
}

// Out of line, so that `slice` stays small enough to inline.
@cold
fn boundaryPanic(lo: int, hi: int) {
    panic("byte range {lo}..{hi} is not on character boundaries")
}

// Whether the `n` bytes at `a` and `b` are equal.
fn sameBytes(a: *u8, b: *u8, n: int) bool {
    return n == 0 || unsafe { memcmp(a, b, n as u64) } == 0
}

// `a == b` on strings: the lowering calls it (lower_ops.c, lower_expr.of).
fn strEq(a: str, b: str) bool {
    return a.len == b.len && sameBytes(a.ptr, b.ptr, a.len)
}

// The order of `a` and `b`: -1, 0 or 1. The lowering calls it for `<`,
// `<=`, `>` and `>=` on strings.
fn strCmp(a: str, b: str) i32 {
    const common = if a.len < b.len { a.len } else { b.len }
    const order: i32 = if common == 0 { 0 } else { unsafe { memcmp(a.ptr, b.ptr, common as u64) } }
    if order != 0 {
        return if order < 0 { -1 } else { 1 }
    }
    return if a.len < b.len { -1 } else if a.len > b.len { 1 } else { 0 }
}

// The offset of the first `part` at or after `from`, or None.
fn findFrom(text: str, part: str, from: int) Option<int> {
    if from > text.len - part.len {
        return Option.None
    }
    const at = unsafe { findBytes(text.ptr.add(from), text.len - from, part.ptr, part.len) }
    if at < 0 {
        return Option.None
    }
    return Option.Some(from + at)
}

// The offset of the first copy of the `n` bytes at `part` in the `len`
// bytes at `text`, or -1.
unsafe fn findBytes(text: *u8, len: int, part: *u8, n: int) int {
    if n == 0 {
        return 0
    }
    if n > len {
        return -1
    }
    const first = *part as i32
    const tail = n - 1
    const final = *part.add(tail)
    const start = text as uint
    const last = start + (len - n) as uint   // the last address a match can start at
    let at = text
    for at as uint <= last {
        const hit = memchr(at, first, (last - at as uint + 1) as u64)
        if hit as uint == 0 {
            return -1
        }
        // The last byte first: a cheap filter before memcmp.
        if *hit.add(tail) == final && sameBytes(hit.add(1), part.add(1), tail) {
            return (hit as uint - start) as int
        }
        at = hit.add(1)
    }
    return -1
}

// ASCII whitespace: space, \t, \n, vertical tab, form feed, \r.
fn isSpace(b: u8) bool {
    return b == b' ' || (b >= 9 && b <= 13)
}
