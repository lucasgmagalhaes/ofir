// The tests of `std.core.box` (spec 12.2): `ofir test std/core/box.of` runs them.

import std.testing.assert

@test
fn cloneCopiesTheValue() {
    const a = Box.new("text".toOwned())
    let b = a.clone()
    (*b).push("!")   // no automatic dereference inside std.core.box
    assert(*a == "text" && *b == "text!")
    assert(b.unbox() == "text!")
}
