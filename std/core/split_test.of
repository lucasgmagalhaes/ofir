// The tests of `std.core.split` (spec 12.2): `ofir test std/core/split.of` runs them.

import std.testing.assert

@test
fn splitKeepsEmptyParts() {
    let parts = "a,,b".split(",")
    assert((parts.next() ?? "?") == "a")
    assert((parts.next() ?? "?") == "")
    assert((parts.next() ?? "?") == "b")
    assert(parts.next().isNone())
}

@test
fn linesDropTheCarriageReturn() {
    let lines = "one\r\ntwo\n".lines()
    assert((lines.next() ?? "?") == "one")
    assert((lines.next() ?? "?") == "two")
    assert(lines.next().isNone())
    let words = "  a  bc ".splitWhitespace()
    assert((words.next() ?? "?") == "a" && (words.next() ?? "?") == "bc")
    assert(words.next().isNone())
}
