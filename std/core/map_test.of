// The tests of `std.core.map` (spec 12.2): `ofir test std/core/map.of` runs them.

import std.testing.assert

@test
fn insertReplacesAndReturnsTheOldValue() {
    let ages: Map<str, int> = Map.new()
    assert(ages.insert("ada".toOwned(), 36).isNone())
    assert(ages.insert("ada".toOwned(), 37).unwrapOr(0) == 36)
    assert(ages.len() == 1 && ages.contains("ada"))
    assert(*ages.get("ada").unwrap() == 37)
}

@test
fn removeKeepsTheOtherEntries() {
    let m: Map<int, int> = Map.new()
    for i in 0..100 {
        m.insert(i, i * i)
    }
    for i in 0..50 {
        assert(m.remove(i * 2).unwrapOr(-1) == i * i * 4)
    }
    assert(m.len() == 50 && !m.contains(10) && *m.get(11).unwrap() == 121)
    *m.getOrInsert(200, 0) += 5
    assert(*m.get(200).unwrap() == 5)
}

@test
fn seededMapsFindEveryKey() {
    let m: Map<str, int> = Map.seeded()
    for i in 0..500 {
        m.insert("key{i}", i)
    }
    for i in 0..250 {
        assert(m.remove("key{i * 2}").unwrapOr(-1) == i * 2)
    }
    assert(m.len() == 250 && !m.contains("key10") && *m.get("key11").unwrap() == 11)
    let twin = m.clone()
    twin.insert("new".toOwned(), 1)
    assert(twin.len() == 251 && *twin.get("key499").unwrap() == 499)
}

@test
fn seededMapsKeepTheInsertionOrder() {
    let m: Map<int, int> = Map.withSeed(0x5eed)
    for i in 0..20 {
        m.insert(19 - i, i)
    }
    let next = 19
    for key, value in m {
        assert(key == next && value == 19 - next)
        next -= 1
    }
}

@test
fn theSeedChangesTheHash() {
    assert(hashSeeded(1, 1) != hashSeeded(1, 2) && hashSeeded(1, 1) != hashSeeded(2, 1))
}
