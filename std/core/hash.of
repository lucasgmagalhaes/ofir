/**
 * @module
 * The hash functions of `Map` keys (ADR 0011, ADR 0034). The default ones
 * use a fixed key, so a program behaves the same on every run; a seeded
 * map mixes their results with its seed. The compiler calls them for the
 * `hashOf<K>` intrinsic of std/core/map.of; they are not public.
 */

// The fixed key of `hashStr`: the first 128 bits of pi's fraction.
const KEY0: u64 = 0x243f6a8885a308d3
const KEY1: u64 = 0x13198a2e03707344

// splitmix64's finalizer: every bit of `x` affects every bit of the result.
fn hashU64(x: u64) u64 {
    let z = x
    z = (z ^ (z >> 30)).wrappingMul(0xbf58476d1ce4e5b9)
    z = (z ^ (z >> 27)).wrappingMul(0x94d049bb133111eb)
    return z ^ (z >> 31)
}

// SipHash-1-3 over the bytes, with a fixed key: strings chosen to collide
// would have to collide in all 64 bits, which no known shortcut finds.
fn hashStr(s: str) u64 {
    let sip = Sip.new(KEY0, KEY1)
    const n = s.len()
    const whole = n - n % 8
    let i = 0
    for i < whole {
        let word: u64 = 0
        for b in 0..8 {
            word |= (s[i + b] as u64) << ((b * 8) as u64)
        }
        sip.compress(word)
        i += 8
    }
    let last = ((n & 255) as u64) << 56
    for b in 0..n - whole {
        last |= (s[whole + b] as u64) << ((b * 8) as u64)
    }
    sip.compress(last)
    return sip.finish()
}

// The hash of a tuple: each element's hash folded into the previous ones,
// in order, so that `(1, 2)` and `(2, 1)` differ.
fn hashCombine(h: u64, x: u64) u64 {
    return hashU64(h.wrappingMul(0x9e3779b97f4a7c15) ^ x)
}

/**
 * Mixes a hash with a seed: SipHash-1-3 of the one word `h`, keyed by
 * `seed`, so that without the seed the result cannot be told (ADR 0034).
 * `Map.seeded()` hashes its keys this way.
 *
 * @param h the hash of a value
 * @param seed the key, usually random
 * @returns the seeded hash
 */
@inline(never)
pub fn hashSeeded(h: u64, seed: u64) u64 {
    let sip = Sip.new(seed, hashU64(seed))
    sip.compress(h)
    sip.compress(8 << 56)
    return sip.finish()
}

// The state of SipHash (Aumasson and Bernstein, 2012).
struct Sip {
    v0: u64
    v1: u64
    v2: u64
    v3: u64

    fn new(k0: u64, k1: u64) Sip {
        return Sip{v0: k0 ^ 0x736f6d6570736575, v1: k1 ^ 0x646f72616e646f6d,
                   v2: k0 ^ 0x6c7967656e657261, v3: k1 ^ 0x7465646279746573}
    }

    // One word of the message, with one round.
    fn compress(mut self, m: u64) {
        self.v3 ^= m
        self.round()
        self.v0 ^= m
    }

    // Three rounds, then the state folded into 64 bits.
    fn finish(mut self) u64 {
        self.v2 ^= 255
        self.round()
        self.round()
        self.round()
        return self.v0 ^ self.v1 ^ self.v2 ^ self.v3
    }

    fn round(mut self) {
        self.v0 = self.v0.wrappingAdd(self.v1)
        self.v1 = rotl(self.v1, 13) ^ self.v0
        self.v0 = rotl(self.v0, 32)
        self.v2 = self.v2.wrappingAdd(self.v3)
        self.v3 = rotl(self.v3, 16) ^ self.v2
        self.v0 = self.v0.wrappingAdd(self.v3)
        self.v3 = rotl(self.v3, 21) ^ self.v0
        self.v2 = self.v2.wrappingAdd(self.v1)
        self.v1 = rotl(self.v1, 17) ^ self.v2
        self.v2 = rotl(self.v2, 32)
    }
}

fn rotl(x: u64, b: u64) u64 {
    return (x << b) | (x >> (64 - b))
}
