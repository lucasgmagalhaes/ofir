// The tests of `std.core.list` (spec 12.2): `ofir test std/core/list.of` runs them.

import std.testing.assert

@test
fn removeAndInsertShiftElements() {
    let l = [1, 2, 3, 4]
    assert(l.remove(1) == 2)
    l.insert(0, 9)
    assert(l.len() == 4 && l[0] == 9 && l[1] == 1 && l[3] == 4)
    assert(l.swapRemove(0) == 9 && l[0] == 4)
    l.sort()
    assert(l[0] == 1 && l[2] == 4)
}

@test
fn iterBorrowsEachElement() {
    const words = ["a", "bc", "def"]
    let total = 0
    let count = 0
    for w in words.iter() {
        total += w.len()
        count += 1
    }
    assert(count == 3 && total == 6)
    const empty: List<str> = []
    let it = empty.iter()
    assert(it.next().isNone())
}

@test
fn swapExchangesTwoElements() {
    let words = ["a".toOwned(), "b".toOwned(), "c".toOwned()]
    words.swap(0, 2)
    words.swap(1, 1)
    assert(words[0] == "c" && words[1] == "b" && words[2] == "a")
}
