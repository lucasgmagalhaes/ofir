/**
 * @module
 * `Box<T>`: an owned heap allocation (docs/std/collections.md).
 */

extern "C" {
    fn ofir_alloc(size: int) *mut u8
    fn ofir_alloc_aligned(size: int, align: int) *mut u8
    fn ofir_free(p: *mut u8)
}

extern "intrinsic" {
    // Drops the value at `p` in place: what the compiler runs at the end of
    // a value's scope (spec 5.2).
    fn dropInPlace<T>(p: *mut T)
    // Consumes a value without dropping it.
    fn forget<T>(value: move T)
    // What `value.clone()` does for any `T` (roadmap 3.3).
    fn cloneOf<T>(value: T) T
    // Appends the debug representation of `value` (`{x:?}`, spec 9.9).
    fn debugOf<T>(value: T, out: mut str)

    /**
     * The size in bytes of a value of type `T`, as laid out in memory
     * (spec 7.5, chapter 13): what an allocation for one `T` needs.
     *
     * @typeParam T the type to measure
     * @returns the size in bytes; 0 for `()`
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * assert(sizeOf<i32>() == 4)
     * assert(sizeOf<str>() == 24)
     * ```
     */
    pub fn sizeOf<T>() int

    /**
     * The alignment in bytes of a value of type `T` (spec 7.5, chapter 13):
     * what the address of an allocation for a `T` must be a multiple of.
     *
     * @typeParam T the type to measure
     * @returns a power of two; 1 for `()`
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * assert(alignOf<i32>() == 4)
     * assert(alignOf<str>() == 8)
     * ```
     */
    pub fn alignOf<T>() int
}

/**
 * A value of type `T` on the heap, owned by the box: the box itself is one
 * pointer.
 *
 * A type cannot contain itself by value (its size would be infinite), so
 * recursive types hold their children in boxes. `*b` reads the value, and
 * the fields and methods of the value are reached through the box:
 * `b.x`, `b.area()`, `b.x = 1` (the box must then be `let`). Methods of
 * `Box` itself (`unbox`) come first; `(*b).m()` calls the value's.
 *
 * Stage 0 frees a box only in `unbox`; drops come with roadmap 3.2.
 *
 * @typeParam T the type of the value
 * @example
 * ```ofir
 * import std.testing.assert
 *
 * enum Expr {
 *     Number(int)
 *     Add(Box<Expr>, Box<Expr>)
 * }
 *
 * fn eval(e: Expr) int {
 *     return match e {
 *         Expr.Number(n) => n
 *         Expr.Add(a, b) => eval(*a) + eval(*b)
 *     }
 * }
 *
 * const e = Expr.Add(Box.new(Expr.Number(2)), Box.new(Expr.Number(3)))
 * assert(eval(e) == 5)
 * ```
 */
@lang("box")
@threadsafe
pub struct Box<T> {
    ptr: *mut T

    /**
     * Moves a value to the heap.
     *
     * @param value the value to store
     * @returns a box that owns the value
     * @panics when the system is out of memory
     */
    pub fn new(value: move T) Box<T> {
        const ptr = unsafe {
            if alignOf<T>() > 16 {   // above malloc's alignment (spec 13.7)
                  ofir_alloc_aligned(sizeOf<T>(), alignOf<T>()) as *mut T
            } else {
                  ofir_alloc(sizeOf<T>()) as *mut T
            }
        }
        unsafe {
            *ptr = value
        }
        return Box{ptr}
    }

    /**
     * Moves the value out of the box and frees the heap memory.
     *
     * @returns the value the box held
     * @example
     * ```ofir
     * const b = Box.new("text")
     * const s = b.unbox()   // b can no longer be used
     * ```
     */
    pub fn unbox(move self) T {
        const value = unsafe { *self.ptr }
        unsafe {
            ofir_free(self.ptr as *mut u8)
        }
        forget(self)   // the value was moved out: dropping the box would drop it twice
        return value
    }

    /**
     * A new box holding a clone of this one's value.
     *
     * @returns a box that owns its own copy of the value
     * @example
     * ```ofir
     * const a = Box.new("text".toOwned())
     * const b = a.clone()   // a and b can both be used
     * ```
     */
    pub fn clone(self) Box<T> {
        return unsafe { Box.new(cloneOf(*self.ptr)) }
    }

    /**
     * Appends the debug representation of the value in the box: what
     * `{b:?}` shows (spec 9.9).
     *
     * @param out the string written to
     */
    pub fn debug(self, out: mut str) {
        unsafe {
            debugOf(*self.ptr, out)
        }
    }

    // Drops the value, then frees the memory (spec 5.2).
    fn drop(mut self) {
        unsafe {
            dropInPlace(self.ptr)
            ofir_free(self.ptr as *mut u8)
        }
    }
}
