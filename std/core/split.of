/**
 * @module
 * The iterators of `str`: `StrSplit` for `split`, `splitWhitespace` and
 * `lines`, `StrBytes` for `bytes`, `StrChars` for `chars`
 * (docs/std/strings.md).
 */

/**
 * The iterator of `split`, `splitWhitespace` and `lines`: each `next()`
 * returns the following part, as a view of the string, until `None`.
 *
 * @example
 * ```ofir
 * let parts = "x=1".split("=")
 * const key = parts.next() ?? ""   // "x"
 * ```
 */
pub struct StrSplit {
    rest: str     // the text not split yet
    sep: str
    words: bool   // splitWhitespace
    lines: bool   // lines: no `\r` at the end, no part after a final `\n`
    done: bool

    /**
     * The parts of `text` between the occurrences of `sep`: `text.split(sep)`.
     *
     * @param text the string to split
     * @param sep the separator
     * @returns the iterator
     * @panics when `sep` is `""`
     */
    pub fn on(text: str, sep: str) StrSplit {
        if sep.len() == 0 {
            panic("split: the separator is empty")
        }
        return StrSplit{rest: text.sliceFrom(0), sep: sep.sliceFrom(0), words: false,
                        lines: false, done: false}
    }

    /**
     * The words of `text`: `text.splitWhitespace()`.
     *
     * @param text the string to split
     * @returns the iterator
     */
    pub fn words(text: str) StrSplit {
        return StrSplit{rest: text.sliceFrom(0), sep: "", words: true, lines: false,
                        done: false}
    }

    /**
     * The lines of `text`: `text.lines()`.
     *
     * @param text the string to split
     * @returns the iterator
     */
    pub fn lines(text: str) StrSplit {
        return StrSplit{rest: text.sliceFrom(0), sep: "\n", words: false, lines: true,
                        done: text.len() == 0}
    }

    /**
     * The next part.
     *
     * @returns `Some(part)`, or `None` after the last one
     */
    pub fn next(mut self) Option<str> {
        if self.words {
            return self.nextWord()
        }
        if self.done {
            return Option.None
        }
        const Option.Some(i) = self.rest.find(self.sep) else {
            self.done = true
            return Option.Some(self.cut(self.rest.len()))
        }
        const part = self.cut(i)
        // A match of UTF-8 text in UTF-8 text starts and ends on boundaries.
        self.rest = unsafe { self.rest.sliceUnchecked(self.sep.len(), self.rest.len()) }
        self.done = self.lines && self.rest.len() == 0
        return Option.Some(part)
    }

    // The first `n` bytes of the rest, which keeps the bytes after them.
    fn cut(mut self, n: int) str {
        let hi = n
        if self.lines && hi > 0 && self.rest[hi - 1] == b'\r' {
            hi -= 1
        }
        // `n` is the end of the rest or the start of a match, and a `\r` is one byte.
        const part = unsafe { self.rest.sliceUnchecked(0, hi) }
        self.rest = unsafe { self.rest.sliceUnchecked(n, self.rest.len()) }
        return part
    }

    fn nextWord(mut self) Option<str> {
        let lo = 0
        for lo < self.rest.len() && isSpace(self.rest[lo]) {
            lo += 1
        }
        let hi = lo
        for hi < self.rest.len() && !isSpace(self.rest[hi]) {
            hi += 1
        }
        const word = self.rest.slice(lo, hi)
        self.rest = self.rest.sliceFrom(hi)
        if lo == hi {
            return Option.None
        }
        return Option.Some(word)
    }
}

/**
 * The iterator of `bytes`: each `next()` returns the following byte.
 */
pub struct StrBytes {
    text: str
    at: int

    /**
     * The bytes of `text`: `text.bytes()`.
     *
     * @param text the string
     * @returns the iterator
     */
    pub fn of(text: str) StrBytes {
        return StrBytes{text: text.sliceFrom(0), at: 0}
    }

    /**
     * The next byte.
     *
     * @returns `Some(byte)`, or `None` at the end
     */
    pub fn next(mut self) Option<u8> {
        if self.at >= self.text.len() {
            return Option.None
        }
        self.at += 1
        return Option.Some(self.text[self.at - 1])
    }
}

/**
 * The iterator of `chars`: each `next()` returns the following Unicode
 * scalar value, decoded from the UTF-8 bytes.
 *
 * @example
 * ```ofir
 * let count = 0
 * for c in "café".chars() {
 *     count += 1   // 4 characters, 5 bytes
 * }
 * ```
 */
pub struct StrChars {
    text: str
    at: int

    /**
     * The characters of `text`: `text.chars()`.
     *
     * @param text the string
     * @returns the iterator
     */
    pub fn of(text: str) StrChars {
        return StrChars{text: text.sliceFrom(0), at: 0}
    }

    /**
     * The next character. A `str` is always valid UTF-8, so the lead byte
     * gives the length of the sequence.
     *
     * @returns `Some(scalar)`, or `None` at the end
     */
    pub fn next(mut self) Option<u32> {
        if self.at >= self.text.len() {
            return Option.None
        }
        const lead = self.text[self.at] as u32
        let value = lead
        let extra = 0
        if lead >= 0xF0 {
            value = lead & 0x07
            extra = 3
        } else if lead >= 0xE0 {
            value = lead & 0x0F
            extra = 2
        } else if lead >= 0xC0 {
            value = lead & 0x1F
            extra = 1
        }
        self.at += 1
        for extra > 0 {
            value = (value << 6) | (self.text[self.at] as u32 & 0x3F)
            self.at += 1
            extra -= 1
        }
        return Option.Some(value)
    }
}

// ASCII whitespace: space, \t, \n, vertical tab, form feed, \r.
fn isSpace(b: u8) bool {
    return b == b' ' || (b >= 9 && b <= 13)
}
