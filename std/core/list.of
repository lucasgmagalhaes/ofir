/**
 * @module
 * `List<T>`: a growable array (docs/std/collections.md).
 *
 * The compiler builds list literals with `withCapacity` and `push`, `[]`
 * with `new` and `[x; n]` with `filled`, and reaches elements through
 * `ptr` and `len` (`@lang("list")` fixes this layout).
 */

extern "C" {
    fn ofir_alloc(size: int) *mut u8
    fn ofir_realloc(p: *mut u8, size: int) *mut u8
    fn ofir_alloc_aligned(size: int, align: int) *mut u8
    fn ofir_realloc_aligned(p: *mut u8, size: int, align: int) *mut u8
    fn ofir_free(p: *mut u8)
    fn memmove(dst: *mut u8, src: *u8, n: u64) *mut u8
}

extern "intrinsic" {
    fn dropInPlace<T>(p: *mut T)   // drops the value at `p` (spec 5.2)
    fn forget<T>(value: move T)    // consumes a value without dropping it
    fn cloneOf<T>(value: T) T     // what `value.clone()` does for any `T` (roadmap 3.3)
    // Appends the debug representation of `value` (`{x:?}`, spec 9.9).
    fn debugOf<T>(value: T, out: mut str)
}

/**
 * A growable array of values of type `T`, stored contiguously on the heap.
 *
 * Literals: `[1, 2, 3]`, `[0; 16]` (16 zeros), `[]` (type from the
 * context). `l[i]` reads or writes element `i` and panics outside
 * `0..l.len()`; `for x in l` visits the elements in order (stage 0: they
 * must be Copy). Pushing doubles the capacity when it runs out, so it
 * takes amortized constant time.
 *
 * @typeParam T the type of the elements
 * @example
 * ```ofir
 * let scores = [70, 95, 82]
 * scores.push(64)
 * scores.sort()
 * println("{scores[0]} {scores[scores.len() - 1]}")   // 64 95
 * ```
 */
@lang("list")
@threadsafe
pub struct List<T> {
    ptr: *mut T
    len: int
    cap: int

    /**
     * An empty list; nothing is allocated until the first push.
     *
     * @returns a list of length 0
     * @complexity O(1)
     */
    pub fn new() List<T> {
        return List{ptr: unsafe { 0 as *mut T }, len: 0, cap: 0}
    }

    /**
     * Takes over a buffer of `len` initialized elements: the list frees it
     * when it is dropped.
     *
     * @param ptr the first element
     * @param len the number of elements
     * @param cap the number of elements the buffer can hold
     * @returns the list
     * @safety `ptr` must come from `ofir_alloc` with room for `cap`
     * elements (or be null with `cap == 0`), and nothing else may free it
     * @complexity O(1)
     */
    pub unsafe fn fromParts(ptr: *mut T, len: int, cap: int) List<T> {
        return List{ptr, len, cap}
    }

    /**
     * An empty list with room for `n` elements, to avoid reallocations
     * when the final length is known.
     *
     * @param n the number of elements to make room for
     * @returns a list of length 0 and capacity at least `n`
     * @panics when the system is out of memory
     * @complexity O(1); allocates `capacity` elements
     */
    pub fn withCapacity(n: int) List<T> {
        let list: List<T> = List.new()
        list.reserve(n)
        return list
    }

    /**
     * A list of copies of one value: the literal `[value; count]`, which
     * requires a Copy value.
     *
     * @param value the element to repeat
     * @param count the length of the list
     * @returns a list of `count` elements equal to `value`
     * @panics when the system is out of memory
     * @complexity O(n)
     */
    pub fn filled(value: T, count: int) List<T> {
        let list: List<T> = List.withCapacity(count)
        for i in 0..count {
            unsafe {
                *list.ptr.add(i) = *(&value as *T)   // a copy: the literal needs Copy values
            }
        }
        list.len = count
        return list
    }

    /**
     * The number of elements.
     *
     * @returns the length
     * @complexity O(1)
     */
    pub fn len(self) int {
        return self.len
    }

    /**
     * Whether the list has no elements.
     *
     * @returns true when the length is 0
     * @complexity O(1)
     */
    pub fn isEmpty(self) bool {
        return self.len == 0
    }

    /**
     * How many elements fit before the next reallocation.
     *
     * @returns the capacity, at least the length
     * @complexity O(1)
     */
    pub fn capacity(self) int {
        return self.cap
    }

    /**
     * Makes room for more elements. The capacity at least doubles, so
     * repeated pushes reallocate O(log n) times.
     *
     * @param extra how many more elements must fit
     * @panics with "capacity overflow" when the size does not fit an `int`, or out of memory
     * @complexity O(n) when it grows, else O(1)
     */
    pub fn reserve(mut self, extra: int) {
        const needed = match self.len.checkedAdd(extra) {
            Option.Some(n) => n
            Option.None => panic("capacity overflow")
        }
        if needed <= self.cap {
            return
        }
        let cap = if self.cap == 0 { 4 } else { self.cap * 2 }
        if cap < needed {
            cap = needed
        }
        const size = match cap.checkedMul(sizeOf<T>()) {
            Option.Some(n) => n
            Option.None => panic("capacity overflow")
        }
        unsafe {
            const old = self.ptr as *mut u8
            self.ptr = if alignOf<T>() > 16 {   // above malloc's alignment (spec 13.7)
                ofir_realloc_aligned(old, size, alignOf<T>()) as *mut T
            } else {
                ofir_realloc(old, size) as *mut T
            }
        }
        self.cap = cap
    }

    /**
     * Appends an element at the end, in amortized constant time.
     *
     * @param x the element; the list takes ownership of it
     * @panics when the system is out of memory
     * @complexity O(1) amortized; O(n) when it grows
     * @example
     * ```ofir
     * let xs: List<int> = []
     * xs.push(1)   // [1]
     * ```
     */
    pub fn push(mut self, x: move T) {
        if self.len == self.cap {
            self.reserve(1)
        }
        unsafe {
            *self.ptr.add(self.len) = x
        }
        self.len += 1
    }

    /**
     * A borrow of an element, without panicking: the safe form of `l[i]`.
     *
     * @param i the position
     * @returns `Some` with a reference to element `i`, or `None` outside
     * `0..len()`
     * @complexity O(1)
     * @example
     * ```ofir
     * const xs = [10, 20]
     * if const Option.Some(x) = xs.get(1) {
     *     println("{x}")   // 20
     * }
     * ```
     */
    pub fn get(self, i: int) Option<&T> {
        if i < 0 || i >= self.len {
            return Option.None
        }
        return Option.Some(unsafe { &*self.ptr.add(i) })
    }

    /**
     * A mutable borrow of an element, without panicking.
     *
     * @param i the position
     * @returns `Some` with a mutable reference to element `i`, or `None`
     * outside `0..len()`
     * @complexity O(1)
     * @example
     * ```ofir
     * let xs = [1, 2]
     * if const Option.Some(x) = xs.getMut(0) {
     *     *x = 10   // xs is [10, 2]
     * }
     * ```
     */
    pub fn getMut(mut self, i: int) Option<&mut T> {
        if i < 0 || i >= self.len {
            return Option.None
        }
        return Option.Some(unsafe { &mut *self.ptr.add(i) })
    }

    /**
     * A borrow of the first element.
     *
     * @returns `Some` with a reference to it, or `None` for an empty list
     * @complexity O(1)
     */
    pub fn first(self) Option<&T> {
        return self.get(0)
    }

    /**
     * A borrow of the last element.
     *
     * @returns `Some` with a reference to it, or `None` for an empty list
     * @complexity O(1)
     */
    pub fn last(self) Option<&T> {
        return self.get(self.len - 1)
    }

    /**
     * A view of all the elements. A list is converted to a slice where
     * one is expected, so this is rarely written.
     *
     * @returns a slice of the whole list
     * @complexity O(1)
     */
    pub fn asSlice(self) &[T] {
        return unsafe { Slice.fromRaw(self.ptr, self.len) }
    }

    /**
     * A mutable view of all the elements. `&mut list` is converted to a
     * `&mut [T]` where one is expected, so this is rarely written.
     *
     * @returns a mutable slice of the whole list
     * @complexity O(1)
     */
    pub fn asMutSlice(mut self) SliceMut<T> {
        return unsafe { SliceMut.fromRaw(self.ptr, self.len) }
    }

    /**
     * An iterator over borrows of the elements, in order. Unlike
     * `for x in l`, it works for elements that are not Copy.
     *
     * @returns a `ListIter` that borrows the list
     * @complexity O(1)
     * @example
     * ```ofir
     * const names = ["ana", "bia"]
     * for name in names.iter() {
     *     println(name)
     * }
     * ```
     */
    pub fn iter(self) ListIter<T> {
        return ListIter{list: &self, index: 0}
    }

    /**
     * An iterator that moves the elements out, first to last, and leaves
     * the list empty: `for x in list.drain()` consumes the elements and
     * keeps the buffer. The elements the loop does not reach are dropped
     * with the iterator.
     *
     * @returns a `Drain` that borrows the list mutably
     * @complexity O(1); the walk is O(n)
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * let names = ["ana".toOwned(), "bia".toOwned()]
     * let kept: List<str> = []
     * for name in names.drain() {
     *     kept.push(name)
     * }
     * assert(names.isEmpty() && kept.len() == 2)
     * ```
     */
    pub fn drain(mut self) Drain<T> {
        return Drain{list: &mut self, index: 0}
    }

    /**
     * A view of part of the list: `l[lo..hi]`.
     *
     * @param lo the first position
     * @param hi the position after the last one
     * @returns the elements `lo` to `hi - 1`
     * @panics unless `0 <= lo <= hi <= len()`
     * @complexity O(1)
     * @example
     * ```ofir
     * const xs = [10, 20, 30, 40]
     * const middle = xs[1..3]   // [20, 30]
     * ```
     */
    pub fn slice(self, lo: int, hi: int) &[T] {
        checkRange(lo, hi, self.len)
        return unsafe { Slice.fromRaw(self.ptr.add(lo), hi - lo) }
    }

    /**
     * A view of the end of the list: `l[lo..]`.
     *
     * @param lo the first position
     * @returns the elements from `lo` to the end
     * @panics unless `0 <= lo <= len()`
     * @complexity O(1)
     */
    pub fn sliceFrom(self, lo: int) &[T] {
        return self.slice(lo, self.len)
    }

    /**
     * A mutable view of part of the list: `&mut l[lo..hi]`. The list cannot
     * grow or shrink while the view is used.
     *
     * @param lo the first position
     * @param hi the position after the last one
     * @returns the elements `lo` to `hi - 1`
     * @panics unless `0 <= lo <= hi <= len()`
     * @complexity O(1)
     */
    pub fn sliceMut(mut self, lo: int, hi: int) SliceMut<T> {
        checkRange(lo, hi, self.len)
        return unsafe { SliceMut.fromRaw(self.ptr.add(lo), hi - lo) }
    }

    /**
     * A mutable view of the end of the list: `&mut l[lo..]`.
     *
     * @param lo the first position
     * @returns the elements from `lo` to the end
     * @panics unless `0 <= lo <= len()`
     * @complexity O(1)
     */
    pub fn sliceFromMut(mut self, lo: int) SliceMut<T> {
        return self.sliceMut(lo, self.len)
    }

    /**
     * Removes the last element, in constant time.
     *
     * @returns `Some` with the last element, or `None` for an empty list
     * @complexity O(1)
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * let stack = [1, 2]
     * assert((stack.pop() ?? 0) == 2)
     * ```
     */
    pub fn pop(mut self) Option<T> {
        if self.len == 0 {
            return Option.None
        }
        self.len -= 1
        return Option.Some(unsafe { *self.ptr.add(self.len) })
    }

    /**
     * Inserts an element at a position, shifting the later ones: O(n).
     *
     * @param i the position of the new element, from 0 to `len()`
     * @param x the element; the list takes ownership of it
     * @panics when `i` is negative or greater than `len()`
     * @complexity O(n - i): shifts the later elements
     * @example
     * ```ofir
     * let xs = ["b", "c"]
     * xs.insert(0, "a")   // ["a", "b", "c"]
     * ```
     */
    pub fn insert(mut self, i: int, x: move T) {
        if i < 0 || i > self.len {
            panic("insertion index {i} is out of bounds for a list of length {self.len}")
        }
        self.reserve(1)
        unsafe {
            shift(self.ptr.add(i + 1), self.ptr.add(i), self.len - i)
            *self.ptr.add(i) = x
        }
        self.len += 1
    }

    /**
     * Removes the element at a position, shifting the later ones to keep
     * the order: O(n). `swapRemove` is O(1).
     *
     * @param i the position, in `0..len()`
     * @returns the removed element
     * @panics when `i` is outside `0..len()`
     * @complexity O(n - i): shifts the later elements
     */
    pub fn remove(mut self, i: int) T {
        self.checkIndex(i)
        const x = unsafe { *self.ptr.add(i) }
        unsafe {
            shift(self.ptr.add(i), self.ptr.add(i + 1), self.len - i - 1)
        }
        self.len -= 1
        return x
    }

    /**
     * Removes the element at a position and moves the last element into
     * its place: O(1), but the order changes.
     *
     * @param i the position, in `0..len()`
     * @returns the removed element
     * @panics when `i` is outside `0..len()`
     * @complexity O(1)
     */
    pub fn swapRemove(mut self, i: int) T {
        self.checkIndex(i)
        unsafe {
            const x = *self.ptr.add(i)
            *self.ptr.add(i) = *self.ptr.add(self.len - 1)
            self.len -= 1
            return x
        }
    }

    /**
     * Exchanges two elements, in constant time.
     *
     * @param i the position of one element
     * @param j the position of the other; it may equal `i`
     * @panics when `i` or `j` is outside `0..len()`
     * @complexity O(1)
     * @example
     * ```ofir
     * let xs = ["a", "b", "c"]
     * xs.swap(0, 2)   // ["c", "b", "a"]
     * ```
     */
    pub fn swap(mut self, i: int, j: int) {
        self.checkIndex(i)
        self.checkIndex(j)
        unsafe {
            const x = *self.ptr.add(i)
            *self.ptr.add(i) = *self.ptr.add(j)
            *self.ptr.add(j) = x
        }
    }

    /**
     * Removes every element; the capacity is kept for reuse.
     * @complexity O(n), to drop the elements
     */
    pub fn clear(mut self) {
        self.truncate(0)
    }

    /**
     * A new list with a clone of each element, in the same order.
     *
     * @returns a list of the same length, which owns its elements
     * @complexity O(n)
     * @example
     * ```ofir
     * import std.testing.assert
     *
     * const names = ["ada".toOwned(), "alan".toOwned()]
     * let more = names.clone()
     * more.push("grace".toOwned())
     * assert(names.len() == 2 && more.len() == 3)
     * ```
     */
    pub fn clone(self) List<T> {
        let out: List<T> = List.withCapacity(self.len)
        for i in 0..self.len {
            unsafe {
                out.push(cloneOf(*self.ptr.add(i)))
            }
        }
        return out
    }

    /**
     * Appends the debug representation of the list, `[1, 2, 3]`: what
     * `{list:?}` shows (spec 9.9).
     *
     * @param out the string written to
     * @complexity O(n)
     */
    pub fn debug(self, out: mut str) {
        out.push("[")
        for i in 0..self.len {
            if i > 0 {
                out.push(", ")
            }
            unsafe {
                debugOf(*self.ptr.add(i), out)
            }
        }
        out.push("]")
    }

    /**
     * Shortens the list to its first elements; a longer `n` changes
     * nothing.
     *
     * @param n the number of elements to keep
     * @complexity O(n - len), to drop the elements removed
     */
    pub fn truncate(mut self, n: int) {
        for self.len > n && self.len > 0 {   // the dropped elements, last first
            self.len -= 1
            unsafe {
                dropInPlace(self.ptr.add(self.len))
            }
        }
    }

    /**
     * Moves all the elements of another list to the end of this one.
     *
     * @param other the list to empty into this one; it is consumed
     * @panics when the system is out of memory
     * @complexity O(m) amortized, for `m` new elements
     * @example
     * ```ofir
     * let xs = [1, 2]
     * xs.extend([3, 4])   // [1, 2, 3, 4]
     * ```
     */
    pub fn extend(mut self, other: move List<T>) {
        self.reserve(other.len)
        unsafe {
            shift(self.ptr.add(self.len), other.ptr, other.len)
            if other.cap > 0 {
                ofir_free(other.ptr as *mut u8)
            }
        }
        self.len += other.len
        forget(other)   // its elements were moved here
    }

    /**
     * Reverses the order of the elements, in place.
     * @complexity O(n)
     */
    pub fn reverse(mut self) {
        let i = 0
        let j = self.len - 1
        for i < j {
            unsafe {
                const a = *self.ptr.add(i)
                *self.ptr.add(i) = *self.ptr.add(j)
                *self.ptr.add(j) = a
            }
            i += 1
            j -= 1
        }
    }

    /**
     * Sorts the elements in ascending order. The sort is stable (equal
     * elements keep their order) and takes O(n log n) time: a bottom-up
     * merge sort through one temporary buffer.
     *
     * The elements must be ordered (`T: Ord`, spec 8.1); stage 0 orders
     * int, float and str.
     *
     * @panics when the system is out of memory
     * @complexity O(n log n), stable; allocates one buffer of n elements
     * @example
     * ```ofir
     * let names = ["mia", "ana", "bob"]
     * names.sort()   // ["ana", "bob", "mia"]
     * ```
     */
    pub fn sort(mut self) where T: Ord {
        if self.len < 2 {
            return
        }
        let src = self.ptr
        const size = self.len * sizeOf<T>()
        let dst = unsafe {
            if alignOf<T>() > 16 {
                ofir_alloc_aligned(size, alignOf<T>()) as *mut T
            } else {
                ofir_alloc(size) as *mut T
            }
        }
        let lo = 0
        for lo < self.len {   // short runs first: insertion sort is cheaper there
            const hi = (lo + SORT_RUN).min(self.len)
            insertionSort(src, dst, lo, hi)
            lo = hi
        }
        let width = SORT_RUN
        for width < self.len {
            let lo = 0
            for lo < self.len {
                const mid = (lo + width).min(self.len)
                const hi = (lo + 2 * width).min(self.len)
                mergeRuns(src, dst, lo, mid, hi)
                lo = hi
            }
            const done = src
            src = dst
            dst = done
            width *= 2
        }
        if src != self.ptr {   // the sorted run is in the buffer
            unsafe {
                shift(self.ptr, src, self.len)
            }
            dst = src
        }
        unsafe {
            ofir_free(dst as *mut u8)
        }
    }

    // Drops the elements, then frees the buffer (spec 5.2).
    fn drop(mut self) {
        self.truncate(0)
        if self.cap > 0 {
            unsafe {
                ofir_free(self.ptr as *mut u8)
            }
        }
    }

    fn checkIndex(self, i: int) {
        if i < 0 || i >= self.len {
            panic("index out of bounds: the length is {self.len} but the index is {i}")
        }
    }
}

/**
 * An iterator over borrows of the elements of a list (`List.iter`). It
 * borrows the list, so the list cannot change while it is in use.
 *
 * @typeParam T the type of the elements
 */
pub ref struct ListIter<T> {
    list: &List<T>
    index: int

    /**
     * The next element.
     *
     * @returns `Some` with a reference to it, or `None` after the last one
     * @complexity O(1)
     */
    pub fn next(mut self) Option<&T> {
        const item = self.list.get(self.index)
        self.index += 1
        return item
    }
}

/**
 * An iterator that moves the elements out of a list (`List.drain`).
 *
 * @typeParam T the type of the elements
 */
pub ref struct Drain<T> {
    list: &mut List<T>
    index: int

    /**
     * The next element, moved out of the list.
     *
     * @returns `Some` with the element, or `None` after the last one
     * @complexity O(1)
     */
    pub fn next(mut self) Option<T> {
        if self.index >= self.list.len {
            return Option.None
        }
        self.index += 1
        return Option.Some(unsafe { *self.list.ptr.add(self.index - 1) })
    }

    // The elements not moved out are dropped, last first; the list is empty.
    fn drop(mut self) {
        for self.list.len > self.index {
            self.list.len -= 1
            unsafe {
                dropInPlace(self.list.ptr.add(self.list.len))
            }
        }
        self.list.len = 0
    }
}

// Moves `count` elements from `src` to `dst`; the ranges may overlap.
unsafe fn shift<T>(dst: *mut T, src: *T, count: int) {
    if count > 0 {
        memmove(dst as *mut u8, src as *u8, (count * sizeOf<T>()) as u64)
    }
}

// The length of the runs that `sort` orders by insertion before merging.
const SORT_RUN = 16

// Sorts p[lo..hi] in place by insertion; `scratch[i]` holds the element
// being placed. Equal elements keep their order.
fn insertionSort<T: Ord>(p: *mut T, scratch: *mut T, lo: int, hi: int) {
    for i in lo + 1..hi {
        unsafe {
            if *p.add(i) < *p.add(i - 1) {
                shift(scratch.add(i), p.add(i), 1)
                let j = i - 1
                for j > lo && *scratch.add(i) < *p.add(j - 1) {
                    j -= 1
                }
                shift(p.add(j + 1), p.add(j), i - j)
                shift(p.add(j), scratch.add(i), 1)
            }
        }
    }
}

// Merges the sorted runs src[lo..mid] and src[mid..hi] into dst[lo..hi];
// on ties the left run comes first, so the sort is stable.
fn mergeRuns<T: Ord>(src: *mut T, dst: *mut T, lo: int, mid: int, hi: int) {
    unsafe {
        if mid >= hi || !(*src.add(mid) < *src.add(mid - 1)) {   // already in order
            shift(dst.add(lo), src.add(lo), hi - lo)
            return
        }
    }
    let i = lo
    let j = mid
    let k = lo
    for i < mid && j < hi {
        unsafe {
            if *src.add(j) < *src.add(i) {
                shift(dst.add(k), src.add(j), 1)
                j += 1
            } else {
                shift(dst.add(k), src.add(i), 1)
                i += 1
            }
        }
        k += 1
    }
    unsafe {
        shift(dst.add(k), src.add(i), mid - i)
        shift(dst.add(k + mid - i), src.add(j), hi - j)
    }
}
