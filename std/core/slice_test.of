// The tests of `std.core.slice` (spec 12.2): `ofir test std/core/slice.of` runs them.

import std.testing.assert

@test
fn slicesViewPartOfAList() {
    const items = [1, 2, 3, 4, 5]
    const middle = items[1..4]
    assert(middle.len() == 3 && *middle.first().unwrap() == 2 && *middle.last().unwrap() == 4)
    assert(middle.get(3).isNone())
    assert(middle.sliceFrom(2).len() == 1)
}
