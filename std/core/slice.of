/**
 * @module
 * `&[T]`: a borrowed view of a contiguous sequence (spec 2.12).
 */

extern "intrinsic" {
    // Appends the debug representation of `value` (`{x:?}`, spec 9.9).
    fn debugOf<T>(value: T, out: mut str)
}

/**
 * A read-only view of consecutive elements of type `T`, written `&[T]`
 * (and `[T]` for a parameter): a pointer and a length.
 *
 * A slice borrows the list (or other sequence) it views, so it is a
 * reference and follows the rules of references: it cannot be stored in a
 * struct or a container (E0702). `xs[a..b]` takes a slice of a list or of
 * another slice, and a `List<T>` is accepted where a `&[T]` is expected.
 * `s[i]` and `for x in s` read the elements.
 *
 * @typeParam T the type of the elements
 * @example
 * ```ofir
 * fn sum(xs: [int]) int {
 *     let total = 0
 *     for x in xs {
 *         total += x
 *     }
 *     return total
 * }
 *
 * const numbers = [1, 2, 3, 4, 5]
 * println("{sum(numbers)} {sum(numbers[1..3])}")   // 15 5
 * ```
 */
@lang("slice")
pub ref struct Slice<T> {
    ptr: *T
    len: int

    /**
     * A slice of `len` elements starting at `ptr`.
     *
     * @param ptr the first element
     * @param len the number of elements
     * @returns the view
     * @safety `ptr` must point to `len` initialized elements that stay
     * valid and unmodified while the slice is used
     */
    pub unsafe fn fromRaw(ptr: *T, len: int) &[T] {
        return Slice{ptr, len}
    }

    /**
     * The address of the first element, for C functions that read the
     * elements (spec 11).
     *
     * @returns the pointer; reading through it requires `unsafe`
     */
    pub fn asPtr(self) *T {
        return self.ptr
    }

    /**
     * The number of elements.
     *
     * @returns the length
     */
    pub fn len(self) int {
        return self.len
    }

    /**
     * Whether the slice has no elements.
     *
     * @returns true when the length is 0
     */
    pub fn isEmpty(self) bool {
        return self.len == 0
    }

    /**
     * A borrow of an element, without panicking.
     *
     * @param i the position
     * @returns `Some` with a reference to element `i`, or `None` outside
     * `0..len()`
     */
    pub fn get(self, i: int) Option<&T> {
        if i < 0 || i >= self.len {
            return Option.None
        }
        return Option.Some(unsafe { &*self.ptr.add(i) })
    }

    /**
     * A borrow of the first element.
     *
     * @returns `Some` with a reference to it, or `None` for an empty slice
     */
    pub fn first(self) Option<&T> {
        return self.get(0)
    }

    /**
     * A borrow of the last element.
     *
     * @returns `Some` with a reference to it, or `None` for an empty slice
     */
    pub fn last(self) Option<&T> {
        return self.get(self.len - 1)
    }

    /**
     * A view of part of the slice: `s[lo..hi]`.
     *
     * @param lo the first position
     * @param hi the position after the last one
     * @returns the elements `lo` to `hi - 1`
     * @panics unless `0 <= lo <= hi <= len()`
     */
    pub fn slice(self, lo: int, hi: int) &[T] {
        checkRange(lo, hi, self.len)
        return unsafe { Slice.fromRaw(self.ptr.add(lo), hi - lo) }
    }

    /**
     * A view of the end of the slice: `s[lo..]`.
     *
     * @param lo the first position
     * @returns the elements from `lo` to the end
     * @panics unless `0 <= lo <= len()`
     */
    pub fn sliceFrom(self, lo: int) &[T] {
        return self.slice(lo, self.len)
    }

    /**
     * Appends the debug representation of the slice, `{s:?}`: its
     * elements in brackets, like a list.
     *
     * @param out the string written to
     */
    pub fn debug(self, out: mut str) {
        out.push("[")
        for i in 0..self.len {
            if i > 0 {
                out.push(", ")
            }
            unsafe {
                debugOf(*self.ptr.add(i), out)
            }
        }
        out.push("]")
    }
}

/**
 * Checks the bounds of a range of a sequence of length `len`.
 *
 * @param lo the first position
 * @param hi the position after the last one
 * @param len the length of the sequence
 * @panics unless `0 <= lo <= hi <= len`
 */
pub fn checkRange(lo: int, hi: int, len: int) {
    if lo < 0 || lo > hi || hi > len {
        rangePanic(lo, hi, len)
    }
}

// Out of line, so that checkRange stays small enough to inline.
@cold
fn rangePanic(lo: int, hi: int, len: int) {
    panic("range {lo}..{hi} is out of bounds for a length of {len}")
}

/**
 * Whether two slices hold equal elements in the same order: `a == b` on
 * slices and arrays (spec 9.9) calls it.
 *
 * @param a the left slice
 * @param b the right slice
 * @returns true if they have the same length and equal elements
 */
pub fn sliceEqual<T: Eq>(a: &[T], b: &[T]) bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

/**
 * A mutable view of consecutive elements of type `T`, written `&mut [T]`:
 * a pointer and a length. `&mut list` and `&mut array` convert to it, and
 * `s[i] = v` writes through it.
 *
 * Like `&mut T`, it borrows the sequence exclusively while it is used.
 *
 * @typeParam T the type of the elements
 * @example
 * ```ofir
 * fn fill(xs: &mut [int], v: int) {
 *     for i in 0..xs.len() {
 *         xs[i] = v
 *     }
 * }
 * ```
 */
@lang("slice_mut")
pub ref struct SliceMut<T> {
    ptr: *mut T
    len: int

    /**
     * A mutable slice of `len` elements starting at `ptr`.
     *
     * @param ptr the first element
     * @param len the number of elements
     * @returns the view
     * @safety `ptr` must point to `len` initialized elements that nothing
     * else reads or writes while the slice is used
     */
    pub unsafe fn fromRaw(ptr: *mut T, len: int) SliceMut<T> {
        return SliceMut{ptr, len}
    }

    /**
     * The number of elements.
     *
     * @returns the length
     */
    pub fn len(self) int {
        return self.len
    }

    /**
     * Whether the slice has no elements.
     *
     * @returns true when the length is 0
     */
    pub fn isEmpty(self) bool {
        return self.len == 0
    }

    /**
     * A read-only view of all the elements.
     *
     * @returns the elements as a `&[T]`
     */
    pub fn asSlice(self) &[T] {
        return unsafe { Slice.fromRaw(self.ptr, self.len) }
    }

    /**
     * A read-only view of part of the slice: `s[lo..hi]`.
     *
     * @param lo the first position
     * @param hi the position after the last one
     * @returns the elements `lo` to `hi - 1`
     * @panics unless `0 <= lo <= hi <= len()`
     */
    pub fn slice(self, lo: int, hi: int) &[T] {
        checkRange(lo, hi, self.len)
        return unsafe { Slice.fromRaw(self.ptr.add(lo), hi - lo) }
    }

    /**
     * A read-only view of the end of the slice: `s[lo..]`.
     *
     * @param lo the first position
     * @returns the elements from `lo` to the end
     * @panics unless `0 <= lo <= len()`
     */
    pub fn sliceFrom(self, lo: int) &[T] {
        return self.slice(lo, self.len)
    }

    /**
     * A mutable view of part of the slice: `&mut s[lo..hi]`.
     *
     * @param lo the first position
     * @param hi the position after the last one
     * @returns the elements `lo` to `hi - 1`
     * @panics unless `0 <= lo <= hi <= len()`
     */
    pub fn sliceMut(self, lo: int, hi: int) SliceMut<T> {
        checkRange(lo, hi, self.len)
        return unsafe { SliceMut.fromRaw(self.ptr.add(lo), hi - lo) }
    }

    /**
     * A mutable view of the end of the slice: `&mut s[lo..]`.
     *
     * @param lo the first position
     * @returns the elements from `lo` to the end
     * @panics unless `0 <= lo <= len()`
     */
    pub fn sliceFromMut(self, lo: int) SliceMut<T> {
        return self.sliceMut(lo, self.len)
    }
}
