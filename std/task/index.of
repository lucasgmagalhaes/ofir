/**
 * @module
 * `std.task`: tasks, each on an OS thread of its own (spec 14.2).
 *
 * Only stage 1 compiles this module: it needs `move fn` closures.
 */
// requires: stage1 (closures, roadmap 5.7)

import std.mem.atomic

@link("pthread")
extern "C" {
    fn ofir_alloc(size: int) *mut u8
    fn ofir_alloc_aligned(size: int, align: int) *mut u8
    fn ofir_free(p: *mut u8)
    fn ofir_task_spawn(job: *mut u8) *mut u8
    fn ofir_task_join(thread: *mut u8)
    fn ofir_task_detach(thread: *mut u8)
}

extern "intrinsic" {
    fn dropInPlace<T>(p: *mut T)
    fn forget<T>(value: move T)
}

// Where a task leaves its result. `state` says who frees it: the handle
// joins and takes the value, or, once dropped, leaves the slot to the
// task, which drops the value it makes.
struct Slot<T> {
    state: int
    value: T
}

const RUNNING: int = 0
const DONE: int = 1
const DETACHED: int = 2

unsafe fn statePtr<T>(slot: *mut Slot<T>) *mut int {
    return &(*slot).state as *int as *mut int
}

unsafe fn valuePtr<T>(slot: *mut Slot<T>) *mut T {
    return &(*slot).value as *T as *mut T
}

// What a new thread runs: the task's closure, with its result already
// bound to the task's slot.
struct Job {
    run: move fn()
}

// The runtime calls this on the new thread with the job `run` handed it.
@export("ofir_task_entry")
extern "C" fn taskEntry(job: *mut u8) {
    const j = unsafe { *(job as *mut Job) }
    unsafe {
        ofir_free(job)
    }
    const body = j.run
    body()
}

/**
 * A running task: `join` waits for it and returns its result. Dropping the
 * handle without a join detaches the task: it runs on, and its result is
 * dropped when it ends.
 *
 * @typeParam T the type of the task's result
 */
pub struct Task<T> {
    thread: *mut u8
    slot: *mut Slot<T>

    /**
     * Waits for the task to finish.
     *
     * @returns the value the task's closure returned
     */
    pub fn join(move self) T {
        const value = unsafe {
            ofir_task_join(self.thread)
            const v = *valuePtr(self.slot)
            ofir_free(self.slot as *mut u8)
            v
        }
        forget(self)   // the thread and the slot are gone
        return value
    }

    fn drop(mut self) {
        unsafe {
            ofir_task_detach(self.thread)
            if atomic.atomicSwap(statePtr(self.slot), DETACHED, atomic.Ordering.AcqRel) == DONE {
                dropInPlace(valuePtr(self.slot))
                ofir_free(self.slot as *mut u8)
            }
        }
    }
}

/**
 * Starts a task that runs `f` on an OS thread of its own.
 *
 * @typeParam T the type of the task's result, which moves back to the caller
 * @param f the task's body; it owns everything it captures, and all of it
 *          must be `Send` (spec 14.3)
 * @returns the task's handle
 * @example
 * ```ofir
 * import std.task
 *
 * const handle = task.run(move () int => 40 + 2)
 * println("{handle.join()}")
 * ```
 */
pub fn run<T: Send>(f: move fn() T + Send) Task<T> {
    const slot = unsafe {
        if alignOf<Slot<T>>() > 16 {
            ofir_alloc_aligned(sizeOf<Slot<T>>(), alignOf<Slot<T>>()) as *mut Slot<T>
        } else {
            ofir_alloc(sizeOf<Slot<T>>()) as *mut Slot<T>
        }
    }
    unsafe {
        *statePtr(slot) = RUNNING
    }
    const job = Job{run: move () => {
        unsafe {
            *valuePtr(slot) = f()
            if atomic.atomicSwap(statePtr(slot), DONE, atomic.Ordering.AcqRel) == DETACHED {
                dropInPlace(valuePtr(slot))
                ofir_free(slot as *mut u8)
            }
        }
    }}
    const thread = unsafe {
        const p = ofir_alloc(sizeOf<Job>()) as *mut Job
        *p = job
        ofir_task_spawn(p as *mut u8)
    }
    return Task{thread: thread, slot: slot}
}
