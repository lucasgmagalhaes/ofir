/**
 * @module
 * `std.sync`: channels, locks, atomics, shared ownership and wait groups
 * for tasks (spec 14.4).
 *
 * Only stage 1 compiles this module: it needs `Send` (spec 14.3).
 */
// requires: stage1 (Send, roadmap 6.1b)

import std.mem.atomic
import std.mem.cell.UnsafeCell

@link("pthread")
extern "C" {
    fn ofir_alloc(size: int) *mut u8
    fn ofir_alloc_aligned(size: int, align: int) *mut u8
    fn ofir_free(p: *mut u8)
    fn ofir_channel_new() *mut u8
    fn ofir_channel_send(ch: *mut u8, value: *mut u8) bool
    fn ofir_channel_recv(ch: *mut u8) *mut u8
    fn ofir_channel_try_recv(ch: *mut u8) *mut u8
    fn ofir_channel_add_sender(ch: *mut u8)
    fn ofir_channel_drop_sender(ch: *mut u8)
    fn ofir_channel_close(ch: *mut u8)
    fn ofir_channel_drop_receiver(ch: *mut u8)
    fn ofir_mutex_new() *mut u8
    fn ofir_mutex_lock(m: *mut u8)
    fn ofir_mutex_unlock(m: *mut u8)
    fn ofir_mutex_free(m: *mut u8)
    fn ofir_rwlock_new() *mut u8
    fn ofir_rwlock_read(l: *mut u8)
    fn ofir_rwlock_write(l: *mut u8)
    fn ofir_rwlock_unlock(l: *mut u8)
    fn ofir_rwlock_free(l: *mut u8)
    fn ofir_waitgroup_new() *mut u8
    fn ofir_waitgroup_add(wg: *mut u8, delta: int) bool
    fn ofir_waitgroup_wait(wg: *mut u8)
    fn ofir_waitgroup_free(wg: *mut u8)
}

extern "intrinsic" {
    fn dropInPlace<T>(p: *mut T)
}

// Moves a value to memory of its own, as the channel's queue holds it.
fn boxed<T>(value: move T) *mut T {
    const p = unsafe {
        if alignOf<T>() > 16 {
              ofir_alloc_aligned(sizeOf<T>(), alignOf<T>()) as *mut T
        } else {
              ofir_alloc(sizeOf<T>()) as *mut T
        }
    }
    unsafe {
        *p = value
    }
    return p
}

// Whether the runtime handed back no value.
fn none(p: *mut u8) bool {
    return unsafe { p == 0 as *mut u8 }
}

// Moves the value out of memory from `boxed` and frees it.
fn unboxed<T>(p: *mut u8) T {
    unsafe {
        const value = *(p as *mut T)
        ofir_free(p)
        return value
    }
}

/**
 * The sending half of a channel. `clone` makes another sender of the same
 * channel; the receiver sees the end once every sender is dropped.
 *
 * @typeParam T the type of the values sent
 */
@threadsafe
pub struct Sender<T> {
    ch: *mut u8

    /**
     * Sends a value to the receiver; it never waits. If the receiver is
     * gone, the value is dropped.
     *
     * @param value the value to send
     */
    pub fn send(self, value: move T) {
        const p = boxed(value)
        const sent = unsafe { ofir_channel_send(self.ch, p as *mut u8) }
        if !sent {
            unsafe {
                dropInPlace(p)
                ofir_free(p as *mut u8)
            }
        }
    }

    /**
     * Another sender of the same channel.
     *
     * @returns the new sender
     */
    pub fn clone(self) Sender<T> {
        unsafe {
            ofir_channel_add_sender(self.ch)
        }
        return Sender{ch: self.ch}
    }

    fn drop(mut self) {
        unsafe {
            ofir_channel_drop_sender(self.ch)
        }
    }
}

/**
 * The receiving half of a channel. Values arrive in the order each sender
 * sent them.
 *
 * @typeParam T the type of the values received
 */
@threadsafe
pub struct Receiver<T> {
    ch: *mut u8

    /**
     * Waits for the next value.
     *
     * @returns the value, or `None` once the queue is empty and every
     *          sender is dropped
     */
    pub fn recv(self) Option<T> {
        const p = unsafe { ofir_channel_recv(self.ch) }
        if none(p) {
            return Option.None
        }
        return Option.Some(unboxed<T>(p))
    }

    /**
     * Takes the next value if one is waiting.
     *
     * @returns the value, or `None` when the queue is empty
     */
    pub fn tryRecv(self) Option<T> {
        const p = unsafe { ofir_channel_try_recv(self.ch) }
        if none(p) {
            return Option.None
        }
        return Option.Some(unboxed<T>(p))
    }

    // Later sends fail; the values still queued are dropped here.
    fn drop(mut self) {
        unsafe {
            ofir_channel_close(self.ch)
        }
        for {
            const p = unsafe { ofir_channel_try_recv(self.ch) }
            if none(p) {
                break
            }
            unsafe {
                dropInPlace(p as *mut T)
                ofir_free(p)
            }
        }
        unsafe {
            ofir_channel_drop_receiver(self.ch)
        }
    }
}

/**
 * Makes a channel: values sent on the `Sender` arrive at the `Receiver`,
 * possibly in another task.
 *
 * @typeParam T the type of the values, which move between tasks
 * @returns the sender and the receiver
 * @example
 * ```ofir
 * import std.sync.channel
 * import std.task
 *
 * const (tx, rx) = channel<int>()
 * const t = task.run(move () => tx.send(42))
 * println("{rx.recv().unwrap()}")
 * t.join()
 * ```
 */
pub fn channel<T: Send>() (Sender<T>, Receiver<T>) {
    const ch = unsafe { ofir_channel_new() }
    return (Sender{ch: ch}, Receiver{ch: ch})
}

/**
 * An `int` that several tasks may read and change at once, without a lock.
 * Every operation is sequentially consistent. Tasks share it through an
 * `Arc`.
 *
 * @example
 * ```ofir
 * import std.sync.AtomicInt
 *
 * const hits = AtomicInt.new(0)
 * hits.fetchAdd(2)
 * const old = hits.swap(10)   // old == 2, hits.load() == 10
 * ```
 */
@threadsafe
pub struct AtomicInt {
    cell: UnsafeCell<int>

    /**
     * An atomic holding a value.
     *
     * @param value the first value
     * @returns the atomic
     */
    pub fn new(value: int) AtomicInt {
        return AtomicInt{cell: UnsafeCell.new(value)}
    }

    /**
     * Reads the value.
     *
     * @returns the current value
     */
    pub fn load(self) int {
        return unsafe { atomic.atomicLoad(self.cell.get(), atomic.Ordering.SeqCst) }
    }

    /**
     * Reads the value with an ordering. `Release` and `AcqRel`, which a
     * load does not allow, are `SeqCst`.
     *
     * @param order the memory ordering
     * @returns the current value
     */
    pub fn loadWith(self, order: atomic.Ordering) int {
        return unsafe { loadOrdered(self.cell.get(), order) }
    }

    /**
     * Replaces the value.
     *
     * @param value the new value
     */
    pub fn store(self, value: int) {
        unsafe {
            atomic.atomicStore(self.cell.get(), value, atomic.Ordering.SeqCst)
        }
    }

    /**
     * Replaces the value with an ordering. `Acquire` and `AcqRel`, which a
     * store does not allow, are `SeqCst`.
     *
     * @param value the new value
     * @param order the memory ordering
     */
    pub fn storeWith(self, value: int, order: atomic.Ordering) {
        unsafe {
            storeOrdered(self.cell.get(), value, order)
        }
    }

    /**
     * Adds to the value, wrapping on overflow.
     *
     * @param delta the amount added, negative to subtract
     * @returns the value before the addition
     */
    pub fn fetchAdd(self, delta: int) int {
        return unsafe { atomic.atomicFetchAdd(self.cell.get(), delta, atomic.Ordering.SeqCst) }
    }

    /**
     * Adds to the value with an ordering, wrapping on overflow.
     *
     * @param delta the amount added, negative to subtract
     * @param order the memory ordering
     * @returns the value before the addition
     */
    pub fn fetchAddWith(self, delta: int, order: atomic.Ordering) int {
        return unsafe { fetchAddOrdered(self.cell.get(), delta, order) }
    }

    /**
     * Replaces the value.
     *
     * @param value the new value
     * @returns the value it replaced
     */
    pub fn swap(self, value: int) int {
        return unsafe { atomic.atomicSwap(self.cell.get(), value, atomic.Ordering.SeqCst) }
    }

    /**
     * Replaces the value with an ordering.
     *
     * @param value the new value
     * @param order the memory ordering
     * @returns the value it replaced
     */
    pub fn swapWith(self, value: int, order: atomic.Ordering) int {
        return unsafe { swapOrdered(self.cell.get(), value, order) }
    }

    /**
     * Replaces the value only if it is `expected`.
     *
     * @param expected the value the atomic must hold
     * @param desired the value it then holds
     * @returns true if the value was replaced
     */
    pub fn compareExchange(self, expected: int, desired: int) bool {
        const p = self.cell.get()
        const old = unsafe {
            atomic.atomicCompareExchange(p, expected, desired, atomic.Ordering.SeqCst)
        }
        return old == expected
    }

    /**
     * Replaces the value only if it is `expected`, with an ordering.
     *
     * @param expected the value the atomic must hold
     * @param desired the value it then holds
     * @param order the memory ordering
     * @returns true if the value was replaced
     */
    pub fn compareExchangeWith(self, expected: int, desired: int, order: atomic.Ordering) bool {
        const old = unsafe { compareExchangeOrdered(self.cell.get(), expected, desired, order) }
        return old == expected
    }
}

/**
 * A `bool` that several tasks may read and change at once, without a
 * lock: a flag such as "stop now". Every operation is sequentially
 * consistent.
 *
 * @example
 * ```ofir
 * import std.sync.AtomicBool
 *
 * const stop = AtomicBool.new(false)
 * stop.store(true)   // stop.load() == true
 * ```
 */
@threadsafe
pub struct AtomicBool {
    cell: UnsafeCell<int>

    /**
     * An atomic holding a value.
     *
     * @param value the first value
     * @returns the atomic
     */
    pub fn new(value: bool) AtomicBool {
        return AtomicBool{cell: UnsafeCell.new(if value { 1 } else { 0 })}
    }

    /**
     * Reads the value.
     *
     * @returns the current value
     */
    pub fn load(self) bool {
        return unsafe { atomic.atomicLoad(self.cell.get(), atomic.Ordering.SeqCst) } != 0
    }

    /**
     * Reads the value with an ordering. `Release` and `AcqRel`, which a
     * load does not allow, are `SeqCst`.
     *
     * @param order the memory ordering
     * @returns the current value
     */
    pub fn loadWith(self, order: atomic.Ordering) bool {
        return unsafe { loadOrdered(self.cell.get(), order) } != 0
    }

    /**
     * Replaces the value.
     *
     * @param value the new value
     */
    pub fn store(self, value: bool) {
        unsafe {
            atomic.atomicStore(self.cell.get(), if value { 1 } else { 0 }, atomic.Ordering.SeqCst)
        }
    }

    /**
     * Replaces the value with an ordering. `Acquire` and `AcqRel`, which a
     * store does not allow, are `SeqCst`.
     *
     * @param value the new value
     * @param order the memory ordering
     */
    pub fn storeWith(self, value: bool, order: atomic.Ordering) {
        unsafe {
            storeOrdered(self.cell.get(), if value { 1 } else { 0 }, order)
        }
    }

    /**
     * Replaces the value.
     *
     * @param value the new value
     * @returns the value it replaced
     */
    pub fn swap(self, value: bool) bool {
        const bits = if value { 1 } else { 0 }
        return unsafe { atomic.atomicSwap(self.cell.get(), bits, atomic.Ordering.SeqCst) } != 0
    }

    /**
     * Replaces the value with an ordering.
     *
     * @param value the new value
     * @param order the memory ordering
     * @returns the value it replaced
     */
    pub fn swapWith(self, value: bool, order: atomic.Ordering) bool {
        return unsafe { swapOrdered(self.cell.get(), if value { 1 } else { 0 }, order) } != 0
    }
}

// The atomic intrinsics with an ordering known only at run time: the
// ordering of an intrinsic is a constant (E0820), so each one is a branch
// that inlining with a constant `order` removes. An ordering the operation
// does not allow is the stronger `SeqCst`.
unsafe fn loadOrdered(p: *mut int, order: atomic.Ordering) int {
    return match order {
        atomic.Ordering.Relaxed => atomic.atomicLoad(p, atomic.Ordering.Relaxed)
        atomic.Ordering.Acquire => atomic.atomicLoad(p, atomic.Ordering.Acquire)
        _ => atomic.atomicLoad(p, atomic.Ordering.SeqCst)
    }
}

unsafe fn storeOrdered(p: *mut int, value: int, order: atomic.Ordering) {
    match order {
        atomic.Ordering.Relaxed => atomic.atomicStore(p, value, atomic.Ordering.Relaxed)
        atomic.Ordering.Release => atomic.atomicStore(p, value, atomic.Ordering.Release)
        _ => atomic.atomicStore(p, value, atomic.Ordering.SeqCst)
    }
}

unsafe fn swapOrdered(p: *mut int, value: int, order: atomic.Ordering) int {
    return match order {
        atomic.Ordering.Relaxed => atomic.atomicSwap(p, value, atomic.Ordering.Relaxed)
        atomic.Ordering.Acquire => atomic.atomicSwap(p, value, atomic.Ordering.Acquire)
        atomic.Ordering.Release => atomic.atomicSwap(p, value, atomic.Ordering.Release)
        atomic.Ordering.AcqRel => atomic.atomicSwap(p, value, atomic.Ordering.AcqRel)
        atomic.Ordering.SeqCst => atomic.atomicSwap(p, value, atomic.Ordering.SeqCst)
    }
}

unsafe fn fetchAddOrdered(p: *mut int, delta: int, order: atomic.Ordering) int {
    return match order {
        atomic.Ordering.Relaxed => atomic.atomicFetchAdd(p, delta, atomic.Ordering.Relaxed)
        atomic.Ordering.Acquire => atomic.atomicFetchAdd(p, delta, atomic.Ordering.Acquire)
        atomic.Ordering.Release => atomic.atomicFetchAdd(p, delta, atomic.Ordering.Release)
        atomic.Ordering.AcqRel => atomic.atomicFetchAdd(p, delta, atomic.Ordering.AcqRel)
        atomic.Ordering.SeqCst => atomic.atomicFetchAdd(p, delta, atomic.Ordering.SeqCst)
    }
}

// The value before the exchange.
unsafe fn compareExchangeOrdered(p: *mut int, expected: int, desired: int,
                                 order: atomic.Ordering) int {
    return match order {
        atomic.Ordering.Relaxed => {
            atomic.atomicCompareExchange(p, expected, desired, atomic.Ordering.Relaxed)
        }
        atomic.Ordering.Acquire => {
            atomic.atomicCompareExchange(p, expected, desired, atomic.Ordering.Acquire)
        }
        atomic.Ordering.Release => {
            atomic.atomicCompareExchange(p, expected, desired, atomic.Ordering.Release)
        }
        atomic.Ordering.AcqRel => {
            atomic.atomicCompareExchange(p, expected, desired, atomic.Ordering.AcqRel)
        }
        atomic.Ordering.SeqCst => {
            atomic.atomicCompareExchange(p, expected, desired, atomic.Ordering.SeqCst)
        }
    }
}

// What an `Arc` points to: the count of its owners and the value.
struct ArcInner<T> {
    count: int
    value: T
}

/**
 * A value shared by several owners, possibly in different tasks: each
 * `clone` is another owner of the same value, and the last owner to go
 * drops it. The count is atomic. The value is read-only: shared mutation
 * goes through a `Mutex`, an `RwLock` or an atomic inside the `Arc`.
 *
 * @typeParam T the type of the value; shared between tasks, it must be
 *            `Send` and `Sync`
 * @example
 * ```ofir
 * import std.sync.Arc
 * import std.task
 *
 * const names = Arc.new(["ana", "bia"])
 * const mine = names.clone()
 * const t = task.run(move () int => mine.get().len())
 * println("{t.join()} {names.get()[0]}")   // 2 ana
 * ```
 */
@threadsafe
pub struct Arc<T: Send + Sync> {
    inner: *mut ArcInner<T>

    /**
     * Moves a value to the heap, with one owner.
     *
     * @param value the value to share
     * @returns the first owner
     */
    pub fn new(value: move T) Arc<T> {
        return Arc{inner: boxed(ArcInner{count: 1, value})}
    }

    /**
     * The shared value.
     *
     * @returns a borrow of the value, as long as this owner lives
     */
    pub fn get(self) &T {
        return unsafe { &(*self.inner).value }
    }

    /**
     * Another owner of the same value; the value itself is not copied.
     *
     * @returns the new owner
     */
    pub fn clone(self) Arc<T> {
        unsafe {   // a new owner comes from an existing one: no ordering is needed
            atomic.atomicFetchAdd(self.count(), 1, atomic.Ordering.Relaxed)
        }
        return Arc{inner: self.inner}
    }

    /**
     * How many owners the value has. Other tasks may change it at any
     * moment, so it is a hint, not a guarantee.
     *
     * @returns the number of owners
     */
    pub fn owners(self) int {
        return unsafe { atomic.atomicLoad(self.count(), atomic.Ordering.Relaxed) }
    }

    // The address of the count.
    unsafe fn count(self) *mut int {
        return &(*self.inner).count as *int as *mut int
    }

    // The last owner drops the value and frees the memory.
    fn drop(mut self) {
        unsafe {
            // Release publishes this owner's uses of the value; the last owner's
            // Acquire fence sees all of them before the drop.
            if atomic.atomicFetchSub(self.count(), 1, atomic.Ordering.Release) == 1 {
                atomic.fence(atomic.Ordering.Acquire)
                dropInPlace(self.inner)
                ofir_free(self.inner as *mut u8)
            }
        }
    }
}

/**
 * A value that tasks change one at a time. The value lives inside the
 * mutex and is reached only through the guard that `lock` returns; the
 * mutex is unlocked when the guard is dropped. Tasks share it through an
 * `Arc`.
 *
 * Locking a mutex again in the task that holds it waits forever.
 *
 * @typeParam T the type of the value
 * @example
 * ```ofir
 * import std.sync.Mutex
 *
 * const names = Mutex.new(List<str>.new())
 * {
 *     let guard = names.lock()
 *     guard.getMut().push("ana")
 * }   // unlocked here
 * println("{names.lock().get().len()}")   // 1
 * ```
 */
@threadsafe
pub struct Mutex<T> {
    raw: *mut u8
    cell: UnsafeCell<T>

    /**
     * A mutex holding a value, unlocked.
     *
     * @param value the value to guard
     * @returns the mutex
     */
    pub fn new(value: move T) Mutex<T> {
        return Mutex{raw: unsafe { ofir_mutex_new() }, cell: UnsafeCell.new(value)}
    }

    /**
     * Waits until no other task holds the mutex, then holds it.
     *
     * @returns the guard that reaches the value and unlocks on drop
     */
    pub fn lock(self) MutexGuard<T> {
        unsafe {
            ofir_mutex_lock(self.raw)
        }
        return MutexGuard{mutex: &self}
    }

    fn drop(mut self) {
        unsafe {
            ofir_mutex_free(self.raw)
        }
    }
}

/**
 * Proof that a task holds a `Mutex`: the value is reachable through it,
 * and dropping it unlocks the mutex.
 *
 * @typeParam T the type of the value
 */
pub ref struct MutexGuard<T> {
    mutex: &Mutex<T>

    /**
     * Reads the value.
     *
     * @returns a borrow of the value, as long as the guard lives
     */
    pub fn get(self) &T {
        return unsafe { &*self.mutex.cell.get() }
    }

    /**
     * Changes the value.
     *
     * @returns a mutable borrow of the value, as long as the guard lives
     */
    pub fn getMut(mut self) &mut T {
        return unsafe { &mut *self.mutex.cell.get() }
    }

    fn drop(mut self) {
        unsafe {
            ofir_mutex_unlock(self.mutex.raw)
        }
    }
}

/**
 * A value that many tasks may read at once, or one task may change: a
 * reader-writer lock. `read` and `write` return guards that unlock on
 * drop. Tasks share it through an `Arc`.
 *
 * @typeParam T the type of the value
 * @example
 * ```ofir
 * import std.sync.RwLock
 *
 * const config = RwLock.new("fast")
 * {
 *     let w = config.write()
 *     *w.getMut() = "safe"
 * }
 * println("{config.read().get()}")   // safe
 * ```
 */
@threadsafe
pub struct RwLock<T> {
    raw: *mut u8
    cell: UnsafeCell<T>

    /**
     * A lock holding a value, unlocked.
     *
     * @param value the value to guard
     * @returns the lock
     */
    pub fn new(value: move T) RwLock<T> {
        return RwLock{raw: unsafe { ofir_rwlock_new() }, cell: UnsafeCell.new(value)}
    }

    /**
     * Waits until no task writes, then reads alongside the other readers.
     *
     * @returns the guard that reads the value and unlocks on drop
     */
    pub fn read(self) ReadGuard<T> {
        unsafe {
            ofir_rwlock_read(self.raw)
        }
        return ReadGuard{lock: &self}
    }

    /**
     * Waits until no other task reads or writes, then holds the lock alone.
     *
     * @returns the guard that changes the value and unlocks on drop
     */
    pub fn write(self) WriteGuard<T> {
        unsafe {
            ofir_rwlock_write(self.raw)
        }
        return WriteGuard{lock: &self}
    }

    fn drop(mut self) {
        unsafe {
            ofir_rwlock_free(self.raw)
        }
    }
}

/**
 * A shared hold on an `RwLock`: the value can be read, and dropping the
 * guard releases the hold.
 *
 * @typeParam T the type of the value
 */
pub ref struct ReadGuard<T> {
    lock: &RwLock<T>

    /**
     * Reads the value.
     *
     * @returns a borrow of the value, as long as the guard lives
     */
    pub fn get(self) &T {
        return unsafe { &*self.lock.cell.get() }
    }

    fn drop(mut self) {
        unsafe {
            ofir_rwlock_unlock(self.lock.raw)
        }
    }
}

/**
 * The only hold on an `RwLock`: the value can be read and changed, and
 * dropping the guard releases the hold.
 *
 * @typeParam T the type of the value
 */
pub ref struct WriteGuard<T> {
    lock: &RwLock<T>

    /**
     * Reads the value.
     *
     * @returns a borrow of the value, as long as the guard lives
     */
    pub fn get(self) &T {
        return unsafe { &*self.lock.cell.get() }
    }

    /**
     * Changes the value.
     *
     * @returns a mutable borrow of the value, as long as the guard lives
     */
    pub fn getMut(mut self) &mut T {
        return unsafe { &mut *self.lock.cell.get() }
    }

    fn drop(mut self) {
        unsafe {
            ofir_rwlock_unlock(self.lock.raw)
        }
    }
}

/**
 * Waits for a group of tasks: `add` counts the work started, each task
 * calls `done` when it finishes, and `wait` returns once the count is
 * back to zero. Tasks share it through an `Arc`.
 *
 * @example
 * ```ofir
 * import std.sync.Arc
 * import std.sync.WaitGroup
 * import std.task
 *
 * const group = Arc.new(WaitGroup.new())
 * group.get().add(1)
 * const mine = group.clone()
 * const t = task.run(move () => mine.get().done())
 * group.get().wait()   // returns once the task called done
 * t.join()
 * ```
 */
@threadsafe
pub struct WaitGroup {
    raw: *mut u8

    /**
     * A group with a count of zero.
     *
     * @returns the group
     */
    pub fn new() WaitGroup {
        return WaitGroup{raw: unsafe { ofir_waitgroup_new() }}
    }

    /**
     * Adds to the count.
     *
     * @param count the amount of work started
     * @panics when the count would go below zero
     */
    pub fn add(self, count: int) {
        if unsafe { !ofir_waitgroup_add(self.raw, count) } {
            panic("WaitGroup count below zero")
        }
    }

    /**
     * Counts one piece of work as finished.
     *
     * @panics when the count is already zero
     */
    pub fn done(self) {
        self.add(-1)
    }

    /**
     * Waits until the count is zero.
     */
    pub fn wait(self) {
        unsafe {
            ofir_waitgroup_wait(self.raw)
        }
    }

    fn drop(mut self) {
        unsafe {
            ofir_waitgroup_free(self.raw)
        }
    }
}
