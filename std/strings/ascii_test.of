// The tests of `std.strings.ascii` (ADR 0056): `ofir test std/strings/ascii.of` runs them.

import std.testing.assert

@test
fn classesHaveTheirSizes() {
    let counts: List<int> = [0, 0, 0, 0, 0, 0, 0]
    for i in 0..256 {
        const b = i as u8
        const checks = [isDigit(b), isHexDigit(b), isAlpha(b), isAlnum(b), isSpace(b),
                        isUpper(b), isLower(b)]
        for k in 0..checks.len() {
            if checks[k] {
                counts[k] += 1
            }
        }
    }
    const expected = [10, 22, 52, 62, 6, 26, 26]
    for k in 0..expected.len() {
        assert(counts[k] == expected[k])
    }
}

@test
fn caseMappingLeavesOtherBytes() {
    assert(toLower(b'Q') == b'q' && toLower(b'q') == b'q' && toLower(b'@') == b'@')
    assert(toUpper(b'q') == b'Q' && toUpper(b'[') == b'[' && toUpper(0xE9) == 0xE9)
}

@test
fn digitValueChecksTheBase() {
    assert((digitValue(b'7', 8) ?? -1) == 7)
    assert(digitValue(b'8', 8).isNone())
    assert((digitValue(b'Z', 36) ?? -1) == 35)
    assert((digitValue(b'b', 16) ?? -1) == 11)
    assert(digitValue(b'g', 16).isNone() && digitValue(b'-', 10).isNone())
}
