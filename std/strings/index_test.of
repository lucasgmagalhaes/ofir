// The tests of `std.strings` (spec 12.2): `ofir test std/strings/index.of` runs them.

import std.testing.assert

@test
fn joinPutsTheSeparatorBetweenParts() {
    assert(join(["a", "b", "c"], ", ") == "a, b, c")
    const none: List<str> = []
    assert(join(none, ",") == "")
}

@test
fn fromUtf8RejectsInvalidSequences() {
    assert(fromUtf8([0x68, 0xC3, 0xA9]).unwrapOr("") == "hé")
    const cases: List<List<u8>> = [[0xFF], [0xC0, 0x80], [0xED, 0xA0, 0x80], [0xE2, 0x82]]
    for i in 0..cases.len() {
        assert(fromUtf8(cases[i].clone()).isErr())
    }
}

@test
fn builderCollectsPieces() {
    let b = Builder.new()
    b.push("n = ")
    b.pushChar(0x31)
    b.pushChar(0x20AC)
    assert(b.len() == 8)
    assert(b.finish() == "n = 1€")
}
