/**
 * @module
 * `std.encoding`: bytes as hex and base64 text, and integers in a byte
 * order (ADR 0059).
 *
 * Decoding is strict: a byte outside the alphabet, wrong padding or
 * unused bits that are not 0 fail, so each text has at most one meaning.
 *
 * @example
 * ```ofir
 * import std.encoding
 * import std.testing.assert
 *
 * assert(encoding.hexEncode("hi".asBytes()) == "6869")
 * assert(encoding.base64Encode("hi".asBytes()) == "aGk=")
 * let out: List<u8> = []
 * encoding.writeU16Be(out, 0x0102)
 * assert(encoding.readU16Be(out.asSlice(), 0) == 0x0102)
 * ```
 */

/**
 * Why text is not a valid encoding.
 */
pub struct DecodeError {
    /** The offset of the first byte that is wrong, or the length when it is too short. */
    pub offset: int
}

const HEX = "0123456789abcdef"
const BASE64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const BASE64_URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

/**
 * The bytes as lowercase hex digits, two for each byte.
 *
 * @param data the bytes
 * @returns the digits
 */
pub fn hexEncode(data: &[u8]) str {
    const digits = HEX.asBytes()
    let out = str.withCapacity(data.len() * 2)
    for i in 0..data.len() {
        out.pushChar(digits[(data[i] >> 4) as int] as u32)
        out.pushChar(digits[(data[i] & 15) as int] as u32)
    }
    return out
}

// The value of a hex digit, or -1.
fn hexValue(b: u8) int {
    if b >= b'0' && b <= b'9' {
        return (b - b'0') as int
    }
    if b >= b'a' && b <= b'f' {
        return (b - b'a') as int + 10
    }
    if b >= b'A' && b <= b'F' {
        return (b - b'A') as int + 10
    }
    return -1
}

/**
 * The bytes that hex digits stand for, in either case.
 *
 * @param text two digits for each byte
 * @returns the bytes, or `DecodeError` at an odd length or a byte that is
 * not a digit
 */
pub fn hexDecode(text: str) Result<List<u8>, DecodeError> {
    const b = text.asBytes()
    if b.len() % 2 != 0 {
        return Result.Err(DecodeError{offset: b.len()})
    }
    let out: List<u8> = List.withCapacity(b.len() / 2)
    let i = 0
    for i < b.len() {
        const hi = hexValue(b[i])
        if hi < 0 {
            return Result.Err(DecodeError{offset: i})
        }
        const lo = hexValue(b[i + 1])
        if lo < 0 {
            return Result.Err(DecodeError{offset: i + 1})
        }
        out.push((hi * 16 + lo) as u8)
        i += 2
    }
    return Result.Ok(out)
}

fn base64With(data: &[u8], alphabet: str, pad: bool) str {
    const a = alphabet.asBytes()
    let out = str.withCapacity((data.len() + 2) / 3 * 4)
    let i = 0
    for i + 3 <= data.len() {
        const n = (data[i] as int) * 65536 + (data[i + 1] as int) * 256 + data[i + 2] as int
        out.pushChar(a[n / 262144] as u32)
        out.pushChar(a[n / 4096 % 64] as u32)
        out.pushChar(a[n / 64 % 64] as u32)
        out.pushChar(a[n % 64] as u32)
        i += 3
    }
    const rest = data.len() - i
    if rest == 1 {
        const n = data[i] as int
        out.pushChar(a[n / 4] as u32)
        out.pushChar(a[n % 4 * 16] as u32)
        if pad {
            out.push("==")
        }
    } else if rest == 2 {
        const n = (data[i] as int) * 256 + data[i + 1] as int
        out.pushChar(a[n / 1024] as u32)
        out.pushChar(a[n / 16 % 64] as u32)
        out.pushChar(a[n % 16 * 4] as u32)
        if pad {
            out.push("=")
        }
    }
    return out
}

// The value of a base64 digit in the standard (`url` false) or URL
// alphabet, or -1.
fn base64Value(b: u8, url: bool) int {
    if b >= b'A' && b <= b'Z' {
        return (b - b'A') as int
    }
    if b >= b'a' && b <= b'z' {
        return (b - b'a') as int + 26
    }
    if b >= b'0' && b <= b'9' {
        return (b - b'0') as int + 52
    }
    if (!url && b == b'+') || (url && b == b'-') {
        return 62
    }
    if (!url && b == b'/') || (url && b == b'_') {
        return 63
    }
    return -1
}

fn base64DecodeWith(text: str, url: bool) Result<List<u8>, DecodeError> {
    const b = text.asBytes()
    let len = b.len()
    if !url {
        // Padding makes the length a multiple of 4, with at most two `=`.
        if len % 4 != 0 {
            return Result.Err(DecodeError{offset: len})
        }
        if len > 0 && b[len - 1] == b'=' {
            len -= 1
            if b[len - 1] == b'=' {
                len -= 1
            }
        }
    }
    if len % 4 == 1 {
        return Result.Err(DecodeError{offset: len})
    }
    let out: List<u8> = List.withCapacity(len / 4 * 3 + 2)
    let acc = 0
    let bits = 0
    for i in 0..len {
        const v = base64Value(b[i], url)
        if v < 0 {
            return Result.Err(DecodeError{offset: i})
        }
        acc = acc * 64 + v
        bits += 6
        if bits >= 8 {
            bits -= 8
            out.push((acc >> bits) as u8)
            acc = acc & ((1 << bits) - 1)
        }
    }
    // The bits left over from the last digit must be 0.
    if acc != 0 {
        return Result.Err(DecodeError{offset: len - 1})
    }
    return Result.Ok(out)
}

/**
 * The bytes in base64 with the standard alphabet and `=` padding
 * (RFC 4648, section 4).
 *
 * @param data the bytes
 * @returns four characters for each three bytes or part of them
 */
pub fn base64Encode(data: &[u8]) str {
    return base64With(data, BASE64, true)
}

/**
 * The bytes that standard, padded base64 stands for.
 *
 * @param text the base64 text, a multiple of 4 long
 * @returns the bytes, or `DecodeError` at a byte outside the alphabet,
 * wrong padding or unused bits that are not 0
 */
pub fn base64Decode(text: str) Result<List<u8>, DecodeError> {
    return base64DecodeWith(text, false)
}

/**
 * The bytes in base64 with the URL alphabet (`-` and `_`) and no padding
 * (RFC 4648, section 5).
 *
 * @param data the bytes
 * @returns the text, safe in URLs and file names
 */
pub fn base64UrlEncode(data: &[u8]) str {
    return base64With(data, BASE64_URL, false)
}

/**
 * The bytes that unpadded URL base64 stands for.
 *
 * @param text the text, without `=`
 * @returns the bytes, or `DecodeError` as in `base64Decode`
 */
pub fn base64UrlDecode(text: str) Result<List<u8>, DecodeError> {
    return base64DecodeWith(text, true)
}

// Byte order. Reads panic past the end of `data`, as indexing does.

/**
 * The little-endian `u16` at `at`.
 *
 * @param data the bytes
 * @param at the offset of its first byte
 * @returns the value
 */
pub fn readU16Le(data: &[u8], at: int) u16 {
    return (data[at] as u16) | ((data[at + 1] as u16) << 8)
}

/**
 * The big-endian `u16` at `at`.
 *
 * @param data the bytes
 * @param at the offset of its first byte
 * @returns the value
 */
pub fn readU16Be(data: &[u8], at: int) u16 {
    return ((data[at] as u16) << 8) | (data[at + 1] as u16)
}

/**
 * The little-endian `u32` at `at`.
 *
 * @param data the bytes
 * @param at the offset of its first byte
 * @returns the value
 */
pub fn readU32Le(data: &[u8], at: int) u32 {
    let v: u32 = 0
    for k in 0..4 {
        v = v | ((data[at + k] as u32) << (8 * k) as u32)
    }
    return v
}

/**
 * The big-endian `u32` at `at`.
 *
 * @param data the bytes
 * @param at the offset of its first byte
 * @returns the value
 */
pub fn readU32Be(data: &[u8], at: int) u32 {
    let v: u32 = 0
    for k in 0..4 {
        v = (v << 8) | (data[at + k] as u32)
    }
    return v
}

/**
 * The little-endian `u64` at `at`.
 *
 * @param data the bytes
 * @param at the offset of its first byte
 * @returns the value
 */
pub fn readU64Le(data: &[u8], at: int) u64 {
    let v: u64 = 0
    for k in 0..8 {
        v = v | ((data[at + k] as u64) << (8 * k) as u64)
    }
    return v
}

/**
 * The big-endian `u64` at `at`.
 *
 * @param data the bytes
 * @param at the offset of its first byte
 * @returns the value
 */
pub fn readU64Be(data: &[u8], at: int) u64 {
    let v: u64 = 0
    for k in 0..8 {
        v = (v << 8) | (data[at + k] as u64)
    }
    return v
}

/**
 * Appends `v` in little-endian order.
 *
 * @param out where the two bytes go
 * @param v the value
 */
pub fn writeU16Le(out: mut List<u8>, v: u16) {
    out.push((v & 255) as u8)
    out.push((v >> 8) as u8)
}

/**
 * Appends `v` in big-endian order.
 *
 * @param out where the two bytes go
 * @param v the value
 */
pub fn writeU16Be(out: mut List<u8>, v: u16) {
    out.push((v >> 8) as u8)
    out.push((v & 255) as u8)
}

/**
 * Appends `v` in little-endian order.
 *
 * @param out where the four bytes go
 * @param v the value
 */
pub fn writeU32Le(out: mut List<u8>, v: u32) {
    for k in 0..4 {
        out.push(((v >> (8 * k) as u32) & 255) as u8)
    }
}

/**
 * Appends `v` in big-endian order.
 *
 * @param out where the four bytes go
 * @param v the value
 */
pub fn writeU32Be(out: mut List<u8>, v: u32) {
    for k in 0..4 {
        out.push(((v >> (24 - 8 * k) as u32) & 255) as u8)
    }
}

/**
 * Appends `v` in little-endian order.
 *
 * @param out where the eight bytes go
 * @param v the value
 */
pub fn writeU64Le(out: mut List<u8>, v: u64) {
    for k in 0..8 {
        out.push(((v >> (8 * k) as u64) & 255) as u8)
    }
}

/**
 * Appends `v` in big-endian order.
 *
 * @param out where the eight bytes go
 * @param v the value
 */
pub fn writeU64Be(out: mut List<u8>, v: u64) {
    for k in 0..8 {
        out.push(((v >> (56 - 8 * k) as u64) & 255) as u8)
    }
}
