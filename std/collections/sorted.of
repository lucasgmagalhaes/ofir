/**
 * @module
 * `SortedMap<K, V>`: a map that keeps its keys in order (ADR 0055,
 * docs/std/collections.md).
 */

import std.mem

/**
 * A map whose keys are kept in ascending order.
 *
 * The keys are in one sorted list and the values in a parallel list:
 * `get` and `contains` are a binary search, O(log n); `insert` and
 * `remove` shift the later entries, O(n). It suits maps that are read
 * more than they are changed, and walks in key order. For a bulk load,
 * sort the entries first and insert them in order: each insertion then
 * lands at the end.
 *
 * @typeParam K the type of the keys
 * @typeParam V the type of the values
 * @example
 * ```ofir
 * import std.collections.sorted.SortedMap
 *
 * let stock: SortedMap<str, int> = SortedMap.new()
 * stock.insert("pear", 4)
 * stock.insert("apple", 7)
 * const names = stock.keys()
 * println("{names[0]} {stock.get("pear") ?? &0}")   // apple 4
 * ```
 */
pub struct SortedMap<K: Ord, V> {
    keys: List<K>
    values: List<V>

    /**
     * An empty map.
     *
     * @returns a map with no entries
     * @complexity O(1)
     */
    pub fn new() SortedMap<K, V> {
        return SortedMap{keys: [], values: []}
    }

    /**
     * The number of entries.
     *
     * @returns the number of keys
     * @complexity O(1)
     */
    pub fn len(self) int {
        return self.keys.len()
    }

    /**
     * Whether the map has no entries.
     *
     * @returns true when the map is empty
     * @complexity O(1)
     */
    pub fn isEmpty(self) bool {
        return self.keys.isEmpty()
    }

    /**
     * The position of the first key that is not less than `key`: where
     * `key` is, or would be inserted.
     *
     * @param key the key to look for
     * @returns a position from 0 to `len()`
     * @complexity O(log n)
     */
    pub fn lowerBound(self, key: K) int {
        let lo = 0
        let hi = self.keys.len()
        for lo < hi {
            const mid = lo + (hi - lo) / 2
            if self.keys[mid] < key {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        return lo
    }

    /**
     * Whether a key is in the map, in O(log n).
     *
     * @param key the key to look for
     * @returns true when an equal key is in the map
     * @complexity O(log n)
     */
    pub fn contains(self, key: K) bool {
        return self.find(key) >= 0
    }

    /**
     * A borrow of the value of a key, in O(log n).
     *
     * @param key the key to look for
     * @returns `Some` with a reference to the value, or `None`
     * @complexity O(log n)
     */
    pub fn get(self, key: K) Option<&V> {
        const i = self.find(key)
        if i < 0 {
            return Option.None
        }
        return self.values.get(i)
    }

    /**
     * A mutable borrow of the value of a key, in O(log n).
     *
     * @param key the key to look for
     * @returns `Some` with a mutable reference to the value, or `None`
     * @complexity O(log n)
     */
    pub fn getMut(mut self, key: K) Option<&mut V> {
        const i = self.find(key)
        if i < 0 {
            return Option.None
        }
        return self.values.getMut(i)
    }

    /**
     * Sets the value of a key, in O(n): O(log n) when the key is there or
     * goes last.
     *
     * @param key the key; the map takes ownership of it
     * @param value the value; the map takes ownership of it
     * @returns `Some` with the previous value of the key, or `None`
     * @complexity O(n): a binary search, then the later entries shift; O(log n) at the end
     */
    pub fn insert(mut self, key: move K, value: move V) Option<V> {
        const i = self.lowerBound(key)
        if i < self.keys.len() && !(key < self.keys[i]) {
            return Option.Some(mem.replace(self.values[i], value))
        }
        self.keys.insert(i, key)
        self.values.insert(i, value)
        return Option.None
    }

    /**
     * Removes a key and its value, in O(n).
     *
     * @param key the key to remove
     * @returns `Some` with the value, or `None` when the key was not there
     * @complexity O(n): the later entries shift
     */
    pub fn remove(mut self, key: K) Option<V> {
        const i = self.find(key)
        if i < 0 {
            return Option.None
        }
        self.keys.remove(i)
        return Option.Some(self.values.remove(i))
    }

    /**
     * Removes every entry; the capacity is kept for reuse.
     * @complexity O(n)
     */
    pub fn clear(mut self) {
        self.keys.clear()
        self.values.clear()
    }

    /**
     * The keys, in ascending order. With `lowerBound`, `keys()[a..b]` is a
     * range of keys.
     *
     * @returns a slice of the keys
     * @complexity O(1)
     */
    pub fn keys(self) &[K] {
        return self.keys.asSlice()
    }

    /**
     * The values, in the order of their keys: `values()[i]` belongs to
     * `keys()[i]`.
     *
     * @returns a slice of the values
     * @complexity O(1)
     */
    pub fn values(self) &[V] {
        return self.values.asSlice()
    }

    // The position of `key`, or -1.
    fn find(self, key: K) int {
        const i = self.lowerBound(key)
        if i < self.keys.len() && !(key < self.keys[i]) {
            return i
        }
        return -1
    }
}
