// The tests of `std.collections.heap`: `ofir test std/collections/heap.of` runs them.

import std.testing.assert

@test
fn popsTheGreatestFirst() {
    let h: Heap<int> = Heap.new()
    for x in [5, 1, 8, 3, 9, 2, 8] {
        h.push(x)
    }
    assert(h.len() == 7 && *(h.peek() ?? &0) == 9)
    let out: List<int> = []
    for !h.isEmpty() {
        out.push(h.pop() ?? -1)
    }
    assert(joined(&out) == "9 8 8 5 3 2 1")
    assert(h.pop().isNone() && h.peek().isNone())
}

@test
fn fromListAndIntoSorted() {
    const h = Heap.fromList([4, 7, 1, 9, 3])
    assert(*(h.peek() ?? &0) == 9)
    assert(joined(&h.intoSorted()) == "1 3 4 7 9")
}

fn joined(xs: &List<int>) str {
    let out = ""
    for i in 0..xs.len() {
        if i > 0 {
            out.push(" ")
        }
        out.push("{xs[i]}")
    }
    return out
}
