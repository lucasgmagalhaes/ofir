// The tests of `std.mem` (spec 12.2): `ofir test std/mem/index.of` runs them.

import std.testing.assert

@test
fn replaceReturnsTheOldValue() {
    let names = ["ana".toOwned(), "bob".toOwned()]
    const old = replace(names[0], "cy".toOwned())
    assert(old == "ana" && names[0] == "cy")
}

@test
fn swapExchangesTheValues() {
    let a = "ana".toOwned()
    let b = "bob".toOwned()
    swap(a, b)
    assert(a == "bob" && b == "ana")
}
