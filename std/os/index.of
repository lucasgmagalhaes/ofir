/**
 * @module
 * `std.os`: the process: its arguments, its environment, exiting, and
 * running other programs (docs/std/system.md).
 *
 * @example
 * ```ofir
 * import std.os
 *
 * const home = os.env("HOME") ?? "."
 * const out = os.run("echo", ["hi"]).expect("echo runs")
 * if out.status != 0 {
 *     os.exit(1)
 * }
 * ```
 */

import std.io.Buffer
import std.io.IoError
import std.io

extern "C" {
    fn ofir_arg_count() int
    fn ofir_arg(i: int, len: *mut int) *u8
    fn ofir_os_name(len: *mut int) *u8
    fn ofir_arch_name(len: *mut int) *u8
    fn ofir_env(name: *u8, len: int, value_len: *mut int) *u8
    fn ofir_exit(code: int) !
    fn ofir_abort() !
    fn ofir_spawn(args: *u8, len: int, count: int, child: *mut *mut u8) i32
    fn ofir_wait(child: *mut u8, out: *mut Captured)
    fn ofir_child_free(child: *mut u8)
    fn ofir_cpu_count() int
    fn ofir_current_dir(out: *mut Buffer) i32
    fn ofir_executable_path(out: *mut Buffer) i32
}

/**
 * The command-line arguments.
 *
 * @returns the arguments; `args()[0]` is the path of the program
 * @example
 * ```ofir
 * import std.os
 *
 * const args = os.args()
 * if args.len() < 2 {
 *     eprintln("usage: tool <file>")
 *     os.exit(2)
 * }
 * ```
 */
pub fn args() List<str> {
    const count = unsafe { ofir_arg_count() }
    let out: List<str> = List.withCapacity(count)
    for i in 0..count {
        let len = 0
        const ptr = unsafe { ofir_arg(i, &mut len as *mut int) }
        out.push(unsafe { str.fromRaw(ptr, len) })
    }
    return out
}

/**
 * The value of an environment variable.
 *
 * @param name the variable
 * @returns `Some(value)`, or `None` when it is not set
 * @example
 * ```ofir
 * import std.os
 *
 * const home = os.env("HOME") ?? "/"
 * ```
 */
pub fn env(name: str) Option<str> {
    let len = 0
    const ptr = unsafe { ofir_env(name.asPtr(), name.len(), &mut len as *mut int) }
    if unsafe { ptr as u64 } == 0 {
        return Option.None
    }
    return Option.Some(unsafe { str.fromRaw(ptr, len) })
}

/**
 * Ends the process at once. Standard output is flushed; no value is
 * dropped.
 *
 * @param code the exit status: 0 for success
 * @returns never: the process ends
 */
pub fn exit(code: int) ! {
    unsafe {
        ofir_exit(code)
    }
}

/**
 * Ends the process at once, abnormally: by `SIGABRT` (exit status 134 in a
 * shell; 3 on Windows). Standard output is not flushed, no value is dropped
 * and no exit handler runs.
 *
 * @returns never: the process ends
 */
pub fn abort() ! {
    unsafe {
        ofir_abort()
    }
}

/**
 * What a program run by `run` did.
 */
pub struct Output {
    /** Its exit status, or -1 when a signal ended it. */
    pub status: int
    /** What it wrote to standard output. */
    pub stdout: str
    /** What it wrote to standard error. */
    pub stderr: str
}

// The layout of the runtime's OfirRun.
struct Captured {
    status: int
    out: Buffer
    err: Buffer
}

/**
 * A program started by `spawn`, running beside this one. Its standard
 * output and error are captured until `wait` returns them. A child dropped
 * without `wait` is waited for, and its output discarded.
 */
pub struct Child {
    handle: *mut u8

    fn drop(mut self) {
        unsafe {
            ofir_child_free(self.handle)
        }
    }

    /**
     * Waits for the program to end.
     *
     * @returns its exit status and what it wrote
     */
    pub fn wait(move self) Result<Output, IoError> {
        let captured = Captured{status: 0, out: Buffer.new(), err: Buffer.new()}
        unsafe {
            ofir_wait(self.handle, &mut captured as *mut Captured)
        }
        return Result.Ok(Output{status: captured.status, stdout: unsafe { captured.out.intoStr() },
                          stderr: unsafe { captured.err.intoStr() }})
    }
}

/**
 * Starts a program without waiting for it, capturing its output. The
 * program is looked up in `PATH` when its name has no `/`. Its output goes
 * to temporary files, so a program that writes a lot never blocks.
 *
 * @param program the program to run
 * @param args its arguments, without the program itself
 * @returns the running program; `Err` when it cannot be started
 * @example
 * ```ofir no_run
 * import std.os
 *
 * const a = os.spawn("clang", ["-c", "a.c"]).expect("clang starts")
 * const b = os.spawn("clang", ["-c", "b.c"]).expect("clang starts")
 * const statusA = a.wait().expect("clang ends").status
 * const statusB = b.wait().expect("clang ends").status
 * ```
 */
pub fn spawn(program: str, args: [str]) Result<Child, IoError> {
    let packed = "{program}\0"
    for i in 0..args.len() {
        packed.push(args[i])
        packed.push("\0")
    }
    let handle = unsafe { 0 as *mut u8 }
    io.check(unsafe {
        ofir_spawn(packed.asPtr(), packed.len(), args.len() + 1, &mut handle as *mut *mut u8)
    })?
    return Result.Ok(Child{handle: handle})
}

/**
 * Runs a program and waits for it to end, capturing its output: `spawn`
 * followed by `wait`.
 *
 * @param program the program to run
 * @param args its arguments, without the program itself
 * @returns its exit status and output; `Err` when it cannot be started
 * @example
 * ```ofir
 * import std.os
 *
 * const out = os.run("clang", ["--version"]).expect("clang is installed")
 * println(out.stdout)
 * ```
 */
pub fn run(program: str, args: [str]) Result<Output, IoError> {
    const child = spawn(program, args)?
    return child.wait()
}

/**
 * The number of processors the system has online, for choosing how many
 * programs to run at once.
 *
 * @returns at least 1
 */
pub fn cpuCount() int {
    return unsafe { ofir_cpu_count() }
}

/**
 * The working directory of the process.
 *
 * @returns its absolute path
 */
pub fn currentDir() Result<str, IoError> {
    let out = Buffer.new()
    io.check(unsafe { ofir_current_dir(&mut out as *mut Buffer) })?
    return Result.Ok(unsafe { out.intoStr() })
}

/**
 * The path of the running program's executable.
 *
 * @returns its absolute path
 */
pub fn executablePath() Result<str, IoError> {
    let out = Buffer.new()
    io.check(unsafe { ofir_executable_path(&mut out as *mut Buffer) })?
    return Result.Ok(unsafe { out.intoStr() })
}

/**
 * The operating system the program was compiled for.
 *
 * @returns `"linux"`, `"macos"` or `"windows"`
 */
pub fn name() str {
    let len = 0
    const ptr = unsafe { ofir_os_name(&mut len as *mut int) }
    return unsafe { str.fromRaw(ptr, len) }
}

/**
 * The processor architecture the program was compiled for.
 *
 * @returns `"x86_64"` or `"aarch64"`
 */
pub fn arch() str {
    let len = 0
    const ptr = unsafe { ofir_arch_name(&mut len as *mut int) }
    return unsafe { str.fromRaw(ptr, len) }
}
