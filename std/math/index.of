/**
 * @module
 * `std.math`: float constants and the numeric helpers that are not methods
 * (ADR 0057). The elementary functions are methods of `f32` and `f64`:
 * `x.sin()`, `x.ln()`, `x.powf(y)`.
 */

/** Pi, the ratio of a circle's circumference to its diameter. */
pub const PI: f64 = 3.141592653589793

/** Tau, two pi: a full turn in radians. */
pub const TAU: f64 = 6.283185307179586

/** Euler's number, the base of the natural logarithm. */
pub const E: f64 = 2.718281828459045

/** The square root of 2. */
pub const SQRT_2: f64 = 1.4142135623730951

/** The natural logarithm of 2. */
pub const LN_2: f64 = 0.6931471805599453

/** The natural logarithm of 10. */
pub const LN_10: f64 = 2.302585092994046

/** Positive infinity. */
pub const INFINITY: f64 = 1.0 / 0.0

/** Negative infinity. */
pub const NEG_INFINITY: f64 = -1.0 / 0.0

/** A quiet NaN; compare with `isNan()`, since NaN is not equal to itself. */
pub const NAN: f64 = 0.0 / 0.0

/** The gap between 1.0 and the next larger `f64`. */
pub const EPSILON: f64 = 2.220446049250313e-16

/** The largest finite `f64`. */
pub const MAX: f64 = 1.7976931348623157e308

/** The smallest positive normal `f64`. */
pub const MIN_POSITIVE: f64 = 2.2250738585072014e-308

/**
 * Whether two floats are equal up to rounding: their distance is at most
 * `relTol` times the larger magnitude, or at most `absTol`. NaN is never
 * close to anything; equal infinities are.
 *
 * @param a a value
 * @param b the other value
 * @param relTol the relative tolerance, such as `1e-9`
 * @param absTol the absolute tolerance, for values near zero
 * @returns true when the values are close
 * @example
 * ```ofir
 * import std.math
 * import std.testing.assert
 *
 * assert(0.1 + 0.2 != 0.3)
 * assert(math.approxEq(0.1 + 0.2, 0.3, 1e-9, 0.0))
 * ```
 */
pub fn approxEq(a: f64, b: f64, relTol: f64, absTol: f64) bool {
    if a == b {
        return true
    }
    const diff = (a - b).abs()
    if !diff.isFinite() {
        return false
    }
    return diff <= absTol || diff <= relTol * a.abs().max(b.abs())
}

/**
 * The sum of floats with Neumaier compensation: the rounding error of each
 * step is carried, so the result is as if the sum were computed with
 * twice the precision and rounded once.
 *
 * @param values the values to add
 * @returns their sum; 0.0 for none
 * @example
 * ```ofir
 * import std.math
 * import std.testing.assert
 *
 * const values: List<f64> = [1.0, 1e100, 1.0, -1e100]
 * assert(math.sum(values.asSlice()) == 2.0)
 * ```
 */
pub fn sum(values: &[f64]) f64 {
    let total: f64 = 0.0
    let carry: f64 = 0.0
    for i in 0..values.len() {
        const v = values[i]
        const t = total + v
        if total.abs() >= v.abs() {
            carry = carry + ((total - t) + v)
        } else {
            carry = carry + ((v - t) + total)
        }
        total = t
    }
    return total + carry
}

/**
 * The greatest common divisor.
 *
 * @param a a value
 * @param b the other value
 * @returns the largest positive divisor of both; 0 when both are 0
 * @example
 * ```ofir
 * import std.math
 * import std.testing.assert
 *
 * assert(math.gcd(12, -18) == 6)
 * ```
 */
pub fn gcd(a: int, b: int) int {
    let x = a.abs()
    let y = b.abs()
    for y != 0 {
        const r = x % y
        x = y
        y = r
    }
    return x
}

/**
 * The least common multiple.
 *
 * @param a a value
 * @param b the other value
 * @returns the smallest non-negative common multiple; 0 when either is 0
 */
pub fn lcm(a: int, b: int) int {
    if a == 0 || b == 0 {
        return 0
    }
    return (a / gcd(a, b) * b).abs()
}

/**
 * The integer square root, exact for every `int`.
 *
 * @param n the value, not negative
 * @returns the largest `r` with `r * r <= n`
 * @panics when `n` is negative
 * @example
 * ```ofir
 * import std.math
 * import std.testing.assert
 *
 * assert(math.isqrt(99) == 9)
 * ```
 */
pub fn isqrt(n: int) int {
    if n < 0 {
        panic("isqrt of a negative number")
    }
    let r = (n as f64).sqrt() as int
    for r > 0 && r > n / r {
        r = r - 1
    }
    for r + 1 <= n / (r + 1) {
        r = r + 1
    }
    return r
}
