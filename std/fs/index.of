/**
 * @module
 * `std.fs`: reading and writing files and directories
 * (docs/std/system.md). Paths are strings; they cannot hold a NUL byte
 * (`InvalidInput`).
 */

import std.io.Buffer
import std.io.IoError
import std.io

extern "C" {
    fn ofir_read_file(path: *u8, len: int, out: *mut Buffer) i32
    fn ofir_write_file(path: *u8, len: int, data: *u8, n: int) i32
    fn ofir_append_file(path: *u8, len: int, data: *u8, n: int) i32
    fn ofir_path_exists(path: *u8, len: int) bool
    fn ofir_remove_file(path: *u8, len: int) i32
    fn ofir_remove_dir(path: *u8, len: int) i32
    fn ofir_rename(from: *u8, fromLen: int, to: *u8, toLen: int) i32
    fn ofir_file_info(path: *u8, len: int, size: *mut int, modified: *mut int) i32
    fn ofir_touch(path: *u8, len: int) i32
    fn ofir_canonicalize(path: *u8, len: int, out: *mut Buffer) i32
    fn ofir_create_dir_all(path: *u8, len: int) i32
    fn ofir_read_dir(path: *u8, len: int, out: *mut Buffer) i32
}

/**
 * The contents of a file.
 *
 * @param path the file to read
 * @returns its bytes
 * @example
 * ```ofir
 * import std.fs
 * import std.io
 *
 * fn size() Result<int, io.IoError> {
 *     const bytes = fs.read("data.bin")?
 *     return Result.Ok(bytes.len())
 * }
 *
 * const _ = size()
 * ```
 */
pub fn read(path: str) Result<List<u8>, IoError> {
    let out = Buffer.new()
    io.check(unsafe { ofir_read_file(path.asPtr(), path.len(), &mut out as *mut Buffer) })?
    return Result.Ok(unsafe { out.intoList() })
}

/**
 * The contents of a text file.
 *
 * @param path the file to read
 * @returns its text
 * @example
 * ```ofir
 * import std.fs
 * import std.io
 *
 * fn length() Result<int, io.IoError> {
 *     const text = fs.readToString("notes.txt")?
 *     return Result.Ok(text.len())
 * }
 *
 * const _ = length()
 * ```
 */
pub fn readToString(path: str) Result<str, IoError> {
    let out = Buffer.new()
    io.check(unsafe { ofir_read_file(path.asPtr(), path.len(), &mut out as *mut Buffer) })?
    return Result.Ok(unsafe { out.intoStr() })
}

/**
 * Writes bytes to a file, which is created or truncated.
 *
 * @param path the file to write
 * @param data its new contents
 * @returns `Ok(())` once everything is written
 */
pub fn write(path: str, data: [u8]) Result<(), IoError> {
    return io.check(unsafe {
        ofir_write_file(path.asPtr(), path.len(), data.asPtr(), data.len())
    })
}

/**
 * Writes text to a file, which is created or truncated.
 *
 * @param path the file to write
 * @param text its new contents
 * @returns `Ok(())` once everything is written
 * @example
 * ```ofir no_run
 * import std.fs
 *
 * fs.writeString("out.txt", "hello\n").expect("out.txt is writable")
 * ```
 */
pub fn writeString(path: str, text: str) Result<(), IoError> {
    return io.check(unsafe {
        ofir_write_file(path.asPtr(), path.len(), text.asPtr(), text.len())
    })
}

/**
 * Adds bytes at the end of a file, which is created if it is missing.
 *
 * @param path the file to add to
 * @param data the bytes to add
 * @returns `Ok(())` once everything is written
 */
pub fn append(path: str, data: [u8]) Result<(), IoError> {
    return io.check(unsafe {
        ofir_append_file(path.asPtr(), path.len(), data.asPtr(), data.len())
    })
}

/**
 * Adds text at the end of a file, which is created if it is missing.
 *
 * @param path the file to add to
 * @param text the text to add
 * @returns `Ok(())` once everything is written
 * @example
 * ```ofir no_run
 * import std.fs
 *
 * fs.appendString("app.log", "started\n").expect("app.log is writable")
 * ```
 */
pub fn appendString(path: str, text: str) Result<(), IoError> {
    return io.check(unsafe {
        ofir_append_file(path.asPtr(), path.len(), text.asPtr(), text.len())
    })
}

/**
 * Copies the contents of a file; `to` is created or replaced. The
 * permissions and times are not copied.
 *
 * @param from the file to read
 * @param to the file to write
 * @returns `Ok(())` once `to` holds the contents
 */
pub fn copyFile(from: str, to: str) Result<(), IoError> {
    const data = read(from)?
    return write(to, data.asSlice())
}

/**
 * Whether a file or directory exists at `path`.
 *
 * @param path the path to look at
 * @returns true if it exists and can be reached
 */
pub fn exists(path: str) bool {
    return unsafe { ofir_path_exists(path.asPtr(), path.len()) }
}

/**
 * The absolute path of an existing file or directory, with no `.`, `..`
 * or symbolic link left in it.
 *
 * @param path the path to resolve
 * @returns the canonical path
 * @example
 * ```ofir
 * import std.fs
 * import std.testing.assert
 *
 * const here = fs.canonicalize(".").expect("the current directory exists")
 * assert(fs.exists(here))   // an absolute path, also on Windows
 * ```
 */
pub fn canonicalize(path: str) Result<str, IoError> {
    let out = Buffer.new()
    io.check(unsafe { ofir_canonicalize(path.asPtr(), path.len(), &mut out as *mut Buffer) })?
    return Result.Ok(unsafe { out.intoStr() })
}

/**
 * Creates a directory and the missing directories above it.
 *
 * @param path the directory to create
 * @returns `Ok(())`, also when it exists already
 */
pub fn createDirAll(path: str) Result<(), IoError> {
    return io.check(unsafe { ofir_create_dir_all(path.asPtr(), path.len()) })
}

/**
 * Removes a file.
 *
 * @param path the file to remove
 * @returns `Ok(())` once it is gone
 */
pub fn removeFile(path: str) Result<(), IoError> {
    return io.check(unsafe { ofir_remove_file(path.asPtr(), path.len()) })
}

/**
 * Removes an empty directory.
 *
 * @param path the directory to remove
 * @returns `Ok(())` once it is gone; an error when it is not empty
 */
pub fn removeDir(path: str) Result<(), IoError> {
    return io.check(unsafe { ofir_remove_dir(path.asPtr(), path.len()) })
}

/**
 * Renames a file, replacing `to` if it exists.
 *
 * @param from the file to rename
 * @param to its new path, on the same file system
 * @returns `Ok(())` once it is moved
 */
pub fn rename(from: str, to: str) Result<(), IoError> {
    return io.check(unsafe { ofir_rename(from.asPtr(), from.len(), to.asPtr(), to.len()) })
}

/**
 * The size and modification time of a file.
 */
pub struct Metadata {
    /** The size in bytes. */
    pub size: int
    /** The modification time, in nanoseconds since 1970 (UTC). */
    pub modified: int
}

/**
 * The size and modification time of a file.
 *
 * @param path the file to look at; symbolic links are followed
 * @returns its metadata
 */
pub fn metadata(path: str) Result<Metadata, IoError> {
    let size = 0
    let modified = 0
    io.check(unsafe {
        ofir_file_info(path.asPtr(), path.len(), &mut size as *mut int, &mut modified as *mut int)
    })?
    return Result.Ok(Metadata{size: size, modified: modified})
}

/**
 * Sets the modification time of a file to now.
 *
 * @param path the file, which must exist
 * @returns `Ok(())` once it is updated
 */
pub fn touch(path: str) Result<(), IoError> {
    return io.check(unsafe { ofir_touch(path.asPtr(), path.len()) })
}

/**
 * An entry of a directory.
 */
pub struct DirEntry {
    /** The name of the entry, without the directory. */
    pub name: str
    /** The directory and the name, joined by `/`. */
    pub path: str
}

/**
 * The entries of a directory, sorted by name so that programs behave the
 * same everywhere; `.` and `..` are left out.
 *
 * @param path the directory to read
 * @returns its entries
 * @example
 * ```ofir
 * import std.fs
 *
 * for entry in fs.readDir(".").expect("the current directory exists") {
 *     println(entry.name)
 * }
 * ```
 */
pub fn readDir(path: str) Result<List<DirEntry>, IoError> {
    let out = Buffer.new()
    io.check(unsafe { ofir_read_dir(path.asPtr(), path.len(), &mut out as *mut Buffer) })?
    const names = unsafe { out.intoStr() }
    let entries: List<DirEntry> = []
    for name in names.split("\0") {
        if name.len() > 0 {
            entries.push(DirEntry{name: name.toOwned(), path: "{path}/{name}"})
        }
    }
    return Result.Ok(entries)
}
