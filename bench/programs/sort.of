// Sorting a million pseudo-random integers with the standard library sort.

fn main() {
    const n = 1000000
    let xs = List<int>.withCapacity(n)
    let seed = 42
    for _ in 0..n {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(seed)
    }
    xs.sort()
    let sum = 0
    let i = 0
    for i < n {
        sum += xs[i] % 1000 * (i % 7)
        i += 1000
    }
    println("{xs[0]} {xs[n / 2]} {xs[n - 1]} {sum}")
}
