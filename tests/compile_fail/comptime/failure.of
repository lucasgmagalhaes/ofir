// requires: stage1
// A compile-time panic, arithmetic or bounds error, deep recursion or a
// spent step budget fails the build (spec 15.5, E0816).

fn add(x: u8, y: u8) u8 {
    return x + y
}

fn divide(x: int, y: int) int {
    return x / y
}

fn pick(i: int) int {
    const a: [int; 3] = [1, 2, 3]
    return a[i]
}

fn down(n: int) int {
    return down(n + 1)
}

fn check(n: int) int {
    if n > 2 {
        panic("too big: {n}")
    }
    return n
}

fn main() {
    const b = comptime add(200, 100)   // error[E0816]: compile-time evaluation failed: arithmetic overflow
    const c = comptime divide(1, 0)   // error[E0816]: compile-time evaluation failed: division by zero
    const d = comptime pick(3)   // error[E0816]: compile-time evaluation failed: index 3 out of bounds for length 3
    const e = comptime down(0)   // error[E0816]: compile-time evaluation failed: calls nested more than 128 deep
    const f = comptime check(5)   // error[E0816]: compile-time evaluation failed: it panicked: too big: 5
    println("{b} {c} {d} {e} {f} {budgeted()}")
}

@comptimeBudget(1000)
fn budgeted() int {
    return comptime small2()   // error[E0816]: compile-time evaluation failed: it ran out of its budget of 1000 steps (`@comptimeBudget(n)`)
}

fn small2() int {
    let total = 0
    for i in 0..100000 {
        total += i
    }
    return total
}
