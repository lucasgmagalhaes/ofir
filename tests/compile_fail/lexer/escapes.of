// Malformed escapes and exponents (spec 1.4, 1.5).

fn main() {
    const _a = "\xZZ"   // error[E0004]: `\x` escapes in strings must be between \x00 and \x7f
    const _b = "\u41"   // error[E0004]: invalid unicode escape
    const _c = "\u{1234567"   // error[E0004]: invalid unicode escape
    const _d = 1.5e+   // error[E0005]: invalid float literal
}
