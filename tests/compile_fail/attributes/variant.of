// requires: stage1
// Only `@tag` applies to an enum variant (spec 15.4).

enum Color {
    @tag("json", "red")
    Red
    @inline   // error[E0808]: the attribute `@inline` does not apply to a variant
    Green
    @cfg(debug)   // error[E0808]: the attribute `@cfg` does not apply to a variant
    Blue
}

fn main() {
    const _ = Color.Red
}
