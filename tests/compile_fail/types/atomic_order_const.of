// A named constant is not an ordering an atomic operation can read: the
// ordering is written as `Ordering.X` (ADR 0042, spec 14.4).

import std.mem.atomic

let COUNT: int = 5
const ORDER: atomic.Ordering = atomic.Ordering.SeqCst

fn main() {
    unsafe {
        const a: int = atomic.atomicLoad(&mut COUNT as *mut int, ORDER)   // error[E0820]: the memory ordering of an atomic operation must be a constant
        println("{a}")
    }
}
