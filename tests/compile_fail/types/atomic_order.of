// The ordering of an atomic operation is a constant that the operation
// allows (ADR 0042, spec 14.4).

import std.mem.atomic

let COUNT: int = 5

fn get(order: atomic.Ordering) int {
    unsafe {
        return atomic.atomicLoad(&mut COUNT as *mut int, order)   // error[E0820]: the memory ordering of an atomic operation must be a constant
    }
}

fn main() {
    unsafe {
        const p = &mut COUNT as *mut int
        const a: int = atomic.atomicLoad(p, atomic.Ordering.Release)   // error[E0821]: `atomicLoad` does not allow the ordering `Release`
        atomic.atomicStore(p, 1, atomic.Ordering.Acquire)   // error[E0821]: `atomicStore` does not allow the ordering `Acquire`
        atomic.fence(atomic.Ordering.Relaxed)   // error[E0821]: `fence` does not allow the ordering `Relaxed`
        println("{a} {get(atomic.Ordering.SeqCst)}")
    }
}
