// A `where` clause bounds the type parameters of its declaration only
// (spec 8.1).

fn bad<T>(_a: T)
where
    int: Eq,   // error[E0334]: `int` is not a type parameter of this declaration: only type parameters take bounds
{
}

fn generic<T>(_a: T)
where
    List<T>: Eq,   // error[E0334]: `List<T>` is not a type parameter of this declaration: only type parameters take bounds
    &T: Eq,   // error[E0334]: `&T` is not a type parameter of this declaration: only type parameters take bounds
{
}

struct Plain {
    x: int

    fn get(self) int where int: Eq {   // error[E0334]: `int` is not a type parameter of this declaration: only type parameters take bounds
        return self.x
    }
}

fn main() {
    const p = Plain{x: 1}
    const _g = p.get()
}
