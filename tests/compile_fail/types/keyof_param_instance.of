// requires: stage1
// A parameter of type `keyof T` in an instance where `T` is not a struct or
// tuple (spec 16.1): the call has no keys to give it.

enum Color {
    Red
    Green
}

fn keyed<T>(_value: T, _key: keyof T) {}

fn main() {
    keyed((1, 2), .0)
    keyed(Late{x: 1}, .x)
    keyed(Color.Red, 5)   // error[E0340]: `keyof` needs a struct or tuple type, found `Color`
    keyed(3, 5)   // error[E0340]: `keyof` needs a struct or tuple type, found `int`
}

// Declared after `Color`, so `Color` has an empty fields slot.
struct Late {
    x: int
}
