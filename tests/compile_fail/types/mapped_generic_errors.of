// requires: stage1
// Errors in the bodies and filters of generic mapped aliases (spec 16.4).

struct Point {
    x: float
    y: int
}

type BadType<T> = { [K in keyof T]: Nope }   // error[E0200]: cannot find type `Nope` in this scope
type Partial<T> = { [K in keyof T]?: T[K] }
type Only<C> = { [K in keyof Point if C]: int }   // error[E0344]: the condition of a conditional type is not decided for `C`

fn f<T>(a: &BadType<T>) {
}

fn other<T, U, K: keyof T>(a: &Partial<U>, k: K) {
    const _v = a[k]   // error[E0341]: the keys of `K` may not be keys of `Partial<U>`: bound it by `keyof Partial<U>`
}

fn only<C>(a: &Only<C>) {
}

fn main() {
    f<Point>(panic("x"))
}
