// requires: stage1
// Mapped types that later roadmap steps support: E0901.
struct Point {
    x: float
}
type Wrapped<T> = Option<{ [K in keyof T]: T[K] }>   // error[E0901]: mapped types over type parameters are not supported yet
fn wrapped<T>(p: Wrapped<T>) {}
fn inline(p: { [K in .a]: int }) {}   // error[E0901]: mapped types outside a type alias are not supported yet
