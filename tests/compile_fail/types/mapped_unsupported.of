// requires: stage1
// Mapped types that later roadmap steps support: E0901.
struct Point {
    x: float
}
type Pick<T, K: keyof T> = { [P in K]: T[P] }   // error[E0901]: mapped types over type parameters are not supported yet
type Ints<T> = { [K in keyof T if T[K] is int]: T[K] }   // error[E0901]: mapped types over type parameters are not supported yet
fn generic<T, K: keyof T>(p: Pick<T, K>) {}
fn filtered<T>(p: Ints<T>) {}
fn inline(p: { [K in .a]: int }) {}   // error[E0901]: mapped types outside a type alias are not supported yet
