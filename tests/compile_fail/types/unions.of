// requires: stage1
// Union types (spec 17.1): E0350, E0351.

struct Point {
    x: int
}

type PointRef = &Point
type Nothing = !

type A = int | PointRef   // error[E0351]: type `&Point` cannot be a member of a union
type B = int | Nothing   // error[E0351]: type `!` cannot be a member of a union
type D = int | keyof Point   // error[E0351]: type `int` cannot be a member of a union of keys

fn bare<T>(x: T | int) {   // error[E0350]: the members `T` and `int` of a union can be the same type
}

fn lists<T>(x: List<T> | List<int>) {   // error[E0350]: the members `List<T>` and `List<int>` of a union can be the same type
}

type Pair<T> = [T; 2]
type IntOrStr = int | str
type IntOrBool = int | bool

// Members whose type arguments, or array elements, never unify do not overlap.
fn nested<T>(x: Option<Option<T>> | Option<List<T>>, y: Pair<Option<T>> | Pair<List<T>>) {
}

// Every member of `int | str` must be a member of the target to widen.
fn widen(u: IntOrStr) IntOrBool {
    return u   // error[E0300]: mismatched types: expected bool | int, found int | str
}

// A union has no methods: the message names the union.
fn call(u: IntOrStr) {
    u.foo()   // error[E0301]: no method `foo` on type `int | str`
}

fn aliases(a: A, b: B, d: D) {
}

fn main() {
}
