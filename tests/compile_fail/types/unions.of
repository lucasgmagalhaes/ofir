// requires: stage1
// Union types (spec 17.1): E0350, E0351.

struct Point {
    x: int
}

type PointRef = &Point
type Nothing = !

type A = int | PointRef   // error[E0351]: type `&Point` cannot be a member of a union
type B = int | Nothing   // error[E0351]: type `!` cannot be a member of a union
type D = int | keyof Point   // error[E0351]: type `int` cannot be a member of a union of keys

fn bare<T>(x: T | int) {   // error[E0350]: the members `T` and `int` of a union can be the same type
}

fn lists<T>(x: List<T> | List<int>) {   // error[E0350]: the members `List<T>` and `List<int>` of a union can be the same type
}

fn aliases(a: A, b: B, d: D) {
}

fn main() {
}
