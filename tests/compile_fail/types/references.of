struct Holder {
    value: &int                  // error[E0702]: a reference cannot be stored in a struct field: store an owned value, or declare a `ref struct`
}

enum Either {
    Left(&str)
    Right(&[int])                // error[E0702]: a reference cannot be stored in an enum variant: store an owned value, or declare a `ref struct`
}

fn noSource(a: int, b: int) &int {   // error[E0702]: a function that returns a reference must borrow it from `self` or from its only borrowed parameter, which it has none of
    return &a
}

fn twoSources(a: List<int>, b: List<int>) &int {   // error[E0702]: a function that returns a reference must borrow it from `self` or from its only borrowed parameter, which it has several of
    return &a[0]
}

fn dangling(xs: List<int>) &int {
    const local = 5
    return &local                // error[E0702]: cannot return a reference to `local`, which ends with the function
}

enum Wrapped {
    One(List<int>)
    Two(List<int>)
}

// A binding of a `match` on a borrowed value is a copy that ends with the
// function; the elements it points to outlive it.
fn inside(w: &Wrapped) &List<int> {
    return match *w {
        Wrapped.One(list) => &list      // error[E0702]: cannot return a reference to `list`, which ends with the function
        Wrapped.Two(list) => {
            &list                // error[E0702]: cannot return a reference to `list`, which ends with the function
        }
    }
}

fn element(w: &Wrapped) &int {
    return match *w {
        Wrapped.One(list) => &list[0]
        Wrapped.Two(list) => &list[1]
    }
}

// A temporary ends with its statement, and so before the caller could use
// a borrow of it; a reference or a view on the way reaches the caller's data.
struct Pair {
    left: int
    right: int
}

fn makePair(n: int) Pair {
    return Pair{left: n, right: n}
}

fn sum(r: &int) &int {
    return &(*r + 1)             // error[E0702]: cannot return a reference to a temporary value, which ends with the function
}

fn literal(r: &int) &int {
    return &5                    // error[E0702]: cannot return a reference to a temporary value, which ends with the function
}

fn fieldOfCall(r: &int) &int {
    return &makePair(*r).left    // error[E0702]: cannot return a reference to a temporary value, which ends with the function
}

fn someOfTemporary(r: &int) Option<&int> {
    return Option.Some(&(*r * 2))   // error[E0702]: cannot return a reference to a temporary value, which ends with the function
}

fn eitherTemporary(r: &int, first: bool) &int {
    return if first {
        &(*r + 1)                // error[E0702]: cannot return a reference to a temporary value, which ends with the function
    } else {
        r
    }
}

fn throughView(xs: List<int>) &int {
    return &xs.slice(0, 1)[0]
}

fn byteOfStr(s: &str) &u8 {
    return &s[0]                 // error[E0702]: cannot return a reference to a temporary value, which ends with the function
}

fn newView(xs: &List<int>) & &[int] {
    return &xs[0..2]             // error[E0702]: cannot return a reference to a temporary value, which ends with the function
}

fn main() {
    const n = 1
    const r = &mut n               // error[E0315]: this value cannot be modified: declare it with `let`
    let m = 2
    const shared = &m
    *shared = 3                  // error[E0315]: this value cannot be modified: it is reached through a `&T`, not a `&mut T`
    const xs = [1, 2, 3]
    const view = xs[0..2]
    view[0] = 5                  // error[E0315]: this value cannot be modified: the elements of a `&[T]` are read-only
    const refs = [&m]              // error[E0702]: a reference cannot be stored in a container or a struct: store an owned value, or declare a `ref struct`
    const wrong: &[str] = xs       // error[E0300]: mismatched types: expected Slice<str>, found List<int>
}
