// std.fs and std.io errors (roadmap 3.8): a directory tree in the
// temporary directory, written, read, listed and removed.

import std.fs
import std.io
import std.os

fn check(what: str, result: Result<(), io.IoError>) {
    match result {
        Result.Ok(_) => println("{what}: ok")
        Result.Err(e) => println("{what}: {e.message}")
    }
}

fn main() {
    const base = "{os.env("TMPDIR") ?? "/tmp"}/ofir-fs-test"
    const dir = "{base}/a/b"
    check("createDirAll", fs.createDirAll(dir))
    check("createDirAll again", fs.createDirAll(dir))
    println("exists {fs.exists(dir)} {fs.exists("{dir}/none")}")
    match fs.canonicalize("{dir}/../b/.") {
        Result.Ok(path) => println("canonical {path.endsWith("/ofir-fs-test/a/b")}")
        Result.Err(e) => println("canonicalize: {e.message}")
    }
    match fs.canonicalize("{dir}/none") {
        Result.Ok(_) => println("canonical none")
        Result.Err(e) => println("canonicalize none: {e.message}")
    }
    check("write b", fs.writeString("{dir}/b.txt", "second\n"))
    check("write a", fs.writeString("{dir}/a.txt", "one\r\ntwo\n"))
    check("write bytes", fs.write("{dir}/c.bin", [0, 1, 2, 255]))
    match fs.readToString("{dir}/a.txt") {
        Result.Ok(text) => {
            for line in text.lines() {
                println("line [{line}]")
            }
        }
        Result.Err(e) => println("read: {e.message}")
    }
    match fs.read("{dir}/c.bin") {
        Result.Ok(bytes) => println("bytes {bytes.len()} {bytes[3]}")
        Result.Err(e) => println("read: {e.message}")
    }
    match fs.readDir(dir) {
        Result.Ok(entries) => {
            for i in 0..entries.len() {
                println("entry {entries[i].name} {entries[i].path.endsWith("/b/{entries[i].name}")}")
            }
        }
        Result.Err(e) => println("readDir: {e.message}")
    }
    match fs.metadata("{dir}/c.bin") {
        Result.Ok(info) => println("metadata {info.size} {info.modified > 0}")
        Result.Err(e) => println("metadata: {e.message}")
    }
    check("touch", fs.touch("{dir}/c.bin"))
    check("touch missing", fs.touch("{dir}/none"))
    check("rename", fs.rename("{dir}/b.txt", "{dir}/c.bin"))
    match fs.readToString("{dir}/c.bin") {
        Result.Ok(text) => print("renamed {text}")
        Result.Err(e) => println("read: {e.message}")
    }
    check("rename missing", fs.rename("{dir}/b.txt", "{dir}/d.txt"))
    match fs.metadata("{dir}/b.txt") {
        Result.Ok(_) => println("metadata b")
        Result.Err(e) => println("metadata gone {e.kind == io.IoErrorKind.NotFound}")
    }
    for name in ["a.txt", "c.bin"] {
        check("remove {name}", fs.removeFile("{dir}/{name}"))
    }
    match fs.readToString("{dir}/a.txt") {
        Result.Ok(_) => println("still there")
        Result.Err(e) => println("gone {e.kind == io.IoErrorKind.NotFound}")
    }
    check("remove missing", fs.removeFile("{dir}/a.txt"))
    check("append new", fs.appendString("{dir}/log.txt", "one\n"))
    check("append more", fs.append("{dir}/log.txt", [116, 119, 111, 10]))
    check("copyFile", fs.copyFile("{dir}/log.txt", "{dir}/copy.txt"))
    match fs.readToString("{dir}/copy.txt") {
        Result.Ok(text) => print("copied {text}")
        Result.Err(e) => println("read: {e.message}")
    }
    check("copyFile missing", fs.copyFile("{dir}/none", "{dir}/other.txt"))
    match fs.removeDir(dir) {
        Result.Ok(_) => println("removeDir full: removed")
        Result.Err(_) => println("removeDir full: refused")
    }
    for name in ["log.txt", "copy.txt"] {
        check("remove {name}", fs.removeFile("{dir}/{name}"))
    }
    check("removeDir", fs.removeDir(dir))
    println("exists after removeDir {fs.exists(dir)}")
    check("removeDir missing", fs.removeDir(dir))
    check("bad path", fs.writeString("a\0b", ""))
}
