// Spec 1.3: where a newline ends a statement and where it is ignored.
fn add(a: int, b: int) int {
    return a + b
}

fn main() {
    const ok = 3 > 0 &&
        2 > 0
    const total = add(
        1,
        2,
    )
    const list = [
        10,
        20,
    ]
    const sum = list[0] +
        list[1] *
        2
    // Inside a block in parentheses, newlines end statements and arms again.
    const twice = add(if ok {
        const y = 4 * 2
        y + 1
    } else {
        0
    }, match total {
        3 => 100
        _ => 0
    })
    const nested = add(add(1,
        2), [3,
        4][1])
    println("{ok} {total} {sum} {twice} {nested}")
    let n = 1
    n +=
        2
    const neg = n
    -1          // a new statement: `neg` is 3
    println("{n} {neg}")
}
