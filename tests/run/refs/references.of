// `&x`, `&mut x`, reading and writing through references, fields and
// methods through them, and functions returning a borrow.

struct Point {
    x: int
    y: int

    fn sum(self) int {
        return self.x + self.y
    }

    fn shift(mut self, by: int) {
        self.x += by
    }

    // A borrow of a field of `self`: `self` is passed by address.
    fn xRef(self) &int {
        return &self.x
    }

    fn yMut(mut self) &mut int {
        return &mut self.y
    }
}

struct Team {
    name: str
    members: List<str>
}

fn bump(r: &mut int) {
    *r += 1
}

// The only borrowed parameter lends the result.
fn longest(team: Team) &str {
    let best = &team.members[0]
    for i in 1..team.members.len() {
        if team.members[i].len() > best.len() {
            best = &team.members[i]
        }
    }
    return best
}

// A borrow that a parameter holds, returned through a dereference.
fn inner(r: & &int) &int {
    return *r
}

fn innerOf(r: & &int, first: bool) &int {
    return if first { *r } else { *r }
}

// A byte of a borrowed `str` lives with the caller's string.
fn firstByte(s: &str) &u8 {
    return &s[0]
}

fn main() {
    let n = 1
    const r = &n
    println("{*r} {r}")
    let m = 10
    const w = &mut m
    *w = 20
    bump(&mut m)
    println("{m}")

    let p = Point{x: 1, y: 2}
    const pr = &mut p
    pr.x = 5
    pr.shift(10)
    println("{pr.sum()} {p.x}")
    println("{*p.xRef()}")
    *p.yMut() = 40
    println("{p.y}")

    const team = Team{name: "core", members: ["ana", "bartholomew", "cy"]}
    println(longest(team))

    let xs = [10, 20, 30]
    if const Option.Some(first) = xs.get(0) {
        println("first {first}")
    }
    println("{xs.get(5).isNone()} {*xs.last().unwrap()}")
    if const Option.Some(slot) = xs.getMut(1) {
        *slot = 21
    }
    println("{xs[1]}")
    const seven = 7
    const rs = &seven
    println("{*inner(&rs)} {*innerOf(&rs, false)}")
    println("{*firstByte("abc")}")
}
