// A `&T` or `&mut T` is passed to a parameter of type `T` as it is: the
// parameter borrows it already (spec 5.6).

fn total(xs: List<int>) int {
    let sum = 0
    for x in xs {
        sum += x
    }
    return sum
}

fn reset(xs: mut List<int>) {
    xs.clear()
    xs.push(7)
}

fn count<T>(xs: List<T>) int {
    return xs.len()
}

fn size(s: str) int {
    return s.len()
}

ref struct View {
    items: &List<int>
}

struct Bag {
    items: List<int>

    fn add(mut self, xs: List<int>) {
        for x in xs {
            self.items.push(x)
        }
    }
}

fn main() {
    let nums = [1, 2, 3]
    const r = &nums
    println("{total(r)} {count(r)}")
    const v = View { items: &nums }
    println("{total(v.items)}")
    let bag = Bag { items: [] }
    bag.add(r)
    println("{bag.items.len()}")
    const m = &mut nums
    reset(m)
    println("{total(m)}")
    println("{total(nums)}")
    const word = "ofir"
    const w = &word
    println("{size(w)}")
}
