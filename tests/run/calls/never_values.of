// requires: stage1
// Calls that never return (spec 2.15) through a fn value and through a
// `dyn` method, and a closure whose body evaluates a `comptime` call.

interface Fails {
    fn fail(self) !
}

struct Loud {
    code: int

    fn fail(self) ! {
        panic("code {self.code}")
    }
}

fn boom() ! {
    panic("boom")
}

fn twice(n: int) int {
    return n * 2
}

fn maybe(f: &dyn Fails, go: bool) {
    if go {
        f.fail()
    }
}

fn main() {
    const f = boom
    if false {
        f()
    }
    maybe(&Loud { code: 1 }, false)
    const g = (x: int) int => x + comptime twice(3)
    println("{g(1)}")
}
