// Integers are formatted with the right digits at every length boundary,
// for signed and unsigned values (spec 2.1).

fn main() {
    let value = 1
    for _ in 0..18 {
        println("{value - 1} {value} {-value}")
        value = value * 10
    }
    println("{value - 1} {value} {-value}")
    println("{9223372036854775807} {-9223372036854775807 - 1}")
    const big: u64 = 18446744073709551615
    const ten: u64 = 10000000000000000000
    println("{big} {ten} {ten - 1}")
    let s = ""
    s.push("{42}{-7}{0}")
    println(s)
}
