// requires: stage1
// A thousand tasks alive at once (ADR 0050): each blocks until a gate
// opens, then hands back its result; nothing is lost or joined twice.
import std.sync.Arc
import std.sync.WaitGroup
import std.task

fn main() {
    const n = 1000
    const gate = Arc.new(WaitGroup.new())
    gate.get().add(1)
    const started = Arc.new(WaitGroup.new())
    started.get().add(n)
    let tasks = List<task.Task<int>>.new()
    for i in 0..n {
        const g = gate.clone()
        const s = started.clone()
        tasks.push(task.run(move () int => {
            s.get().done()
            g.get().wait()
            i * 2
        }))
    }
    started.get().wait()
    println("{n} tasks waiting at the gate")
    gate.get().done()
    let sum = 0
    let joined = 0
    for tasks.len() > 0 {
        sum += tasks.pop().unwrap().join()
        joined += 1
    }
    println("joined {joined}, sum {sum}")
}
