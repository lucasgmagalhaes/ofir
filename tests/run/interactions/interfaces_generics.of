// requires: stage1
// sections: 8.1 8.2 9.2 9.6
// Interfaces and generics: a generic type bounded by an interface calls
// it on each element, and a generic function forwards its bound.

interface Shape {
    fn area(self) int
    fn name(self) str
}

struct Rect {
    w: int
    h: int

    fn area(self) int {
        return self.w * self.h
    }

    fn name(self) str {
        return "rect"
    }
}

struct Square {
    side: int

    fn area(self) int {
        return self.side * self.side
    }

    fn name(self) str {
        return "square"
    }
}

struct Group<T: Shape> {
    items: List<T>

    fn total(self) int {
        let sum = 0
        for item in self.items {
            sum += item.area()
        }
        return sum
    }

    fn largest(self) str {
        let best = 0
        let name = "none"
        for item in self.items {
            if item.area() > best {
                best = item.area()
                name = item.name()
            }
        }
        return "{name} {best}"
    }
}

fn describe<T: Shape>(g: Group<T>) str {
    return "{g.items.len()} shapes, {g.total()}, largest {g.largest()}"
}

fn twice(s: Shape) int {
    return s.area() * 2
}

fn main() {
    const rects = Group{items: [Rect{w: 2, h: 3}, Rect{w: 4, h: 1}]}
    const squares = Group{items: [Square{side: 3}]}
    println(describe(rects))
    println(describe(squares))
    println("{twice(rects.items[0])} {twice(squares.items[0])}")
}
