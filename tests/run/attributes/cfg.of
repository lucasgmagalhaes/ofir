// requires: stage1
// requires: unix
// `@cfg` removes the declarations whose condition is false (spec 12.4).

import std.os

@cfg(os == "linux" || os == "macos")
fn family() str {
    return "unix"
}

@cfg(os == "windows")
fn family() str {
    return "windows"
}

@cfg(os == "windows")
import std.missing.module

@cfg(arch == "x86_64" || arch == "aarch64")
const KNOWN_ARCH: bool = true

@cfg(!(arch == "x86_64" || arch == "aarch64"))
const KNOWN_ARCH: bool = false

@cfg(debug)
fn mode() str {
    return "debug"
}

@cfg(!debug)
fn mode() str {
    return "release"
}

// Only the removing condition is checked, not the other attributes.
@cfg(os == "windows")
@notYetKnown(1)
fn later() {
}

@cfg(test)
fn undefinedOutsideTests() int {
    return missing()
}

struct Config {
    name: str
    @cfg(os == "windows")
    drive: str
    @cfg(os != "windows")
    root: str

    @cfg(os != "windows")
    fn path(self) str {
        return "{self.root}{self.name}"
    }

    @cfg(os == "windows")
    fn path(self) str {
        return "{self.drive}:\\{self.name}"
    }
}

@cfg(os == "windows")
extern "C" {
    fn GetTickCount() u32
}

enum Mode {
    Fast
    Slow

    @cfg(os == "windows")
    fn label(self) str {
        return "windows"
    }

    @cfg(os != "windows")
    fn label(self) str {
        return "unix"
    }
}

interface Named {
    @cfg(os == "windows")
    fn drive(self) str

    fn name(self) str
}

struct File {
    n: str

    fn name(self) str {
        return self.n.clone()
    }
}

fn nameOf(x: &dyn Named) str {
    return x.name()
}

extern "C" {
    @cfg(os == "windows")
    fn GetTickCount64() u64

    fn abs(x: i32) i32
}

fn main() {
    println(family())
    println("{KNOWN_ARCH} {mode()}")
    const matches = os.name() == "linux" || os.name() == "macos"
    println("{matches}")
    const c = Config{name: "etc", root: "/"}
    println(c.path())
    println(Mode.Fast.label())
    println(nameOf(&File{n: "x"}))
    const three = unsafe { abs(-3) }
    println("{three}")
}
