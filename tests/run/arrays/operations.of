// requires: stage1
// An array has the methods of `&[T]`, `a[lo..hi]` slices it, `==` compares
// arrays and slices element by element and `{a:?}` prints the elements
// (spec 2.7, 9.9; ADR 0047).

ref struct View {
    xs: &[int]
}

fn total(xs: &[int]) int {
    let s = 0
    for x in xs {
        s += x
    }
    return s
}

fn main() {
    const a: [int; 4] = [3, 1, 2, 5]
    const r = &a
    println("{a.len()} {a.isEmpty()} {r.len()} {a.first():?} {r.last():?}")
    println("{a.get(1):?} {a.get(4):?}")
    const part = a[1..3]
    println("{part:?} {total(part)} {total(a[2..])} {r[..2]:?}")

    const b: [int; 4] = [3, 1, 2, 5]
    const c: [int; 4] = [3, 1, 2, 6]
    println("{a == b} {a == c} {a != c} {a[0..3] == c[0..3]}")
    const l1: List<int> = [5, 6]
    const l2: List<int> = [5, 6]
    const x: &[int] = l1.asSlice()
    const y: &[int] = l2.asSlice()
    println("{x == y} {x != y} {x == a[0..2]}")

    const grid: [[bool; 2]; 2] = [[true, false], [false, true]]
    const same: [[bool; 2]; 2] = [[true, false], [false, true]]
    println("{grid:?} {grid == same} {x:?} {&a:?}")
    println("{View{xs: x} == View{xs: y}}")
}
