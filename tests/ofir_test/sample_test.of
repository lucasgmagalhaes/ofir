// The tests of sample.of, in its test file (spec 12.2).

@test
fn addWorks() {
    // Keep this test running while later tests finish, to check output order.
    let total = 0
    for i in 0..3000000 {
        total += i % 2
    }
    assert(total == 1500000)
    assert(add(2, 2) == 4)
}

@test
fn addFails() {
    println("printed before the failure")
    assert(add(2, 2) == 5)
}

@test
fn stillRuns() {
    let total = 0
    for i in 1..=10 {
        total = add(total, i)
    }
    assert(total == 55)
}
