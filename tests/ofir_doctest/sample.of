// Doc tests (spec 12.5), stage 1 only: each `ofir` block of a
// documentation comment is compiled and run by `ofir test`.

import std.testing.assert

/**
 * @module
 * Doc tests: each `ofir` block below is compiled and run by `ofir test`.
 *
 * ```ofir
 * import sample.double
 * import std.testing.assert
 *
 * assert(double(2) == 4)
 * ```
 */

/**
 * Twice `n`.
 *
 * @param n a number
 * @returns `n + n`
 * @example
 * ```ofir
 * import sample.double
 * import std.testing.assert
 *
 * fn quadruple(n: int) int {
 *     return double(double(n))
 * }
 *
 * const n = quadruple(3)
 * assert(n == 12)
 * ```
 *
 * A block that fails:
 *
 * ```ofir
 * import sample.double
 * import std.testing.assert
 *
 * assert(double(1) == 3)
 * ```
 *
 * ```ofir no_run
 * import sample.double
 *
 * for {
 *     const _ = double(1)
 * }
 * ```
 *
 * ```ofir ignore
 * this is not Ofir
 * ```
 *
 * ```
 * neither is this
 * ```
 */
pub fn double(n: int) int {
    return n + n
}

@test
fn doubleWorks() {
    assert(double(0) == 0)
}
