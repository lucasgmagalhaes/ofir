// requires: stage1
// flags: -g
// With -g, the block no path reaches after a `return` (its `unreachable`)
// is at line 0, not at the closing brace: gcov would count it as a line
// that never runs (roadmap 6.33e).
// CHECK: DISubprogram(name: "deadEnd"
// CHECK: !DILocation(line: 11, column: 5,
// CHECK-NOT: !DILocation(line: 12, column: 1,
// CHECK: DISubprogram(
fn deadEnd(a: int) int {
    return a + 1
}

fn main() {
    println("{deadEnd(1)}")
}
