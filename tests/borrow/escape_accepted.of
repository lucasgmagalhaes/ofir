// requires: stage1
// Borrows that end before what they borrow (spec 5.6).

struct Handlers {
    owned: move fn(int)
}

fn each(xs: List<int>, f: fn(int)) {
}

fn maybe(f: Option<fn(int)>) {
}

// A borrow of an inner local that is not used after its block.
fn innerBlock() {
    const a = [1]
    let r = &a
    {
        const b = [2, 3]
        r = &b
        println("{r.len()}")
    }
    r = &a
    println("{r.len()}")
}

// A reference made and used in each iteration.
fn eachIteration() {
    for i in 0..3 {
        const b = [i]
        const r = &b
        println("{r.len()}")
    }
}

// A block whose value copies out of a local of the block.
fn blockValue() {
    const n = {
        const b = [1, 2]
        const r = &b
        r.len()
    }
    println("{n}")
}

fn main() {
    innerBlock()
    eachIteration()
    blockValue()
}
