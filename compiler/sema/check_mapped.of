/**
 * @module
 * Mapped types (spec 16.4): each instance is a struct of its own, with one
 * field per key (stage 1 only).
 */

import base.intern.Symbol
import base.span.Span
import sema.check.Checker
import sema.check.boundedParam
import sema.check.emptyInfo
import sema.check.isKeyBound
import sema.check.itemOf
import sema.check_cond.decide
import sema.check_cond.notDecided
import sema.check_keys.included
import sema.check_ref.checkStorable
import sema.check_types.resolveType
import sema.def.Def
import sema.def.DefKind
import sema.program.Program
import sema.structs.StructInfo
import sema.types.ERROR
import sema.types.KeyFields
import sema.types.TyKind
import std.mem
import syntax.ast.ItemKind
import syntax.ast.TypeExpr

/**
 * A mapped type alias over its own parameters, expanded for each instance
 * whose arguments have a parameter (spec 16.4).
 */
pub copy struct MappedTpl {
    /** The mapped type: with the arguments, the key of its instances in `Checker.mapped`. */
    pub span: Span
    /** `Keys`, over the alias parameters. */
    pub keys: int
    /** The field type, over the alias parameters and `K` after them. */
    pub field: int
    /** `?:`: each field defaults to `Option.None`. */
    pub optional: bool
    /** `if Cond`, over the alias parameters and `K`: `true` or `false` per key; -1 for none. */
    pub filter: int
}

/**
 * `{ [K in Keys]: F }`: the struct of this instance, made once.
 *
 * @param c the checker
 * @param p the program
 * @param t the mapped type
 * @param param `K`
 * @param keys `Keys`
 * @param filter `if Cond`: the keys for which it is `false` are left out
 * @param optional `?:`: each field is an `Option` that defaults to `None`
 * @param field `F`
 * @returns the struct type
 */
pub fn mappedType(c: mut Checker, p: Program, t: &TypeExpr, param: Symbol, keys: &TypeExpr,
                  filter: &Option<Box<TypeExpr>>, optional: bool, field: &TypeExpr) int {
    if c.aliasDef == 0 {
        return c.unsupported(t.span, "mapped types outside a type alias are")
    }
    const keyType = resolveType(c, p, keys)
    if keyType == ERROR {
        return ERROR
    }
    if c.types.get(keyType).hasParam {
        return deferred(c, p, t, param, keys, filter, optional, field)
    }
    if c.types.kind(keyType) != TyKind.Key {
        c.error("E0340", keys.span, "a mapped type needs a key type, found "
                + "`{c.typeName(keyType)}`")
        return ERROR
    }
    let scope = c.generics.aliasArgs.clone()
    for i in 0..c.typeVarTypes.len() {
        scope.push(c.typeVarTypes[i])
    }
    const cacheKey = (t.span.file.0, t.span.start, c.types.tuple(scope))
    if const Option.Some(known) = c.mapped.get(cacheKey) {
        return c.types.adt(*known, [])
    }
    let info = StructInfo{names: [], types: [], defaults: [], isTuple: false, isCopy: false}
    const names = c.types.keyNames(keyType)
    let fieldNames: List<int> = []
    for i in 0..names.len() {
        c.typeVars.push(param)
        c.typeVarTypes.push(c.types.keys([names[i]]))
        const kept = keep(c, p, filter)
        if kept != 1 {
            c.typeVars.pop()
            c.typeVarTypes.pop()
            if kept < 0 {
                return ERROR
            }
            continue
        }
        let ty = resolveType(c, p, field)
        c.typeVars.pop()
        c.typeVarTypes.pop()
        if ty != ERROR && c.types.get(ty).hasParam {
            return c.unsupported(t.span, "mapped types over type parameters are")
        }
        if optional && ty != ERROR {
            ty = c.types.adt(c.r.langItems[2], [ty])
        }
        checkStorable(c, p, ty, field.span, "a struct field")
        info.names.push(Symbol(names[i]))
        fieldNames.push(names[i])
        info.types.push(ty)
        info.defaults.push(optional)
    }
    const id = mappedStruct(c, c.aliasDef, t.span, &scope)
    let pubs: List<bool> = []
    for _ in 0..fieldNames.len() {
        pubs.push(true)
    }
    c.types.setFields(id, KeyFields{module: c.module(), isTuple: false, names: fieldNames, pubs,
                                    types: info.types.clone()})
    c.info[id].fields = Option.Some(Box.new(info))
    c.mapped.insert(cacheKey, id)
    if c.typeVarTypes.len() == 0 {
        c.mappedArgs.insert(id, (c.aliasDef, cacheKey.2))
    }
    return c.types.adt(id, [])
}

// An instance whose keys have a parameter: a `Mapped` type, expanded once its
// arguments are known. Only an alias whose whole body is the mapped type.
fn deferred(c: mut Checker, p: Program, t: &TypeExpr, param: Symbol, keys: &TypeExpr,
            filter: &Option<Box<TypeExpr>>, optional: bool, field: &TypeExpr) int {
    const alias = c.aliasDef
    const body = match itemOf(p, c.loc(alias)).kind {
        ItemKind.TypeAlias(_, aliased) => aliased.span
        _ => t.span
    }
    const whole = body.file.0 == t.span.file.0 && body.start == t.span.start
    const nested = c.typeVarTypes.len() > 0
    if !whole || nested {
        return c.unsupported(t.span, "mapped types over type parameters are")
    }
    if c.mappedTpls.get(alias).isNone() {
        const tpl = template(c, p, t, param, keys, filter, optional, field)
        if tpl.keys == ERROR || tpl.field == ERROR || tpl.filter == ERROR {
            return ERROR
        }
        c.mappedTpls.insert(alias, tpl)
    }
    const args = c.generics.aliasArgs.clone()
    return c.types.intern(TyKind.Mapped, alias, 0, args)
}

// The keys and field type of a mapped type over the alias parameters: `K` is
// the parameter after them, bounded by the keys.
fn template(c: mut Checker, p: Program, t: &TypeExpr, param: Symbol, keys: &TypeExpr,
            filter: &Option<Box<TypeExpr>>, optional: bool, field: &TypeExpr) MappedTpl {
    const savedArgs = mem.replace(c.generics.aliasArgs, [])
    const n = c.generics.owner.len()
    const savedKeys = mem.replace(c.generics.keys, List.filled(0, n + 1))
    aliasKeys(c, p)
    const keysTpl = resolveType(c, p, keys)
    c.generics.keys[n] = keysTpl
    c.typeVars.push(param)
    c.typeVarTypes.push(c.types.param(n, param.0))
    let fieldTpl = resolveType(c, p, field)
    const filterTpl = match *filter {
        Option.Some(test) => resolveType(c, p, &*test)
        Option.None => -1
    }
    c.typeVars.pop()
    c.typeVarTypes.pop()
    c.generics.keys = savedKeys
    c.generics.aliasArgs = savedArgs
    if optional && fieldTpl != ERROR {
        fieldTpl = c.types.adt(c.r.langItems[2], [fieldTpl])
    }
    return MappedTpl{span: t.span, keys: keysTpl, field: fieldTpl, optional,
                     filter: filterTpl}
}

// The key bounds of the alias parameters, such as `K: keyof T`, as types of
// the parameters.
fn aliasKeys(c: mut Checker, p: Program) {
    const preds = itemOf(p, c.loc(c.aliasDef)).bounds.clone()
    for i in 0..preds.len() {
        const index = boundedParam(&preds[i].ty, &c.generics.owner, &[])
        if index < 0 {
            continue
        }
        for j in 0..preds[i].bounds.len() {
            if isKeyBound(&preds[i].bounds[j]) {
                const bound = resolveType(c, p, &preds[i].bounds[j])
                c.generics.keys[index] = bound
            }
        }
    }
}

/**
 * The struct of a `Mapped` type whose arguments have no parameter, made
 * once: the same struct as the alias applied to them directly.
 *
 * @param c the checker
 * @param mapped the `Mapped` type
 * @returns the struct type, or ERROR
 */
pub fn expandMapped(c: mut Checker, mapped: int) int {
    const known = c.types.expandedOf(mapped)
    if known != 0 {
        return known
    }
    const alias = c.types.get(mapped).data
    let args = c.types.get(mapped).args.clone()
    for i in 0..args.len() {
        if c.types.kind(args[i]) == TyKind.Mapped {   // `Partial<Partial<T>>`
            const inner = expandMapped(c, args[i])
            args[i] = inner
        }
    }
    if c.mappedTpls.get(alias).isNone() {
        return ERROR
    }
    const tpl = *c.mappedTpls.get(alias).unwrap()
    const cacheKey = (tpl.span.file.0, tpl.span.start, c.types.tuple(args.clone()))
    if const Option.Some(id) = c.mapped.get(cacheKey) {
        const ty = c.types.adt(*id, [])
        c.types.setExpanded(mapped, ty)
        return ty
    }
    const keyType = c.types.subst(tpl.keys, args.clone())
    if c.types.kind(keyType) != TyKind.Key {
        return ERROR
    }
    let info = StructInfo{names: [], types: [], defaults: [], isTuple: false, isCopy: false}
    const names = c.types.keyNames(keyType)
    let pubs: List<bool> = []
    let kept: List<int> = []
    for i in 0..names.len() {
        let fieldArgs = args.clone()
        fieldArgs.push(c.types.keys([names[i]]))
        if tpl.filter >= 0 {
            const test = c.types.get(c.types.subst(tpl.filter, fieldArgs.clone()))
            if test.kind != TyKind.Bool || test.data == 0 {
                return ERROR
            }
            if test.data == 2 {
                continue
            }
        }
        const ty = c.types.subst(tpl.field, fieldArgs)
        kept.push(names[i])
        info.names.push(Symbol(names[i]))
        info.types.push(ty)
        info.defaults.push(tpl.optional)
        pubs.push(true)
    }
    const id = mappedStruct(c, alias, tpl.span, &args)
    c.types.setFields(id, KeyFields{module: c.def(alias).module, isTuple: false,
                                    names: kept, pubs, types: info.types.clone()})
    c.info[id].fields = Option.Some(Box.new(info))
    c.mapped.insert(cacheKey, id)
    c.mappedArgs.insert(id, (alias, cacheKey.2))
    const ty = c.types.adt(id, [])
    c.types.setExpanded(mapped, ty)
    return ty
}

/**
 * `subst`, expanding the mapped types it makes known.
 *
 * @param c the checker
 * @param ty a type
 * @param args the type arguments
 * @returns the substituted type
 */
pub fn substType(c: mut Checker, ty: int, args: [int]) int {
    let out = c.types.subst(ty, args)
    for c.types.hasPending() {   // again for each level: `Partial<Partial<T>>`
        const pending = c.types.takePending()
        for i in 0..pending.len() {
            expandMapped(c, pending[i])
        }
        out = c.types.subst(ty, args)
    }
    return out
}

/**
 * `M[K]` for an instance of a mapped type with a parameter, when `K` is
 * bounded by its keys.
 *
 * @param c the checker
 * @param base `M`, a `Mapped` type
 * @param key `K`
 * @param bound the key bound of `K`
 * @returns the field type, or 0
 */
pub fn mappedIndexType(c: mut Checker, base: int, key: int, bound: int) int {
    const alias = c.types.get(base).data
    if c.mappedTpls.get(alias).isNone() {
        return 0
    }
    const tpl = *c.mappedTpls.get(alias).unwrap()
    const args = c.types.get(base).args.clone()
    if mappedKeys(c, c.types.subst(tpl.keys, args.clone())) != bound {
        return 0
    }
    let fieldArgs = args
    fieldArgs.push(key)
    return reduceIndex(c, c.types.subst(tpl.field, fieldArgs))
}

// `ty` with each `M[K]` of a mapped type `M` replaced by the field type of
// `M`: in `Partial<Partial<T>>`, `Partial<T>[K]` is `Option<T[K]>`. The key
// of a field type is one of the keys of `M`.
fn reduceIndex(c: mut Checker, ty: int) int {
    if !c.types.get(ty).hasParam {
        return ty
    }
    const kind = c.types.kind(ty)
    const data = c.types.get(ty).data
    let inner = c.types.get(ty).inner
    let items = c.types.get(ty).args.clone()
    if kind == TyKind.Index && c.types.kind(inner) == TyKind.Mapped {
        if const Option.Some(tpl) = c.mappedTpls.get(c.types.get(inner).data) {
            let fieldArgs = c.types.get(inner).args.clone()
            fieldArgs.push(items[0])
            const field = tpl.field
            return reduceIndex(c, c.types.subst(field, fieldArgs))
        }
        return ty
    }
    const keepsInner = kind == TyKind.Tuple || kind == TyKind.Adt || kind == TyKind.Dyn ||
                       kind == TyKind.Mapped || kind == TyKind.Index
    if !keepsInner {
        inner = reduceIndex(c, inner)   // ref, ptr, slice, array, fn
    }
    for i in 0..items.len() {
        const item = reduceIndex(c, items[i])
        items[i] = item
    }
    return c.types.intern(kind, data, inner, items)
}

/**
 * `keys` with each `keyof M` of a mapped type `M` with no filter replaced by
 * the keys of `M`: `keyof Partial<T>` is `keyof T`.
 *
 * @param c the checker
 * @param keys a key type
 * @returns the reduced key type
 */
pub fn mappedKeys(c: mut Checker, keys: int) int {
    let out = keys
    for c.types.kind(out) == TyKind.KeyOf {
        const inner = c.types.get(out).inner
        if c.types.kind(inner) != TyKind.Mapped {
            break
        }
        const alias = c.types.get(inner).data
        const found = c.mappedTpls.get(alias)
        if found.isNone() || found.unwrap().filter >= 0 {
            break
        }
        const tpl = *found.unwrap()
        out = c.types.subst(tpl.keys, c.types.get(inner).args.clone())
    }
    return out
}

// Whether a mapped type keeps the current key: 1, 0, or -1 after an error.
fn keep(c: mut Checker, p: Program, filter: &Option<Box<TypeExpr>>) int {
    return match *filter {
        Option.Some(test) => {
            let names: List<Symbol> = []
            let binds: List<int> = []
            let parts: List<int> = []
            const decided = decide(c, p, &*test, names, binds, parts)
            if decided == 2 {
                notDecided(c, test.span, parts[0])
            } else {
                decided
            }
        }
        Option.None => 1
    }
}

// A new struct declaration for an instance, named by its alias and the types
// in scope: `Partial<Point>`.
fn mappedStruct(c: mut Checker, alias: int, span: Span, scope: &List<int>) int {
    let name = c.text(c.def(alias).name).toOwned()
    if scope.len() > 0 {
        name.push("<")
        for i in 0..scope.len() {
            if i > 0 {
                name.push(", ")
            }
            name.push(c.typeName(scope[i]))
        }
        name.push(">")
    }
    const symbol = c.r.names.intern(name)
    const module = c.def(alias).module
    const item = c.def(alias).item
    const isPub = c.def(alias).isPub
    c.r.defs.push(Def{kind: DefKind.Struct, name: symbol, span, isPub, inPrelude: false,
                      lang: false, module, item, member: -1, target: 0, primitive: 0})
    c.info.push(emptyInfo())
    return c.r.defs.len() - 1
}

/**
 * Whether a struct is the instance of a mapped type: it has no declaration
 * of its own.
 *
 * @param c the checker
 * @param p the program
 * @param id the struct's `DefId`
 * @returns true for a mapped type's struct
 */
pub fn isMappedStruct(c: Checker, p: Program, id: int) bool {
    if c.def(id).kind != DefKind.Struct {
        return false
    }
    return match itemOf(p, c.loc(id)).kind {
        ItemKind.TypeAlias(_, _) => true
        _ => false
    }
}

/**
 * Reports E0332 for an argument of a type alias outside its key bound:
 * `Pick<Point, .z>` for `type Pick<T, K: keyof T>`.
 *
 * @param c the checker, in the alias with its arguments
 * @param p the program
 * @param id the alias
 * @param span where it is used
 * @returns whether every key argument is in its bound
 */
pub fn checkAliasBounds(c: mut Checker, p: Program, id: int, span: Span) bool {
    let ok = true
    const preds = itemOf(p, c.loc(id)).bounds.clone()
    for i in 0..preds.len() {
        const index = boundedParam(&preds[i].ty, &c.generics.owner, &[])
        if index < 0 || index >= c.generics.aliasArgs.len() {
            continue
        }
        const arg = c.generics.aliasArgs[index]
        if arg == ERROR || c.types.get(arg).hasParam {
            continue
        }
        for j in 0..preds[i].bounds.len() {
            const bound = resolveType(c, p, &preds[i].bounds[j])
            if bound != ERROR && !c.types.get(bound).hasParam && !included(c, arg, bound) {
                c.error("E0332", span, "the key `{c.typeName(arg)}` is not in the bound "
                        + "`{c.typeName(bound)}` of `{c.text(c.generics.owner[index])}`")
                ok = false
            }
        }
    }
    return ok
}
