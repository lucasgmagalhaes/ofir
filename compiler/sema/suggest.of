/**
 * @module
 * "Did you mean" suggestions (docs/design/toolchain.md, Suggestions; stage
 * 0: bootstrap/src/sema/suggest.c): the candidate closest to an unknown name
 * by edit distance, if it is within a third of the name's length. Between
 * equally close candidates the one with the smaller symbol id (interned
 * first) wins, so the order in which they are offered does not matter.
 */

import base.intern.Symbol
import sema.def.DefKind
import sema.resolve.Resolver

// Longer names get no suggestion.
const MAX_NAME: int = 128

/** Where `suggestName` looks for candidates. */
pub copy enum SuggestScope {
    /** The locals in scope and the current module's table. */
    Value
    /** The current module's table only (after resolution). */
    Item
    /** The types of the current module's table. */
    Type
}

// The bytes of a name.
fn bytesOf(text: str) List<u8> {
    let out: List<u8> = []
    for b in text.bytes() {
        out.push(b)
    }
    return out
}

// The insertions, deletions, substitutions and swaps of two adjacent bytes
// that turn `a` into `b` (optimal string alignment).
fn editDistance(a: &List<u8>, b: &List<u8>) int {
    const width = b.len() + 1
    let d: List<int> = []
    for i in 0..a.len() + 1 {
        for j in 0..width {
            d.push(if i == 0 { j } else if j == 0 { i } else { 0 })
        }
    }
    for i in 1..a.len() + 1 {
        for j in 1..width {
            let best = d[(i - 1) * width + j - 1] + (if a[i - 1] == b[j - 1] { 0 } else { 1 })
            if d[(i - 1) * width + j] + 1 < best {
                best = d[(i - 1) * width + j] + 1
            }
            if d[i * width + j - 1] + 1 < best {
                best = d[i * width + j - 1] + 1
            }
            const swapped = i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1]
            if swapped && d[(i - 2) * width + j - 2] + 1 < best {
                best = d[(i - 2) * width + j - 2] + 1
            }
            d[i * width + j] = best
        }
    }
    return d[a.len() * width + b.len()]
}

/** The closest candidate to an unknown name found so far. */
pub struct Suggestion {
    text: str
    name: List<u8>
    best: int   // a symbol id, -1 for none
    distance: int

    /**
     * Starts looking for a name close to `name`.
     *
     * @param name the unknown name
     * @returns no candidate yet
     */
    pub fn new(name: str) Suggestion {
        return Suggestion{text: name.toOwned(), name: bytesOf(name), best: -1, distance: 0}
    }

    /**
     * Considers a candidate.
     *
     * @param candidate its symbol
     * @param text its text
     */
    pub fn offer(mut self, candidate: Symbol, text: str) {
        const limit = self.name.len() / 3
        if limit == 0 || self.name.len() > MAX_NAME || text.len() > MAX_NAME {
            return
        }
        let gap = self.name.len() - text.len()
        if gap < 0 {
            gap = -gap
        }
        if gap > limit {
            return
        }
        const distance = editDistance(&self.name, &bytesOf(text))
        if distance == 0 || distance > limit {
            return
        }
        const tie = distance == self.distance && candidate.0 < self.best
        if self.best < 0 || distance < self.distance || tie {
            self.best = candidate.0
            self.distance = distance
        }
    }

    /**
     * Adds `= help: did you mean `x`?` to the diagnostic reported last,
     * with the fix that writes `x` for the unknown name.
     *
     * @param r the resolver
     */
    pub fn report(self, r: mut Resolver) {
        if self.best >= 0 {
            const best = r.text(Symbol(self.best))
            r.diags.suggest("did you mean `{best}`?", self.text, best)
        }
    }
}

// Whether a declaration of this kind is a type.
fn isType(kind: DefKind) bool {
    return match kind {
        DefKind.Primitive | DefKind.Struct | DefKind.Enum | DefKind.TypeAlias => true
        _ => false
    }
}

/**
 * The help line for an unknown name, after its E0200.
 *
 * @param r the resolver
 * @param name the unknown name
 * @param scope where the candidates are
 */
pub fn suggestName(r: mut Resolver, name: Symbol, scope: SuggestScope) {
    let s = Suggestion.new(r.text(name))
    for i in 0..r.scope.symbols() {
        const def = r.scope.module(Symbol(i))
        let visible = scope == SuggestScope.Value && r.scope.localOf(Symbol(i)).isSome()
        if !visible && def != 0 {
            visible = scope != SuggestScope.Type || isType(r.def(def).kind)
        }
        if visible {
            s.offer(Symbol(i), r.text(Symbol(i)))
        }
    }
    s.report(r)
}

/**
 * The help line for an unknown member of module `index`: its public
 * declarations.
 *
 * @param r the resolver
 * @param index the module
 * @param name the unknown name
 */
pub fn suggestMember(r: mut Resolver, index: int, name: Symbol) {
    let s = Suggestion.new(r.text(name))
    for i in 0..r.scope.symbols() {
        const id = r.scope.moduleIn(index, Symbol(i))
        if id == 0 {
            continue
        }
        const def = r.def(id)
        if !def.inPrelude && def.module == index && def.isPub && def.kind != DefKind.Module {
            s.offer(Symbol(i), r.text(Symbol(i)))
        }
    }
    s.report(r)
}

/**
 * The help line for an unknown field of a struct: its named fields.
 *
 * @param r the resolver
 * @param names the struct's field names
 * @param name the unknown name
 */
pub fn suggestField(r: mut Resolver, names: &List<Symbol>, name: Symbol) {
    let s = Suggestion.new(r.text(name))
    for i in 0..names.len() {
        s.offer(names[i], r.text(names[i]))
    }
    s.report(r)
}
