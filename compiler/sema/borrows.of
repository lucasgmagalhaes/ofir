/**
 * @module
 * The borrow checker (spec 5.4, 5.5, 5.6), run with the move analysis.
 *
 * A *loan* is a borrow of a place of a local, held by a *holder*: a local
 * that holds a reference (`const r = &list`, `const f = list.first()`), a
 * binding that borrows (`for x in list`, `match` on a borrowed place), or a
 * `for` loop, which borrows what it iterates. The state at each program
 * point keeps the loans that may be alive. An access to a place that
 * overlaps a loan it is not compatible with (a write, a move or an
 * exclusive borrow while it is borrowed, any use while it is borrowed
 * mutably) records a *conflict*; the conflict is an error only if its
 * holder is used afterwards, so a borrow lasts until its last use
 * (non-lexical borrows). The arguments of one call are checked against
 * each other at once: `append(a, a)`.
 */

import base.span.Span
import sema.check.Checker
import sema.def.DefKind
import sema.moves.Moves
import sema.moves.Part
import sema.moves.State
import sema.moves.localName
import sema.moves.moveError
import sema.structs.fieldsOf
import sema.types.TyKind

/** A borrow of a part of a local. */
pub struct Loan {
    /** The local holding it, or a `for` loop (`Moves.holderBase` + depth). */
    pub holder: int
    /** What it borrows. */
    pub part: Part
    /** An exclusive borrow. */
    pub mutable: bool
    /** Where the borrow is made. */
    pub span: Span

    /**
     * Whether two loans are the same.
     *
     * @param other the other loan
     * @returns true if they are
     */
    pub fn same(self, other: &Loan) bool {
        return self.holder == other.holder && self.mutable == other.mutable &&
               self.span.start == other.span.start && self.span.end == other.span.end &&
               self.part.same(&other.part)
    }
}

/** How a place is accessed. */
pub copy enum Access {
    Read
    Write
    Move
    Borrow
    BorrowMut
    /** The end of a local's block. */
    Drop
}

/** An access to a borrowed place: an error if the loan's holder is used later. */
pub struct Conflict {
    /** The loan. */
    pub loan: Loan
    /** The access. */
    pub access: Access
    /** The accessed place. */
    pub part: Part
    /** Where. */
    pub span: Span

    /**
     * Whether two conflicts are the same.
     *
     * @param other the other conflict
     * @returns true if they are
     */
    pub fn same(self, other: &Conflict) bool {
        return self.access == other.access && self.span.start == other.span.start &&
               self.span.end == other.span.end && self.loan.same(&other.loan)
    }
}

/**
 * Adds a loan to a state, once.
 *
 * @param s the state
 * @param loan the loan
 */
pub fn addLoan(s: mut State, loan: &Loan) {
    for i in 0..s.loans.len() {
        if s.loans[i].same(loan) {
            return
        }
    }
    s.loans.push(loan.clone())
}

/**
 * Adds a conflict to a state, once.
 *
 * @param s the state
 * @param conflict the conflict
 */
pub fn addConflict(s: mut State, conflict: &Conflict) {
    for i in 0..s.conflicts.len() {
        if s.conflicts[i].same(conflict) {
            return
        }
    }
    s.conflicts.push(conflict.clone())
}

/**
 * Whether two states have the same loans and conflicts.
 *
 * @param a a state
 * @param b the other
 * @returns true if they have
 */
pub fn sameLoans(a: &State, b: &State) bool {
    if a.loans.len() != b.loans.len() || a.conflicts.len() != b.conflicts.len() {
        return false
    }
    for i in 0..a.loans.len() {
        if !hasLoan(b, &a.loans[i]) {
            return false
        }
    }
    for i in 0..a.conflicts.len() {
        if !hasConflict(b, &a.conflicts[i]) {
            return false
        }
    }
    return true
}

fn hasLoan(s: &State, loan: &Loan) bool {
    for i in 0..s.loans.len() {
        if s.loans[i].same(loan) {
            return true
        }
    }
    return false
}

fn hasConflict(s: &State, conflict: &Conflict) bool {
    for i in 0..s.conflicts.len() {
        if s.conflicts[i].same(conflict) {
            return true
        }
    }
    return false
}

/**
 * Joins the loans and conflicts of another path into a state.
 *
 * @param s the state
 * @param other the other path's state
 */
pub fn joinLoans(s: mut State, other: &State) {
    for i in 0..other.loans.len() {
        addLoan(s, &other.loans[i])
    }
    for i in 0..other.conflicts.len() {
        addConflict(s, &other.conflicts[i])
    }
}

/**
 * A holder gets a new value: its loans, and their conflicts, end.
 *
 * @param s the state
 * @param holder the holder
 */
pub fn killHolder(s: mut State, holder: int) {
    let loans: List<Loan> = []
    for i in 0..s.loans.len() {
        if s.loans[i].holder != holder {
            loans.push(s.loans[i].clone())
        }
    }
    s.loans = loans
    dropConflicts(s, holder)
}

fn dropConflicts(s: mut State, holder: int) {
    let kept: List<Conflict> = []
    for i in 0..s.conflicts.len() {
        if s.conflicts[i].loan.holder != holder {
            kept.push(s.conflicts[i].clone())
        }
    }
    s.conflicts = kept
}

/**
 * A holder takes loans (the borrows of the value it is given).
 *
 * @param s the state
 * @param holder the holder
 * @param loans the loans; their holders are replaced
 */
pub fn bindLoans(s: mut State, holder: int, loans: &List<Loan>) {
    if s.dead {
        return
    }
    for i in 0..loans.len() {
        let loan = loans[i].clone()
        loan.holder = holder
        addLoan(s, &loan)
    }
}

/**
 * The loans of a holder.
 *
 * @param s the state
 * @param holder the holder
 * @returns a copy of them
 */
pub fn loansOf(s: &State, holder: int) List<Loan> {
    let loans: List<Loan> = []
    for i in 0..s.loans.len() {
        if s.loans[i].holder == holder {
            loans.push(s.loans[i].clone())
        }
    }
    return loans
}

/**
 * The loans carried since `mark`, the borrows of the value being computed.
 *
 * @param m the analysis
 * @param mark `m.carry.len()` before the value
 * @returns a copy of them
 */
pub fn carriedSince(m: Moves, mark: int) List<Loan> {
    let loans: List<Loan> = []
    for i in mark..m.carry.len() {
        loans.push(m.carry[i].clone())
    }
    return loans
}

/**
 * Forgets the loans carried since `mark`.
 *
 * @param m the analysis
 * @param mark `m.carry.len()` before
 */
pub fn dropCarry(m: mut Moves, mark: int) {
    if m.carry.len() > mark {
        m.carry.truncate(mark)
    }
}

/**
 * A value read from a holder carries its loans.
 *
 * @param m the analysis
 * @param s the state
 * @param holder the holder
 */
pub fn carryHolder(m: mut Moves, s: &State, holder: int) {
    for i in 0..s.loans.len() {
        if s.loans[i].holder == holder {
            m.carry.push(s.loans[i].clone())
        }
    }
}

/**
 * Makes a new loan of a part, carried by the value being computed.
 *
 * @param m the analysis
 * @param part the borrowed part
 * @param mutable an exclusive borrow
 * @param span where
 */
pub fn lend(m: mut Moves, part: &Part, mutable: bool, span: Span) {
    m.carry.push(Loan{holder: -1, part: part.clone(), mutable, span})
}

fn conflicts(loan: &Loan, kind: Access) bool {
    return loan.mutable || !(kind == Access.Read || kind == Access.Borrow)
}

/**
 * An access to a part: each loan of an overlapping part it is not
 * compatible with gets a conflict.
 *
 * @param s the state
 * @param part the accessed part
 * @param kind the access
 * @param span where
 */
pub fn access(s: mut State, part: &Part, kind: Access, span: Span) {
    if s.dead || s.loans.len() == 0 {
        return
    }
    for i in 0..s.loans.len() {
        if s.loans[i].part.overlaps(part) && conflicts(&s.loans[i], kind) {
            const conflict = Conflict{loan: s.loans[i].clone(), access: kind, part: part.clone(),
                                      span}
            addConflict(s, &conflict)
        }
    }
}

/**
 * A holder is used: the conflicts with its loans are errors.
 *
 * @param m the analysis
 * @param c the checker
 * @param s the state
 * @param holder the holder
 */
pub fn useHolder(m: Moves, c: mut Checker, s: mut State, holder: int) {
    if s.dead || s.conflicts.len() == 0 {
        return
    }
    let found: List<Conflict> = []
    for i in 0..s.conflicts.len() {
        if s.conflicts[i].loan.holder == holder {
            found.push(s.conflicts[i].clone())
        }
    }
    if found.len() == 0 {
        return
    }
    dropConflicts(s, holder)
    const by = holderName(m, c, holder)
    for i in 0..found.len() {
        if !reportedAt(&found, i) {
            reportConflict(m, c, &found[i], by)
        }
    }
}

// Whether another conflict at an overlapping place stands for the `i`th
// one: `r.push(x)` both reads and borrows `r`, and one error is enough. A
// read gives way to the other accesses, else the first one is kept.
fn reportedAt(found: &List<Conflict>, i: int) bool {
    const a = &found[i]
    for j in 0..found.len() {
        const b = &found[j]
        if j != i && b.span.start < a.span.end && a.span.start < b.span.end {
            const aRead = a.access == Access.Read
            const bRead = b.access == Access.Read
            if (aRead && !bRead) || (aRead == bRead && j < i) {
                return true
            }
        }
    }
    return false
}

fn holderName(m: Moves, c: Checker, holder: int) str {
    if holder >= m.holderBase {
        return "the `for` loop".toOwned()
    }
    return "`{localName(c, holder)}`"
}

fn reportConflict(m: Moves, c: mut Checker, conflict: &Conflict, by: str) {
    const place = placeText(c, &conflict.part)
    const span = conflict.span
    match conflict.access {
        Access.BorrowMut => {
            if conflict.loan.mutable {
                moveError(m, c, "E0700", span, "cannot borrow `{place}` as mutable more than "
                          + "once: it is also borrowed by {by}")
            } else {
                moveError(m, c, "E0701", span, "cannot borrow `{place}` as mutable because it "
                          + "is also borrowed as shared by {by}")
            }
        }
        Access.Write => {
            moveError(m, c, "E0704", span, "cannot assign to `{place}` while it is borrowed by "
                      + "{by}")
        }
        Access.Move => {
            moveError(m, c, "E0705", span, "cannot move out of `{place}` while it is borrowed "
                      + "by {by}")
        }
        Access.Drop => {
            moveError(m, c, "E0706", conflict.loan.span, "`{place}` does not live long enough: "
                      + "it is dropped at the end of its block while still borrowed by {by}")
        }
        _ => {
            moveError(m, c, "E0703", span, "cannot use `{place}` while it is borrowed as "
                      + "mutable by {by}")
        }
    }
}

/**
 * The end of a block: its owned locals die, so the loans of them conflict
 * with any later use of their holders, and the loans they hold end.
 *
 * @param m the analysis
 * @param c the checker
 * @param s the state
 * @param base `m.scope.len()` when the block opened
 * @param span where
 */
pub fn endScope(m: Moves, c: mut Checker, s: mut State, base: int, span: Span) {
    for i in base..m.scope.len() {
        const local = m.scope[i]
        access(s, &Part{local, fields: []}, Access.Drop, span)
        killHolder(s, local)
    }
}

/**
 * The value of a block may not borrow a local of the block (E0706).
 *
 * @param m the analysis
 * @param c the checker
 * @param base `m.scope.len()` when the block opened
 */
pub fn escapesBlock(m: Moves, c: mut Checker, base: int) {
    for i in 0..m.carry.len() {
        const loan = &m.carry[i]
        for j in base..m.scope.len() {
            if loan.part.local == m.scope[j] {
                const place = placeText(c, &loan.part)
                moveError(m, c, "E0706", loan.span, "`{place}` does not live long enough: "
                          + "the value of its block borrows it")
            }
        }
    }
}

/**
 * Two arguments of one call borrow overlapping places, one of them
 * mutably (E0700, E0701).
 *
 * @param m the analysis
 * @param c the checker
 * @param a the place borrowed twice
 * @param shared whether one of the borrows is shared
 * @param span where
 */
pub fn argumentConflict(m: Moves, c: mut Checker, a: &Part, shared: bool, span: Span) {
    const place = placeText(c, a)
    if shared {
        moveError(m, c, "E0701", span, "cannot borrow `{place}` as mutable because it is also "
                  + "borrowed as shared")
    } else {
        moveError(m, c, "E0700", span, "cannot borrow `{place}` as mutable more than once")
    }
}

/**
 * The text of a part, for messages: `pair.a`.
 *
 * @param c the checker
 * @param part the part
 * @returns its text
 */
pub fn placeText(c: mut Checker, part: &Part) str {
    let text = localName(c, part.local)
    let ty = if part.local < c.localTypes.len() { c.localTypes[part.local] } else { -1 }
    for i in 0..part.fields.len() {
        const field = part.fields[i]
        let name = "{field}"
        let next = -1
        if ty >= 0 {
            const kind = c.types.kind(ty)
            if kind == TyKind.Tuple {
                if field < c.types.get(ty).args.len() {
                    next = c.types.get(ty).args[field]
                }
            } else if kind == TyKind.Adt {
                const def = c.types.get(ty).data
                if c.def(def).kind == DefKind.Struct && c.info[def].fields.isSome() {
                    const info = fieldsOf(c, def)
                    if field < info.types.len() {
                        if !info.isTuple {
                            name = c.text(info.names[field]).toOwned()
                        }
                        const declared = info.types[field]
                        const args = c.types.get(ty).args.clone()
                        next = c.types.subst(declared, args)
                    }
                }
            }
        }
        text = "{text}.{name}"
        ty = next
    }
    return text
}
