/**
 * @module
 * Compile-time evaluation of constants (spec 3.2; stage 0:
 * bootstrap/src/sema/const_eval.c): literals, other constants, the
 * constants of the primitive types and the arithmetic, bitwise, comparison
 * and logical operators, with the overflow, division and shift rules of
 * run time, reported as errors (E0801, E0802) instead of panics.
 */

import base.intern.Symbol
import base.span.Span
import sema.check.Checker
import sema.def.DefKind
import sema.def.Res
import sema.expr_check.isModuleMember
import sema.program.Program
import sema.types.BOOL
import sema.types.ERROR
import sema.types.TyKind
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.Op

/**
 * The kinds of constant values.
 */
pub copy enum ConstKind {
    /** An integer: `bits` holds its two's complement pattern of the type's width. */
    Int
    /** A float: `f`. */
    Float
    /** A bool: `b`. */
    Bool
    /** A string: `s`. */
    Str
}

/**
 * The value of a constant.
 */
pub struct ConstValue {
    /** Its kind. */
    pub kind: ConstKind
    /** Its type. */
    pub ty: int
    /** An integer's bits. */
    pub bits: u64
    /** A float. */
    pub f: float
    /** A bool. */
    pub b: bool
    /** A string. */
    pub s: str

    /**
     * An integer's bits read as an `int`, as stage 0 does for discriminants.
     *
     * @returns the value
     */
    pub fn signed(self) int {
        return self.bits.wrappingCast<int>()
    }
}

struct Eval {
    failed: bool   // an error was reported: stop
}

fn widthOf(kind: int) int {
    const widths = [8, 16, 32, 64, 8, 16, 32, 64]
    return widths[kind]
}

fn mask(width: int) u64 {
    return if width == 64 { 18446744073709551615 } else { (1 as u64 << width as u64) - 1 }
}

// A signed value from the bit pattern of its width.
fn asSigned(bits: u64, width: int) int {
    if width < 64 && (bits >> (width - 1) as u64) & 1 == 1 {
        return (bits | (18446744073709551615 ^ mask(width))).wrappingCast<int>()
    }
    return bits.wrappingCast<int>()
}

fn intValue(ty: int, bits: u64, width: int) ConstValue {
    return ConstValue{kind: ConstKind.Int, ty, bits: bits & mask(width), f: 0.0, b: false, s: ""}
}

fn floatValue(ty: int, f: float) ConstValue {
    return ConstValue{kind: ConstKind.Float, ty, bits: 0, f, b: false, s: ""}
}

fn boolValue(b: bool) ConstValue {
    return ConstValue{kind: ConstKind.Bool, ty: BOOL, bits: 0, f: 0.0, b, s: ""}
}

fn fail(c: mut Checker, ev: mut Eval, code: str, span: Span, message: str) Option<ConstValue> {
    if !ev.failed {
        c.error(code, span, message.toOwned())
    }
    ev.failed = true
    return Option.None
}

// Whether a signed result fits a type of `width` bits.
fn fitsSigned(s: int, width: int) bool {
    if width == 64 {
        return true
    }
    const half = 1 << (width - 1)
    return s >= -half && s <= half - 1
}

fn intArith(c: mut Checker, ev: mut Eval, op: Op, span: Span, a: &ConstValue,
            b: &ConstValue) Option<ConstValue> {
    const kind = c.types.get(a.ty).data
    const width = widthOf(kind)
    if (op == Op.Div || op == Op.Rem) && b.bits == 0 {
        return fail(c, ev, "E0802", span, "division by zero in a constant")
    }
    if kind <= 3 {
        const x = asSigned(a.bits, width)
        const y = asSigned(b.bits, width)
        const min = -9223372036854775807 - 1
        const result: Option<int> = match op {
            Op.Add => x.checkedAdd(y)
            Op.Sub => x.checkedSub(y)
            Op.Mul => x.checkedMul(y)
            Op.Div => if x == min && y == -1 { Option.None } else { Option.Some(x / y) }
            _ => if x == min && y == -1 { Option.None } else { Option.Some(x % y) }
        }
        const Option.Some(s) = result else {
            return fail(c, ev, "E0802", span, "integer overflow in a constant")
        }
        if !fitsSigned(s, width) {
            return fail(c, ev, "E0802", span, "integer overflow in a constant")
        }
        return Option.Some(intValue(a.ty, s.wrappingCast<u64>(), width))
    }
    const result: Option<u64> = match op {
        Op.Add => a.bits.checkedAdd(b.bits)
        Op.Sub => a.bits.checkedSub(b.bits)
        Op.Mul => a.bits.checkedMul(b.bits)
        Op.Div => Option.Some(a.bits / b.bits)
        _ => Option.Some(a.bits % b.bits)
    }
    const Option.Some(u) = result else {
        return fail(c, ev, "E0802", span, "integer overflow in a constant")
    }
    if width < 64 && u > mask(width) {
        return fail(c, ev, "E0802", span, "integer overflow in a constant")
    }
    return Option.Some(intValue(a.ty, u, width))
}

fn intBits(c: mut Checker, ev: mut Eval, op: Op, span: Span, a: &ConstValue,
           b: &ConstValue) Option<ConstValue> {
    const kind = c.types.get(a.ty).data
    const width = widthOf(kind)
    if (op == Op.Shl || op == Op.Shr) && b.bits >= width as u64 {   // also a negative amount
        return fail(c, ev, "E0802", span, "shift amount out of range in a constant")
    }
    const r: u64 = match op {
        Op.And => a.bits & b.bits
        Op.Or => a.bits | b.bits
        Op.Xor => a.bits ^ b.bits
        Op.Shl => (a.bits & (mask(64 - b.bits as int))) << b.bits
        _ => if kind <= 3 {
            (asSigned(a.bits, width) >> b.bits as int).wrappingCast<u64>()
        } else {
            a.bits >> b.bits
        }
    }
    return Option.Some(intValue(a.ty, r, width))
}

fn order(greater: bool, less: bool) int {
    if greater {
        return 1
    }
    return if less { -1 } else { 0 }
}

// <0, 0 or >0.
fn compare(c: Checker, a: &ConstValue, b: &ConstValue) int {
    return match a.kind {
        ConstKind.Int => {
            const kind = c.types.get(a.ty).data
            if kind <= 3 {
                order(asSigned(a.bits, widthOf(kind)) > asSigned(b.bits, widthOf(kind)),
                      asSigned(a.bits, widthOf(kind)) < asSigned(b.bits, widthOf(kind)))
            } else {
                order(a.bits > b.bits, a.bits < b.bits)
            }
        }
        ConstKind.Float => order(a.f > b.f, a.f < b.f)
        ConstKind.Bool => order(a.b && !b.b, !a.b && b.b)
        ConstKind.Str => order(a.s > b.s, a.s < b.s)
    }
}

fn isNan(f: float) bool {
    return f != f
}

fn comparison(c: Checker, op: Op, a: &ConstValue, b: &ConstValue) ConstValue {
    const unordered = a.kind == ConstKind.Float && (isNan(a.f) || isNan(b.f))
    const order = compare(c, a, b)
    const r = match op {
        Op.Eq => !unordered && order == 0
        Op.Ne => unordered || order != 0
        Op.Lt => !unordered && order < 0
        Op.Le => !unordered && order <= 0
        Op.Gt => !unordered && order > 0
        _ => !unordered && order >= 0
    }
    return boolValue(r)
}

fn floatArith(op: Op, a: &ConstValue, b: &ConstValue) ConstValue {
    const r = match op {
        Op.Add => a.f + b.f
        Op.Sub => a.f - b.f
        Op.Mul => a.f * b.f
        Op.Div => a.f / b.f
        _ => a.f % b.f
    }
    return floatValue(a.ty, r)
}

fn binary(c: mut Checker, p: Program, ev: mut Eval, e: &Expr, op: Op, lhs: &Expr,
          rhs: &Expr) Option<ConstValue> {
    const Option.Some(a) = eval(c, p, ev, lhs) else {
        return Option.None
    }
    if op == Op.LogicalAnd || op == Op.LogicalOr {   // short-circuit, as at run time
        if a.b == (op == Op.LogicalOr) {
            return Option.Some(a)
        }
        return eval(c, p, ev, rhs)
    }
    const Option.Some(b) = eval(c, p, ev, rhs) else {
        return Option.None
    }
    if op == Op.Eq || op == Op.Ne || op == Op.Lt || op == Op.Le || op == Op.Gt || op == Op.Ge {
        return Option.Some(comparison(c, op, &a, &b))
    }
    if a.kind == ConstKind.Str {
        return Option.Some(ConstValue{kind: ConstKind.Str, ty: a.ty, bits: 0, f: 0.0, b: false,
                                s: "{a.s}{b.s}"})
    }
    if a.kind == ConstKind.Float {
        return Option.Some(floatArith(op, &a, &b))
    }
    if op == Op.Add || op == Op.Sub || op == Op.Mul || op == Op.Div || op == Op.Rem {
        return intArith(c, ev, op, e.span, &a, &b)
    }
    return intBits(c, ev, op, e.span, &a, &b)
}

fn unary(c: mut Checker, p: Program, ev: mut Eval, e: &Expr, op: Op,
         operand: &Expr) Option<ConstValue> {
    const Option.Some(a) = eval(c, p, ev, operand) else {
        return Option.None
    }
    if a.kind == ConstKind.Bool {
        return Option.Some(ConstValue{kind: ConstKind.Bool, ty: a.ty, bits: 0, f: 0.0, b: !a.b,
                                      s: ""})
    }
    if a.kind == ConstKind.Float {
        return Option.Some(floatValue(a.ty, -a.f))
    }
    const width = widthOf(c.types.get(a.ty).data)
    if op == Op.Not {
        return Option.Some(intValue(a.ty, a.bits ^ 18446744073709551615, width))
    }
    const zero = intValue(a.ty, 0, 64)
    return intArith(c, ev, Op.Sub, e.span, &zero, &a)
}

fn cast(c: mut Checker, p: Program, ev: mut Eval, e: &Expr, value: &Expr) Option<ConstValue> {
    const Option.Some(a) = eval(c, p, ev, value) else {
        return Option.None
    }
    const to = c.typeOf(e.id.0)
    const target = c.types.get(to)
    if target.kind == TyKind.Float {
        let f = a.f
        if a.kind != ConstKind.Float {
            const from = c.types.get(a.ty).data
            f = if from <= 3 { asSigned(a.bits, widthOf(from)) as float } else { a.bits as float }
        }
        if target.data == 32 {
            f = (f as f32) as float
        }
        return Option.Some(floatValue(to, f))
    }
    if a.kind == ConstKind.Float {
        return fail(c, ev, "E0801", e.span,
                    "float to integer conversions are not allowed in constants")
    }
    const from = c.types.get(a.ty).data
    const fromSigned = from <= 3
    const signed = if fromSigned { asSigned(a.bits, widthOf(from)) } else { 0 }
    const negative = fromSigned && signed < 0
    const magnitude = if fromSigned { signed.wrappingCast<u64>() } else { a.bits }
    const width = widthOf(target.data)
    let ok = false
    if target.data <= 3 {
        const half = if width == 64 { 9223372036854775807 } else { (1 << (width - 1)) - 1 }
        ok = if negative { width == 64 || signed >= -half - 1 } else {
            magnitude <= half.wrappingCast<u64>()
        }
    } else {
        ok = !negative && (width == 64 || magnitude <= mask(width))
    }
    if !ok {
        return fail(c, ev, "E0802", e.span, "value out of range for the target type of `as`")
    }
    return Option.Some(intValue(to, magnitude, width))
}

fn literal(c: Checker, e: &Expr) ConstValue {
    const ty = c.typeOf(e.id.0)
    const t = c.types.get(ty)
    return match e.kind {
        ExprKind.Int(value) => if t.kind == TyKind.Float { floatValue(ty, value as float) } else {
            intValue(ty, value, widthOf(t.data))
        }
        ExprKind.Float(value) => floatValue(ty, value)
        ExprKind.Byte(value) => intValue(ty, value as u64, 8)
        ExprKind.Bool(value) => ConstValue{kind: ConstKind.Bool, ty, bits: 0, f: 0.0, b: value,
                                           s: ""}
        ExprKind.Str(value) => ConstValue{kind: ConstKind.Str, ty, bits: 0, f: 0.0, b: false,
                                          s: value.clone()}
        _ => boolValue(false)
    }
}

// `i32.MAX`, `float.NAN`, ...
fn primitiveConst(c: Checker, e: &Expr, name: Symbol) ConstValue {
    const ty = c.typeOf(e.id.0)
    const t = c.types.get(ty)
    const text = c.text(name)
    if t.kind == TyKind.Int {
        const width = widthOf(t.data)
        const isSigned = t.data <= 3
        const max = mask(width)
        let v: u64 = 0
        if text == "MAX" {
            v = if isSigned { max >> 1 } else { max }
        } else if isSigned {
            v = 1 as u64 << (width - 1) as u64
        }
        return intValue(ty, v, width)
    }
    const zero = 0.0
    let f = if t.data == 32 { 1.1920928955078125e-07 } else { 2.220446049250313e-16 }
    if text == "NAN" {
        f = zero / zero
    } else if text == "INFINITY" {
        f = 1.0 / zero
    }
    return floatValue(ty, f)
}

fn eval(c: mut Checker, p: Program, ev: mut Eval, e: &Expr) Option<ConstValue> {
    if c.typeOf(e.id.0) == ERROR {
        ev.failed = true   // already reported by the checker
        return Option.None
    }
    if isModuleMember(c, e) {
        return constant(c, ev, e)
    }
    return match e.kind {
        ExprKind.Int(_) | ExprKind.Float(_) | ExprKind.Byte(_) | ExprKind.Bool(_) |
        ExprKind.Str(_) => Option.Some(literal(c, e))
        ExprKind.Ident(_) => constant(c, ev, e)
        ExprKind.Field(_, name, _) => Option.Some(primitiveConst(c, e, name))
        ExprKind.Unary(op, operand) => unary(c, p, ev, e, op, &*operand)
        ExprKind.Binary(op, lhs, rhs) => binary(c, p, ev, e, op, &*lhs, &*rhs)
        ExprKind.Cast(value, _) => cast(c, p, ev, e, &*value)
        _ => fail(c, ev, "E0801", e.span,
                  "a constant may only use literals, constants and operators")
    }
}

// The value of a named constant.
/**
 * Why the constant `id`, computed by `comptime` code, has no value yet.
 *
 * @param c the checker
 * @param id its `DefId`
 * @returns the message
 */
pub fn byComptimeMessage(c: Checker, id: int) str {
    return ("`{c.text(c.def(id).name)}` is computed by `comptime` code, which runs after "
            + "type checking: its value cannot be used in a constant or an array length")
}

fn constant(c: mut Checker, ev: mut Eval, e: &Expr) Option<ConstValue> {
    const id = match c.res(e.id.0) {
        Res.Def(id) => id
        _ => 0
    }
    let found: Option<ConstValue> = Option.None
    if id != 0 && c.def(id).kind == DefKind.Const {
        found = c.info[id].value.clone()
    }
    const Option.Some(value) = found else {
        if id != 0 && c.info[id].byComptime {
            return fail(c, ev, "E0801", e.span, byComptimeMessage(c, id))
        }
        return fail(c, ev, "E0801", e.span, "only constants can be used in a constant")
    }
    let out = value
    out.ty = c.typeOf(e.id.0)
    return Option.Some(out)
}

/**
 * The value of a constant's initializer.
 *
 * @param c the checker
 * @param p the program
 * @param e the initializer, already checked
 * @returns its value, or `None` after an error
 */
pub fn constEval(c: mut Checker, p: Program, e: &Expr) Option<ConstValue> {
    let ev = Eval{failed: false}
    return eval(c, p, ev, e)
}
