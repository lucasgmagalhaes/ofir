/**
 * @module
 * Enum variants and their construction (spec 2.5 and 3.5; stage 0:
 * bootstrap/src/sema/enums.c): `.Circle(1.0)` where the enum is known from
 * the context, `Shape.Circle(1.0)` and `Shape.Empty`.
 */

import base.intern.Symbol
import sema.check.Checker
import sema.check.Loc
import sema.check.itemOf
import sema.check.typeGenericsOf
import sema.check_ref.checkStorable
import sema.check_types.ownerType
import sema.check_types.resolveType
import sema.const_eval.constEval
import sema.def.DefKind
import sema.expr_check.coerce
import sema.program.Program
import sema.structs.checkNotRecursive
import sema.structs.isCopy
import sema.types.ERROR
import sema.types.I64
import sema.types.TyKind
import syntax.ast.ItemKind
import syntax.ast.Variant

/**
 * A variant of an enum.
 */
pub struct VariantInfo {
    /** Its name. */
    pub name: Symbol
    /** The names of its fields, for the named ones. */
    pub fieldNames: List<Option<Symbol>>
    /** Their types, with the enum's own type parameters. */
    pub types: List<int>
    /** Its tag. */
    pub discriminant: int
}

/**
 * The variants of an enum.
 */
pub struct EnumInfo {
    /** In declaration order. */
    pub variants: List<VariantInfo>
    /** Whether some variant has fields. */
    pub hasPayload: bool
}

// Whether an enum is `copy`, and its number of variants.
fn declaredFlags(p: Program, at: Loc) (bool, int) {
    return match itemOf(p, at).kind {
        ItemKind.Enum(isCopy, _, variants, _) => (isCopy, variants.len())
        _ => (false, 0)
    }
}

/**
 * Variant `i` of an enum, as written.
 *
 * @param p the program
 * @param at where the enum is
 * @param i the variant's position
 * @returns its declaration
 */
pub fn variantDeclAt(p: Program, at: Loc, i: int) &Variant {
    return match itemOf(p, at).kind {
        ItemKind.Enum(_, _, variants, _) => &variants[i]
        _ => {
            panic("variantDeclAt: not an enum")
        }
    }
}

fn fillVariant(c: mut Checker, p: Program, decl: &Variant, next: int,
               isCopyEnum: bool) VariantInfo {
    let v = VariantInfo{name: decl.name, fieldNames: [], types: [], discriminant: next}
    for f in 0..decl.fields.len() {
        const ty = resolveType(c, p, &decl.fields[f].ty)
        v.fieldNames.push(decl.fields[f].name)
        v.types.push(ty)
        checkNotRecursive(c, p, ty, decl.span)
        checkStorable(c, p, ty, decl.span, "an enum variant")
        if isCopyEnum && !isCopy(c, p, ty) && ty != ERROR {
            c.error("E0317", decl.span, "a `copy enum` can only have fields of Copy types, "
                    + "not `{c.typeName(ty)}`")
        }
    }
    if const Option.Some(value) = decl.discriminant {
        const ty = coerce(c, p, &value, I64)
        if ty != ERROR {
            if const Option.Some(found) = constEval(c, p, &value) {
                v.discriminant = found.signed()
            }
        }
    }
    return v
}

// Explicit discriminants: only without payloads, and all distinct.
fn checkDiscriminants(c: mut Checker, p: Program, at: Loc, info: &EnumInfo) {
    for i in 0..info.variants.len() {
        const decl = variantDeclAt(p, at, i)
        if decl.discriminant.isSome() && info.hasPayload {
            c.error("E0319", decl.span,
                    "explicit discriminants are allowed only in enums without payloads"
                        .toOwned())
            return
        }
        for j in 0..i {
            if info.variants[j].discriminant == info.variants[i].discriminant {
                c.error("E0319", decl.span,
                        "discriminant {info.variants[i].discriminant} is used twice")
            }
        }
    }
}

/**
 * Computes the variants of an enum, once.
 *
 * @param c the checker
 * @param p the program
 * @param id its `DefId`
 * @returns whether they are known (false while they are being computed)
 */
pub fn enumVariants(c: mut Checker, p: Program, id: int) bool {
    if c.info[id].variants.isSome() {
        return true
    }
    if c.info[id].checking {
        return false
    }
    const declared = declaredFlags(p, c.loc(id))
    const saved = c.enter(c.def(id).module)
    const savedSelf = c.selfType
    const outer = c.enterGenerics(typeGenericsOf(c, p, id))
    c.selfType = ownerType(c, p, id)
    c.info[id].checking = true
    let info = EnumInfo{variants: [], hasPayload: false}
    let next = 0
    for i in 0..declared.1 {
        const v = fillVariant(c, p, variantDeclAt(p, c.loc(id), i), next, declared.0)
        next = v.discriminant + 1
        info.hasPayload = info.hasPayload || v.types.len() > 0
        info.variants.push(v)
    }
    c.info[id].checking = false
    c.enterGenerics(outer)
    c.selfType = savedSelf
    c.enter(saved)
    checkDiscriminants(c, p, c.loc(id), &info)
    c.info[id].variants = Option.Some(Box.new(info))
    return true
}

/**
 * The variants of an enum, already computed.
 *
 * @param c the checker
 * @param id the enum's `DefId`
 * @returns its variants
 * @panics before `enumVariants`
 */
pub fn variantsOf(c: Checker, id: int) &EnumInfo {
    return match c.info[id].variants {
        Option.Some(info) => &*info
        Option.None => {
            panic("variantsOf: not computed")
        }
    }
}

/**
 * The position of a variant.
 *
 * @param info the variants
 * @param name its name
 * @returns its index, or -1
 */
pub fn variantIndex(info: &EnumInfo, name: Symbol) int {
    for i in 0..info.variants.len() {
        if info.variants[i].name.0 == name.0 {
            return i
        }
    }
    return -1
}

/**
 * The enum of a type, with its variants computed.
 *
 * @param c the checker
 * @param p the program
 * @param ty a type
 * @returns its `DefId`, when it is an enum whose variants are known
 */
pub fn enumOf(c: mut Checker, p: Program, ty: int) Option<int> {
    if c.types.kind(ty) != TyKind.Adt {
        return Option.None
    }
    const id = c.types.get(ty).data
    if c.def(id).kind != DefKind.Enum || !enumVariants(c, p, id) {
        return Option.None
    }
    return Option.Some(id)
}

/**
 * The check that `Option` and `Result` have the layout the compiler builds
 * (E0806), for the enums of std that it knows.
 *
 * @param c the checker
 * @param p the program
 * @param id an enum whose variants are computed
 */
pub fn checkEnumLayouts(c: mut Checker, p: Program, id: int) {
    if id != c.r.langItems[2] && id != c.r.langItems[3] {
        return
    }
    const isOption = id == c.r.langItems[2]
    const info = variantsOf(c, id)
    const ok = info.variants.len() == 2 && if isOption {
        variantIs(c, &info.variants[0], "Some", 1) && variantIs(c, &info.variants[1], "None", 0)
    } else {
        variantIs(c, &info.variants[0], "Ok", 1) && variantIs(c, &info.variants[1], "Err", 1)
    }
    if !ok {
        const message = if isOption {
            "`@lang(\"option\")` must declare `Some(T)` then `None`"
        } else {
            "`@lang(\"result\")` must declare `Ok(T)` then `Err(E)`"
        }
        c.error("E0806", c.def(id).span, message.toOwned())
    }
}

fn variantIs(c: Checker, v: &VariantInfo, name: str, count: int) bool {
    return c.text(v.name) == name && v.types.len() == count
}
