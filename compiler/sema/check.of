/**
 * What the checker knows of a declaration.
 */
pub struct DefInfo {
    /** A function's signature, a constant's type, an alias's type. */
    pub ty: int
    /** `ty` is known. */
    pub typed: bool
    /** Being computed: a cycle guard. */
    pub checking: bool
    /** A struct's fields, once computed. */
    pub fields: Option<Box<StructInfo>>
    /** An enum's variants, once computed. */
    pub variants: Option<Box<EnumInfo>>
    /** A constant's value, when it could be computed. */
    pub value: Option<ConstValue>
    /** A constant whose value `comptime` code computes, after checking. */
    pub byComptime: bool
    /** A function that returns a reference (spec 5.6). */
    pub returnsBorrow: bool
    /** The parameter it borrows from; -1 for `self`. */
    pub borrowSource: int
    /** That parameter is borrowed, not a reference itself. */
    pub sourceByRef: bool
    /**
     * The borrowed parameters with interior mutability, passed by address
     * (spec 13.5): bit 0 for `self`, bit `i + 1` for parameter `i`.
     */
    pub cellParams: int
}

/**
 * The type parameters in scope: those of the type declaring the method,
 * numbered first, then those of the function (spec 8.3).
 */
pub struct Generics {
    /** The type's parameters. */
    pub owner: List<Symbol>
    /** The function's own parameters. */
    pub fnParams: List<Symbol>
    /** The bounds of each parameter, numbered as above: `BOUND_EQ`, ... (spec 8.1). */
    pub bounds: List<int>
    /** The interfaces each parameter is bounded by, as `DefId`s (spec 9.6). */
    pub ifaces: List<List<int>>
    /** The type arguments of each of those interfaces, as a tuple type (`UNIT` for none). */
    pub ifaceArgs: List<List<int>>
    /** Actual arguments when expanding an alias; empty for generic declarations. */
    pub aliasArgs: List<int>
    /** The key type bounding each parameter (spec 16.2), or 0. */
    pub keys: List<int>
}

/**
 * No type parameters.
 *
 * @returns the empty generics
 */
pub fn noGenerics() Generics {
    return Generics{owner: [], fnParams: [], bounds: [], ifaces: [], ifaceArgs: [],
                    aliasArgs: [], keys: []}
}

/** The built-in interfaces a bound can name until interfaces (roadmap 5.3), as bits. */
pub const BOUND_EQ: int = 1
/** `Ord`: `<`, `<=`, `>`, `>=` and `sort`. */
pub const BOUND_ORD: int = 2
/** `Hash`: with `Eq`, `Map` keys. */
pub const BOUND_HASH: int = 4
/** `Clone`: `.clone()`. */
pub const BOUND_CLONE: int = 8
/** `Copy`: the arguments are Copy types (spec 2.9). */
pub const BOUND_COPY: int = 16
/** `Debug`: `{x:?}` (spec 9.9). */
pub const BOUND_DEBUG: int = 32
/** `Send`: values may move to another task (spec 14.3). */
pub const BOUND_SEND: int = 64
/** `Sync`: shared references may be used from several tasks (spec 14.3). */
pub const BOUND_SYNC: int = 128
/** The number of bits above. */
pub const BOUND_COUNT: int = 8
/** `const N: int`: a const parameter, its arguments integers (spec 8.7); not an interface. */
pub const BOUND_CONST: int = 256

/**
 * The bit of the built-in interface a bound names, or 0.
 *
 * @param c the checker
 * @param t the bound
 * @returns `BOUND_EQ`, `BOUND_ORD`, `BOUND_HASH`, `BOUND_CLONE`, `BOUND_COPY`,
 *          `BOUND_DEBUG`, `BOUND_SEND`, `BOUND_SYNC` or 0
 */
pub fn boundBit(c: Checker, t: &TypeExpr) int {
    const name = match t.kind {
        TypeKind.Path(segments, args) => if segments.len() == 1 && args.len() == 0 {
            segments[0]
        } else {
            return 0
        }
        _ => {
            return 0
        }
    }
    const text = c.text(name)
    return if text == "Eq" {
        BOUND_EQ
    } else if text == "Ord" {
        BOUND_ORD
    } else if text == "Hash" {
        BOUND_HASH
    } else if text == "Clone" {
        BOUND_CLONE
    } else if text == "Copy" {
        BOUND_COPY
    } else if text == "Debug" {
        BOUND_DEBUG
    } else if text == "Send" {
        BOUND_SEND
    } else if text == "Sync" {
        BOUND_SYNC
    } else {
        0
    }
}

/**
 * The number of the type parameter a bounded type names, or -1.
 *
 * @param t the bounded type
 * @param owner the type's parameters
 * @param fnParams the function's own
 * @returns its number: the type's first, then the function's
 */
pub fn boundedParam(t: &TypeExpr, owner: &List<Symbol>, fnParams: &List<Symbol>) int {
    const name = match t.kind {
        TypeKind.Path(segments, args) => if segments.len() == 1 && args.len() == 0 {
            segments[0]
        } else {
            return -1
        }
        _ => {
            return -1
        }
    }
    for i in 0..fnParams.len() {
        if fnParams[i].0 == name.0 {
            return owner.len() + i
        }
    }
    for i in 0..owner.len() {
        if owner[i].0 == name.0 {
            return i
        }
    }
    return -1
}

/**
 * The interface a bound names, `Name` or `module.Name`, or 0 when it names
 * none (built-in bounds included).
 *
 * @param c the checker, in the module of the bound
 * @param t the bound
 * @returns the interface's `DefId`, or 0
 */
pub fn interfaceOf(c: Checker, t: &TypeExpr) int {
    return match t.kind {
        TypeKind.Path(segments, _) => interfaceAt(c, &segments)
        _ => 0
    }
}

fn interfaceAt(c: Checker, segments: &List<Symbol>) int {
    let id = c.r.scope.module(segments[0])
    if segments.len() == 2 && id != 0 && c.def(id).kind == DefKind.Module {
        const target = c.def(id).target
        id = c.r.scope.moduleIn(target, segments[1])
        if id != 0 && c.def(id).module != target {   // an import of that module
            return 0
        }
    } else if segments.len() != 1 {
        return 0
    }
    return if id != 0 && c.def(id).kind == DefKind.Interface { id } else { 0 }
}

// Empty interface lists, one per type parameter.
fn noIfaces(n: int) List<List<int>> {
    let ifaces: List<List<int>> = []
    for _ in 0..n {
        ifaces.push([])
    }
    return ifaces
}

// The bounds of `preds`, added to `g`, whose parameters are already set.
fn addBounds(c: mut Checker, p: Program, preds: &List<WherePred>, g: mut Generics) {
    for i in 0..preds.len() {
        const index = boundedParam(&preds[i].ty, &g.owner, &g.fnParams)
        if index < 0 {
            continue   // E0334, reported with the declaration
        }
        if preds[i].isConst {   // its type, `int`, checked with the declaration
            g.bounds[index] = g.bounds[index] | BOUND_CONST | BOUND_COPY
            continue
        }
        for j in 0..preds[i].bounds.len() {
            if isKeyBound(&preds[i].bounds[j]) {
                g.keys[index] = keyBound(c, p, &preds[i].bounds[j], &g)
                g.bounds[index] = g.bounds[index] | BOUND_COPY   // a key has no value
                continue
            }
            g.bounds[index] = g.bounds[index] | boundBit(c, &preds[i].bounds[j])
            const iface = interfaceOf(c, &preds[i].bounds[j])
            if iface != 0 {
                g.ifaces[index].push(iface)
                const args = boundArgs(c, p, &preds[i].bounds[j], &g)
                g.ifaceArgs[index].push(args)
            }
        }
    }
}

/**
 * Whether a bound is a key type (spec 16.2): `keyof T`, `.x` or `A | B`.
 *
 * @param t the bound
 * @returns true for a key bound
 */
pub fn isKeyBound(t: &TypeExpr) bool {
    return match t.kind {
        TypeKind.KeyOf(_) |
        TypeKind.Key(_) |
        TypeKind.KeyOp(_, _, _) => true
        _ => false
    }
}

// The key type of a key bound, resolved once with the parameters of the
// declaration, or 0 when it is not a key type.
fn keyBound(c: mut Checker, p: Program, t: &TypeExpr, g: &Generics) int {
    const key = (t.span.file.0, t.span.start)
    if const Option.Some(known) = c.boundArgs.get(key) {
        return *known
    }
    const inner = Generics{owner: g.owner.clone(), fnParams: g.fnParams.clone(), bounds: [],
                           ifaces: [], ifaceArgs: [], aliasArgs: [], keys: []}
    const saved = c.enterGenerics(inner)
    const ty = resolveType(c, p, t)
    c.enterGenerics(saved)
    const kind = c.types.kind(ty)
    const bound = if kind == TyKind.Key || kind == TyKind.KeyOf { ty } else { 0 }
    c.boundArgs.insert(key, bound)
    return bound
}

/**
 * The type arguments of an interface named as a bound, `Iterator<T>`, as a
 * tuple type, resolved once with the parameters of the declaration.
 *
 * @param c the checker
 * @param p the program
 * @param t the bound
 * @param g the declaration's parameters
 * @returns the tuple, or `UNIT` when it has none
 */
pub fn boundArgs(c: mut Checker, p: Program, t: &TypeExpr, g: &Generics) int {
    const list = match t.kind {
        TypeKind.Path(_, args) => args.clone()
        _ => {
            return UNIT
        }
    }
    if list.len() == 0 {
        return UNIT
    }
    const key = (t.span.file.0, t.span.start)
    if const Option.Some(known) = c.boundArgs.get(key) {
        return *known
    }
    const inner = Generics{owner: g.owner.clone(), fnParams: g.fnParams.clone(), bounds: [],
                           ifaces: [], ifaceArgs: [], aliasArgs: [], keys: []}
    const saved = c.enterGenerics(inner)
    let types: List<int> = []
    for i in 0..list.len() {
        const ty = resolveType(c, p, &list[i])
        types.push(ty)
    }
    c.enterGenerics(saved)
    const tuple = c.types.tuple(types)
    c.boundArgs.insert(key, tuple)
    return tuple
}

/**
 * The `DefId` of an interface declaration.
 *
 * @param c the checker
 * @param item the interface
 * @returns its `DefId`, or 0
 */
pub fn interfaceDef(c: Checker, item: &Item) int {
    for id in 1..c.r.defs.len() {
        const def = &c.r.defs[id]
        const sameSpan = def.span.file.0 == item.span.file.0 && def.span.start == item.span.start
        if def.kind == DefKind.Interface && sameSpan {
            return id
        }
    }
    return 0
}

/**
 * The type parameters of a struct or enum, with their bounds; none for
 * other items.
 *
 * @param c the checker
 * @param item the item
 * @returns them
 */
pub fn typeGenerics(c: mut Checker, p: Program, item: &Item) Generics {
    const owner = itemTypeParams(item)
    let g = Generics{owner: owner.clone(), fnParams: [], bounds: List.filled(0, owner.len()),
                     ifaces: noIfaces(owner.len()), ifaceArgs: noIfaces(owner.len()),
                     aliasArgs: [], keys: List.filled(0, owner.len())}
    addBounds(c, p, &item.bounds, g)
    const isInterface = match item.kind {
        ItemKind.Interface(_, _, _) => true
        _ => false
    }
    if isInterface {   // `Self` satisfies the interface it is declared in
        g.ifaces[0].push(interfaceDef(c, item))
        g.ifaceArgs[0].push(ownArgs(c, &owner))
    }
    return g
}

/**
 * The type parameters of the struct, enum or interface `id`, with their
 * bounds, read in its module.
 *
 * @param c the checker
 * @param p the program
 * @param id its `DefId`
 * @returns them
 */
pub fn typeGenericsOf(c: mut Checker, p: Program, id: int) Generics {
    const saved = c.enter(c.def(id).module)
    const g = typeGenerics(c, p, itemOf(p, c.loc(id)))
    c.enter(saved)
    return g
}

// The arguments an interface's own parameters stand for inside it: the
// parameters themselves, after `Self`.
fn ownArgs(c: mut Checker, owner: &List<Symbol>) int {
    let params: List<int> = []
    for i in 1..owner.len() {
        params.push(c.types.param(i, owner[i].0))
    }
    return c.types.tuple(params)
}

/**
 * The type parameters of a function declared in `outer`: the type's, then
 * its own, with their bounds and those of its `where` clause.
 *
 * @param c the checker
 * @param p the program
 * @param outer the type's parameters
 * @param decl the function
 * @returns them
 */
pub fn fnGenericsIn(c: mut Checker, p: Program, outer: &Generics, decl: &FnDecl) Generics {
    const n = outer.owner.len() + decl.typeParams.len()
    let g = Generics{owner: outer.owner.clone(), fnParams: decl.typeParams.clone(),
                     bounds: List.filled(0, n), ifaces: noIfaces(n), ifaceArgs: noIfaces(n),
                     aliasArgs: [], keys: List.filled(0, n)}
    for i in 0..outer.owner.len() {
        if i < outer.bounds.len() {
            g.bounds[i] = outer.bounds[i]
        }
        if i < outer.keys.len() {
            g.keys[i] = outer.keys[i]
        }
        if i < outer.ifaces.len() {
            g.ifaces[i] = outer.ifaces[i].clone()
            g.ifaceArgs[i] = outer.ifaceArgs[i].clone()
        }
    }
    addBounds(c, p, &decl.bounds, g)
    return g
}

/**
 * The checker's state and results.
 */
pub struct Checker {
    /** The resolver, with the declarations, the scopes and the tables. */
    pub r: Resolver
    /** Every type of the program. */
    pub types: TypeTable
    /** What is known of each declaration, by `DefId`. */
    pub info: List<DefInfo>
    /** The `DefId` of each item of each module, or 0. */
    pub itemDefs: List<List<int>>
    /** The type of each expression and pattern, by module and `NodeId`. */
    pub nodeTypes: List<List<int>>
    /** The types of the locals of each function, by module and the `NodeId` of the function. */
    pub localTypesOf: List<Map<int, List<int>>>
    /** The implicit dereferences of an expression's value, by module and `NodeId`: the
     * type before each one (a `&T` or a `Box<T>`), in order (stage 0 inserts `*e`). */
    pub derefs: List<Map<int, List<int>>>
    /** The type of an expression's value after its implicit dereferences. */
    pub adjusted: List<Map<int, int>>
    /** The const parameter each use of one stands for, as its `Param` type, by
     * `module * 2^32 + NodeId` (spec 8.7). */
    pub constUses: Map<int, int>
    /** By module and `NodeId`: the field of `a.f` and `a.0`, the variant of a variant
     * expression or pattern, the method (`DefId`) of a method call's callee, or -1. */
    pub members: List<List<int>>
    /** The type arguments of each generic call, as a tuple type, by module and `NodeId`. */
    pub callTypeArgs: List<Map<int, int>>
    /** The parameter each argument of a call gives, by module and `NodeId`: only for the
     * calls that name arguments or leave parameters to their defaults (spec 3.3). */
    pub argSlots: List<Map<int, List<int>>>
    /** The functions whose parameter defaults were checked, by `DefId`. */
    pub defaultsChecked: Map<int, bool>
    /** The values converted from `List<T>` to `&[T]` (`list.asSlice()`), by module:
     * `NodeId` to the element type. */
    pub sliceCoercions: List<Map<int, int>>
    /** The arrays converted to `&[T]` (spec 2.12), by module: `NodeId` to the type before
     * the conversion, `[T; N]` or a reference to it. */
    pub arrayCoercions: List<Map<int, int>>
    /** The values converted to `&dyn I`, `*dyn I` or `Box<dyn I>`, by module: `NodeId` to
     * the type before the conversion. */
    pub dynCoercions: List<Map<int, int>>
    /** The values widened to a union (spec 17.3), by module: `NodeId` to the type before
     * the widening. */
    pub unionCoercions: List<Map<int, int>>
    /** The calls `x.f(...)` of a fn-typed field `f` (spec 10.2), by module: the callee's
     * `NodeId` to the field's index. */
    pub fieldCalls: List<Map<int, int>>
    /** What the move analysis found, by module and `NodeId`: `moves.MOVES`, `moves.CONSUMED`. */
    pub moveFlags: List<Map<int, int>>
    /** The std functions checked with the root whose move analysis waits for the lowering. */
    pub movesPending: Map<int, bool>
    /** The functions whose body was checked, by `DefId`. */
    pub bodyChecked: Map<int, bool>
    /** What the move analysis found of each function, by `DefId`. */
    pub fnMoves: Map<int, FnMoves>
    /** The type parameters in scope. */
    pub generics: Generics
    /** The locals of the function being checked. */
    pub locals: List<Local>
    /** Their types. */
    pub localTypes: List<int>
    /** The function's return type. */
    pub ret: int
    /** The type declaring the method, or `ERROR`. */
    pub selfType: int
    /** Per open loop: whether a `break` leaves it. */
    pub loops: List<bool>
    /** Per open loop: its label, if it has one. */
    pub loopLabels: List<Option<Symbol>>
    /** Above 0 inside an `unsafe` block or function. */
    pub unsafeDepth: int
    /** Above 0 inside a `comptime` expression or a `comptime fn` (spec 15.1). */
    pub comptimeDepth: int
    /** The `NodeId` of the function being checked, or -1. */
    pub fnNode: int
    /** Its `DefId`, or 0. */
    pub fnDef: int
    /** The struct literal being checked: where its shorthand fields `P\{x\}` are. */
    pub shorthandSpan: Span
    /** The closures being checked, innermost last: their `NodeId`s. */
    pub closures: List<int>
    /** Whether each of them is a `move` closure. */
    pub closureMoves: List<bool>
    /** Per module, per closure `NodeId`: the captured locals it modifies,
     * captured by `&mut` (spec 10.3). */
    pub capturesMut: List<Map<int, List<int>>>
    /** The type arguments of the interfaces named as bounds, by the bound's file and
     * offset: a tuple type (see `boundArgs`). */
    pub boundArgs: Map<(int, int), int>
    /** Type names bound while resolving a type: the key parameter of a mapped type. */
    pub typeVars: List<Symbol>
    /** Their types. */
    pub typeVarTypes: List<int>
    /** The type alias being expanded, or 0. */
    pub aliasDef: int
    /** The module that uses the outermost alias being expanded: its private
     * fields are keys in the alias too (spec 16.1). */
    pub aliasUser: int
    /** The struct of each instance of a mapped type (spec 16.4), by the mapped type's
     * file and offset and a tuple of the types in scope. */
    pub mapped: Map<(int, int, int), int>
    /** The mapped type aliases used over type parameters, by `DefId`. */
    pub mappedTpls: Map<int, MappedTpl>
    /** The alias and arguments of each struct of a mapped type, as a tuple type, by
     * `DefId`: for inference. */
    pub mappedArgs: Map<int, (int, int)>
    /** The names of the `infer` placeholders of the pattern being resolved (spec 16.5). */
    pub inferNames: List<Symbol>
    /** Whether a pattern of a conditional type is being resolved. */
    pub inferring: bool
    /** The type aliases being expanded, outermost first, with where each is named. */
    pub aliasStack: List<int>
    pub aliasSpans: List<Span>
    /** The branches of conditional types being resolved when each was entered. */
    pub aliasConds: List<int>
    pub aliasDefers: List<int>
    /** The branches being resolved of decided conditional types, and of those
     * deferred on a type parameter (spec 16.5). */
    pub condDepth: int
    pub deferDepth: int
    /** The generic enum of the union types of each number of members (spec 17.6). */
    pub unions: Map<int, int>
    /** The number of members of each union's enum, by its `DefId`. */
    pub unionDefs: Map<int, int>
    /** The `comptime for` loops and the members of their variables (spec 15.3), by
     * `module * 2^32 + NodeId`. */
    pub comptimeInfo: Map<int, ComptimeInfo>
    /** The open `comptime for` loops, innermost last. */
    pub comptimeLoops: List<ComptimeInfo>

    /**
     * Reports an error.
     *
     * @param code its code
     * @param span where
     * @param message what
     */
    pub fn error(mut self, code: str, span: Span, message: move str) {
        self.r.diags.error(code, span, message)
    }

    /**
     * Whether an enum is the one of a union type (spec 17.6): it has no declaration.
     *
     * @param id its `DefId`
     * @returns true for a union's enum
     */
    pub fn isUnion(self, id: int) bool {
        return self.unionDefs.get(id).isSome()
    }

    /**
     * Reports a construct the checker does not implement (E0901).
     *
     * @param span where
     * @param what what is not supported, ending with its verb (`"... are"`)
     * @returns the error type
     */
    pub fn unsupported(mut self, span: Span, what: str) int {
        self.error("E0901", span, "{what} not supported yet")
        return ERROR
    }

    /**
     * The text of a name.
     *
     * @param name the name
     * @returns its text
     */
    pub fn text(self, name: Symbol) str {
        return self.r.names.name(name)
    }

    /**
     * The name of a type parameter as written: an anonymous one
     * (`Shape 1`, ADR 0029) prints as its interface.
     *
     * @param name the parameter's name
     * @returns the text
     */
    pub fn paramText(self, name: Symbol) str {
        const text = self.r.names.name(name)
        if const Option.Some(at) = text.find(" ") {
            return text.slice(0, at)
        }
        return text
    }

    /**
     * A declaration.
     *
     * @param id its `DefId`
     * @returns it
     */
    pub fn def(self, id: int) &Def {
        return &self.r.defs[id]
    }

    /**
     * Where a declaration is.
     *
     * @param id its `DefId`
     * @returns its location
     */
    pub fn loc(self, id: int) Loc {
        const def = &self.r.defs[id]
        return Loc{module: def.module, item: def.item, member: def.member}
    }

    /**
     * The module being checked.
     *
     * @returns its index
     */
    pub fn module(self) int {
        return self.r.current
    }

    /**
     * The module that uses the alias being expanded, else the current one:
     * `keyof` and `T[K]` see its private fields as well as the current
     * module's.
     *
     * @returns the module index
     */
    pub fn keyModule(self) int {
        return if self.aliasDef != 0 { self.aliasUser } else { self.r.current }
    }

    /**
     * Makes module `m` the current one.
     *
     * @param m a module
     * @returns the previous one
     */
    pub fn enter(mut self, m: int) int {
        const previous = self.r.current
        self.r.current = m
        self.r.moduleName = self.r.moduleNames[m].clone()
        self.r.scope.useModule(m)
        return previous
    }

    /**
     * What a node's name resolves to, in the current module.
     *
     * @param id the node's number
     * @returns the resolution
     */
    pub fn res(self, id: int) Res {
        return self.r.tables[self.r.current].res[id]
    }

    /**
     * The local a node declares, in the current module.
     *
     * @param id the node's number
     * @returns its index, or -1
     */
    pub fn localAt(self, id: int) int {
        return self.r.tables[self.r.current].locals[id]
    }

    /**
     * The type found for a node of the current module.
     *
     * @param id the node's number
     * @returns its type
     */
    pub fn typeOf(self, id: int) int {
        return self.nodeTypes[self.r.current][id]
    }

    /**
     * Records the type of a node of the current module.
     *
     * @param id the node's number
     * @param ty its type
     */
    pub fn setType(mut self, id: int, ty: int) {
        self.nodeTypes[self.r.current][id] = ty
    }

    /**
     * Records the field, variant or method of a node of the current module.
     *
     * @param id the node's number
     * @param member its index or `DefId`
     */
    pub fn setMember(mut self, id: int, member: int) {
        self.members[self.r.current][id] = member
    }

    /**
     * Makes `generics` the type parameters in scope.
     *
     * @param generics the new ones
     * @returns the previous ones
     */
    pub fn enterGenerics(mut self, generics: move Generics) Generics {
        return mem.replace(self.generics, generics)
    }

    /**
     * The spelling of a type for messages: `&mut List<int>`.
     *
     * @param ty the type
     * @returns its text
     */
    pub fn typeName(self, ty: int) str {
        let out = ""
        self.appendType(out, ty, false)
        return out
    }

    /**
     * The spelling of a type with the structs and enums of modules other
     * than the root qualified by their module: `Pair<int, geo.Point>`, as
     * in the names of instances in LLVM IR.
     *
     * @param ty the type
     * @returns its text
     */
    pub fn qualifiedTypeName(self, ty: int) str {
        let out = ""
        self.appendType(out, ty, true)
        return out
    }

    fn appendList(self, out: mut str, args: &List<int>, qualified: bool) {
        for i in 0..args.len() {
            if i > 0 {
                out.push(", ")
            }
            self.appendType(out, args[i], qualified)
        }
    }

    // An operand of a `ValueOp`: a nested operation in parentheses.
    fn appendOperand(self, out: mut str, ty: int, qualified: bool) {
        const nested = self.types.get(ty).kind == TyKind.ValueOp
        if nested {
            out.push("(")
        }
        self.appendType(out, ty, qualified)
        if nested {
            out.push(")")
        }
    }

    fn appendType(self, out: mut str, ty: int, qualified: bool) {
        const t = self.types.get(ty)
        match t.kind {
            TyKind.Error => out.push("\{error\}")
            TyKind.Unit => out.push("()")
            TyKind.Never => out.push("!")
            TyKind.Bool => out.push(if t.data == 1 { "true" } else if t.data == 2 { "false" }
                                    else { "bool" })
            TyKind.Int => out.push(intName(t.data))
            TyKind.Float => out.push(if t.data == 64 { "float" } else { "f32" })
            TyKind.Str => out.push("str")
            TyKind.Ref | TyKind.Ptr => {
                out.push(if t.kind == TyKind.Ref { "&" } else { "*" })
                out.push(if t.data != 0 { "mut " } else { "" })
                self.appendType(out, t.inner, qualified)
            }
            TyKind.Slice | TyKind.Array => {
                out.push("[")
                self.appendType(out, t.inner, qualified)
                if t.kind == TyKind.Array && t.args.len() == 1 {
                    out.push("; ")
                    self.appendType(out, t.args[0], qualified)
                } else if t.kind == TyKind.Array {
                    out.push("; {t.data}")
                }
                out.push("]")
            }
            TyKind.Tuple => {
                out.push("(")
                self.appendList(out, &t.args, qualified)
                out.push(if t.args.len() == 1 { ",)" } else { ")" })
            }
            TyKind.Fn => {
                out.push(if t.data & FN_OWNED != 0 { "move fn(" } else { "fn(" })
                self.appendList(out, &t.args, qualified)
                out.push(")")
                if t.inner != UNIT {
                    out.push(" ")
                    self.appendType(out, t.inner, qualified)
                }
                if t.data & FN_SEND != 0 {
                    out.push(" + Send")
                }
            }
            TyKind.Adt | TyKind.Dyn => {
                if t.kind == TyKind.Dyn {
                    const d = &self.r.defs[t.data]
                    const inStd = self.r.moduleNames[d.module] == "std.core.any"
                    if inStd && self.text(d.name) == "any" {
                        out.push("any")   // spec 9.8
                        return
                    }
                    out.push("dyn ")
                }
                if t.kind == TyKind.Adt && self.isUnion(t.data) {   // `A | B`
                    for i in 0..t.args.len() {
                        if i > 0 {
                            out.push(" | ")
                        }
                        self.appendType(out, t.args[i], qualified)
                    }
                    return
                }
                const module = self.r.defs[t.data].module
                if qualified && module != 0 {
                    out.push(self.r.moduleNames[module])
                    out.push(".")
                }
                out.push(self.text(self.r.defs[t.data].name))
                if t.args.len() > 0 {
                    out.push("<")
                    self.appendList(out, &t.args, qualified)
                    out.push(">")
                }
            }
            TyKind.Param => out.push(self.paramText(Symbol(t.inner)))
            TyKind.Key => {
                const names = self.types.keyNames(ty)
                if names.len() == 0 {
                    out.push("keyof ()")
                }
                for i in 0..names.len() {
                    out.push(if i > 0 { " | ." } else { "." })
                    out.push(self.text(Symbol(names[i])))
                }
            }
            TyKind.KeyOf => {
                out.push("keyof ")
                self.appendType(out, t.inner, qualified)
            }
            TyKind.Index => {
                self.appendType(out, t.inner, qualified)
                out.push("[")
                self.appendType(out, t.args[0], qualified)
                out.push("]")
            }
            TyKind.Value => out.push("{t.data}")
            TyKind.ValueOp => {
                self.appendOperand(out, t.args[0], qualified)
                const ops = [" + ", " - ", " * ", " / ", " % "]
                out.push(ops[t.data])
                self.appendOperand(out, t.args[1], qualified)
            }
            TyKind.Mapped => {
                out.push(self.text(self.def(t.data).name))
                out.push("<")
                self.appendList(out, &t.args, qualified)
                out.push(">")
            }
            TyKind.KeyOp => {
                self.appendType(out, t.args[0], qualified)
                out.push(if t.data == 1 { " & " } else { " - " })
                self.appendType(out, t.args[1], qualified)
            }
            TyKind.Cond => {
                out.push("if ")
                self.appendType(out, t.args[0], qualified)
                if t.data == 1 {
                    out.push(" is ")
                    self.appendType(out, t.args[1], qualified)
                }
                out.push(" \{ ")
                self.appendType(out, t.args[2], qualified)
                out.push(" \} else \{ ")
                self.appendType(out, t.args[3], qualified)
                out.push(" \}")
            }
        }
    }
}

// The 64-bit types are printed with their usual alias names.
fn intName(kind: int) str {
    const names = ["i8", "i16", "i32", "int", "u8", "u16", "u32", "uint"]
    return names[kind].sliceFrom(0)
}

/** A `comptime for` loop (spec 15.3). */
pub const COMPTIME_LOOP: int = 0
/** `field.name` of its variable. */
pub const COMPTIME_NAME: int = 1
/** `field.index`. */
pub const COMPTIME_INDEX: int = 2
/** `field.attribute(key)`. */
pub const COMPTIME_ATTRIBUTE: int = 3
/** `variant.matches(value)`. */
pub const COMPTIME_MATCHES: int = 4

/**
 * A `comptime for` loop, or a member of its variable.
 */
pub copy struct ComptimeInfo {
    /**
     * `COMPTIME_LOOP`, `COMPTIME_NAME`, `COMPTIME_INDEX`, `COMPTIME_ATTRIBUTE`
     * or `COMPTIME_MATCHES`.
     */
    pub kind: int
    /** The loop variable's local. */
    pub local: int
    /** The index of the key parameter it stands for. */
    pub param: int
    /** The struct, tuple or enum type whose fields or variants it goes over, or 0. */
    pub base: int
    /** Whether it goes over the variants of an enum, `meta.variantsOf<T>()`. */
    pub variants: bool
    /** The key type it goes over. */
    pub bound: int
    /** The symbol of the key of `field.attribute(key)`, or 0. */
    pub key: int
    /** How many loops are open around it. */
    pub loops: int
}

/**
 * Where a declaration is: its module, item and member.
 */
pub copy struct Loc {
    /** The module. */
    pub module: int
    /** The item in it. */
    pub item: int
    /** The method, `extern` function or variant in the item, or -1. */
    pub member: int
}

/**
 * The item a declaration comes from.
 *
 * @param p the program
 * @param def the declaration
 * @returns its item
 */
pub fn itemOf(p: Program, def: Loc) &Item {
    if def.item < 0 {   // a type the checker made
        return &p.synthetic
    }
    return &p.modules[def.module].module.items[def.item]
}

/**
 * The type parameters of a struct or enum; none for other items.
 *
 * @param item the item
 * @returns their names
 */
pub fn itemTypeParams(item: &Item) List<Symbol> {
    return match item.kind {
        ItemKind.Struct(_, _, _, typeParams, _, _) => typeParams.clone()
        ItemKind.Enum(_, typeParams, _, _) => typeParams.clone()
        ItemKind.Interface(typeParams, _, _) => typeParams.clone()   // `Self` first
        _ => []
    }
}

/**
 * The function a function declaration comes from: an item, a method or a
 * function of an `extern` block.
 *
 * @param p the program
 * @param def a declaration of kind `Fn`
 * @returns the function
 */
pub fn fnOf(p: Program, def: Loc) &FnDecl {
    const item = &p.modules[def.module].module.items[def.item]
    return match item.kind {
        ItemKind.Fn(decl) => &*decl
        ItemKind.Struct(_, _, _, _, _, methods) => &methods[def.member]
        ItemKind.Enum(_, _, _, methods) => &methods[def.member]
        ItemKind.Extern(_, fns) => &fns[def.member]
        ItemKind.Interface(_, _, methods) => &methods[def.member]
        _ => {
            panic("fnOf: not a function")
        }
    }
}

pub fn emptyInfo() DefInfo {
    return DefInfo{ty: ERROR, typed: false, checking: false, fields: Option.None,
                   variants: Option.None,
                   value: Option.None, returnsBorrow: false, borrowSource: -1, sourceByRef: false,
                   cellParams: 0, byComptime: false}
}

/**
 * A checker for a resolved program.
 *
 * @param p the program
 * @param r the resolver, with its results
 * @returns the checker
 */
pub fn newChecker(p: Program, r: move Resolver) Checker {
    let info: List<DefInfo> = []
    let itemDefs: List<List<int>> = []
    let nodeTypes: List<List<int>> = []
    let localTypesOf: List<Map<int, List<int>>> = []
    let derefs: List<Map<int, List<int>>> = []
    let adjusted: List<Map<int, int>> = []
    let members: List<List<int>> = []
    let callTypeArgs: List<Map<int, int>> = []
    let argSlots: List<Map<int, List<int>>> = []
    let sliceCoercions: List<Map<int, int>> = []
    let arrayCoercions: List<Map<int, int>> = []
    let dynCoercions: List<Map<int, int>> = []
    let unionCoercions: List<Map<int, int>> = []
    let fieldCalls: List<Map<int, int>> = []
    let moveFlags: List<Map<int, int>> = []
    let capturesMut: List<Map<int, List<int>>> = []
    for m in 0..p.modules.len() {
        itemDefs.push(List.filled(0, p.modules[m].module.items.len()))
        nodeTypes.push(List.filled(ERROR, p.modules[m].module.nodeCount))
        localTypesOf.push(Map.new())
        derefs.push(Map.new())
        adjusted.push(Map.new())
        members.push(List.filled(-1, p.modules[m].module.nodeCount))
        callTypeArgs.push(Map.new())
        argSlots.push(Map.new())
        sliceCoercions.push(Map.new())
        arrayCoercions.push(Map.new())
        dynCoercions.push(Map.new())
        unionCoercions.push(Map.new())
        fieldCalls.push(Map.new())
        moveFlags.push(Map.new())
        capturesMut.push(Map.new())
    }
    for id in 0..r.defs.len() {
        info.push(emptyInfo())
        const def = &r.defs[id]
        const named = def.kind != DefKind.Module && def.kind != DefKind.Variant && def.member < 0
        if id > 0 && named && def.item >= 0 && itemDefs[def.module][def.item] == 0 {
            itemDefs[def.module][def.item] = id
        }
    }
    return Checker{r, types: TypeTable.new(), info, itemDefs, nodeTypes, localTypesOf, derefs,
                   adjusted, constUses: Map.new(),
                   members, callTypeArgs, argSlots, defaultsChecked: Map.new(), sliceCoercions,
                   arrayCoercions, dynCoercions, unionCoercions, fieldCalls, moveFlags,
                   fnMoves: Map.new(),
                   bodyChecked: Map.new(), movesPending: Map.new(),
                   generics: noGenerics(), locals: [], localTypes: [], ret: UNIT,
                   selfType: ERROR, loops: [], loopLabels: [], unsafeDepth: 0, comptimeDepth: 0,
                   fnNode: -1, fnDef: 0,
                   shorthandSpan: noSpan(), closures: [], closureMoves: [], capturesMut,
                   boundArgs: Map.new(), typeVars: [], typeVarTypes: [], aliasDef: 0, aliasUser: 0,
                   mapped: Map.new(), mappedTpls: Map.new(),
                   mappedArgs: Map.new(), inferNames: [], inferring: false, aliasStack: [],
                   aliasSpans: [], aliasConds: [], aliasDefers: [], condDepth: 0, deferDepth: 0,
                   unions: Map.new(),
                   unionDefs: Map.new(), comptimeInfo: Map.new(), comptimeLoops: []}
}

// ---------------------------------------------------------------------------
// Functions

/**
 * Checks a function's signature and, unless it is a std function outside
 * the root, its body.
 *
 * @param c the checker
 * @param p the program
 * @param id the function's `DefId`
 * @param selfType the type declaring the method, or `ERROR`
 */
pub fn checkFn(c: mut Checker, p: Program, id: int, selfType: int) {
    const decl = fnOf(p, c.loc(id))
    const inner = fnGenericsIn(c, p, &c.generics.clone(), decl)
    const outer = c.enterGenerics(inner)
    checkDeclBounds(c, p, &decl.bounds)
    const sig = fnSignature(c, p, id)
    checkBorrowSource(c, p, id, sig, selfType)   // what callers need, now
    c.info[id].cellParams = cellParams(c, p, decl, sig, selfType)
    c.enterGenerics(outer)
    if decl.body.isSome() && c.module() != 0 && moduleInStd(p, c.module()) {
        return   // a program uses few std functions: the lowering checks them
    }
    checkDefaults(c, p, id)
    checkBody(c, p, id, selfType, false)
}

// The `cellParams` of a function: its borrowed parameters whose types have
// interior mutability.
fn cellParams(c: mut Checker, p: Program, decl: &FnDecl, sig: int, selfType: int) int {
    let bits = 0
    if decl.hasSelf && decl.selfMode == Mode.Borrow && hasInteriorMutability(c, p, selfType) {
        bits = 1
    }
    const params = c.types.get(sig).args.clone()
    for i in 0..decl.params.len() {
        if i < params.len() && decl.params[i].mode == Mode.Borrow &&
           hasInteriorMutability(c, p, params[i]) {
            bits = bits | (1 << (i + 1))
        }
    }
    return bits
}

/**
 * Checks the body of a std function the lowering reached (stage 0:
 * `sema_check_late`), then runs its move analysis; once per function.
 *
 * @param c the checker
 * @param p the program
 * @param id the function's `DefId`
 */
pub fn checkLate(c: mut Checker, p: Program, id: int) {
    if c.movesPending.get(id).isSome() {   // checked with the root, analyzed now
        const _ = c.movesPending.remove(id)
        lateMoves(c, p, id)
        return
    }
    if c.bodyChecked.get(id).isSome() || fnOf(p, c.loc(id)).body.isNone() {
        return
    }
    const module = c.def(id).module
    const previous = c.enter(module)
    const selfType = if isTypeMember(c, p, id) {
        ownerTypeOf(c, p, module, c.def(id).item)
    } else {
        ERROR
    }
    const owner = ownerGenerics(c, p, id)
    const outer = c.enterGenerics(owner)
    checkBody(c, p, id, selfType, true)
    c.enterGenerics(outer)
    c.enter(previous)
}

// Whether a function is a method of a struct, an enum or an interface.
fn isTypeMember(c: Checker, p: Program, id: int) bool {
    if c.def(id).member < 0 {
        return false
    }
    return match itemOf(p, c.loc(id)).kind {
        ItemKind.Struct(_, _, _, _, _, _) | ItemKind.Enum(_, _, _, _) |
        ItemKind.Interface(_, _, _) => true
        _ => false
    }
}

// The type parameters of the type declaring a method, or none; in the module.
fn ownerGenerics(c: mut Checker, p: Program, id: int) Generics {
    return if isTypeMember(c, p, id) { typeGenericsOf(c, p, id) } else { noGenerics() }
}

// The move analysis of a std function checked with the root module (stage
// 0: `sema_moves_late`), with the function's locals and their types.
fn lateMoves(c: mut Checker, p: Program, id: int) {
    const decl = fnOf(p, c.loc(id))
    const module = c.def(id).module
    const previous = c.enter(module)
    c.locals = match c.r.tables[module].fnLocals.get(decl.id.0) {
        Option.Some(list) => list.clone()
        Option.None => []
    }
    c.localTypes = match c.localTypesOf[module].get(decl.id.0) {
        Option.Some(list) => list.clone()
        Option.None => []
    }
    c.fnNode = decl.id.0
    c.fnDef = id
    const owner = ownerGenerics(c, p, id)   // a `Copy` bound makes a parameter Copy
    const inner = fnGenericsIn(c, p, &owner, decl)
    const outer = c.enterGenerics(inner)
    checkMoves(c, p, id)
    c.enterGenerics(outer)
    c.enter(previous)
}

fn checkBody(c: mut Checker, p: Program, id: int, selfType: int, late: bool) {
    c.bodyChecked.insert(id, true)
    const decl = fnOf(p, c.loc(id))
    const inner = fnGenericsIn(c, p, &c.generics.clone(), decl)
    const outer = c.enterGenerics(inner)
    const sig = fnSignature(c, p, id)
    const locals = c.r.tables[c.module()].fnLocals.get(decl.id.0)
    c.locals = match locals {
        Option.Some(list) => list.clone()
        Option.None => []
    }
    c.localTypes = List.filled(ERROR, c.locals.len())
    c.ret = c.types.get(sig).inner
    c.selfType = selfType
    c.fnNode = decl.id.0
    c.fnDef = id
    if decl.hasSelf && c.localTypes.len() > 0 {
        c.localTypes[0] = selfType
    }
    for i in 0..decl.params.len() {
        const local = c.localAt(decl.params[i].id.0)
        if local >= 0 {
            c.localTypes[local] = c.types.get(sig).args[i]
        }
    }
    if decl.body.isNone() {
        c.enterGenerics(outer)
        return
    }
    c.unsafeDepth = if decl.isUnsafe { 1 } else { 0 }
    c.comptimeDepth = if decl.isComptime { 1 } else { 0 }
    const errors = c.r.diags.errorCount()
    let found = UNIT
    if const Option.Some(body) = decl.body {
        found = checkBlock(c, p, &body, ERROR, false)
    }
    c.unsafeDepth = 0
    c.comptimeDepth = 0
    if c.ret != UNIT && c.ret != ERROR && found != NEVER {
        c.error("E0303", decl.span,
                "function may reach its end without returning a value".toOwned())
    }
    // No cascade after type errors; std functions wait until the lowering reaches them.
    if c.r.diags.errorCount() == errors {
        if late || !moduleInStd(p, c.module()) {
            checkMoves(c, p, id)
        } else {
            c.movesPending.insert(id, true)
        }
    }
    const types = mem.replace(c.localTypes, [])
    c.localTypesOf[c.module()].insert(decl.id.0, types)
    c.enterGenerics(outer)
}

// ---------------------------------------------------------------------------
// Items

fn checkMethods(c: mut Checker, p: Program, index: int, methods: &List<FnDecl>) {
    const item = &p.modules[c.module()].module.items[index]
    const selfType = ownerTypeOf(c, p, c.module(), index)
    const outer = c.enterGenerics(typeGenerics(c, p, item))
    for i in 0..methods.len() {
        const def = c.r.tables[c.module()].fnDefs[methods[i].id.0]
        if def != 0 {
            checkFn(c, p, def, selfType)
        }
    }
    c.enterGenerics(outer)
}

// `extern "C"` blocks cross the C boundary; `extern "intrinsic"` blocks,
// reserved to std, declare operations the compiler generates.
fn checkExtern(c: mut Checker, p: Program, item: &Item, abi: str, fns: &List<FnDecl>) {
    if abi == "intrinsic" {
        if !c.r.moduleName.startsWith("std") {
            c.error("E0805", item.span,
                    "intrinsics are reserved to the standard library".toOwned())
        }
        for i in 0..fns.len() {
            fnSignature(c, p, c.r.tables[c.module()].fnDefs[fns[i].id.0])
        }
        return
    }
    if abi != "C" {
        c.error("E0804", item.span, "unknown ABI: only `extern \"C\"` is supported".toOwned())
    }
    for i in 0..fns.len() {
        checkCSignature(c, p, c.r.tables[c.module()].fnDefs[fns[i].id.0])
    }
}

/**
 * Reports the bounds that name no type parameter in scope (E0334) or no
 * interface (E0333).
 *
 * @param c the checker, with the declaration's parameters in scope
 * @param p the program
 * @param preds the bounds
 */
pub fn checkDeclBounds(c: mut Checker, p: Program, preds: &List<WherePred>) {
    for i in 0..preds.len() {
        const pred = &preds[i]
        if boundedParam(&pred.ty, &c.generics.owner, &c.generics.fnParams) < 0 {
            c.error("E0334", pred.ty.span, "`{typeText(&pred.ty, c.r.names)}` is not a type "
                    + "parameter of this declaration: only type parameters take bounds")
        }
        if pred.isConst {
            checkConstParamType(c, p, pred)
            continue
        }
        for j in 0..pred.bounds.len() {
            const iface = interfaceOf(c, &pred.bounds[j])
            if boundBit(c, &pred.bounds[j]) == 0 && iface == 0 && !isKeyBound(&pred.bounds[j]) {
                c.error("E0333", pred.bounds[j].span, "`{typeText(&pred.bounds[j], c.r.names)}` "
                        + "is not an interface")
            }
            checkArity(c, p, &pred.bounds[j], iface)
        }
    }
}

// E0361 unless the type of a const parameter is `int` (spec 8.7).
fn checkConstParamType(c: mut Checker, p: Program, pred: &WherePred) {
    const ty = resolveType(c, p, &pred.bounds[0])
    if ty != I64 && ty != ERROR {
        c.error("E0361", pred.bounds[0].span, "the type of the const parameter "
                + "`{typeText(&pred.ty, c.r.names)}` is `{c.typeName(ty)}`: const parameters "
                + "are of type `int`")
    }
}

fn checkTypeBounds(c: mut Checker, p: Program, item: &Item) {
    const outer = c.enterGenerics(typeGenerics(c, p, item))
    checkDeclBounds(c, p, &item.bounds)
    c.enterGenerics(outer)
}

fn checkItem(c: mut Checker, p: Program, index: int) {
    const item = &p.modules[c.module()].module.items[index]
    const id = c.itemDefs[c.module()][index]
    match item.kind {
        ItemKind.Fn(decl) => {
            const def = c.r.tables[c.module()].fnDefs[decl.id.0]
            if def == 0 {
                return
            }
            if decl.abi.len() > 0 {   // `extern "C" fn` with a body, called from C
                checkCSignature(c, p, def)
            }
            checkFn(c, p, def, ERROR)
        }
        ItemKind.Extern(abi, fns) => checkExtern(c, p, item, abi, &fns)
        ItemKind.Struct(_, _, _, _, _, methods) => {
            checkTypeBounds(c, p, item)
            if id != 0 {
                structFields(c, p, id)
                checkStructLayouts(c, p, id)
                checkStructAttrs(c, p, id)
            }
            checkMethods(c, p, index, &methods)
            checkAsserts(c, p, index)
        }
        ItemKind.Enum(_, _, _, methods) => {
            checkTypeBounds(c, p, item)
            if id != 0 {
                enumVariants(c, p, id)
                checkEnumLayouts(c, p, id)
                checkEnumAttrs(c, p, id)
            }
            checkMethods(c, p, index, &methods)
            checkAsserts(c, p, index)
        }
        ItemKind.Const(_, _) | ItemKind.Global(_, _) => {
            if id != 0 {
                checkConst(c, p, id)
            }
        }
        ItemKind.Interface(_, _, methods) => checkInterface(c, p, index, &methods)
        ItemKind.TypeAlias(_, _) | ItemKind.Import(_, _) => {}
    }
}

// An interface: embedding only interfaces, with its default methods checked
// once, generically over `Self` and its parameters.
fn checkInterface(c: mut Checker, p: Program, index: int, methods: &List<FnDecl>) {
    const item = &p.modules[c.module()].module.items[index]
    match item.kind {
        ItemKind.Interface(_, embeds, _) => {
            notInterfaces(c, p, &embeds)
            for i in 0..embeds.len() {
                if typeArgCount(&embeds[i]) > 0 {
                    c.unsupported(embeds[i].span, "embedded generic interfaces are")
                }
            }
            checkEmbeds(c, p, index, &embeds)
        }
        _ => {}
    }
    checkMethods(c, p, index, methods)
}

// E0327 for an interface embedded by one it embeds, E0328 for embedded
// methods with conflicting signatures and E0329 for conflicting defaults
// (spec 9.3, 9.4).
fn checkEmbeds(c: mut Checker, p: Program, index: int, embeds: &List<TypeExpr>) {
    const me = c.itemDefs[c.module()][index]
    if me == 0 || embeds.len() == 0 {
        return
    }
    let seen: List<int> = []
    for m in 0..methodCount(p, c.loc(me)) {
        seen.push(c.r.tables[c.module()].fnDefs[methodAt(p, c.loc(me), m).id.0])
    }
    let tops: List<int> = []
    for i in 0..embeds.len() {
        const embedded = interfaceOf(c, &embeds[i])
        tops.push(embedded)
        if embedded == 0 {
            continue   // E0333
        }
        if embedsInterface(c, p, embedded, me) {
            const through = if embedded == me {
                ""
            } else {
                " through `{c.text(c.def(embedded).name)}`"
            }
            c.error("E0327", embeds[i].span, "interface `{c.text(c.def(me).name)}` embeds "
                    + "itself{through}")
            continue
        }
        const why = embedConflict(c, p, embedded, seen)
        if why.len() > 0 {
            c.error("E0328", embeds[i].span, "conflicting methods: {why}")
        }
    }
    const clash = firstDefaultClash(c, p, &tops, me)
    if clash.len() > 0 {
        c.error("E0329", embeds[embeds.len() - 1].span, "conflicting defaults: {clash}; "
                + "declare the method in `{c.text(c.def(me).name)}`")
    }
}

// E0333 for each type named where only interfaces go, E0302 for each
// interface given the wrong number of type arguments.
fn notInterfaces(c: mut Checker, p: Program, list: &List<TypeExpr>) {
    for i in 0..list.len() {
        const iface = interfaceOf(c, &list[i])
        if iface == 0 {
            c.error("E0333", list[i].span, "`{typeText(&list[i], c.r.names)}` is not an "
                    + "interface")
        }
        checkArity(c, p, &list[i], iface)
    }
}

// The number of type arguments a path is written with.
fn typeArgCount(t: &TypeExpr) int {
    return match t.kind {
        TypeKind.Path(_, args) => args.len()
        _ => 0
    }
}

// E0302 unless interface `iface`, named by `t`, is given one type argument
// per parameter.
fn checkArity(c: mut Checker, p: Program, t: &TypeExpr, iface: int) {
    if iface == 0 {
        return
    }
    const expected = interfaceArity(c, p, iface)
    const found = typeArgCount(t)
    if found != expected {
        c.error("E0302", t.span, "wrong number of type arguments for "
                + "`{c.text(c.def(iface).name)}`: expected {expected}, found {found}")
    }
}

// `struct C: Shape`: E0335 unless the type satisfies each interface it
// asserts (spec 9.2).
fn checkAsserts(c: mut Checker, p: Program, index: int) {
    const item = &p.modules[c.module()].module.items[index]
    if item.asserts.len() == 0 || c.itemDefs[c.module()][index] == 0 {
        return
    }
    notInterfaces(c, p, &item.asserts)
    const ty = ownerTypeOf(c, p, c.module(), index)
    const generics = typeGenerics(c, p, item)
    for i in 0..item.asserts.len() {
        const iface = interfaceOf(c, &item.asserts[i])
        if iface == 0 || typeArgCount(&item.asserts[i]) != interfaceArity(c, p, iface) {
            continue   // E0333, E0302
        }
        const args = boundArgs(c, p, &item.asserts[i], &generics)
        const why = unsatisfied(c, p, ty, iface, args)
        if why.len() > 0 {
            c.error("E0335", item.asserts[i].span, "the type `{c.typeName(ty)}` does not "
                    + "satisfy `{interfaceText(c, iface, args)}`: {why}")
        }
    }
    let ifaces: List<int> = []
    for i in 0..item.asserts.len() {
        ifaces.push(interfaceOf(c, &item.asserts[i]))
    }
    const owner = c.itemDefs[c.module()][index]
    const clash = firstDefaultClash(c, p, &ifaces, owner)
    if clash.len() > 0 {
        c.error("E0329", item.asserts[item.asserts.len() - 1].span, "conflicting defaults: "
                + "{clash}; declare the method in `{c.typeName(ty)}`")
    }
}

/**
 * A `@test` or `@bench` function that this build does not check (spec 12.2,
 * 12.3).
 *
 * @param c the checker
 * @param p the program
 * @param item an item of the current module
 * @returns true to skip it
 */
pub fn skippedTest(c: Checker, p: Program, item: &Item) bool {
    const isFn = match item.kind {
        ItemKind.Fn(_) => true
        _ => false
    }
    const test = isFn && findAttribute(c.r, item.attributes, "test").isSome()
    const bench = isFn && findAttribute(c.r, item.attributes, "bench").isSome()
    if !test && !bench {
        return false
    }
    const wanted = (test && !c.r.benching) || (bench && c.r.benching)
    const tested = c.module() == 0 || !moduleInStd(p, c.module())
    return !c.r.testing || !tested || !wanted
}

/**
 * Checks every module of a program.
 *
 * @param p the program
 * @param r the resolver, with its results
 * @returns the checker, with its results
 */
pub fn checkProgram(p: Program, r: move Resolver) Checker {
    let c = newChecker(p, r)
    for m in 0..p.modules.len() {
        c.enter(m)
        for i in 0..p.modules[m].module.items.len() {
            if !skippedTest(c, p, &p.modules[m].module.items[i]) {
                checkItem(c, p, i)
            }
        }
    }
    c.enter(0)
    checkCSymbols(c, p)
    warnUnusedImports(c, p)
    return c
}

fn warnUnusedImports(c: mut Checker, p: Program) {
    for i in 0..c.r.imports.len() {
        const use = &c.r.imports[i]
        // std modules other than the root are checked in part: they are
        // checked whole as roots.
        const partlyChecked = use.module != 0 && moduleInStd(p, use.module)
        const preludeRoot = c.r.moduleNames[use.module] == "std.core"
        if !use.used && !preludeRoot && !partlyChecked {
            const span = use.span
            const name = c.text(use.name).toOwned()
            c.r.diags.warning("W0002", span, "unused import `{name}`")
        }
    }
}
