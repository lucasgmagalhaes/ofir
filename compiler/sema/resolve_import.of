/**
 * @module
 * Imports and module-qualified names (spec 7.2 and 7.3; stage 0:
 * bootstrap/src/sema/resolve_import.c). `import parser.lexer` binds `lexer`
 * to the module; `import std.collections.Map` binds `Map` to that module's
 * declaration. An expression `lexer.tokenize` resolves to the declaration.
 */

import base.intern.Symbol
import base.span.Span
import sema.def.Def
import sema.def.DefKind
import sema.def.Res
import sema.program.Program
import sema.resolve.ImportUse
import sema.resolve.ReExport
import sema.resolve.enter
import sema.resolve.Resolver
import sema.resolve_attributes.warnDeprecated
import sema.complete.completeMember
import sema.complete.probing
import sema.suggest.suggestMember
import sema.trace.traceUse
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.ItemKind

// The dotted name of the first `count` segments of `path`.
fn dotted(r: Resolver, path: &List<Symbol>, count: int) str {
    let out = ""
    for i in 0..count {
        if i > 0 {
            out.push(".")
        }
        out.push(r.text(path[i]))
    }
    return out
}

// The module named by the first `count` segments of `path`, or -1.
fn findModule(r: Resolver, path: &List<Symbol>, count: int) int {
    const name = dotted(r, path, count)
    if name.len() >= 511 {   // as stage 0's buffer
        return -1
    }
    for m in 0..r.moduleNames.len() {
        if r.moduleNames[m] == name {
            return m
        }
    }
    return -1
}

/**
 * The member `name` of module `index`: one of its declarations, or a
 * declaration or module it re-exports with `pub import` (spec 7.3).
 *
 * @param r the resolver
 * @param index a module
 * @param name the name
 * @returns its `DefId`, or 0 when module `index` has no such member
 */
pub fn memberOf(r: Resolver, index: int, name: Symbol) int {
    const id = r.scope.moduleIn(index, name)
    if id == 0 {
        return 0
    }
    if !r.def(id).inPrelude && r.def(id).module == index {
        return id
    }
    for e in r.reexports {
        if e.module == index && e.name.0 == name.0 {
            return id
        }
    }
    return 0
}

/**
 * Reports E0200 for `name`, missing from module `index`, with a help line
 * when `name` is a submodule that the module does not re-export.
 *
 * @param r the resolver
 * @param index a module
 * @param name the name
 * @param span where it is used
 */
pub fn missingMember(r: mut Resolver, index: int, name: Symbol, span: Span) {
    const parent = r.programName(index)
    r.error("E0200", span, "cannot find `{r.text(name)}` in module `{parent}`")
    const nested = "{parent}.{r.text(name)}"
    for m in 0..r.moduleNames.len() {
        if r.moduleNames[m] == nested {
            r.diags.help("import it: `import {nested}`, or re-export it from `{parent}` "
                         + "with `pub import {nested}`")
            return
        }
    }
    suggestMember(r, index, name)
}

/**
 * The declaration `name` of module `index`, reported when it is missing or
 * private; a module's members are its declarations and its re-exports.
 *
 * @param r the resolver
 * @param index a module
 * @param name the name
 * @param span where it is used
 * @returns its `DefId`, or 0 when it is missing
 */
pub fn moduleMember(r: mut Resolver, index: int, name: Symbol, span: Span) int {
    const id = memberOf(r, index, name)
    if id == 0 {
        missingMember(r, index, name, span)
        if probing(r, name) {
            completeMember(r, index, false)
        }
        return 0
    }
    if !r.def(id).isPub {
        r.error("E0202", span, "`{r.text(name)}` is private to module `{r.programName(index)}`")
    }
    return id
}

// The same declaration, or the same module imported twice (a test file may
// repeat its module's imports).
fn sameTarget(r: Resolver, a: int, b: int) bool {
    const x = r.def(a)
    const y = r.def(b)
    return a == b || (x.kind == DefKind.Module && y.kind == DefKind.Module && x.target == y.target)
}

fn bind(r: mut Resolver, name: Symbol, id: int, span: Span) {
    const existing = r.scope.module(name)
    if existing != 0 && sameTarget(r, existing, id) {
        return
    }
    if existing != 0 && !r.def(existing).inPrelude {
        r.error("E0201", span, "`{r.text(name)}` is defined more than once")
        return
    }
    r.scope.setModule(name, id)
}

/**
 * Binds the name of an `import` in the current module; a `pub import` was
 * bound before, by `bindReexports`.
 *
 * @param r the resolver
 * @param program the program
 * @param path the imported path
 * @param alias the `as` name, if any
 * @param span the import
 * @param isPub a `pub import`, which counts as used
 */
pub fn resolveImport(r: mut Resolver, program: Program, path: &List<Symbol>,
                     alias: Option<Symbol>, span: Span, isPub: bool) {
    const name = alias ?? path[path.len() - 1]
    r.imports.push(ImportUse{module: r.current, name, span, used: isPub})
    if !isPub {
        bindImport(r, path, name, span, false)
    }
    traceUse(r, "import", name, span, Res.Def(r.scope.module(name)))
}

fn bindImport(r: mut Resolver, path: &List<Symbol>, name: Symbol, span: Span, isPub: bool) {
    const module = findModule(r, path, path.len())
    if module >= 0 {   // a module
        let def = Def{kind: DefKind.Module, name, span, isPub, inPrelude: false, lang: false,
                      module: r.current, item: -1, member: -1, target: module, primitive: -1}
        const id = r.addDef(def)
        bind(r, name, id, span)
        return
    }
    const owner = if path.len() > 1 { findModule(r, path, path.len() - 1) } else { -1 }
    if owner < 0 {
        r.error("E0204", span, "cannot find module `{dotted(r, path, path.len())}`")
        return
    }
    const member = moduleMember(r, owner, path[path.len() - 1], span)   // a declaration
    if member != 0 {
        bind(r, name, member, span)
        if isPub && r.def(member).kind != DefKind.Module {
            r.reexports.push(ReExport{module: r.current, name})
        }
    }
}

/**
 * Binds the `pub import`s of every module before the other imports, those
 * of a module after the ones of the modules it imports from, so that a
 * re-export may name another; a cycle of re-exports stops where it closes.
 *
 * @param r the resolver
 * @param program the program
 */
pub fn bindReexports(r: mut Resolver, program: Program) {
    let state = List.filled(false, program.modules.len())
    for m in 0..program.modules.len() {
        reexportsOf(r, program, m, state)
    }
}

fn reexportsOf(r: mut Resolver, program: Program, m: int, seen: mut List<bool>) {
    if seen[m] {
        return
    }
    seen[m] = true
    const items = &program.modules[m].module.items
    for i in 0..items.len() {
        const item = &items[i]
        if !item.isPub {
            continue
        }
        if const ItemKind.Import(path, alias) = item.kind {
            const owner = if path.len() > 1 { findModule(r, &path, path.len() - 1) } else { -1 }
            if owner >= 0 {
                reexportsOf(r, program, owner, seen)
            }
            enter(r, program, m)
            bindImport(r, &path, alias ?? path[path.len() - 1], item.span, true)
        }
    }
}

/**
 * `m.name` where `m` names an imported module: resolves to the declaration.
 *
 * @param r the resolver
 * @param e the field expression
 * @param base its base, already resolved
 * @param name the field's name
 */
pub fn resolveQualified(r: mut Resolver, e: &Expr, base: &Expr, name: Symbol) {
    const isName = match base.kind {
        ExprKind.Ident(_) => true
        ExprKind.Field(_, _, _) => true   // `a.b.c` where `a.b` was a module member
        _ => false
    }
    const target = match r.tables[r.current].res[base.id.0] {
        Res.Def(id) => id
        _ => 0
    }
    if !isName || target == 0 || r.def(target).kind != DefKind.Module {
        return
    }
    const member = moduleMember(r, r.def(target).target, name, e.span)
    const res: Res = if member != 0 { Res.Def(member) } else { Res.Error }
    r.setRes(e.id.0, res)
    traceUse(r, "member", name, e.span, res)
    warnDeprecated(r, member, e.span)
}

// `std.core` and its submodules form the prelude.
fn inCore(r: Resolver, m: int) bool {
    const name = r.programName(m)
    return name == "std.core" || (name.len() > 9 && name.startsWith("std.core."))
}

// Makes the public declarations of the prelude module `core` visible in
// every other module, below the module's own declarations (spec 7.4).
fn exportCore(r: mut Resolver, core: int) {
    for name in 0..r.scope.symbols() {
        const id = r.scope.moduleIn(core, Symbol(name))
        if id == 0 || !r.def(id).isPub || r.def(id).module != core {
            continue
        }
        for m in 0..r.moduleNames.len() {
            const own = r.scope.moduleIn(m, Symbol(name))
            if m != core && (own == 0 || r.def(own).inPrelude) {
                r.scope.setIn(m, Symbol(name), id)
            }
        }
    }
}

/**
 * Exports the prelude modules (`std.core` and `std.core.*`) to the others,
 * once every module's declarations are known.
 *
 * @param r the resolver
 * @param program the program
 */
pub fn importPrelude(r: mut Resolver, program: Program) {
    for m in 0..program.modules.len() {
        if inCore(r, m) {
            exportCore(r, m)
        }
    }
}
