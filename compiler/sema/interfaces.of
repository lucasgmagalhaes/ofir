/**
 * @module
 * Interfaces (spec 9): the methods an interface requires, embedded
 * interfaces included, and whether a type satisfies them. Satisfaction is
 * structural: a type satisfies an interface when it has a method of the
 * same name, `self` mode and signature for each method without a body.
 */

import base.intern.Symbol
import sema.check.Checker
import sema.check.interfaceOf
import sema.check.itemOf
import sema.check.itemTypeParams
import sema.check_methods.methodAt
import sema.check_methods.methodCount
import sema.check_ref.holdsRef
import sema.check_types.fnSignature
import sema.program.Program
import sema.types.TyKind
import sema.types.UNIT
import syntax.ast.ItemKind
import syntax.ast.Mode

/**
 * An interface and the interfaces it embeds, directly or not, each once.
 *
 * @param c the checker
 * @param p the program
 * @param iface the interface's `DefId`
 * @returns their `DefId`s, `iface` first
 */
pub fn interfaceClosure(c: mut Checker, p: Program, iface: int) List<int> {
    let out = [iface]
    let i = 0
    for i < out.len() {
        const id = out[i]
        match itemOf(p, c.loc(id)).kind {
            ItemKind.Interface(_, embeds, _) => {
                const saved = c.enter(c.def(id).module)
                for j in 0..embeds.len() {
                    const embedded = interfaceOf(c, &embeds[j])
                    if embedded != 0 && !contains(&out, embedded) {
                        out.push(embedded)
                    }
                }
                c.enter(saved)
            }
            _ => {}
        }
        i += 1
    }
    return out
}

fn contains(list: &List<int>, x: int) bool {
    for i in 0..list.len() {
        if list[i] == x {
            return true
        }
    }
    return false
}

/**
 * The position of method `name` among the methods of a type or interface.
 *
 * @param c the checker
 * @param p the program
 * @param owner its `DefId`
 * @param name the method
 * @returns the position, or -1
 */
pub fn methodIndex(c: Checker, p: Program, owner: int, name: Symbol) int {
    if owner == 0 || c.def(owner).item < 0 {
        return -1
    }
    for i in 0..methodCount(p, c.loc(owner)) {
        if methodAt(p, c.loc(owner), i).name.0 == name.0 {
            return i
        }
    }
    return -1
}

/**
 * The interface, among `iface` and those it embeds, that declares method
 * `name`.
 *
 * @param c the checker
 * @param p the program
 * @param iface the interface
 * @param name the method
 * @returns its `DefId`, or 0
 */
pub fn declaringInterface(c: mut Checker, p: Program, iface: int, name: Symbol) int {
    const all = interfaceClosure(c, p, iface)
    for i in 0..all.len() {
        if methodIndex(c, p, all[i], name) >= 0 {
            return all[i]
        }
    }
    return 0
}

/**
 * The methods of an interface, embedded ones included, that can be called
 * through a `dyn` value, in vtable order.
 *
 * @param c the checker
 * @param p the program
 * @param iface the interface
 * @returns their `DefId`s
 */
pub fn dynMethods(c: mut Checker, p: Program, iface: int) List<int> {
    let out: List<int> = []
    const all = interfaceClosure(c, p, iface)
    for i in 0..all.len() {
        const module = c.def(all[i]).module
        for m in 0..methodCount(p, c.loc(all[i])) {
            const id = c.r.tables[module].fnDefs[methodAt(p, c.loc(all[i]), m).id.0]
            if dynCallable(c, p, id) {
                out.push(id)
            }
        }
    }
    return out
}

/**
 * Whether an interface method can be called through a `dyn` value: it
 * borrows `self`, has no type parameters and does not mention `Self`.
 *
 * @param c the checker
 * @param p the program
 * @param id the method's `DefId`
 * @returns true if it can
 */
pub fn dynCallable(c: mut Checker, p: Program, id: int) bool {
    const m = methodAt(p, c.loc(id), c.def(id).member)
    if !m.hasSelf || m.selfMode == Mode.Move || m.typeParams.len() > 0 {
        return false
    }
    return !c.types.get(fnSignature(c, p, id)).hasParam
}

/**
 * Why an interface cannot be used as `dyn I`: a method without a body that
 * cannot be called through a vtable (spec 9.7).
 *
 * @param c the checker
 * @param p the program
 * @param iface the interface
 * @returns "" or the reason
 */
pub fn dynIncompatible(c: mut Checker, p: Program, iface: int) str {
    const all = interfaceClosure(c, p, iface)
    for i in 0..all.len() {
        const module = c.def(all[i]).module
        for m in 0..methodCount(p, c.loc(all[i])) {
            const method = methodAt(p, c.loc(all[i]), m)
            const id = c.r.tables[module].fnDefs[method.id.0]
            if method.body.isNone() && !dynCallable(c, p, id) {
                return ("method `{c.text(method.name)}` takes `self` by value, is generic "
                    + "or mentions `Self`")
            }
        }
    }
    return ""
}

/**
 * Whether the interfaces bounding a type parameter include `iface`, or
 * one that embeds it.
 *
 * @param c the checker
 * @param p the program
 * @param param the parameter's number
 * @param iface the interface
 * @param args its type arguments, as a tuple type
 * @returns true if they do
 */
pub fn paramHas(c: mut Checker, p: Program, param: int, iface: int, args: int) bool {
    if param >= c.generics.ifaces.len() {
        return false
    }
    const bounds = c.generics.ifaces[param].clone()
    for i in 0..bounds.len() {
        if bounds[i] == iface && c.generics.ifaceArgs[param][i] == args {
            return true
        }
        if args != UNIT {
            continue   // only the bound itself has type arguments
        }
        const all = interfaceClosure(c, p, bounds[i])
        if contains(&all, iface) {
            return true
        }
    }
    return false
}

/**
 * The type arguments of the interface `iface` bounding a type parameter,
 * `T` in `I: Iterator<T>`; none when it is embedded by a bound.
 *
 * @param c the checker
 * @param param the parameter's number
 * @param iface the interface
 * @returns them, as a tuple type
 */
pub fn paramBoundArgs(c: Checker, param: int, iface: int) int {
    if param >= c.generics.ifaces.len() {
        return UNIT
    }
    for i in 0..c.generics.ifaces[param].len() {
        if c.generics.ifaces[param][i] == iface {
            return c.generics.ifaceArgs[param][i]
        }
    }
    return UNIT
}

/**
 * The number of type parameters of an interface, `Self` aside.
 *
 * @param c the checker
 * @param p the program
 * @param iface the interface
 * @returns it
 */
pub fn interfaceArity(c: Checker, p: Program, iface: int) int {
    return itemTypeParams(itemOf(p, c.loc(iface))).len() - 1
}

/**
 * An interface with its type arguments, as in `Iterator<int>`.
 *
 * @param c the checker
 * @param iface the interface
 * @param args its type arguments, as a tuple type
 * @returns the text
 */
pub fn interfaceText(c: Checker, iface: int, args: int) str {
    let out = c.text(c.def(iface).name).toOwned()
    const list = &c.types.get(args).args
    for i in 0..list.len() {
        out += if i == 0 { "<" } else { ", " }
        out += c.typeName(list[i])
    }
    if list.len() > 0 {
        out += ">"
    }
    return out
}

/**
 * The interface bounding a type parameter that declares method `name`.
 *
 * @param c the checker
 * @param p the program
 * @param param the parameter's number
 * @param name the method
 * @returns its `DefId`, or 0
 */
pub fn paramMethodOwner(c: mut Checker, p: Program, param: int, name: Symbol) int {
    if param >= c.generics.ifaces.len() {
        return 0
    }
    const bounds = c.generics.ifaces[param].clone()
    for i in 0..bounds.len() {
        const found = declaringInterface(c, p, bounds[i], name)
        if found != 0 {
            return found
        }
    }
    return 0
}

/**
 * Why a type does not satisfy an interface, or "" when it does. Type
 * parameters satisfy the interfaces they are bounded by; other types need
 * a matching method for each method without a body.
 *
 * @param c the checker
 * @param p the program
 * @param ty the type
 * @param iface the interface
 * @param args its type arguments, as a tuple type (`UNIT` for none)
 * @returns "" or the reason, as in "missing method `area`"
 */
pub fn unsatisfied(c: mut Checker, p: Program, ty: int, iface: int, args: int) str {
    const kind = c.types.kind(ty)
    if kind == TyKind.Error || kind == TyKind.Never {
        return ""
    }
    if isAny(c, iface) && kind != TyKind.Dyn {   // the compiler provides `typeName`
        if holdsRef(c, p, ty) {
            return "it holds a reference"
        }
        return ""
    }
    if kind == TyKind.Dyn {   // `dyn I` satisfies `I` and the interfaces `I` embeds
        if args == UNIT && contains(&interfaceClosure(c, p, c.types.get(ty).data), iface) {
            return ""
        }
        return "it is not one of its interfaces"
    }
    if kind == TyKind.Param {
        if paramHas(c, p, c.types.get(ty).data, iface, args) {
            return ""
        }
        return "it is not bounded by it"
    }
    let owner = 0
    let ownerArgs: List<int> = []
    if kind == TyKind.Adt {
        owner = c.types.get(ty).data
        ownerArgs = c.types.get(ty).args.clone()
    } else if ty < c.r.lang.len() {
        owner = c.r.lang[ty]
    }
    let selfArgs = [ty]   // `Self`, then the interface's own parameters
    const given = c.types.get(args).args.clone()
    for i in 0..given.len() {
        selfArgs.push(given[i])
    }
    const all = interfaceClosure(c, p, iface)
    for i in 0..all.len() {
        const wanted = if i == 0 { selfArgs.clone() } else { [ty] }
        const why = unsatisfiedBy(c, p, owner, &ownerArgs, all[i], &wanted)
        if why.len() > 0 {
            return why
        }
    }
    return ""
}

// The first method of `iface` without a body that `owner` lacks or declares
// with another signature: `args` are those of `owner`, `selfArgs` those of
// `iface`, `Self` first.
fn unsatisfiedBy(c: mut Checker, p: Program, owner: int, args: &List<int>, iface: int,
                 selfArgs: &List<int>) str {
    const module = c.def(iface).module
    for m in 0..methodCount(p, c.loc(iface)) {
        const wanted = methodAt(p, c.loc(iface), m)
        if wanted.body.isSome() {
            continue   // a default method
        }
        const name = wanted.name
        const index = methodIndex(c, p, owner, name)
        if index < 0 {
            return "missing method `{c.text(name)}`"
        }
        const found = methodAt(p, c.loc(owner), index)
        const sameShape = (found.hasSelf == wanted.hasSelf && found.selfMode == wanted.selfMode
            && found.typeParams.len() == 0 && wanted.typeParams.len() == 0)
        const foundId = c.r.tables[c.def(owner).module].fnDefs[found.id.0]
        const wantedId = c.r.tables[module].fnDefs[wanted.id.0]
        const foundSig = c.types.subst(fnSignature(c, p, foundId), args.clone())
        const wantedSig = c.types.subst(fnSignature(c, p, wantedId), selfArgs.clone())
        if !sameShape || foundSig != wantedSig {
            return "method `{c.text(name)}` has a different signature"
        }
    }
    return ""
}

/**
 * The signatures of the methods without a body of `iface` that a type
 * declares with the same name and `self` mode: the interface's, in its
 * own parameters, and the type's.
 *
 * @param c the checker
 * @param p the program
 * @param ty the type
 * @param iface the interface
 * @returns the pairs
 */
pub fn implementedSigs(c: mut Checker, p: Program, ty: int, iface: int) List<(int, int)> {
    let out: List<(int, int)> = []
    let owner = 0
    let args: List<int> = []
    if c.types.kind(ty) == TyKind.Adt {
        owner = c.types.get(ty).data
        args = c.types.get(ty).args.clone()
    } else if ty < c.r.lang.len() {
        owner = c.r.lang[ty]
    }
    const module = c.def(iface).module
    for m in 0..methodCount(p, c.loc(iface)) {
        const wanted = methodAt(p, c.loc(iface), m)
        const index = methodIndex(c, p, owner, wanted.name)
        if wanted.body.isSome() || index < 0 {
            continue
        }
        const found = methodAt(p, c.loc(owner), index)
        if found.hasSelf != wanted.hasSelf || found.selfMode != wanted.selfMode {
            continue
        }
        const foundId = c.r.tables[c.def(owner).module].fnDefs[found.id.0]
        const wantedId = c.r.tables[module].fnDefs[wanted.id.0]
        const foundSig = c.types.subst(fnSignature(c, p, foundId), args.clone())
        out.push((fnSignature(c, p, wantedId), foundSig))
    }
    return out
}

/**
 * Whether a method is declared in an interface.
 *
 * @param c the checker
 * @param p the program
 * @param id the method's `DefId`
 * @returns true if it is
 */
pub fn isInterfaceMethod(c: Checker, p: Program, id: int) bool {
    if c.def(id).member < 0 {
        return false
    }
    return match itemOf(p, c.loc(id)).kind {
        ItemKind.Interface(_, _, _) => true
        _ => false
    }
}

/**
 * The interface asserted by a struct or enum (`struct C: Shape`), or one
 * it embeds, that gives the type default method `name` (spec 9.3).
 *
 * @param c the checker
 * @param p the program
 * @param owner the type's `DefId`
 * @param name the method
 * @returns the interface's `DefId`, or 0
 */
pub fn assertedDefault(c: mut Checker, p: Program, owner: int, name: Symbol) int {
    if owner == 0 || c.def(owner).item < 0 {
        return 0
    }
    const asserts = itemOf(p, c.loc(owner)).asserts.clone()
    let ifaces: List<int> = []
    const saved = c.enter(c.def(owner).module)
    for i in 0..asserts.len() {
        ifaces.push(interfaceOf(c, &asserts[i]))
    }
    c.enter(saved)
    for i in 0..ifaces.len() {
        if ifaces[i] == 0 {
            continue
        }
        const all = interfaceClosure(c, p, ifaces[i])
        for j in 0..all.len() {
            const index = methodIndex(c, p, all[j], name)
            if index >= 0 && methodAt(p, c.loc(all[j]), index).body.isSome() {
                return all[j]
            }
        }
    }
    return 0
}

/**
 * Whether an interface embeds `target`, directly or not, or is it.
 *
 * @param c the checker
 * @param p the program
 * @param iface the interface
 * @param target another interface
 * @returns true if it does
 */
pub fn embedsInterface(c: mut Checker, p: Program, iface: int, target: int) bool {
    return contains(&interfaceClosure(c, p, iface), target)
}

/**
 * Why the interfaces bounding a type parameter give conflicting defaults
 * for method `name` (spec 9.3).
 *
 * @param c the checker
 * @param p the program
 * @param param the type parameter
 * @param name the method
 * @returns the reason, or ""
 */
pub fn paramDefaultClash(c: mut Checker, p: Program, param: int, name: Symbol) str {
    if param >= c.generics.ifaces.len() {
        return ""
    }
    const bounds = c.generics.ifaces[param].clone()
    return defaultClash(c, p, &bounds, name)
}

/**
 * Why two interfaces give conflicting defaults for method `name` (spec
 * 9.3): the first default each of `tops`, or an interface it embeds,
 * gives, when two of them differ and none declares `name` without a body.
 *
 * @param c the checker
 * @param p the program
 * @param tops the interfaces, as embedded, asserted or bounding
 * @param name the method
 * @returns the reason, or ""
 */
pub fn defaultClash(c: mut Checker, p: Program, tops: &List<int>, name: Symbol) str {
    let providers: List<int> = []
    for i in 0..tops.len() {
        if tops[i] == 0 {
            continue
        }
        const all = interfaceClosure(c, p, tops[i])
        let first = 0
        for j in 0..all.len() {
            const index = methodIndex(c, p, all[j], name)
            if index < 0 {
                continue
            }
            if methodAt(p, c.loc(all[j]), index).body.isNone() {
                return ""   // the type must declare it
            }
            if first == 0 {
                first = all[j]
            }
        }
        if first != 0 && !contains(&providers, first) {
            providers.push(first)
        }
    }
    if providers.len() < 2 {
        return ""
    }
    const a = c.text(c.def(providers[0]).name).toOwned()
    const b = c.text(c.def(providers[1]).name).toOwned()
    return "`{c.text(name)}` has a default in both `{a}` and `{b}`"
}

/**
 * The first conflicting defaults among `tops` for a method that `owner`
 * does not declare (spec 9.3).
 *
 * @param c the checker
 * @param p the program
 * @param tops the interfaces, as embedded or asserted
 * @param owner the type or interface declaring them, whose own methods win
 * @returns the reason, or ""
 */
pub fn firstDefaultClash(c: mut Checker, p: Program, tops: &List<int>, owner: int) str {
    for i in 0..tops.len() {
        if tops[i] == 0 {
            continue
        }
        const all = interfaceClosure(c, p, tops[i])
        for j in 0..all.len() {
            for m in 0..methodCount(p, c.loc(all[j])) {
                const method = methodAt(p, c.loc(all[j]), m)
                if method.body.isNone() || methodIndex(c, p, owner, method.name) >= 0 {
                    continue
                }
                const why = defaultClash(c, p, tops, method.name)
                if why.len() > 0 {
                    return why
                }
            }
        }
    }
    return ""
}

/**
 * Why the methods of interface `embedded`, and those it embeds, conflict
 * with those `seen` so far: a method of the same name with another `self`
 * mode or signature (spec 9.4). Adds the methods to `seen`.
 *
 * @param c the checker
 * @param p the program
 * @param embedded the interface embedded
 * @param seen the `DefId`s of the methods seen, one per name
 * @returns the reason, or ""
 */
pub fn embedConflict(c: mut Checker, p: Program, embedded: int, seen: mut List<int>) str {
    const all = interfaceClosure(c, p, embedded)
    for i in 0..all.len() {
        const module = c.def(all[i]).module
        for m in 0..methodCount(p, c.loc(all[i])) {
            const method = methodAt(p, c.loc(all[i]), m)
            const id = c.r.tables[module].fnDefs[method.id.0]
            const other = sameName(c, &seen, method.name)
            if other == 0 {
                seen.push(id)
            } else if !sameMethod(c, p, other, id) {
                const d = c.def(other)
                const first = c.itemDefs[d.module][d.item]
                return ("method `{c.text(method.name)}` of "
                    + "`{c.text(c.def(all[i]).name)}` has another signature than the one of "
                    + "`{c.text(c.def(first).name)}`")
            }
        }
    }
    return ""
}

// The method among `seen` named `name`, or 0.
fn sameName(c: Checker, seen: &List<int>, name: Symbol) int {
    for i in 0..seen.len() {
        if c.def(seen[i]).name.0 == name.0 {
            return seen[i]
        }
    }
    return 0
}

// Whether two interface methods have the same `self` mode and signature.
fn sameMethod(c: mut Checker, p: Program, a: int, b: int) bool {
    const x = methodAt(p, c.loc(a), c.def(a).member)
    const y = methodAt(p, c.loc(b), c.def(b).member)
    if x.hasSelf != y.hasSelf || x.selfMode != y.selfMode {
        return false
    }
    if x.typeParams.len() != y.typeParams.len() {
        return false
    }
    return fnSignature(c, p, a) == fnSignature(c, p, b)
}

/**
 * Whether an interface is `Any` (spec 9.8), whose `typeName` the compiler
 * provides for every type.
 *
 * @param c the checker
 * @param iface the interface's `DefId`
 * @returns true if it is
 */
pub fn isAny(c: Checker, iface: int) bool {
    const d = c.def(iface)
    return c.text(d.name) == "Any" && c.r.moduleNames[d.module] == "std.core.any"
}

/**
 * Whether a method is `typeName` of `Any`, which the compiler provides for
 * every type (spec 9.8).
 *
 * @param c the checker
 * @param id the method's `DefId`
 * @returns true if it is
 */
pub fn isAnyMethod(c: Checker, id: int) bool {
    const d = c.def(id)
    return d.member >= 0 && c.text(d.name) == "typeName" &&
           c.r.moduleNames[d.module] == "std.core.any"
}
