/**
 * @module
 * Key types (spec 16.1-16.3): `keyof T`, the key operators and indexed
 * access types `T[K]` (stage 1 only).
 */

import base.intern.Symbol
import base.span.Span
import sema.check.Checker
import sema.check.Generics
import sema.check_mapped.mappedIndexType
import sema.check_mapped.mappedKeys
import sema.check_methods.checkVisible
import sema.check_types.resolveType
import sema.check_union.unionType
import sema.program.Program
import sema.struct_exprs.fieldIsPub
import sema.struct_exprs.structDef
import sema.structs.fieldIndex
import sema.structs.fieldsOf
import sema.structs.structFieldType
import sema.structs.structFields
import sema.types.ERROR
import sema.types.TyKind
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.Op
import syntax.ast.TypeExpr

/**
 * `keyof T`: the names of the fields of a struct, or a tuple's indices.
 *
 * @param c the checker
 * @param p the program
 * @param inner `T`
 * @param span the whole type, for errors
 * @returns the key type
 */
pub fn keyofType(c: mut Checker, p: Program, inner: &TypeExpr, span: Span) int {
    const ty = resolveType(c, p, inner)
    const kind = c.types.kind(ty)
    if ty == ERROR {
        return ERROR
    }
    if kind == TyKind.Param || kind == TyKind.Mapped {
        useIndexNames(c)
        const keys = c.types.intern(TyKind.KeyOf, c.keyModule(), ty, [])
        return mappedKeys(c, keys)   // `keyof Partial<T>` is `keyof T`
    }
    if kind == TyKind.Tuple {
        return indexKeys(c, c.types.get(ty).args.len())
    }
    const id = if kind == TyKind.Adt { structDef(c, ty) } else { 0 }
    if id == 0 {
        c.error("E0340", span, "`keyof` needs a struct or tuple type, found `{c.typeName(ty)}`")
        return ERROR
    }
    if !structFields(c, p, id) {
        return c.unsupported(span, "`keyof` of a struct in its own fields is")
    }
    if fieldsOf(c, id).isTuple {
        return indexKeys(c, fieldsOf(c, id).types.len())
    }
    const owner = c.def(id).module
    const inside = owner == c.module() || owner == c.keyModule()
    let names: List<int> = []
    for i in 0..fieldsOf(c, id).names.len() {
        if inside || fieldIsPub(c, p, id, i) {
            names.push(fieldsOf(c, id).names[i].0)
        }
    }
    return c.types.keys(names)
}

/**
 * Records the symbols of the tuple keys, for `keyof T` and `T[K]` resolved
 * after substitution; only programs with key parameters intern them.
 *
 * @param c the checker
 */
pub fn useIndexNames(c: mut Checker) {
    if c.types.hasIndexNames() {
        return
    }
    let names: List<int> = []
    for i in 0..INDEX_KEYS {
        names.push(c.r.names.intern("{i}").0)
    }
    c.types.setIndexNames(names)
}

// The tuple keys a key parameter can name: those of a tuple of 32 elements.
const INDEX_KEYS: int = 32

/**
 * The key type bounding a type parameter in scope (spec 16.2), or 0 for
 * other types.
 *
 * @param c the checker
 * @param ty a type
 * @returns its key bound, or 0
 */
pub fn paramKey(c: Checker, ty: int) int {
    const t = c.types.get(ty)
    if t.kind != TyKind.Param || t.data >= c.generics.keys.len() {
        return 0
    }
    return c.generics.keys[t.data]
}

// The keys `.0` to `.(count - 1)`.
fn indexKeys(c: mut Checker, count: int) int {
    let names: List<int> = []
    for i in 0..count {
        names.push(c.r.names.intern("{i}").0)
    }
    return c.types.keys(names)
}

/**
 * `A | B`, `A & B` or `A - B`.
 *
 * @param c the checker
 * @param p the program
 * @param op the operator
 * @param left `A`
 * @param right `B`
 * @param span the whole type, for errors
 * @returns the key type
 */
pub fn keyOpType(c: mut Checker, p: Program, op: Op, left: &TypeExpr, right: &TypeExpr,
                 span: Span) int {
    const a = resolveType(c, p, left)
    const b = resolveType(c, p, right)
    if a == ERROR || b == ERROR {
        return ERROR
    }
    const keysA = c.types.kind(a) == TyKind.Key
    const keysB = c.types.kind(b) == TyKind.Key
    if op != Op.Or && (keyLike(c, a) && keyLike(c, b)) && !(keysA && keysB) {
        return c.types.intern(TyKind.KeyOp, if op == Op.And { 1 } else { 2 }, 0, [a, b])
    }
    if !keysA || !keysB {
        if op == Op.Or {
            return unionType(c, a, left.span, b, right.span, span)
        }
        const found = if keysA { b } else { a }
        const symbol = if op == Op.And { "&" } else { "-" }
        c.error("E0340", span, "`{symbol}` needs key types, found `{c.typeName(found)}`")
        return ERROR
    }
    if op != Op.Or {
        return c.types.keyOp(if op == Op.And { 1 } else { 2 }, a, b)
    }
    let names = c.types.keyNames(a)
    const namesB = c.types.keyNames(b)
    for i in 0..namesB.len() {
        names.push(namesB[i])
    }
    return c.types.keys(names)
}

// A key type, or one with a parameter that may be a key type once it is
// known: `keyof T`, a parameter, `A - B`.
fn keyLike(c: Checker, ty: int) bool {
    const kind = c.types.kind(ty)
    return kind == TyKind.Key || kind == TyKind.KeyOf || kind == TyKind.KeyOp ||
           kind == TyKind.Param
}

fn contains(names: &List<int>, name: int) bool {
    for i in 0..names.len() {
        if names[i] == name {
            return true
        }
    }
    return false
}

/**
 * `T[K]`: the type of the fields `K` of `T`, which must all be the same.
 *
 * @param c the checker
 * @param p the program
 * @param baseExpr `T`
 * @param keyExpr `K`
 * @param span the whole type, for errors
 * @returns the field type
 */
pub fn indexType(c: mut Checker, p: Program, baseExpr: &TypeExpr, keyExpr: &TypeExpr,
                 span: Span) int {
    const base = resolveType(c, p, baseExpr)
    const key = resolveType(c, p, keyExpr)
    if base == ERROR || key == ERROR {
        return ERROR
    }
    const bound = paramKey(c, key)
    if c.types.kind(key) != TyKind.Key && bound == 0 {
        c.error("E0340", keyExpr.span, "an indexed access type needs a key type, "
                + "found `{c.typeName(key)}`")
        return ERROR
    }
    if bound != 0 {
        return paramIndexType(c, p, base, key, bound, keyExpr.span)
    }
    if c.types.kind(base) == TyKind.Param {
        return c.unsupported(span, "indexing a type parameter with a key literal is")
    }
    return keysType(c, p, base, key, keyExpr.span, span)
}

// The type of the fields `key` of `base`, which must all be the same.
fn keysType(c: mut Checker, p: Program, base: int, key: int, keySpan: Span, span: Span) int {
    const names = c.types.keyNames(key)
    if names.len() == 0 {
        c.error("E0341", keySpan, "`{c.typeName(base)}` has no field for the empty key "
                + "type `keyof ()`")
        return ERROR
    }
    let result = ERROR
    for i in 0..names.len() {
        const field = fieldType(c, p, base, names[i], keySpan)
        if field == ERROR {
            return ERROR
        }
        if i > 0 && field != result {
            c.error("E0342", span, "the fields of these keys have different types: "
                    + "`{c.typeName(result)}` and `{c.typeName(field)}`")
            return ERROR
        }
        result = field
    }
    return result
}

/**
 * `T[K]` for a key parameter `K` bounded by `bound`: resolved for each
 * instantiation.
 *
 * @param c the checker
 * @param p the program
 * @param base `T`
 * @param key `K`
 * @param bound its bound
 * @param span `K`, for errors
 * @returns the type
 */
pub fn paramIndexType(c: mut Checker, p: Program, base: int, key: int, bound: int,
                      span: Span) int {
    const b = c.types.get(bound)
    if keysOf(c, bound, base) {
        return c.types.intern(TyKind.Index, 0, base, [key])
    }
    if b.kind == TyKind.Key && !c.types.get(base).hasParam {
        return keysType(c, p, base, bound, span, span)   // the same for every instance
    }
    if c.types.kind(base) == TyKind.Mapped {
        const field = mappedIndexType(c, base, key, bound)
        if field != 0 {
            return field
        }
    }
    c.error("E0341", span, "the keys of `{c.typeName(key)}` may not be keys of "
            + "`{c.typeName(base)}`: bound it by `keyof {c.typeName(base)}`")
    return ERROR
}

// Whether every key of `bound` is a key of `base`: `keyof base`, a key
// parameter bounded by it, or an `&` or `-` of them.
fn keysOf(c: Checker, bound: int, base: int) bool {
    const b = c.types.get(bound)
    if b.kind == TyKind.KeyOf {
        return b.inner == base
    }
    if b.kind == TyKind.Param {
        const outer = paramKey(c, bound)
        return outer != 0 && outer != bound && keysOf(c, outer, base)
    }
    if b.kind != TyKind.KeyOp {
        return false
    }
    if b.data == 1 && keysOf(c, b.args[1], base) {
        return true
    }
    return keysOf(c, b.args[0], base)
}

// The type of field `name` of `base`, or ERROR after an error.
fn fieldType(c: mut Checker, p: Program, base: int, name: int, span: Span) int {
    if c.types.kind(base) == TyKind.Tuple {
        const count = c.types.get(base).args.len()
        const index = tupleIndex(c, count, name)
        if index >= 0 {
            return c.types.get(base).args[index]
        }
        return noField(c, base, name, span)
    }
    const isAdt = c.types.kind(base) == TyKind.Adt
    const id = if isAdt { structDef(c, base) } else { 0 }
    if id == 0 {
        c.error("E0340", span, "an indexed access type needs a struct or tuple type, "
                + "found `{c.typeName(base)}`")
        return ERROR
    }
    if !structFields(c, p, id) {
        return c.unsupported(span, "indexing a struct in its own fields is")
    }
    const index = if fieldsOf(c, id).isTuple {
        tupleIndex(c, fieldsOf(c, id).types.len(), name)
    } else {
        fieldIndex(fieldsOf(c, id), Symbol(name))
    }
    if index < 0 {
        return noField(c, base, name, span)
    }
    checkVisible(c, c.def(id).module, fieldIsPub(c, p, id, index), Symbol(name), span)
    return structFieldType(c, p, base, index)
}

// The index of the key `name` among `.0` to `.(count - 1)`, or -1.
fn tupleIndex(c: mut Checker, count: int, name: int) int {
    for i in 0..count {
        if c.r.names.intern("{i}").0 == name {
            return i
        }
    }
    return -1
}

fn noField(c: mut Checker, base: int, name: int, span: Span) int {
    c.error("E0341", span, "`{c.typeName(base)}` has no field `.{c.text(Symbol(name))}`")
    return ERROR
}

/**
 * Whether an expression is a key literal, `.x`: a variant shorthand without
 * arguments.
 *
 * @param e the expression
 * @returns true for `.name`
 */
pub fn isKeyLiteral(e: &Expr) bool {
    return match e.kind {
        ExprKind.Variant(_, _, hasArgs) => !hasArgs
        _ => false
    }
}

/**
 * The single key of a key literal.
 *
 * @param c the checker
 * @param e a key literal
 * @returns its key type
 */
pub fn keyLiteralType(c: mut Checker, e: &Expr) int {
    return match e.kind {
        ExprKind.Variant(name, _, _) => c.types.keys([name.0])
        _ => ERROR
    }
}

/**
 * The key literal `.name` where the key type `expected` is wanted.
 *
 * @param c the checker
 * @param span the literal
 * @param name its name
 * @param expected the key type
 * @returns `expected`, or ERROR after an error
 */
pub fn checkKeyLiteral(c: mut Checker, span: Span, name: Symbol, expected: int) int {
    if contains(&c.types.keyNames(expected), name.0) {
        return expected
    }
    c.error("E0341", span, "the key type `{c.typeName(expected)}` has no key `.{c.text(name)}`")
    return ERROR
}

/**
 * Reports E0343 when the argument for a key parameter is neither a key
 * literal nor a key parameter of the caller.
 *
 * @param c the checker
 * @param arg the argument
 * @param found its type
 */
pub fn checkKeyArg(c: mut Checker, arg: &Expr, found: int) {
    if isKeyLiteral(arg) || found == ERROR || paramKey(c, found) != 0 {
        return
    }
    c.error("E0343", arg.span, "a key must be known at compile time: pass a key literal, "
            + "as `.x`, or a key parameter")
}

/**
 * Whether the parameter a pattern names is bounded by a key type.
 *
 * @param c the checker
 * @param params the callee's parameters
 * @param pattern a parameter type of the callee
 * @returns true for a key parameter
 */
pub fn isKeyParam(c: Checker, params: &Generics, pattern: int) bool {
    const t = c.types.get(pattern)
    return t.kind == TyKind.Param && t.data < params.keys.len() && params.keys[t.data] != 0
}

/**
 * Reports E0343 for a key argument of several keys and E0332 for one not in
 * the key bound of parameter `i`.
 *
 * @param c the checker
 * @param p the program
 * @param params the parameters
 * @param i the key parameter
 * @param args the arguments
 * @param span where
 */
pub fn checkKeyBound(c: mut Checker, p: Program, params: &Generics, i: int, args: &List<int>,
                     span: Span) {
    for j in 0..args.len() {
        ensureFields(c, p, args[j])
    }
    const arg = args[i]
    const isKey = c.types.kind(arg) == TyKind.Key
    if arg == ERROR || (!isKey && paramKey(c, arg) == 0) {
        return   // E0343 or E0330, reported with the argument
    }
    if isKey && c.types.get(arg).data < 0 {
        c.error("E0343", span, "a key parameter takes a single key, not "
                + "`{c.typeName(arg)}`")
        return
    }
    const bound = c.types.subst(params.keys[i], args.clone())
    if bound == ERROR || included(c, arg, bound) {
        return
    }
    const owner = params.owner.len()
    const name = if i < owner { params.owner[i] } else { params.fnParams[i - owner] }
    c.error("E0332", span, "the key `{c.typeName(arg)}` is not in the bound "
            + "`{c.typeName(bound)}` of `{c.paramText(name)}`")
}

// The fields of a struct type, computed for `keyof T` resolved after
// substitution.
fn ensureFields(c: mut Checker, p: Program, ty: int) {
    const id = if c.types.kind(ty) == TyKind.Adt { structDef(c, ty) } else { 0 }
    if id != 0 {
        structFields(c, p, id)
    }
}

// Whether the keys of `key` are keys of `bound`.
pub fn included(c: Checker, key: int, bound: int) bool {
    let keys = key
    if c.types.kind(key) == TyKind.Param {
        keys = paramKey(c, key)
        if keys == bound {
            return true
        }
    }
    if c.types.kind(keys) != TyKind.Key || c.types.kind(bound) != TyKind.Key {
        return false
    }
    const names = c.types.keyNames(keys)
    const wanted = c.types.keyNames(bound)
    for i in 0..names.len() {
        if !contains(&wanted, names[i]) {
            return false
        }
    }
    return true
}

/**
 * `value[key]` for a key parameter `key`: the field, or `None` when the
 * index has another type.
 *
 * @param c the checker
 * @param p the program
 * @param base the type of `value`, after its dereferences
 * @param index `key`, checked
 * @param found its type
 * @returns the field's type
 */
pub fn keyIndex(c: mut Checker, p: Program, base: int, index: &Expr, found: int) Option<int> {
    const bound = paramKey(c, found)
    if bound == 0 {
        return Option.None
    }
    return Option.Some(paramIndexType(c, p, base, found, bound, index.span))
}

/**
 * `ty` with its `T[K]` resolved where `T` is known and `K` is a parameter
 * bounded by keys whose fields have one type: an instantiated signature.
 *
 * @param c the checker
 * @param ty the type
 * @returns the type
 */
pub fn resolveKeyed(c: mut Checker, ty: int) int {
    const t = c.types.get(ty).clone()
    if !t.hasParam || t.kind == TyKind.Param {
        return ty
    }
    if t.kind == TyKind.Index && !c.types.get(t.inner).hasParam {
        const bound = paramKey(c, t.args[0])
        if bound != 0 && c.types.kind(bound) == TyKind.Key {
            const field = c.types.indexFields(t.inner, bound)
            return if field == ERROR { ty } else { field }
        }
        return ty
    }
    let args: List<int> = []
    for i in 0..t.args.len() {
        args.push(resolveKeyed(c, t.args[i]))
    }
    const inner = if t.inner > 0 { resolveKeyed(c, t.inner) } else { t.inner }
    return c.types.intern(t.kind, t.data, inner, args)
}
