/**
 * @module
 * Struct fields, literals, tuple struct constructors and field access
 * (spec 3.4; stage 0: bootstrap/src/sema/structs.c).
 */

import base.intern.Symbol
import base.span.Span
import sema.check.BOUND_COPY
import sema.check.Checker
import sema.check.Loc
import sema.check.itemOf
import sema.check.typeGenericsOf
import sema.check_generic.paramBounds
import sema.check_ref.checkStorable
import sema.check_types.ownerType
import sema.check_types.resolveType
import sema.def.DefKind
import sema.enums.enumVariants
import sema.expr_check.coerce
import sema.program.Program
import sema.types.ERROR
import sema.types.FN_OWNED
import sema.types.I64
import sema.types.KeyFields
import sema.types.STR
import sema.types.TyKind
import sema.types.U8
import syntax.ast.FieldDecl
import syntax.ast.ItemKind

/**
 * The fields of a struct.
 */
pub struct StructInfo {
    /** Their names; for a tuple struct, unused. */
    pub names: List<Symbol>
    /** Their types, with the struct's own type parameters. */
    pub types: List<int>
    /** Whether each has a default value. */
    pub defaults: List<bool>
    /** A tuple struct. */
    pub isTuple: bool
    /** A `copy struct`. */
    pub isCopy: bool
}

// The flags of a struct: (copy, ref, tuple), and its number of fields.
fn declaredFlags(p: Program, at: Loc) (bool, bool, bool, int) {
    return match itemOf(p, at).kind {
        ItemKind.Struct(isCopy, isRef, isTuple, _, fields, _) => (isCopy, isRef, isTuple,
                                                                  fields.len())
        _ => (false, false, false, 0)
    }
}

/**
 * The declaration of field `i` of a struct (or of a `@lang` declaration).
 *
 * @param p the program
 * @param at the struct
 * @param i the field
 * @returns its declaration
 */
pub fn fieldDeclAt(p: Program, at: Loc, i: int) &FieldDecl {
    return match itemOf(p, at).kind {
        ItemKind.Struct(_, _, _, _, fields, _) => &fields[i]
        _ => {
            panic("fieldDeclAt: not a struct")
        }
    }
}

/**
 * Whether a type is Copy (spec 2.9): Option and Result when their
 * arguments are, other structs and enums when declared `copy`. A type
 * parameter is Copy only when bound by `Copy`.
 *
 * @param c the checker
 * @param p the program
 * @param ty the type
 * @returns true for Copy types
 */
pub fn isCopy(c: Checker, p: Program, ty: int) bool {
    const t = c.types.get(ty)
    return match t.kind {
        TyKind.Adt => {
            if t.data == c.r.langItems[2] || t.data == c.r.langItems[3] {
                return argsAreCopy(c, p, &t.args)
            }
            if c.isUnion(t.data) {
                return argsAreCopy(c, p, &t.args)   // its members
            }
            match itemOf(p, c.loc(t.data)).kind {
                ItemKind.Struct(isCopyType, _, _, _, _, _) => isCopyType
                ItemKind.Enum(isCopyType, _, _, _) => isCopyType
                _ => false
            }
        }
        TyKind.Tuple => argsAreCopy(c, p, &t.args)
        TyKind.Array => isCopy(c, p, t.inner)
        TyKind.Param => paramBounds(c, ty) & BOUND_COPY != 0
        TyKind.Str | TyKind.Slice => false
        TyKind.Index | TyKind.Mapped | TyKind.Cond => false   // not known before the instance
        TyKind.Fn => t.data & FN_OWNED == 0   // a `move fn` owns its captured values
        _ => true
    }
}

fn argsAreCopy(c: Checker, p: Program, args: &List<int>) bool {
    for i in 0..args.len() {
        if !isCopy(c, p, args[i]) {
            return false
        }
    }
    return true
}

/**
 * The type of field `i` of a struct instance (or of a primitive's `@lang`
 * declaration), with its type arguments substituted.
 *
 * @param c the checker
 * @param p the program
 * @param ty the struct type
 * @param i the field
 * @returns its type
 */
pub fn structFieldType(c: mut Checker, p: Program, ty: int, i: int) int {
    if c.types.kind(ty) != TyKind.Adt {
        const lang = c.r.lang[ty]
        return fieldsOf(c, lang).types[i]
    }
    const def = c.types.get(ty).data
    const field = fieldsOf(c, def).types[i]
    const args = c.types.get(ty).args.clone()
    return c.types.subst(field, args)
}

/**
 * The fields of a struct, already computed.
 *
 * @param c the checker
 * @param id the struct's `DefId`
 * @returns its fields
 * @panics before `structFields`
 */
pub fn fieldsOf(c: Checker, id: int) &StructInfo {
    return match c.info[id].fields {
        Option.Some(info) => &*info
        Option.None => {
            panic("fieldsOf: not computed")
        }
    }
}

// The fields of an instance of a generic type hold its type arguments by
// value: `Wrap<Node>` inside `Node` contains `Node`.
fn checkInstanceFields(c: mut Checker, p: Program, ty: int, span: Span) {
    const def = c.types.get(ty).data
    if c.def(def).kind == DefKind.Struct && c.info[def].fields.isSome() {
        for i in 0..fieldsOf(c, def).types.len() {
            checkNotRecursive(c, p, structFieldType(c, p, ty, i), span)
        }
    }
    if c.def(def).kind == DefKind.Enum && c.info[def].variants.isSome() {
        const count = variantCount(c, def)
        for v in 0..count {
            for i in 0..variantFieldCount(c, def, v) {
                checkNotRecursive(c, p, variantFieldType(c, p, ty, v, i), span)
            }
        }
    }
}

fn variantCount(c: Checker, def: int) int {
    return match c.info[def].variants {
        Option.Some(info) => info.variants.len()
        Option.None => 0
    }
}

fn variantFieldCount(c: Checker, def: int, v: int) int {
    return match c.info[def].variants {
        Option.Some(info) => info.variants[v].types.len()
        Option.None => 0
    }
}

/**
 * The type of field `i` of variant `v` of an enum instance.
 *
 * @param c the checker
 * @param p the program
 * @param ty the enum type
 * @param v the variant
 * @param i the field
 * @returns its type
 */
pub fn variantFieldType(c: mut Checker, p: Program, ty: int, v: int, i: int) int {
    const def = c.types.get(ty).data
    const field = match c.info[def].variants {
        Option.Some(info) => info.variants[v].types[i]
        Option.None => ERROR
    }
    const args = c.types.get(ty).args.clone()
    return c.types.subst(field, args)
}

/**
 * Whether a type has interior mutability (spec 5.8): it holds an
 * `UnsafeCell` by value, directly or through its fields, variants, tuple
 * elements or array elements. What a pointer or a reference points to is
 * not looked into.
 *
 * @param c the checker
 * @param p the program
 * @param ty the type
 * @returns true if it does
 */
pub fn hasInteriorMutability(c: mut Checker, p: Program, ty: int) bool {
    const kind = c.types.kind(ty)
    if kind == TyKind.Tuple {
        const parts = c.types.get(ty).args.clone()
        for i in 0..parts.len() {
            if hasInteriorMutability(c, p, parts[i]) {
                return true
            }
        }
        return false
    }
    if kind == TyKind.Array {
        return hasInteriorMutability(c, p, c.types.get(ty).inner)
    }
    if kind != TyKind.Adt {
        return false
    }
    const def = c.types.get(ty).data
    if def == c.r.langItems[6] {
        return true
    }
    if c.def(def).kind == DefKind.Struct {
        if !structFields(c, p, def) {
            return false
        }
        for i in 0..fieldsOf(c, def).types.len() {
            if hasInteriorMutability(c, p, structFieldType(c, p, ty, i)) {
                return true
            }
        }
        return false
    }
    if c.def(def).kind != DefKind.Enum || !enumVariants(c, p, def) {
        return false
    }
    for v in 0..variantCount(c, def) {
        for i in 0..variantFieldCount(c, def, v) {
            if hasInteriorMutability(c, p, variantFieldType(c, p, ty, v, i)) {
                return true
            }
        }
    }
    return false
}

/**
 * Reports E0318 when a field's type contains a struct or enum that is
 * still being laid out; tuples and the type arguments of instances are
 * looked into.
 *
 * @param c the checker
 * @param p the program
 * @param ty the field's type
 * @param span the field
 */
pub fn checkNotRecursive(c: mut Checker, p: Program, ty: int, span: Span) {
    if c.types.kind(ty) == TyKind.Tuple {
        const items = c.types.get(ty).args.clone()
        for i in 0..items.len() {
            checkNotRecursive(c, p, items[i], span)
        }
    }
    if c.types.kind(ty) != TyKind.Adt {
        return
    }
    const id = c.types.get(ty).data
    if c.info[id].checking {
        c.error("E0318", span,
                "a type cannot contain itself by value; use Box<T> or a collection".toOwned())
        return
    }
    if c.def(id).kind == DefKind.Struct {
        structFields(c, p, id)
    } else if c.def(id).kind == DefKind.Enum {
        enumVariants(c, p, id)
    }
    if c.types.get(ty).args.len() > 0 {
        checkInstanceFields(c, p, ty, span)
    }
}

/**
 * Computes the fields of a struct (or of a `@lang` declaration), once.
 *
 * @param c the checker
 * @param p the program
 * @param id its `DefId`
 * @returns whether they are known (false while they are being computed)
 */
pub fn structFields(c: mut Checker, p: Program, id: int) bool {
    if c.info[id].fields.isSome() {
        return true
    }
    if c.info[id].checking {
        return false
    }
    const declared = declaredFlags(p, c.loc(id))
    const saved = c.enter(c.def(id).module)
    const savedSelf = c.selfType
    const outer = c.enterGenerics(typeGenericsOf(c, p, id))
    c.selfType = if c.def(id).lang { c.def(id).primitive } else { ownerType(c, p, id) }
    c.info[id].checking = true
    let info = StructInfo{names: [], types: [], defaults: [], isTuple: declared.2,
                          isCopy: declared.0}
    for i in 0..declared.3 {
        const field = fieldDeclAt(p, c.loc(id), i)
        const ty = resolveType(c, p, &field.ty)
        info.names.push(field.name ?? Symbol(-1))
        info.types.push(ty)
        info.defaults.push(field.defaultValue.isSome())
        if !declared.1 {
            checkStorable(c, p, ty, field.span, "a struct field")
        }
        checkNotRecursive(c, p, ty, field.span)
        if const Option.Some(value) = field.defaultValue {
            coerce(c, p, &value, ty)
        }
        if info.isCopy && !isCopy(c, p, ty) && ty != ERROR {
            c.error("E0317", field.span, "a `copy struct` can only have fields of Copy types, "
                    + "not `{c.typeName(ty)}`")
        }
    }
    c.info[id].checking = false
    c.enterGenerics(outer)
    c.selfType = savedSelf
    c.enter(saved)
    if !c.def(id).lang {
        let names: List<int> = []
        let pubs: List<bool> = []
        for i in 0..info.names.len() {
            names.push(info.names[i].0)
            pubs.push(fieldDeclAt(p, c.loc(id), i).isPub)
        }
        const module = c.def(id).module
        c.types.setFields(id, KeyFields{module, isTuple: info.isTuple, names, pubs,
                                        types: info.types.clone()})
    }
    c.info[id].fields = Option.Some(Box.new(info))
    return true
}

/**
 * The position of a named field.
 *
 * @param info the fields
 * @param name the name
 * @returns its index, or -1
 */
pub fn fieldIndex(info: &StructInfo, name: Symbol) int {
    if info.isTuple {
        return -1
    }
    for i in 0..info.names.len() {
        if info.names[i].0 == name.0 {
            return i
        }
    }
    return -1
}

/**
 * The checks of the layouts the compiler relies on: `@lang("str")` is
 * `{ptr: *u8, len: int, cap: int}`, a numeric `@lang` type declares no
 * fields, and `@lang("list")` starts with `ptr: *mut T, len: int`.
 *
 * @param c the checker
 * @param p the program
 * @param id a struct or `@lang` declaration whose fields are computed
 */
pub fn checkStructLayouts(c: mut Checker, p: Program, id: int) {
    if c.info[id].fields.isNone() {
        return
    }
    if c.def(id).lang {
        const ty = c.def(id).primitive
        const span = c.def(id).span
        const types = fieldsOf(c, id).types.clone()
        if ty == STR {
            const bytes = c.types.ptr(U8, false)
            const ok = types.len() == 3 && types[0] == bytes && types[1] == I64 && types[2] == I64
            if !ok {
                c.error("E0806", span, "`@lang(\"str\")` must declare `ptr: *u8`, `len: int`, "
                        + "`cap: int`")
            }
        } else if types.len() > 0 {
            c.error("E0806", span, "a `@lang` numeric type declares no fields".toOwned())
        }
    }
    if id == c.r.langItems[1] {
        const types = fieldsOf(c, id).types.clone()
        const ok = types.len() == 3 && c.types.kind(types[0]) == TyKind.Ptr && types[1] == I64
        if !ok {
            c.error("E0806", c.def(id).span, "`@lang(\"list\")` must declare `ptr: *mut T`, "
                    + "`len: int`, `cap: int`")
        }
    }
}
