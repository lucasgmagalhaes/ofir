/**
 * @module
 * `List<T>`, `Map<K, V>` and iterators in the checker (stage 0:
 * bootstrap/src/sema/check_list.c and check_iter.c): literals, indexing
 * with ranges, `for` loops over collections and iterators, and the
 * conversion of a list to a slice.
 */

import base.intern.Symbol
import base.span.Span
import sema.check.BOUND_EQ
import sema.check.BOUND_HASH
import sema.check.Checker
import sema.check.fnOf
import sema.check_box.autoDeref
import sema.check_box.methodReceiver
import sema.check_generic.paramBounds
import sema.check_methods.hasMethod
import sema.check_methods.methodAt
import sema.check_methods.methodCount
import sema.check_place.placeRoot
import sema.check_place.requireMutable
import sema.check_ref.checkInstanceStorable
import sema.check_types.fnSignature
import sema.check_types.lengthType
import sema.check_types.typeParameter
import sema.def.DefKind
import sema.derive.adtSatisfies
import sema.expr_check.checkExpr
import sema.expr_check.coerce
import sema.program.Program
import sema.structs.isCopy
import sema.types.ERROR
import sema.types.I64
import sema.types.TyKind
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.Mode
import syntax.ast.Op
import syntax.ast.Stmt
import syntax.ast.StmtKind

/**
 * The element type of a `List<T>`.
 *
 * @param c the checker
 * @param ty a type
 * @returns T, if `ty` is a list
 */
pub fn listElem(c: Checker, ty: int) Option<int> {
    const t = c.types.get(ty)
    const list = c.r.langItems[1]
    if list == 0 || t.kind != TyKind.Adt || t.data != list || t.args.len() != 1 {
        return Option.None
    }
    return Option.Some(t.args[0])
}

/**
 * The element type of a `List<T>` or a `&[T]`.
 *
 * @param c the checker
 * @param ty a type
 * @returns T, if `ty` is a list or a slice
 */
pub fn sequenceElem(c: Checker, ty: int) Option<int> {
    const t = c.types.get(ty)
    if t.kind == TyKind.Array {
        return Option.Some(t.inner)
    }
    const slice = c.r.langItems[4]
    const sliceMut = c.r.langItems[7]
    if t.kind == TyKind.Adt && t.data != 0 && (t.data == slice || t.data == sliceMut) {
        return Option.Some(t.args[0])
    }
    return listElem(c, ty)
}

fn listOf(c: mut Checker, elem: int) int {
    return c.types.adt(c.r.langItems[1], [elem])
}

/**
 * Reports E0321 unless a type is Copy.
 *
 * @param c the checker
 * @param p the program
 * @param span where
 * @param ty the type
 * @param what what needs it, for the message
 */
pub fn requireCopy(c: mut Checker, p: Program, span: Span, ty: int, what: str) {
    if !isCopy(c, p, ty) && ty != ERROR {
        c.error("E0321", span, "{what} needs a value of a Copy type, not `{c.typeName(ty)}`")
    }
}

/**
 * `[a, b, c]` and `[]`: the elements have one type, from the expected
 * `List<T>` or the first element.
 *
 * @param c the checker
 * @param p the program
 * @param e the literal
 * @param items its elements
 * @param expected the type the context expects
 * @returns its type
 */
pub fn checkListLiteral(c: mut Checker, p: Program, e: &Expr, items: &List<Expr>,
                        expected: int) int {
    if c.types.kind(expected) == TyKind.Array {   // `[a, b]` as a `[T; N]` (spec 2.7)
        let elem = c.types.get(expected).inner
        let ty = expected
        for i in 0..items.len() {
            if elem == ERROR {   // a generic `[T; N]` (spec 8.7): `T` from the first element
                elem = checkExpr(c, p, &items[i], ERROR)
                const len = c.types.get(expected).data
                ty = c.types.intern(TyKind.Array, len, elem, [])
            } else {
                coerce(c, p, &items[i], elem)
            }
        }
        arrayElements(c, p, e.span, ty, items.len())
        return ty
    }
    if c.r.langItems[1] == 0 {
        return c.unsupported(e.span, "list literals without the standard library are")
    }
    let elem = ERROR
    let known = false
    let given = false   // the expected type gives the element type, already checked
    if const Option.Some(t) = sequenceElem(c, expected) {   // a List or a `[T]` parameter
        elem = t
        known = true
        given = true
    }
    for i in 0..items.len() {
        if known {
            coerce(c, p, &items[i], elem)
        } else {
            elem = checkExpr(c, p, &items[i], ERROR)
            known = true
        }
    }
    if !known {
        c.error("E0330", e.span, "cannot infer the element type of `[]`: write the type, as "
                + "in `const names: List<str> = []`")
        return ERROR
    }
    const ty = listOf(c, elem)
    if !given {
        checkInstanceStorable(c, p, ty, e.span)
    }
    return ty
}

// An array literal of `count` elements for the array type `ty`: the count
// must be its length, and its elements Copy.
fn arrayElements(c: mut Checker, p: Program, span: Span, ty: int, count: int) {
    const t = c.types.get(ty).clone()
    if count != t.data {
        c.error("E0300", span, "mismatched types: expected `{c.typeName(ty)}`, found an array "
                + "of {count} elements")
    }
    if !isCopy(c, p, t.inner) && t.inner != ERROR {
        c.unsupported(span, "arrays of a type that is not Copy are")
    }
}

// `[v; len]` as a `[T; N]`, `len` a length expression (spec 8.7).
fn arrayLength(c: mut Checker, p: Program, span: Span, ty: int, len: int) {
    if len == ERROR {
        return
    }
    const t = c.types.get(ty).clone()
    const want = if t.args.len() == 1 { t.args[0] } else { c.types.value(t.data) }
    if len != want {
        c.error("E0300", span, "mismatched types: expected `{c.typeName(ty)}`, found an array "
                + "of `{c.typeName(len)}` elements")
    }
    if !isCopy(c, p, t.inner) && t.inner != ERROR {
        c.unsupported(span, "arrays of a type that is not Copy are")
    }
}

// Whether `e` is written as an array length: integers, const parameters,
// `const` items and an arithmetic of them (spec 8.7).
fn isLengthExpr(c: mut Checker, e: &Expr) bool {
    return match e.kind {
        ExprKind.Int(_) => true
        ExprKind.Ident(name) => {
            if typeParameter(c, name).isSome() {
                return true
            }
            const id = c.r.scope.module(name)
            id != 0 && c.def(id).kind == DefKind.Const
        }
        ExprKind.Binary(op, lhs, rhs) => {
            const arith = op == Op.Add || op == Op.Sub || op == Op.Mul || op == Op.Div ||
                          op == Op.Rem
            arith && isLengthExpr(c, &*lhs) && isLengthExpr(c, &*rhs)
        }
        _ => false
    }
}

/**
 * `[value; count]`: `count` copies of a Copy value.
 *
 * @param c the checker
 * @param p the program
 * @param e the literal
 * @param value the value
 * @param count the count
 * @param expected the type the context expects
 * @returns its type
 */
pub fn checkListRepeat(c: mut Checker, p: Program, e: &Expr, value: &Expr, count: &Expr,
                       expected: int) int {
    if c.r.langItems[1] == 0 {
        return c.unsupported(e.span, "list literals without the standard library are")
    }
    if c.types.kind(expected) == TyKind.Array {   // `[v; N]` as a `[T; N]`
        const elem = c.types.get(expected).inner
        coerce(c, p, value, elem)
        coerce(c, p, count, I64)
        match count.kind {
            ExprKind.Int(n) => arrayElements(c, p, e.span, expected, n as int)
            _ => {
                if isLengthExpr(c, count) {
                    arrayLength(c, p, e.span, expected, lengthType(c, p, count))
                } else {
                    c.error("E0300", count.span, "the count of `[value; count]` as an array "
                            + "must be an integer literal or a length (spec 8.7)")
                }
            }
        }
        return expected
    }
    const hint = listElem(c, expected) ?? ERROR
    const elem = checkExpr(c, p, value, hint)
    requireCopy(c, p, value.span, elem, "`[value; count]`")
    coerce(c, p, count, I64)
    return listOf(c, elem)
}

/**
 * The key and value types of a `Map<K, V>`.
 *
 * @param c the checker
 * @param ty a type
 * @returns (K, V), if `ty` is a map
 */
pub fn mapParts(c: Checker, ty: int) Option<(int, int)> {
    const t = c.types.get(ty)
    const map = c.r.langItems[5]
    if map == 0 || t.kind != TyKind.Adt || t.data != map || t.args.len() != 2 {
        return Option.None
    }
    return Option.Some((t.args[0], t.args[1]))
}

/**
 * Whether `Map` can hash and compare keys of a type: integers, bool,
 * `str`, parameters bound by `Hash + Eq` (in std, any parameter), and
 * tuples, structs and enums that satisfy `Hash` (spec 9.9).
 *
 * @param c the checker
 * @param p the program
 * @param ty the type
 * @returns true if it can
 */
pub fn hashable(c: mut Checker, p: Program, ty: int) bool {
    const t = c.types.get(ty).clone()
    if t.kind == TyKind.Tuple {
        for i in 0..t.args.len() {
            if !hashable(c, p, t.args[i]) {
                return false
            }
        }
        return true
    }
    if t.kind == TyKind.Adt {
        return adtSatisfies(c, p, ty, BOUND_HASH)
    }
    const both = BOUND_HASH | BOUND_EQ
    return t.kind == TyKind.Int || t.kind == TyKind.Bool || t.kind == TyKind.Str ||
           t.kind == TyKind.Error ||
           (t.kind == TyKind.Param && paramBounds(c, ty) & both == both)
}

// ---------------------------------------------------------------------------
// Iterators: a type with `fn next(mut self) Option<T>` (roadmap 3.7)

fn nextMethod(c: Checker, p: Program, id: int) int {
    const kind = c.def(id).kind
    const typed = kind == DefKind.Struct || kind == DefKind.Enum || kind == DefKind.Interface
    if !typed || c.def(id).item < 0 {
        return 0
    }
    for i in 0..methodCount(p, c.loc(id)) {
        const m = methodAt(p, c.loc(id), i)
        if m.hasSelf && m.selfMode == Mode.Mut && m.params.len() == 0 && c.text(m.name) == "next" {
            return c.r.tables[c.def(id).module].fnDefs[m.id.0]
        }
    }
    return 0
}

/**
 * The item type of an iterator.
 *
 * @param c the checker
 * @param p the program
 * @param ty a type
 * @returns T, if `ty` has `fn next(mut self) Option<T>`
 */
pub fn iteratorItem(c: mut Checker, p: Program, ty: int) Option<int> {
    if c.r.langItems[2] == 0 {
        return Option.None
    }
    if c.types.kind(ty) == TyKind.Param {
        return boundIteratorItem(c, p, ty)
    }
    if c.types.kind(ty) != TyKind.Adt {
        return Option.None
    }
    const args = c.types.get(ty).args.clone()
    return nextItem(c, p, nextMethod(c, p, c.types.get(ty).data), args)
}

// The item type of a type parameter bounded by an interface with `next`:
// `T` of `I: Iterator<T>`.
fn boundIteratorItem(c: mut Checker, p: Program, ty: int) Option<int> {
    const param = c.types.get(ty).data
    if param >= c.generics.ifaces.len() {
        return Option.None
    }
    const bounds = c.generics.ifaces[param].clone()
    for i in 0..bounds.len() {
        const next = nextMethod(c, p, bounds[i])
        if next != 0 {
            let args = [ty]   // `Self`, then the interface's own parameters
            const given = c.types.get(c.generics.ifaceArgs[param][i]).args.clone()
            for j in 0..given.len() {
                args.push(given[j])
            }
            return nextItem(c, p, next, args)
        }
    }
    return Option.None
}

// `T` of the `Option<T>` that method `next` returns, with its owner's
// parameters replaced by `args`.
fn nextItem(c: mut Checker, p: Program, next: int, args: List<int>) Option<int> {
    if next == 0 {
        return Option.None
    }
    const decl = fnOf(p, c.loc(next))
    if decl.typeParams.len() > 0 {   // the owner's are the type's arguments
        return Option.None
    }
    const ret = c.types.get(fnSignature(c, p, next)).inner
    const option = c.types.subst(ret, args)
    const t = c.types.get(option)
    if t.kind != TyKind.Adt || t.data != c.r.langItems[2] {
        return Option.None
    }
    return Option.Some(t.args[0])
}

/**
 * `for x in list`, `for i, x in list` (with the index), `for key, value in
 * map`, `for x in iterator`.
 *
 * @param c the checker
 * @param p the program
 * @param s the `for` statement
 * @param expr the iterated value
 * @param two whether there are two variables
 */
pub fn checkForCollection(c: mut Checker, p: Program, s: &Stmt, expr: &Expr, two: bool) {
    const found = checkExpr(c, p, expr, ERROR)
    const ty = autoDeref(c, p, expr, found)
    let first = ERROR
    let second = ERROR
    if const Option.Some(elem) = sequenceElem(c, ty) {
        first = if two { I64 } else { elem }
        second = elem
    } else if const Option.Some(parts) = mapParts(c, ty) {
        if !two {
            c.error("E0300", expr.span, "iterate a map with two variables: "
                    + "`for key, value in map`")
        }
        first = parts.0
        second = parts.1
    } else if const Option.Some(item) = iteratorItem(c, p, ty) {
        if two {
            c.error("E0300", expr.span, "an iterator gives one value at a time: "
                    + "`for item in iterator`")
        }
        if placeRoot(c, expr).isSome() {
            requireMutable(c, p, expr)
        }
        first = item
    } else if ty != ERROR {
        c.error("E0300", expr.span, "mismatched types: `for` needs a range, a list, a slice, "
                + "a map or an iterator, found {c.typeName(ty)}")
    }
    if const StmtKind.For(_, true, _, _, _, _) = s.kind {   // `for mut`: the elements change
        if first != ERROR && iteratorItem(c, p, ty).isNone() && placeRoot(c, expr).isSome() {
            requireMutable(c, p, expr)
        }
    }
    const local = c.localAt(s.id.0)
    if local >= 0 {
        c.localTypes[local] = first
        if two && local + 1 < c.localTypes.len() {
            c.localTypes[local + 1] = second
        }
    }
}

/**
 * `xs[a..b]`, `xs[a..]`, `xs[..b]`: the methods `xs.slice(a, b)` and
 * `xs.sliceFrom(a)` of List, Slice and str (stage 0 rewrites the index
 * into the call).
 *
 * @param c the checker
 * @param p the program
 * @param e the index expression
 * @param base the indexed value
 * @param range the range
 * @param mutable whether it is `&mut xs[a..b]`, the methods `sliceMut` and
 * `sliceFromMut`
 * @returns the type of the slice
 */
pub fn checkRangeIndex(c: mut Checker, p: Program, e: &Expr, base: &Expr, range: &Expr,
                       mutable: bool) int {
    match range.kind {
        ExprKind.Range(lo, hi, _) => {
            let text = if hi.isSome() { "slice" } else { "sliceFrom" }
            if mutable {   // `&mut xs[a..b]` is `xs.sliceMut(a, b)`
                text = if hi.isSome() { "sliceMut" } else { "sliceFromMut" }
            }
            const name = c.r.names.intern(text)
            const found = checkExpr(c, p, base, ERROR)
            let recvType = arraySliceReceiver(c, p, base, found, name)   // `a[1..3]` on an array
            if recvType < 0 {
                recvType = methodReceiver(c, p, base, found, name)
            }
            let owner = 0
            if c.types.kind(recvType) == TyKind.Adt {
                owner = c.types.get(recvType).data
            } else if recvType < c.r.lang.len() {
                owner = c.r.lang[recvType]
            }
            if owner == 0 || !hasMethod(c, p, owner, name) {
                if recvType != ERROR {
                    c.error("E0301", e.span, "no method `{text}` on type `{c.typeName(recvType)}`")
                }
                if const Option.Some(l) = lo {
                    checkExpr(c, p, &*l, ERROR)
                }
                if const Option.Some(h) = hi {
                    checkExpr(c, p, &*h, ERROR)
                }
                return ERROR
            }
            let id = 0
            for i in 0..methodCount(p, c.loc(owner)) {
                const m = methodAt(p, c.loc(owner), i)
                if m.name.0 == name.0 {
                    id = c.r.tables[c.def(owner).module].fnDefs[m.id.0]
                }
            }
            const sig = fnSignature(c, p, id)
            let selfArgs: List<int> = []
            if c.types.kind(recvType) == TyKind.Adt {
                selfArgs = c.types.get(recvType).args.clone()
            }
            const params = c.types.get(sig).args.clone()
            if const Option.Some(l) = lo {
                coerce(c, p, &*l, c.types.subst(params[0], selfArgs))
            }
            if const Option.Some(h) = hi {
                coerce(c, p, &*h, c.types.subst(params[1], selfArgs))
            }
            c.setMember(e.id.0, id)
            const ret = c.types.get(sig).inner
            return c.types.subst(ret, selfArgs)
        }
        _ => {
            return ERROR
        }
    }
}

// `[T; N]`, for an array or a reference to one, or -1.
fn arrayBehind(c: Checker, ty: int) int {
    const t = c.types.get(ty)
    if t.kind == TyKind.Array {
        return ty
    }
    if t.kind == TyKind.Ref && c.types.kind(t.inner) == TyKind.Array {
        return t.inner
    }
    return -1
}

/**
 * A method of `&[T]` called on an array `[T; N]`, or a reference to one
 * (spec 2.7): the receiver becomes a slice of its N elements.
 *
 * @param c the checker
 * @param p the program
 * @param base the receiver
 * @param found its type
 * @param name the method
 * @returns the slice type, or -1 when it does not apply
 */
pub fn arraySliceReceiver(c: mut Checker, p: Program, base: &Expr, found: int,
                          name: Symbol) int {
    const array = arrayBehind(c, found)
    const slice = c.r.langItems[4]
    if array < 0 || slice == 0 || !hasMethod(c, p, slice, name) {
        return -1
    }
    const ty = c.types.adt(slice, [c.types.get(array).inner])
    const _ = c.derefs[c.module()].remove(base.id.0)
    const _ = c.adjusted[c.module()].remove(base.id.0)
    c.arrayCoercions[c.module()].insert(base.id.0, found)
    c.setType(base.id.0, ty)
    return ty
}

/**
 * A `List<T>` or a `&List<T>` where a `&[T]` is expected (spec 2.12)
 * becomes `list.asSlice()`; an array `[T; N]`, or a reference to one, becomes a
 * slice of its N elements.
 *
 * @param c the checker
 * @param p the program
 * @param e the value
 * @param found its type
 * @param expected the type expected
 * @returns whether it was converted
 */
pub fn coerceToSlice(c: mut Checker, p: Program, e: &Expr, found: int, expected: int) bool {
    const slice = c.r.langItems[4]
    const t = c.types.get(expected)
    if t.kind == TyKind.Adt && t.data != 0 && t.data == c.r.langItems[7] {
        return coerceToMutSlice(c, p, e, found, expected)
    }
    if t.kind != TyKind.Adt || slice == 0 || t.data != slice {
        return false
    }
    const array = arrayBehind(c, found)
    if array >= 0 && c.types.get(array).inner == t.args[0] {   // `&[T; N]` or `[T; N]`
        c.arrayCoercions[c.module()].insert(e.id.0, found)
        c.setType(e.id.0, expected)
        return true
    }
    const ft = c.types.get(found)
    const borrowed = ft.kind == TyKind.Ref   // `&List<T>` or `&mut List<T>`
    const Option.Some(elem) = listElem(c, if borrowed { ft.inner } else { found }) else {
        return false
    }
    if elem != t.args[0] {
        return false
    }
    const Option.Some(asSlice) = c.r.names.find("asSlice") else {
        return false
    }
    const list = c.r.langItems[1]
    if !hasMethod(c, p, list, asSlice) {
        return false
    }
    c.sliceCoercions[c.module()].insert(e.id.0, if borrowed { -1 - elem } else { elem })
    c.setType(e.id.0, expected)
    return true
}

/**
 * `&mut list` or `&mut array` where a `&mut [T]` is expected (spec 2.12):
 * `list.asMutSlice()`, or a mutable slice of the N elements.
 *
 * @param c the checker
 * @param p the program
 * @param e the value
 * @param found its type
 * @param expected the `SliceMut<T>` expected
 * @returns whether it was converted
 */
fn coerceToMutSlice(c: mut Checker, p: Program, e: &Expr, found: int, expected: int) bool {
    const t = c.types.get(found)
    if t.kind != TyKind.Ref || t.data == 0 {   // only a `&mut` converts
        return false
    }
    const elem = c.types.get(expected).args[0]
    const target = c.types.get(t.inner)
    if target.kind == TyKind.Array {
        if target.inner != elem {
            return false
        }
        c.arrayCoercions[c.module()].insert(e.id.0, found)
        c.setType(e.id.0, expected)
        return true
    }
    const Option.Some(inner) = listElem(c, t.inner) else {
        return false
    }
    const Option.Some(asMutSlice) = c.r.names.find("asMutSlice") else {
        return false
    }
    if inner != elem || !hasMethod(c, p, c.r.langItems[1], asMutSlice) {
        return false
    }
    c.sliceCoercions[c.module()].insert(e.id.0, elem)
    c.setType(e.id.0, expected)
    return true
}
