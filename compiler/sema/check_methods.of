import sema.resolve_attributes.warnDeprecated
import sema.struct_exprs.checkStructField
import sema.structs.fieldIndex
import sema.structs.fieldsOf
import sema.structs.isCopy
import sema.structs.structFields
import sema.structs.structFieldType
import sema.structs.variantFieldType
