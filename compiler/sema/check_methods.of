import syntax.ast.Mode
import syntax.ast.TypeExpr

/** The `members` entry of a `.clone()` derived by the compiler. */
pub const DERIVED_CLONE: int = -2
/** The `members` entry of a built-in method: -10 minus its number. */
pub const BUILTIN_BASE: int = -10

// ---------------------------------------------------------------------------
// User methods

/**
 * The number of methods of a struct, enum or `@lang` declaration.
 *
 * @param p the program
 * @param owner where the type is
 * @returns the count
 */
pub fn methodCount(p: Program, owner: Loc) int {
    return match itemOf(p, owner).kind {
        ItemKind.Struct(_, _, _, _, _, methods) => methods.len()
        ItemKind.Enum(_, _, _, methods) => methods.len()
        ItemKind.Interface(_, _, methods) => methods.len()
        _ => 0
    }
}

/**
 * A method of a struct, enum or `@lang` declaration.
 *
 * @param p the program
 * @param owner where the type is
 * @param i the method's position
 * @returns the method
 */
pub fn methodAt(p: Program, owner: Loc, i: int) &FnDecl {
    return match itemOf(p, owner).kind {
        ItemKind.Struct(_, _, _, _, _, methods) => &methods[i]
        ItemKind.Enum(_, _, _, methods) => &methods[i]
        ItemKind.Interface(_, _, methods) => &methods[i]
        _ => {
            panic("methodAt: not a type")
        }
    }
}

// The help line for an unknown method of `owner`: the methods it declares.
fn suggestMethod(c: mut Checker, p: Program, owner: int, name: Symbol) {
    if owner == 0 || c.def(owner).item < 0 {
        return
    }
    let s = Suggestion.new(c.text(name))
    for i in 0..methodCount(p, c.loc(owner)) {
        const method = methodAt(p, c.loc(owner), i).name
        s.offer(method, c.text(method))
    }
    s.report(c.r)
    if probing(c.r, name) {
        completeMethods(c, p, owner)
    }
}

/**
 * Keeps the methods of `owner` that take `self`, for a completion after
 * `value.` (sema/complete.of).
 *
 * @param c the checker
 * @param p the program
 * @param owner the declaration of the value's type, or 0
 */
pub fn completeMethods(c: mut Checker, p: Program, owner: int) {
    if owner == 0 || c.def(owner).item < 0 {
        return
    }
    for i in 0..methodCount(p, c.loc(owner)) {
        const method = methodAt(p, c.loc(owner), i)
        if method.hasSelf {
            offer(c.r, c.text(method.name), CompletionKind.Method)
        }
    }
}

// The position of method `name` of `owner`, or -1.
fn findMethod(c: Checker, p: Program, owner: int, name: Symbol) int {
    if owner == 0 || c.def(owner).item < 0 {
        return -1
    }
    const isType = match itemOf(p, c.loc(owner)).kind {
        ItemKind.Struct(_, _, _, _, _, _) | ItemKind.Enum(_, _, _, _) |
        ItemKind.Interface(_, _, _) => true
        _ => false
    }
    if !isType {
        return -1
    }
    for i in 0..methodCount(p, c.loc(owner)) {
        if methodAt(p, c.loc(owner), i).name.0 == name.0 {
            return i
        }
    }
    return -1
}

/**
 * Whether a type declares a method.
 *
 * @param c the checker
 * @param p the program
 * @param owner the type's `DefId`
 * @param name the method
 * @returns true if it does
 */
pub fn hasMethod(c: Checker, p: Program, owner: int, name: Symbol) bool {
    return findMethod(c, p, owner, name) >= 0
}

// The `DefId` of method `index` of `owner`.
fn methodDef(c: Checker, p: Program, owner: int, index: int) int {
    const decl = methodAt(p, c.loc(owner), index)
    return c.r.tables[c.def(owner).module].fnDefs[decl.id.0]
}

/**
 * Reports E0202 when a field or method of another module is not `pub`.
 *
 * @param c the checker
 * @param module the module declaring it
 * @param isPub whether it is `pub`
 * @param name its name
 * @param span where it is used
 */
pub fn checkVisible(c: mut Checker, module: int, isPub: bool, name: Symbol, span: Span) {
    if module != c.module() && module != c.keyModule() && !isPub {
        c.error("E0202", span, "`{c.text(name)}` is private to module "
                + "`{c.r.moduleNames[module]}`")
    }
}

/**
 * The struct or enum named by `e`, as in `Point.new()` or `Stack<int>.new()`.
 *
 * @param c the checker
 * @param e an expression
 * @returns its `DefId`, or 0
 */
pub fn typeNameOf(c: Checker, e: &Expr) int {
    const Res.Def(id) = nameRes(c, e) else {
        return 0
    }
    const kind = c.def(id).kind
    return if kind == DefKind.Struct || kind == DefKind.Enum { id } else { 0 }
}

fn typeArgsOf(e: &Expr) List<TypeExpr> {
    return match e.kind {
        ExprKind.Generic(_, args) => args.clone()
        _ => []
    }
}

fn namedInstance(c: mut Checker, p: Program, id: int, list: &List<TypeExpr>, span: Span) int {
    if list.len() == 0 && itemTypeParams(itemOf(p, c.loc(id))).len() > 0 {
        return ERROR
    }
    let args: List<int> = []
    for i in 0..list.len() {
        args.push(resolveType(c, p, &list[i]))
    }
    return adtInstance(c, p, id, args, span)
}

/**
 * An argument for a `mut` parameter must be a place that may be modified;
 * the caller passes it by reference (spec 5.3).
 *
 * @param c the checker
 * @param p the program
 * @param id the callee's `DefId`
 * @param callee the callee expression
 * @param args the arguments
 */
pub fn checkMutArgs(c: mut Checker, p: Program, id: int, callId: int, args: &List<Arg>) {
    const decl = fnOf(p, c.loc(id))
    for i in 0..args.len() {
        const slot = argParam(c, callId, i)
        if slot >= 0 && slot < decl.params.len() && decl.params[slot].mode == Mode.Mut {
            requireMutable(c, p, &args[i].value)
            checkPackedBorrow(c, p, &args[i].value)
        }
    }
}

fn skipArgs(c: mut Checker, p: Program, args: &List<Arg>) int {
    for i in 0..args.len() {
        checkExpr(c, p, &args[i].value, ERROR)
    }
    return ERROR
}

fn methodArgs(c: mut Checker, p: Program, call: &Expr, field: &Expr, explicit: &List<TypeExpr>,
              args: &List<Arg>, id: int, selfType: int, expected: int) int {
    const sig = fnSignature(c, p, id)
    const generics = fnGenerics(c, p, id)
    if generics.owner.len() + generics.fnParams.len() == 0 {
        if explicit.len() > 0 {
            c.error("E0302", field.span, "`{c.text(c.def(id).name)}` takes no type arguments")
        }
        return checkCallArgs(c, p, call, args, id)
    }
    const ownerCount = generics.owner.len()
    let inf = inferNew(generics)
    if isInterfaceMethod(c, p, id) {   // `Self` is the receiver's type
        inf.args[0] = selfType
        inf.known[0] = true
        if c.types.kind(selfType) == TyKind.Param {   // and the bound gives the others
            const iface = c.itemDefs[c.def(id).module][c.def(id).item]
            const bound = paramBoundArgs(c, c.types.get(selfType).data, iface)
            const given = c.types.get(bound).args.clone()
            for i in 0..given.len() {
                if 1 + i < ownerCount {
                    inf.args[1 + i] = given[i]
                    inf.known[1 + i] = true
                }
            }
        }
    } else {
        inferFromSelf(c, inf, selfType, ownerCount)
    }
    if explicit.len() > 0 {
        inferExplicit(c, p, inf, false, explicit, field.span)
    }
    const params = c.types.get(sig).args.clone()
    const ret = c.types.get(sig).inner
    return checkGenericArgs(c, p, call.id.0, call.span, args, &params, ret, inf, expected,
                            id)
}

// The index of field `name` of struct `owner` when its type is a `fn`, or -1.
fn fnFieldOf(c: mut Checker, p: Program, owner: int, name: Symbol) int {
    if c.def(owner).kind != DefKind.Struct || !structFields(c, p, owner) {
        return -1
    }
    const index = fieldIndex(fieldsOf(c, owner), name)
    if index < 0 || c.types.kind(fieldsOf(c, owner).types[index]) != TyKind.Fn {
        return -1
    }
    return index
}

// `x.f(...)` that calls the fn value in field `f` of `x` (spec 10.2).
fn checkFieldCall(c: mut Checker, p: Program, call: &Expr, field: &Expr, name: Symbol,
                  args: &List<Arg>, selfType: int) int {
    const ty = checkStructField(c, p, field, name, selfType)
    c.setType(field.id.0, ty)
    c.fieldCalls[c.module()].insert(field.id.0, 1)
    if c.types.kind(ty) != TyKind.Fn {
        return skipArgs(c, p, args)
    }
    return checkArgsOf(c, p, call.span, args, ty)
}

/**
 * `value.m(args)` (`viaType` false) or `Type.f(args)` (`viaType` true).
 *
 * @param c the checker
 * @param p the program
 * @param call the call
 * @param field its callee, `base.name`
 * @param base the receiver or the type name
 * @param name the method
 * @param explicit the written type arguments
 * @param args the arguments
 * @param owner the type's `DefId`
 * @param viaType whether it is called on the type
 * @param selfType the receiver's type, or the type named
 * @param expected the type the context expects
 * @returns the result type
 */
pub fn checkUserMethod(c: mut Checker, p: Program, call: &Expr, field: &Expr, base: &Expr,
                       name: Symbol, explicit: &List<TypeExpr>, args: &List<Arg>, owner: int,
                       viaType: bool, selfType: int, expected: int) int {
    const index = findMethod(c, p, owner, name)
    if index < 0 && !viaType && c.def(owner).kind != DefKind.Interface {
        const iface = assertedDefault(c, p, owner, name)
        if iface != 0 {   // a default method of an asserted interface
            return checkUserMethod(c, p, call, field, base, name, explicit, args, iface, false,
                                   selfType, expected)
        }
    }
    const isClone = c.text(name) == "clone"
    if index < 0 && !viaType && isClone {
        return checkDerivedClone(c, p, call, field, explicit, args, selfType)
    }
    if index < 0 && !viaType && explicit.len() == 0 && fnFieldOf(c, p, owner, name) >= 0 {
        return checkFieldCall(c, p, call, field, name, args, selfType)
    }
    if index < 0 {
        const ty = c.types.adt(owner, [])
        c.error("E0301", field.span, "no method `{c.text(name)}` on type `{c.typeName(ty)}`")
        suggestMethod(c, p, owner, name)
        return skipArgs(c, p, args)
    }
    const decl = methodAt(p, c.loc(owner), index)
    warnDeprecated(c.r, c.r.tables[c.def(owner).module].fnDefs[decl.id.0], field.span)
    if viaType && decl.hasSelf {
        c.error("E0301", field.span, "`{c.text(name)}` is a method: call it on a value, "
                + "`value.m()`")
        return skipArgs(c, p, args)
    }
    if !viaType && !decl.hasSelf {
        c.error("E0301", field.span, "`{c.text(name)}` is an associated function: call it on "
                + "the type, `Type.f()`")
        return skipArgs(c, p, args)
    }
    if decl.hasSelf && decl.selfMode == Mode.Mut {
        requireMutable(c, p, base)
    }
    const isPub = decl.isPub || c.def(owner).kind == DefKind.Interface && c.def(owner).isPub
    checkVisible(c, c.def(owner).module, isPub, name, field.span)
    const id = methodDef(c, p, owner, index)
    c.setMember(field.id.0, id)
    const ret = methodArgs(c, p, call, field, explicit, args, id, selfType, expected)
    checkMutArgs(c, p, id, call.id.0, args)
    if !viaType && isClone {
        checkStdClone(c, p, field, owner, decl.hasSelf, selfType)
    }
    return ret
}

// ---------------------------------------------------------------------------
// Built-in methods of the primitive types

// (name, receiver: 0 int / 1 pointer, number, takes an integer type argument)
fn builtinIndex(c: Checker, ty: int, name: Symbol) int {
    const kind = c.types.kind(ty)
    const text = c.text(name)
    if kind == TyKind.Int {
        if text == "wrappingCast" {
            return 0
        }
        if text == "saturatingCast" {
            return 1
        }
        if text == "checkedCast" {
            return 2
        }
    }
    if kind == TyKind.Ptr && text == "add" {
        return 3
    }
    return -1
}

// The integer type argument of `x.wrappingCast<T>()`.
fn typeArgument(c: mut Checker, p: Program, field: &Expr, explicit: &List<TypeExpr>,
                wanted: bool) int {
    const count = if wanted { 1 } else { 0 }
    if explicit.len() != count {
        c.error("E0302", field.span, "wrong number of type arguments: expected {count}, "
                + "found {explicit.len()}")
        return ERROR
    }
    if !wanted {
        return ERROR
    }
    const target = resolveType(c, p, &explicit[0])
    if !c.types.isInteger(target) && target != ERROR {
        c.error("E0300", explicit[0].span, "mismatched types: expected an integer type, "
                + "found {c.typeName(target)}")
        return ERROR
    }
    return target
}

fn callBuiltin(c: mut Checker, p: Program, call: &Expr, field: &Expr, explicit: &List<TypeExpr>,
               args: &List<Arg>, which: int, selfType: int) int {
    c.setMember(field.id.0, BUILTIN_BASE - which)
    if which == 3 {   // pointer arithmetic (spec 11.2)
        requireUnsafe(c, call.span, "offsetting a raw pointer")
    }
    const target = typeArgument(c, p, field, explicit, which < 3)
    if which == 3 {
        return checkArgs(c, p, call.span, args, &[I64], selfType)
    }
    let ret = target
    if which == 2 {
        const option = c.r.langItems[2]
        ret = if option == 0 || target == ERROR { ERROR } else { c.types.adt(option, [target]) }
    }
    return checkArgs(c, p, call.span, args, &[], ret)
}

// Whether std declares the method `name` for the primitive `ty`.
fn hasLangMethod(c: Checker, p: Program, ty: int, name: Symbol) bool {
    const lang = if ty < c.r.lang.len() { c.r.lang[ty] } else { 0 }
    return lang != 0 && hasMethod(c, p, lang, name)
}

fn noMethod(c: mut Checker, p: Program, field: &Expr, name: Symbol, args: &List<Arg>,
            selfType: int) int {
    if selfType != ERROR {
        c.error("E0301", field.span, "no method `{c.text(name)}` on type `{c.typeName(selfType)}`")
        suggestMethod(c, p, if selfType < c.r.lang.len() { c.r.lang[selfType] } else { 0 }, name)
    }
    return skipArgs(c, p, args)
}

/**
 * The primitive type named by `e`, as in `str.new()` or `i32.MAX`.
 *
 * @param c the checker
 * @param e an expression
 * @returns the type, or -1
 */
pub fn primitiveName(c: Checker, e: &Expr) int {
    const isIdent = match e.kind {
        ExprKind.Ident(_) => true
        _ => false
    }
    if !isIdent {
        return -1
    }
    const Res.Def(id) = c.res(e.id.0) else {
        return -1
    }
    return if c.def(id).kind == DefKind.Primitive { c.def(id).primitive } else { -1 }
}

/**
 * `base.name(args)`: a method or associated function, or `Shape.Circle(x)`.
 *
 * @param c the checker
 * @param p the program
 * @param call the call
 * @param field its callee
 * @param args its arguments
 * @param expected the type the context expects
 * @returns the result type
 */
pub fn checkMethodCall(c: mut Checker, p: Program, call: &Expr, field: &Expr, args: &List<Arg>,
                       expected: int) int {
    match field.kind {
        ExprKind.Field(baseBox, name, explicit) => {
            const base = &*baseBox
            const owner = typeNameOf(c, base)
            if owner != 0 {   // `Point.new()`, `Stack<int>.new()` or `Shape.Circle(1.0)`
                const selfType = namedInstance(c, p, owner, &typeArgsOf(base), base.span)
                c.setType(base.id.0, selfType)
                if c.def(owner).kind == DefKind.Enum {
                    if const Option.Some(ty) = checkQualifiedVariant(c, p, call, field, name,
                                                                   Option.Some(args),
                                                             owner, selfType, expected) {
                        return ty
                    }
                }
                return checkUserMethod(c, p, call, field, base, name, &explicit, args, owner, true,
                                       selfType, expected)
            }
            const primitive = primitiveName(c, base)
            if primitive >= 0 {   // an associated function: `str.new()`
                c.setType(base.id.0, primitive)
                if hasLangMethod(c, p, primitive, name) {
                    return checkUserMethod(c, p, call, field, base, name, &explicit, args,
                                           c.r.lang[primitive], true, primitive, expected)
                }
                return noMethod(c, p, field, name, args, primitive)
            }
            const found = checkExpr(c, p, base, ERROR)
            const selfType = methodReceiver(c, p, base, found, name)
            if c.types.kind(selfType) == TyKind.Param {   // a method of a bounding interface
                const param = c.types.get(selfType).data
                const iface = paramMethodOwner(c, p, param, name)
                const clash = paramDefaultClash(c, p, param, name)
                if clash.len() > 0 {
                    c.error("E0329", field.span, "ambiguous call: {clash}")
                }
                if iface != 0 {
                    return checkUserMethod(c, p, call, field, base, name, &explicit, args, iface,
                                           false, selfType, expected)
                }
            }
            if c.types.kind(selfType) == TyKind.Dyn {   // a method called through the vtable
                const iface = declaringInterface(c, p, c.types.get(selfType).data, name)
                if iface != 0 && !dynCallable(c, p, methodDef(c, p, iface,
                                                              methodIndex(c, p, iface, name))) {
                    c.error("E0339", field.span, "`{c.text(name)}` cannot be called on "
                            + "`{c.typeName(selfType)}`: it takes `self` by value, is generic "
                            + "or mentions `Self`")
                    return skipArgs(c, p, args)
                }
                if iface != 0 {
                    return checkUserMethod(c, p, call, field, base, name, &explicit, args, iface,
                                           false, selfType, expected)
                }
                return noMethod(c, p, field, name, args, selfType)
            }
            if c.types.kind(selfType) == TyKind.Adt {
                const id = c.types.get(selfType).data
                return checkUserMethod(c, p, call, field, base, name, &explicit, args, id, false,
                                       selfType, expected)
            }
            if hasLangMethod(c, p, selfType, name) {
                const lang = c.r.lang[selfType]
                return checkUserMethod(c, p, call, field, base, name, &explicit, args, lang,
                                       false, selfType, expected)
            }
            const which = builtinIndex(c, selfType, name)
            if which >= 0 {
                return callBuiltin(c, p, call, field, &explicit, args, which, selfType)
            }
            if c.text(name) == "clone" {
                return checkDerivedClone(c, p, call, field, &explicit, args, selfType)
            }
            return noMethod(c, p, field, name, args, selfType)
        }
        _ => {
            return ERROR
        }
    }
}

fn builtinConst(c: Checker, ty: int, name: Symbol) bool {
    const text = c.text(name)
    const kind = c.types.kind(ty)
    if kind == TyKind.Int {
        return text == "MIN" || text == "MAX"
    }
    if kind == TyKind.Float {
        return text == "NAN" || text == "INFINITY" || text == "EPSILON"
    }
    return false
}

/**
 * `p.x` on a struct, `Shape.Empty`, or `i32.MAX`, `float.NAN`, ... on a
 * primitive type.
 *
 * @param c the checker
 * @param p the program
 * @param e the field expression
 * @param base its base
 * @param name the field
 * @param expected the type the context expects
 * @returns its type
 */
pub fn checkField(c: mut Checker, p: Program, e: &Expr, base: &Expr, name: Symbol,
                  expected: int) int {
    const member = comptimeMember(c, e, base, name)
    if member >= 0 {   // `field.name` in a `comptime for`
        return member
    }
    const owner = typeNameOf(c, base)
    if owner != 0 {   // `Shape.Empty`, `Opt<int>.None`
        const selfType = namedInstance(c, p, owner, &typeArgsOf(base), base.span)
        c.setType(base.id.0, selfType)
        if c.def(owner).kind == DefKind.Enum {
            if const Option.Some(ty) = checkQualifiedVariant(c, p, e, e, name, Option.None, owner,
                                                           selfType, expected) {
                return ty
            }
        }
        c.error("E0320", e.span, "no variant `{c.text(name)}` in `{c.text(c.def(owner).name)}`")
        return ERROR
    }
    const primitive = primitiveName(c, base)
    if primitive < 0 {
        const found = checkExpr(c, p, base, ERROR)
        return checkStructField(c, p, e, name, autoDeref(c, p, base, found))
    }
    c.setType(base.id.0, primitive)
    if !builtinConst(c, primitive, name) {
        c.error("E0301", e.span, "no constant `{c.text(name)}` on type "
                + "`{c.typeName(primitive)}`")
        return ERROR
    }
    return primitive
}

/**
 * `s[i]` is the byte at offset i of a str (spec 2.3); `l[i]` an element.
 *
 * @param c the checker
 * @param p the program
 * @param e the index expression
 * @param base the indexed value
 * @param index the index
 * @returns the element's type
 */
pub fn checkIndex(c: mut Checker, p: Program, e: &Expr, base: &Expr, index: &Expr) int {
    if const ExprKind.Range(_, _, _) = index.kind {
        return checkRangeIndex(c, p, e, base, index, false)
    }
    if comptimeVariantGet(c, e, index) {
        checkExpr(c, p, base, ERROR)
        return ERROR
    }
    const found = checkExpr(c, p, base, ERROR)
    const ty = autoDeref(c, p, base, found)
    if keyedBase(c, ty) {   // `value[key]` (spec 16.2)
        const key = checkExpr(c, p, index, ERROR)
        if const Option.Some(field) = keyIndex(c, p, ty, index, key) {
            return field
        }
        if paramKey(c, key) == ERROR {   // a `comptime for` that had an error
            return ERROR
        }
        requireType(c, index, key, I64)
        c.error("E0313", e.span, "type `{c.typeName(ty)}` cannot be indexed")
        return ERROR
    }
    coerce(c, p, index, I64)
    if const Option.Some(elem) = sequenceElem(c, ty) {
        return elem
    }
    if ty == STR {
        return U8
    }
    if ty != ERROR {
        c.error("E0313", e.span, "type `{c.typeName(ty)}` cannot be indexed")
    }
    return ERROR
}

// Whether `value[key]` can name a field of a value of type `ty`: a type
// parameter, a tuple or a struct other than a list's.
fn keyedBase(c: Checker, ty: int) bool {
    const kind = c.types.kind(ty)
    if kind == TyKind.Param || kind == TyKind.Tuple || kind == TyKind.Mapped {
        return true
    }
    if kind != TyKind.Adt || sequenceElem(c, ty).isSome() {
        return false
    }
    const def = c.def(c.types.get(ty).data)
    return def.kind == DefKind.Struct && !def.lang
}

// ---------------------------------------------------------------------------
// Clones (spec 5.1)

// `Box` and `List`, whose `clone` clones their elements; the `clone` of other
// std types (`Arc`, `Sender`) shares them.
fn clonesElements(c: Checker, id: int) bool {
    return id != 0 && (id == c.r.langItems[0] || id == c.r.langItems[1])
}

fn cloneableArgs(c: mut Checker, p: Program, ty: int, visiting: mut List<int>) bool {
    const args = c.types.get(ty).args.clone()
    for i in 0..args.len() {
        if !cloneableIn(c, p, args[i], visiting) {
            return false
        }
    }
    return true
}

fn cloneableFields(c: mut Checker, p: Program, ty: int, id: int, visiting: mut List<int>) bool {
    if c.def(id).kind == DefKind.Struct {
        const count = match c.info[id].fields {
            Option.Some(info) => info.types.len()
            Option.None => 0
        }
        for i in 0..count {
            if !cloneableIn(c, p, structFieldType(c, p, ty, i), visiting) {
                return false
            }
        }
        return true
    }
    let shape: List<int> = []
    if const Option.Some(info) = c.info[id].variants {
        for v in 0..info.variants.len() {
            shape.push(info.variants[v].types.len())
        }
    }
    for v in 0..shape.len() {
        for i in 0..shape[v] {
            if !cloneableIn(c, p, variantFieldType(c, p, ty, v, i), visiting) {
                return false
            }
        }
    }
    return true
}

// The `clone` of `List` and `Box` clones their elements; any other type's is
// its own business.
fn cloneableAdt(c: mut Checker, p: Program, ty: int, visiting: mut List<int>) bool {
    const id = c.types.get(ty).data
    const cloneName = c.r.names.find("clone")
    const dropName = c.r.names.find("drop")
    if const Option.Some(name) = cloneName {
        if hasMethod(c, p, id, name) {
            return !clonesElements(c, id) || cloneableArgs(c, p, ty, visiting)
        }
    }
    if const Option.Some(name) = dropName {
        if hasMethod(c, p, id, name) {
            return false
        }
    }
    return cloneableFields(c, p, ty, id, visiting)
}

fn cloneableIn(c: mut Checker, p: Program, ty: int, visiting: mut List<int>) bool {
    const kind = c.types.kind(ty)
    if kind == TyKind.Param {
        return paramBounds(c, ty) & BOUND_CLONE != 0
    }
    if kind == TyKind.Str || isCopy(c, p, ty) {
        return true
    }
    if kind == TyKind.Tuple {
        return cloneableArgs(c, p, ty, visiting)
    }
    if kind != TyKind.Adt {
        return false
    }
    for i in 0..visiting.len() {
        if visiting[i] == ty {
            return true   // a recursive type: cloneable if the rest is
        }
    }
    if visiting.len() == 64 {
        return false
    }
    visiting.push(ty)
    const ok = cloneableAdt(c, p, ty, visiting)
    visiting.pop()
    return ok
}

/**
 * Whether the compiler can clone a value of a type.
 *
 * @param c the checker
 * @param p the program
 * @param ty the type
 * @returns true if it can
 */
pub fn isCloneable(c: mut Checker, p: Program, ty: int) bool {
    let visiting: List<int> = []
    return cloneableIn(c, p, ty, visiting)
}

fn notCloneable(c: mut Checker, span: Span, ty: int) {
    if ty != ERROR {
        c.error("E0322", span, "type `{c.typeName(ty)}` cannot be cloned: declare a `clone` "
                + "method, or give it only parts that can be cloned")
    }
}

// `value.clone()` on a type without a `clone` method: the derived clone.
fn checkDerivedClone(c: mut Checker, p: Program, call: &Expr, field: &Expr,
                     explicit: &List<TypeExpr>, args: &List<Arg>, selfType: int) int {
    if args.len() > 0 || explicit.len() > 0 {
        c.error("E0302", call.span, "`clone` takes no arguments".toOwned())
    }
    for i in 0..args.len() {
        checkExpr(c, p, &args[i].value, ERROR)
    }
    if !isCloneable(c, p, selfType) {
        notCloneable(c, field.span, selfType)
        return ERROR
    }
    c.setMember(field.id.0, DERIVED_CLONE)
    return selfType
}

// `list.clone()` calls the std method, which clones each element.
fn checkStdClone(c: mut Checker, p: Program, field: &Expr, owner: int, hasSelf: bool,
                 selfType: int) {
    if !clonesElements(c, owner) || !hasSelf {
        return
    }
    if !isCloneable(c, p, selfType) {
        notCloneable(c, field.span, selfType)
    }
}
