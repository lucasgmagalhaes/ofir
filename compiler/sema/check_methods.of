/**
 * @module
 * Method calls, fields and indexing (stage 0: bootstrap/src/sema/
 * check_method.c, check_user_method.c, builtins.c and check_clone.c):
 * methods declared in a type's body (spec 3.6), the `@lang` methods of the
 * primitive types in std, the few built-in ones (`wrappingCast<T>()`,
 * `p.add(n)`), the derived `.clone()`, and the arguments of `mut`
 * parameters.
 */

import base.intern.Symbol
import base.span.Span
import sema.check.BOUND_CLONE
import sema.call_args.argParam
import sema.check.Checker
import sema.check.Loc
import sema.check.fnOf
import sema.check.itemOf
import sema.check.itemTypeParams
