/**
 * @module
 * Type checking of statements, blocks, `if` and `match` (spec 3.1 and 4;
 * stage 0: bootstrap/src/sema/check_stmt.c and check_match.c).
 */

import base.intern.Symbol
import base.span.Span
import sema.check.Checker
import sema.check_closure.noteWrite
import sema.check_comptime.DEPENDS
import sema.check_comptime.checkComptimeCond
import sema.check_comptime_for.checkComptimeFor
import sema.check_comptime_for.jumpLeavesComptime
import sema.check_comptime.ifNarrowing
import sema.check_comptime.narrow
import sema.check_list.checkForCollection
import sema.check_option.checkUnusedResult
import sema.check_pattern.checkPattern
import sema.check_pattern.irrefutable
import sema.check_place.placeRoot
import sema.check_place.requireMutable
import sema.check_ref.checkReturnedRef
import sema.check_types.compatible
import sema.check_union.coerceToUnion
import sema.check_types.resolveType
import sema.check_generic.reportBadLengths
import sema.def.DefKind
import sema.def.Res
import sema.exhaustive.checkExhaustive
import sema.expr_check.checkBinary
import sema.expr_check.checkExpr
import sema.expr_check.checkUnsafeBlock
import sema.expr_check.coerce
import sema.expr_check.nameRes
import sema.expr_check.requireTypeAt
import sema.program.Program
import sema.types.BOOL
import sema.types.ERROR
import sema.types.NEVER
import sema.types.UNIT
import syntax.ast.Block
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.ForKind
import syntax.ast.Op
import syntax.ast.Stmt
import syntax.ast.StmtKind

fn unitUnlessNever(ty: int) int {
    return if ty == NEVER { ty } else { UNIT }
}

fn letStmt(c: mut Checker, p: Program, s: &Stmt) int {
    match s.kind {
        StmtKind.Let(pattern, annotation, value, otherwise) => {
            let ty = ERROR
            let found = ERROR
            if const Option.Some(t) = annotation {
                ty = resolveType(c, p, &t)
                found = coerce(c, p, &value, ty)
            } else {
                found = checkExpr(c, p, &value, ERROR)
                ty = found
            }
            checkPattern(c, p, &pattern, ty)
            // `const pattern = value else { ... }` (spec 4.6)
            if const Option.Some(block) = otherwise {
                if checkBlock(c, p, &block, ERROR, false) != NEVER {
                    c.error("E0307", block.span, "the `else` block of `const ... else` must not "
                            + "fall through: end it with `return`, `break`, `continue` or a panic")
                }
            } else if !irrefutable(c, &pattern) {
                c.error("E0501", pattern.span,
                        "this pattern does not match every value: use `match` or `if const`"
                            .toOwned())
            }
            return unitUnlessNever(found)
        }
        _ => {
            return UNIT
        }
    }
}

fn varStmt(c: mut Checker, p: Program, s: &Stmt) int {
    match s.kind {
        StmtKind.Var(_, annotation, value) => {
            let ty = ERROR
            if const Option.Some(t) = annotation {
                ty = resolveType(c, p, &t)
            }
            let found = ERROR
            if const Option.Some(init) = value {
                found = if annotation.isSome() { coerce(c, p, &init, ty) } else {
                    checkExpr(c, p, &init, ERROR)
                }
            }
            const local = c.localAt(s.id.0)
            if local >= 0 {
                c.localTypes[local] = if annotation.isSome() { ty } else { found }
            }
            return unitUnlessNever(found)
        }
        _ => {
            return UNIT
        }
    }
}

// The left side of `=` must be a mutable place (spec 4.2).
fn checkPlace(c: mut Checker, p: Program, target: &Expr) {
    const Option.Some(root) = placeRoot(c, target) else {
        c.unsupported(target.span, "assigning to elements is")
        return
    }
    const isUnary = match root.0.kind {
        ExprKind.Unary(_, _) => true
        _ => false
    }
    if root.0.id.0 != target.id.0 || root.1 > 0 || isUnary {   // a field or `*p`
        requireMutable(c, p, target)
        return
    }
    match nameRes(c, target) {
        Res.Local(id) => {
            if !c.locals[id].mutable {
                const name = c.text(c.locals[id].name)
                c.error("E0304", target.span, "cannot assign twice to immutable variable "
                        + "`{name}`")
                c.r.diags.help("declare it with `let {name}` to assign to it again")
            }
            noteWrite(c, target.span, id)
        }
        Res.Def(id) => {
            if c.def(id).kind != DefKind.Global {
                c.error("E0304", target.span, "cannot assign to `{c.text(c.def(id).name)}`")
            }
        }
        _ => {}
    }
}

fn assignStmt(c: mut Checker, p: Program, s: &Stmt, op: Op, target: &Expr, value: &Expr) int {
    const ty = checkExpr(c, p, target, ERROR)
    checkPlace(c, p, target)
    if op == Op.Assign {
        coerce(c, p, value, ty)
        return UNIT
    }
    // `x op= y` checks like `x op y`.
    const found = checkBinary(c, p, s.span, op, target, value, ty)
    if !compatible(found, ty) {
        requireTypeAt(c, s.span, found, ty)
    }
    return UNIT
}

fn loopBody(c: mut Checker, p: Program, s: &Stmt, body: &Block, infinite: bool) int {
    if const Option.Some(label) = s.label {
        if loopLabeled(c, label) >= 0 {
            c.error("E0324", s.span, "the label `{c.r.names.name(label)}` is already used by an "
                    + "enclosing loop")
        }
    }
    c.loops.push(false)
    c.loopLabels.push(s.label)
    checkBlock(c, p, body, ERROR, false)
    const _ = c.loopLabels.pop()
    const broken = c.loops.pop() ?? false
    // An infinite loop without `break` never finishes.
    return if infinite && !broken { NEVER } else { UNIT }
}

fn forIn(c: mut Checker, p: Program, s: &Stmt, iterable: &Expr, two: bool, body: &Block) int {
    match iterable.kind {   // a list, a map or an iterator
        ExprKind.Range(lo, hi, _) => {
            if two {
                c.error("E0300", iterable.span,
                        "a range gives one variable: `for i in a..b`".toOwned())
                return UNIT
            }
            if lo.isNone() || hi.isNone() {
                c.unsupported(iterable.span, "`for` over ranges without both bounds is")
                return UNIT
            }
            const low = match lo {
                Option.Some(l) => &*l
                Option.None => iterable
            }
            const high = match hi {
                Option.Some(h) => &*h
                Option.None => iterable
            }
            // A literal bound takes the type of the other one: `for i in 0..n` with `n: u8`.
            const lowInt = match low.kind {
                ExprKind.Int(_) => true
                _ => false
            }
            const highInt = match high.kind {
                ExprKind.Int(_) => true
                _ => false
            }
            const swap = lowInt && !highInt
            const first = if swap { high } else { low }
            const second = if swap { low } else { high }
            const ty = checkExpr(c, p, first, ERROR)
            coerce(c, p, second, ty)
            if !c.types.isInteger(ty) && ty != ERROR {
                c.error("E0300", iterable.span, "mismatched types: expected an integer, "
                        + "found {c.typeName(ty)}")
            }
            c.setType(iterable.id.0, ty)
            const local = c.localAt(s.id.0)
            if local >= 0 {
                c.localTypes[local] = ty
            }
            return loopBody(c, p, s, body, false)
        }
        _ => {
            checkForCollection(c, p, s, iterable, two)
            return loopBody(c, p, s, body, false)
        }
    }
}

fn forStmt(c: mut Checker, p: Program, s: &Stmt) int {
    match s.kind {
        StmtKind.For(kind, _, first, second, expr, body) => {
            return match kind {
                ForKind.Infinite => loopBody(c, p, s, &body, true)
                ForKind.Cond => {
                    if const Option.Some(cond) = expr {
                        coerce(c, p, &cond, BOOL)
                    }
                    loopBody(c, p, s, &body, false)
                }
                ForKind.In => match expr {
                    Option.Some(iterable) => forIn(c, p, s, &iterable, second.isSome(), &body)
                    Option.None => UNIT
                }
                ForKind.Comptime => match expr {
                    Option.Some(iterable) => {
                        checkComptimeFor(c, p, s, first ?? c.r.selfName, &iterable, &body)
                    }
                    Option.None => UNIT
                }
            }
        }
        _ => {
            return UNIT
        }
    }
}

fn returnStmt(c: mut Checker, p: Program, s: &Stmt, value: &Option<Expr>) int {
    if const Option.Some(v) = *value {
        coerce(c, p, &v, c.ret)
        checkReturnedRef(c, p, c.fnDef, &v)
    } else if !compatible(UNIT, c.ret) {
        c.error("E0300", s.span, "mismatched types: expected {c.typeName(c.ret)}, found ()")
    }
    return NEVER
}

fn jumpStmt(c: mut Checker, s: &Stmt, isBreak: bool) int {
    if s.label.isNone() && jumpLeavesComptime(c) {
        c.error("E0309", s.span, "`{if isBreak { "break" } else { "continue" }}` inside "
                + "`comptime for`, which is unrolled")
    } else if c.loops.len() == 0 {
        c.error("E0309", s.span, "`{if isBreak { "break" } else { "continue" }}` outside of a "
                + "loop")
    } else if const Option.Some(label) = s.label {
        const i = loopLabeled(c, label)
        if i < 0 {
            c.error("E0323", s.span, "no enclosing loop is labeled `{c.r.names.name(label)}`")
        } else if isBreak {
            c.loops[i] = true
        }
    } else if isBreak {
        const last = c.loops.len() - 1
        c.loops[last] = true
    }
    return NEVER
}

// The open loop with this label, innermost first, or -1.
fn loopLabeled(c: Checker, label: Symbol) int {
    let i = c.loopLabels.len()
    for i > 0 {
        i -= 1
        if const Option.Some(name) = c.loopLabels[i] {
            if name.0 == label.0 {
                return i
            }
        }
    }
    return -1
}

// An `if`, `match` or block used as a statement: its branches are not values.
fn exprStmt(c: mut Checker, p: Program, e: &Expr) int {
    const ty = match e.kind {
        ExprKind.Match(_, _) => checkMatch(c, p, e, ERROR, false)
        ExprKind.If(_, _, _, _) => checkIf(c, p, e, ERROR, false)
        ExprKind.Unsafe(block) => checkUnsafeBlock(c, p, &block, ERROR, false)
        ExprKind.Block(block) => checkBlock(c, p, &block, ERROR, false)
        _ => {
            const found = checkExpr(c, p, e, ERROR)
            checkUnusedResult(c, e)
            found
        }
    }
    c.setType(e.id.0, ty)
    return unitUnlessNever(ty)
}

fn checkStmt(c: mut Checker, p: Program, s: &Stmt) int {
    return match s.kind {
        StmtKind.Let(_, _, _, _) => letStmt(c, p, s)
        StmtKind.Var(_, _, _) => varStmt(c, p, s)
        StmtKind.Assign(op, target, value) => assignStmt(c, p, s, op, &target, &value)
        StmtKind.For(_, _, _, _, _, _) => forStmt(c, p, s)
        StmtKind.Return(value) => returnStmt(c, p, s, &value)
        StmtKind.Break => jumpStmt(c, s, true)
        StmtKind.Continue => jumpStmt(c, s, false)
        StmtKind.ExprStmt(expr) => exprStmt(c, p, &expr)
    }
}

/**
 * Checks a block. As a value, a block is worth its last expression (spec
 * 4.1); a block that cannot finish has type `!`.
 *
 * @param c the checker
 * @param p the program
 * @param block the block
 * @param expected the type the context expects
 * @param asValue whether its value is used
 * @returns its type
 */
pub fn checkBlock(c: mut Checker, p: Program, block: &Block, expected: int, asValue: bool) int {
    const stmts = &block.stmts
    let diverges = false
    let warned = false
    for i in 0..stmts.len() {
        const s = &stmts[i]
        if diverges && !warned {   // W0004 once per block (spec 12.6)
            c.r.diags.warning("W0004", s.span,
                              "unreachable code: the statement before it never finishes"
                                  .toOwned())
            warned = true
        }
        if asValue && i + 1 == stmts.len() {
            if const StmtKind.ExprStmt(tail) = s.kind {
                let ty = checkExpr(c, p, &tail, expected)
                reportBadLengths(c, s.span)
                if coerceToUnion(c, &tail, ty, expected) {
                    ty = expected   // a branch widens to the union expected (spec 17.3)
                }
                return if diverges { NEVER } else { ty }
            }
        }
        const ty = checkStmt(c, p, s)
        reportBadLengths(c, s.span)   // a type of the statement, as `Short<0>`
        diverges = diverges || ty == NEVER
    }
    return if diverges { NEVER } else { UNIT }
}

fn join(c: mut Checker, span: Span, expected: int, then: int, other: int) int {
    if then == NEVER {
        return other
    }
    if other != NEVER && !compatible(other, then) {
        mismatchedBranches(c, span, expected, then, other)
    }
    return then
}

// Branches of different types: E0353 when no type is expected (a union is
// never inferred, spec 17.3), else E0300.
fn mismatchedBranches(c: mut Checker, span: Span, expected: int, first: int, other: int) {
    if expected == ERROR {
        c.error("E0353", span, "the branches have different types, `{c.typeName(first)}` and "
                + "`{c.typeName(other)}`: write the union type expected")
        return
    }
    c.error("E0300", span, "mismatched types: expected {c.typeName(first)}, "
            + "found {c.typeName(other)}")
}

/**
 * Checks `if cond { } else { }` and `if const pattern = value { }`.
 *
 * @param c the checker
 * @param p the program
 * @param e the `if`
 * @param expected the type the context expects
 * @param asValue whether its value is used
 * @returns its type
 */
pub fn checkIf(c: mut Checker, p: Program, e: &Expr, expected: int, asValue: bool) int {
    match e.kind {
        ExprKind.If(letPattern, cond, _, otherwise) => {
            let known = DEPENDS
            if const Option.Some(pattern) = letPattern {
                const ty = checkExpr(c, p, &*cond, ERROR)
                checkPattern(c, p, &pattern, ty)
            } else if const ExprKind.Comptime(inner) = cond.kind {
                known = checkComptimeCond(c, p, &*inner)
                c.setType(cond.id.0, BOOL)
            } else {
                coerce(c, p, &*cond, BOOL)
            }
            const thenType = if known == 0 { NEVER } else { checkThen(c, p, e, expected, asValue) }
            if otherwise.isNone() {
                return UNIT   // as a value, `if` without `else` is ()
            }
            const other = match otherwise {
                Option.Some(o) => &*o
                Option.None => e
            }
            if known == 1 {
                return thenType   // the `else` branch is not compiled (spec 15.3)
            }
            const otherType = match other.kind {
                ExprKind.If(_, _, _, _) => checkIf(c, p, other, expected, asValue)
                ExprKind.Block(block) => checkBlock(c, p, &block, expected, asValue)
                _ => checkExpr(c, p, other, expected)
            }
            c.setType(other.id.0, otherType)
            if known == 0 {
                return otherType
            }
            if !asValue {
                return if thenType == NEVER && otherType == NEVER { NEVER } else { UNIT }
            }
            return join(c, other.span, expected, thenType, otherType)
        }
        _ => {
            return ERROR
        }
    }
}

// The `then` block of `e`, with the type parameters narrowed by a `comptime`
// condition (spec 15.3).
fn checkThen(c: mut Checker, p: Program, e: &Expr, expected: int, asValue: bool) int {
    return match e.kind {
        ExprKind.If(_, cond, then, _) => match ifNarrowing(c, p, &*cond) {
            Option.Some(n) => {
                const saved = narrow(c, &n)
                const ty = checkBlock(c, p, &then, expected, asValue)
                c.enterGenerics(saved)
                ty
            }
            Option.None => checkBlock(c, p, &then, expected, asValue)
        }
        _ => ERROR
    }
}

fn armBody(c: mut Checker, p: Program, body: &Expr, expected: int, asValue: bool) int {
    if !asValue {
        match body.kind {
            ExprKind.Unsafe(block) => {
                const ty = checkUnsafeBlock(c, p, &block, ERROR, false)
                c.setType(body.id.0, ty)
                return unitUnlessNever(ty)
            }
            ExprKind.Block(block) => {
                const ty = checkBlock(c, p, &block, ERROR, false)
                c.setType(body.id.0, ty)
                return unitUnlessNever(ty)
            }
            ExprKind.If(_, _, _, _) => {
                const ty = checkIf(c, p, body, ERROR, false)
                c.setType(body.id.0, ty)
                return ty
            }
            _ => {}
        }
    }
    let ty = checkExpr(c, p, body, expected)
    if asValue && coerceToUnion(c, body, ty, expected) {
        ty = expected
    }
    return if asValue || ty == NEVER { ty } else { UNIT }
}

/**
 * Checks a `match` (spec 4.5): its arms have one type, like the branches
 * of `if`.
 *
 * @param c the checker
 * @param p the program
 * @param e the `match`
 * @param expected the type the context expects
 * @param asValue whether its value is used
 * @returns its type
 */
pub fn checkMatch(c: mut Checker, p: Program, e: &Expr, expected: int, asValue: bool) int {
    match e.kind {
        ExprKind.Match(scrutinee, arms) => {
            const ty = checkExpr(c, p, &*scrutinee, ERROR)
            let result = NEVER
            for i in 0..arms.len() {
                const arm = &arms[i]
                checkPattern(c, p, &arm.pattern, ty)
                if const Option.Some(guard) = arm.guard {
                    coerce(c, p, &guard, BOOL)
                }
                const hint = if result == NEVER { expected } else { result }
                const found = armBody(c, p, &arm.body, hint, asValue)
                if result == NEVER {
                    result = found
                } else if found != NEVER && !compatible(found, result) {
                    mismatchedBranches(c, arm.body.span, expected, result, found)
                }
            }
            checkExhaustive(c, p, e, &arms, ty)
            return if asValue { result } else { unitUnlessNever(result) }
        }
        _ => {
            return ERROR
        }
    }
}
