/**
 * @module
 * Building enum variants (spec 2.5 and 3.5; stage 0:
 * bootstrap/src/sema/enums.c): `.Circle(1.0)` where the enum is known from
 * the context, `Shape.Circle(1.0)`, `Shape.Empty`, and the prelude's
 * `Some(x)`, `None`, `Ok(v)`, `Err(e)`.
 */

import base.intern.Symbol
import base.span.Span
import sema.check.Checker
import sema.check.itemOf
import sema.check.itemTypeParams
import sema.check.typeGenericsOf
import sema.check.check_generic.checkGenericArgs
import sema.check.check_generic.inferFromSelf
import sema.check.check_generic.inferNew
import sema.check.check_keys.checkKeyLiteral
import sema.check.check_types.ownerType
import sema.check.enums.enumOf
import sema.check.enums.enumVariants
import sema.check.enums.variantIndex
import sema.check.enums.variantsOf
import sema.check.expr_check.checkArgs
import sema.core.program.Program
import sema.core.types.ERROR
import sema.core.types.TyKind
import syntax.ast.Arg
import syntax.ast.Expr
import syntax.ast.ExprKind

// Checks the payload of variant `index` of enum `id`, built at `at`.
fn build(c: mut Checker, p: Program, at: &Expr, args: Option<&List<Arg>>, id: int, index: int,
         selfType: int, expected: int) int {
    enumVariants(c, p, id)
    const name = variantsOf(c, id).variants[index].name
    const types = variantsOf(c, id).variants[index].types.clone()
    const count = types.len()
    if args.isNone() && count > 0 {
        c.error("E0302", at.span, "the variant `{c.text(name)}` takes {count} values")
    }
    if args.isSome() && count == 0 {
        c.error("E0302", at.span, "the variant `{c.text(name)}` takes no values: write it "
                + "without parentheses")
    }
    const none: List<Arg> = []
    const given = args ?? &none
    const owner = itemTypeParams(itemOf(p, c.loc(id)))
    if owner.len() > 0 {   // the arguments come from `self`, the expected type or the payload
        let inf = inferNew(typeGenericsOf(c, p, id))
        inferFromSelf(c, inf, selfType, owner.len())
        const selfType = ownerType(c, p, id)
        let params: List<int> = []
        if args.isSome() && count > 0 {
            params = types
        }
        const used = if args.isSome() && count > 0 { given } else { &none }
        return checkGenericArgs(c, p, at.id.0, at.span, used, params, selfType, inf,
                                expected, 0)
    }
    const ty = c.types.adt(id, [])
    if args.isNone() || count == 0 {
        return ty
    }
    return checkArgs(c, p, at.span, given, types, ty)
}

/**
 * E0326: a variant named without its enum (ADR 0028).
 *
 * @param c the checker
 * @param span where the variant is named
 * @param id the enum's `DefId`
 * @param name the variant
 */
pub fn unqualifiedVariant(c: mut Checker, span: Span, id: int, name: Symbol) {
    const text = c.text(name).toOwned()
    c.error("E0326", span, "a variant is named through its enum: write "
            + "`{c.text(c.def(id).name)}.{text}`")
}

/**
 * `Some(x)`, `None`, `Ok(v)`, `Err(e)`: E0326, then checked as if qualified.
 *
 * @param c the checker
 * @param p the program
 * @param e the name or the call
 * @param def the variant's `DefId`
 * @param args the arguments of a call
 * @param expected the type the context expects
 * @returns its type
 */
pub fn checkPreludeVariant(c: mut Checker, p: Program, e: &Expr, def: int,
                           args: Option<&List<Arg>>, expected: int) int {
    const id = c.def(def).target
    const index = c.def(def).member
    unqualifiedVariant(c, e.span, id, c.def(def).name)
    c.setMember(e.id.0, index)
    return build(c, p, e, args, id, index, ERROR, expected)
}

fn noVariant(c: mut Checker, span: Span, name: Symbol, ty: int) int {
    c.error("E0320", span, "no variant `{c.text(name)}` in `{c.typeName(ty)}`")
    return ERROR
}

/**
 * `.Circle(1.0)`: E0326; when the expected type gives the enum, checked as if
 * qualified.
 *
 * @param c the checker
 * @param p the program
 * @param e the variant expression
 * @param expected the type the context expects
 * @returns its type
 */
pub fn checkVariantShorthand(c: mut Checker, p: Program, e: &Expr, expected: int) int {
    match e.kind {
        ExprKind.Variant(name, args, hasArgs) => {
            if !hasArgs && c.types.kind(expected) == TyKind.Key {
                return checkKeyLiteral(c, e.span, name, expected)
            }
            const Option.Some(id) = enumOf(c, p, expected) else {
                c.error("E0326", e.span, "a variant is named through its enum: write "
                        + "`Enum.{c.text(name)}`")
                return ERROR
            }
            unqualifiedVariant(c, e.span, id, name)
            const index = variantIndex(variantsOf(c, id), name)
            if index < 0 {
                return noVariant(c, e.span, name, expected)
            }
            c.setMember(e.id.0, index)
            let given: Option<&List<Arg>> = Option.None
            if hasArgs {
                given = Option.Some(&args)
            }
            return build(c, p, e, given, id, index, expected, expected)
        }
        _ => {
            return ERROR
        }
    }
}

/**
 * `Shape.Circle(1.0)` (a call) or `Shape.Empty` (a field).
 *
 * @param c the checker
 * @param p the program
 * @param e the call or the field
 * @param field the `Shape.Circle` part
 * @param name the variant's name
 * @param args the call's arguments
 * @param id the enum
 * @param selfType the instance named, `Opt<int>` in `Opt<int>.None`, or `ERROR`
 * @param expected the type the context expects
 * @returns its type, `None` when `name` is not a variant (maybe a method)
 */
pub fn checkQualifiedVariant(c: mut Checker, p: Program, e: &Expr, field: &Expr,
                             name: Symbol, args: Option<&List<Arg>>, id: int,
                             selfType: int, expected: int) Option<int> {
    const index = if enumVariants(c, p, id) { variantIndex(variantsOf(c, id), name) } else { -1 }
    if index < 0 {
        return Option.None
    }
    c.setMember(field.id.0, index)
    return Option.Some(build(c, p, e, args, id, index, selfType, expected))
}
