/**
 * @module
 * Conditional types (spec 16.5): `if A is B { X } else { Y }`, decided per
 * instance (stage 1 only).
 */

import base.intern.Symbol
import base.span.Span
import sema.check.Checker
import sema.check_types.resolveType
import sema.program.Program
import sema.types.ERROR
import sema.types.INFER_BASE
import sema.types.TyKind
import syntax.ast.TypeExpr
import syntax.ast.TypeKind

/**
 * The type `true` or `false`.
 *
 * @param c the checker
 * @param value which one
 * @returns its type
 */
pub fn boolType(c: mut Checker, value: bool) int {
    return c.types.intern(TyKind.Bool, if value { 1 } else { 2 }, 0, [])
}

/**
 * `infer U`: a placeholder in the pattern of a conditional type, else E0345.
 *
 * @param c the checker
 * @param name `U`
 * @param span where it is written
 * @returns the placeholder
 */
pub fn inferType(c: mut Checker, name: Symbol, span: Span) int {
    if !c.inferring {
        c.error("E0345", span, "`infer` is only allowed in the pattern of a conditional type")
        return ERROR
    }
    for i in 0..c.inferNames.len() {
        if c.inferNames[i].0 == name.0 {
            return c.types.param(INFER_BASE + i, name.0)
        }
    }
    c.inferNames.push(name)
    return c.types.param(INFER_BASE + c.inferNames.len() - 1, name.0)
}

/**
 * `if A is B { X } else { Y }`: one branch, resolved with the names `B`
 * infers when it is `X`; a `Cond` type when `A` has a type parameter.
 *
 * @param c the checker
 * @param p the program
 * @param test `A is B`, or another condition
 * @param then `X`
 * @param otherwise `Y`
 * @returns the type of the branch
 */
pub fn condType(c: mut Checker, p: Program, test: &TypeExpr, then: &TypeExpr,
                otherwise: &TypeExpr) int {
    let names: List<Symbol> = []
    let binds: List<int> = []
    let parts: List<int> = []
    const decided = decide(c, p, test, names, binds, parts)
    if decided < 0 {
        return ERROR
    }
    if decided == 2 {
        return deferredCond(c, p, test, &parts, &names, then, otherwise)
    }
    if decided == 0 {
        return resolveType(c, p, otherwise)
    }
    return thenType(c, p, &names, &binds, then)
}

// `X` with each name `infer` binds in scope.
fn thenType(c: mut Checker, p: Program, names: &List<Symbol>, binds: &List<int>,
            then: &TypeExpr) int {
    for i in 0..names.len() {
        c.typeVars.push(names[i])
        c.typeVarTypes.push(binds[i])
    }
    const ty = resolveType(c, p, then)
    for _ in 0..names.len() {
        c.typeVars.pop()
        c.typeVarTypes.pop()
    }
    return ty
}

// A conditional type whose condition `parts` has a type parameter: both
// branches, with the `infer` names as placeholders in `X`.
fn deferredCond(c: mut Checker, p: Program, test: &TypeExpr, parts: &List<int>,
                names: &List<Symbol>, then: &TypeExpr, otherwise: &TypeExpr) int {
    if names.len() > 0 && hasInfer(c, parts[0]) {
        return c.unsupported(test.span, "conditional types on an `infer` name are")
    }
    let binds: List<int> = []
    for i in 0..names.len() {
        binds.push(c.types.param(INFER_BASE + i, names[i].0))
    }
    const thenTy = thenType(c, p, names, &binds, then)
    const elseTy = resolveType(c, p, otherwise)
    if thenTy == ERROR || elseTy == ERROR {
        return ERROR
    }
    const isPattern = if parts[1] == ERROR { 0 } else { 1 }
    const cond = c.types.intern(TyKind.Cond, isPattern, 0, [parts[0], parts[1], thenTy, elseTy])
    return c.types.reduceCond(cond)
}

// Whether `ty` has an `infer` placeholder of an enclosing conditional type.
fn hasInfer(c: Checker, ty: int) bool {
    const t = c.types.get(ty)
    if !t.hasParam {
        return false
    }
    if t.kind == TyKind.Param {
        return t.data >= INFER_BASE
    }
    if t.inner != 0 && hasInfer(c, t.inner) {
        return true
    }
    for i in 0..t.args.len() {
        if hasInfer(c, t.args[i]) {
            return true
        }
    }
    return false
}

/**
 * `A is B` as a type: `true` or `false`; a `Cond` type when `A` has a type
 * parameter.
 *
 * @param c the checker
 * @param p the program
 * @param test `A is B`
 * @returns its type
 */
pub fn isType(c: mut Checker, p: Program, test: &TypeExpr) int {
    let names: List<Symbol> = []
    let binds: List<int> = []
    let parts: List<int> = []
    const decided = decide(c, p, test, names, binds, parts)
    if decided < 0 {
        return ERROR
    }
    if decided == 2 {
        const isPattern = if parts[1] == ERROR { 0 } else { 1 }
        const cond = c.types.intern(TyKind.Cond, isPattern, 0,
                                    [parts[0], parts[1], boolType(c, true), boolType(c, false)])
        return c.types.reduceCond(cond)
    }
    return boolType(c, decided == 1)
}

/**
 * Decides a condition: 1 when it holds, 0 when not, -1 after an error, 2
 * when it has a type parameter.
 *
 * @param c the checker
 * @param p the program
 * @param test the condition
 * @param names the names `infer` binds in it
 * @param binds their types, when it holds
 * @param parts for 2, `A` and the pattern `B` (ERROR when there is no `is`)
 * @returns 1, 0, -1 or 2
 */
pub fn decide(c: mut Checker, p: Program, test: &TypeExpr, names: mut List<Symbol>,
              binds: mut List<int>, parts: mut List<int>) int {
    match test.kind {
        TypeKind.Is(left, pattern) => {
            return decideIs(c, p, &*left, &*pattern, names, binds, parts)
        }
        _ => {}
    }
    const ty = resolveType(c, p, test)
    if ty == ERROR {
        return -1
    }
    const t = c.types.get(ty)
    if t.kind == TyKind.Bool && t.data > 0 {
        return if t.data == 1 { 1 } else { 0 }
    }
    if t.hasParam {
        parts.push(ty)
        parts.push(ERROR)
        return 2
    }
    c.error("E0344", test.span, "a condition must be `true` or `false`, found "
            + "`{c.typeName(ty)}`")
    return -1
}

// `A is B`.
fn decideIs(c: mut Checker, p: Program, left: &TypeExpr, pattern: &TypeExpr,
            names: mut List<Symbol>, binds: mut List<int>, parts: mut List<int>) int {
    const ty = resolveType(c, p, left)
    if ty == ERROR {
        return -1
    }
    const wasInferring = c.inferring
    const outer = c.inferNames.clone()
    c.inferring = true
    c.inferNames = []
    const shape = resolveType(c, p, pattern)
    c.inferring = wasInferring
    const inferred = c.inferNames.clone()
    c.inferNames = outer
    if shape == ERROR {
        return -1
    }
    if c.types.get(ty).hasParam {
        for i in 0..inferred.len() {
            names.push(inferred[i])
        }
        parts.push(ty)
        parts.push(shape)
        return 2
    }
    let found: List<int> = List.filled(-1, inferred.len())
    if !c.types.unify(shape, ty, found) {
        return 0
    }
    for i in 0..inferred.len() {
        names.push(inferred[i])
        binds.push(found[i])
    }
    return 1
}

/**
 * E0344 for a condition on a type parameter that must be decided now.
 *
 * @param c the checker
 * @param span the condition
 * @param ty its type
 * @returns -1
 */
pub fn notDecided(c: mut Checker, span: Span, ty: int) int {
    c.error("E0344", span, "the condition of a conditional type is not decided for "
            + "`{c.typeName(ty)}`")
    return -1
}
