/**
 * @module
 * Conversions to `dyn` types (spec 9.7): a pointer, a box or a borrowed
 * value whose type satisfies an interface becomes a fat pointer to
 * `dyn I`, recorded in `Checker.dynCoercions` for the lowering.
 */

import sema.check.Checker
import sema.check_box.boxInner
import sema.interfaces.unsatisfied
import sema.program.Program
import sema.types.TyKind
import syntax.ast.Expr

/**
 * Converts `e`, of type `found`, to `expected` when `expected` is a
 * `&dyn I`, `*dyn I` or `Box<dyn I>` that `found` can point to.
 *
 * @param c the checker
 * @param p the program
 * @param e the value
 * @param found its type
 * @param expected the type expected
 * @returns whether it was converted (or an error reported)
 */
pub fn coerceToDyn(c: mut Checker, p: Program, e: &Expr, found: int, expected: int) bool {
    if reborrowsDyn(c, found, expected) {   // the same fat pointer, retyped
        c.setType(e.id.0, expected)
        return true
    }
    const Option.Some(target) = dynTarget(c, found, expected) else {
        return false
    }
    if c.types.kind(target) == TyKind.Error {
        return true
    }
    const object = match boxInner(c, expected) {
        Option.Some(inner) => inner
        Option.None => c.types.get(expected).inner
    }
    const dynArgs = c.types.get(object).args.clone()
    const why = unsatisfied(c, p, target, c.types.get(object).data, c.types.tuple(dynArgs))
    if why.len() > 0 {
        c.error("E0300", e.span, "mismatched types: expected {c.typeName(expected)}, found "
                + "{c.typeName(found)}: {why}")
        return true
    }
    c.dynCoercions[c.module()].insert(e.id.0, found)
    c.setType(e.id.0, expected)
    return true
}

// Whether `found` is a `&mut dyn I` or a `Box<dyn I>` passed where a
// `&dyn I` (or, from a `Box`, a `&mut dyn I`) is expected: a `dyn`
// parameter given another `dyn` value.
fn reborrowsDyn(c: Checker, found: int, expected: int) bool {
    const want = c.types.get(expected)
    if want.kind != TyKind.Ref || c.types.kind(want.inner) != TyKind.Dyn {
        return false
    }
    if const Option.Some(inner) = boxInner(c, found) {
        return inner == want.inner
    }
    const have = c.types.get(found)
    return have.kind == TyKind.Ref && have.inner == want.inner && have.data == 1 &&
           want.data == 0
}

// The concrete type that `found` gives to `expected`, if the conversion
// applies.
fn dynTarget(c: Checker, found: int, expected: int) Option<int> {
    if const Option.Some(inner) = boxInner(c, expected) {
        if c.types.kind(inner) != TyKind.Dyn {
            return Option.None
        }
        const Option.Some(source) = boxInner(c, found) else {
            return Option.None
        }
        return dynSource(c, source)
    }
    if !c.types.isFat(expected) {
        return Option.None
    }
    const want = c.types.get(expected)
    const have = c.types.get(found)
    if have.kind == want.kind {   // `&T` to `&dyn I`, `*T` to `*dyn I`
        if want.data == 1 && have.data != 1 {
            return Option.None
        }
        return dynSource(c, have.inner)
    }
    if want.kind == TyKind.Ref && have.kind != TyKind.Ref && have.kind != TyKind.Ptr {
        return dynSource(c, found)   // a value, borrowed (a `mut dyn` parameter: mutably)
    }
    return Option.None
}

fn dynSource(c: Checker, ty: int) Option<int> {
    if c.types.kind(ty) == TyKind.Dyn || c.types.kind(ty) == TyKind.Never {
        return Option.None
    }
    return Option.Some(ty)
}

/**
 * Whether a type is `Box<dyn I>`.
 *
 * @param c the checker
 * @param ty the type
 * @returns true if it is
 */
pub fn boxesDyn(c: Checker, ty: int) bool {
    return match boxInner(c, ty) {
        Option.Some(inner) => c.types.kind(inner) == TyKind.Dyn
        Option.None => false
    }
}

/**
 * Whether `e` is a value borrowed as a `&dyn I` (not a pointer or box
 * converted).
 *
 * @param c the checker
 * @param e an expression of the current module
 * @returns true if it is
 */
pub fn dynBorrowed(c: Checker, e: &Expr) bool {
    return match c.dynCoercions[c.module()].get(e.id.0) {
        Option.Some(found) => {
            const kind = c.types.kind(*found)
            kind != TyKind.Ref && kind != TyKind.Ptr && boxInner(c, *found).isNone()
        }
        Option.None => false
    }
}

/**
 * The type `e` had before its conversion to a `dyn` type.
 *
 * @param c the checker
 * @param e an expression of the current module
 * @returns the type, or -1 if it was not converted
 */
pub fn dynSourceType(c: Checker, e: &Expr) int {
    return match c.dynCoercions[c.module()].get(e.id.0) {
        Option.Some(found) => *found
        Option.None => -1
    }
}
