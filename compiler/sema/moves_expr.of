import std.mem

/** What else than fields a place goes through, which forbids moving out of it. */
pub copy enum Via {
    Nothing
    Index
    Deref
    Raw
}

/** A place rooted at a local: `x`, `x.a.b`, `x.0`. */
pub struct Place {
    /** Rooted at a local, else a temporary or a global. */
    pub local: bool
    /** The local and the path. */
    pub part: Part
    /** What else it goes through. */
    pub via: Via
}

fn noPlace(via: Via) Place {
    return Place{local: false, part: Part{local: 0, fields: []}, via: via}
}

// `m.x`, a declaration of an imported module: the resolver knows it.
fn moduleMember(c: Checker, e: &Expr) bool {
    const Res.Def(id) = c.res(e.id.0) else {
        return false
    }
    return c.def(id).kind != DefKind.Module
}

fn derefCount(c: Checker, e: &Expr) int {
    return match c.derefs[c.module()].get(e.id.0) {
        Option.Some(steps) => steps.len()
        Option.None => 0
    }
}

// The type before the `i`th implicit dereference of `e`.
fn stepType(c: Checker, e: &Expr, i: int) int {
    return match c.derefs[c.module()].get(e.id.0) {
        Option.Some(steps) => steps[i]
        Option.None => c.typeOf(e.id.0)
    }
}

/**
 * The field step of `base[index]` with a key parameter (spec 16.2): it
 * names `T[K]`, resolved for each instance.
 *
 * @param c the checker
 * @param base the indexed value
 * @param index the key
 * @returns the step
 */
pub fn keyStep(c: mut Checker, base: &Expr, index: &Expr) int {
    const ty = viewType(c, base, -1)
    return keyField(c.types.intern(TyKind.Index, 0, ty, [c.typeOf(index.id.0)]))
}

/**
 * The type of `e` dereferenced `depth` times.
 *
 * @param c the checker
 * @param e the expression
 * @param depth the number of dereferences, -1 for all of them
 * @returns the type
 */
pub fn viewType(c: Checker, e: &Expr, depth: int) int {
    const count = derefCount(c, e)
    if depth == 0 || count == 0 {
        return c.typeOf(e.id.0)
    }
    if depth < 0 || depth >= count {
        return adjustedType(c, e)
    }
    return stepType(c, e, depth)
}

// Whether `e` is a slice (`&[T]` or `&mut [T]`): its elements are behind a
// pointer, not in a place `e` owns.
fn viewsSlice(c: Checker, e: &Expr) bool {
    const t = c.types.get(viewType(c, e, -1))
    if t.kind != TyKind.Adt || t.data == 0 {
        return false
    }
    return t.data == c.r.langItems[4] || t.data == c.r.langItems[7]
}

fn coerced(c: Checker, e: &Expr) bool {
    return c.sliceCoercions[c.module()].get(e.id.0).isSome() || dynBorrowed(c, e)
}

// The field of `a.f`, or -1 for a variant (`Shape.Empty`), a constant
// (`i32.MAX`) or an error.
fn fieldOf(c: Checker, e: &Expr, base: &Expr) int {
    if typeNameOf(c, base) != 0 || primitiveName(c, base) >= 0 {
        return -1
    }
    return c.members[c.module()][e.id.0]
}

fn isRangeIndex(index: &Expr) bool {
    return match index.kind {
        ExprKind.Range(_, _, _) => true
        _ => false
    }
}

// Whether `e` itself is a place: a name, a field, an element, `*p`.
fn isPlaceExpr(c: Checker, e: &Expr) bool {
    return match e.kind {
        ExprKind.Ident(_) | ExprKind.SelfValue | ExprKind.TupleField(_, _) => true
        ExprKind.Index(_, index) => !isRangeIndex(&*index)
        ExprKind.Field(base, _, _) => fieldOf(c, e, &*base) >= 0
        ExprKind.Unary(op, _) => op == Op.Deref
        _ => false
    }
}

/**
 * Whether `e`, with its implicit dereferences and conversions, is a place.
 *
 * @param c the checker
 * @param e the expression
 * @returns true if it is
 */
pub fn isPlace(c: Checker, e: &Expr) bool {
    return !coerced(c, e) && isPlaceView(c, e)
}

/**
 * Whether `e`, with its implicit dereferences, is a place, also when it
 * is converted (`list` given as `[T]` is the place `list`).
 *
 * @param c the checker
 * @param e the expression
 * @returns true if it is
 */
pub fn isPlaceView(c: Checker, e: &Expr) bool {
    return derefCount(c, e) > 0 || isPlaceExpr(c, e)
}

/**
 * Whether a type is Copy.
 *
 * @param c the checker
 * @param p the program
 * @param ty the type
 * @returns true if it is
 */
pub fn copyType(c: Checker, p: Program, ty: int) bool {
    return isCopy(c, p, ty)
}

/**
 * Walks an expression used as `use`.
 *
 * @param m the analysis
 * @param c the checker
 * @param p the program
 * @param e the expression
 * @param s the state, updated
 * @param use how its value is used
 */
pub fn movesNode(m: mut Moves, c: mut Checker, p: Program, e: &Expr, s: mut State, use: Use) {
    if coerced(c, e) {   // `list.asSlice()`: the list is read
        if s.dead {
            return
        }
        if use == Use.Move {
            markFlag(c, e.id.0, COERCION_CONSUMED)
        }
        movesView(m, c, p, e, derefCount(c, e), s, Use.Read)
        return
    }
    const mark = m.carry.len()
    movesView(m, c, p, e, derefCount(c, e), s, use)
    // A computed value that holds no reference borrows nothing: `r.len()`.
    if m.carry.len() > mark && !isPlaceView(c, e) && !holdsRef(c, p, c.typeOf(e.id.0)) &&
       !holdsBorrowedFn(c, c.typeOf(e.id.0)) {
        dropCarry(m, mark)
    }
}

fn movesView(m: mut Moves, c: mut Checker, p: Program, e: &Expr, depth: int, s: mut State,
             use: Use) {
    if s.dead {
        return   // unreachable code moves nothing
    }
    if depth > 0 || isPlaceExpr(c, e) {
        placeExpr(m, c, p, e, depth, s, use)
    } else {
        if use == Use.Move {   // else a temporary, dropped (3.2)
            markFlag(c, e.id.0, CONSUMED)
        }
        walk(m, c, p, e, s, if use == Use.Mutate { Use.Read } else { use })
    }
    if viewType(c, e, depth) == NEVER {
        s.dead = true
    }
}

// The place of `e` dereferenced `depth` times, walking the bases it does
// not reach through fields.
fn placeOf(m: mut Moves, c: mut Checker, p: Program, e: &Expr, depth: int, s: mut State) Place {
    if depth > 0 {
        if boxInner(c, stepType(c, e, depth - 1)).isSome() {   // `*b.ptr`
            boxPointer(m, c, p, e, depth - 1, s)
        } else {   // `*r`
            movesView(m, c, p, e, depth - 1, s, Use.Read)
        }
        return noPlace(Via.Deref)
    }
    match e.kind {
        ExprKind.Ident(_) | ExprKind.SelfValue => {   // else a constant or a function
            return match c.res(e.id.0) {
                Res.Local(id) => Place{local: true, part: Part{local: id, fields: []},
                                       via: Via.Nothing}
                _ => noPlace(Via.Nothing)
            }
        }
        ExprKind.Field(base, _, _) => {
            return fieldPlace(m, c, p, &*base, fieldOf(c, e, &*base), s)
        }
        ExprKind.TupleField(base, index) => {
            return fieldPlace(m, c, p, &*base, index as int, s)
        }
        ExprKind.Index(base, index) => {
            if c.types.kind(c.typeOf(index.id.0)) == TyKind.Param {   // `value[key]`: a field
                return fieldPlace(m, c, p, &*base, keyStep(c, &*base, &*index), s)
            }
            if viewsSlice(c, &*base) {   // `view[i]`: an element behind the slice's pointer
                movesNode(m, c, p, &*base, s, Use.Read)
                movesNode(m, c, p, &*index, s, Use.Read)
                return noPlace(Via.Deref)
            }
            let place = placeOf(m, c, p, &*base, derefCount(c, &*base), s)
            movesNode(m, c, p, &*index, s, Use.Read)
            place.via = Via.Index
            return place
        }
        ExprKind.Unary(_, operand) => {   // `*p`
            const ty = viewType(c, &*operand, -1)
            if boxInner(c, ty).isSome() {   // `*b` is `*b.ptr`
                boxPointer(m, c, p, &*operand, derefCount(c, &*operand), s)
                // The value in a box is lent like a referenced one: a `match` on
                // it binds by borrow, as the box still owns it. In std.core.box
                // itself, `*self.ptr` is the raw pointer it is.
                return noPlace(if ownBox(c) { Via.Raw } else { Via.Deref })
            }
            movesNode(m, c, p, &*operand, s, Use.Read)
            return noPlace(if c.types.kind(ty) == TyKind.Ptr { Via.Raw } else { Via.Deref })
        }
        _ => {
            movesView(m, c, p, e, 0, s, Use.Read)   // a temporary: `make().x`
            return noPlace(Via.Nothing)
        }
    }
}

/**
 * The place of an expression, with its implicit dereferences, walking the
 * bases it does not reach through fields.
 *
 * @param m the analysis
 * @param c the checker
 * @param p the program
 * @param e the expression, a place
 * @param s the state, updated
 * @returns the place
 */
pub fn placeOfNode(m: mut Moves, c: mut Checker, p: Program, e: &Expr, s: mut State) Place {
    return placeOf(m, c, p, e, derefCount(c, e), s)
}

fn ownBox(c: Checker) bool {
    const box = c.r.langItems[0]
    return box != 0 && c.def(box).module == c.module()
}

// Reads `b.ptr`, the pointer field of the box `b` (`e` dereferenced `depth` times).
fn boxPointer(m: mut Moves, c: mut Checker, p: Program, e: &Expr, depth: int, s: mut State) {
    let place = placeOf(m, c, p, e, depth, s)
    if place.local && place.part.fields.len() < PART_DEPTH {
        place.part.fields.push(0)
    }
    usePlace(m, c, &place, s, e.span)
    if place.local {
        access(s, &place.part, Access.Read, e.span)
    }
}

fn fieldPlace(m: mut Moves, c: mut Checker, p: Program, base: &Expr, field: int,
              s: mut State) Place {
    let place = placeOf(m, c, p, base, derefCount(c, base), s)
    if place.local && place.part.fields.len() < PART_DEPTH {
        place.part.fields.push(field)
    }
    return place
}

/**
 * Reports E0601 or E0600 if a place may not hold a value. A local that
 * holds loans is used: their conflicts are errors, and the value read
 * carries them.
 *
 * @param m the analysis
 * @param c the checker
 * @param place the place
 * @param s the state
 * @param span where it is used
 */
pub fn usePlace(m: mut Moves, c: mut Checker, place: &Place, s: mut State, span: Span) {
    if !place.local {
        return
    }
    const local = place.part.local
    useHolder(m, c, s, local)
    carryHolder(m, &s, local)
    if s.uninit[local] {
        moveError(m, c, "E0601", span, "use of possibly uninitialized variable "
                  + "`{localName(c, local)}`")
    } else if s.movedPart(&place.part) {
        const name = localName(c, local)
        moveError(m, c, "E0600", span, "use of moved value `{name}`")
        if m.report {
            c.r.diags.help("`{name}` was moved before: clone it there if both copies are needed")
        }
    }
}

// Moving out of `place`: only out of a place the function owns entirely.
fn movePlace(m: mut Moves, c: mut Checker, place: &Place, s: mut State, span: Span) {
    if place.via == Via.Index || place.via == Via.Deref {
        const what = if place.via == Via.Index { "an element of a collection" } else {
            "a reference"
        }
        moveError(m, c, "E0602", span, "cannot move out of {what}: use `remove`, `swapRemove`, "
                  + "`mem.replace` or `.clone()`")
        return
    }
    if !place.local || place.via == Via.Raw {
        return   // a temporary, or a raw pointer read (unsafe)
    }
    if m.borrowed[place.part.local] {
        moveError(m, c, "E0602", span, "cannot move out of `{localName(c, place.part.local)}`, "
                  + "which is borrowed: declare the parameter `move`, or call `.clone()`")
        return
    }
    m.movePart(s, &place.part)
}

// `p = value`: `p` holds a value again. A field of a moved struct cannot be
// assigned: the struct as a whole is gone.
fn assignPlace(m: mut Moves, c: mut Checker, e: &Expr, place: &Place, s: mut State,
               span: Span) {
    if !place.local {
        return
    }
    if s.movedPart(&place.part) {   // the old value may be moved out: it is not dropped
        markFlag(c, e.id.0, MOVES)
    }
    const local = place.part.local
    if place.part.fields.len() > 0 && s.moved[local] {
        usePlace(m, c, &Place{local: true, part: Part{local: local, fields: []}, via: Via.Nothing},
                 s, span)
    }
    access(s, &place.part, Access.Write, span)
    if place.part.fields.len() == 0 && place.via == Via.Nothing {
        killHolder(s, local)   // the old value's loans end with it
    }
    if m.refLocal[local] {
        bindLoans(s, local, &m.binding)
    }
    s.initPart(&place.part)
}

// Moving a field out of a value whose type has a `drop` method would leave
// that method a value with a hole (E0602).
fn hasDrop(m: Moves, c: mut Checker, p: Program, e: &Expr, depth: int) bool {
    if depth > 0 {
        return false
    }
    const base = match e.kind {
        ExprKind.Field(b, _, _) => if fieldOf(c, e, &*b) >= 0 { viewType(c, &*b, -1) } else { -1 }
        ExprKind.TupleField(b, _) => viewType(c, &*b, -1)
        _ => -1
    }
    if base < 0 || c.types.kind(base) != TyKind.Adt {
        return false
    }
    const Option.Some(drop) = c.r.names.find("drop") else {
        return false
    }
    if !hasMethod(c, p, c.types.get(base).data, drop) {
        return false
    }
    moveError(m, c, "E0602", e.span, "cannot move out of a field of `{c.typeName(base)}`, "
              + "which has a `drop` method: use `mem.replace`")
    return true
}

// A field moved out of a temporary: the rest of it is not dropped.
fn consumeRoot(m: mut Moves, c: mut Checker, e: &Expr, depth: int) {
    if depth > 0 {
        return
    }
    match e.kind {
        ExprKind.Field(base, _, _) | ExprKind.TupleField(base, _) => {
            consumeRoot(m, c, &*base, derefCount(c, &*base))
        }
        _ => {
            if !isPlaceExpr(c, e) {
                markFlag(c, e.id.0, CONSUMED)
            }
        }
    }
}

fn placeExpr(m: mut Moves, c: mut Checker, p: Program, e: &Expr, depth: int, s: mut State,
             use: Use) {
    const place = placeOf(m, c, p, e, depth, s)
    m.lastLocal = place.local
    if place.local {
        m.lastPlace = place.part.clone()
    } else if place.via == Via.Deref && (use == Use.Assign || use == Use.Mutate) && !s.dead {
        const root = refRoot(m, c, e)   // a write through a reference: `*r = v`, `r.push(v)`
        let kind = Access.BorrowMut
        if use == Use.Assign {
            kind = Access.Write
        }
        if root >= 0 {
            access(s, &Part{local: root, fields: []}, kind, e.span)
        }
    }
    if use == Use.Assign {   // the target of `=`: overwritten, not read
        assignPlace(m, c, e, &place, s, e.span)
        return
    }
    usePlace(m, c, &place, s, e.span)
    const widened = c.unionCoercions[c.module()].get(e.id.0)   // copied before widening
    const ty = if const Option.Some(found) = widened { *found } else { viewType(c, e, depth) }
    const copied = isCopy(c, p, ty)
    if place.local && use != Use.Mutate {   // a `mut` argument is borrowed after the others
        const moves = use == Use.Move && !copied && place.via == Via.Nothing
        access(s, &place.part, if moves { Access.Move } else { Access.Read }, e.span)
    }
    if use != Use.Move || copied {
        return
    }
    if !place.local {
        consumeRoot(m, c, e, depth)
    }
    if hasDrop(m, c, p, e, depth) {
        return   // E0602: a type with a `drop` method is dropped whole
    }
    movePlace(m, c, &place, s, e.span)
    if place.local && place.via == Via.Nothing && depth == 0 {   // for the drop flags
        markFlag(c, e.id.0, MOVES)
    }
}

// `Point{x}`: the variable `x`, moved into the field.
fn shorthand(m: mut Moves, c: mut Checker, p: Program, init: &FieldInit, span: Span,
             s: mut State) {
    const place = match c.res(init.id.0) {
        Res.Local(id) => Place{local: true, part: Part{local: id, fields: []}, via: Via.Nothing}
        _ => noPlace(Via.Nothing)
    }
    usePlace(m, c, &place, s, span)
    const copied = isCopy(c, p, c.typeOf(init.id.0))
    if place.local {
        access(s, &place.part, if copied { Access.Read } else { Access.Move }, span)
    }
    if !copied {
        movePlace(m, c, &place, s, span)
        if place.local {
            markFlag(c, init.id.0, MOVES)
        }
    }
}

// ---------------------------------------------------------------------------
// Calls

fn eachArg(m: mut Moves, c: mut Checker, p: Program, args: &List<Arg>, uses: &List<Use>,
           otherwise: Use, s: mut State) {
    for i in 0..args.len() {
        const use = if i < uses.len() { uses[i] } else { otherwise }
        movesNode(m, c, p, &args[i].value, s, use)
    }
}

/** An argument of a call that borrows a place of a local. */
struct ArgPlace {
    /** The place. */
    part: Part
    /** Borrowed mutably (a `mut` parameter or `mut self`). */
    mutable: bool
    /** The parameter, -1 for `self`. */
    param: int
    /** The argument holds no reference, so a returned borrow borrows the place itself. */
    direct: bool
    /** Where. */
    span: Span
}

fn modeUse(mode: Mode) Use {
    return match mode {
        Mode.Move => Use.Move
        Mode.Mut => Use.Mutate
        _ => Use.Read
    }
}

// Walks an argument; one that borrows a place is added to `places`.
fn argument(m: mut Moves, c: mut Checker, p: Program, arg: &Expr, use: Use, param: int,
            s: mut State, places: mut List<ArgPlace>) {
    m.lastLocal = false
    movesNode(m, c, p, arg, s, use)
    if !m.lastLocal || !isPlaceView(c, arg) || use == Use.Move {
        return
    }
    const ty = viewType(c, arg, -1)
    if use == Use.Read && isCopy(c, p, ty) {
        return   // passed by value
    }
    places.push(ArgPlace{part: m.lastPlace.clone(), mutable: use == Use.Mutate, param,
                         direct: !holdsRef(c, p, ty), span: arg.span})
}

// The parameter a function returns a borrow from (spec 5.6): -1 for
// `self`, -2 for none.
fn borrowSource(c: Checker, p: Program, decl: &FnDecl, callId: int, args: &List<Arg>) int {
    if decl.hasSelf && decl.selfMode != Mode.Move {
        return -1
    }
    if decl.isUnsafe {
        return -2
    }
    let source = -2
    let count = 0
    for i in 0..args.len() {
        const slot = argParam(c, callId, i)
        if slot >= 0 && slot < decl.params.len() {
            const ty = viewType(c, &args[i].value, -1)
            const mode = decl.params[slot].mode
            if holdsRef(c, p, ty) || (mode == Mode.Borrow && !isCopy(c, p, ty)) {
                source = slot
                count += 1
            }
        }
    }
    return if count == 1 { source } else { -2 }
}

// A call of a function: its arguments are evaluated, then its `mut`
// arguments are borrowed mutably; none of them may overlap another one
// (E0700, E0701). A result that holds a reference borrows the source.
fn fnCall(m: mut Moves, c: mut Checker, p: Program, e: &Expr, id: int, receiver: &Expr,
          hasReceiver: bool, args: &List<Arg>, s: mut State) {
    const decl = fnOf(p, c.loc(id))
    let places: List<ArgPlace> = []
    if hasReceiver && decl.hasSelf {
        argument(m, c, p, receiver, modeUse(decl.selfMode), -1, s, places)
    }
    for i in 0..args.len() {
        const slot = argParam(c, e.id.0, i)
        const known = slot >= 0 && slot < decl.params.len()
        const use = if known { modeUse(decl.params[slot].mode) } else { Use.Read }
        const param = if known { slot } else { decl.params.len() + i }   // never a source
        argument(m, c, p, &args[i].value, use, param, s, places)
    }
    if s.dead {
        return
    }
    let reported = false
    for i in 0..places.len() {
        for j in 0..i {
            const a = &places[j]
            const b = &places[i]
            if !reported && (a.mutable || b.mutable) && a.part.overlaps(&b.part) {
                const span = if b.mutable { b.span } else { a.span }
                argumentConflict(m, c, &b.part, !(a.mutable && b.mutable), span)
                reported = true
            }
        }
    }
    for i in 0..places.len() {
        if places[i].mutable {
            access(s, &places[i].part, Access.BorrowMut, places[i].span)
        }
    }
    if !holdsRef(c, p, c.typeOf(e.id.0)) {
        return
    }
    const source = borrowSource(c, p, decl, e.id.0, args)
    for i in 0..places.len() {
        if places[i].param == source && places[i].direct && source > -2 {
            lend(m, &places[i].part, places[i].mutable, places[i].span)
        }
    }
}

fn isVariant(c: mut Checker, p: Program, owner: int, field: &Expr) bool {
    if owner == 0 || c.def(owner).kind != DefKind.Enum || !enumVariants(c, p, owner) {
        return false
    }
    return match field.kind {
        ExprKind.Field(_, name, _) => variantIndex(variantsOf(c, owner), name) >= 0
        _ => false
    }
}

// A call of a name: a function, a constructor or a variant.
fn nameCall(m: mut Moves, c: mut Checker, p: Program, e: &Expr, callee: &Expr,
            args: &List<Arg>, s: mut State) {
    const none: List<Use> = []
    match c.res(callee.id.0) {
        Res.Def(id) => {
            const kind = c.def(id).kind
            if kind == DefKind.Fn {
                fnCall(m, c, p, e, id, callee, false, args, s)
            } else {
                const build = kind == DefKind.Struct || kind == DefKind.Variant
                eachArg(m, c, p, args, &none, if build { Use.Move } else { Use.Read }, s)
            }
        }
        _ => {
            movesNode(m, c, p, callee, s, Use.Read)
            eachArg(m, c, p, args, &none, Use.Read, s)
        }
    }
}

// A call consumes the arguments of `move` parameters (and of constructors
// and variants) and only reads the others.
fn call(m: mut Moves, c: mut Checker, p: Program, e: &Expr, callee: &Expr, args: &List<Arg>,
        s: mut State) {
    const none: List<Use> = []
    match callee.kind {
        ExprKind.Field(baseBox, _, _) => {
            const base = &*baseBox
            if moduleMember(c, callee) {   // `m.f(x)`: a function of an imported module
                nameCall(m, c, p, e, callee, args, s)
                return
            }
            if isVariant(c, p, typeNameOf(c, base), callee) {
                eachArg(m, c, p, args, &none, Use.Move, s)
                return
            }
            if c.fieldCalls[c.module()].get(callee.id.0).isSome() {   // `button.onClick()`
                movesNode(m, c, p, callee, s, Use.Read)
                eachArg(m, c, p, args, &none, Use.Read, s)
                return
            }
            const member = c.members[c.module()][callee.id.0]
            if member > 0 {   // a method, or an associated function
                fnCall(m, c, p, e, member, base, true, args, s)
                return
            }
            movesNode(m, c, p, base, s, Use.Read)   // the built-in methods read
            eachArg(m, c, p, args, &none, Use.Read, s)
        }
        ExprKind.Ident(_) | ExprKind.Generic(_, _) => nameCall(m, c, p, e, callee, args, s)
        _ => {
            movesNode(m, c, p, callee, s, Use.Read)
            eachArg(m, c, p, args, &none, Use.Read, s)
        }
    }
}

// ---------------------------------------------------------------------------

fn each(m: mut Moves, c: mut Checker, p: Program, list: &List<Expr>, s: mut State, use: Use) {
    for i in 0..list.len() {
        movesNode(m, c, p, &list[i], s, use)
    }
}

// `a && b`, `a || b`, `a ?? b`: `b` is evaluated on some paths only.
fn conditional(m: mut Moves, c: mut Checker, p: Program, lhs: &Expr, rhs: &Expr, s: mut State,
               use: Use) {
    movesNode(m, c, p, lhs, s, use)
    let other = s.dup()
    movesNode(m, c, p, rhs, other, use)
    s.join(&other)
}

// `&x`, `&mut x`: a new loan of `x`, carried by the reference.
fn borrow(m: mut Moves, c: mut Checker, p: Program, operand: &Expr, s: mut State,
          mutable: bool) {
    if const ExprKind.Index(base, index) = operand.kind {
        if isRangeIndex(&*index) {   // `&xs[a..b]` and `&mut xs[a..b]` borrow `xs`
            borrow(m, c, p, &*base, s, mutable)
            movesNode(m, c, p, &*index, s, Use.Read)
            return
        }
    }
    if isPlace(c, operand) {
        const place = placeOf(m, c, p, operand, derefCount(c, operand), s)
        usePlace(m, c, &place, s, operand.span)
        if place.local {
            access(s, &place.part, if mutable { Access.BorrowMut } else { Access.Borrow },
                   operand.span)
            if !s.dead {
                lend(m, &place.part, mutable, operand.span)
            }
        } else if !s.dead {   // a reborrow: `&mut *r` borrows `r` itself
            const root = refRoot(m, c, operand)
            if root >= 0 {
                const part = Part{local: root, fields: []}
                access(s, &part, if mutable { Access.BorrowMut } else { Access.Borrow },
                       operand.span)
                lend(m, &part, mutable, operand.span)
            }
        }
    } else {
        movesNode(m, c, p, operand, s, Use.Read)
    }
}

// The local reference a place reached through it belongs to (`*r`,
// `r.field`, `r[i]`), or -1.
fn refRoot(m: Moves, c: Checker, e: &Expr) int {
    return match e.kind {
        ExprKind.Ident(_) => match c.res(e.id.0) {
            Res.Local(id) => if m.refLocal[id] { id } else { -1 }
            _ => -1
        }
        ExprKind.Field(base, _, _) => refRoot(m, c, &*base)
        ExprKind.TupleField(base, _) => refRoot(m, c, &*base)
        ExprKind.Index(base, _) => refRoot(m, c, &*base)
        ExprKind.Unary(op, operand) => if op == Op.Deref { refRoot(m, c, &*operand) } else { -1 }
        _ => -1
    }
}

fn walk(m: mut Moves, c: mut Checker, p: Program, e: &Expr, s: mut State, use: Use) {
    match e.kind {
        ExprKind.Interp(parts, _) => each(m, c, p, &parts, s, Use.Read)
        ExprKind.Unary(op, operand) => {
            if op == Op.Ref || op == Op.RefMut {   // a borrow
                borrow(m, c, p, &*operand, s, op == Op.RefMut)
            } else {
                movesNode(m, c, p, &*operand, s, Use.Read)
            }
        }
        ExprKind.Binary(op, lhs, rhs) => {
            if op == Op.LogicalAnd || op == Op.LogicalOr {
                conditional(m, c, p, &*lhs, &*rhs, s, Use.Read)
            } else if op == Op.Coalesce {
                conditional(m, c, p, &*lhs, &*rhs, s, Use.Move)
            } else {
                movesNode(m, c, p, &*lhs, s, Use.Read)
                movesNode(m, c, p, &*rhs, s, Use.Read)
            }
        }
        ExprKind.Cast(value, _) => movesNode(m, c, p, &*value, s, Use.Read)
        ExprKind.Range(lo, hi, _) => {
            if const Option.Some(l) = lo {
                movesNode(m, c, p, &*l, s, Use.Read)
            }
            if const Option.Some(h) = hi {
                movesNode(m, c, p, &*h, s, Use.Read)
            }
        }
        ExprKind.Index(base, index) => {   // `xs[a..b]` is `xs.slice(a, b)`: both read
            movesNode(m, c, p, &*base, s, Use.Read)
            if const ExprKind.Range(lo, hi, _) = index.kind {
                if const Option.Some(l) = lo {
                    movesNode(m, c, p, &*l, s, Use.Read)
                }
                if const Option.Some(h) = hi {
                    movesNode(m, c, p, &*h, s, Use.Read)
                }
            }
        }
        ExprKind.Call(callee, args) => call(m, c, p, e, &*callee, &args, s)
        ExprKind.Try(inner) => movesNode(m, c, p, &*inner, s, Use.Move)
        ExprKind.Struct(_, fields, base) => {
            for i in 0..fields.len() {
                match fields[i].value {
                    Option.Some(value) => movesNode(m, c, p, &value, s, Use.Move)
                    Option.None => shorthand(m, c, p, &fields[i], e.span, s)
                }
            }
            if const Option.Some(b) = base {
                movesNode(m, c, p, &*b, s, Use.Move)
            }
        }
        ExprKind.Array(elems) | ExprKind.Tuple(elems) => each(m, c, p, &elems, s, Use.Move)
        ExprKind.Repeat(value, count) => {
            movesNode(m, c, p, &*value, s, Use.Read)
            movesNode(m, c, p, &*count, s, Use.Read)
        }
        ExprKind.Variant(_, args, _) => {
            const none: List<Use> = []
            eachArg(m, c, p, &args, &none, Use.Move, s)
        }
        ExprKind.If(_, _, _, _) => movesIf(m, c, p, e, s, use)
        ExprKind.Match(_, _) => movesMatch(m, c, p, e, s, use)
        ExprKind.Block(block) | ExprKind.Unsafe(block) => movesBlock(m, c, p, &block, s, use)
        ExprKind.Closure(params, _, body, isMove) => closure(m, c, p, e, &params, &*body, isMove, s)
        _ => {}   // literals, names of types and functions, constants
    }
}

// A closure (spec 10.3): a `move` closure moves or copies what it captures,
// another borrows it, `&mut` if it modifies it, until its last use. Its
// body is analyzed apart, the captured variables borrowed there.
fn closure(m: mut Moves, c: mut Checker, p: Program, e: &Expr, params: &List<Param>,
           body: &Expr, isMove: bool, s: mut State) {
    const captured = closureCaptures(c, e.id.0)
    let saved: List<bool> = []
    for i in 0..captured.len() {
        saved.push(m.borrowed[captured[i]])
        m.borrowed[captured[i]] = true
    }
    const carry = mem.replace(m.carry, [])
    const loops = mem.replace(m.loops, [])
    let inner = s.dup()
    for i in 0..params.len() {
        initLocal(m, c.localAt(params[i].id.0), inner, true)
    }
    movesNode(m, c, p, body, inner, Use.Move)
    m.carry = carry
    m.loops = loops
    for i in 0..captured.len() {
        m.borrowed[captured[i]] = saved[i]
    }
    for i in 0..captured.len() {
        const local = captured[i]
        const place = Place{local: true, part: Part{local: local, fields: []}, via: Via.Nothing}
        usePlace(m, c, &place, s, e.span)
        if isMove {
            const copied = m.copyLocal[local]
            access(s, &place.part, if copied { Access.Read } else { Access.Move }, e.span)
            if !copied {
                movePlace(m, c, &place, s, e.span)
            }
        } else {
            const mutable = capturedMut(c, e.id.0, local)
            access(s, &place.part, if mutable { Access.BorrowMut } else { Access.Borrow },
                   e.span)
            if !s.dead {
                lend(m, &place.part, mutable, e.span)
            }
        }
    }
}
