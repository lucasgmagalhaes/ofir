/**
 * @module
 * Move analysis of patterns, `if const` and `match` (spec 5.1, 5.5; stage 0:
 * bootstrap/src/sema/moves_match.c): a matched owned value is moved into
 * the bindings that take parts of it by move; the bindings of a matched
 * borrowed place borrow.
 */

import sema.borrows.Access
import sema.borrows.Loan
import sema.borrows.access
import sema.borrows.bindLoans
import sema.borrows.carriedSince
import sema.borrows.dropCarry
import sema.borrows.killHolder
import sema.check.Checker
import sema.check_comptime.knownCondition
import sema.check_dyn.boxesDyn
import sema.check_pattern.testedDyn
import sema.check_union.unionMembers
import sema.moves.MOVES
import sema.moves.Moves
import sema.moves.Part
import sema.moves.State
import sema.moves.Use
import sema.moves.deadState
import sema.moves.markFlag
import sema.moves.movesBlock
import sema.moves_expr.Via
import sema.moves_expr.isPlace
import sema.moves_expr.movesNode
import sema.moves_expr.placeOfNode
import sema.moves_expr.usePlace
import sema.program.Program
import sema.structs.isCopy
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.FieldPattern
import syntax.ast.Pattern
import std.mem
import syntax.ast.PatternKind

fn anyByMove(c: Checker, p: Program, list: &List<Pattern>) bool {
    for i in 0..list.len() {
        if bindsByMove(c, p, &list[i]) {
            return true
        }
    }
    return false
}

// The shorthand field `Point{x}` of a pattern binds `x`, if it is a local.
fn fieldBindsByMove(c: Checker, p: Program, field: &FieldPattern) bool {
    return match field.pattern {
        Option.Some(pattern) => bindsByMove(c, p, &pattern)
        Option.None => c.localAt(field.id.0) >= 0 && !isCopy(c, p, c.typeOf(field.id.0))
    }
}

/**
 * Whether the bindings of a pattern take a non-Copy part of the value by
 * move.
 *
 * @param c the checker
 * @param p the program
 * @param pattern the pattern
 * @returns true if one does
 */
pub fn bindsByMove(c: Checker, p: Program, pattern: &Pattern) bool {
    return match pattern.kind {
        PatternKind.Binding(_, _) => c.localAt(pattern.id.0) >= 0 &&
                          !isCopy(c, p, c.typeOf(pattern.id.0))
        PatternKind.Variant(_, _, args, _) => anyByMove(c, p, &args)
        PatternKind.Tuple(items) => anyByMove(c, p, &items)
        PatternKind.TupleStruct(_, args) => anyByMove(c, p, &args)
        PatternKind.Or(alternatives) => anyByMove(c, p, &alternatives)
        PatternKind.Struct(_, fields, _) => {
            for i in 0..fields.len() {
                if fieldBindsByMove(c, p, &fields[i]) {
                    return true
                }
            }
            false
        }
        // `c: Config` on a `Box<dyn I>` takes the value out of the box; on a
        // union, a member that is not Copy
        PatternKind.TypeTest(_, _) => c.localAt(pattern.id.0) >= 0 &&
                          (boxesDyn(c, c.typeOf(pattern.id.0)) ||
                           (unionMembers(c, c.typeOf(pattern.id.0)).len() > 0 &&
                            !isCopy(c, p, c.members[c.module()][pattern.id.0])))
        _ => false
    }
}

// A binding holds the loans of the value (`m.binding`) if it holds a
// reference, or borrows a non-Copy part of the matched place.
pub fn initLocal(m: mut Moves, local: int, s: mut State, borrowed: bool) {
    if local >= 0 {
        s.initPart(&Part{local: local, fields: []})   // also the parts moved out before
        m.borrowed[local] = borrowed
        killHolder(s, local)
        if m.refLocal[local] || (borrowed && !m.copyLocal[local]) {
            bindLoans(s, local, &m.binding)
        }
    }
}

fn listLocals(c: Checker, list: &List<Pattern>, out: mut List<int>) {
    for i in 0..list.len() {
        patternLocals(c, &list[i], out)
    }
}

/**
 * The locals a pattern binds.
 *
 * @param c the checker
 * @param pattern the pattern
 * @param out gets them
 */
pub fn patternLocals(c: Checker, pattern: &Pattern, out: mut List<int>) {
    match pattern.kind {
        PatternKind.Binding(_, _) | PatternKind.TypeTest(_, _) => {
            const local = c.localAt(pattern.id.0)
            if local >= 0 {
                out.push(local)
            }
        }
        PatternKind.Variant(_, _, args, _) => listLocals(c, &args, out)
        PatternKind.Tuple(items) => listLocals(c, &items, out)
        PatternKind.TupleStruct(_, args) => listLocals(c, &args, out)
        PatternKind.Or(alternatives) => listLocals(c, &alternatives, out)
        PatternKind.Struct(_, fields, _) => {
            for i in 0..fields.len() {
                match fields[i].pattern {
                    Option.Some(inner) => patternLocals(c, &inner, out)
                    Option.None => {
                        const local = c.localAt(fields[i].id.0)
                        if local >= 0 {
                            out.push(local)
                        }
                    }
                }
            }
        }
        _ => {}
    }
}

fn initList(m: mut Moves, c: Checker, list: &List<Pattern>, s: mut State, borrowed: bool) {
    for i in 0..list.len() {
        patternInit(m, c, &list[i], s, borrowed)
    }
}

/**
 * The bindings of a pattern hold values; `borrowed` ones borrow the
 * matched place.
 *
 * @param m the analysis
 * @param c the checker
 * @param pattern the pattern
 * @param s the state, updated
 * @param borrowed whether the bindings borrow
 */
pub fn patternInit(m: mut Moves, c: Checker, pattern: &Pattern, s: mut State, borrowed: bool) {
    match pattern.kind {
        PatternKind.Binding(_, _) | PatternKind.TypeTest(_, _) => {
            initLocal(m, c.localAt(pattern.id.0), s, borrowed)
        }
        PatternKind.Variant(_, _, args, _) => initList(m, c, &args, s, borrowed)
        PatternKind.Tuple(items) => initList(m, c, &items, s, borrowed)
        PatternKind.TupleStruct(_, args) => initList(m, c, &args, s, borrowed)
        PatternKind.Or(alternatives) => initList(m, c, &alternatives, s, borrowed)
        PatternKind.Struct(_, fields, _) => {
            for i in 0..fields.len() {
                match fields[i].pattern {
                    Option.Some(inner) => patternInit(m, c, &inner, s, borrowed)
                    Option.None => initLocal(m, c.localAt(fields[i].id.0), s, borrowed)
                }
            }
        }
        _ => {}
    }
}

// The value matched by `match` or `if const`: an owned place whose parts are
// bound by move is moved; a borrowed place lends its parts to the
// bindings; a temporary is consumed. Returns whether the bindings borrow;
// `m.binding` gets the loans they take.
fn scrutinee(m: mut Moves, c: mut Checker, p: Program, e: &Expr, s: mut State,
             byMove: bool) bool {
    const mark = m.carry.len()
    if !isPlace(c, e) {   // a temporary: consumed if its parts are bound by move
        movesNode(m, c, p, e, s, if byMove { Use.Move } else { Use.Read })
        m.binding = carriedSince(m, mark)
        dropCarry(m, mark)
        return false
    }
    const place = placeOfNode(m, c, p, e, s)
    usePlace(m, c, &place, s, e.span)
    const owned = place.local && place.via == Via.Nothing && !m.borrowed[place.part.local]
    const moves = byMove && owned
    if place.local {
        access(s, &place.part, if moves { Access.Move } else { Access.Read }, e.span)
    }
    if moves {
        m.movePart(s, &place.part)
        markFlag(c, e.id.0, MOVES)
    }
    let loans = carriedSince(m, mark)
    dropCarry(m, mark)
    const borrows = !owned && place.via != Via.Raw
    if borrows && place.local {
        loans.push(Loan{holder: -1, part: place.part.clone(), mutable: false, span: e.span})
    }
    m.binding = loans
    const ty = c.typeOf(e.id.0)
    return borrows || (testedDyn(c, ty) >= 0 && !boxesDyn(c, ty))   // a `&dyn I` lends its value
}

/**
 * `if cond {...} else {...}` and `if const pattern = value {...}`. A
 * `comptime if` whose condition is known walks only the taken branch.
 *
 * @param m the analysis
 * @param c the checker
 * @param p the program
 * @param e the `if`
 * @param s the state, updated
 * @param use how the value of its branches is used
 */
pub fn movesIf(m: mut Moves, c: mut Checker, p: Program, e: &Expr, s: mut State, use: Use) {
    match e.kind {
        ExprKind.If(letPattern, cond, then, otherwise) => {
            const known = knownCondition(c, p, &*cond)
            if known == 1 {
                m.binding = []
                movesBlock(m, c, p, &then, s, use)
                return
            }
            if known == 0 {
                m.binding = []
                if const Option.Some(branch) = otherwise {
                    movesNode(m, c, p, &*branch, s, use)
                }
                return
            }
            let borrowed = false
            match letPattern {
                Option.Some(pattern) => {
                    borrowed = scrutinee(m, c, p, &*cond, s, bindsByMove(c, p, &pattern))
                }
                Option.None => movesNode(m, c, p, &*cond, s, Use.Read)
            }
            let other = s.dup()
            if const Option.Some(pattern) = letPattern {
                patternInit(m, c, &pattern, s, borrowed)
            }
            m.binding = []
            movesBlock(m, c, p, &then, s, use)
            if const Option.Some(branch) = otherwise {
                movesNode(m, c, p, &*branch, other, use)
            }
            s.join(&other)
        }
        _ => {}
    }
}

/**
 * `match value { arms }`.
 *
 * @param m the analysis
 * @param c the checker
 * @param p the program
 * @param e the `match`
 * @param s the state, updated
 * @param use how the value of its arms is used
 */
pub fn movesMatch(m: mut Moves, c: mut Checker, p: Program, e: &Expr, s: mut State, use: Use) {
    match e.kind {
        ExprKind.Match(value, arms) => {
            let byMove = false
            for i in 0..arms.len() {
                byMove = byMove || bindsByMove(c, p, &arms[i].pattern)
            }
            const borrowed = scrutinee(m, c, p, &*value, s, byMove)
            const loans = mem.replace(m.binding, [])
            let result = deadState()
            for i in 0..arms.len() {
                let a = s.dup()
                m.binding = loans.clone()
                patternInit(m, c, &arms[i].pattern, a, borrowed)
                m.binding = []
                if const Option.Some(guard) = arms[i].guard {
                    movesNode(m, c, p, &guard, a, Use.Read)
                }
                movesNode(m, c, p, &arms[i].body, a, use)
                result.join(&a)
            }
            s.replace(result)
        }
        _ => {}
    }
}
