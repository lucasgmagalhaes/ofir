// The tests of `sema.suggest` (docs/design/toolchain.md, Suggestions).

import base.intern.Symbol
import std.testing.assert

fn distance(a: str, b: str) int {
    return editDistance(&bytesOf(a), &bytesOf(b))
}

@test
fn aSwapOfAdjacentBytesCostsOne() {
    assert(distance("cuont", "count") == 1)
    assert(distance("count", "count") == 0)
    assert(distance("", "abc") == 3)
    assert(distance("kitten", "sitting") == 3)
}

@test
fn theLimitIsAThirdOfTheName() {
    let s = Suggestion.new("wdth")   // limit 1
    s.offer(Symbol(3), "width")
    assert(s.best == 3)
    let far = Suggestion.new("wd")   // limit 0: no suggestion
    far.offer(Symbol(3), "w")
    assert(far.best < 0)
    let same = Suggestion.new("width")   // the name itself is not offered
    same.offer(Symbol(3), "width")
    assert(same.best < 0)
}

@test
fn theClosestThenTheFirstInternedWins() {
    let s = Suggestion.new("lenght")
    s.offer(Symbol(5), "lengths")
    s.offer(Symbol(9), "length")
    assert(s.best == 9 && s.distance == 1)
    s.offer(Symbol(2), "lenght_")
    assert(s.best == 2)
}
