/**
 * @module
 * Arrow closures (spec 10.1 and 10.3): their parameter and result types,
 * and the captured variables they modify. Stage 0 has no closures.
 */

import base.span.Span
import sema.check.Checker
import sema.check_stmt.checkBlock
import sema.check_types.resolveType
import sema.expr_check.checkExpr
import sema.expr_check.coerce
import sema.expr_check.requireTypeAt
import sema.program.Program
import sema.send.isSend
import sema.send.isSync
import sema.types.ERROR
import sema.types.FN_BORROWED
import sema.types.FN_OWNED
import sema.types.FN_SEND
import sema.types.TyKind
import sema.types.UNIT
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.Mode
import syntax.ast.Param
import syntax.ast.TypeExpr
import syntax.ast.TypeKind

/**
 * Checks a closure: each parameter's type comes from its annotation or
 * from the function type the context expects (E0336 without either).
 *
 * @param c the checker
 * @param p the program
 * @param e the closure
 * @param params its parameters
 * @param ret its written result type
 * @param body its body
 * @param isMove `move`
 * @param expected the type the context expects, or `ERROR`
 * @returns its type: `move fn(A) R` or `fn(A) R`
 */
pub fn checkClosure(c: mut Checker, p: Program, e: &Expr, params: &List<Param>,
                    ret: &Option<TypeExpr>, body: &Expr, isMove: bool, expected: int) int {
    if c.types.isCFn(expected) {   // C cannot pass an environment (spec 11.3)
        c.error("E0823", e.span, "a closure cannot be a value of type "
                + "`{c.typeName(expected)}`: only an `extern \"C\"` function can")
        return ERROR
    }
    const hinted = c.types.kind(expected) == TyKind.Fn && c.types.get(expected).data != 0 &&
                   c.types.get(expected).args.len() == params.len()
    let types: List<int> = []
    for i in 0..params.len() {
        const param = &params[i]
        if param.mode != Mode.Borrow {
            c.unsupported(param.ty.span, "`mut` and `move` closure parameters are")
        }
        const hint = if hinted { c.types.get(expected).args[i] } else { ERROR }
        let ty = ERROR
        if written(&param.ty) {
            ty = resolveType(c, p, &param.ty)
            if hint != ERROR {
                requireTypeAt(c, param.ty.span, hint, ty)
            }
        } else if hint != ERROR {
            ty = hint
        } else {
            c.error("E0336", param.ty.span, "cannot infer the type of the closure parameter "
                    + "`{c.text(param.name)}`: write its type")
        }
        const local = c.localAt(param.id.0)
        if local >= 0 {
            c.localTypes[local] = ty
        }
        types.push(ty)
    }
    let result = ERROR
    if const Option.Some(t) = *ret {
        result = resolveType(c, p, &t)
    } else if hinted {
        result = c.types.get(expected).inner
    }
    const savedRet = c.ret
    const savedLoops = c.loops.clone()
    const savedLabels = c.loopLabels.clone()
    c.loops = []
    c.loopLabels = []
    c.closures.push(e.id.0)
    c.closureMoves.push(isMove)
    if result != ERROR {
        c.ret = result
        coerce(c, p, body, result)
    } else {
        match body.kind {
            ExprKind.Block(block) => {
                c.ret = UNIT
                checkBlock(c, p, &block, ERROR, false)
                c.setType(body.id.0, UNIT)
                result = UNIT
            }
            _ => {
                c.ret = ERROR
                result = checkExpr(c, p, body, ERROR)
            }
        }
    }
    c.closures.pop()
    c.closureMoves.pop()
    c.loops = savedLoops
    c.loopLabels = savedLabels
    c.ret = savedRet
    const fnExpected = c.types.kind(expected) == TyKind.Fn
    const owned = isMove || (captureCount(c, e.id.0) == 0 && fnExpected &&
                             c.types.get(expected).data & FN_OWNED != 0)
    let data = if owned { FN_OWNED } else { FN_BORROWED }
    if fnExpected && c.types.get(expected).data & FN_SEND != 0 {
        capturesSend(c, p, e, isMove)   // after E0360 it is still `+ Send`, so no E0300 follows
        data = data | FN_SEND
    }
    return c.types.fnValueTypeWith(types, result, data)
}

// E0360 for each capture that cannot go to another task with the closure
// (spec 14.3): a `move` closure moves its captures, which must be `Send`;
// another borrows them, which must be `Sync`.
fn capturesSend(c: mut Checker, p: Program, e: &Expr, isMove: bool) {
    const list = match c.r.tables[c.module()].captures.get(e.id.0) {
        Option.Some(l) => l.clone()
        Option.None => []
    }
    for i in 0..list.len() {
        const ty = c.localTypes[list[i]]
        const fits = if isMove { isSend(c, p, ty) } else { isSync(c, p, ty) }
        if !fits {
            const name = c.text(c.locals[list[i]].name)
            const need = if isMove { "Send" } else { "Sync" }
            c.error("E0360", e.span, "the closure captures `{name}` of type "
                    + "`{c.typeName(ty)}`, which is not `{need}`")
        }
    }
}

// A parameter without a written type has an empty path (the parser's mark).
fn written(t: &TypeExpr) bool {
    return match t.kind {
        TypeKind.Path(segments, _) => segments.len() > 0
        _ => true
    }
}

fn captureCount(c: Checker, closure: int) int {
    return match c.r.tables[c.module()].captures.get(closure) {
        Option.Some(list) => list.len()
        Option.None => 0
    }
}

fn captures(c: Checker, closure: int, local: int) bool {
    return match c.r.tables[c.module()].captures.get(closure) {
        Option.Some(list) => contains(list, local)
        Option.None => false
    }
}

fn contains(list: &List<int>, value: int) bool {
    for i in 0..list.len() {
        if list[i] == value {
            return true
        }
    }
    return false
}

/**
 * Notes that `local` is modified at `span`: E0337 if a `move` closure being
 * checked captured it, else each closure capturing it takes it by `&mut`.
 *
 * @param c the checker
 * @param span the write
 * @param local the local
 */
pub fn noteWrite(c: mut Checker, span: Span, local: int) {
    let k = c.closures.len()
    for k > 0 {
        k -= 1
        const closure = c.closures[k]
        if !captures(c, closure, local) {
            break
        }
        if c.closureMoves[k] {
            c.error("E0337", span, "`{c.text(c.locals[local].name)}` is captured by a `move` "
                    + "closure: captured values are immutable")
            return
        }
        const m = c.module()
        let written: List<int> = match c.capturesMut[m].get(closure) {
            Option.Some(list) => list.clone()
            Option.None => []
        }
        if !contains(&written, local) {
            written.push(local)
        }
        c.capturesMut[m].insert(closure, written)
    }
}

/**
 * The outer locals a closure of the current module captures, in order.
 *
 * @param c the checker
 * @param closure its `NodeId`
 * @returns the locals
 */
pub fn closureCaptures(c: Checker, closure: int) List<int> {
    return match c.r.tables[c.module()].captures.get(closure) {
        Option.Some(list) => list.clone()
        Option.None => []
    }
}

/**
 * Whether a closure of the current module modifies a captured local: it
 * captures it by `&mut`.
 *
 * @param c the checker
 * @param closure its `NodeId`
 * @param local the local
 * @returns true if it does
 */
pub fn capturedMut(c: Checker, closure: int, local: int) bool {
    return match c.capturesMut[c.module()].get(closure) {
        Option.Some(list) => contains(list, local)
        Option.None => false
    }
}

/**
 * Gives a closure argument the `+ Send` its generic callee's parameter
 * wants, which was unknown while the closure was checked (`task.run(move ()
 * => 42)`), after checking its captures (E0360).
 *
 * @param c the checker
 * @param p the program
 * @param e the argument
 * @param found its type
 * @param wanted the parameter's type
 * @returns true if `e` is such a closure
 */
pub fn coerceToSend(c: mut Checker, p: Program, e: &Expr, found: int, wanted: int) bool {
    const isMove = match e.kind {
        ExprKind.Closure(_, _, _, m) => m
        _ => {
            return false
        }
    }
    const f = c.types.get(found).clone()
    const w = c.types.get(wanted).clone()
    if f.kind != TyKind.Fn || w.kind != TyKind.Fn || f.data & FN_SEND != 0 ||
       w.data != (f.data | FN_SEND) || f.inner != w.inner || f.args.len() != w.args.len() {
        return false
    }
    for i in 0..f.args.len() {
        if f.args[i] != w.args[i] {
            return false
        }
    }
    capturesSend(c, p, e, isMove)
    c.setType(e.id.0, wanted)
    return true
}
