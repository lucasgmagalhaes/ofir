/**
 * @module
 * The C symbols a program defines and the libraries it links (spec 11.3,
 * 11.4): `@export("name")` and `@link("name")`.
 */

import sema.check.Checker
import sema.program.Program
import sema.resolve.Resolver
import sema.resolve.findAttribute
import syntax.ast.Attribute
import syntax.ast.ExprKind
import syntax.ast.FnDecl
import syntax.ast.ItemKind

// The string argument of the attribute `name`, if the list has it.
fn stringArg(r: Resolver, attributes: &List<Attribute>, name: str) Option<str> {
    const Option.Some(at) = findAttribute(r, *attributes, name) else {
        return Option.None
    }
    if attributes[at].args.len() != 1 {
        return Option.None
    }
    return match attributes[at].args[0].kind {
        ExprKind.Str(value) => Option.Some(value.clone())
        _ => Option.None
    }
}

/**
 * The symbol of an `extern "C" fn`: its `@export` name, or its own name.
 *
 * @param r the resolver
 * @param decl the function
 * @returns the symbol
 */
pub fn cSymbol(r: Resolver, decl: &FnDecl) str {
    return stringArg(r, &decl.attributes, "export") ?? r.text(decl.name).toOwned()
}

// `main` and the `ofir_` prefix belong to the runtime (spec 11.4).
fn reservedSymbol(symbol: str) bool {
    return symbol == "main" || symbol.startsWith("ofir_")
}

/**
 * Reports E0813 for two `extern "C" fn` that define the same symbol, and
 * E0819 for a symbol of the runtime defined outside std.
 *
 * @param c the checker
 * @param p the program
 */
pub fn checkCSymbols(c: mut Checker, p: Program) {
    let seen: Map<str, bool> = Map.new()
    for m in 0..p.modules.len() {
        const name = &p.modules[m].name
        const inStd = name == "std" || name.startsWith("std.")
        const items = &p.modules[m].module.items
        for i in 0..items.len() {
            match items[i].kind {
                ItemKind.Fn(decl) => {
                    if decl.abi.len() > 0 {
                        const symbol = cSymbol(c.r, &*decl)
                        if !inStd && reservedSymbol(symbol) {
                            c.error("E0819", decl.span,
                                    "the C symbol `{symbol}` is reserved for the runtime")
                        } else if seen.contains(symbol) {
                            c.error("E0813", decl.span, "the C symbol `{symbol}` is defined twice")
                        } else {
                            const _ = seen.insert(symbol, true)
                        }
                    }
                }
                _ => {}
            }
        }
    }
}

/**
 * The libraries of the `@link` attributes of a program's `extern` blocks,
 * each once, in the order they are declared.
 *
 * @param r the resolver
 * @param p the program
 * @returns their names
 */
pub fn linkLibraries(r: Resolver, p: Program) List<str> {
    let names: List<str> = []
    for m in 0..p.modules.len() {
        const items = &p.modules[m].module.items
        for i in 0..items.len() {
            const isExtern = match items[i].kind {
                ItemKind.Extern(_, _) => true
                _ => false
            }
            if !isExtern {
                continue
            }
            if const Option.Some(name) = stringArg(r, &items[i].attributes, "link") {
                let twice = false
                for k in 0..names.len() {
                    twice = twice || names[k] == name
                }
                if !twice {
                    names.push(name)
                }
            }
        }
    }
    return names
}
