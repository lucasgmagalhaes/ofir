/**
 * @module
 * Types (stage 0: bootstrap/src/sema/types.c): hash-consed, so that each
 * distinct type exists once and type equality compares two ids. A type id
 * is an `int`, its index in the `TypeTable`; the built-in types have the
 * fixed ids `ERROR` to `STR`.
 */

import std.mem

/**
 * The forms of a type.
 */
pub copy enum TyKind {
    /** After a reported error: compatible with every type. */
    Error
    /** `()` */
    Unit
    /** `!` */
    Never
    /** `bool` */
    Bool
    /** `i8` to `u64`; `data` is the `IntKind` number (0-3 signed, 4-7 unsigned). */
    Int
    /** `f32`, `f64`; `data` is the width. */
    Float
    /** `str` */
    Str
    /** `&T`, `&mut T`; `data` is 1 when mutable. */
    Ref
    /** `*T`, `*mut T`; `data` is 1 when mutable. */
    Ptr
    /** `[T]` */
    Slice
    /**
     * `[T; N]`; `data` is the length, or -1 when it is a const parameter,
     * then the only one of `args`.
     */
    Array
    /** `(A, B)` */
    Tuple
    /**
     * `fn(A, B) R`; `inner` is the result, `data` is 0 for a function's
     * signature, `FN_BORROWED` or `FN_OWNED` for a written type.
     */
    Fn
    /** A struct or an enum; `data` is its `DefId`, `args` its type arguments. */
    Adt
    /** A type parameter; `data` is its index, `inner` its name (a symbol). */
    Param
    /** `dyn I`; `data` is the interface's `DefId`, `args` its type arguments. */
    Dyn
    /**
     * A key type (spec 16.1). A single key has its name's symbol in `data`;
     * any other set has `data` -1 and its single keys in `args`, ordered by
     * symbol.
     */
    Key
    /**
     * `keyof T` of a type with a parameter, resolved by `subst` (spec 16.2);
     * `inner` is `T`, `data` the module that wrote it.
     */
    KeyOf
    /** `T[K]` of types with a parameter, resolved by `subst`; `inner` is `T`, `args` `[K]`. */
    Index
    /** The argument of a const parameter (spec 8.7); `data` is the integer. */
    Value
    /**
     * A mapped type alias applied to types with a parameter (spec 16.4):
     * `data` is the alias, `args` its arguments; a struct once they are known.
     */
    Mapped
}

/**
 * A type.
 */
pub struct Ty {
    /** Its form. */
    pub kind: TyKind
    /** What `kind` says. */
    pub data: int
    /** The element of a reference, pointer, slice or array; a function's result. */
    pub inner: int
    /** A tuple's elements, a function's parameters, an ADT's type arguments. */
    pub args: List<int>
    /** A type parameter occurs in it. */
    pub hasParam: bool
}

/** The error type. */
pub const ERROR: int = 0
/** `()` */
pub const UNIT: int = 1
/** `!` */
pub const NEVER: int = 2
/** `bool` */
pub const BOOL: int = 3
/** `i8` */
pub const I8: int = 4
/** `i16` */
pub const I16: int = 5
/** `i32` */
pub const I32: int = 6
/** `i64` and `int` */
pub const I64: int = 7
/** `u8` */
pub const U8: int = 8
/** `u16` */
pub const U16: int = 9
/** `u32` */
pub const U32: int = 10
/** `u64` and `uint` */
pub const U64: int = 11
/** `f32` */
pub const F32: int = 12
/** `f64` and `float` */
pub const F64: int = 13
/** `str` */
pub const STR: int = 14
/** The number of built-in types. */
pub const BUILTIN_COUNT: int = 15
/** `data` of a written `fn(A) R`: a borrowed function value. */
pub const FN_BORROWED: int = 1
/** `data` of a written `move fn(A) R`: an owned function value. */
pub const FN_OWNED: int = 2
/** Added to `data` by `+ Send`: the function value may move to another task (spec 14.3). */
pub const FN_SEND: int = 4

/**
 * The fields of a struct, for `keyof T` and `T[K]` after substitution.
 */
pub struct KeyFields {
    /** The module that declares it. */
    pub module: int
    /** A tuple struct: its keys are its indices. */
    pub isTuple: bool
    /** The names' symbols. */
    pub names: List<int>
    /** The types, with the struct's own type parameters. */
    pub types: List<int>
    /** Whether each is `pub`. */
    pub pubs: List<bool>
}

/**
 * The table of every type of a program.
 */
pub struct TypeTable {
    types: List<Ty>
    slots: List<int>   // open addressing: type id + 1, 0 when empty
    fields: List<Option<KeyFields>>   // by `DefId`
    indexNames: List<int>   // the symbols of `0`, `1`, ...: tuple keys
    expanded: List<int>   // by type id: the struct of a known `Mapped`, or 0
    pending: List<int>   // the known `Mapped` types with no struct yet

    /**
     * A table with the built-in types, in the order of their ids.
     *
     * @returns the table
     */
    pub fn new() TypeTable {
        let table = TypeTable{types: [], slots: List.filled(0, 256), fields: [],
                              indexNames: [], expanded: [], pending: []}
        table.intern(TyKind.Error, 0, 0, [])
        table.intern(TyKind.Unit, 0, 0, [])
        table.intern(TyKind.Never, 0, 0, [])
        table.intern(TyKind.Bool, 0, 0, [])
        for k in 0..8 {
            table.intern(TyKind.Int, k, 0, [])
        }
        table.intern(TyKind.Float, 32, 0, [])
        table.intern(TyKind.Float, 64, 0, [])
        table.intern(TyKind.Str, 0, 0, [])
        assert(table.types.len() == BUILTIN_COUNT)
        return table
    }

    /**
     * A type.
     *
     * @param id its id
     * @returns the type
     */
    pub fn get(self, id: int) &Ty {
        return &self.types[id]
    }

    /**
     * The form of a type.
     *
     * @param id its id
     * @returns its kind
     */
    pub fn kind(self, id: int) TyKind {
        return self.types[id].kind
    }

    /**
     * The number of types.
     *
     * @returns the count
     */
    pub fn len(self) int {
        return self.types.len()
    }

    /**
     * The id of a type, created the first time. `&str` is `str` in stage 0:
     * a view whose capacity is 0.
     *
     * @param kind its form
     * @param data its data
     * @param inner its inner type, or 0
     * @param args its arguments
     * @returns its id
     */
    pub fn intern(mut self, kind: TyKind, data: int, inner: int, args: [int]) int {
        if kind == TyKind.Ref && data == 0 && inner == STR {
            return STR
        }
        if (self.types.len() + 1) * 2 > self.slots.len() {
            self.rehash()
        }
        const mask = self.slots.len() - 1
        let i = hashOf(kind, data, inner, args) & mask
        for self.slots[i] != 0 {
            const id = self.slots[i] - 1
            if same(&self.types[id], kind, data, inner, args) {
                return id
            }
            i = (i + 1) & mask
        }
        const nested = kind == TyKind.Ref || kind == TyKind.Ptr || kind == TyKind.Slice ||
                       kind == TyKind.Array || kind == TyKind.Fn || kind == TyKind.KeyOf ||
                       kind == TyKind.Index
        let hasParam = kind == TyKind.Param || (nested && self.types[inner].hasParam)
        let copied: List<int> = []
        for a in 0..args.len() {
            hasParam = hasParam || self.types[args[a]].hasParam
            copied.push(args[a])
        }
        self.slots[i] = self.types.len() + 1
        self.types.push(Ty{kind, data, inner, args: copied, hasParam})
        return self.types.len() - 1
    }

    fn rehash(mut self) {
        const size = self.slots.len() * 2
        let slots = List.filled(0, size)
        for id in 0..self.types.len() {
            const t = &self.types[id]
            let i = hashOf(t.kind, t.data, t.inner, t.args) & (size - 1)
            for slots[i] != 0 {
                i = (i + 1) & (size - 1)
            }
            slots[i] = id + 1
        }
        self.slots = slots
    }

    /**
     * `&T` or `&mut T`.
     *
     * @param inner T
     * @param mutable whether it is `&mut`
     * @returns the reference type
     */
    pub fn ref(mut self, inner: int, mutable: bool) int {
        return self.intern(TyKind.Ref, if mutable { 1 } else { 0 }, inner, [])
    }

    /**
     * `*T` or `*mut T`.
     *
     * @param inner T
     * @param mutable whether it is `*mut`
     * @returns the pointer type
     */
    pub fn ptr(mut self, inner: int, mutable: bool) int {
        return self.intern(TyKind.Ptr, if mutable { 1 } else { 0 }, inner, [])
    }

    /**
     * A tuple; `()` without elements.
     *
     * @param elems the element types
     * @returns the tuple type
     */
    pub fn tuple(mut self, elems: [int]) int {
        return if elems.len() == 0 { UNIT } else { self.intern(TyKind.Tuple, 0, 0, elems) }
    }

    /**
     * A function type.
     *
     * @param params the parameter types
     * @param ret the result type
     * @returns the function type
     */
    pub fn fnType(mut self, params: [int], ret: int) int {
        return self.intern(TyKind.Fn, 0, ret, params)
    }

    /**
     * The type of a function value, as written: `fn(A) R` (borrowed,
     * second-class, spec 10.2) or `move fn(A) R` (owned). Both print as
     * `fn(A) R`, as in stage 0.
     *
     * @param params the parameter types
     * @param ret the result type
     * @param owned `move fn`
     * @returns the type
     */
    pub fn fnValueType(mut self, params: [int], ret: int, owned: bool) int {
        return self.intern(TyKind.Fn, if owned { FN_OWNED } else { FN_BORROWED }, ret, params)
    }

    /**
     * A function value type with `data` given: `FN_BORROWED` or `FN_OWNED`,
     * plus `FN_SEND` for `+ Send`.
     *
     * @param params its parameters
     * @param ret its result
     * @param data its `data`
     * @returns the type
     */
    pub fn fnValueTypeWith(mut self, params: [int], ret: int, data: int) int {
        return self.intern(TyKind.Fn, data, ret, params)
    }

    /**
     * A struct or enum with type arguments.
     *
     * @param def its `DefId`
     * @param args its type arguments
     * @returns the type
     */
    pub fn adt(mut self, def: int, args: [int]) int {
        return self.intern(TyKind.Adt, def, 0, args)
    }

    /**
     * `dyn I`.
     *
     * @param iface the interface's `DefId`
     * @param args its type arguments
     * @returns the type
     */
    pub fn dynOf(mut self, iface: int, args: [int]) int {
        return self.intern(TyKind.Dyn, iface, 0, args)
    }

    /**
     * The key type of a set of names: the single key for one name.
     *
     * @param names the names' symbols, in any order, maybe repeated
     * @returns the type
     */
    pub fn keys(mut self, names: [int]) int {
        let sorted: List<int> = []
        for i in 0..names.len() {
            let at = 0
            for at < sorted.len() && sorted[at] < names[i] {
                at += 1
            }
            if at == sorted.len() {
                sorted.push(names[i])
            } else if sorted[at] != names[i] {
                sorted.insert(at, names[i])
            }
        }
        if sorted.len() == 1 {
            return self.intern(TyKind.Key, sorted[0], 0, [])
        }
        let singles: List<int> = []
        for i in 0..sorted.len() {
            singles.push(self.intern(TyKind.Key, sorted[i], 0, []))
        }
        return self.intern(TyKind.Key, -1, 0, singles)
    }

    /**
     * The names of a key type.
     *
     * @param ty a key type
     * @returns their symbols, ordered
     */
    pub fn keyNames(self, ty: int) List<int> {
        const t = &self.types[ty]
        let names: List<int> = []
        if t.data >= 0 {
            names.push(t.data)
        } else {
            for i in 0..t.args.len() {
                names.push(self.types[t.args[i]].data)
            }
        }
        return names
    }

    /**
     * Whether a type is a pointer to a `dyn` value: a fat pointer.
     *
     * @param ty a type
     * @returns true for `&dyn I`, `*dyn I` and their `mut` forms
     */
    pub fn isFat(self, ty: int) bool {
        const t = &self.types[ty]
        return (t.kind == TyKind.Ref || t.kind == TyKind.Ptr) &&
               self.types[t.inner].kind == TyKind.Dyn
    }

    /**
     * The type parameter number `index` of a generic declaration: those of
     * a type come first, then those of its method.
     *
     * @param index its position
     * @param name its name's symbol, for messages
     * @returns the type
     */
    pub fn param(mut self, index: int, name: int) int {
        return self.intern(TyKind.Param, index, name, [])
    }

    /**
     * The argument `n` of a const parameter (spec 8.7).
     *
     * @param n the integer
     * @returns its type
     */
    pub fn value(mut self, n: int) int {
        return self.intern(TyKind.Value, n, 0, [])
    }

    /**
     * `ty` with each type parameter `i` replaced by `args[i]` (spec 8.6).
     *
     * @param ty a type
     * @param args the arguments
     * @returns the substituted type
     */
    pub fn subst(mut self, ty: int, args: [int]) int {
        if !self.types[ty].hasParam || args.len() == 0 {
            return ty
        }
        const kind = self.types[ty].kind
        const data = self.types[ty].data
        if kind == TyKind.Param {
            return if data < args.len() { args[data] } else { ty }
        }
        let inner = self.types[ty].inner
        const keepsInner = kind == TyKind.Tuple || kind == TyKind.Adt || kind == TyKind.Dyn
        if !keepsInner && kind != TyKind.Mapped {
            inner = self.subst(inner, args)   // ref, ptr, slice, array, fn
        }
        let items: List<int> = []
        for i in 0..self.types[ty].args.len() {
            const arg = self.types[ty].args[i]
            items.push(self.subst(arg, args))
        }
        if kind == TyKind.KeyOf && !self.types[inner].hasParam {
            return self.keyofFields(inner, data)
        }
        if kind == TyKind.Index && !self.types[inner].hasParam && !self.types[items[0]].hasParam {
            return self.indexFields(inner, items[0])
        }
        if kind == TyKind.Array && items.len() == 1 && self.types[items[0]].kind == TyKind.Value {
            return self.intern(kind, self.types[items[0]].data, inner, [])   // `[T; N]`
        }
        if kind == TyKind.Array && items.len() == 1 && !self.types[items[0]].hasParam {
            return ERROR   // a type given for `N`: E0362
        }
        const result = self.intern(kind, data, inner, items)
        if kind == TyKind.Mapped && !self.types[result].hasParam {
            if result < self.expanded.len() && self.expanded[result] != 0 {
                return self.expanded[result]
            }
            self.pending.push(result)
        }
        return result
    }

    /**
     * Records the struct of a `Mapped` type with no parameter: `subst`
     * returns it from now on.
     *
     * @param mapped the `Mapped` type
     * @param adt its struct type
     */
    pub fn setExpanded(mut self, mapped: int, adt: int) {
        for self.expanded.len() <= mapped {
            self.expanded.push(0)
        }
        self.expanded[mapped] = adt
    }

    /**
     * The struct of a `Mapped` type, or 0 before `setExpanded`.
     *
     * @param mapped the `Mapped` type
     * @returns the struct type, or 0
     */
    pub fn expandedOf(self, mapped: int) int {
        return if mapped < self.expanded.len() { self.expanded[mapped] } else { 0 }
    }

    /**
     * Whether `subst` made `Mapped` types known since the last `takePending`.
     *
     * @returns true when there are some
     */
    pub fn hasPending(self) bool {
        return self.pending.len() > 0
    }

    /**
     * The `Mapped` types `subst` made known since the last call.
     *
     * @returns them, in order
     */
    pub fn takePending(mut self) List<int> {
        return mem.replace(self.pending, [])
    }

    /**
     * Records the fields of a struct, for `keyof T` and `T[K]` after
     * substitution.
     *
     * @param def its `DefId`
     * @param fields its fields
     */
    pub fn setFields(mut self, def: int, fields: move KeyFields) {
        for self.fields.len() <= def {
            self.fields.push(Option.None)
        }
        self.fields[def] = Option.Some(fields)
    }

    /**
     * Records the symbols of the tuple keys `.0`, `.1`, ...
     *
     * @param names their symbols, in order
     */
    pub fn setIndexNames(mut self, names: move List<int>) {
        self.indexNames = names
    }

    /**
     * Whether `setIndexNames` was called.
     *
     * @returns true once the tuple keys are known
     */
    pub fn hasIndexNames(self) bool {
        return self.indexNames.len() > 0
    }

    // The first `count` tuple keys, or ERROR.
    fn indexKeys(mut self, count: int) int {
        if count > self.indexNames.len() {
            return ERROR
        }
        let names: List<int> = []
        for i in 0..count {
            names.push(self.indexNames[i])
        }
        return self.keys(names)
    }

    // `keyof ty` written in `module`, or ERROR.
    fn keyofFields(mut self, ty: int, module: int) int {
        const kind = self.types[ty].kind
        if kind == TyKind.Tuple {
            return self.indexKeys(self.types[ty].args.len())
        }
        const def = self.types[ty].data
        if kind != TyKind.Adt || def >= self.fields.len() {
            return ERROR
        }
        let names: List<int> = []
        match self.fields[def] {
            Option.Some(f) => {
                if f.isTuple {
                    return self.indexKeys(f.types.len())
                }
                for i in 0..f.names.len() {
                    if f.module == module || f.pubs[i] {
                        names.push(f.names[i])
                    }
                }
            }
            Option.None => {
                return ERROR
            }
        }
        return self.keys(names)
    }

    /**
     * The type of the fields `key` of `base`, which must all be the same.
     *
     * @param base a struct or tuple type
     * @param key a key type
     * @returns the type, or ERROR
     */
    pub fn indexFields(mut self, base: int, key: int) int {
        if self.types[key].kind != TyKind.Key {
            return ERROR
        }
        const names = self.keyNames(key)
        let result = ERROR
        for i in 0..names.len() {
            const field = self.fieldOf(base, names[i])
            if field == ERROR || (i > 0 && field != result) {
                return ERROR
            }
            result = field
        }
        return result
    }

    // The type of field `name` of `base`, or ERROR.
    fn fieldOf(mut self, base: int, name: int) int {
        const kind = self.types[base].kind
        if kind == TyKind.Tuple {
            const at = self.indexOf(name)
            return if at >= 0 && at < self.types[base].args.len() {
                self.types[base].args[at]
            } else {
                ERROR
            }
        }
        const def = self.types[base].data
        if kind != TyKind.Adt || def >= self.fields.len() {
            return ERROR
        }
        let field = ERROR
        match self.fields[def] {
            Option.Some(f) => {
                for i in 0..f.types.len() {
                    const tupleNamed = f.isTuple && self.indexOf(name) == i
                    const named = tupleNamed || (!f.isTuple && f.names[i] == name)
                    if named {
                        field = f.types[i]
                    }
                }
            }
            Option.None => {}
        }
        const args = self.types[base].args.clone()
        return self.subst(field, args)
    }

    /**
     * The position of the field of a single key, after substitution.
     *
     * @param base a struct or tuple type
     * @param key a single key
     * @returns the field's position, or -1
     */
    pub fn keyPosition(self, base: int, key: int) int {
        const name = self.types[key].data
        const kind = self.types[base].kind
        if kind == TyKind.Tuple {
            return self.indexOf(name)
        }
        const def = self.types[base].data
        if kind != TyKind.Adt || def >= self.fields.len() {
            return -1
        }
        return match self.fields[def] {
            Option.Some(f) => if f.isTuple {
                self.indexOf(name)
            } else {
                position(&f.names, name)
            }
            Option.None => -1
        }
    }

    // The position of a tuple key, or -1.
    fn indexOf(self, name: int) int {
        for i in 0..self.indexNames.len() {
            if self.indexNames[i] == name {
                return i
            }
        }
        return -1
    }

    /**
     * How deeply types nest: 1 for `int`, 2 for `Pair<int, int>`.
     *
     * @param ty a type
     * @returns its depth
     */
    pub fn depth(self, ty: int) int {
        const t = &self.types[ty]
        const nested = t.kind == TyKind.Ref || t.kind == TyKind.Ptr || t.kind == TyKind.Slice ||
                       t.kind == TyKind.Array || t.kind == TyKind.Fn || t.kind == TyKind.KeyOf ||
                       t.kind == TyKind.Index
        let deepest = if nested { self.depth(t.inner) } else { 0 }
        for i in 0..t.args.len() {
            const d = self.depth(t.args[i])
            if d > deepest {
                deepest = d
            }
        }
        return deepest + 1
    }

    /**
     * Whether a type is an integer type.
     *
     * @param ty a type
     * @returns true for `i8` to `u64`
     */
    pub fn isInteger(self, ty: int) bool {
        return self.types[ty].kind == TyKind.Int
    }

    /**
     * Whether a type is an integer or float type.
     *
     * @param ty a type
     * @returns true for numbers
     */
    pub fn isNumeric(self, ty: int) bool {
        const kind = self.types[ty].kind
        return kind == TyKind.Int || kind == TyKind.Float
    }
}

fn position(names: &List<int>, name: int) int {
    for i in 0..names.len() {
        if names[i] == name {
            return i
        }
    }
    return -1
}

/**
 * The position of a kind in `TyKind`, for ordered comparisons.
 *
 * @param kind a kind
 * @returns its number
 */
pub fn kindNumber(kind: TyKind) int {
    return match kind {
        TyKind.Error => 0
        TyKind.Unit => 1
        TyKind.Never => 2
        TyKind.Bool => 3
        TyKind.Int => 4
        TyKind.Float => 5
        TyKind.Str => 6
        TyKind.Ref => 7
        TyKind.Ptr => 8
        TyKind.Slice => 9
        TyKind.Array => 10
        TyKind.Tuple => 11
        TyKind.Fn => 12
        TyKind.Adt => 13
        TyKind.Param => 14
        TyKind.Dyn => 15
        TyKind.Key => 16
        TyKind.KeyOf => 17
        TyKind.Index => 18
        TyKind.Value => 19
        TyKind.Mapped => 20
    }
}

fn mix(h: int, value: int) int {
    return (h ^ (value * 40503 + 2654435769)) * 31 % 1000000007
}

fn hashOf(kind: TyKind, data: int, inner: int, args: [int]) int {
    let h = mix(kindNumber(kind), data)
    h = mix(h, inner)
    for i in 0..args.len() {
        h = mix(h, args[i])
    }
    return if h < 0 { -h } else { h }
}

fn same(t: &Ty, kind: TyKind, data: int, inner: int, args: [int]) bool {
    if t.kind != kind || t.data != data || t.inner != inner || t.args.len() != args.len() {
        return false
    }
    for i in 0..args.len() {
        if t.args[i] != args[i] {
            return false
        }
    }
    return true
}

/**
 * The field step of `value[key]` with a key parameter (spec 16.2), chosen
 * for each instance: a negative number that names the type `T[K]`.
 *
 * @param ty the type `T[K]`
 * @returns the step
 */
pub fn keyField(ty: int) int {
    return -(ty + 2)
}

/**
 * The type `T[K]` a field step of `keyField` names, or -1 for other steps.
 *
 * @param step a field step
 * @returns the type, or -1
 */
pub fn keyFieldType(step: int) int {
    return if step < -2 { -step - 2 } else { -1 }
}
