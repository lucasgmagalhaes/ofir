/**
 * @module
 * Interfaces as parameter types (spec 9.6, ADR 0029): an interface named
 * in the type of a function's or a method's parameter declares an
 * anonymous type parameter bound by it, so `fn draw(s: Shape)` is
 * `fn draw<S: Shape>(s: S)`. The pass rewrites the tree after the
 * resolver and before the checker, which then sees ordinary type
 * parameters. An anonymous parameter is named `Shape 1`: the space keeps
 * it apart from every name a program can write, and messages print the
 * part before it (`Checker.paramText`).
 */

import base.intern.Symbol
import sema.def.DefKind
import sema.program.Program
import sema.resolve.Resolver
import syntax.ast.FnDecl
import syntax.ast.Item
import syntax.ast.ItemKind
import syntax.ast.TypeExpr
import syntax.ast.TypeKind
import syntax.ast.WherePred

/**
 * Rewrites every function and method of the program whose parameters
 * name an interface.
 *
 * @param p the program, rewritten
 * @param r the resolver, whose interner gets the new names
 */
pub fn desugarInterfaceParams(p: mut Program, r: mut Resolver) {
    for m in 0..p.modules.len() {
        r.scope.useModule(m)
        for i in 0..p.modules[m].module.items.len() {
            const kind = rewrittenItem(r, &p.modules[m].module.items[i])
            if const Option.Some(k) = kind {
                p.modules[m].module.items[i].kind = k
            }
        }
    }
    r.scope.useModule(r.current)
}

// The item with its functions rewritten, if one of them changes.
fn rewrittenItem(r: mut Resolver, item: &Item) Option<ItemKind> {
    const none: List<Symbol> = []
    return match item.kind {
        ItemKind.Fn(decl) => {
            if !declNeeds(r, &*decl, &none) {
                return Option.None
            }
            Option.Some(ItemKind.Fn(Box.new(rewrittenDecl(r, &*decl, &none))))
        }
        ItemKind.Struct(isCopy, isRef, isTuple, typeParams, fields, methods) => {
            if !anyNeeds(r, &methods, &typeParams) {
                return Option.None
            }
            Option.Some(ItemKind.Struct(isCopy, isRef, isTuple, typeParams.clone(), fields.clone(),
                                        rewrittenList(r, &methods, &typeParams)))
        }
        ItemKind.Enum(isCopy, typeParams, variants, methods) => {
            if !anyNeeds(r, &methods, &typeParams) {
                return Option.None
            }
            Option.Some(ItemKind.Enum(isCopy, typeParams.clone(), variants.clone(),
                                      rewrittenList(r, &methods, &typeParams)))
        }
        ItemKind.Interface(typeParams, embeds, methods) => {
            if !anyNeeds(r, &methods, &typeParams) {
                return Option.None
            }
            Option.Some(ItemKind.Interface(typeParams.clone(), embeds.clone(),
                                           rewrittenList(r, &methods, &typeParams)))
        }
        _ => Option.None
    }
}

fn anyNeeds(r: Resolver, decls: &List<FnDecl>, owner: &List<Symbol>) bool {
    for i in 0..decls.len() {
        if declNeeds(r, &decls[i], owner) {
            return true
        }
    }
    return false
}

fn rewrittenList(r: mut Resolver, decls: &List<FnDecl>, owner: &List<Symbol>) List<FnDecl> {
    let out: List<FnDecl> = []
    for i in 0..decls.len() {
        if declNeeds(r, &decls[i], owner) {
            out.push(rewrittenDecl(r, &decls[i], owner))
        } else {
            out.push(decls[i].clone())
        }
    }
    return out
}

// Whether a parameter of `decl` names an interface.
fn declNeeds(r: Resolver, decl: &FnDecl, owner: &List<Symbol>) bool {
    for i in 0..decl.params.len() {
        if typeNeeds(r, &decl.params[i].ty, owner, &decl.typeParams) {
            return true
        }
    }
    return false
}

fn rewrittenDecl(r: mut Resolver, decl: &FnDecl, owner: &List<Symbol>) FnDecl {
    let out = decl.clone()
    const named = decl.typeParams.clone()
    for i in 0..decl.params.len() {
        const ty = rewrittenType(r, &decl.params[i].ty, owner, &named, out)
        out.params[i].ty = ty
    }
    return out
}

// The interface a type names alone (`Shape`, `shapes.Shape`): its `DefId`,
// or 0. A type parameter of the same name hides it.
fn interfaceNamed(r: Resolver, t: &TypeExpr, owner: &List<Symbol>, named: &List<Symbol>) int {
    return match t.kind {
        TypeKind.Path(segments, _) => {
            if segments.len() == 1 && (has(owner, segments[0]) || has(named, segments[0])) {
                return 0
            }
            let id = r.scope.module(segments[0])
            if segments.len() == 2 && id != 0 && r.defs[id].kind == DefKind.Module {
                id = r.scope.moduleIn(r.defs[id].target, segments[1])
            } else if segments.len() != 1 {
                return 0
            }
            const isInterface = id != 0 && r.defs[id].kind == DefKind.Interface
            if !isInterface || isAnyDef(r, id) {   // `v: any` is a `dyn` parameter
                return 0
            }
            id
        }
        _ => 0
    }
}

fn has(names: &List<Symbol>, name: Symbol) bool {
    for i in 0..names.len() {
        if names[i].0 == name.0 {
            return true
        }
    }
    return false
}

// Whether `t` names an interface where a parameter type may: anywhere but in
// a `fn(...)` type and after `dyn`.
fn typeNeeds(r: Resolver, t: &TypeExpr, owner: &List<Symbol>, named: &List<Symbol>) bool {
    if interfaceNamed(r, t, owner, named) != 0 {
        return true
    }
    return match t.kind {
        TypeKind.Path(_, args) => {
            for i in 0..args.len() {
                if typeNeeds(r, &args[i], owner, named) {
                    return true
                }
            }
            false
        }
        TypeKind.Ref(_, inner) => typeNeeds(r, &*inner, owner, named)
        TypeKind.Ptr(_, inner) => typeNeeds(r, &*inner, owner, named)
        TypeKind.Slice(elem) => typeNeeds(r, &*elem, owner, named)
        TypeKind.Array(elem, _) => typeNeeds(r, &*elem, owner, named)
        TypeKind.Optional(inner) => typeNeeds(r, &*inner, owner, named)
        TypeKind.Tuple(items) => {
            for i in 0..items.len() {
                if typeNeeds(r, &items[i], owner, named) {
                    return true
                }
            }
            false
        }
        _ => false
    }
}

// `t` with each interface it names replaced by a new type parameter of `decl`.
fn rewrittenType(r: mut Resolver, t: &TypeExpr, owner: &List<Symbol>, named: &List<Symbol>,
                 decl: mut FnDecl) TypeExpr {
    const iface = interfaceNamed(r, t, owner, named)
    if iface != 0 {
        const text = r.names.name(r.defs[iface].name)
        const param = r.names.intern("{text} {decl.typeParams.len() + 1}")
        decl.typeParams.push(param)
        decl.bounds.push(WherePred{ty: pathTo(param, t), bounds: [t.clone()], span: t.span,
                                   isConst: false})
        return pathTo(param, t)
    }
    return match t.kind {
        TypeKind.Path(segments, args) => {
            let list: List<TypeExpr> = []
            for i in 0..args.len() {
                const arg = rewrittenType(r, &args[i], owner, named, decl)
                list.push(arg)
            }
            TypeExpr{kind: TypeKind.Path(segments.clone(), list), span: t.span}
        }
        TypeKind.Ref(mutable, inner) => {
            const target = rewrittenType(r, &*inner, owner, named, decl)
            TypeExpr{kind: TypeKind.Ref(mutable, Box.new(target)), span: t.span}
        }
        TypeKind.Ptr(mutable, inner) => {
            const target = rewrittenType(r, &*inner, owner, named, decl)
            TypeExpr{kind: TypeKind.Ptr(mutable, Box.new(target)), span: t.span}
        }
        TypeKind.Slice(elem) => {
            const item = rewrittenType(r, &*elem, owner, named, decl)
            TypeExpr{kind: TypeKind.Slice(Box.new(item)), span: t.span}
        }
        TypeKind.Array(elem, len) => {
            const item = rewrittenType(r, &*elem, owner, named, decl)
            TypeExpr{kind: TypeKind.Array(Box.new(item), len.clone()), span: t.span}
        }
        TypeKind.Optional(inner) => {
            const target = rewrittenType(r, &*inner, owner, named, decl)
            TypeExpr{kind: TypeKind.Optional(Box.new(target)), span: t.span}
        }
        TypeKind.Tuple(items) => {
            let list: List<TypeExpr> = []
            for i in 0..items.len() {
                const item = rewrittenType(r, &items[i], owner, named, decl)
                list.push(item)
            }
            TypeExpr{kind: TypeKind.Tuple(list), span: t.span}
        }
        _ => t.clone()
    }
}

fn pathTo(param: Symbol, at: &TypeExpr) TypeExpr {
    return TypeExpr{kind: TypeKind.Path([param], []), span: at.span}
}

// Whether a declaration is the interface `any` (spec 9.8), a `dyn` type.
fn isAnyDef(r: Resolver, id: int) bool {
    return r.text(r.defs[id].name) == "any" && r.moduleNames[r.defs[id].module] == "std.core.any"
}
