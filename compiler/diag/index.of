/**
 * @module
 * Diagnostics: errors and warnings collected during compilation and
 * rendered at the end, sorted by position, in the format of stage 0
 * (bootstrap/src/diag/diag.c). Codes come from docs/errors/README.md.
 */

import base.span.FileId
import base.span.SourceFile
import base.span.SourceMap
import base.span.Span

/**
 * How serious a diagnostic is.
 */
pub copy enum Severity {
    /** The compilation fails. */
    Error
    /** The compilation goes on; `--deny-warnings` makes it an error. */
    Warning
}

/** A lint level: its warnings are silenced. */
pub const LINT_ALLOW = 0
/** A lint level: its warnings are reported as warnings. */
pub const LINT_WARN = 1
/** A lint level: its warnings are reported as errors. */
pub const LINT_DENY = 2

// The level of a warning code in one file.
struct LintLevel {
    file: int
    code: str
    level: int
}

/**
 * The warning codes of a lint category, the name `@allow` and the
 * manifest's `lints` give it; empty for an unknown one.
 *
 * @param category as `unused`
 * @returns its codes
 */
pub fn lintCodes(category: str) List<str> {
    return if category == "unused" {
        ["W0001", "W0002", "W0003"]
    } else if category == "unreachable" {
        ["W0004"]
    } else if category == "deprecated" {
        ["W0006"]
    } else if category == "naming" {
        ["W0007"]
    } else if category == "suspicious" {
        ["W0008"]
    } else {
        []
    }
}

/**
 * How diagnostics are written.
 */
pub copy enum Format {
    /** A source excerpt with a caret under the span. */
    Human
    /** One line each: `file:line:col: error[E0001]: message`. */
    Short
    /** One JSON object per line (docs/design/toolchain.md). */
    Json
}

/**
 * What a line after a diagnostic's excerpt says.
 */
pub copy enum NoteKind {
    /** Context: `= note: ...`. */
    Note
    /** A fix: `= help: ...`. */
    Help
}

/**
 * A note or help line of a diagnostic.
 */
pub struct Note {
    /** Whether it gives context or a fix. */
    pub kind: NoteKind
    /** Its text. */
    pub message: str
    /** A machine-applicable fix: the name in the span to replace, or empty. */
    pub from: str
    /** What replaces `from`. */
    pub to: str
}

/**
 * One error or warning.
 */
pub struct Diagnostic {
    /** How serious it is. */
    pub severity: Severity
    /** Its code, as `E0001` or `W0002`. */
    pub code: str
    /** What it points to. */
    pub span: Span
    /** What went wrong. */
    pub message: str
    /** The note and help lines, in order. */
    pub notes: List<Note>
}

/**
 * The diagnostics of a compilation.
 *
 * @example
 * ```ofir
 * import base.span.FileId
 * import base.span.Span
 * import diag.Diagnostics
 * import std.testing.assert
 *
 * const span = Span{file: FileId(0), start: 0, end: 1}
 * let diags = Diagnostics.new()
 * diags.error("E0001", span, "unexpected character")
 * assert(diags.hasErrors())
 * ```
 */
pub struct Diagnostics {
    items: List<Diagnostic>
    errors: int
    // The spans where a warning code is silenced (`@allow`, spec 12.1).
    allowedCodes: List<str>
    allowedSpans: List<Span>
    // The lint levels of a package's manifest (ADR 0071), by file.
    levels: List<LintLevel>
    /** `--deny-warnings`: warnings are reported as errors. */
    pub denyWarnings: bool
    // The last warning was silenced: its notes are dropped too.
    silenced: bool

    /**
     * No diagnostics yet.
     *
     * @returns the collection
     */
    pub fn new() Diagnostics {
        return Diagnostics{items: [], errors: 0, allowedCodes: [], allowedSpans: [],
                           levels: [], denyWarnings: false, silenced: false}
    }

    /**
     * Records an error.
     *
     * @param code its code, as `E0300`
     * @param span what it points to
     * @param message what went wrong
     */
    pub fn error(mut self, code: str, span: Span, message: move str) {
        self.add(Severity.Error, code, span, message)
    }

    /**
     * Records a warning, or an error under `denyWarnings`.
     *
     * @param code its code, as `W0001`
     * @param span what it points to
     * @param message what is suspicious
     */
    pub fn warning(mut self, code: str, span: Span, message: move str) {
        const level = self.levelOf(code, span.file)
        if level == LINT_ALLOW || self.isAllowed(code, span) {
            self.silenced = true
            return
        }
        const deny = self.denyWarnings || level == LINT_DENY
        self.add(if deny { Severity.Error } else { Severity.Warning }, code, span, message)
    }

    /**
     * Sets the level of a warning code in a file: the `lints` of the
     * manifest of the package the file is in (ADR 0071).
     *
     * @param file the file
     * @param code the warning's code, as `W0008`
     * @param level `LINT_ALLOW`, `LINT_WARN` or `LINT_DENY`
     */
    pub fn setLevel(mut self, file: FileId, code: str, level: int) {
        self.levels.push(LintLevel{file: file.0, code: code.toOwned(), level})
    }

    // The level of `code` in `file`: the last one set, `LINT_WARN` if none.
    fn levelOf(self, code: str, file: FileId) int {
        let level = LINT_WARN
        for i in 0..self.levels.len() {
            if self.levels[i].file == file.0 && self.levels[i].code == code {
                level = self.levels[i].level
            }
        }
        return level
    }

    /**
     * Adds a note to the diagnostic recorded last.
     *
     * @param message the context it gives
     */
    pub fn note(mut self, message: move str) {
        self.addNote(NoteKind.Note, message)
    }

    /**
     * Adds a help line to the diagnostic recorded last.
     *
     * @param message the fix it suggests
     */
    pub fn help(mut self, message: move str) {
        self.addNote(NoteKind.Help, message)
    }

    /**
     * Adds a help line with a machine-applicable fix to the diagnostic
     * recorded last: the first `from` in its span, as a whole name, becomes
     * `to` (`fix` in JSON).
     *
     * @param message the fix it suggests
     * @param from the name to replace
     * @param to its replacement
     */
    pub fn suggest(mut self, message: move str, from: str, to: str) {
        const last = self.items.len() - 1
        const before = if last >= 0 { self.items[last].notes.len() } else { 0 }
        self.addNote(NoteKind.Help, message)
        if last >= 0 && self.items[last].notes.len() > before {
            self.items[last].notes[before].from = from.toOwned()
            self.items[last].notes[before].to = to.toOwned()
        }
    }

    /**
     * Silences a warning code inside a span: `@allow(unused)` on a
     * declaration.
     *
     * @param code the warning's code, as `W0001`
     * @param span the declaration
     */
    pub fn allow(mut self, code: str, span: Span) {
        self.allowedCodes.push(code.toOwned())
        self.allowedSpans.push(span)
    }

    /**
     * Whether an error was recorded.
     *
     * @returns true after the first error
     */
    pub fn hasErrors(self) bool {
        return self.errors > 0
    }

    /**
     * The number of errors.
     *
     * @returns the count
     */
    pub fn errorCount(self) int {
        return self.errors
    }

    /**
     * The number of diagnostics, errors and warnings.
     *
     * @returns the count
     */
    pub fn len(self) int {
        return self.items.len()
    }

    /**
     * The text of every diagnostic, sorted by file, offset and code, with
     * exact duplicates left out.
     *
     * @param map the files the spans point into
     * @param format how to write them
     * @returns the text, as stage 0 writes it to standard error
     */
    pub fn render(self, map: SourceMap, format: Format) str {
        let out = ""
        const order = self.sortedOrder()
        for k in 0..order.len() {
            const d = &self.items[order[k]]
            if k > 0 && same(d, &self.items[order[k - 1]]) {
                continue
            }
            if format == Format.Short {
                out.push(shortLine(d, map))
            } else if format == Format.Json {
                out.push(jsonLine(d, map))
            } else {
                out.push(excerpt(d, map))
            }
        }
        return out
    }

    /**
     * The diagnostics in the order `render` writes them, without exact
     * duplicates.
     *
     * @returns copies of them
     */
    pub fn reported(self) List<Diagnostic> {
        let out: List<Diagnostic> = []
        const order = self.sortedOrder()
        for k in 0..order.len() {
            if k > 0 && same(&self.items[order[k]], &self.items[order[k - 1]]) {
                continue
            }
            out.push(self.items[order[k]].clone())
        }
        return out
    }

    fn isAllowed(self, code: str, span: Span) bool {
        for i in 0..self.allowedCodes.len() {
            const a = self.allowedSpans[i]
            if self.allowedCodes[i] == code && a.file.0 == span.file.0 && a.start <= span.start &&
                span.end <= a.end {
                return true
            }
        }
        return false
    }

    fn add(mut self, severity: Severity, code: str, span: Span, message: move str) {
        if severity == Severity.Error {
            self.errors += 1
        }
        self.silenced = false
        self.items.push(Diagnostic{severity, code: code.toOwned(), span, message, notes: []})
    }

    fn addNote(mut self, kind: NoteKind, message: move str) {
        const last = self.items.len() - 1
        if last < 0 || self.silenced || self.items[last].notes.len() == MAX_NOTES {
            return
        }
        self.items[last].notes.push(Note{kind, message, from: "", to: ""})
    }

    // The indices of the diagnostics by (file, start, code), stable: an
    // insertion sort, as a compilation reports few diagnostics.
    fn sortedOrder(self) List<int> {
        let order: List<int> = []
        for i in 0..self.items.len() {
            order.push(i)
            let k = order.len() - 1
            for k > 0 && before(&self.items[order[k]], &self.items[order[k - 1]]) {
                const previous = order[k - 1]
                order[k - 1] = order[k]
                order[k] = previous
                k -= 1
            }
        }
        return order
    }
}

// The notes a diagnostic keeps, as stage 0 (`DIAG_MAX_NOTES`).
const MAX_NOTES: int = 4

// Whether `a` sorts before `b`: by file, then offset, then code.
fn before(a: &Diagnostic, b: &Diagnostic) bool {
    if a.span.file.0 != b.span.file.0 {
        return a.span.file.0 < b.span.file.0
    }
    if a.span.start != b.span.start {
        return a.span.start < b.span.start
    }
    return a.code < b.code
}

fn same(a: &Diagnostic, b: &Diagnostic) bool {
    return a.span.file.0 == b.span.file.0 && a.span.start == b.span.start &&
        a.code == b.code && a.message == b.message
}

fn severityName(s: Severity) str {
    return if s == Severity.Error { "error" } else { "warning" }
}

fn shortLine(d: &Diagnostic, map: SourceMap) str {
    const file = map.file(d.span.file)
    const at = file.lineCol(d.span.start)
    return "{file.path}:{at.line}:{at.column}: {severityName(d.severity)}[{d.code}]: {d.message}\n"
}

/**
 * A string as a JSON string literal, quotes included.
 *
 * @param text the string
 * @returns the literal
 */
pub fn jsonString(text: str) str {
    let out = "\""
    let copied = 0   // text before it is in `out`
    for i in 0..text.len() {
        const escape = jsonEscape(text[i])
        if escape.len() > 0 {
            out.push(text.slice(copied, i))
            out.push(escape)
            copied = i + 1
        }
    }
    out.push(text.sliceFrom(copied))
    out.push("\"")
    return out
}

// The JSON escape of a byte, "" for one copied as it is.
fn jsonEscape(b: u8) str {
    if b == b'"' {
        return "\\\"".toOwned()
    } else if b == b'\\' {
        return "\\\\".toOwned()
    } else if b == b'\n' {
        return "\\n".toOwned()
    } else if b == b'\t' {
        return "\\t".toOwned()
    } else if b < 32 {
        const digits = "0123456789abcdef"
        const high = b as int / 16
        const low = b as int % 16
        return "\\u00{digits.slice(high, high + 1)}{digits.slice(low, low + 1)}"
    }
    return "".toOwned()
}

/**
 * A diagnostic that points at no source, as a JSON line.
 *
 * @param severity its severity
 * @param code its code
 * @param message what went wrong
 * @returns the line, with its `\n`
 */
pub fn jsonNoSource(severity: Severity, code: str, message: str) str {
    return "{jsonFields(severity, code, message)},\"notes\":[]\}\n"
}

// The opening `{` and the fields every JSON diagnostic has.
fn jsonFields(severity: Severity, code: str, message: str) str {
    const head = "\{\"severity\":\"{severityName(severity)}\",\"code\":{jsonString(code)}"
    return "{head},\"message\":{jsonString(message)}"
}

fn jsonLine(d: &Diagnostic, map: SourceMap) str {
    const file = map.file(d.span.file)
    const at = file.lineCol(d.span.start)
    const end = file.lineCol(if d.span.end > d.span.start { d.span.end } else { d.span.start })
    let out = jsonFields(d.severity, d.code, d.message)
    out.push(",\"file\":{jsonString(file.path)},\"line\":{at.line},\"column\":{at.column},")
    out.push("\"endLine\":{end.line},\"endColumn\":{end.column},\"notes\":[")
    for i in 0..d.notes.len() {
        const kind = if d.notes[i].kind == NoteKind.Help { "help" } else { "note" }
        const separator = if i > 0 { "," } else { "" }
        out.push("{separator}\{\"kind\":\"{kind}\",\"message\":{jsonString(d.notes[i].message)}")
        out.push(jsonFix(d, &d.notes[i], file))
        out.push("\}")
    }
    out.push("]\}\n")
    return out
}

// The `fix` of a help line, with a leading comma: where the first `from`
// in the span, as a whole name, is and what replaces it. Empty without one.
fn jsonFix(d: &Diagnostic, note: &Note, file: &SourceFile) str {
    if note.from.len() == 0 {
        return ""
    }
    let at = nameIn(&file.text, d.span.start, d.span.end, &note.from, false)
    if at < 0 {   // a field value's span: the name is before it, on its line
        const lineStart = d.span.start - file.lineCol(d.span.start).column + 1
        at = nameIn(&file.text, lineStart, d.span.start, &note.from, true)
    }
    if at < 0 {
        return ""
    }
    const start = file.lineCol(at)
    const end = file.lineCol(at + note.from.len())
    let out = ",\"fix\":\{\"line\":{start.line},\"column\":{start.column},"
    out.push("\"endLine\":{end.line},\"endColumn\":{end.column},")
    out.push("\"text\":{jsonString(note.to)}\}")
    return out
}

// The offset of the first (or the last) `name` in `text[start..end]` that is
// not part of a longer name, or -1.
fn nameIn(text: &str, start: int, end: int, name: &str, last: bool) int {
    let found = -1
    for at in start..end - name.len() + 1 {
        if text.sliceFrom(at).startsWith(name) {
            const before = at == 0 || !isNameByte(text[at - 1])
            const after = at + name.len() >= text.len() || !isNameByte(text[at + name.len()])
            if before && after {
                found = at
                if !last {
                    return found
                }
            }
        }
    }
    return found
}

fn isNameByte(b: u8) bool {
    return b == b'_' || b >= b'0' && b <= b'9' || b >= b'a' && b <= b'z' ||
        b >= b'A' && b <= b'Z'
}

// The message, the location, the line and a caret line under the span.
fn excerpt(d: &Diagnostic, map: SourceMap) str {
    const file = map.file(d.span.file)
    const at = file.lineCol(d.span.start)
    const line = file.lineText(at.line)
    const number = "{at.line}"
    const pad = " ".repeat(number.len())
    let out = "{severityName(d.severity)}[{d.code}]: {d.message}\n"
    out.push("{pad}--> {file.path}:{at.line}:{at.column}\n")
    out.push("{pad} |\n")
    out.push("{number} | {line}\n")
    out.push("{pad} | ")
    for i in 0..at.column - 1 {   // tabs are kept so the caret stays under the text
        out.push(if line[i] == b'\t' { "\t" } else { " " })
    }
    let len = if d.span.end > d.span.start { d.span.end - d.span.start } else { 1 }
    if at.column - 1 + len > line.len() + 1 {   // a span running past the line is clipped
        len = line.len() + 1 - (at.column - 1)
    }
    out.push("^".repeat(len))
    out.push("\n")
    if d.notes.len() > 0 {
        out.push("{pad} |\n")
    }
    for i in 0..d.notes.len() {
        const kind = if d.notes[i].kind == NoteKind.Help { "help" } else { "note" }
        out.push("{pad} = {kind}: {d.notes[i].message}\n")
    }
    out.push("\n")
    return out
}

/**
 * A span for tests and diagnostics that have no source: offset 0 of file 0.
 *
 * @returns the span
 */
pub fn noSpan() Span {
    return Span{file: FileId(0), start: 0, end: 0}
}
