/** A generated value: its LLVM type and its text (`%t3`, `42`, `true`, ...). */
pub struct Value {
    /** Its LLVM type. */
    pub ty: str
    /** Its text. */
    pub text: str
}

/** The state of the generator. */
pub struct Gen {
    /** The module so far. */
    pub module: str
    /** The function being generated. */
    pub out: str
    /** String literals and locations, written at the end. */
    pub globals: str
    /** Struct type definitions not written yet. */
    pub typeDefs: str
    /** The number of `@.str.N`. */
    pub strCount: int
    /** The number of `@.loc.N`. */
    pub locCount: int
    /** [signed][add, sub, mul][i8, i16, i32, i64]: the overflow intrinsics used. */
    pub overflowUsed: List<bool>
    /** [function][f32, f64]: the float intrinsics used. */
    pub floatFnUsed: List<bool>
    /** The next `%t` number in this function. */
    pub temp: int
    /** By `FileId`: whether `@.file.<id>` exists. */
    pub filesEmitted: Map<int, bool>
    /** The LLVM name of each struct or enum type, by type. */
    pub adtTypes: Map<int, str>
    /** By `DefId`: the functions of extern blocks to declare. */
    pub cUsed: List<bool>
    /** By `DefId`: the functions used as values, which need a thunk. */
    pub fnValues: List<bool>
    /** By `DefId`: the mutable globals used, which need a definition. */
    pub mutGlobals: List<bool>
    /** Whether a `move` closure allocates or frees its environment. */
    pub heap: bool
    /** Whether an environment is aligned above 16 (spec 13.7). */
    pub alignedHeap: bool
    /** Whether an interpolation uses a format specifier (spec 1.7). */
    pub formats: bool
    /** The vtables, by number: the concrete type of each. */
    pub vtTypes: List<int>
    /** The interface of each vtable. */
    pub vtIfaces: List<int>
    /** Whether the concrete type of each vtable needs drop. */
    pub vtDrops: List<bool>
    /** The vtable numbers, by `type * 2^32 + interface`. */
    pub vtIds: Map<int, int>
    /** Whether the last `placeAddress` went through a `@packed` struct. */
    pub packedPlace: bool
    /** The enum whose tag the last `placeAddress` named, if it has a niche; else -1. */
    pub nicheTag: int
    /** By enum type: the variant `nicheVariant` found. */
    pub niches: Map<int, int>
    /** By struct type: the slot of each field in its LLVM type (`fieldSlots`). */
    pub slots: Map<int, List<int>>
    /** `-g`: whether to write debug info. */
    pub debug: bool
    /** The debug metadata. */
    pub di: DebugInfo
    /** The `DISubprogram` of the function being generated, 0 for none. */
    pub scope: int
    /** The working directory, escaped, for the `DIFile`s. */
    pub dir: str
    /** `--release`: whether to mark parameters `noalias` and `readonly`. */
    pub optimize: bool
    /** Whether this is a codegen unit rather than the whole program (ADR 0033). */
    pub units: bool
    /** Whether the function being generated is `linkonce_odr` in its unit. */
    pub linkonce: bool
    /** In a unit: where the linkage of the function being generated goes, or -1. */
    pub linkAt: int
    /** The `declare` of the function last generated. */
    pub declare: str
    /** In a unit: the text before each linkage left open. */
    pub parts: List<str>
    /** In a unit: the body whose linkage follows each part. */
    pub links: List<int>
    /** In a unit: the number of the body being generated. */
    pub body: int
    /** In a unit: the `@.file.N` number of each file, by `FileId`. */
    pub fileNums: Map<int, int>
    /** By `DefId`: whether the thunk of a function value is written. */
    pub thunked: List<bool>
    /** The number of vtables written. */
    pub vtDone: int
    /** Whether a vtable needs `@ofir.dyn.nodrop`. */
    pub noDrop: bool
    /** By type: the layouts of the ADTs computed so far. */
    pub layouts: Map<int, Layout>
}

fn hexDigit(n: u64) str {
    return "0123456789ABCDEF".slice(n as int, n as int + 1).toOwned()
}

// A byte as two upper-case hex digits.
fn hexByte(b: u8) str {
    return "{hexDigit((b >> 4) as u64)}{hexDigit((b & 15) as u64)}"
}

fn escapedBytes(out: mut str, text: str) {
    for i in 0..text.len() {
        const c = text[i]
        if c < 0x20 || c >= 0x7f || c == b'"' || c == b'\\' {
            out.push("\\")
            out.push(hexByte(c))
        } else {
            out.push(text.slice(i, i + 1))
        }
    }
}

// The bits of a double, through its memory.
fn floatBits(value: float) u64 {
    const x = value
    unsafe {
        const p = &x as *float
        return *(p as *u64)
    }
}

fn intBits(data: int) int {
    return match data % 4 {
        0 => 8
        1 => 16
        2 => 32
        _ => 64
    }
}

/**
 * Whether a type has a value in LLVM: false for (), !, the error type and keys.
 *
 * @param c the checker
 * @param ty the type
 * @returns true if it does
 */
pub fn hasValue(c: Checker, ty: int) bool {
    return ty != UNIT && ty != NEVER && ty != ERROR && c.types.kind(ty) != TyKind.Key
}

/**
 * A new generator.
 *
 * @returns the generator
 */
pub fn newGen() Gen {
    return Gen{module: "", out: "", globals: "", typeDefs: "", strCount: 0, locCount: 0,
               overflowUsed: List.filled(false, 24), floatFnUsed: List.filled(false, 12),
               temp: 0, filesEmitted: Map.new(), adtTypes: Map.new(), cUsed: [], heap: false,
               formats: false, packedPlace: false, nicheTag: -1, niches: Map.new(),
               slots: Map.new(),
               alignedHeap: false, mutGlobals: [],
               fnValues: [], vtTypes: [], vtIfaces: [], vtDrops: [], vtIds: Map.new(),
               debug: false, di: DebugInfo.new(), scope: 0, dir: "", optimize: false,
               units: false, linkonce: false, linkAt: -1, declare: "", parts: [], links: [],
               body: 0, fileNums: Map.new(), thunked: [], vtDone: 0, noDrop: false,
               layouts: Map.new()}
}

fn nextTemp(g: mut Gen) str {
    const t = "%t{g.temp}"
    g.temp += 1
    return t
}

// ---------------------------------------------------------------------------
// Types

/**
 * The LLVM type of an Ofir type.
 *
 * @param g the generator
 * @param c the checker
 * @param p the program
 * @param ty the type, concrete
 * @returns its LLVM type
 */
pub fn llvmType(g: mut Gen, c: mut Checker, p: Program, ty: int) str {
    const t = c.types.get(ty)
    const kind = t.kind
    const data = t.data
    const inner = t.inner
    return match kind {
        TyKind.Adt => adtType(g, c, p, ty)
        TyKind.Array => "[{data} x {fieldType(g, c, p, inner)}]"
        TyKind.Param => panic("llvmType: a type parameter survived monomorphization")
        TyKind.Tuple => tupleType(g, c, p, ty)
        TyKind.Ref |
        TyKind.Ptr => if c.types.isFat(ty) { FN_LLVM.toOwned() } else { "ptr".toOwned() }
        TyKind.Bool => "i1".toOwned()
        TyKind.Int => "i{intBits(data)}"
        TyKind.Float => if data == 32 { "float".toOwned() } else { "double".toOwned() }
        TyKind.Str => "%ofir.str".toOwned()
        TyKind.Fn => if c.types.isCFn(ty) {   // a C function pointer
            "ptr".toOwned()
        } else {
            FN_LLVM.toOwned()   // the code and the environment
        }
        _ => "void".toOwned()   // (), ! and the types the checker rejects
    }
}

fn fieldType(g: mut Gen, c: mut Checker, p: Program, ty: int) str {
    const t = llvmType(g, c, p, ty)
    return if t == "void" { "\{\}".toOwned() } else { t }
}

// A field that is never null: a reference, a `Box` or a function.
fn neverNull(c: Checker, ty: int) bool {
    const t = c.types.get(ty)
    const box = c.r.langItems[0]
    return t.kind == TyKind.Ref || (t.kind == TyKind.Fn && t.data & FN_C == 0) ||
           (t.kind == TyKind.Adt && box != 0 && t.data == box)
}

/**
 * The variant of a niche enum that holds a pointer, or -1 (spec 13.3): an
 * enum of two variants, one without fields and the other with one field
 * that is never null, keeps no tag; the other variant is a null pointer.
 *
 * @param g the generator
 * @param c the checker
 * @param p the program
 * @param adt the enum type
 * @returns the variant, or -1
 */
pub fn nicheVariant(g: mut Gen, c: mut Checker, p: Program, adt: int) int {
    if const Option.Some(known) = g.niches.get(adt) {
        return *known
    }
    const id = c.types.get(adt).data
    enumVariants(c, p, id)
    let found = -1
    if variantsOf(c, id).variants.len() == 2 {
        const first = variantsOf(c, id).variants[0].types.len()
        const second = variantsOf(c, id).variants[1].types.len()
        const v = if first == 1 && second == 0 { 0 } else if first == 0 && second == 1 { 1 } else {
            -1
        }
        if v >= 0 && neverNull(c, variantFieldType(c, p, adt, v, 0)) {
            found = v
        }
    }
    g.niches.insert(adt, found)
    return found
}

// Whether `ty` is an enum with a niche.
fn isNicheEnum(g: mut Gen, c: mut Checker, p: Program, ty: int) bool {
    const t = c.types.get(ty)
    if t.kind != TyKind.Adt || c.def(t.data).kind != DefKind.Enum {
        return false
    }
    return nicheVariant(g, c, p, ty) >= 0
}

copy struct Layout {
    size: int
    align: int
}

fn fieldsLayout(g: mut Gen, c: mut Checker, p: Program, types: &List<int>) Layout {
    let size = 0
    let align = 1
    for i in 0..types.len() {
        const f = layout(g, c, p, types[i])
        size = (size + f.align - 1) / f.align * f.align + f.size
        align = if f.align > align { f.align } else { align }
    }
    size = (size + align - 1) / align * align
    return Layout{size: size, align: align}
}

// The field types of variant `v` of the enum instance `adt`, or of the
// struct when `v` is -1.
fn fieldTypes(c: mut Checker, p: Program, adt: int, v: int) List<int> {
    const id = c.types.get(adt).data
    let types: List<int> = []
    if v < 0 {
        structFields(c, p, id)
        const count = fieldsOf(c, id).types.len()
        for i in 0..count {
            types.push(structFieldType(c, p, adt, i))
        }
    } else {
        const count = variantsOf(c, id).variants[v].types.len()
        for i in 0..count {
            types.push(variantFieldType(c, p, adt, v, i))
        }
    }
    return types
}

// The slot of each field of a struct in its LLVM type: the fields go by
// descending alignment, stable, unless their order is fixed (spec 13.2).
fn fieldSlots(g: mut Gen, c: mut Checker, p: Program, ty: int) List<int> {
    if const Option.Some(known) = g.slots.get(ty) {
        return known.clone()
    }
    const id = c.types.get(ty).data
    let types: List<int> = []
    if c.info[id].fields.isSome() {
        types = fieldTypes(c, p, ty, -1)
    }
    let slots: List<int> = []
    let aligns: List<int> = []
    for i in 0..types.len() {
        slots.push(i)
        aligns.push(layout(g, c, p, types[i]).align)
    }
    if !fixedOrder(c, p, id) {
        let placed = List.filled(false, types.len())
        for k in 0..types.len() {
            let best = -1
            for i in 0..types.len() {
                if !placed[i] && (best < 0 || aligns[i] > aligns[best]) {
                    best = i
                }
            }
            placed[best] = true
            slots[best] = k
        }
    }
    g.slots.insert(ty, slots.clone())
    return slots
}

// The field types of a struct in the order of its LLVM type.
fn slotTypes(g: mut Gen, c: mut Checker, p: Program, ty: int, types: &List<int>) List<int> {
    const slots = fieldSlots(g, c, p, ty)
    let out = types.clone()
    for i in 0..types.len() {
        out[slots[i]] = types[i]
    }
    return out
}

// Whether a type is a struct.
fn isStruct(c: Checker, ty: int) bool {
    const t = c.types.get(ty)
    return t.kind == TyKind.Adt && c.def(t.data).kind == DefKind.Struct
}

// The layout of a struct: `@packed` has no padding, `@align(N)` raises its
// alignment (spec 13.2).
fn structLayout(g: mut Gen, c: mut Checker, p: Program, ty: int) Layout {
    const id = c.types.get(ty).data
    const declared = fieldTypes(c, p, ty, -1)
    const types = slotTypes(g, c, p, ty, &declared)
    if isPacked(c, p, id) {
        let size = 0
        for i in 0..types.len() {
            size += layout(g, c, p, types[i]).size
        }
        return Layout{size: size, align: 1}
    }
    const l = fieldsLayout(g, c, p, &types)
    const align = alignAttr(c, p, id)
    if align <= l.align {
        return l
    }
    return Layout{size: (l.size + align - 1) / align * align, align: align}
}

// The size of a payload unit of an enum: the largest alignment of its
// variants, at least 8.
fn payloadUnit(g: mut Gen, c: mut Checker, p: Program, adt: int) int {
    const id = c.types.get(adt).data
    enumVariants(c, p, id)
    let unit = 8
    for v in 0..variantsOf(c, id).variants.len() {
        const types = fieldTypes(c, p, adt, v)
        const align = fieldsLayout(g, c, p, &types).align
        unit = if align > unit { align } else { unit }
    }
    return unit
}

// The payload units of an enum: enough for its largest variant.
fn payloadWords(g: mut Gen, c: mut Checker, p: Program, adt: int) int {
    const id = c.types.get(adt).data
    enumVariants(c, p, id)
    let largest = 0
    for v in 0..variantsOf(c, id).variants.len() {
        const types = fieldTypes(c, p, adt, v)
        const l = fieldsLayout(g, c, p, &types)
        largest = if l.size > largest { l.size } else { largest }
    }
    const unit = payloadUnit(g, c, p, adt)
    return (largest + unit - 1) / unit
}

fn layout(g: mut Gen, c: mut Checker, p: Program, ty: int) Layout {
    const t = c.types.get(ty)
    const kind = t.kind
    const data = t.data
    const inner = t.inner
    return match kind {
        TyKind.Bool => Layout{size: 1, align: 1}
        TyKind.Array => {
            const elem = layout(g, c, p, inner)
            Layout{size: elem.size * data, align: elem.align}
        }
        TyKind.Int => Layout{size: intBits(data) / 8, align: intBits(data) / 8}
        TyKind.Float => Layout{size: data / 8, align: data / 8}
        TyKind.Str => Layout{size: 24, align: 8}
        TyKind.Ref | TyKind.Ptr => Layout{size: if c.types.isFat(ty) { 16 } else { 8 }, align: 8}
        TyKind.Fn => Layout{size: if c.types.isCFn(ty) { 8 } else { 16 }, align: 8}
        TyKind.Tuple => {
            const args = c.types.get(ty).args.clone()
            fieldsLayout(g, c, p, &args)
        }
        TyKind.Adt => adtLayout(g, c, p, ty)
        _ => Layout{size: 0, align: 1}
    }
}

// The layout of a struct or enum, computed once: an enum's layout reads
// its variants' layouts more than once.
fn adtLayout(g: mut Gen, c: mut Checker, p: Program, ty: int) Layout {
    if const Option.Some(known) = g.layouts.get(ty) {
        return *known
    }
    const data = c.types.get(ty).data
    const l = if c.def(data).kind == DefKind.Struct {
        structLayout(g, c, p, ty)
    } else if nicheVariant(g, c, p, ty) >= 0 {   // the pointer alone
        layout(g, c, p, variantFieldType(c, p, ty, nicheVariant(g, c, p, ty), 0))
    } else {
        const words = payloadWords(g, c, p, ty)
        const unit = payloadUnit(g, c, p, ty)
        const size = if words > 0 { unit + unit * words } else { 4 }
        const align = if words > 0 { unit } else { 4 }
        Layout{size: size, align: align}
    }
    g.layouts.insert(ty, l)
    return l
}

// `<int, geo.Point>`: the type arguments of an instance, for its name.
fn typeArgsText(c: Checker, targs: int) str {
    const args = c.types.get(targs).args.clone()
    let out = ""
    for i in 0..args.len() {
        out.push(if i > 0 { ", " } else { "<" })
        out.push(c.qualifiedTypeName(args[i]))
    }
    out.push(">")
    return out
}

// `%"Shape.3"`, or `%"Pair<int, str>.5"` for an instance: the DefId keeps
// same-named types apart. A unit names a type by its qualified name, which
// does not change when declarations are added elsewhere.
fn nameType(c: mut Checker, ty: int, suffix: str, units: bool) str {
    if units {
        return "%\"{c.qualifiedTypeName(ty)}{suffix}\""
    }
    const id = c.types.get(ty).data
    const args = c.types.get(ty).args.clone()
    let out = "%\"{c.text(c.def(id).name)}"
    if args.len() > 0 {
        out.push(typeArgsText(c, c.types.tuple(args)))
    }
    out.push(".{id}{suffix}\"")
    return out
}

// An empty array whose element has alignment `align`: the last field of an
// `@align(N)` struct.
fn alignField(align: int) str {
    return if align >= 16 {
        "[0 x <{align} x i8>]"
    } else {
        "[0 x i{align * 8}]"
    }
}

// `packed` gives `<{ ... }>`; `align`, when above 0, adds `alignField`.
fn define(g: mut Gen, c: mut Checker, p: Program, name: str, types: &List<int>, packed: bool,
          align: int) {
    for i in 0..types.len() {
        const _ = fieldType(g, c, p, types[i])   // the field types first: no interleaving
    }
    g.typeDefs.push(if packed { "{name} = type <\{ " } else { "{name} = type \{ " })
    for i in 0..types.len() {
        if i > 0 {
            g.typeDefs.push(", ")
        }
        g.typeDefs.push(fieldType(g, c, p, types[i]))
    }
    if align > 0 {
        g.typeDefs.push(if types.len() > 0 { ", " } else { "" })
        g.typeDefs.push(alignField(align))
    }
    g.typeDefs.push(if packed { " \}>\n" } else { " \}\n" })
}

/**
 * The LLVM type of variant `v` of an enum.
 *
 * @param c the checker
 * @param adt the enum type
 * @param v the variant
 * @returns its name
 */
pub fn variantType(c: mut Checker, adt: int, v: int, units: bool) str {
    return nameType(c, adt, ".{v}", units)
}

fn defineEnum(g: mut Gen, c: mut Checker, p: Program, adt: int, name: str) {
    const words = payloadWords(g, c, p, adt)
    const id = c.types.get(adt).data
    let fields = false
    for v in 0..variantsOf(c, id).variants.len() {
        const types = fieldTypes(c, p, adt, v)
        fields = fields || types.len() > 0
        define(g, c, p, variantType(c, adt, v, g.units), &types, false, 0)
    }
    const unit = payloadUnit(g, c, p, adt)
    const niche = nicheVariant(g, c, p, adt)
    if niche >= 0 {   // the pointer alone
        const field = fieldType(g, c, p, variantFieldType(c, p, adt, niche, 0))
        g.typeDefs.push("{name} = type \{ {field} \}\n")
    } else if words > 0 && unit > 8 {
        g.typeDefs.push("{name} = type \{ i32, [{words} x <{unit} x i8>] \}\n")
    } else if words > 0 {
        g.typeDefs.push("{name} = type \{ i32, [{words} x i64] \}\n")
    } else if fields {   // zero-sized fields still need a payload to point at
        g.typeDefs.push("{name} = type \{ i32, [0 x i8] \}\n")
    } else {
        g.typeDefs.push("{name} = type \{ i32 \}\n")
    }
}

fn adtType(g: mut Gen, c: mut Checker, p: Program, ty: int) str {
    if const Option.Some(known) = g.adtTypes.get(ty) {
        return known.clone()
    }
    const id = c.types.get(ty).data
    const name = nameType(c, ty, "", g.units)
    g.adtTypes.insert(ty, name.clone())
    if c.def(id).kind == DefKind.Enum {
        defineEnum(g, c, p, ty, name.clone())
        return name
    }
    let types: List<int> = []
    if c.info[id].fields.isSome() {
        const declared = fieldTypes(c, p, ty, -1)
        types = slotTypes(g, c, p, ty, &declared)
    }
    define(g, c, p, name.clone(), &types, isPacked(c, p, id), alignAttr(c, p, id))
    return name
}

// A tuple is a literal LLVM struct type, `{ i64, double }`.
fn tupleType(g: mut Gen, c: mut Checker, p: Program, ty: int) str {
    const args = c.types.get(ty).args.clone()
    let out = "\{ "
    for i in 0..args.len() {
        if i > 0 {
            out.push(", ")
        }
        out.push(fieldType(g, c, p, args[i]))
    }
    out.push(" \}")
    return out
}

// The address of a place: `%l<N>` itself, or a getelementptr to the field.
fn placeAddress(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, local: int,
                path: &FieldPath) str {
    let base = "%l{local}"
    g.packedPlace = false
    g.nicheTag = -1
    if path.deref {   // the local holds the address of the value
        base = nextTemp(g)
        g.out.push("  {base} = load ptr, ptr %l{local}\n")
    }
    let current = body.locals[local].ty
    const pointer = c.types.get(current)
    if path.deref && (pointer.kind == TyKind.Ptr || pointer.kind == TyKind.Ref) {   // `*p`, `*r`
        current = pointer.inner
    }
    let variant = false
    let index = 0
    for i in 0..path.fields.len() {
        const entry = path.fields[i]
        if !variant && isNicheEnum(g, c, p, current) {   // no tag: the pointer
            if entry >= VARIANT_STEP {
                variant = true
                index = entry - VARIANT_STEP
            } else {
                g.nicheTag = current
                current = I32
            }
            continue
        }
        const next = nextTemp(g)
        if entry >= VARIANT_STEP {   // view the payload as a variant
            const container = llvmType(g, c, p, current)
            g.out.push("  {next} = getelementptr inbounds {container}, ptr {base}, i32 0, i32 1\n")
            variant = true
            index = entry - VARIANT_STEP
            base = next
            continue
        }
        const container = if variant { variantType(c, current, index, g.units) } else {
            llvmType(g, c, p, current)
        }
        const slot = if !variant && isStruct(c, current) {
            fieldSlots(g, c, p, current)[entry]
        } else {
            entry
        }
        g.out.push("  {next} = getelementptr inbounds {container}, ptr {base}, i32 0, "
                   + "i32 {slot}\n")
        const t = c.types.get(current)
        const isEnum = t.kind == TyKind.Adt && c.def(t.data).kind == DefKind.Enum
        if !variant && t.kind == TyKind.Adt && isPacked(c, p, t.data) {
            g.packedPlace = true
        }
        if variant {
            current = variantFieldType(c, p, current, index, entry)
        } else if t.kind == TyKind.Tuple {
            current = t.args[entry]
        } else if t.kind == TyKind.Array {
            current = t.inner
        } else if isEnum {
            current = I32
        } else {   // a struct, or a primitive's fields from its `@lang` declaration
            current = structFieldType(c, p, current, entry)
        }
        variant = false
        base = next
    }
    return base
}

// ---------------------------------------------------------------------------
// Names and globals

fn isCFunction(c: Checker, p: Program, id: int) bool {
    const def = c.def(id)
    if def.kind != DefKind.Fn || def.item < 0 {
        return false
    }
    const isExtern = match itemOf(p, c.loc(id)).kind {
        ItemKind.Extern(_, _) => true
        _ => false
    }
    return isExtern || fnOf(p, c.loc(id)).abi.len() > 0
}

// `@inline`, `@inline(never)` and `@cold` (spec 12.1).
fn hints(c: Checker, p: Program, id: int) str {
    const def = c.def(id)
    if def.kind != DefKind.Fn || def.item < 0 {
        return ""
    }
    const decl = fnOf(p, c.loc(id))
    let text = ""
    if const Option.Some(at) = findAttribute(c.r, decl.attributes, "inline") {
        text = if decl.attributes[at].args.len() > 0 { " noinline" } else { " alwaysinline" }
    }
    if findAttribute(c.r, decl.attributes, "cold").isSome() {
        text = "{text} cold"
    }
    return text
}

// User functions are prefixed so they never clash with C symbols; `main`
// becomes the entry point called by the runtime.
fn functionName(c: mut Checker, p: Program, id: int, targs: int, isMain: bool) str {
    if isMain {
        return "@ofir_main".toOwned()
    }
    if isGlue(id) {   // `ofir.drop<T>`, `ofir.clone<T>`, `ofir.eq<T>`, ...
        const glue = glueName(id)
        return "@\"ofir.{glue}{typeArgsText(c, targs)}\""
    }
    if isCFunction(c, p, id) {   // a C function keeps its name or takes its `@export` one
        return "@{cSymbol(c.r, fnOf(p, c.loc(id)))}"
    }
    const def = c.def(id)
    let out = "@\"ofir."
    if def.module != 0 {   // qualified by its module, except in the root module
        out.push(c.r.moduleNames[def.module])
        out.push(".")
    }
    if def.member >= 0 {
        const item = itemOf(p, c.loc(id))
        const isType = match item.kind {
            ItemKind.Struct(_, _, _, _, _, _) | ItemKind.Enum(_, _, _, _) |
            ItemKind.Interface(_, _, _) => true
            _ => false
        }
        if isType {   // a method: qualified by its type, `ofir.Point.norm`
            out.push(c.text(item.name))
            out.push(".")
        }
    }
    out.push(c.text(def.name))
    if targs != UNIT {   // an instance: `ofir.identity<int>`
        out.push(typeArgsText(c, targs))
    }
    out.push("\"")
    return out
}

fn stringGlobal(g: mut Gen, text: str) int {
    const n = g.strCount
    g.strCount += 1
    g.globals.push("@.str.{n} = private unnamed_addr constant [{text.len()} x i8] c\"")
    escapedBytes(g.globals, text)
    g.globals.push("\"\n")
    return n
}

// The location of a span, for panic messages: `@.loc.N`.
fn locationGlobal(g: mut Gen, c: Checker, span: Span) int {
    const file = c.r.map.file(span.file)
    const pos = file.lineCol(span.start)
    let id = span.file.0
    if g.units {   // numbered within the unit
        if const Option.Some(n) = g.fileNums.get(span.file.0) {
            id = *n
        } else {
            id = g.fileNums.len()
            g.fileNums.insert(span.file.0, id)
        }
    }
    if g.filesEmitted.get(id).isNone() {
        g.filesEmitted.insert(id, true)
        const path = file.path.clone()
        g.globals.push("@.file.{id} = private unnamed_addr constant [{path.len() + 1} x i8] c\"")
        escapedBytes(g.globals, path)
        g.globals.push("\\00\"\n")
    }
    const n = g.locCount
    g.locCount += 1
    g.globals.push("@.loc.{n} = private unnamed_addr constant %ofir.loc \{ ptr @.file.{id}, "
                   + "i32 {pos.line}, i32 {pos.column} \}\n")
    return n
}

// ---------------------------------------------------------------------------
// Operands and rvalues

// LLVM integers are sign-agnostic: the bit pattern as a signed number of
// the type's width.
fn intText(value: u64, bits: int) str {
    const ones: u64 = 18446744073709551615
    const mask = if bits == 64 { ones } else { ((1 as u64) << (bits as u64)) - 1 }
    let v = value & mask
    if bits < 64 && ((v >> ((bits - 1) as u64)) & 1) == 1 {
        v = v | (mask ^ ones)   // sign-extend
    }
    return "{v.wrappingCast<i64>()}"
}

fn floatText(value: float, isF32: bool) str {
    const exact = if isF32 { (value as f32) as float } else { value }
    const bits = floatBits(exact)
    let out = "0x"
    let shift = 60
    for shift >= 0 {
        out.push(hexDigit((bits >> (shift as u64)) & 15))
        shift -= 4
    }
    return out
}

fn operand(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, o: &Operand) Value {
    const ty = llvmType(g, c, p, o.ty)
    return match o.kind {
        OperandKind.Copy => {
            if ty == "void" {
                Value{ty: ty, text: ""}   // a local of type (): nothing to load
            } else {
                const at = placeAddress(g, c, p, body, o.local, &o.path)
                if g.nicheTag >= 0 {   // the tag of a niche enum: whether the pointer is null
                    return nicheTagValue(g, c, p, at)
                }
                const t = nextTemp(g)
                g.out.push("  {t} = load {ty}, ptr {at}{packedAlign(g)}\n")
                Value{ty: ty, text: t}
            }
        }
        OperandKind.Addr => Value{ty: "ptr".toOwned(), text: placeAddress(g, c, p, body, o.local,
                                                                          &o.path)}
        OperandKind.Int => Value{ty: ty, text: intText(o.bits, intBits(c.types.get(o.ty).data))}
        OperandKind.Float => Value{ty: ty, text: floatText(o.float, c.types.get(o.ty).data == 32)}
        OperandKind.Bool => Value{ty: ty,
                                  text: if o.truth { "true".toOwned() } else { "false".toOwned() }}
        OperandKind.Str => {
            const n = stringGlobal(g, o.text)
            if c.types.kind(o.ty) != TyKind.Str {   // a byte string: a `Slice<u8>`
                return Value{ty: ty, text: "\{ ptr @.str.{n}, i64 {o.text.len()} \}"}
            }
            Value{ty: ty, text: "\{ ptr @.str.{n}, i64 {o.text.len()}, i64 0 \}"}
        }
        OperandKind.Unit => Value{ty: "void".toOwned(), text: ""}
    }
}

// The discriminants of the variants of the niche enum `g.nicheTag`: the
// one without a payload, then the one with it.
fn nicheDiscriminants(g: mut Gen, c: mut Checker, p: Program) (int, int) {
    const adt = g.nicheTag
    const some = nicheVariant(g, c, p, adt)
    const id = c.types.get(adt).data
    const none = variantsOf(c, id).variants[1 - some].discriminant
    return (none, variantsOf(c, id).variants[some].discriminant)
}

// Reads the tag of a niche enum at `at`.
fn nicheTagValue(g: mut Gen, c: mut Checker, p: Program, at: str) Value {
    const (none, some) = nicheDiscriminants(g, c, p)
    const word = nextTemp(g)
    g.out.push("  {word} = load ptr, ptr {at}\n")
    const isNull = nextTemp(g)
    g.out.push("  {isNull} = icmp eq ptr {word}, null\n")
    const tag = nextTemp(g)
    g.out.push("  {tag} = select i1 {isNull}, i32 {none}, i32 {some}\n")
    return Value{ty: "i32".toOwned(), text: tag}
}

// Writes the tag `v` of a niche enum at `at`: a null pointer for the
// variant without a payload; the other variant's payload is already there.
fn nicheTagStore(g: mut Gen, c: mut Checker, p: Program, at: str, v: &Value) {
    const (none, some) = nicheDiscriminants(g, c, p)
    if v.text == "{none}" {
        g.out.push("  store ptr null, ptr {at}\n")
    } else if v.text != "{some}" {   // not a constant
        const word = nextTemp(g)
        g.out.push("  {word} = load ptr, ptr {at}\n")
        const isNone = nextTemp(g)
        g.out.push("  {isNone} = icmp eq i32 {v.text}, {none}\n")
        const kept = nextTemp(g)
        g.out.push("  {kept} = select i1 {isNone}, ptr null, ptr {word}\n")
        g.out.push("  store ptr {kept}, ptr {at}\n")
    }
}

fn intOp(op: Op, signed: bool) str {
    const name = match op {
        Op.Add => "add"
        Op.Sub => "sub"
        Op.Mul => "mul"
        Op.Div => if signed { "sdiv" } else { "udiv" }
        Op.Rem => if signed { "srem" } else { "urem" }
        Op.And => "and"
        Op.Or => "or"
        Op.Xor => "xor"
        Op.Shl => "shl"
        Op.Shr => if signed { "ashr" } else { "lshr" }
        Op.Eq => "icmp eq"
        Op.Ne => "icmp ne"
        Op.Lt => if signed { "icmp slt" } else { "icmp ult" }
        Op.Le => if signed { "icmp sle" } else { "icmp ule" }
        Op.Gt => if signed { "icmp sgt" } else { "icmp ugt" }
        Op.Ge => if signed { "icmp sge" } else { "icmp uge" }
        _ => "add"
    }
    return name.toOwned()
}

fn floatOp(op: Op) str {
    const name = match op {
        Op.Add => "fadd"
        Op.Sub => "fsub"
        Op.Mul => "fmul"
        Op.Div => "fdiv"
        Op.Rem => "frem"
        Op.Eq => "fcmp oeq"
        Op.Ne => "fcmp une"   // NaN != NaN is true
        Op.Lt => "fcmp olt"
        Op.Le => "fcmp ole"
        Op.Gt => "fcmp ogt"
        Op.Ge => "fcmp oge"
        _ => "fadd"
    }
    return name.toOwned()
}

fn isSigned(c: Checker, ty: int) bool {
    const t = c.types.get(ty)
    return t.kind == TyKind.Int && t.data <= 3
}

// The cast instruction from one type to another, or "" for none.
fn castOp(c: Checker, from: int, to: int) str {
    const f = c.types.get(from)
    const t = c.types.get(to)
    const fromPtr = f.kind == TyKind.Ptr || f.kind == TyKind.Ref
    const toPtr = t.kind == TyKind.Ptr || t.kind == TyKind.Ref
    if fromPtr || toPtr {   // a reference is a pointer
        const op = if fromPtr == toPtr { "" } else if fromPtr { "ptrtoint" } else { "inttoptr" }
        return op.toOwned()
    }
    if f.kind == TyKind.Float && t.kind == TyKind.Float {
        return if f.data < t.data { "fpext".toOwned() } else { "fptrunc".toOwned() }
    }
    if f.kind == TyKind.Float {
        return if isSigned(c, to) { "fptosi".toOwned() } else { "fptoui".toOwned() }
    }
    if t.kind == TyKind.Float {
        return if isSigned(c, from) { "sitofp".toOwned() } else { "uitofp".toOwned() }
    }
    const fromBits = intBits(f.data)
    const toBits = intBits(t.data)
    if fromBits == toBits {
        return "".toOwned()   // same bits, different signedness
    }
    const op = if toBits < fromBits { "trunc" } else if isSigned(c, from) { "sext" } else { "zext" }
    return op.toOwned()
}

fn castValue(g: mut Gen, c: mut Checker, p: Program, from: int, to: int, a: move Value) Value {
    const op = castOp(c, from, to)
    const target = llvmType(g, c, p, to)
    if c.types.isFat(from) && !c.types.isFat(to) {   // the data pointer of a fat pointer
        const data = nextTemp(g)
        g.out.push("  {data} = extractvalue {FN_LLVM} {a.text}, 0\n")
        return Value{ty: target, text: data}
    }
    if op == "" {
        return Value{ty: target, text: a.text}
    }
    const t = nextTemp(g)
    g.out.push("  {t} = {op} {a.ty} {a.text} to {target}\n")
    return Value{ty: target, text: t}
}

copy struct Bounds {
    below: bool
    above: bool
    min: i64
    max: u64
}

fn bounds(c: Checker, from: int, to: int) Bounds {
    const s = intBits(c.types.get(from).data)
    const t = intBits(c.types.get(to).data)
    const fs = c.types.get(from).data <= 3
    const ts = c.types.get(to).data <= 3
    const below = fs && (!ts || t < s)
    const aboveSigned = if ts { t < s } else { t + 1 < s }
    const aboveUnsigned = if ts { t <= s } else { t < s }
    const above = if fs { aboveSigned } else { aboveUnsigned }
    const one: u64 = 1
    let min: i64 = 0
    if ts {
        min = if t == 64 { i64.MIN } else { 0 - ((one << ((t - 1) as u64)) as i64) }
    }
    const ones: u64 = 18446744073709551615
    let max: u64 = 0
    if ts {
        max = (one << ((t - 1) as u64)) - 1
    } else {
        max = if t == 64 { ones } else { (one << (t as u64)) - 1 }
    }
    return Bounds{below: below, above: above, min: min, max: max}
}

// Combines two optional failure conditions with `or`.
fn either(g: mut Gen, low: str, high: str) str {
    if low.len() > 0 && high.len() > 0 {
        const t = nextTemp(g)
        g.out.push("  {t} = or i1 {low}, {high}\n")
        return t
    }
    return if low.len() > 0 { low.toOwned() } else if high.len() > 0 { high.toOwned() } else {
        "false".toOwned()
    }
}

fn floatBound(value: float) str {
    return floatText(value, false)
}

fn castFails(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, rv: &Rvalue) Value {
    const a = operand(g, c, p, body, &rv.a)
    const from = rv.a.ty
    const to = rv.to
    if c.types.kind(from) == TyKind.Float {   // the value must be in (min - 1, max + 1)
        const t = intBits(c.types.get(to).data)
        const signed = c.types.get(to).data <= 3
        let power = 1.0
        const exponent = if signed { t - 1 } else { t }
        for _ in 0..exponent {
            power = power * 2.0
        }
        const min = if signed { 0.0 - power } else { 0.0 }
        // When min - 1 is not exact in the source type, no value lies between it and min.
        const below = min - 1.0
        const exact = if c.types.get(from).data == 32 {
            (below as f32) as float == below
        } else {
            below != min
        }
        const lo = floatBound(if exact { below } else { min })
        const hi = floatBound(power)
        const op = if exact { "ogt" } else { "oge" }
        const ge = nextTemp(g)
        g.out.push("  {ge} = fcmp {op} {a.ty} {a.text}, {lo}\n")
        const lt = nextTemp(g)
        g.out.push("  {lt} = fcmp olt {a.ty} {a.text}, {hi}\n")
        const ok = nextTemp(g)
        g.out.push("  {ok} = and i1 {ge}, {lt}\n")
        const result = nextTemp(g)
        g.out.push("  {result} = xor i1 {ok}, true\n")
        return Value{ty: "i1".toOwned(), text: result}
    }
    const b = bounds(c, from, to)
    let low = ""
    let high = ""
    if b.below {
        low = nextTemp(g)
        g.out.push("  {low} = icmp slt {a.ty} {a.text}, {b.min}\n")
    }
    if b.above {
        high = nextTemp(g)
        const cmp = if isSigned(c, from) { "sgt" } else { "ugt" }
        g.out.push("  {high} = icmp {cmp} {a.ty} {a.text}, {b.max}\n")
    }
    return Value{ty: "i1".toOwned(), text: either(g, low, high)}
}

// `x.saturatingCast<T>()`: clamp in the source type, then convert.
fn saturate(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, rv: &Rvalue) Value {
    const a = operand(g, c, p, body, &rv.a)
    const b = bounds(c, rv.a.ty, rv.to)
    let value = a.text.clone()
    if b.below {
        const test = nextTemp(g)
        g.out.push("  {test} = icmp slt {a.ty} {value}, {b.min}\n")
        const clamped = nextTemp(g)
        g.out.push("  {clamped} = select i1 {test}, {a.ty} {b.min}, {a.ty} {value}\n")
        value = clamped
    }
    if b.above {
        const test = nextTemp(g)
        const cmp = if isSigned(c, rv.a.ty) { "sgt" } else { "ugt" }
        g.out.push("  {test} = icmp {cmp} {a.ty} {value}, {b.max}\n")
        const clamped = nextTemp(g)
        g.out.push("  {clamped} = select i1 {test}, {a.ty} {b.max}, {a.ty} {value}\n")
        value = clamped
    }
    return castValue(g, c, p, rv.a.ty, rv.to, Value{ty: a.ty, text: value})
}

fn floatFnName(f: FloatFn) str {
    const name = match f {
        FloatFn.Sqrt => "sqrt"
        FloatFn.Fabs => "fabs"
        FloatFn.Floor => "floor"
        FloatFn.Ceil => "ceil"
        FloatFn.Minnum => "minnum"
        FloatFn.Maxnum => "maxnum"
    }
    return name.toOwned()
}

fn floatFnIndex(f: FloatFn) int {
    return match f {
        FloatFn.Sqrt => 0
        FloatFn.Fabs => 1
        FloatFn.Floor => 2
        FloatFn.Ceil => 3
        FloatFn.Minnum => 4
        FloatFn.Maxnum => 5
    }
}

fn floatFn(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, rv: &Rvalue) Value {
    const binary = rv.floatFn == FloatFn.Minnum || rv.floatFn == FloatFn.Maxnum
    const a = operand(g, c, p, body, &rv.a)
    const b = if binary { operand(g, c, p, body, &rv.b) } else { a.clone() }   // loads first
    const isF64 = a.ty == "double"
    g.floatFnUsed[floatFnIndex(rv.floatFn) * 2 + if isF64 { 1 } else { 0 }] = true
    const t = nextTemp(g)
    const suffix = if isF64 { "f64" } else { "f32" }
    g.out.push("  {t} = call {a.ty} @llvm.{floatFnName(rv.floatFn)}.{suffix}({a.ty} {a.text}")
    if binary {
        g.out.push(", {b.ty} {b.text}")
    }
    g.out.push(")\n")
    return Value{ty: a.ty, text: t}
}

// The value `v` as an atomic instruction takes it: an `i1` becomes `i8`.
fn widen(g: mut Gen, v: str, isBool: bool) str {
    if !isBool {
        return v.toOwned()
    }
    const t = nextTemp(g)
    g.out.push("  {t} = zext i1 {v} to i8\n")
    return t
}

// The result of an atomic instruction, narrowed back to `i1` for a bool.
fn narrow(g: mut Gen, raw: str, isBool: bool) str {
    if !isBool {
        return raw.toOwned()
    }
    const t = nextTemp(g)
    g.out.push("  {t} = trunc i8 {raw} to i1\n")
    return t
}

// The atomic intrinsics (ADR 0042): `load atomic`, `store atomic`,
// `atomicrmw`, `cmpxchg` and `fence`. A `bool` is a byte in memory; LLVM
// atomics need a whole byte, so a bool is widened to `i8` around the
// instruction.
fn atomic(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, rv: &Rvalue,
          ty: move str) Value {
    const orders = ["monotonic", "acquire", "release", "acq_rel", "seq_cst"]
    const order = &orders[rv.flag]
    if rv.to == ATOMIC_FENCE {
        g.out.push("  fence {order}\n")
        return Value{ty: ty, text: ""}
    }
    const inner = llvmType(g, c, p, c.types.get(rv.a.ty).inner)
    const isBool = inner == "i1"
    const vt = if isBool { "i8".toOwned() } else { inner.clone() }
    const align = if vt == "i8" { 1 } else if vt == "i16" { 2 } else if vt == "i32" { 4 } else { 8 }
    const at = operand(g, c, p, body, &rv.a).text
    if rv.to == ATOMIC_LOAD {
        const raw = nextTemp(g)
        g.out.push("  {raw} = load atomic {vt}, ptr {at} {order}, align {align}\n")
        return Value{ty: ty, text: narrow(g, raw, isBool)}
    }
    const b = operand(g, c, p, body, &rv.b).text
    const value = widen(g, b, isBool)
    if rv.to == ATOMIC_STORE {
        g.out.push("  store atomic {vt} {value}, ptr {at} {order}, align {align}\n")
        return Value{ty: ty, text: ""}
    }
    if rv.to == ATOMIC_CAS {
        const fails = ["monotonic", "acquire", "monotonic", "acquire", "seq_cst"]
        const d = operand(g, c, p, body, &rv.items[0]).text
        const desired = widen(g, d, isBool)
        const pair = nextTemp(g)
        g.out.push("  {pair} = cmpxchg ptr {at}, {vt} {value}, {vt} {desired} {order} ")
        g.out.push("{fails[rv.flag]}, align {align}\n")
        const raw = nextTemp(g)
        g.out.push("  {raw} = extractvalue \{ {vt}, i1 \} {pair}, 0\n")
        return Value{ty: ty, text: narrow(g, raw, isBool)}
    }
    const ops = ["", "", "xchg", "add", "sub"]
    const raw = nextTemp(g)
    g.out.push("  {raw} = atomicrmw {ops[rv.to]} ptr {at}, {vt} {value} {order}, align {align}\n")
    return Value{ty: ty, text: narrow(g, raw, isBool)}
}

fn rvalue(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, rv: &Rvalue,
          destType: int) Value {
    const ty = llvmType(g, c, p, destType)
    match rv.kind {
        RvalueKind.Use => {
            const v = operand(g, c, p, body, &rv.a)
            return Value{ty: ty, text: v.text}
        }
        RvalueKind.Binary => {
            const a = operand(g, c, p, body, &rv.a)
            const b = operand(g, c, p, body, &rv.b)
            const float = c.types.kind(rv.a.ty) == TyKind.Float
            const op = if float { floatOp(rv.op) } else { intOp(rv.op, isSigned(c, rv.a.ty)) }
            const t = nextTemp(g)
            g.out.push("  {t} = {op} {a.ty} {a.text}, {b.text}\n")
            return Value{ty: ty, text: t}
        }
        RvalueKind.Checked => {
            const a = operand(g, c, p, body, &rv.a)
            const b = operand(g, c, p, body, &rv.b)
            const signed = isSigned(c, rv.a.ty)
            const op = if rv.op == Op.Add { 0 } else if rv.op == Op.Sub { 1 } else { 2 }
            const width = c.types.get(rv.a.ty).data % 4
            g.overflowUsed[(if signed { 12 } else { 0 }) + op * 4 + width] = true
            const ops = ["add", "sub", "mul"]
            const pair = nextTemp(g)
            const sign = if signed { "s" } else { "u" }
            g.out.push("  {pair} = call \{ {a.ty}, i1 \} @llvm.{sign}{ops[op]}.with.overflow."
                       + "{a.ty}({a.ty} {a.text}, {a.ty} {b.text})\n")
            const result = nextTemp(g)
            g.out.push("  {result} = extractvalue \{ {a.ty}, i1 \} {pair}, 0\n")
            const flag = nextTemp(g)
            g.out.push("  {flag} = extractvalue \{ {a.ty}, i1 \} {pair}, 1\n")
            g.out.push("  store i1 {flag}, ptr %l{rv.flag}\n")
            return Value{ty: ty, text: result}
        }
        RvalueKind.Unary => {
            const a = operand(g, c, p, body, &rv.a)
            const t = nextTemp(g)
            if rv.op == Op.Neg {
                g.out.push("  {t} = fneg {a.ty} {a.text}\n")
            } else {
                g.out.push("  {t} = xor {a.ty} {a.text}, -1\n")   // also i1
            }
            return Value{ty: ty, text: t}
        }
        RvalueKind.Cast => {
            const a = operand(g, c, p, body, &rv.a)
            const v = castValue(g, c, p, rv.a.ty, rv.to, a)
            return Value{ty: ty, text: v.text}
        }
        RvalueKind.CastFails => {
            const v = castFails(g, c, p, body, rv)
            return Value{ty: ty, text: v.text}
        }
        RvalueKind.Saturate => {
            const v = saturate(g, c, p, body, rv)
            return Value{ty: ty, text: v.text}
        }
        RvalueKind.PtrAdd => {
            const a = operand(g, c, p, body, &rv.a)
            const n = operand(g, c, p, body, &rv.b)
            const elem = fieldType(g, c, p, c.types.get(rv.a.ty).inner)   // `()` steps by 0
            const t = nextTemp(g)
            g.out.push("  {t} = getelementptr {elem}, ptr {a.text}, i64 {n.text}\n")
            return Value{ty: ty, text: t}
        }
        RvalueKind.Aggregate => {   // insertvalue of each field into poison
            let current = "poison".toOwned()
            let slots: List<int> = []
            if isStruct(c, destType) {
                slots = fieldSlots(g, c, p, destType)
            }
            for i in 0..rv.items.len() {
                const field = operand(g, c, p, body, &rv.items[i])
                if field.ty == "void" {
                    continue   // a field of type (): nothing to store
                }
                const next = nextTemp(g)
                const slot = if i < slots.len() { slots[i] } else { i }
                g.out.push("  {next} = insertvalue {ty} {current}, {field.ty} {field.text}, "
                           + "{slot}\n")
                current = next
            }
            return Value{ty: ty, text: current}
        }
        RvalueKind.SizeOf => {   // the address of element 1 from null is the size
            const end = nextTemp(g)
            const t = fieldType(g, c, p, rv.to)
            g.out.push("  {end} = getelementptr {t}, ptr null, i32 1\n")
            const result = nextTemp(g)
            g.out.push("  {result} = ptrtoint ptr {end} to i64\n")
            return Value{ty: ty, text: result}
        }
        RvalueKind.AlignOf => {   // the offset of a `T` after an `i1` is its alignment
            const end = nextTemp(g)
            const t = fieldType(g, c, p, rv.to)
            g.out.push("  {end} = getelementptr \{ i1, {t} \}, ptr null, i32 0, i32 1\n")
            const result = nextTemp(g)
            g.out.push("  {result} = ptrtoint ptr {end} to i64\n")
            return Value{ty: ty, text: result}
        }
        RvalueKind.StrLen => {
            const s = operand(g, c, p, body, &rv.a)
            const t = nextTemp(g)
            g.out.push("  {t} = extractvalue %ofir.str {s.text}, 1\n")
            return Value{ty: ty, text: t}
        }
        RvalueKind.StrByte => {
            const s = operand(g, c, p, body, &rv.a)
            const i = operand(g, c, p, body, &rv.b)
            const ptr = nextTemp(g)
            g.out.push("  {ptr} = extractvalue %ofir.str {s.text}, 0\n")
            const at = nextTemp(g)
            g.out.push("  {at} = getelementptr inbounds i8, ptr {ptr}, i64 {i.text}\n")
            const t = nextTemp(g)
            g.out.push("  {t} = load i8, ptr {at}\n")
            return Value{ty: ty, text: t}
        }
        RvalueKind.FloatFn => {
            const v = floatFn(g, c, p, body, rv)
            return Value{ty: ty, text: v.text}
        }
        RvalueKind.FnValue => {
            if c.types.isCFn(destType) {   // the C symbol itself (spec 11.3)
                if c.def(rv.flag).member >= 0 {
                    for g.cUsed.len() <= rv.flag {
                        g.cUsed.push(false)
                    }
                    g.cUsed[rv.flag] = true
                }
                return Value{ty: ty, text: functionName(c, p, rv.flag, UNIT, false)}
            }
            for g.fnValues.len() <= rv.flag {
                g.fnValues.push(false)
            }
            g.fnValues[rv.flag] = true
            let env = "null"
            if rv.a.kind != OperandKind.Unit {
                env = operand(g, c, p, body, &rv.a).text
            }
            const code = nextTemp(g)
            const thunk = thunkName(c, p, rv.flag)
            g.out.push("  {code} = insertvalue {FN_LLVM} undef, ptr {thunk}, 0\n")
            const t = nextTemp(g)
            g.out.push("  {t} = insertvalue {FN_LLVM} {code}, ptr {env}, 1\n")
            return Value{ty: ty, text: t}
        }
        RvalueKind.GlobalAddr => {
            for g.mutGlobals.len() <= rv.flag {
                g.mutGlobals.push(false)
            }
            g.mutGlobals[rv.flag] = true
            return Value{ty: ty, text: globalName(c, rv.flag)}
        }
        RvalueKind.Atomic => {
            return atomic(g, c, p, body, rv, ty)
        }
        RvalueKind.Unsize => {
            const thin = operand(g, c, p, body, &rv.a)
            const iface = c.types.get(dynObject(c, rv.to)).data
            const vt = vtable(g, rv.b.ty, iface, rv.flag == 1)
            let data = thin.text.clone()
            const boxed = boxInner(c, rv.to).isSome()
            if boxed {
                data = nextTemp(g)
                g.out.push("  {data} = extractvalue {thin.ty} {thin.text}, 0\n")
            }
            const half = nextTemp(g)
            g.out.push("  {half} = insertvalue {FN_LLVM} undef, ptr {data}, 0\n")
            const fat = nextTemp(g)
            g.out.push("  {fat} = insertvalue {FN_LLVM} {half}, ptr @\"ofir.vt{vt}\", 1\n")
            if !boxed {
                return Value{ty: ty, text: fat}
            }
            const t = nextTemp(g)
            g.out.push("  {t} = insertvalue {ty} undef, {FN_LLVM} {fat}, 0\n")
            return Value{ty: ty, text: t}
        }
        RvalueKind.DynFn => {
            const fat = operand(g, c, p, body, &rv.a)
            const data = nextTemp(g)
            g.out.push("  {data} = extractvalue {FN_LLVM} {fat.text}, 0\n")
            const vt = nextTemp(g)
            g.out.push("  {vt} = extractvalue {FN_LLVM} {fat.text}, 1\n")
            const at = nextTemp(g)
            g.out.push("  {at} = getelementptr inbounds ptr, ptr {vt}, i64 {rv.flag + 4}\n")
            const code = nextTemp(g)
            g.out.push("  {code} = load ptr, ptr {at}\n")
            const half = nextTemp(g)
            g.out.push("  {half} = insertvalue {FN_LLVM} undef, ptr {code}, 0\n")
            const t = nextTemp(g)
            g.out.push("  {t} = insertvalue {FN_LLVM} {half}, ptr {data}, 1\n")
            return Value{ty: ty, text: t}
        }
        RvalueKind.TypeId => {
            const fat = operand(g, c, p, body, &rv.a)
            const vt = nextTemp(g)
            g.out.push("  {vt} = extractvalue {FN_LLVM} {fat.text}, 1\n")
            const at = nextTemp(g)
            g.out.push("  {at} = getelementptr inbounds ptr, ptr {vt}, i64 3\n")
            const slot = nextTemp(g)
            g.out.push("  {slot} = load ptr, ptr {at}\n")
            const t = nextTemp(g)
            g.out.push("  {t} = ptrtoint ptr {slot} to i64\n")
            return Value{ty: ty, text: t}
        }
        RvalueKind.Closure => {
            let env = "null"
            if rv.a.kind != OperandKind.Unit &&
               c.types.kind(rv.a.ty) == TyKind.Tuple {   // `move`: on the heap
                const values = operand(g, c, p, body, &rv.a)
                const envType = "\{ ptr, {values.ty} \}"
                const size = nextTemp(g)
                g.out.push("  {size} = ptrtoint ptr getelementptr ({envType}, ptr null, ")
                g.out.push("i32 1) to i64\n")
                env = nextTemp(g)
                const align = layout(g, c, p, rv.a.ty).align
                if align > 16 {   // above malloc's alignment
                    g.alignedHeap = true
                    g.out.push("  {env} = call ptr @ofir_alloc_aligned(i64 {size}, i64 {align})\n")
                } else {
                    g.out.push("  {env} = call ptr @ofir_alloc(i64 {size})\n")
                }
                const drop = closureName(c, p, body.def, body.targs, rv.flag)
                g.out.push("  store ptr {dropName(drop)}, ptr {env}\n")
                const field = nextTemp(g)
                g.out.push("  {field} = getelementptr inbounds {envType}, ptr {env}, ")
                g.out.push("i32 0, i32 1\n")
                g.out.push("  store {values.ty} {values.text}, ptr {field}\n")
                g.heap = true
            } else if rv.a.kind != OperandKind.Unit {
                env = operand(g, c, p, body, &rv.a).text
            }
            const code = nextTemp(g)
            const name = closureName(c, p, body.def, body.targs, rv.flag)
            g.out.push("  {code} = insertvalue {FN_LLVM} undef, ptr {name}, 0\n")
            const t = nextTemp(g)
            g.out.push("  {t} = insertvalue {FN_LLVM} {code}, ptr {env}, 1\n")
            return Value{ty: ty, text: t}
        }
    }
}

// The function of the closure `id` of a function: it takes the environment first.
fn closureName(c: mut Checker, p: Program, def: int, targs: int, id: int) str {
    const name = functionName(c, p, def, targs, false)
    if isCFunction(c, p, def) {
        return "@\"{name.slice(1, name.len())}.c{id}\""
    }
    return "{name.slice(0, name.len() - 1)}.c{id}\""
}

// The function that drops a `move` closure's captured values.
fn dropName(closure: str) str {
    return "{closure.slice(0, closure.len() - 1)}.drop\""
}

// The LLVM type of a function value: the code and the environment.
const FN_LLVM: str = "\{ ptr, ptr \}"

// The thunk of a function used as a value: it takes the environment first.
fn thunkName(c: mut Checker, p: Program, id: int) str {
    const name = functionName(c, p, id, UNIT, false)
    return "{name.slice(0, name.len() - 1)}.fv\""
}

// A call of a function value: `args[0]` is the value.
fn valueCall(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, s: &AirStmt) {
    let values: List<Value> = []
    for i in 0..s.args.len() {
        values.push(operand(g, c, p, body, &s.args[i]))
    }
    const retType = c.types.get(s.args[0].ty).inner
    const ret = llvmType(g, c, p, retType)
    if c.types.isCFn(s.args[0].ty) {
        cPointerCall(g, c, p, body, s, &values, retType)
        return
    }
    const code = nextTemp(g)
    g.out.push("  {code} = extractvalue {FN_LLVM} {values[0].text}, 0\n")
    const env = nextTemp(g)
    g.out.push("  {env} = extractvalue {FN_LLVM} {values[0].text}, 1\n")
    const hasDest = s.hasDest && hasValue(c, retType)
    let result = ""
    if hasDest {
        result = nextTemp(g)
        g.out.push("  {result} = ")
    } else {
        g.out.push("  ")
    }
    g.out.push("call fastcc {ret} {code}(ptr {env}")
    for i in 1..values.len() {
        if values[i].ty != "void" {
            g.out.push(", {values[i].ty} {values[i].text}")
        }
    }
    g.out.push(")\n")
    if hasDest {
        storeAt(g, c, p, body, s.dest, &noPath(), &Value{ty: ret, text: result})
    }
}

// A call through a C function pointer: the C calling convention, no
// environment, and a `bool` result widened as C returns it.
fn cPointerCall(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, s: &AirStmt,
                values: &List<Value>, retType: int) {
    const ret = llvmType(g, c, p, retType)
    const hasDest = s.hasDest && hasValue(c, retType)
    let result = ""
    if hasDest {
        result = nextTemp(g)
        g.out.push("  {result} = ")
    } else {
        g.out.push("  ")
    }
    const zext = if ret == "i1" { "zeroext " } else { "" }
    g.out.push("call {zext}{ret} {values[0].text}(")
    let first = true
    for i in 1..values.len() {
        if values[i].ty != "void" {
            if !first {
                g.out.push(", ")
            }
            first = false
            const ext = if values[i].ty == "i1" { "zeroext " } else { "" }
            g.out.push("{values[i].ty} {ext}{values[i].text}")
        }
    }
    g.out.push(")\n")
    if hasDest {
        storeAt(g, c, p, body, s.dest, &noPath(), &Value{ty: ret, text: result})
    }
}

// The symbol of the mutable global `id`: `@"ofir.g.<module>.<name>"`.
fn globalName(c: Checker, id: int) str {
    const def = c.def(id)
    let out = "@\"ofir.g."
    if def.module != 0 {
        out.push(c.r.moduleNames[def.module])
        out.push(".")
    }
    out.push(c.text(def.name))
    out.push("\"")
    return out
}

// The definitions of the mutable globals used, with their initial values.
fn mutGlobals(g: mut Gen, c: mut Checker, p: Program) {
    for id in 0..g.mutGlobals.len() {
        if !g.mutGlobals[id] {
            continue
        }
        const ty = c.info[id].ty
        const llty = llvmType(g, c, p, ty)
        let init = "zeroinitializer".toOwned()
        if const Option.Some(v) = c.info[id].value {
            init = if c.types.kind(ty) == TyKind.Ptr {   // `0 as *T`
                "null".toOwned()
            } else {
                match v.kind {
                    ConstKind.Int => intText(v.bits, intBits(c.types.get(ty).data))
                    ConstKind.Float => floatText(v.f, c.types.get(ty).data == 32)
                    ConstKind.Bool => if v.b { "true".toOwned() } else { "false".toOwned() }
                    ConstKind.Str => "zeroinitializer".toOwned()
                }
            }
        }
        const linkage = if g.units { "linkonce_odr hidden" } else { "internal" }   // shared
        const item = itemOf(p, c.loc(id))
        const tls = if findAttribute(c.r, item.attributes, "threadLocal").isSome() {
            "thread_local "
        } else {
            ""
        }
        g.module.push("\n{globalName(c, id)} = {linkage} {tls}global {llty} {init}\n")
    }
}

// The thunks of the functions used as values.
fn thunks(g: mut Gen, c: mut Checker, p: Program) {
    for id in 0..g.fnValues.len() {
        if !g.fnValues[id] || (id < g.thunked.len() && g.thunked[id]) {
            continue
        }
        for g.thunked.len() <= id {
            g.thunked.push(false)
        }
        g.thunked[id] = true
        const sig = c.info[id].ty
        const ret = llvmType(g, c, p, c.types.get(sig).inner)
        const args = c.types.get(sig).args.clone()
        let params = ""
        let forward = ""
        for i in 0..args.len() {
            const ty = llvmType(g, c, p, args[i])
            if ty != "void" {
                params.push(", {ty} %a{i}")
                forward.push("{if forward.len() > 0 { ", " } else { "" }}{ty} %a{i}")
            }
        }
        const thunk = thunkName(c, p, id)
        g.module.push("\ndefine internal fastcc {ret} {thunk}(ptr %env{params}) \{\n")
        const name = functionName(c, p, id, UNIT, false)
        if ret == "void" {
            g.module.push("  call fastcc void {name}({forward})\n  ret void\n\}\n")
        } else {
            g.module.push("  %r = call fastcc {ret} {name}({forward})\n  ret {ret} %r\n\}\n")
        }
    }
}

// The number of the vtable of a concrete type for an interface.
fn vtable(g: mut Gen, ty: int, iface: int, drops: bool) int {
    const key = ty * 4294967296 + iface
    if const Option.Some(found) = g.vtIds.get(key) {
        return *found
    }
    const id = g.vtTypes.len()
    g.vtTypes.push(ty)
    g.vtIfaces.push(iface)
    g.vtDrops.push(drops)
    g.vtIds.insert(key, id)
    return id
}

// The vtables: the drop glue, the size, the alignment, the type id (the
// concrete type's number, for type switches: spec 9.8), then a thunk per
// method, which takes the data pointer as `self` (spec 9.7).
fn vtables(g: mut Gen, c: mut Checker, p: Program) {
    for k in g.vtDone..g.vtTypes.len() {
        const ty = g.vtTypes[k]
        const slots = dynMethods(c, p, g.vtIfaces[k])
        const l = layout(g, c, p, ty)
        let drop = "@ofir.dyn.nodrop".toOwned()
        if g.vtDrops[k] {
            drop = functionName(c, p, GLUE_DROP, c.types.tuple([ty]), false)
        } else {
            g.noDrop = true
        }
        g.module.push("\n@\"ofir.vt{k}\" = internal constant [{slots.len() + 4} x ptr] [")
        g.module.push("ptr {drop}, ptr inttoptr (i64 {l.size} to ptr), ")
        g.module.push("ptr inttoptr (i64 {l.align} to ptr), ptr inttoptr (i64 {ty} to ptr)")
        for i in 0..slots.len() {
            g.module.push(", ptr @\"ofir.vt{k}.{i}\"")
        }
        g.module.push("]\n")
        for i in 0..slots.len() {
            if isAnyMethod(c, slots[i]) {
                typeNameThunk(g, c, p, ty, "@\"ofir.vt{k}.{i}\"")
            } else {
                vtableThunk(g, c, p, ty, slots[i], "@\"ofir.vt{k}.{i}\"")
            }
        }
    }
    g.vtDone = g.vtTypes.len()
}

// The drop of a vtable whose type needs none.
fn noDrop(g: mut Gen) {
    if g.noDrop {
        g.module.push("\ndefine internal fastcc void @ofir.dyn.nodrop(ptr %self) \{\n")
        g.module.push("  ret void\n\}\n")
    }
}

// `typeName` of `any` (spec 9.8), which the compiler provides: the name of
// the concrete type, as messages write it.
fn typeNameThunk(g: mut Gen, c: mut Checker, p: Program, ty: int, name: str) {
    const text = c.typeName(ty)
    const n = stringGlobal(g, text)
    const ret = llvmType(g, c, p, STR)
    g.module.push("\ndefine internal fastcc {ret} {name}(ptr %self) \{\n")
    g.module.push("  ret {ret} \{ ptr @.str.{n}, i64 {text.len()}, i64 0 \}\n\}\n")
}

// A vtable slot: calls the concrete type's method, converting `self` and
// the arguments passed by address or by value as the method takes them.
fn vtableThunk(g: mut Gen, c: mut Checker, p: Program, ty: int, id: int, name: str) {
    const target = dynSlotTarget(c, p, ty, id)
    const sig = c.info[target.def].ty
    const targs = c.types.get(target.targs).args.clone()
    const ret = llvmType(g, c, p, c.types.subst(c.types.get(sig).inner, targs.clone()))
    const params = c.types.get(sig).args.clone()
    let head = "\ndefine internal fastcc {ret} {name}(ptr %self"
    let body = ""
    let forward = ""
    if byAddress(c, p, target.def, -1) {
        forward.push("ptr %self")
    } else {
        const selfType = llvmType(g, c, p, ty)
        if selfType != "void" {
            body.push("  %s = load {selfType}, ptr %self\n")
            forward.push("{selfType} %s")
        }
    }
    for i in 0..params.len() {   // the signature leaves `self` out
        const index = i
        const pty = llvmType(g, c, p, c.types.subst(params[i], targs.clone()))
        if pty == "void" {
            continue
        }
        const given = byAddress(c, p, id, index)
        const taken = byAddress(c, p, target.def, index)
        const givenType = if given { "ptr".toOwned() } else { pty.clone() }
        const takenType = if taken { "ptr".toOwned() } else { pty.clone() }
        head.push(", {givenType} %a{i}")
        let arg = "{takenType} %a{i}"
        if given && !taken {
            body.push("  %v{i} = load {pty}, ptr %a{i}\n")
            arg = "{pty} %v{i}"
        } else if taken && !given {
            body.push("  %m{i} = alloca {pty}\n  store {pty} %a{i}, ptr %m{i}\n")
            arg = "ptr %m{i}"
        }
        forward.push("{if forward.len() > 0 { ", " } else { "" }}{arg}")
    }
    g.module.push(head)
    g.module.push(") \{\n")
    g.module.push(body)
    const callee = functionName(c, p, target.def, target.targs, false)
    if ret == "void" {
        g.module.push("  call fastcc void {callee}({forward})\n  ret void\n\}\n")
    } else {
        g.module.push("  %r = call fastcc {ret} {callee}({forward})\n  ret {ret} %r\n\}\n")
    }
}

// Drop glue of a `dyn I`: the drop function in its vtable, on its data.
fn dropDyn(g: mut Gen) {
    g.out.push("  %dyn.data = extractvalue {FN_LLVM} %p1, 0\n")
    g.out.push("  %dyn.vt = extractvalue {FN_LLVM} %p1, 1\n")
    g.out.push("  %dyn.drop = load ptr, ptr %dyn.vt\n")
    g.out.push("  call fastcc void %dyn.drop(ptr %dyn.data)\n")
}

// ---------------------------------------------------------------------------
// Bodies

fn storeAt(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, dest: int,
           path: &FieldPath, v: &Value) {
    if v.ty != "void" {
        const at = placeAddress(g, c, p, body, dest, path)
        if g.nicheTag >= 0 {
            nicheTagStore(g, c, p, at, v)
            return
        }
        g.out.push("  store {v.ty} {v.text}, ptr {at}{packedAlign(g)}\n")
    }
}

// `, align 1` for a field of a `@packed` struct, whose address may not be
// aligned.
fn packedAlign(g: Gen) str {
    return if g.packedPlace { ", align 1" } else { "" }
}

fn runtimeCall(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, s: &AirStmt) {
    let args: List<Value> = []
    for i in 0..s.args.len() {
        args.push(operand(g, c, p, body, &s.args[i]))
    }
    const ret = match s.rt {
        RuntimeFn.TestIndex => "i64"
        _ => "void"
    }
    if s.rt == RuntimeFn.Free {
        g.heap = true   // declared with `ofir_alloc`
    }
    if s.rt == RuntimeFn.StrPushFixed {
        g.formats = true
    }
    let result = ""
    if s.hasDest {
        result = nextTemp(g)
        g.out.push("  {result} = ")
    } else {
        g.out.push("  ")
    }
    g.out.push("call {ret} @{runtimeName(s.rt)}(")
    for i in 0..args.len() {
        const zext = if args[i].ty == "i1" { " zeroext" } else { "" }
        g.out.push("{if i > 0 { ", " } else { "" }}{args[i].ty}{zext} {args[i].text}")
    }
    g.out.push(")\n")
    if s.hasDest {
        storeAt(g, c, p, body, s.dest, &noPath(), &Value{ty: ret.toOwned(), text: result})
    }
}

fn userCall(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, s: &AirStmt) {
    if s.callee == CALL_VALUE {
        valueCall(g, c, p, body, s)
        return
    }
    let values: List<Value> = []
    for i in 0..s.args.len() {
        values.push(operand(g, c, p, body, &s.args[i]))
    }
    const glue = isGlue(s.callee)
    const cfn = !glue && isCFunction(c, p, s.callee)
    if cfn && c.def(s.callee).member >= 0 {
        for g.cUsed.len() <= s.callee {
            g.cUsed.push(false)
        }
        g.cUsed[s.callee] = true
    }
    let retType = UNIT
    if s.callee == GLUE_CLONE {
        retType = c.types.get(s.targs).args[0]   // clone<T> returns T
    } else if s.callee == GLUE_EQ {
        retType = BOOL
    } else if s.callee == GLUE_HASH {
        retType = U64
    } else if s.callee == GLUE_CMP {
        retType = I32   // the tag of an `Ordering`
    } else if !glue {
        const sig = c.info[s.callee].ty
        const args = c.types.get(s.targs).args.clone()
        retType = c.types.subst(c.types.get(sig).inner, args)
    }
    const ret = llvmType(g, c, p, retType)
    const hasDest = s.hasDest && hasValue(c, retType)   // an instance may return ()
    let result = ""
    if hasDest {
        result = nextTemp(g)
        g.out.push("  {result} = ")
    } else {
        g.out.push("  ")
    }
    const zext = cfn && ret == "i1"
    g.out.push("call {if cfn { "" } else { "fastcc " }}{if zext { "zeroext " } else { "" }}{ret} ")
    g.out.push(functionName(c, p, s.callee, s.targs, false))
    g.out.push("(")
    let first = true
    for i in 0..values.len() {
        if values[i].ty != "void" {   // () arguments are not passed
            const attr = if cfn && values[i].ty == "i1" { " zeroext" } else { "" }
            g.out.push("{if first { "" } else { ", " }}{values[i].ty}{attr} {values[i].text}")
            first = false
        }
    }
    g.out.push(")\n")
    if hasDest {
        storeAt(g, c, p, body, s.dest, &noPath(), &Value{ty: ret, text: result})
    }
}

fn statement(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, s: &AirStmt) {
    if s.kind == StmtKind.Call {
        if s.runtime {
            runtimeCall(g, c, p, body, s)
        } else {
            userCall(g, c, p, body, s)
        }
        return
    }
    let ty = body.locals[s.dest].ty
    if s.destPath.fields.len() > 0 || s.destPath.deref {   // a field or `*p`: the operand's type
        ty = s.value.a.ty
    } else if body.locals[s.dest].byRef {   // a binding given an address
        ty = s.value.a.ty
    }
    const v = rvalue(g, c, p, body, &s.value, ty)
    storeAt(g, c, p, body, s.dest, &s.destPath, &v)
}

fn panicFn(kind: PanicKind) str {
    const name = match kind {
        PanicKind.Overflow => "ofir_panic_overflow"
        PanicKind.DivZero => "ofir_panic_div_zero"
        PanicKind.Shift => "ofir_panic_shift"
        PanicKind.Cast => "ofir_panic_cast"
        PanicKind.Bounds => "ofir_panic_bounds"
        PanicKind.Assert => "ofir_panic_assert"
    }
    return name.toOwned()
}

fn terminator(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, t: &Terminator,
              index: int) {
    match t.kind {
        TermKind.Goto => g.out.push("  br label %bb{t.target}\n")
        TermKind.Branch => {
            const cond = operand(g, c, p, body, &t.cond)
            g.out.push("  br i1 {cond.text}, label %bb{t.target}, label %bb{t.other}\n")
        }
        TermKind.Assert => {   // the failing branch calls the panic function with the location
            const cond = operand(g, c, p, body, &t.cond)
            const loc = locationGlobal(g, c, t.span)
            g.out.push("  br i1 {cond.text}, label %panic{index}, label %bb{t.target}\n")
            g.out.push("panic{index}:\n")
            if t.panic == PanicKind.Bounds {   // the message shows the index and the length
                const i = operand(g, c, p, body, &t.index)
                const len = operand(g, c, p, body, &t.len)
                g.out.push("  call void @ofir_panic_bounds(i64 {i.text}, i64 {len.text}, "
                           + "ptr @.loc.{loc})\n")
            } else {
                g.out.push("  call void @{panicFn(t.panic)}(ptr @.loc.{loc})\n")
            }
            g.out.push("  unreachable\n")
        }
        TermKind.Panic => {
            const msg = operand(g, c, p, body, &t.cond)
            const loc = locationGlobal(g, c, t.span)
            g.out.push("  call void @ofir_panic_str(ptr {msg.text}, ptr @.loc.{loc})\n")
            g.out.push("  unreachable\n")
        }
        TermKind.Return => {
            const ret = body.locals[0].ty
            if hasValue(c, ret) {
                const v = operand(g, c, p, body, &opCopy(0, ret))
                g.out.push("  ret {v.ty} {v.text}\n")
            } else {
                g.out.push("  ret void\n")
            }
        }
        TermKind.Unreachable | TermKind.None => g.out.push("  unreachable\n")
    }
}

// Drop glue of a `move fn`: its environment, if it has one, is dropped by
// the function its first field points to, then freed.
fn dropFnEnv(g: mut Gen) {
    g.heap = true
    g.out.push("  %fn.envp = getelementptr inbounds {FN_LLVM}, ptr %p1, i32 0, i32 1\n")
    g.out.push("  %fn.env = load ptr, ptr %fn.envp\n")
    g.out.push("  %fn.none = icmp eq ptr %fn.env, null\n")
    g.out.push("  br i1 %fn.none, label %bb0, label %fn.drop\n")
    g.out.push("fn.drop:\n")
    g.out.push("  %fn.dropfn = load ptr, ptr %fn.env\n")
    g.out.push("  call fastcc void %fn.dropfn(ptr %fn.env)\n")
    g.out.push("  call void @ofir_free(ptr %fn.env)\n")
}

fn localType(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, i: int) str {
    const local = &body.locals[i]
    return if local.byRef { "ptr".toOwned() } else { llvmType(g, c, p, local.ty) }
}

// ---------------------------------------------------------------------------
// Debug info (codegen/debug.of)

// The `DIFile` of a source file.
fn debugFile(g: mut Gen, c: Checker, id: FileId) int {
    let path = ""
    escapedBytes(path, c.r.map.file(id).path)
    return g.di.file(id.0, path, g.dir)
}

// The `DISubprogram` of `body`, `define`d as `@symbol(...`: named as in the
// source, except a closure.
fn subprogram(g: mut Gen, c: Checker, body: &AirBody, header: str) int {
    let symbol = header.slice(1, header.find("(") ?? header.len())   // without `@`
    if symbol.startsWith("\"") {
        symbol = symbol.slice(1, symbol.len() - 1)
    }
    let name = symbol.toOwned()
    if body.isMain {
        name = "main".toOwned()
    } else if body.closure.isNone() {
        name = ""
        escapedBytes(name, c.text(body.name))
    }
    const line = c.r.map.file(body.span.file).lineCol(body.span.start).line
    const file = debugFile(g, c, body.span.file)
    return g.di.subprogram(name, file, line)
}

// The name of a type in debug info, escaped for LLVM.
fn debugTypeName(c: Checker, ty: int) str {
    let name = ""
    escapedBytes(name, c.typeName(ty))
    return name
}

// The debug type node of `ty`: bool, integers and floats are basic types,
// a thin reference or pointer points to its pointee, a struct has its
// fields as members, and any other type is a struct of its size with no
// members.
fn debugType(g: mut Gen, c: mut Checker, p: Program, ty: int) int {
    if const Option.Some(n) = g.di.typeNode(ty) {
        return n
    }
    const t = c.types.get(ty)
    const kind = t.kind
    const data = t.data
    const inner = t.inner
    const name = debugTypeName(c, ty)
    if kind == TyKind.Bool {
        return g.di.basicType(ty, name, 8, "DW_ATE_boolean")
    }
    if kind == TyKind.Int {
        const encoding = if isSigned(c, ty) { "DW_ATE_signed" } else { "DW_ATE_unsigned" }
        return g.di.basicType(ty, name, intBits(data), encoding)
    }
    if kind == TyKind.Float {
        return g.di.basicType(ty, name, data, "DW_ATE_float")
    }
    if (kind == TyKind.Ref || kind == TyKind.Ptr) && !c.types.isFat(ty) {
        const n = g.di.reserveType(ty)
        const pointee = debugType(g, c, p, inner)
        g.di.pointerTo(n, name, pointee)
        return n
    }
    const bits = layout(g, c, p, ty).size * 8
    const n = g.di.reserveType(ty)
    let members: List<int> = []
    if kind == TyKind.Adt && c.def(data).kind == DefKind.Struct && c.info[data].fields.isSome() {
        members = debugMembers(g, c, p, ty, n)
    } else if kind == TyKind.Str {
        members = strMembers(g, n)
    }
    g.di.structType(n, name, bits, &members)
    return n
}

// The members of `str` (runtime/include/ofir_rt.h), whose node is
// `scope`: its bytes as characters, so that a debugger prints the text,
// its length and its capacity. Their types have no type of the program, so
// they are kept under negative numbers.
fn strMembers(g: mut Gen, scope: int) List<int> {
    const byte = match g.di.typeNode(-1) {
        Option.Some(n) => n
        Option.None => g.di.basicType(-1, "char", 8, "DW_ATE_unsigned_char")
    }
    const bytes = match g.di.typeNode(-2) {
        Option.Some(n) => n
        Option.None => {
            const n = g.di.reserveType(-2)
            g.di.pointerTo(n, "", byte)
            n
        }
    }
    const word = match g.di.typeNode(-3) {
        Option.Some(n) => n
        Option.None => g.di.basicType(-3, "i64", 64, "DW_ATE_signed")
    }
    let members: List<int> = []
    members.push(g.di.member("ptr", scope, bytes, 64, 0))
    members.push(g.di.member("len", scope, word, 64, 64))
    members.push(g.di.member("cap", scope, word, 64, 128))
    return members
}

// The members of the struct type `ty`, whose node is `scope`, at the
// offsets of their slots.
fn debugMembers(g: mut Gen, c: mut Checker, p: Program, ty: int, scope: int) List<int> {
    const id = c.types.get(ty).data
    const declared = fieldTypes(c, p, ty, -1)
    const slots = fieldSlots(g, c, p, ty)
    const types = slotTypes(g, c, p, ty, &declared)
    const packed = isPacked(c, p, id)
    let offsets: List<int> = []
    let at = 0
    for i in 0..types.len() {
        const l = layout(g, c, p, types[i])
        if !packed {
            at = (at + l.align - 1) / l.align * l.align
        }
        offsets.push(at)
        at += l.size
    }
    const info = fieldsOf(c, id)
    const tuple = info.isTuple
    let names: List<str> = []
    for i in 0..declared.len() {
        names.push(if tuple { "{i}".toOwned() } else { c.text(info.names[i]).toOwned() })
    }
    let members: List<int> = []
    for i in 0..declared.len() {
        const fieldTy = debugType(g, c, p, declared[i])
        const bits = layout(g, c, p, declared[i]).size * 8
        const m = g.di.member(names[i], scope, fieldTy, bits, offsets[slots[i]] * 8)
        members.push(m)
    }
    return members
}

// With debug info, declares each named local of `body` to the debugger,
// after the prologue stored the parameters: through its pointer when it is
// held by reference, as a captured variable is.
fn declareLocals(g: mut Gen, c: mut Checker, p: Program, body: &AirBody, params: &List<int>) {
    let captured = List.filled(false, body.locals.len())
    if const Option.Some(info) = body.closure {
        for j in 0..info.captures.len() {
            captured[info.captures[j]] = true
        }
    }
    const file = debugFile(g, c, body.span.file)
    for i in 1..body.locals.len() {
        const local = &body.locals[i]
        const named = match local.name {
            Option.Some(sym) => c.text(sym).toOwned()
            Option.None => ""
        }
        if named.len() == 0 || named.startsWith("_") || !(local.byRef || hasValue(c, local.ty)) {
            continue
        }
        let arg = 0
        for k in 0..params.len() {
            if params[k] == i {
                arg = k + 1
            }
        }
        let name = ""
        escapedBytes(name, named)
        const ty = debugType(g, c, p, local.ty)
        const line = c.r.map.file(local.span.file).lineCol(local.span.start).line
        const v = g.di.variable(name, arg, g.scope, file, line, ty)
        const deref = local.byRef || captured[i]
        const expr = if deref { "!DIExpression(DW_OP_deref)" } else { "!DIExpression()" }
        g.out.push("  call void @llvm.dbg.declare(metadata ptr %l{i}, metadata !{v}, ")
        g.out.push("metadata {expr})\n")
    }
}

// With debug info, starts collecting the instructions of a statement:
// returns the function so far.
fn tagStart(g: mut Gen) str {
    if g.scope == 0 {
        return ""
    }
    return mem.replace(g.out, "")
}

// With debug info, appends the instructions collected since `tagStart` to
// `held`, each with the location of `span`.
fn tagEnd(g: mut Gen, c: Checker, held: move str, span: Span) {
    if g.scope == 0 {
        return
    }
    const pos = c.r.map.file(span.file).lineCol(span.start)
    tagLines(g, held, pos.line, pos.column)
}

// Appends the instructions collected since `tagStart` to `held`, each at
// `row` and `column`; row 0 is no line, as for the prologue, so that a
// debugger stops after it.
fn tagLines(g: mut Gen, held: move str, row: int, column: int) {
    const text = mem.replace(g.out, held)
    const loc = g.di.location(row, column, g.scope)
    for line in text.lines() {
        g.out.push(line)
        if line.startsWith("  ") {   // not a label
            g.out.push(", !dbg !{loc}")
        }
        g.out.push("\n")
    }
}

// The aliasing attributes of parameter `i` of a user function (spec 13.5),
// sound because the borrow checker has run: `mut` parameters and `&mut T`
// do not alias, other borrows are also read-only, unless what they point to
// has interior mutability.
fn aliasAttrs(c: mut Checker, p: Program, body: &AirBody, i: int) str {
    const local = &body.locals[i]
    let exclusive = false
    let target = local.ty
    if local.byRef {
        exclusive = local.exclusive
    } else {
        const t = c.types.get(local.ty)
        if t.kind != TyKind.Ref || c.types.isFat(local.ty) {
            return ""
        }
        exclusive = t.data == 1
        target = t.inner
    }
    if exclusive {
        return " noalias"
    }
    return if hasInteriorMutability(c, p, target) { "" } else { " noalias readonly" }
}

fn genBody(g: mut Gen, c: mut Checker, p: Program, body: &AirBody) {
    g.temp = 0
    const ret = body.locals[0].ty
    const closure = body.closure.isSome()
    const cfn = !closure && !isGlue(body.def) && isCFunction(c, p, body.def)   // callable from C
    let linkage = if body.isMain || cfn { "" } else { "internal fastcc " }
    const retType = if body.isMain { "void".toOwned() } else { llvmType(g, c, p, ret) }
    g.out.push("define ")
    g.linkAt = -1
    if g.units && linkage.len() > 0 {   // a unit's own functions: decided once all are known
        linkage = if g.linkonce { "linkonce_odr hidden fastcc " } else { "fastcc " }
        if !g.linkonce {
            g.linkAt = g.out.len()
        }
    }
    g.out.push(linkage)
    const sigAt = g.out.len()
    g.out.push("{retType} ")
    const nameAt = g.out.len()
    let params: List<int> = []
    if const Option.Some(info) = body.closure {
        const name = closureName(c, p, body.def, body.targs, info.id)
        if info.drop {
            g.out.push(dropName(name))
        } else {
            g.out.push(name)
        }
        g.out.push("(ptr %env")
        params = info.params.clone()
    } else {
        g.out.push(functionName(c, p, body.def, body.targs, body.isMain))
        g.out.push("(")
        for i in 1..body.paramCount + 1 {
            params.push(i)
        }
    }
    let first = !closure
    const plain = g.optimize && !closure && !cfn && !isGlue(body.def)
    for k in 0..params.len() {
        const i = params[k]
        const local = &body.locals[i]
        if local.byRef || hasValue(c, local.ty) {
            const attrs = if plain { aliasAttrs(c, p, body, i) } else { "" }
            g.out.push("{if first { "" } else { ", " }}{localType(g, c, p, body, i)}{attrs} %p{i}")
            first = false
        }
    }
    g.out.push(")")
    if g.units {
        const conv = if linkage.len() > 0 { "fastcc " } else { "" }
        g.declare = "declare {conv}{g.out.sliceFrom(sigAt)} nounwind\n"
    }
    g.out.push(" nounwind")
    if !closure && !isGlue(body.def) {
        g.out.push(hints(c, p, body.def))
    }
    g.scope = 0
    if g.debug && body.span.end > 0 {   // glue has no debug info
        g.scope = subprogram(g, c, body, g.out.sliceFrom(nameAt))
        g.out.push(" !dbg !{g.scope}")
    }
    g.out.push(" \{\nstart:\n")
    const prologue = tagStart(g)
    for i in 0..body.locals.len() {
        const local = &body.locals[i]
        if local.byRef || hasValue(c, local.ty) {
            g.out.push("  %l{i} = alloca {localType(g, c, p, body, i)}\n")
        }
    }
    for k in 0..params.len() {
        const i = params[k]
        const local = &body.locals[i]
        if local.byRef || hasValue(c, local.ty) {
            g.out.push("  store {localType(g, c, p, body, i)} %p{i}, ptr %l{i}\n")
        }
    }
    if const Option.Some(info) = body.closure {   // each captured variable, through the environment
        let envType = ""
        if info.env != 0 {
            envType = "\{ ptr, {llvmType(g, c, p, info.env)} \}"
        }
        if info.drop {   // the captured values
            g.out.push("  %values = getelementptr inbounds {envType}, ptr %env, i32 0, i32 1\n")
            g.out.push("  store ptr %values, ptr %l1\n")
        }
        for j in 0..info.captures.len() {
            const i = info.captures[j]
            if info.env != 0 {   // `move`: the value is in the environment
                g.out.push("  %cap.{j} = getelementptr inbounds {envType}, ptr %env, i32 0, ")
                g.out.push("i32 1, i32 {j}\n")
            } else {
                g.out.push("  %env.{j} = getelementptr inbounds ptr, ptr %env, i64 {j}\n")
                g.out.push("  %cap.{j} = load ptr, ptr %env.{j}\n")
            }
            g.out.push("  store ptr %cap.{j}, ptr %l{i}\n")
        }
    }
    // drop glue of a function value
    if body.def == GLUE_DROP && !body.isMain &&
       c.types.kind(c.types.get(body.targs).args[0]) == TyKind.Fn {
        dropFnEnv(g)
    }
    if body.def == GLUE_DROP && !body.isMain &&
       c.types.kind(c.types.get(body.targs).args[0]) == TyKind.Dyn {
        dropDyn(g)
    }
    if g.scope != 0 {
        declareLocals(g, c, p, body, &params)
    }
    g.out.push("  br label %bb0\n")
    if g.scope != 0 {
        tagLines(g, prologue, 0, 0)
    }
    for b in 0..body.blocks.len() {
        g.out.push("bb{b}:\n")
        const block = &body.blocks[b]
        for i in 0..block.stmts.len() {
            const held = tagStart(g)
            statement(g, c, p, body, &block.stmts[i])
            tagEnd(g, c, held, block.stmts[i].span)
        }
        const held = tagStart(g)
        terminator(g, c, p, body, &block.term, b)
        tagEnd(g, c, held, block.at)
    }
    g.out.push("\}\n\n")
}

// ---------------------------------------------------------------------------
// The module

fn runtimeDecls() str {
    let out = ""
    out.push("declare void @ofir_print_str(ptr) nounwind\n")
    out.push("declare void @ofir_print_int(i64) nounwind\n")
    out.push("declare void @ofir_print_uint(i64) nounwind\n")
    out.push("declare void @ofir_print_float(double) nounwind\n")
    out.push("declare void @ofir_print_f32(float) nounwind\n")
    out.push("declare void @ofir_print_bool(i1 zeroext) nounwind\n")
    out.push("declare void @ofir_print_newline() nounwind\n")
    out.push("declare i64 @ofir_test_index() nounwind\n")
    out.push("declare void @ofir_str_push_float(ptr, double) nounwind\n")
    out.push("declare void @ofir_str_push_f32(ptr, float) nounwind\n")
    out.push("declare void @ofir_panic_overflow(ptr) noreturn cold nounwind\n")
    out.push("declare void @ofir_panic_div_zero(ptr) noreturn cold nounwind\n")
    out.push("declare void @ofir_panic_shift(ptr) noreturn cold nounwind\n")
    out.push("declare void @ofir_panic_cast(ptr) noreturn cold nounwind\n")
    out.push("declare void @ofir_panic_bounds(i64, i64, ptr) noreturn cold nounwind\n")
    out.push("declare void @ofir_panic_assert(ptr) noreturn cold nounwind\n")
    out.push("declare void @ofir_panic_str(ptr, ptr) noreturn cold nounwind\n")
    return out
}

fn begin(g: mut Gen, c: mut Checker, p: Program, module: int) {
    const root = c.r.map.file(p.modules[module].module.file)
    let path = ""
    escapedBytes(path, root.path)
    g.module.push("; Generated by the Ofir stage 0 compiler.\nsource_filename = \"{path}\"\n\n")
    g.module.push("%ofir.str = type \{ ptr, i64, i64 \}\n")
    g.module.push("%ofir.loc = type \{ ptr, i32, i32 \}\n")
    if g.units {   // a unit defines the types it uses, as it uses them
        return
    }
    // Every struct is known after type checking. The definitions come first:
    // LLVM needs a type's size when a function allocates it.
    for i in 1..c.r.defs.len() {
        const def = c.def(i)
        const known = (def.kind == DefKind.Struct && c.info[i].fields.isSome() && !def.lang) ||
                      (def.kind == DefKind.Enum && c.info[i].variants.isSome())
        // A union's enum (`item < 0`) is generic: its instances come as used.
        if known && def.item >= 0 && itemTypeParams(itemOf(p, c.loc(i))).len() == 0 {
            const ty = c.types.adt(i, [])
            const _ = adtType(g, c, p, ty)
        }
    }
    g.module.push(g.typeDefs)
    g.module.push("\n")
    g.typeDefs = ""
}

// LLVM needs a struct type's definition before an instruction that sizes
// it, and the instances of generic types are defined as functions use
// them: the types a function defined are written first, then the function.
fn function(g: mut Gen, c: mut Checker, p: Program, body: &AirBody) {
    g.out.clear()
    genBody(g, c, p, body)
    if g.typeDefs.len() > 0 {
        g.module.push(g.typeDefs)
        g.module.push("\n")
        g.typeDefs = ""
    }
    if g.linkAt < 0 {
        g.module.push(g.out)
        return
    }
    g.module.push(g.out.slice(0, g.linkAt))   // the linkage is written by `units`
    g.parts.push(g.module.clone())
    g.links.push(g.body)
    g.module = ""
    g.module.push(g.out.sliceFrom(g.linkAt))
}

fn overflowDecls(g: mut Gen) {
    const ops = ["add", "sub", "mul"]
    const bits = [8, 16, 32, 64]
    for i in 0..24 {
        const s = i / 12
        const op = i / 4 % 3
        const b = i % 4
        if g.overflowUsed[i] {
            const n = bits[b]
            const sign = if s == 1 { "s" } else { "u" }
            g.module.push("declare \{ i{n}, i1 \} @llvm.{sign}{ops[op]}.with.overflow.i{n}(i{n}, "
                          + "i{n})\n")
        }
    }
}

fn floatDecls(g: mut Gen) {
    const names = ["sqrt", "fabs", "floor", "ceil", "minnum", "maxnum"]
    for f in 0..6 {
        for isF64 in 0..2 {
            if !g.floatFnUsed[f * 2 + isF64] {
                continue
            }
            const ty = if isF64 == 1 { "double" } else { "float" }
            const suffix = if isF64 == 1 { "f64" } else { "f32" }
            const second = if f >= 4 { ", {ty}" } else { "" }
            g.module.push("declare {ty} @llvm.{names[f]}.{suffix}({ty}{second})\n")
        }
    }
}

// `declare` for each function of an extern block that is called; several
// modules may declare the same C function.
fn cDecls(g: mut Gen, c: mut Checker, p: Program) {
    for id in 0..g.cUsed.len() {
        if !g.cUsed[id] {
            continue
        }
        let before = false
        for other in 0..id {
            if g.cUsed[other] && c.text(c.def(other).name) == c.text(c.def(id).name) {
                before = true
            }
        }
        if before {
            continue
        }
        const sig = c.info[id].ty
        const ret = llvmType(g, c, p, c.types.get(sig).inner)
        g.module.push("declare {if ret == "i1" { "zeroext " } else { "" }}{ret} ")
        g.module.push(functionName(c, p, id, UNIT, false))
        g.module.push("(")
        const args = c.types.get(sig).args.clone()
        for i in 0..args.len() {
            const ty = llvmType(g, c, p, args[i])
            const zext = if ty == "i1" { " zeroext" } else { "" }
            g.module.push("{if i > 0 { ", " } else { "" }}{ty}{zext}")
        }
        g.module.push(") nounwind\n")
    }
    if g.heap {   // `move` closures: unless the program declares them already
        heapDecl(g, c, "ofir_alloc", "declare ptr @ofir_alloc(i64) nounwind\n")
        heapDecl(g, c, "ofir_free", "declare void @ofir_free(ptr) nounwind\n")
    }
    if g.alignedHeap {
        heapDecl(g, c, "ofir_alloc_aligned",
                 "declare ptr @ofir_alloc_aligned(i64, i64) nounwind\n")
    }
}

fn heapDecl(g: mut Gen, c: mut Checker, name: str, decl: str) {
    for id in 0..g.cUsed.len() {
        if g.cUsed[id] && c.text(c.def(id).name) == name {
            return
        }
    }
    g.module.push(decl)
}

/**
 * The LLVM IR module of the lowered bodies, as stage 0's `--emit=llvm`
 * writes it.
 *
 * @param c the checker
 * @param p the program
 * @param bodies the bodies, in the order the lowering reached them
 * @param debug `-g`: with debug info, which stage 0 does not write
 * @returns the module's text
 */
pub fn generate(c: mut Checker, p: Program, bodies: &List<AirBody>, debug: bool,
                optimize: bool) str {
    let g = newGen()
    g.debug = debug
    g.optimize = optimize
    let root = 0
    if debug {
        escapedBytes(g.dir, os.currentDir().ok() ?? "")
        root = debugFile(g, c, p.modules[0].module.file)
    }
    begin(g, c, p, 0)
    for i in 0..bodies.len() {
        function(g, c, p, &bodies[i])
    }
    thunks(g, c, p)
    mutGlobals(g, c, p)
    vtables(g, c, p)
    noDrop(g)
    g.module.push(runtimeDecls())
    if g.debug {
        g.module.push("declare void @llvm.dbg.declare(metadata, metadata, metadata) nounwind\n")
    }
    if g.formats {
        g.module.push("declare void @ofir_str_push_fixed(ptr, double, i64) nounwind\n")
    }
    overflowDecls(g)
    floatDecls(g)
    cDecls(g, c, p)
    g.module.push("\n")
    g.module.push(g.globals)
    if debug {
        g.module.push("\n")
        g.module.push(g.di.finish(root, g.optimize))
    }
    return g.module
}

// ---------------------------------------------------------------------------
// Codegen units (ADR 0033)

/** A codegen unit: the code of one module, compiled to an object of its own. */
pub struct Unit {
    /** The module. */
    pub module: int
    /** The unit's LLVM IR. */
    pub text: str
}

// A unit as generated, before the linkage of its functions is known.
struct Draft {
    module: int
    parts: List<str>
    links: List<int>
    tail: str
    externs: List<int>
}

// What the units share while they are generated.
struct Shared {
    /** The body of each function name. */
    names: Map<str, int>
    /** By body: the module that owns it, or -1 for a `linkonce_odr` one. */
    owner: List<int>
    /** By body: its `declare`, once its unit generated it. */
    declares: List<str>
    /** By body: whether another unit calls it. */
    exported: List<bool>
}

// The name a body defines, as `genBody` writes it.
fn bodyName(c: mut Checker, p: Program, body: &AirBody) str {
    if const Option.Some(info) = body.closure {
        const name = closureName(c, p, body.def, body.targs, info.id)
        return if info.drop { dropName(name) } else { name }
    }
    return functionName(c, p, body.def, body.targs, body.isMain)
}

// A function of a module belongs to its unit; glue and the instances of
// generics are copied into each unit that uses them.
fn bodyOwner(c: Checker, body: &AirBody) int {
    if body.isMain {
        return 0
    }
    if isGlue(body.def) || body.targs != UNIT {
        return -1
    }
    return c.def(body.def).module
}

fn symbolByte(b: u8) bool {
    const letter = (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z')
    return letter || (b >= b'0' && b <= b'9') || b == b'_' || b == b'.' || b == b'$'
}

// The bodies whose names `text` refers to.
fn references(text: str, names: &Map<str, int>, found: mut List<int>) {
    let i = 0
    for i < text.len() {
        if text[i] != b'@' {
            i += 1
            continue
        }
        let end = i + 1
        if end < text.len() && text[end] == b'"' {
            end += 1
            for end < text.len() && text[end] != b'"' {
                end += 1
            }
            end = if end < text.len() { end + 1 } else { end }
        } else {
            for end < text.len() && symbolByte(text[end]) {
                end += 1
            }
        }
        if const Option.Some(j) = names.get(text.slice(i, end)) {
            found.push(*j)
        }
        i = end
    }
}

// Generates the unit of `module`: its functions, then each instance or glue
// they use, until no new one is used.
fn draft(c: mut Checker, p: Program, bodies: &List<AirBody>, module: int, s: mut Shared,
         debug: bool, optimize: bool) Draft {
    let g = newGen()
    g.units = true
    g.debug = debug
    g.optimize = optimize
    let root = 0
    if debug {
        escapedBytes(g.dir, os.currentDir().ok() ?? "")
        root = debugFile(g, c, p.modules[module].module.file)
    }
    begin(g, c, p, module)
    let queue: List<int> = []
    let inUnit = List.filled(false, bodies.len())
    let isExtern = List.filled(false, bodies.len())
    let externs: List<int> = []
    for i in 0..bodies.len() {
        if s.owner[i] == module {
            queue.push(i)
            inUnit[i] = true
        }
    }
    let next = 0
    for next < queue.len() {
        let found: List<int> = []
        for next < queue.len() {
            const i = queue[next]
            next += 1
            g.body = i
            g.linkonce = s.owner[i] < 0
            function(g, c, p, &bodies[i])
            if s.owner[i] >= 0 {
                s.declares[i] = g.declare.clone()
            }
            references(g.out, &s.names, found)
        }
        const mark = g.module.len()
        thunks(g, c, p)
        vtables(g, c, p)
        references(g.module.sliceFrom(mark), &s.names, found)
        for k in 0..found.len() {
            const j = found[k]
            if s.owner[j] < 0 && !inUnit[j] {
                inUnit[j] = true
                queue.push(j)
            } else if s.owner[j] >= 0 && s.owner[j] != module && !isExtern[j] {
                isExtern[j] = true
                externs.push(j)
                s.exported[j] = true
            }
        }
    }
    noDrop(g)
    mutGlobals(g, c, p)
    g.module.push(runtimeDecls())
    if g.debug {
        g.module.push("declare void @llvm.dbg.declare(metadata, metadata, metadata) nounwind\n")
    }
    if g.formats {
        g.module.push("declare void @ofir_str_push_fixed(ptr, double, i64) nounwind\n")
    }
    overflowDecls(g)
    floatDecls(g)
    cDecls(g, c, p)
    g.module.push("\n")
    g.module.push(g.globals)
    if debug {
        g.module.push("\n")
        g.module.push(g.di.finish(root, g.optimize))
    }
    return Draft{module: module, parts: g.parts, links: g.links, tail: g.module,
                 externs: externs}
}

/**
 * The codegen units of the lowered bodies (ADR 0033): one for each module
 * that has functions. A function called from another unit is `hidden`, the
 * others are `internal`; glue and instances are `linkonce_odr hidden` in
 * each unit that uses them.
 *
 * @param c the checker
 * @param p the program
 * @param bodies the bodies, in the order the lowering reached them
 * @param debug `-g`: with debug info
 * @param optimize `--release`
 * @returns the units, by module
 */
pub fn generateUnits(c: mut Checker, p: Program, bodies: &List<AirBody>, debug: bool,
                     optimize: bool) List<Unit> {
    let s = Shared{names: Map.new(), owner: [], declares: [], exported: []}
    let owns = List.filled(false, p.modules.len())
    for i in 0..bodies.len() {
        s.names.insert(bodyName(c, p, &bodies[i]), i)
        const owner = bodyOwner(c, &bodies[i])
        s.owner.push(owner)
        s.declares.push("")
        s.exported.push(false)
        if owner >= 0 {
            owns[owner] = true
        }
    }
    let drafts: List<Draft> = []
    for m in 0..p.modules.len() {
        if owns[m] {
            drafts.push(draft(c, p, bodies, m, s, debug, optimize))
        }
    }
    let units: List<Unit> = []
    for u in 0..drafts.len() {
        const d = &drafts[u]
        let text = ""
        for k in 0..d.parts.len() {
            text.push(d.parts[k])
            text.push(if s.exported[d.links[k]] { "hidden " } else { "internal " })
        }
        text.push(d.tail)
        for k in 0..d.externs.len() {
            text.push(s.declares[d.externs[k]])
        }
        units.push(Unit{module: d.module, text: text})
    }
    return units
}
