/**
 * @module
 * The C header of a library (ADR 0064): a declaration for each
 * `extern "C"` function with a body outside `std`, and the `@repr(C)`
 * structs they point to.
 */

import sema.c_symbols.cSymbol
import sema.check.Checker
import sema.check.fnOf
import sema.check.itemOf
import sema.check_types.fnSignature
import sema.def.DefKind
import sema.program.Program
import sema.resolve.findAttribute
import sema.structs.fieldsOf
import sema.structs.structFields
import sema.types.TyKind
import syntax.ast.ItemKind

// The struct definitions written so far.
struct Header {
    // The definitions, in the order a C compiler needs them.
    structs: str
    // The structs defined or declared.
    done: List<int>
    // A type without a C spelling was declared, outside a pointer.
    missing: bool
}

/**
 * The header of the library `name`.
 *
 * @param c the checker, after a check without errors
 * @param p the program
 * @param name the library's name, without `lib` or an extension
 * @param links the `@link` libraries, in order
 * @returns the text of `<name>.h`
 */
pub fn cHeader(c: mut Checker, p: Program, name: str, links: &List<str>) str {
    let h = Header{structs: "", done: [], missing: false}
    let decls = ""
    for m in 0..p.modules.len() {
        const module = p.modules[m].name.clone()
        if module == "std" || module.startsWith("std.") {
            continue
        }
        const items = &p.modules[m].module.items
        for i in 0..items.len() {
            match items[i].kind {
                ItemKind.Fn(decl) => {
                    const id = c.r.tables[m].fnDefs[decl.id.0]
                    if id != 0 && decl.body.isSome() && decl.abi == "C" {
                        const symbol = cSymbol(c.r, &*decl)
                        const text = prototype(h, c, p, id, symbol)
                        decls.push(text)
                    }
                }
                _ => {}
            }
        }
    }
    let libs = ""
    for i in 0..links.len() {
        libs.push(" -l{links[i]}")
    }
    const guard = guardName(name)
    let out = "/* {name}.h: generated by `ofir build --lib` (ADR 0064); do not edit.\n"
    out.push(" * A static library links after it: libofir_rt.a{libs} -lm -lpthread. */\n")
    out.push("#ifndef {guard}\n#define {guard}\n\n")
    out.push("#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n")
    out.push("#ifdef __cplusplus\nextern \"C\" \{\n#endif\n\n")
    if h.structs.len() > 0 {
        out.push(h.structs)
        out.push("\n")
    }
    out.push("/* Writes the library's buffered standard output. */\n")
    out.push("void ofir_stdout_flush(void);\n")
    out.push(decls)
    out.push("\n#ifdef __cplusplus\n\}\n#endif\n\n#endif\n")
    return out
}

// `OFIR_<NAME>_H`, with each byte that is not a letter or digit as `_`.
fn guardName(name: str) str {
    let out = "OFIR_".toOwned()
    for i in 0..name.len() {
        const b = name[i]
        if b >= b'a' && b <= b'z' {
            out.push(UPPER.slice((b - b'a') as int, (b - b'a') as int + 1))
        } else if (b >= b'A' && b <= b'Z') || (b >= b'0' && b <= b'9') {
            out.push(name.slice(i, i + 1))
        } else {
            out.push("_")
        }
    }
    out.push("_H")
    return out
}

const UPPER: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

// `R symbol(A a, B b);` for the function `id`.
fn prototype(h: mut Header, c: mut Checker, p: Program, id: int, symbol: str) str {
    const sig = fnSignature(c, p, id)
    const params = c.types.get(sig).args.clone()
    const ret = c.types.get(sig).inner
    const f = fnOf(p, c.loc(id))
    let names: List<str> = []
    for i in 0..f.params.len() {
        names.push(c.text(f.params[i].name).toOwned())
    }
    let list = ""
    for i in 0..params.len() {
        if i > 0 {
            list.push(", ")
        }
        const param = if i < names.len() { names[i].clone() } else { "a{i}" }
        list.push(declare(h, c, p, params[i], param))
    }
    if params.len() == 0 {
        list = "void".toOwned()
    }
    const text = declare(h, c, p, ret, "{symbol}({list})")
    return "{text};\n"
}

// The C declaration of `inner` (a name, or "" for a type alone) with the
// type `ty`: `int64_t x`, `uint8_t const *p`, `int32_t (*f)(void)`.
fn declare(h: mut Header, c: mut Checker, p: Program, ty: int, inner: str) str {
    const t = c.types.get(ty).clone()
    if c.types.isCFn(ty) {
        let list = ""
        for i in 0..t.args.len() {
            if i > 0 {
                list.push(", ")
            }
            list.push(declare(h, c, p, t.args[i], ""))
        }
        if t.args.len() == 0 {
            list = "void".toOwned()
        }
        return declare(h, c, p, t.inner, "(*{inner})({list})")
    }
    if t.kind == TyKind.Ptr {
        const mutable = t.data == 1
        if const Option.Some(base) = named(h, c, p, t.inner) {
            const star = if inner.len() > 0 { "*{inner}" } else { "*" }
            return if mutable { "{base} {star}" } else { "const {base} {star}" }
        }
        if !c.types.isCFn(t.inner) && c.types.get(t.inner).kind != TyKind.Ptr {
            return if mutable { "void *{inner}" } else { "const void *{inner}" }
        }
        return declare(h, c, p, t.inner, if mutable { "*{inner}" } else { "*const {inner}" })
    }
    if t.kind == TyKind.Array && t.data >= 0 {
        return declare(h, c, p, t.inner, "{inner}[{t.data}]")
    }
    const base = match named(h, c, p, ty) {
        Option.Some(spelled) => spelled
        Option.None => {
            h.missing = true
            "void".toOwned()
        }
    }
    return if inner.len() > 0 { "{base} {inner}" } else { base }
}

// The C name of a scalar or a `@repr(C)` struct, defining the struct first.
fn named(h: mut Header, c: mut Checker, p: Program, ty: int) Option<str> {
    const t = c.types.get(ty).clone()
    return match t.kind {
        TyKind.Unit | TyKind.Never => Option.Some("void".toOwned())
        TyKind.Bool => Option.Some("bool".toOwned())
        TyKind.Int => intName(t.data)
        TyKind.Float => Option.Some(if t.data == 32 { "float" } else { "double" })
        TyKind.Adt => structName(h, c, p, t.data, t.args.len())
        _ => Option.None
    }
}

// `int8_t` to `uint64_t` for the `IntKind` numbers 0 to 7.
fn intName(kind: int) Option<str> {
    const names = ["int8_t", "int16_t", "int32_t", "int64_t", "uint8_t", "uint16_t",
                   "uint32_t", "uint64_t"]
    if kind < 0 || kind >= names.len() {
        return Option.None
    }
    return Option.Some(names[kind].clone())
}

// `struct Name` for a `@repr(C)` struct without type arguments, after its
// definition: its fields in order, or an incomplete `struct Name;` when a
// field has no C type.
fn structName(h: mut Header, c: mut Checker, p: Program, def: int, args: int) Option<str> {
    const d = c.def(def)
    if d.kind != DefKind.Struct || d.item < 0 || args > 0 {
        return Option.None
    }
    const attributes = itemOf(p, c.loc(def)).attributes.clone()
    if findAttribute(c.r, attributes, "repr").isNone() {
        return Option.None
    }
    const name = "struct {c.text(d.name)}"
    for i in 0..h.done.len() {
        if h.done[i] == def {
            return Option.Some(name)
        }
    }
    h.done.push(def)
    if !structFields(c, p, def) {
        h.structs.push("{name};\n")
        return Option.Some(name)
    }
    const info = fieldsOf(c, def).clone()
    let body = ""
    const outer = h.missing
    h.missing = false
    for i in 0..info.types.len() {
        const field = if info.isTuple { "_{i}".toOwned() } else { c.text(info.names[i]) }
        const line = declare(h, c, p, info.types[i], field)
        body.push("    {line};\n")
    }
    const complete = !h.missing
    h.missing = outer
    if complete {
        h.structs.push("{name} \{\n{body}\};\n")
    } else {
        h.structs.push("{name};\n")
    }
    return Option.Some(name)
}
