// The tests of `base.index_vec` (spec 12.2).

import std.testing.assert

copy struct Node {
    depth: int
}

@test
fn pushReturnsConsecutiveIds() {
    let nodes: IndexVec<Node> = IndexVec.new()
    const first = nodes.nextId()
    const a = nodes.push(Node{depth: 0})
    const b = nodes.push(Node{depth: 1})
    assert(first.index == 0 && a.index == 0 && b.index == 1 && nodes.len() == 2)
    assert(nodes.get(b).depth == 1)
}

@test
fn getMutChangesTheElement() {
    let names: IndexVec<str> = IndexVec.new()
    const id = names.push("ma".toOwned())
    names.getMut(id).push("in")
    assert(names.get(id) == "main")
    const same: Id<str> = idAt(0)
    assert(names.get(same) == "main")
}
