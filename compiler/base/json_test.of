// The tests of `base.json`.

import std.testing.assert

@test
fn parsesNestedValues() {
    const text = "\{\"id\": 3, \"params\": \{\"items\": [true, null, \"a\\nb\"]\}\}"
    const Option.Some(doc) = parseJson(text) else {
        panic("not parsed")
    }
    assert(doc.int(doc.field(0, "id")) == 3)
    const items = doc.elements(doc.at(["params", "items"]))
    assert(items.len() == 3)
    assert(doc.nodes[items[0]].kind == JsonKind.Bool)
    assert(doc.nodes[items[1]].kind == JsonKind.Null)
    assert(doc.text(items[2]) == "a\nb")
    assert(doc.field(0, "missing") == -1)
    assert(doc.text(doc.at(["params", "missing", "deeper"])) == "")
}

@test
fn decodesUnicodeEscapes() {
    const Option.Some(doc) = parseJson("\"caf\\u00e9 \\ud83d\\ude00\"") else {
        panic("not parsed")
    }
    assert(doc.text(0) == "café 😀")
}

@test
fn keepsTheIdAsItCame() {
    const Option.Some(doc) = parseJson("[-12, \"x\\\"y\", \{\}]") else {
        panic("not parsed")
    }
    const items = doc.elements(0)
    assert(doc.raw(items[0]) == "-12")
    assert(doc.int(items[0]) == -12)
    assert(doc.raw(items[1]) == "\"x\\\"y\"")
    assert(doc.raw(items[2]) == "null")
}

@test
fn rejectsInvalidDocuments() {
    assert(parseJson("\{\"a\": \}").isNone())
    assert(parseJson("[1, 2").isNone())
    assert(parseJson("\"open").isNone())
    assert(parseJson("tru").isNone())
    assert(parseJson("1 2").isNone())
    assert(parseJson(" [ ] ").isSome())
}

@test
fn jsoncAllowsCommentsAndTrailingCommas() {
    const text = "// manifest\n\{\"a\": [1, 2,], /* b */ \"b\": \{\"c\": true,\},\n\}\n"
    const Result.Ok(doc) = parseJsonc(text) else {
        panic("not parsed")
    }
    assert(doc.elements(doc.field(0, "a")).len() == 2)
    const c = doc.at(["b", "c"])
    assert(doc.nodes[c].kind == JsonKind.Bool)
    assert(text.slice(doc.nodes[c].start, doc.nodes[c].end) == "true")
    assert(parseJson(text).isNone())
}

// Where `text` stops parsing as JSONC, or -1.
fn failsAt(text: str) int {
    match parseJsonc(text) {
        Result.Ok(_) => {
            return -1
        }
        Result.Err(at) => {
            return at
        }
    }
}

@test
fn jsoncReportsWhereItFails() {
    assert(failsAt("\{\"a\": nope\}") == 6)
    assert(failsAt("[1 /* never closed") == 18)
}

@test
fn jsonStringEscapes() {
    assert(jsonString("a\"b\\c\nd\te") == "\"a\\\"b\\\\c\\nd\\te\"")
    assert(jsonString("\x01\x1f") == "\"\\u0001\\u001f\"")
    assert(jsonString("") == "\"\"")
}

// The text of a JSON string, or "?" if it does not parse.
fn decoded(text: str) str {
    const Option.Some(doc) = parseJson(text) else {
        return "?".toOwned()
    }
    return doc.text(0)
}

@test
fn decodesEveryEscape() {
    assert(decoded("\"\\t\\r\\b\\f\\/\"") == "\t\r\x08\x0c/")
    assert(decoded("\"\\u00E9\"") == "é")
    assert(decoded("\"\\ud83d\\u0041\"") == "\u{FFFD}")   // a high surrogate, then no low one
    assert(decoded("\"\\ude00\"") == "\u{FFFD}")   // an unpaired low surrogate
    assert(decoded("\"ab\\") == "?")
    assert(decoded("\"\\x\"") == "?")
    assert(decoded("\"\\u12") == "?")
    assert(decoded("\"\\u12G4\"") == "?")
}

@test
fn rejectsMisplacedSeparators() {
    assert(parseJson("[,1]").isNone())
    assert(parseJson("\{\"a\" 1\}").isNone())
    assert(parseJson("\{\"a\": , \"b\": 1\}").isNone())
    assert(failsAt("[1 /x]") >= 0)
}
