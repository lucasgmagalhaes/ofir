/**
 * @module
 * Typed indices: a list whose elements are reached by an `Id<T>` that only
 * fits that list's element type, so that the index of a type cannot be
 * used for a node by mistake.
 */

/**
 * The index of an element of an `IndexVec<T>`.
 *
 * @typeParam T the type of the element it points to
 */
pub copy struct Id<T> {
    /** The position in the list. */
    pub index: int
    marker: Marker<T>
}

// Holds the type parameter of `Id<T>` without a value of that type.
copy struct Marker<T> {
}

/**
 * The id of position `index`, for code that numbers elements itself.
 *
 * @typeParam T the type of the element
 * @param index the position
 * @returns the id
 */
pub fn idAt<T>(index: int) Id<T> {
    return Id{index, marker: Marker{}}
}

/**
 * A growable list indexed by `Id<T>`: elements are never removed, so an id
 * stays valid as long as the list.
 *
 * @typeParam T the type of the elements
 * @example
 * ```ofir
 * import base.index_vec.IndexVec
 * import std.testing.assert
 *
 * let names: IndexVec<str> = IndexVec.new()
 * const id = names.push("main".toOwned())
 * assert(names.get(id) == "main")
 * ```
 */
pub struct IndexVec<T> {
    items: List<T>

    /**
     * An empty list.
     *
     * @returns the list
     */
    pub fn new() IndexVec<T> {
        return IndexVec{items: []}
    }

    /**
     * Adds an element at the end.
     *
     * @param value the element
     * @returns its id
     */
    pub fn push(mut self, value: move T) Id<T> {
        self.items.push(value)
        return idAt(self.items.len() - 1)
    }

    /**
     * An element.
     *
     * @param id an id of this list
     * @returns a borrow of the element
     * @panics when the id is out of range
     */
    pub fn get(self, id: Id<T>) &T {
        return &self.items[id.index]
    }

    /**
     * An element, to modify it.
     *
     * @param id an id of this list
     * @returns a mutable borrow of the element
     * @panics when the id is out of range
     */
    pub fn getMut(mut self, id: Id<T>) &mut T {
        return &mut self.items[id.index]
    }

    /**
     * The number of elements.
     *
     * @returns the count
     */
    pub fn len(self) int {
        return self.items.len()
    }

    /**
     * The id the next `push` will return.
     *
     * @returns that id
     */
    pub fn nextId(self) Id<T> {
        return idAt(self.items.len())
    }
}
