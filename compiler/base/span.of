/**
 * @module
 * Source positions: the files of a compilation and the byte ranges in them
 * that tokens, syntax nodes and diagnostics point to.
 */

/**
 * The index of a source file in its `SourceMap`.
 */
pub copy struct FileId(int)

/**
 * A byte range `start..end` of a source file.
 *
 * @example
 * ```ofir
 * import base.span.FileId
 * import base.span.Span
 * import std.testing.assert
 *
 * const span = Span{file: FileId(0), start: 4, end: 9}
 * assert(span.len() == 5)
 * ```
 */
pub copy struct Span {
    /** The file the range is in. */
    pub file: FileId
    /** The offset of the first byte. */
    pub start: int
    /** The offset after the last byte. */
    pub end: int

    /**
     * The number of bytes in the range.
     *
     * @returns `end - start`
     */
    pub fn len(self) int {
        return self.end - self.start
    }

    /**
     * The range from the start of this one to the end of `other`, which
     * comes later in the same file: the span of a node from its first
     * token to its last.
     *
     * @param other the span that ends the range
     * @returns the joined span
     */
    pub fn to(self, other: Span) Span {
        return Span{file: self.file, start: self.start, end: other.end}
    }
}

/**
 * A line and a column, both counted from 1; the column counts bytes.
 */
pub copy struct LineCol {
    /** The line, from 1. */
    pub line: int
    /** The column, from 1, in bytes. */
    pub column: int
}

/**
 * A source file: its path, its text and where its lines start.
 */
pub struct SourceFile {
    /** The path the file was read from, as given. */
    pub path: str
    /** The whole text. */
    pub text: str
    lineStarts: List<int>

    /**
     * A file with the offset of each line indexed, for `lineCol`.
     *
     * @param path the path the file was read from
     * @param text its contents
     * @returns the file
     */
    pub fn new(path: move str, text: move str) SourceFile {
        let starts = [0]
        for i in 0..text.len() {
            if text[i] == b'\n' {
                starts.push(i + 1)
            }
        }
        return SourceFile{path, text, lineStarts: starts}
    }

    /**
     * The number of lines; a final line without `\n` counts.
     *
     * @returns the line count
     */
    pub fn lineCount(self) int {
        const n = self.lineStarts.len()
        return if n > 1 && self.lineStarts[n - 1] == self.text.len() { n - 1 } else { n }
    }

    /**
     * The line and column of a byte offset, by binary search.
     *
     * @param offset a byte offset in `0..=text.len()`
     * @returns its position
     */
    pub fn lineCol(self, offset: int) LineCol {
        let lo = 0
        let hi = self.lineStarts.len()
        for hi - lo > 1 {   // lineStarts[lo] <= offset < lineStarts[hi]
            const mid = (lo + hi) / 2
            if self.lineStarts[mid] <= offset {
                lo = mid
            } else {
                hi = mid
            }
        }
        return LineCol{line: lo + 1, column: offset - self.lineStarts[lo] + 1}
    }

    /**
     * The text of line `line`, without its `\n`.
     *
     * @param line the line, from 1
     * @returns a view of the line
     * @panics unless `1 <= line <= lineCount()`
     */
    pub fn lineText(self, line: int) str {
        const start = self.lineStarts[line - 1]
        let end = if line < self.lineStarts.len() { self.lineStarts[line] } else { self.text.len() }
        for end > start && (self.text[end - 1] == b'\n' || self.text[end - 1] == b'\r') {
            end -= 1
        }
        return self.text.slice(start, end)
    }
}

/**
 * The source files of a compilation; a `FileId` is an index into it.
 */
pub struct SourceMap {
    files: List<SourceFile>

    /**
     * An empty map.
     *
     * @returns the map
     */
    pub fn new() SourceMap {
        return SourceMap{files: []}
    }

    /**
     * Adds a file.
     *
     * @param path the path it was read from
     * @param text its contents
     * @returns its id
     */
    pub fn add(mut self, path: move str, text: move str) FileId {
        self.files.push(SourceFile.new(path, text))
        return FileId(self.files.len() - 1)
    }

    /**
     * A file of the map.
     *
     * @param id the file's id
     * @returns the file
     */
    pub fn file(self, id: FileId) &SourceFile {
        return &self.files[id.0]
    }

    /**
     * The number of files.
     *
     * @returns the count
     */
    pub fn len(self) int {
        return self.files.len()
    }
}
