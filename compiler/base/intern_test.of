// The tests of `base.intern` (spec 12.2).

import std.testing.assert

@test
fn internGivesOneSymbolPerName() {
    let names = Interner.new()
    const a = names.intern("main")
    const b = names.intern("helper")
    const again = names.intern("main")
    assert(a.0 == 0 && b.0 == 1 && again.0 == a.0)
    assert(names.len() == 2)
    assert(names.name(a) == "main" && names.name(b) == "helper")
}

@test
fn findDoesNotAdd() {
    let names = Interner.new()
    names.intern("x")
    assert(names.find("x").isSome())
    assert(names.find("y").isNone())
    assert(names.len() == 1)
}

@test
fn manyNamesStayDistinct() {
    let names = Interner.new()
    for i in 0..1000 {
        const symbol = names.intern("name{i}")
        assert(symbol.0 == i)
    }
    assert(names.name(names.intern("name500")) == "name500")
    assert(names.len() == 1000)
}
