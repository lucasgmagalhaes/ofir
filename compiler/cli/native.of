/**
 * @module
 * The native toolchain: clang compiles the generated LLVM IR into objects,
 * then links them into a program or archives them into a library.
 */

import cli.options.Options
import cli.options.onWindows
import cli.report.driverError
import cli.report.timerReport
import cli.report.timerStart
import driver.build.object_cache
import driver.build.target.hostTriple
import driver.build.target.targetOs
import driver.build.target.targetRuntime
import std.fs
import std.os

// A static library: the objects of the units in an archive (ADR 0064).
pub fn archive(opts: &Options, files: List<str>, cached: List<str>, lib: str) bool {
    const clang = clangPath()
    let objects: List<str> = []
    let hits: List<int> = []
    let ok = compileUnits(opts, clang, files, cached, object_cache.tempTag(lib), objects, hits)
    if ok {
        const _ = fs.removeFile(lib)   // `ar r` adds to an archive that exists
        // `D`: no times or owners in the archive (ADR 0083); macOS's ar has no `D`.
        const flags = if hostTriple().contains("apple") { "rcs" } else { "rcsD" }
        let args = [flags.toOwned(), lib.clone()]
        for i in 0..objects.len() {
            args.push(objects[i].clone())
        }
        const ar = archiver()
        ok = match os.spawn(ar, args) {
            Result.Ok(child) => finishClang(opts, ar, child, false)
            Result.Err(_) => false
        }
    }
    removeObjects(objects, cached)
    if !ok {
        driverError(opts.format, "E0902", "cannot archive the objects into `{lib}`")
    }
    return ok
}

// The directory part of `path` with its `/`, or "": `out/` for `out/libx.a`.
pub fn directoryOf(path: str) str {
    let end = 0
    for i in 0..path.len() {
        if path[i] == b'/' || path[i] == b'\\' {   // Windows paths use either
            end = i + 1
        }
    }
    return path.slice(0, end).toOwned()
}

// The archiver: `OFIR_AR`, or `ar`.
pub fn archiver() str {
    if const Option.Some(name) = os.env("OFIR_AR") {
        if name.len() > 0 {
            return name
        }
    }
    return "ar".toOwned()
}

pub fn removeFiles(files: List<str>) {
    for i in 0..files.len() {
        const _ = fs.removeFile(files[i])
    }
}

// The executable: `-o`, the input's name without `.of`, or for `run` and
// `test` a file in the temporary directory named after the input's path,
// so that parallel runs do not share it.
pub fn outputPath(opts: &Options) str {
    if const Option.Some(output) = opts.output {
        return output.clone()
    }
    const input = opts.input.clone()
    const base = inputBase(opts)
    if opts.lib == "static" {
        return "lib{base}.a"
    }
    if opts.lib == "shared" {
        const system = targetOs(opts.target)
        const ext = if system == "windows" {
            "dll"
        } else if system == "macos" {
            "dylib"
        } else {
            "so"
        }
        return "lib{base}.{ext}"
    }
    if opts.command == "build" {
        return base
    }
    const full = match fs.canonicalize(input) {
        Result.Ok(path) => path
        Result.Err(_) => input.clone()
    }
    let name = ""
    for i in 0..full.len() {
        const b = full[i]
        const letter = (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z')
        const plain = letter || (b >= b'0' && b <= b'9')
        name.push(if plain { full.slice(i, i + 1) } else { "_" })
    }
    const ext = if windowsTarget(opts) { ".exe" } else { "" }   // the name a runner opens
    return "{tempDir()}/ofir-{opts.command}-{name}{ext}"
}

// The input's file name without `.of`: `lib` for `src/lib.of`.
pub fn inputBase(opts: &Options) str {
    const input = opts.input.clone()
    let slash = -1
    for i in 0..input.len() {
        if input[i] == b'/' {
            slash = i
        }
    }
    let base = input.sliceFrom(slash + 1).toOwned()
    if base.len() > 3 && base.endsWith(".of") {
        base = base.slice(0, base.len() - 3).toOwned()
    }
    return base
}

// The program is built for Windows: by `--target`, or on Windows.
pub fn windowsTarget(opts: &Options) bool {
    return targetOs(opts.target) == "windows"
}

// `TMPDIR`, then `TEMP` (Windows), then `/tmp`.
pub fn tempDir() str {
    const names = ["TMPDIR", "TEMP"]
    for i in 0..names.len() {
        if const Option.Some(dir) = os.env(names[i]) {
            if dir.len() > 0 {
                return dir.replace("\\", "/")
            }
        }
    }
    return "/tmp".toOwned()
}

// The runtime library: `OFIR_RUNTIME`, or next to the compiler.
pub fn runtimeLibrary() Option<str> {
    if const Option.Some(path) = os.env("OFIR_RUNTIME") {
        return Option.Some(path)
    }
    const Result.Ok(exe) = os.executablePath() else {
        return Option.None   // GCOVR_EXCL_LINE: the running compiler always finds its own path
    }
    let slash = -1
    for i in 0..exe.len() {
        if exe[i] == b'/' {
            slash = i
        }
    }
    const dir = if slash >= 0 { exe.slice(0, slash).toOwned() } else { ".".toOwned() }
    const places = ["{dir}/../libofir_rt.a", "{dir}/../lib/ofir/libofir_rt.a"]
    for i in 0..places.len() {
        if fs.exists(places[i]) {
            return Option.Some(places[i].clone())
        }
    }
    return Option.None
}

// clang compiles the modules and links them with the runtime and the
// `@link` libraries. The modules have no target triple: clang uses its
// default target. `cached` is empty without the object cache, or holds
// where the object of each unit is cached (ADR 0033).
pub fn link(opts: &Options, files: List<str>, cached: List<str>, exe: str,
        libraries: List<str>, native: List<str>) bool {
    let phaseStart = timerStart(opts.timePasses)
    const Option.Some(host) = runtimeLibrary() else {
        const message = "cannot find the runtime library libofir_rt.a (set OFIR_RUNTIME)"
        driverError(opts.format, "E0902", message)
        return false
    }
    const runtime = if opts.target.len() > 0 { targetRuntime(host, opts.target) } else { host }
    if !fs.exists(runtime) {
        const message = "cannot find `{runtime}`: build it with `make runtime TARGET={opts.target}`"
        driverError(opts.format, "E0902", message)
        return false
    }
    const clang = clangPath()
    let objects: List<str> = []
    let hits: List<int> = []   // the units whose objects came from the cache
    if files.len() > 1 || cached.len() > 0 {   // compiled apart, then linked (ADR 0033)
        const tag = object_cache.tempTag(exe)
        if !compileUnits(opts, clang, files, cached, tag, objects, hits) {
            timerReport(opts.timePasses, "objects", phaseStart)
            removeObjects(objects, cached)
            driverError(opts.format, "E0902", "clang failed to compile the generated code")
            return false
        }
    }
    timerReport(opts.timePasses, "objects", phaseStart)
    phaseStart = timerStart(opts.timePasses)
    let inputs = if objects.len() > 0 { objects.clone() } else { files.clone() }
    let ok = linkObjects(opts, clang, inputs, native, runtime, libraries, exe,
                         hits.len() > 0)
    if !ok && hits.len() > 0 {   // a cached object may be bad: compile those units again
        let again: List<str> = []
        let fresh: List<str> = []
        for i in 0..hits.len() {
            const _ = fs.removeFile(objects[hits[i]])
            again.push(files[hits[i]].clone())
        }
        const noCache: List<str> = []
        let none: List<int> = []
        ok = compileUnits(opts, clang, again, noCache, "", fresh, none)
        for i in 0..hits.len() {
            if i < fresh.len() {
                objects[hits[i]] = fresh[i].clone()
            }
        }
        if ok {
            ok = linkObjects(opts, clang, objects, native, runtime, libraries, exe, false)
        }
        removeFiles(fresh)
    }
    timerReport(opts.timePasses, "link", phaseStart)
    removeObjects(objects, cached)
    if !ok {
        driverError(opts.format, "E0902", "clang failed to compile the generated code")
    } else if cached.len() > 0 && hits.len() < cached.len() {   // objects were added
        object_cache.prune()
    }
    return ok
}

// The clang program: `OFIR_CLANG`, or `clang`.
pub fn clangPath() str {
    if const Option.Some(name) = os.env("OFIR_CLANG") {
        if name.len() > 0 {
            return name
        }
    }
    return "clang".toOwned()
}

// Removes the objects that are not in the cache.
pub fn removeObjects(objects: List<str>, cached: List<str>) {
    for i in 0..objects.len() {
        if i >= cached.len() || objects[i] != cached[i] {
            const _ = fs.removeFile(objects[i])
        }
    }
}

// The final clang call. With `quiet`, a failure prints nothing: the
// caller tries again.
pub fn linkObjects(opts: &Options, clang: str, inputs: List<str>, native: List<str>,
               runtime: str, libraries: List<str>, exe: str, quiet: bool) bool {
    let compiles = native.len() > 0
    for i in 0..inputs.len() {
        compiles = compiles || inputs[i].endsWith(".ll")
    }
    // A link of objects only would warn that the code generation flags are unused.
    let args = if compiles { codegenFlags(opts) } else { clangFlags(opts) }
    for i in 0..inputs.len() {
        args.push(inputs[i].clone())
    }
    for i in 0..native.len() {   // compiled with the program's flags (ADR 0078)
        args.push(native[i].clone())
    }
    args.push(runtime.toOwned())
    for i in 0..libraries.len() {
        args.push("-l{libraries[i]}")
    }
    args.push("-lm".toOwned())
    if opts.lib == "shared" {
        args.push("-shared".toOwned())
    }
    // MinGW keeps the pthread functions in winpthreads.
    if windowsTarget(opts) {
        args.push("-lpthread".toOwned())
    }
    args.push("-o".toOwned())
    args.push(exe.toOwned())
    // The main thread gets 32 MiB: the Windows ABI's 32-byte shadow space
    // makes a frame about twice its size on Linux, whose stack is 8 MiB.
    // The PE header gets no link time, so the same inputs give the same
    // bytes (ADR 0083).
    if windowsTarget(opts) {
        args.push("-Wl,--stack,33554432".toOwned())
        args.push("-Wl,--no-insert-timestamp".toOwned())
    }
    // A Mach-O debug map names the temporary objects clang linked, and
    // their times: `--trim-paths` leaves it out (ADR 0083).
    if opts.trimPaths && targetOs(opts.target) == "macos" {
        args.push("-Wl,-S".toOwned())
    }
    return match os.spawn(clang, args) {
        Result.Ok(child) => finishClang(opts, clang, child, quiet)
        Result.Err(_) => {
            driverError(opts.format, "E0902", "cannot run `{clang}`")
            false
        }
    }
}

// The clang flags of both compiling and linking: the optimization level,
// debug info and, on Windows, MinGW rather than MSVC.
pub fn clangFlags(opts: &Options) List<str> {
    let args = ["-O{opts.opt}", "-Wno-override-module".toOwned()]
    if opts.debugInfo {
        args.push("-g".toOwned())
    }
    if opts.coverage {
        args.push("--coverage".toOwned())   // gcov counters, mapped by the line table
    }
    if opts.target.len() > 0 {
        args.push("--target={opts.target}")
        if const Option.Some(root) = os.env("OFIR_SYSROOT") {
            args.push("--sysroot={root}")
        }
    } else if onWindows() {
        // GCOVR_EXCL_START: coverage runs on a Linux host
        args.push("--target=x86_64-w64-windows-gnu".toOwned())
        // GCOVR_EXCL_STOP
    }
    if opts.lib == "shared" && !windowsTarget(opts) {
        args.push("-fPIC".toOwned())   // a shared library's code (ADR 0064)
    }
    return args
}

// The clang flags of a call that generates code: `clangFlags` and, at -O0,
// the linear pre-register-allocation scheduler, which is about 40% faster on
// large functions (ADR 0054). Above -O0 it crashes the AArch64 backend.
pub fn codegenFlags(opts: &Options) List<str> {
    let args = clangFlags(opts)
    if opts.opt == 0 {
        args.push("-mllvm".toOwned())
        args.push("-pre-RA-sched=linearize".toOwned())
    }
    return args
}

// Compiles each unit to its object, with at most `-j N` clang processes
// running, and pushes the objects to `objects`. A unit whose object is in
// the cache is not compiled, and its index goes to `hits`; another is
// compiled to a temporary name in the cache and renamed into place after
// its checksum (ADR 0092). The processes are waited for in the order they
// started, so their output comes in the order of the units. After a
// failure no more are started, and the running ones are waited for.
pub fn compileUnits(opts: &Options, clang: str, files: List<str>, cached: List<str>, tag: str,
                objects: mut List<str>, hits: mut List<int>) bool {
    const jobs = if opts.jobs > 0 { opts.jobs } else { os.cpuCount() }
    let running: List<os.Child> = []
    let units: List<int> = []   // the unit of each running process
    let ok = true
    let next = 0
    for (ok && next < files.len()) || running.len() > 0 {
        if ok && next < files.len() && running.len() < jobs {
            const k = next
            next += 1
            const local = "{files[k].slice(0, files[k].len() - 3)}.o"
            if k >= cached.len() {
                objects.push(local)
            } else if object_cache.useObject(cached[k]) {
                objects.push(cached[k].clone())
                hits.push(k)
                continue
            } else {
                const _ = fs.createDirAll(parentDir(cached[k]))
                objects.push("{cached[k]}.{tag}.tmp")
            }
            let args = codegenFlags(opts)
            args.push("-c".toOwned())
            args.push(files[k].clone())
            args.push("-o".toOwned())
            args.push(objects[k].clone())
            match os.spawn(clang, args) {
                Result.Ok(child) => {
                    running.push(child)
                    units.push(k)
                }
                Result.Err(_) => {
                    driverError(opts.format, "E0902", "cannot run `{clang}`")
                    ok = false
                }
            }
        } else {
            const child = running.remove(0)
            const k = units.remove(0)
            if !finishClang(opts, clang, child, false) {
                ok = false
            } else if k < cached.len() {   // into the cache; the temporary name if that fails
                const summed = object_cache.writeSum(objects[k], cached[k], tag)
                if summed && fs.rename(objects[k], cached[k]).isOk() {
                    objects[k] = cached[k].clone()
                }
            }
        }
    }
    return ok
}

// With `--coverage`, the module `text` of the unit `ll` with `!llvm.gcov`,
// which names the counters' files of its compile unit (`!0`) after the
// unit, `.gcno` and `.gcda` instead of `.ll`: without it they would go to
// the current directory, named after the module. The paths are absolute,
// so the program finds its `.gcda` from any directory.
pub fn coverageFiles(opts: &Options, ll: str, text: str) str {
    if !opts.coverage {
        return text.toOwned()
    }
    let base = ll.slice(0, ll.len() - 3).toOwned()
    if !base.startsWith("/") {
        if const Result.Ok(dir) = os.currentDir() {
            base = "{dir}/{base}"
        }
    }
    let out = text.toOwned()
    out.push("\n!llvm.gcov = !\{!2147483000\}\n")
    out.push("!2147483000 = !\{!\"{base}.gcno\", !\"{base}.gcda\", !0\}\n")
    return out
}

// The directory of a path: what comes before its last `/`.
pub fn parentDir(path: str) str {
    let slash = 0
    for i in 0..path.len() {
        if path[i] == b'/' {
            slash = i
        }
    }
    return path.slice(0, slash).toOwned()
}

// Waits for a clang process and passes its output on, unless `quiet`.
pub fn finishClang(opts: &Options, clang: str, child: move os.Child, quiet: bool) bool {
    return match child.wait() {
        Result.Ok(out) => {
            if !quiet || out.status == 0 {
                print(out.stdout)
                eprint(out.stderr)
            }
            out.status == 0
        }
        Result.Err(_) => {
            // GCOVR_EXCL_START: the clang it started always has a status
            driverError(opts.format, "E0902", "cannot run `{clang}`")
            // GCOVR_EXCL_STOP
            false
        }
    }
}

// The arguments `lead`, then `arg`.
pub fn withArg(lead: List<str>, arg: move str) List<str> {
    let args = lead.clone()
    args.push(arg)
    return args
}
