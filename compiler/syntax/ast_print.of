/**
 * @module
 * `--emit=ast`: one node per line, children indented by two spaces; types
 * and patterns inline in source-like form (stage 0:
 * bootstrap/src/syntax/ast_print.c and ast_print_items.c).
 */

import base.intern.Interner
import base.intern.Symbol
import syntax.ast.Arg
import syntax.ast.Attribute
import syntax.ast.Block
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.FieldDecl
import syntax.ast.FieldInit
import syntax.ast.FnDecl
import syntax.ast.ForKind
import syntax.ast.Item
import syntax.ast.ItemKind
import syntax.ast.MatchArm
import syntax.ast.Module
import syntax.ast.Op
import syntax.ast.Param
import syntax.ast.Pattern
import syntax.ast.Stmt
import syntax.ast.StmtKind
import syntax.ast.TypeExpr
import syntax.ast.Variant
import syntax.ast.WherePred
import syntax.ast_text.literalText
import syntax.ast_text.modeText
import syntax.ast_text.patternText
import syntax.ast_text.typeText

/**
 * The tree of a file, as stage 0's `--emit=ast` prints it.
 *
 * @param module the tree
 * @param names its interner
 * @returns the text
 */
pub fn printModule(module: Module, names: Interner) str {
    let p = Printer{out: "", depth: 0}
    p.line("module")
    p.depth += 1
    for i in 0..module.docs.len() {
        p.line("doc \"{module.docs[i]}\"")
    }
    for i in 0..module.items.len() {
        p.item(&module.items[i], names)
    }
    return p.out
}

struct Printer {
    out: str
    depth: int

    fn line(mut self, text: str) {
        for _ in 0..self.depth {
            self.out.push("  ")
        }
        self.out.push(text)
        self.out.push("\n")
    }

    fn child(mut self, label: str, e: &Expr, names: Interner) {
        self.line(label)
        self.depth += 1
        self.expr(e, names)
        self.depth -= 1
    }

    fn optionalChild(mut self, label: str, e: &Option<Box<Expr>>, names: Interner) {
        if const Option.Some(inner) = *e {
            self.child(label, &*inner, names)
        }
    }

    fn typeLine(mut self, label: str, t: &Option<TypeExpr>, names: Interner) {
        if const Option.Some(ty) = *t {
            self.line("{label} {typeText(&ty, names)}")
        }
    }

    fn withChildren(mut self, label: str, a: &Expr, b: Option<&Expr>, names: Interner) {
        self.line(label)
        self.depth += 1
        self.expr(a, names)
        if const Option.Some(second) = b {
            self.expr(second, names)
        }
        self.depth -= 1
    }

    fn args(mut self, items: List<Arg>, names: Interner) {
        for i in 0..items.len() {
            if const Option.Some(name) = items[i].name {
                self.line("arg {names.name(name)}")
                self.depth += 1
                self.expr(&items[i].value, names)
                self.depth -= 1
            } else {
                self.expr(&items[i].value, names)
            }
        }
    }

    fn sequence(mut self, label: str, list: List<Expr>, names: Interner) {
        self.line(label)
        self.depth += 1
        for i in 0..list.len() {
            self.expr(&list[i], names)
        }
        self.depth -= 1
    }

    fn expr(mut self, e: &Expr, names: Interner) {
        match e.kind {
            ExprKind.Int(_) | ExprKind.Float(_) | ExprKind.Byte(_) |
            ExprKind.Bool(_) => self.line("lit {literalText(e, names)}")
            ExprKind.Str(_) => self.line("str {literalText(e, names)}")
            ExprKind.ByteStr(_) => self.line("bytes {literalText(e, names)}")
            ExprKind.Ident(name) => self.line("ident {names.name(name)}")
            ExprKind.SelfValue => self.line("self")
            ExprKind.SelfType => self.line("Self")
            ExprKind.Interp(parts, specs) => {
                self.line("interp")
                self.depth += 1
                for i in 0..parts.len() {
                    self.expr(&parts[i], names)
                    if specs[i].len() > 0 {
                        self.line("format {specs[i]}")
                    }
                }
                self.depth -= 1
            }
            ExprKind.Generic(name, args) => {
                self.line("generic {names.name(name)}<{typesText(args, names)}>")
            }
            ExprKind.Unary(op, operand) => self.withChildren("unary {opText(op)}", &*operand,
                                                             Option.None, names)
            ExprKind.Binary(op, lhs, rhs) => {
                self.withChildren("binary {opText(op)}", &*lhs, Option.Some(&*rhs), names)
            }
            ExprKind.Cast(value, to) => {
                self.line("cast")
                self.depth += 1
                self.expr(&*value, names)
                self.line("to {typeText(&to, names)}")
                self.depth -= 1
            }
            ExprKind.Range(lo, hi, inclusive) => self.range(&lo, &hi, inclusive, names)
            ExprKind.Call(callee, args) => {
                self.line("call")
                self.depth += 1
                self.expr(&*callee, names)
                self.args(args, names)
                self.depth -= 1
            }
            ExprKind.Index(base, index) => self.withChildren("index", &*base, Option.Some(&*index),
                                                             names)
            ExprKind.Field(base, name, typeArgs) => {
                let args = ""
                if typeArgs.len() > 0 {
                    args = "<{typesText(typeArgs, names)}>"
                }
                self.withChildren("field {names.name(name)}{args}", &*base, Option.None, names)
            }
            ExprKind.TupleField(base, index) => {
                self.withChildren("tuple_field {index}", &*base, Option.None, names)
            }
            ExprKind.Try(inner) => self.withChildren("try", &*inner, Option.None, names)
            ExprKind.Struct(typeName, fields, base) => self.structLiteral(&*typeName, fields, &base,
                                                                          names)
            ExprKind.Array(elems) => self.sequence("array", elems, names)
            ExprKind.Tuple(elems) => self.sequence("tuple", elems, names)
            ExprKind.Repeat(value, count) => self.withChildren("repeat", &*value,
                                                               Option.Some(&*count), names)
            ExprKind.Variant(name, args, hasArgs) => {
                self.line("variant .{names.name(name)}{if hasArgs { "()" } else { "" }}")
                self.depth += 1
                self.args(args, names)
                self.depth -= 1
            }
            ExprKind.If(letPattern, cond, then, otherwise) => {
                self.ifExpr(&letPattern, &*cond, &then, &otherwise, names)
            }
            ExprKind.Match(scrutinee, arms) => self.matchExpr(&*scrutinee, arms, names)
            ExprKind.Block(block) => self.block("block", &block, names)
            ExprKind.Unsafe(block) => self.block("unsafe", &block, names)
            ExprKind.Comptime(inner) => self.withChildren("comptime", &*inner, Option.None, names)
            ExprKind.Keys(ty) => self.line("keys {typeText(&ty, names)}")
            ExprKind.Closure(params, ret, body, isMove) => {
                self.line(if isMove { "closure move" } else { "closure" })
                self.depth += 1
                for i in 0..params.len() {
                    self.param(&params[i], names)
                }
                self.typeLine("returns", &ret, names)
                self.expr(&*body, names)
                self.depth -= 1
            }
        }
    }

    fn range(mut self, lo: &Option<Box<Expr>>, hi: &Option<Box<Expr>>, inclusive: bool,
             names: Interner) {
        // `_` marks a missing bound: `range _..` is `..hi`, `range .._` is `lo..`.
        const left = if lo.isSome() { "" } else { "_" }
        const right = if hi.isSome() { "" } else { "_" }
        self.line("range {left}{if inclusive { "..=" } else { ".." }}{right}")
        self.depth += 1
        if const Option.Some(e) = *lo {
            self.expr(&*e, names)
        }
        if const Option.Some(e) = *hi {
            self.expr(&*e, names)
        }
        self.depth -= 1
    }

    fn structLiteral(mut self, typeName: &Expr, fields: List<FieldInit>, base: &Option<Box<Expr>>,
                     names: Interner) {
        self.line("struct")
        self.depth += 1
        self.expr(typeName, names)
        for i in 0..fields.len() {
            self.line("field {names.name(fields[i].name)}")
            self.depth += 1
            if const Option.Some(value) = fields[i].value {
                self.expr(&value, names)
            }
            self.depth -= 1
        }
        self.optionalChild("base", base, names)
        self.depth -= 1
    }

    fn ifExpr(mut self, letPattern: &Option<Pattern>, cond: &Expr, then: &Block,
              otherwise: &Option<Box<Expr>>, names: Interner) {
        self.line("if")
        self.depth += 1
        if const Option.Some(pattern) = *letPattern {
            self.line("const {patternText(&pattern, names)}")
        }
        self.expr(cond, names)
        self.block("then", then, names)
        if const Option.Some(e) = *otherwise {
            match e.kind {
                ExprKind.Block(block) => self.block("else", &block, names)
                _ => self.child("else", &*e, names)   // `else if`
            }
        }
        self.depth -= 1
    }

    fn matchExpr(mut self, scrutinee: &Expr, arms: List<MatchArm>, names: Interner) {
        self.line("match")
        self.depth += 1
        self.expr(scrutinee, names)
        for i in 0..arms.len() {
            self.line("arm {patternText(&arms[i].pattern, names)}")
            self.depth += 1
            if const Option.Some(guard) = arms[i].guard {
                self.child("guard", &guard, names)
            }
            self.expr(&arms[i].body, names)
            self.depth -= 1
        }
        self.depth -= 1
    }

    // -----------------------------------------------------------------------
    // Statements

    fn block(mut self, label: str, b: &Block, names: Interner) {
        self.line(label)
        self.depth += 1
        for i in 0..b.stmts.len() {
            self.stmt(&b.stmts[i], names)
        }
        self.depth -= 1
    }

    fn stmt(mut self, s: &Stmt, names: Interner) {
        match s.kind {
            StmtKind.Let(pattern, ty, value, otherwise) => {
                self.line("const {patternText(&pattern, names)}")
                self.depth += 1
                self.typeLine("type", &ty, names)
                self.expr(&value, names)
                if const Option.Some(block) = otherwise {
                    self.block("else", &block, names)
                }
                self.depth -= 1
            }
            StmtKind.Var(name, ty, value) => {
                self.line("let {names.name(name)}")
                self.depth += 1
                self.typeLine("type", &ty, names)
                if const Option.Some(e) = value {
                    self.expr(&e, names)
                }
                self.depth -= 1
            }
            StmtKind.Assign(op, target, value) => {
                const text = if op == Op.Assign { "" } else { opText(op) }
                self.withChildren("assign {text}=", &target, Option.Some(&value), names)
            }
            StmtKind.For(kind, mutable, first, second, expr, body) => {
                if const Option.Some(label) = s.label {
                    self.line("label {names.name(label)}")
                }
                self.forStmt(kind, mutable, first, second, &expr, &body, names)
            }
            StmtKind.Return(value) => {
                self.line("return")
                if const Option.Some(e) = value {
                    self.depth += 1
                    self.expr(&e, names)
                    self.depth -= 1
                }
            }
            StmtKind.Break => self.line("break{labelText(s.label, names)}")
            StmtKind.Continue => self.line("continue{labelText(s.label, names)}")
            StmtKind.ExprStmt(e) => self.expr(&e, names)
        }
    }

    fn forStmt(mut self, kind: ForKind, mutable: bool, first: Option<Symbol>,
               second: Option<Symbol>, expr: &Option<Expr>, body: &Block, names: Interner) {
        if kind == ForKind.Infinite {
            self.line("for")
        } else if kind == ForKind.Cond {
            self.line("for cond")
        } else {
            const prefix = if kind == ForKind.Comptime { "comptime " } else { "" }
            let text = "{prefix}for {if mutable { "mut " } else { "" }}{nameOf(first, names)}"
            if const Option.Some(s) = second {
                text.push(", {names.name(s)}")
            }
            text.push(" in")
            self.line(text)
        }
        self.depth += 1
        if const Option.Some(e) = *expr {
            self.expr(&e, names)
        }
        self.block("body", body, names)
        self.depth -= 1
    }

    // -----------------------------------------------------------------------
    // Items

    fn attributes(mut self, attrs: List<Attribute>, names: Interner) {
        for i in 0..attrs.len() {
            let text = names.name(attrs[i].name).toOwned()
            for j in 0..attrs[i].args.len() {
                text.push(if j == 0 { "(" } else { ", " })
                text.push(literalText(&attrs[i].args[j], names))
            }
            if attrs[i].args.len() > 0 {
                text.push(")")
            }
            self.line("attr {text}")
        }
    }

    fn bounds(mut self, preds: &List<WherePred>, names: Interner) {
        for i in 0..preds.len() {
            const prefix = if preds[i].isConst { "const " } else { "" }
            let text = "bound {prefix}{typeText(&preds[i].ty, names)}:"
            for j in 0..preds[i].bounds.len() {
                text.push(if j > 0 { " + " } else { " " })
                text.push(typeText(&preds[i].bounds[j], names))
            }
            self.line(text)
        }
    }

    fn asserts(mut self, list: &List<TypeExpr>, names: Interner) {
        if list.len() > 0 {
            self.line("asserts {typesText(list.clone(), names)}")
        }
    }

    fn symbols(mut self, label: str, list: List<Symbol>, sep: str, names: Interner) {
        if list.len() == 0 {
            return
        }
        let text = "{label} "
        for i in 0..list.len() {
            if i > 0 {
                text.push(sep)
            }
            text.push(names.name(list[i]))
        }
        self.line(text)
    }

    fn param(mut self, param: &Param, names: Interner) {
        const ty = typeText(&param.ty, names)
        if ty.len() == 0 {   // a closure parameter without a written type
            self.line("param {names.name(param.name)}")
        } else {
            self.line("param {names.name(param.name)}: {modeText(param.mode)}{ty}")
        }
        if const Option.Some(value) = param.defaultValue {
            self.depth += 1
            self.line("default")
            self.depth += 1
            self.expr(&value, names)
            self.depth -= 2
        }
    }

    fn fnDecl(mut self, f: &FnDecl, names: Interner) {
        let flags = if f.isPub { " pub" } else { "" }
        flags.push(if f.isUnsafe { " unsafe" } else { "" })
        flags.push(if f.abi.len() > 0 { " extern" } else { "" })
        self.line("fn {names.name(f.name)}{flags}")
        self.depth += 1
        self.attributes(f.attributes, names)
        self.symbols("type_params", f.typeParams, ", ", names)
        self.bounds(&f.bounds, names)
        if f.hasSelf {
            self.line("{modeText(f.selfMode)}self")
        }
        for i in 0..f.params.len() {
            self.param(&f.params[i], names)
        }
        self.typeLine("returns", &f.ret, names)
        if const Option.Some(body) = f.body {
            self.block("body", &body, names)
        }
        self.depth -= 1
    }

    fn fields(mut self, fields: List<FieldDecl>, names: Interner) {
        for i in 0..fields.len() {
            const f = &fields[i]
            const prefix = match f.name {
                Option.Some(name) => "{names.name(name)}: "
                Option.None => "".toOwned()
            }
            const label = if f.isPub { "field pub" } else { "field" }
            self.line("{label} {prefix}{typeText(&f.ty, names)}")
            if const Option.Some(value) = f.defaultValue {
                self.depth += 1
                self.expr(&value, names)
                self.depth -= 1
            }
        }
    }

    fn variants(mut self, variants: List<Variant>, names: Interner) {
        for i in 0..variants.len() {
            const v = &variants[i]
            let text = names.name(v.name).toOwned()
            for j in 0..v.fields.len() {
                text.push(if j == 0 { "(" } else { ", " })
                if const Option.Some(name) = v.fields[j].name {
                    text.push("{names.name(name)}: ")
                }
                text.push(typeText(&v.fields[j].ty, names))
            }
            if v.hasFields {
                text.push(if v.fields.len() > 0 { ")" } else { "()" })
            }
            self.line("variant {text}")
            if const Option.Some(value) = v.discriminant {
                self.depth += 1
                self.expr(&value, names)
                self.depth -= 1
            }
        }
    }

    fn methods(mut self, fns: List<FnDecl>, names: Interner) {
        for i in 0..fns.len() {
            self.fnDecl(&fns[i], names)
        }
    }

    fn item(mut self, it: &Item, names: Interner) {
        const name = names.name(it.name)
        const isPub = if it.isPub { " pub" } else { "" }
        match it.kind {
            ItemKind.Fn(decl) => self.fnDecl(&*decl, names)
            ItemKind.Struct(isCopy, isRef, isTuple, typeParams, fields, methods) => {
                const keyword = if isTuple { "tuple_struct" } else { "struct" }
                const copyFlag = if isCopy { " copy" } else { "" }
                const flags = copyFlag + (if isRef { " ref" } else { "" })
                self.line("{keyword} {name}{isPub}{flags}")
                self.depth += 1
                self.attributes(it.attributes, names)
                self.symbols("type_params", typeParams, ", ", names)
                self.bounds(&it.bounds, names)
                self.asserts(&it.asserts, names)
                self.fields(fields, names)
                self.methods(methods, names)
                self.depth -= 1
            }
            ItemKind.Enum(isCopy, typeParams, variants, methods) => {
                self.line("enum {name}{isPub}{if isCopy { " copy" } else { "" }}")
                self.depth += 1
                self.attributes(it.attributes, names)
                self.symbols("type_params", typeParams, ", ", names)
                self.bounds(&it.bounds, names)
                self.asserts(&it.asserts, names)
                self.variants(variants, names)
                self.methods(methods, names)
                self.depth -= 1
            }
            ItemKind.Const(ty, value) => self.valueItem("const", name, isPub, &ty, &value, names)
            ItemKind.Global(ty, value) => self.valueItem("global", name, isPub, &ty, &value, names)
            ItemKind.TypeAlias(typeParams, ty) => {
                self.line("type {name}{isPub}")
                self.depth += 1
                self.symbols("type_params", typeParams, ", ", names)
                self.line("= {typeText(&ty, names)}")
                self.depth -= 1
            }
            ItemKind.Import(path, alias) => {
                self.symbols("import", path, ".", names)
                if const Option.Some(a) = alias {
                    self.depth += 1
                    self.line("as {names.name(a)}")
                    self.depth -= 1
                }
            }
            ItemKind.Extern(abi, fns) => {
                self.line("extern \"{abi}\"")
                self.depth += 1
                self.methods(fns, names)
                self.depth -= 1
            }
            ItemKind.Interface(typeParams, embeds, methods) => {
                self.line("interface {name}{isPub}")
                self.depth += 1
                self.attributes(it.attributes, names)
                let declared: List<Symbol> = []
                for i in 1..typeParams.len() {   // after the implicit `Self`
                    declared.push(typeParams[i])
                }
                self.symbols("type_params", declared, ", ", names)
                self.bounds(&it.bounds, names)
                for i in 0..embeds.len() {
                    self.line("embed {typeText(&embeds[i], names)}")
                }
                self.methods(methods, names)
                self.depth -= 1
            }
        }
    }

    fn valueItem(mut self, keyword: str, name: str, isPub: str, ty: &Option<TypeExpr>, value: &Expr,
                 names: Interner) {
        self.line("{keyword} {name}{isPub}")
        self.depth += 1
        self.typeLine("type", ty, names)
        self.expr(value, names)
        self.depth -= 1
    }
}

fn typesText(types: List<TypeExpr>, names: Interner) str {
    let out = ""
    for i in 0..types.len() {
        if i > 0 {
            out.push(", ")
        }
        out.push(typeText(&types[i], names))
    }
    return out
}

fn nameOf(symbol: Option<Symbol>, names: Interner) str {
    return match symbol {
        Option.Some(s) => names.name(s)
        Option.None => ""
    }
}

// ` name` for a labeled `break` or `continue`, else "".
fn labelText(label: Option<Symbol>, names: Interner) str {
    return match label {
        Option.Some(s) => " {names.name(s)}"
        Option.None => ""
    }
}

fn opText(op: Op) str {
    return match op {
        Op.Add => "+"
        Op.Sub => "-"
        Op.Mul => "*"
        Op.Div => "/"
        Op.Rem => "%"
        Op.And => "&"
        Op.Or => "|"
        Op.Xor => "^"
        Op.Shl => "<<"
        Op.Shr => ">>"
        Op.Eq => "=="
        Op.Ne => "!="
        Op.Lt => "<"
        Op.Le => "<="
        Op.Gt => ">"
        Op.Ge => ">="
        Op.LogicalAnd => "&&"
        Op.LogicalOr => "||"
        Op.Coalesce => "??"
        Op.Neg => "-"
        Op.Not => "!"
        Op.Deref => "*"
        Op.Ref => "&"
        Op.RefMut => "&mut"
        Op.Assign => "="
    }
}
