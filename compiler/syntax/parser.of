/**
 * @module
 * Parser core: the token stream, newlines, errors and recovery, and the
 * entry point (stage 0: bootstrap/src/syntax/parser.c). Each grammar area
 * has its own file (`parse_*.of`).
 */

import base.intern.Interner
import base.intern.Symbol
import base.span.FileId
import base.span.Span
import diag.Diagnostics
import syntax.ast.Module
import syntax.ast.NodeId
import syntax.ast.TypeExpr
import syntax.ast.WherePred
import syntax.parse_items.docTestItems
import syntax.parse_items.moduleItems
import syntax.token.Token
import syntax.token.TokenKind
import syntax.token.TokenValue
import syntax.token_print.kindText

/** The nesting limit of the parser (E0101, spec A.8). */
pub const MAX_NESTING: int = 256

/**
 * What `parse` gives back: the tree and the tables it took over.
 */
pub struct ParseResult {
    /** The syntax tree of the file. */
    pub module: Module
    /** The interner, with the names the parser added. */
    pub names: Interner
    /** The diagnostics, with the syntax errors. */
    pub diags: Diagnostics
}

/**
 * The parser's state, shared by the `parse_*` modules.
 */
pub struct Parser {
    /** The tokens of the file, without doc comments; the last is `Eof`. */
    pub tokens: List<Token>
    /** The index of the current token. */
    pub pos: int
    /** The source text, for the digits of `pair.0.1`. */
    pub src: str
    /** In `if`, `match` and `for` headers (spec A.6). */
    pub noStructLiteral: bool
    /** In the pattern of a `match` arm or an `if const`: `name: T` is a type test. */
    pub typeTests: bool
    /** An error was reported: silent until resynchronized. */
    pub recovering: bool
    /** Past the nesting limit (E0101): the parse is unwinding to the end. */
    pub tooDeep: bool
    /** The open levels of nesting (`nest`). */
    pub depth: int
    /** The interner, for contextual keywords and type names. */
    pub names: Interner
    /** Where syntax errors go. */
    pub diags: Diagnostics
    /** The contextual keywords (spec 1.5). */
    pub words: Words
    /** The id of the next node. */
    pub nextId: int
    /** The bounds of the type parameters of the struct or enum being parsed. */
    pub typeBounds: List<WherePred>
    /** The interfaces asserted by the struct or enum being parsed. */
    pub typeAsserts: List<TypeExpr>
    /** The variables of the enclosing `comptime for` loops: `field.get(v)` is `v[field]`. */
    pub comptimeNames: List<Symbol>

    /**
     * Numbers a new node.
     *
     * @returns its id
     */
    pub fn newId(mut self) NodeId {
        self.nextId += 1
        return NodeId(self.nextId - 1)
    }

    /**
     * The kind of the token `ahead` positions after the current one; past
     * the end, `Eof`.
     *
     * @param ahead how far to look
     * @returns its kind
     */
    pub fn peekAt(self, ahead: int) TokenKind {
        return self.token(ahead).kind
    }

    /**
     * The token `ahead` positions after the current one; past the end, the
     * last token, `Eof`.
     *
     * @param ahead how far to look
     * @returns the token
     */
    pub fn token(self, ahead: int) &Token {
        const i = self.pos + ahead
        return &self.tokens[if i < self.tokens.len() { i } else { self.tokens.len() - 1 }]
    }

    /**
     * The kind of the current token.
     *
     * @returns its kind
     */
    pub fn peek(self) TokenKind {
        return self.token(0).kind
    }

    /**
     * The span of the current token.
     *
     * @returns its span
     */
    pub fn here(self) Span {
        return self.token(0).span
    }

    /**
     * Whether the current token is of `kind`.
     *
     * @param kind the kind to look for
     * @returns true if it is
     */
    pub fn at(self, kind: TokenKind) bool {
        return self.peek() == kind
    }

    /**
     * Moves to the next token; it stays on the last one, `Eof`.
     *
     * @returns the span of the token passed
     */
    pub fn advance(mut self) Span {
        const span = self.here()
        if self.pos < self.tokens.len() - 1 {
            self.pos += 1
        }
        return span
    }

    /**
     * Consumes the current token if it is of `kind`.
     *
     * @param kind the kind to accept
     * @returns whether it was consumed
     */
    pub fn accept(mut self, kind: TokenKind) bool {
        if self.at(kind) {
            self.advance()
            return true
        }
        return false
    }

    /**
     * Whether the current token is the identifier `word`.
     *
     * @param word a contextual keyword, if it was ever interned
     * @returns true if it is
     */
    pub fn atWord(self, word: Option<Symbol>) bool {
        const t = self.token(0)
        return t.kind == TokenKind.Ident && word.isSome() &&
               symbolOf(t).0 == word.unwrapOr(Symbol(0)).0
    }

    /**
     * Skips newlines, wherever the grammar needs more tokens (spec 1.3).
     */
    pub fn skipNewlines(mut self) {
        for self.at(TokenKind.Newline) {
            self.advance()
        }
    }

    /**
     * The span from `start` to the end of the previous token.
     *
     * @param start where the construct began
     * @returns the span
     */
    pub fn spanSince(self, start: Span) Span {
        const previous = self.tokens[if self.pos > 0 { self.pos - 1 } else { 0 }].span
        const end = if previous.end > start.start { previous.end } else { start.end }
        return Span{file: start.file, start: start.start, end}
    }

    /**
     * Reports a syntax error (E0100), unless one was reported for this
     * statement already: the rest is usually a consequence.
     *
     * @param span where it is
     * @param message what is wrong
     */
    pub fn syntaxError(mut self, span: Span, message: move str) {
        if self.recovering || self.tooDeep {
            return
        }
        self.diags.error("E0100", span, message)
        self.recovering = true
    }

    /**
     * Enters a level of nesting (E0101): each level of expressions, types
     * and patterns, and each step of an operator or postfix chain, is one.
     * Past the limit it reports E0101 once, moves to the end of the file and
     * returns false. The caller leaves the level (`depth -= 1`) either way.
     *
     * @returns whether the parse goes on into the level
     */
    pub fn nest(mut self) bool {
        self.depth += 1
        if self.depth <= MAX_NESTING && !self.tooDeep {
            return true
        }
        if !self.tooDeep {
            const span = self.token(0).span
            self.diags.error("E0101", span, "nesting too deep: more than {MAX_NESTING} levels")
            self.tooDeep = true
        }
        self.recovering = true
        self.pos = self.tokens.len() - 1   // the end of the file
        return false
    }

    /**
     * Reports "expected <what>, found <the current token>".
     *
     * @param what what the grammar needs here
     */
    pub fn unexpected(mut self, what: str) {
        const t = self.token(0)
        const found = describe(t.kind)
        const span = self.errorSpan()
        if found.len() > 0 {
            self.syntaxError(span, "expected {what}, found {found}")
        } else {
            self.syntaxError(span, "expected {what}, found `{kindText(t.kind)}`")
        }
    }

    // Where to report a missing token: at the token found, or, for the end
    // of a line, just after the previous token (not after a comment).
    fn errorSpan(self) Span {
        const t = self.token(0)
        if t.kind != TokenKind.Newline || self.pos == 0 {
            return t.span
        }
        const after = self.tokens[self.pos - 1].span
        return Span{file: after.file, start: after.end, end: after.end}
    }

    /**
     * Consumes a token of `kind`, or reports what was expected.
     *
     * @param kind the kind needed
     * @param what how to describe it in the error
     * @returns whether it was there
     */
    pub fn expect(mut self, kind: TokenKind, what: str) bool {
        if self.at(kind) {
            self.advance()
            return true
        }
        self.unexpected(what)
        return false
    }

    /**
     * Consumes an identifier, or reports what was expected.
     *
     * @param what how to describe it in the error
     * @returns its name, or `None` if it was missing
     */
    pub fn expectName(mut self, what: str) Option<Symbol> {
        if self.at(TokenKind.Ident) {
            const name = symbolOf(self.token(0))
            self.advance()
            return Option.Some(name)
        }
        self.unexpected(what)
        return Option.None
    }

    /**
     * Consumes the identifier at the current token.
     *
     * @returns its name
     */
    pub fn takeName(mut self) Symbol {
        const name = symbolOf(self.token(0))
        self.advance()
        return name
    }

    /**
     * Consumes a `,`, a newline, or both, between list members.
     *
     * @returns false if there was neither
     */
    pub fn acceptSeparator(mut self) bool {
        const comma = self.accept(TokenKind.Comma)
        const newline = self.accept(TokenKind.Newline)
        return comma || newline
    }

    /**
     * Consumes the end of a statement: a newline, or nothing before `}` or
     * the end of the file.
     */
    pub fn expectTerminator(mut self) {
        if self.accept(TokenKind.Newline) {
            self.skipNewlines()
        } else if !self.at(TokenKind.RBrace) && !self.at(TokenKind.Eof) {
            self.unexpected("a new line after the statement")
        }
    }

    /**
     * Skips to the end of the current statement: a newline outside
     * brackets, or the `}` that closes the enclosing block (not consumed).
     */
    pub fn synchronize(mut self) {
        let depth = 0
        for !self.at(TokenKind.Eof) {
            const k = self.peek()
            if depth == 0 && (k == TokenKind.Newline || k == TokenKind.RBrace) {
                break
            }
            if k == TokenKind.LParen || k == TokenKind.LBracket || k == TokenKind.LBrace {
                depth += 1
            } else if (k == TokenKind.RParen || k == TokenKind.RBracket || k == TokenKind.RBrace) &&
                      depth > 0 {
                depth -= 1
            }
            self.advance()
        }
        self.skipNewlines()
        self.recovering = false
    }
}

/**
 * The contextual keywords: identifiers that are keywords in some places.
 */
pub copy struct Words {
    /** `move` */
    pub move: Option<Symbol>
    /** `type` */
    pub type: Option<Symbol>
    /** `ref` */
    pub ref: Option<Symbol>
    /** `where` */
    pub where: Option<Symbol>
    /** `_` */
    pub wildcard: Option<Symbol>
    /** `keyof` */
    pub keyof: Option<Symbol>
    /** `is`, in a conditional type */
    pub is: Option<Symbol>
    /** `infer`, in the pattern of a conditional type */
    pub infer: Option<Symbol>
    /** `Send`, in `move fn() R + Send` */
    pub send: Option<Symbol>
}

/**
 * The name of an identifier token.
 *
 * @param t an `Ident` token
 * @returns its symbol
 */
pub fn symbolOf(t: &Token) Symbol {
    return match t.value {
        TokenValue.Name(symbol) => symbol
        _ => Symbol(0)
    }
}

/**
 * The text of a string or doc comment token.
 *
 * @param t the token
 * @returns its text
 */
pub fn textOf(t: &Token) str {
    return match t.value {
        TokenValue.Str(text) => text.sliceFrom(0)
        _ => ""
    }
}

fn describe(kind: TokenKind) str {
    return match kind {
        TokenKind.Ident => "an identifier"
        TokenKind.Int | TokenKind.Float | TokenKind.Byte => "a number"
        TokenKind.Str | TokenKind.StrStart => "a string"
        TokenKind.Newline => "the end of the line"
        TokenKind.Eof => "the end of the file"
        _ => ""
    }
}

/**
 * Parses the tokens of a file. Module documentation comments become the
 * module's documentation; other doc comments are dropped (spec 12.5).
 *
 * @param file the file the tokens come from
 * @param src its text
 * @param tokens its tokens, ending with `Eof`
 * @param names the interner of their names
 * @param diags where errors go
 * @returns the tree, with the interner and the diagnostics
 */
pub fn parse(file: FileId, src: str, tokens: move List<Token>, names: move Interner,
             diags: move Diagnostics) ParseResult {
    return parseFrom(file, src, tokens, names, diags, 0, false)
}

/**
 * Parses a file whose nodes are numbered from `firstId`: the test file of
 * a module joins the module's items, so its nodes follow the module's.
 *
 * @param file the file
 * @param src its text
 * @param tokens its tokens
 * @param names the interner
 * @param diags the diagnostics
 * @param firstId the number of the first node
 * @param docTest whether the file is a doc test (`docTestItems`)
 * @returns the tree, the interner and the diagnostics
 */
pub fn parseFrom(file: FileId, src: str, tokens: move List<Token>, names: move Interner,
                 diags: move Diagnostics, firstId: int, docTest: bool) ParseResult {
    let docs: List<str> = []
    let kept: List<Token> = []
    for i in 0..tokens.len() {
        const kind = tokens[i].kind
        if kind == TokenKind.ModuleDoc {
            docs.push(textOf(&tokens[i]).toOwned())
        } else if kind != TokenKind.DocComment {
            kept.push(copyToken(&tokens[i]))
        }
    }
    const words = Words{move: names.find("move"), type: names.find("type"), ref: names.find("ref"),
                        where: names.find("where"), wildcard: names.find("_"),
                        keyof: names.find("keyof"), is: names.find("is"),
                        infer: names.find("infer"), send: names.find("Send")}
    let p = Parser{tokens: kept, pos: 0, src: src.sliceFrom(0), noStructLiteral: false,
                   typeTests: false, recovering: false, tooDeep: false, depth: 0, names, diags,
                   words, nextId: firstId, typeBounds: [], typeAsserts: [], comptimeNames: []}
    const items = if docTest { docTestItems(p) } else { moduleItems(p) }
    const module = Module{file, nodeCount: p.nextId, docs, items}
    return ParseResult{module, names: p.names, diags: p.diags}
}

fn copyToken(t: &Token) Token {
    const value: TokenValue = match t.value {
        TokenValue.None => TokenValue.None
        TokenValue.Int(v) => TokenValue.Int(v)
        TokenValue.Float(v) => TokenValue.Float(v)
        TokenValue.Byte(v) => TokenValue.Byte(v)
        TokenValue.Str(text) => TokenValue.Str(text.toOwned())
        TokenValue.Name(symbol) => TokenValue.Name(symbol)
    }
    return Token{kind: t.kind, span: t.span, value}
}
