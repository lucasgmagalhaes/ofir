/**
 * @module
 * Blocks, `if`, `match` and `unsafe` (spec 4.1, 4.3, 4.5, 4.6; stage 0:
 * bootstrap/src/syntax/parse_control.c).
 */

import base.span.Span
import syntax.ast.Block
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.MatchArm
import syntax.ast.Pattern
import syntax.ast.Stmt
import syntax.parse_exprs.newExpr
import syntax.parse_exprs.parseExpr
import syntax.parse_exprs.parseExprNoStruct
import syntax.parse_patterns.parseTestPattern
import syntax.parse_primary.parsePostfix
import syntax.parse_primary.parsePrimary
import syntax.parse_stmts.parseStmt
import syntax.parser.Parser
import syntax.token.TokenKind

/**
 * A block: `{ statements }`.
 *
 * @param p the parser
 * @returns the block
 */
pub fn parseBlock(p: mut Parser) Block {
    const start = p.here()
    if !p.expect(TokenKind.LBrace, "`\{` to start a block") {
        return Block{span: start, stmts: []}
    }
    const saved = p.noStructLiteral
    p.noStructLiteral = false
    let stmts: List<Stmt> = []
    p.skipNewlines()
    for !p.at(TokenKind.RBrace) && !p.at(TokenKind.Eof) {
        stmts.push(parseStmt(p))
        if p.recovering {
            p.synchronize()
        } else {
            p.expectTerminator()
        }
    }
    p.expect(TokenKind.RBrace, "`\}` to close the block")
    p.noStructLiteral = saved
    return Block{span: p.spanSince(start), stmts}
}

// `if cond { } else if ... else { }` and `if const pattern = value { }`;
// `comptime if` (spec 15.3) when `start` is the span of `comptime`.
fn ifExpr(p: mut Parser, comptimeAt: Option<Span>) Expr {
    const start = match comptimeAt {
        Option.Some(at) => {
            p.advance()
            at
        }
        Option.None => p.advance()
    }
    let letPattern: Option<Pattern> = Option.None
    if comptimeAt.isNone() && p.accept(TokenKind.Const) {
        letPattern = Option.Some(parseTestPattern(p))
        p.expect(TokenKind.Eq, "`=` after the pattern")
    }
    let cond = parseExprNoStruct(p)
    if comptimeAt.isSome() {
        cond = newExpr(p, ExprKind.Comptime(Box.new(cond)), start)
    }
    const then = parseBlock(p)
    let otherwise: Option<Box<Expr>> = Option.None
    if p.accept(TokenKind.Else) {
        const elseStart = p.here()
        if p.at(TokenKind.If) {
            if p.nest() {   // an `else if` chain is as deep as it is long
                otherwise = Option.Some(Box.new(ifExpr(p, Option.None)))
            }
            p.depth -= 1
        } else if p.at(TokenKind.Comptime) && p.peekAt(1) == TokenKind.If {
            const at = p.advance()
            if p.nest() {
                otherwise = Option.Some(Box.new(ifExpr(p, Option.Some(at))))
            }
            p.depth -= 1
        } else {
            const block = parseBlock(p)
            otherwise = Option.Some(Box.new(newExpr(p, ExprKind.Block(block), elseStart)))
        }
    }
    return newExpr(p, ExprKind.If(letPattern, Box.new(cond), then, otherwise), start)
}

fn matchArm(p: mut Parser) MatchArm {
    const pattern = parseTestPattern(p)
    let guard: Option<Expr> = Option.None
    if p.accept(TokenKind.If) {
        guard = Option.Some(parseExprNoStruct(p))
    }
    p.expect(TokenKind.FatArrow, "`=>` after the pattern")
    p.skipNewlines()
    return MatchArm{pattern, guard, body: parseExpr(p)}
}

fn matchExpr(p: mut Parser) Expr {
    const start = p.advance()
    const scrutinee = parseExprNoStruct(p)
    let arms: List<MatchArm> = []
    if p.expect(TokenKind.LBrace, "`\{` after the matched value") {
        p.skipNewlines()
        for !p.at(TokenKind.RBrace) && !p.at(TokenKind.Eof) {
            arms.push(matchArm(p))
            if p.recovering {
                p.synchronize()
                continue
            }
            const separated = p.acceptSeparator()
            p.skipNewlines()
            if !separated && !p.at(TokenKind.RBrace) {
                p.unexpected("a new line or `,` after the match arm")
                p.synchronize()
            }
        }
        p.expect(TokenKind.RBrace, "`\}` to close the match")
    }
    return newExpr(p, ExprKind.Match(Box.new(scrutinee), arms), start)
}

/**
 * A block, `if`, `match`, `unsafe` or `comptime` expression; one of them is
 * next.
 *
 * @param p the parser
 * @returns the expression
 */
pub fn parseControl(p: mut Parser) Expr {
    const start = p.here()
    return match p.peek() {
        TokenKind.If => ifExpr(p, Option.None)
        TokenKind.Match => matchExpr(p)
        TokenKind.Comptime => {
            p.advance()
            if p.at(TokenKind.If) {
                ifExpr(p, Option.Some(start))
            } else {   // `comptime panic(...)`
                const inner = parsePostfix(p, parsePrimary(p))
                newExpr(p, ExprKind.Comptime(Box.new(inner)), start)
            }
        }
        TokenKind.Unsafe => {
            p.advance()
            const block = parseBlock(p)
            newExpr(p, ExprKind.Unsafe(block), start)
        }
        _ => {
            const block = parseBlock(p)
            newExpr(p, ExprKind.Block(block), start)
        }
    }
}
