/**
 * @module
 * Patterns (spec appendix A.7; stage 0: bootstrap/src/syntax/parse_patterns.c).
 */

import base.intern.Symbol
import base.span.Span
import syntax.ast.FieldPattern
import syntax.ast.Pattern
import syntax.ast.PatternKind
import syntax.parse_primary.atLiteral
import syntax.parse_primary.parseLiteral
import syntax.parse_types.parseSimpleType
import syntax.parser.Parser
import syntax.token.TokenKind

fn newPattern(p: mut Parser, kind: move PatternKind, start: Span) Pattern {
    return Pattern{id: p.newId(), kind, span: p.spanSince(start)}
}

// `(p, q)` after the `(`; also the arguments of variants and tuple structs.
fn patternList(p: mut Parser) List<Pattern> {
    let items: List<Pattern> = []
    for !p.at(TokenKind.RParen) && !p.at(TokenKind.Eof) {
        items.push(parsePattern(p))
        if !p.accept(TokenKind.Comma) {
            break
        }
    }
    p.expect(TokenKind.RParen, "`)` to close the patterns")
    return items
}

// A literal, optionally followed by `..` or `..=` and a second literal.
fn literalOrRange(p: mut Parser, start: Span) Pattern {
    const lo = Box.new(parseLiteral(p))
    if !p.at(TokenKind.DotDot) && !p.at(TokenKind.DotDotEq) {
        return newPattern(p, PatternKind.Literal(lo), start)
    }
    const inclusive = p.peek() == TokenKind.DotDotEq
    p.advance()
    if !atLiteral(p) {
        p.unexpected("a literal to end the range")
    }
    const hi = Box.new(parseLiteral(p))
    return newPattern(p, PatternKind.Range(lo, hi, inclusive), start)
}

// `.Name` or `.Name(p, q)`; the `.` is next.
fn variantShorthand(p: mut Parser, start: Span) Pattern {
    p.advance()
    const name = p.expectName("a variant name after `.`") ?? Symbol(0)
    let args: List<Pattern> = []
    const hasArgs = p.accept(TokenKind.LParen)
    if hasArgs {
        args = patternList(p)
    }
    return newPattern(p, PatternKind.Variant([], name, args, hasArgs), start)
}

// `Point{x, y: 0, ..}` after the `{`.
fn structPattern(p: mut Parser, path: move List<Symbol>, start: Span) Pattern {
    let fields: List<FieldPattern> = []
    p.skipNewlines()
    for p.at(TokenKind.Ident) {
        const name = p.takeName()
        let pattern: Option<Pattern> = Option.None
        if p.accept(TokenKind.Colon) {
            pattern = Option.Some(parsePattern(p))
        }
        fields.push(FieldPattern{id: p.newId(), name, pattern})
        p.skipNewlines()
        if !p.accept(TokenKind.Comma) {
            break
        }
        p.skipNewlines()
    }
    const rest = p.accept(TokenKind.DotDot)
    p.skipNewlines()
    p.expect(TokenKind.RBrace, "`\}` to close the struct pattern")
    return newPattern(p, PatternKind.Struct(path, fields, rest), start)
}

// A pattern starting with a name: a binding, `Enum.Variant(...)`,
// `TupleStruct(...)` or `Struct{...}`.
fn named(p: mut Parser, start: Span) Pattern {
    let path = [p.takeName()]
    for p.at(TokenKind.Dot) && p.peekAt(1) == TokenKind.Ident {
        p.advance()
        path.push(p.takeName())
    }
    if p.accept(TokenKind.LBrace) {
        return structPattern(p, path, start)
    }
    if path.len() == 1 && p.accept(TokenKind.LParen) {
        const args = patternList(p)
        return newPattern(p, PatternKind.TupleStruct(path, args), start)
    }
    if path.len() > 1 {
        const name = path.pop() ?? Symbol(0)
        const hasArgs = p.accept(TokenKind.LParen)
        let args: List<Pattern> = []
        if hasArgs {
            args = patternList(p)
        }
        return newPattern(p, PatternKind.Variant(path, name, args, hasArgs), start)
    }
    const name = path[0]
    const wildcard = p.words.wildcard.isSome() && (p.words.wildcard ?? Symbol(0)).0 == name.0
    if p.typeTests && p.accept(TokenKind.Colon) {
        let bound: Option<Symbol> = Option.None
        if !wildcard {
            bound = Option.Some(name)
        }
        const ty = parseSimpleType(p)
        return newPattern(p, PatternKind.TypeTest(bound, ty), start)
    }
    if wildcard {
        return newPattern(p, PatternKind.Wildcard, start)
    }
    return newPattern(p, PatternKind.Binding(name, false), start)
}

fn atom(p: mut Parser) Pattern {
    const start = p.here()
    return match p.peek() {
        TokenKind.Ident => named(p, start)
        TokenKind.Dot => variantShorthand(p, start)
        TokenKind.Mut => {
            p.advance()
            const name = p.expectName("a name after `mut`") ?? Symbol(0)
            newPattern(p, PatternKind.Binding(name, true), start)
        }
        TokenKind.LParen => {
            p.advance()
            const items = patternList(p)
            newPattern(p, PatternKind.Tuple(items), start)
        }
        _ => if atLiteral(p) {
            literalOrRange(p, start)
        } else {
            p.unexpected("a pattern")
            newPattern(p, PatternKind.Wildcard, start)
        }
    }
}

/**
 * The pattern of a `match` arm or an `if const`, where `name: T` is a type
 * test (spec 9.8).
 *
 * @param p the parser
 * @returns the pattern
 */
pub fn parseTestPattern(p: mut Parser) Pattern {
    const saved = p.typeTests
    p.typeTests = true
    const pattern = parsePattern(p)
    p.typeTests = saved
    return pattern
}

// `name @ pattern` after the name; the pattern may have alternatives.
fn atBinding(p: mut Parser, first: move Pattern, start: Span) Pattern {
    return match first.kind {
        PatternKind.Binding(name, mutable) => {
            p.advance()
            const inner = Box.new(parsePattern(p))
            newPattern(p, PatternKind.At(name, mutable, inner), start)
        }
        _ => first   // the caller reports the `@`
    }
}

/**
 * A pattern, with `|` alternatives.
 *
 * @param p the parser
 * @returns the pattern
 */
pub fn parsePattern(p: mut Parser) Pattern {
    const start = p.here()
    const first = atom(p)
    if p.at(TokenKind.At) {
        return atBinding(p, first, start)
    }
    if !p.at(TokenKind.Pipe) {
        return first
    }
    let alternatives = [first]
    for p.accept(TokenKind.Pipe) {
        p.skipNewlines()
        alternatives.push(atom(p))
    }
    return newPattern(p, PatternKind.Or(alternatives), start)
}
