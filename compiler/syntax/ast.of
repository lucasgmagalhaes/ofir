/**
 * @module
 * The abstract syntax tree (spec appendix A), as stage 0's
 * (bootstrap/src/syntax/ast.h) without its semantic annotations: the AST is
 * a faithful representation of the source, and later phases keep their
 * results beside it, in tables indexed by the `NodeId` of the nodes.
 */

import base.intern.Symbol
import base.span.FileId
import base.span.Span

/**
 * The number of a node of a module's tree: expressions, patterns,
 * statements, parameters, functions and the fields of literals and
 * patterns, numbered from 0 in the order the parser finishes them.
 */
pub copy struct NodeId(int)

/**
 * How a parameter receives its argument (spec 5.3).
 */
pub copy enum Mode {
    /** Borrows it (the default). */
    Borrow
    /** Borrows it mutably: `mut x`. */
    Mut
    /** Takes it over: `move x`. */
    Move
}

/**
 * The operators of unary, binary and assignment expressions.
 */
pub copy enum Op {
    Add, Sub, Mul, Div, Rem
    And, Or, Xor, Shl, Shr
    Eq, Ne, Lt, Le, Gt, Ge
    LogicalAnd, LogicalOr, Coalesce
    Neg, Not, Deref, Ref, RefMut
    Assign
}

// ---------------------------------------------------------------------------
// Types

/**
 * A type as written: `List<int>`, `&mut T`, `fn(int) str`.
 */
pub struct TypeExpr {
    /** What it is. */
    pub kind: TypeKind
    /** Where it is written. */
    pub span: Span
}

/**
 * The forms of a type.
 */
pub enum TypeKind {
    /** `a.b.Name<args>` */
    Path(segments: List<Symbol>, args: List<TypeExpr>)
    /** `Self` */
    SelfType
    /** `&T`, `&mut T` */
    Ref(mutable: bool, inner: Box<TypeExpr>)
    /** `*T`, `*mut T` */
    Ptr(mutable: bool, inner: Box<TypeExpr>)
    /** `[T]` */
    Slice(elem: Box<TypeExpr>)
    /** `[T; N]` */
    Array(elem: Box<TypeExpr>, len: Box<Expr>)
    /** `(A, B)`; `()` is the unit type. */
    Tuple(items: List<TypeExpr>)
    /** `fn(A) R`, `move fn(A) R`; `send` for `+ Send` (spec 14.3) */
    Fn(params: List<TypeExpr>, modes: List<Mode>, ret: Option<Box<TypeExpr>>, owned: bool,
       send: bool)
    /** `dyn I` */
    Dyn(inner: Box<TypeExpr>)
    /** `T?` */
    Optional(inner: Box<TypeExpr>)
    /** `!` */
    Never
    /** `keyof T` (spec 16.1) */
    KeyOf(inner: Box<TypeExpr>)
    /** A key literal: `.x`, or `.0` with the index as its name. */
    Key(name: Symbol)
    /** `A | B`, `A & B`, `A - B` on key types (`Op.Or`, `Op.And`, `Op.Sub`). */
    KeyOp(op: Op, left: Box<TypeExpr>, right: Box<TypeExpr>)
    /** `T[K]`, an indexed access type (spec 16.3) */
    Index(base: Box<TypeExpr>, key: Box<TypeExpr>)
    /** `{ [K in Keys if Cond]?: F }`, a mapped type (spec 16.4) */
    Mapped(param: Symbol, keys: Box<TypeExpr>, filter: Option<Box<TypeExpr>>, optional: bool,
           field: Box<TypeExpr>)
    /** `A is B`, the condition of a conditional type (spec 16.5) */
    Is(left: Box<TypeExpr>, pattern: Box<TypeExpr>)
    /** `if A is B { X } else { Y }`, a conditional type (spec 16.5) */
    Cond(test: Box<TypeExpr>, then: Box<TypeExpr>, otherwise: Box<TypeExpr>)
    /** `infer U` in the pattern of a conditional type */
    Infer(name: Symbol)
    /** `true` or `false`, the value of a condition */
    Bool(value: bool)
    /** An integer argument of a const parameter: `4`, `-1` (spec 8.7) */
    Const(value: int)
}

// ---------------------------------------------------------------------------
// Patterns

/**
 * A pattern of `const`, `match` and `if const`.
 */
pub struct Pattern {
    /** Its number. */
    pub id: NodeId
    /** What it is. */
    pub kind: PatternKind
    /** Where it is written. */
    pub span: Span
}

/**
 * The forms of a pattern.
 */
pub enum PatternKind {
    /** `_` */
    Wildcard
    /** `name`, `mut name` */
    Binding(name: Symbol, mutable: bool)
    /** `1`, `"a"`, `true`, `b'x'` */
    Literal(value: Box<Expr>)
    /** `1..=9` */
    Range(lo: Box<Expr>, hi: Box<Expr>, inclusive: bool)
    /** `.Some(x)`, `Option.Some(x)`, `Color.Red` */
    Variant(path: List<Symbol>, name: Symbol, args: List<Pattern>, hasArgs: bool)
    /** `(a, b)` */
    Tuple(items: List<Pattern>)
    /** `Point{x, y: 0, ..}` */
    Struct(path: List<Symbol>, fields: List<FieldPattern>, rest: bool)
    /** `UserId(raw)` */
    TupleStruct(path: List<Symbol>, args: List<Pattern>)
    /** `a | b` */
    Or(alternatives: List<Pattern>)
    /** `c: Circle`, `_: int`: a type test (spec 9.8); `name` is `None` for `_` */
    TypeTest(name: Option<Symbol>, ty: TypeExpr)
}

/**
 * A field of a struct pattern.
 */
pub struct FieldPattern {
    /** Its number: the shorthand `x` binds a variable there. */
    pub id: NodeId
    /** The field. */
    pub name: Symbol
    /** Its pattern; `None` for the shorthand `x`. */
    pub pattern: Option<Pattern>
}

// ---------------------------------------------------------------------------
// Expressions

/**
 * An expression.
 */
pub struct Expr {
    /** Its number. */
    pub id: NodeId
    /** What it is. */
    pub kind: ExprKind
    /** Where it is written. */
    pub span: Span
}

/**
 * The forms of an expression.
 */
pub enum ExprKind {
    /** An integer literal. */
    Int(value: u64)
    /** A float literal. */
    Float(value: float)
    /** A byte literal: `b'a'`. */
    Byte(value: u8)
    /** A string literal without interpolation. */
    Str(value: str)
    /** A byte string literal, `b"GET"`: a `&[u8]`. */
    ByteStr(value: str)
    /** `true` or `false`. */
    Bool(value: bool)
    /**
     * `"a {x} b"`: the parts alternate between strings and expressions;
     * `specs[i]` is the format specifier of `parts[i]` (`{x:5}`), or "".
     */
    Interp(parts: List<Expr>, specs: List<str>)
    /** A name. */
    Ident(name: Symbol)
    /** `self` */
    SelfValue
    /** `Self`, as in `Self.new()` */
    SelfType
    /** `Name<T, U>` in expression position (spec 8.5). */
    Generic(name: Symbol, args: List<TypeExpr>)
    /** `-x`, `!x`, `*x`, `&x`, `&mut x` */
    Unary(op: Op, operand: Box<Expr>)
    /** `a + b`, `a ?? b`, ... */
    Binary(op: Op, lhs: Box<Expr>, rhs: Box<Expr>)
    /** `x as T` */
    Cast(value: Box<Expr>, to: TypeExpr)
    /** `a..b`, `a..=b`; either bound may be missing. */
    Range(lo: Option<Box<Expr>>, hi: Option<Box<Expr>>, inclusive: bool)
    /** `f(a, name: b)` */
    Call(callee: Box<Expr>, args: List<Arg>)
    /** `a[i]` */
    Index(base: Box<Expr>, index: Box<Expr>)
    /** `a.name`, `a.name<T>` */
    Field(base: Box<Expr>, name: Symbol, typeArgs: List<TypeExpr>)
    /** `a.0` */
    TupleField(base: Box<Expr>, index: u64)
    /** `a?` */
    Try(inner: Box<Expr>)
    /** `Point{x: 1, ..base}` */
    Struct(typeName: Box<Expr>, fields: List<FieldInit>, base: Option<Box<Expr>>)
    /** `[a, b]` */
    Array(elems: List<Expr>)
    /** `[value; count]` */
    Repeat(value: Box<Expr>, count: Box<Expr>)
    /** `(a, b)`; `()` is unit. */
    Tuple(elems: List<Expr>)
    /** `.Some(x)`, `.None` */
    Variant(name: Symbol, args: List<Arg>, hasArgs: bool)
    /** `if cond { } else { }` and `if const pattern = value { }` */
    If(letPattern: Option<Pattern>, cond: Box<Expr>, then: Block, otherwise: Option<Box<Expr>>)
    /** `match value { arms }` */
    Match(scrutinee: Box<Expr>, arms: List<MatchArm>)
    /** `{ ... }` */
    Block(block: Block)
    /** `unsafe { ... }` */
    Unsafe(block: Block)
    /**
     * `comptime e` (spec 15): `comptime panic(...)`, or the condition of a
     * `comptime if`, `If(_, Comptime(cond), ...)`.
     */
    Comptime(inner: Box<Expr>)
    /**
     * `x => body`, `(a: T, b) R => body`, `move () => body` (spec 10.1); a
     * parameter without a written type has an empty path as its type.
     */
    Closure(params: List<Param>, ret: Option<TypeExpr>, body: Box<Expr>, isMove: bool)
}

/**
 * An argument of a call or a variant.
 */
pub struct Arg {
    /** The parameter it names, `name: value`; `None` for a positional one. */
    pub name: Option<Symbol>
    /** The argument. */
    pub value: Expr
}

/**
 * A field of a struct literal.
 */
pub struct FieldInit {
    /** Its number: the shorthand `x` reads the name there. */
    pub id: NodeId
    /** The field. */
    pub name: Symbol
    /** Its value; `None` for the shorthand `x`. */
    pub value: Option<Expr>
}

/**
 * An arm of a `match`.
 */
pub struct MatchArm {
    /** What it matches. */
    pub pattern: Pattern
    /** Its `if` condition, if any. */
    pub guard: Option<Expr>
    /** Its value. */
    pub body: Expr
}

// ---------------------------------------------------------------------------
// Statements

/**
 * The forms of `for`.
 */
pub copy enum ForKind {
    /** `for { }` */
    Infinite
    /** `for cond { }` */
    Cond
    /** `for [mut] x[, y] in expr { }` */
    In
}

/**
 * A statement.
 */
pub struct Stmt {
    /** Its number. */
    pub id: NodeId
    /** What it is. */
    pub kind: StmtKind
    /** Where it is written. */
    pub span: Span
    /** The label of `name: for`, `break name` or `continue name`. */
    pub label: Option<Symbol>
}

/**
 * The forms of a statement.
 */
pub enum StmtKind {
    /** `const pattern: T = value [else { ... }]` */
    Let(pattern: Pattern, ty: Option<TypeExpr>, value: Expr, otherwise: Option<Block>)
    /** `let name: T = value` */
    Var(name: Symbol, ty: Option<TypeExpr>, value: Option<Expr>)
    /** `target op= value`; `op` is `Assign` for a plain `=`. */
    Assign(op: Op, target: Expr, value: Expr)
    /** The three forms of `for`; `first, second` are the names of `for i, x in`. */
    For(kind: ForKind, mutable: bool, first: Option<Symbol>, second: Option<Symbol>,
        expr: Option<Expr>, body: Block)
    /** `return [value]` */
    Return(value: Option<Expr>)
    /** `break` */
    Break
    /** `continue` */
    Continue
    /** An expression used as a statement. */
    ExprStmt(expr: Expr)
}

/**
 * `{ statements }`
 */
pub struct Block {
    /** From `{` to `}`. */
    pub span: Span
    /** Its statements. */
    pub stmts: List<Stmt>
}

// ---------------------------------------------------------------------------
// Items

/**
 * `@name` or `@name(args)` before a declaration.
 */
pub struct Attribute {
    /** Its name. */
    pub name: Symbol
    /** Its arguments: literals and names. */
    pub args: List<Expr>
    /** Where it is written. */
    pub span: Span
}

/**
 * A parameter of a function.
 */
pub struct Param {
    /** Its number. */
    pub id: NodeId
    /** Its name. */
    pub name: Symbol
    /** How it receives its argument. */
    pub mode: Mode
    /** Its type. */
    pub ty: TypeExpr
    /** `= value`, if any. */
    pub defaultValue: Option<Expr>
    /** Where it is written. */
    pub span: Span
}

/**
 * A function or a method.
 */
pub struct FnDecl {
    /** Its number. */
    pub id: NodeId
    /** Where it is written. */
    pub span: Span
    /** Its name. */
    pub name: Symbol
    /** Its attributes. */
    pub attributes: List<Attribute>
    /** `pub` */
    pub isPub: bool
    /** `unsafe fn` */
    pub isUnsafe: bool
    /** `"C"` for `extern "C" fn`, `""` otherwise. */
    pub abi: str
    /** Its type parameters. */
    pub typeParams: List<Symbol>
    /** The bounds of its type parameters, inline (`<T: Eq>`) and in `where`, in order. */
    pub bounds: List<WherePred>
    /** Whether it is a method. */
    pub hasSelf: bool
    /** How a method receives `self`. */
    pub selfMode: Mode
    /** Its parameters, without `self`. */
    pub params: List<Param>
    /** Its result type; `None` for `()`. */
    pub ret: Option<TypeExpr>
    /** Its body; `None` in an `extern` block. */
    pub body: Option<Block>
}

/**
 * A bound on a type: `T: Eq + Hash` (spec 8.1, 8.4).
 */
pub struct WherePred {
    /** The bounded type: a type parameter. */
    pub ty: TypeExpr
    /** Its bounds: interfaces. */
    pub bounds: List<TypeExpr>
    /** Where it is written. */
    pub span: Span
    /** `const N: int`: a const parameter, its bound the type (spec 8.7). */
    pub isConst: bool
}

/**
 * A field of a struct.
 */
pub struct FieldDecl {
    /** Its name; `None` for a field of a tuple struct. */
    pub name: Option<Symbol>
    /** Its attributes. */
    pub attributes: List<Attribute>
    /** `pub` */
    pub isPub: bool
    /** Its type. */
    pub ty: TypeExpr
    /** `= value`, if any. */
    pub defaultValue: Option<Expr>
    /** Where it is written. */
    pub span: Span
}

/**
 * A field of an enum variant.
 */
pub struct VariantField {
    /** Its name; `None` for an unnamed one. */
    pub name: Option<Symbol>
    /** Its type. */
    pub ty: TypeExpr
}

/**
 * A variant of an enum.
 */
pub struct Variant {
    /** Its name. */
    pub name: Symbol
    /** Its fields. */
    pub fields: List<VariantField>
    /** Whether it has a field list, even an empty one: `A()`. */
    pub hasFields: bool
    /** `= value`, if any. */
    pub discriminant: Option<Expr>
    /** Where it is written. */
    pub span: Span
}

/**
 * A top-level declaration.
 */
pub struct Item {
    /** What it is. */
    pub kind: ItemKind
    /** Where it is written. */
    pub span: Span
    /** Its name (the last segment for an import). */
    pub name: Symbol
    /** Its attributes. */
    pub attributes: List<Attribute>
    /** `pub` */
    pub isPub: bool
    /** The bounds of a struct's or enum's type parameters (`<T: Eq>`). */
    pub bounds: List<WherePred>
    /** The interfaces a struct or enum asserts it satisfies (`struct C: Shape`). */
    pub asserts: List<TypeExpr>
}

/**
 * The forms of a top-level declaration.
 */
pub enum ItemKind {
    /** `fn` */
    Fn(decl: Box<FnDecl>)
    /** `struct`, also a tuple struct: `struct Id(int)` */
    Struct(isCopy: bool, isRef: bool, isTuple: bool, typeParams: List<Symbol>,
           fields: List<FieldDecl>, methods: List<FnDecl>)
    /** `enum` */
    Enum(isCopy: bool, typeParams: List<Symbol>, variants: List<Variant>, methods: List<FnDecl>)
    /** `const NAME: T = value` */
    Const(ty: Option<TypeExpr>, value: Expr)
    /** A global `let`. */
    Global(ty: Option<TypeExpr>, value: Expr)
    /** `type Name<T> = T` */
    TypeAlias(typeParams: List<Symbol>, ty: TypeExpr)
    /** `import a.b [as c]` */
    Import(path: List<Symbol>, alias: Option<Symbol>)
    /** `extern "C" { fns }` */
    Extern(abi: str, fns: List<FnDecl>)
    /** `interface`: the interfaces it embeds and its methods, with or without bodies */
    Interface(typeParams: List<Symbol>, embeds: List<TypeExpr>, methods: List<FnDecl>)
}

/**
 * The AST of one file.
 */
pub struct Module {
    /** The file. */
    pub file: FileId
    /** The number of nodes: their ids are below it. */
    pub nodeCount: int
    /** The text of its module documentation comments (`@module`). */
    pub docs: List<str>
    /** Its declarations. */
    pub items: List<Item>
}
