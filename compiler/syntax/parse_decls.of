/**
 * @module
 * Functions, structs and enums (spec appendix A.2 and A.3; stage 0:
 * bootstrap/src/syntax/parse_decls.c).
 */

import base.intern.Symbol
import syntax.ast.Block
import syntax.ast.Expr
import syntax.ast.FieldDecl
import syntax.ast.FnDecl
import syntax.ast.ItemKind
import syntax.ast.Mode
import syntax.ast.Param
import syntax.ast.TypeExpr
import syntax.ast.Variant
import syntax.ast.WherePred
import syntax.ast.VariantField
import syntax.parse_control.parseBlock
import syntax.parse_exprs.parseExpr
import syntax.parse_items.ItemHeader
import syntax.parse_items.parseAttributes
import syntax.parse_items.parseItemHeader
import syntax.parse_types.canStartType
import syntax.parse_types.parseBounds
import syntax.parse_types.parseMode
import syntax.parse_types.parseType
import syntax.parse_types.parseTypeParams
import syntax.parser.Parser
import syntax.parser.symbolOf
import syntax.token.TokenKind

// ---------------------------------------------------------------------------
// Functions

fn param(p: mut Parser) Param {
    const start = p.here()
    const name = p.expectName("a parameter name") ?? Symbol(0)
    p.expect(TokenKind.Colon, "`:` and the parameter type")
    const mode = parseMode(p)
    const ty = parseType(p)
    let defaultValue: Option<Expr> = Option.None
    if p.accept(TokenKind.Eq) {
        defaultValue = Option.Some(parseExpr(p))
    }
    return Param{id: p.newId(), name, mode, ty, defaultValue, span: p.spanSince(start)}
}

// `[mut | move] self` as the first parameter of a method: its mode.
fn selfParam(p: mut Parser) Option<Mode> {
    const i = if p.at(TokenKind.Mut) || p.atWord(p.words.move) { 1 } else { 0 }
    if p.peekAt(i) != TokenKind.SelfValue {
        return Option.None
    }
    const mode = parseMode(p)
    p.advance()   // self
    return Option.Some(mode)
}

/**
 * A function after `fn`.
 *
 * @param p the parser
 * @param header its attributes and `pub`
 * @param withBody false in `extern` blocks
 * @returns the function
 */
pub fn parseFn(p: mut Parser, header: move ItemHeader, withBody: bool) FnDecl {
    const name = p.expectName("a function name") ?? Symbol(0)
    let bounds: List<WherePred> = []
    const typeParams = parseTypeParams(p, bounds)
    p.expect(TokenKind.LParen, "`(` and the parameters")
    let params: List<Param> = []
    const selfMode = selfParam(p)
    if selfMode.isNone() || p.accept(TokenKind.Comma) {
        for p.at(TokenKind.Ident) {
            params.push(param(p))
            if !p.accept(TokenKind.Comma) {
                break
            }
        }
    }
    p.expect(TokenKind.RParen, "`)` to close the parameters")
    let ret: Option<TypeExpr> = Option.None
    if !p.at(TokenKind.LBrace) && canStartType(p) && !atWhere(p, 0) {
        ret = Option.Some(parseType(p))
    }
    whereClause(p, bounds)
    let body: Option<Block> = Option.None
    if withBody {
        body = Option.Some(parseBlock(p))
    }
    return FnDecl{id: p.newId(), span: p.spanSince(header.span), name,
                  attributes: header.attributes, isPub: header.isPub, isUnsafe: false, abi: "",
                  typeParams, bounds, hasSelf: selfMode.isSome(),
                  selfMode: selfMode ?? Mode.Borrow, params, ret, body}
}

// Whether token `ahead` is the word `where`.
fn atWhere(p: Parser, ahead: int) bool {
    const t = p.token(ahead)
    const word = p.words.where
    return t.kind == TokenKind.Ident && word.isSome() && symbolOf(t).0 == word.unwrapOr(Symbol(0)).0
}

// `where T: Eq, U: Ord + Hash` after a signature, on its line or the next
// ones (spec 8.4).
fn whereClause(p: mut Parser, preds: mut List<WherePred>) {
    let ahead = 0
    for p.peekAt(ahead) == TokenKind.Newline {
        ahead += 1
    }
    if !atWhere(p, ahead) {
        return
    }
    p.skipNewlines()
    p.advance()   // where
    p.skipNewlines()
    for canStartType(p) {
        const start = p.here()
        const ty = parseType(p)
        p.expect(TokenKind.Colon, "`:` and the bounds")
        const bounds = parseBounds(p)
        preds.push(WherePred{ty, bounds, span: p.spanSince(start), isConst: false})
        if !p.accept(TokenKind.Comma) {
            break
        }
        p.skipNewlines()
    }
    p.skipNewlines()
}

// ---------------------------------------------------------------------------
// Struct and enum bodies

// After the attributes `@name(...)` that start at token `start`.
fn skipAttributes(p: Parser, start: int) int {
    let i = start
    for p.peekAt(i) == TokenKind.At {
        i += 2   // @name
        if p.peekAt(i) == TokenKind.LParen {
            let depth = 0
            for {
                const k = p.peekAt(i)
                i += 1
                if k == TokenKind.Eof {
                    return i - 1
                }
                if k == TokenKind.LParen {
                    depth += 1
                } else if k == TokenKind.RParen {
                    depth -= 1
                }
                if depth == 0 {
                    break
                }
            }
        }
        for p.peekAt(i) == TokenKind.Newline {
            i += 1
        }
    }
    return i
}

fn atMethod(p: Parser) bool {
    let i = skipAttributes(p, 0)
    for p.peekAt(i) == TokenKind.Pub || p.peekAt(i) == TokenKind.Unsafe {
        i += 1
    }
    return p.peekAt(i) == TokenKind.Fn
}

fn method(p: mut Parser) FnDecl {
    const header = parseItemHeader(p)
    const isUnsafe = p.accept(TokenKind.Unsafe)
    p.expect(TokenKind.Fn, "`fn`")
    let decl = parseFn(p, header, true)
    decl.isUnsafe = isUnsafe
    return decl
}

fn memberEnd(p: mut Parser) {
    const separated = p.acceptSeparator()
    p.skipNewlines()
    if !separated && !p.at(TokenKind.RBrace) {
        p.unexpected("a new line between members")
    }
    if p.recovering {
        p.synchronize()
    }
}

fn field(p: mut Parser) FieldDecl {
    const header = parseItemHeader(p)
    const name = p.expectName("a field name")
    p.expect(TokenKind.Colon, "`:` and the field type")
    const ty = parseType(p)
    let defaultValue: Option<Expr> = Option.None
    if p.accept(TokenKind.Eq) {
        defaultValue = Option.Some(parseExpr(p))
    }
    return FieldDecl{name: Option.Some(name ?? Symbol(0)), attributes: header.attributes,
                     isPub: header.isPub, ty, defaultValue, span: p.spanSince(header.span)}
}

/**
 * A struct after `struct` (and `copy` or `ref`).
 *
 * @param p the parser
 * @param isCopy `copy struct`
 * @param isRef `ref struct`
 * @returns its name and the item
 */
pub fn parseStruct(p: mut Parser, isCopy: bool, isRef: bool) (Symbol, ItemKind) {
    const name = p.expectName("a struct name") ?? Symbol(0)
    let bounds: List<WherePred> = []
    const typeParams = parseTypeParams(p, bounds)
    p.typeBounds = bounds
    let fields: List<FieldDecl> = []
    let methods: List<FnDecl> = []
    assertions(p)
    const tuple = p.at(TokenKind.LParen)
    if tuple {
        tupleStructBody(p, fields, methods)
    } else {
        p.expect(TokenKind.LBrace, "`\{` and the fields")
        p.skipNewlines()
        for !p.at(TokenKind.RBrace) && !p.at(TokenKind.Eof) {
            if atMethod(p) {
                methods.push(method(p))
            } else {
                fields.push(field(p))
            }
            memberEnd(p)
        }
        p.expect(TokenKind.RBrace, "`\}` to close the struct")
    }
    return (name, ItemKind.Struct(isCopy, isRef, tuple, typeParams, fields, methods))
}

// `(T, U)` and an optional `{ methods }` after a tuple struct name.
fn tupleStructBody(p: mut Parser, fields: mut List<FieldDecl>, methods: mut List<FnDecl>) {
    p.advance()   // (
    for !p.at(TokenKind.RParen) && !p.at(TokenKind.Eof) {
        const header = parseItemHeader(p)
        const ty = parseType(p)
        fields.push(FieldDecl{name: Option.None, attributes: header.attributes.clone(),
                              isPub: header.isPub, ty,
                              defaultValue: Option.None, span: header.span})
        if !p.accept(TokenKind.Comma) {
            break
        }
    }
    p.expect(TokenKind.RParen, "`)` to close the fields")
    if p.accept(TokenKind.LBrace) {
        p.skipNewlines()
        for !p.at(TokenKind.RBrace) && !p.at(TokenKind.Eof) {
            methods.push(method(p))
            memberEnd(p)
        }
        p.expect(TokenKind.RBrace, "`\}` to close the methods")
    }
}

fn variant(p: mut Parser) Variant {
    const attributes = parseAttributes(p)
    const start = p.here()
    const name = p.expectName("a variant name") ?? Symbol(0)
    let fields: List<VariantField> = []
    const hasFields = p.accept(TokenKind.LParen)
    if hasFields {
        for !p.at(TokenKind.RParen) && !p.at(TokenKind.Eof) {
            let fieldName: Option<Symbol> = Option.None
            if p.at(TokenKind.Ident) && p.peekAt(1) == TokenKind.Colon {
                fieldName = Option.Some(p.takeName())
                p.advance()
            }
            fields.push(VariantField{name: fieldName, ty: parseType(p)})
            if !p.accept(TokenKind.Comma) {
                break
            }
        }
        p.expect(TokenKind.RParen, "`)` to close the variant fields")
    }
    let discriminant: Option<Expr> = Option.None
    if p.accept(TokenKind.Eq) {
        discriminant = Option.Some(parseExpr(p))
    }
    return Variant{attributes, name, fields, hasFields, discriminant, span: p.spanSince(start)}
}

// `: Shape + Display` after a struct or enum name: the interfaces it asserts
// it satisfies (spec 9.2).
fn assertions(p: mut Parser) {
    if p.accept(TokenKind.Colon) {
        p.typeAsserts = parseBounds(p)
    }
}

/**
 * An interface after `interface` (spec 9.1, 9.4).
 *
 * @param p the parser
 * @returns its name and the item
 */
pub fn parseInterface(p: mut Parser) (Symbol, ItemKind) {
    const name = p.expectName("an interface name") ?? Symbol(0)
    let bounds: List<WherePred> = []
    const declared = parseTypeParams(p, bounds)
    p.typeBounds = bounds
    let typeParams = [p.names.intern("Self")]   // `Self` is the first parameter
    for i in 0..declared.len() {
        typeParams.push(declared[i])
    }
    let embeds: List<TypeExpr> = []
    let methods: List<FnDecl> = []
    p.expect(TokenKind.LBrace, "`\{` and the methods")
    p.skipNewlines()
    for !p.at(TokenKind.RBrace) && !p.at(TokenKind.Eof) {
        if atMethod(p) {
            methods.push(interfaceMethod(p))
        } else {
            embeds.push(parseType(p))
        }
        memberEnd(p)
    }
    p.expect(TokenKind.RBrace, "`\}` to close the interface")
    return (name, ItemKind.Interface(typeParams, embeds, methods))
}

// A method of an interface: with a body, it is a default method (spec 9.3).
fn interfaceMethod(p: mut Parser) FnDecl {
    const header = parseItemHeader(p)
    const start = header.span
    p.expect(TokenKind.Fn, "`fn`")
    let decl = parseFn(p, header, false)
    if p.at(TokenKind.LBrace) {
        decl.body = Option.Some(parseBlock(p))
        decl.span = p.spanSince(start)
    }
    return decl
}

/**
 * An enum after `enum` (and `copy`).
 *
 * @param p the parser
 * @param isCopy `copy enum`
 * @returns its name and the item
 */
pub fn parseEnum(p: mut Parser, isCopy: bool) (Symbol, ItemKind) {
    const name = p.expectName("an enum name") ?? Symbol(0)
    let bounds: List<WherePred> = []
    const typeParams = parseTypeParams(p, bounds)
    p.typeBounds = bounds
    assertions(p)
    let variants: List<Variant> = []
    let methods: List<FnDecl> = []
    p.expect(TokenKind.LBrace, "`\{` and the variants")
    p.skipNewlines()
    for !p.at(TokenKind.RBrace) && !p.at(TokenKind.Eof) {
        if atMethod(p) {
            methods.push(method(p))
        } else {
            variants.push(variant(p))
        }
        memberEnd(p)
    }
    p.expect(TokenKind.RBrace, "`\}` to close the enum")
    return (name, ItemKind.Enum(isCopy, typeParams, variants, methods))
}
