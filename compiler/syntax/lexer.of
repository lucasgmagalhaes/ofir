/**
 * @module
 * Lexer: turns source text into tokens (spec chapter 1).
 *
 * Written in the bootstrap subset (docs/bootstrap.md). It started as the
 * paper prototype of roadmap task 0.8 and is not compiled yet; findings are
 * recorded in docs/design/prototype-review.md. Literals are scanned in
 * `syntax.literals`, positions are tracked by `syntax.cursor`.
 */

import base.intern.Interner
import base.span.FileId
import diag.Diagnostics
import syntax.cursor.Cursor
import syntax.cursor.isDigit
import syntax.cursor.isLetter
import syntax.literals.scanByteLiteral
import syntax.literals.scanByteString
import syntax.literals.scanMultiline
import syntax.literals.scanNumber
import syntax.literals.scanRawString
import syntax.literals.scanStringPart
import syntax.token.Token
import syntax.token.TokenKind
import syntax.token.TokenValue

pub fn tokenize(src: str, file: FileId, names: mut Interner, diags: mut Diagnostics) List<Token> {
    let lx = Lexer.new(file)
    for !lx.cur.atEnd(src) {
        if !lx.skipTrivia(src, diags) {
            lx.tokenAt(src, names, diags)
        }
    }
    const end = lx.cur.token(TokenKind.Eof, lx.cur.pos)
    lx.out.push(end)
    return lx.out
}

struct Lexer {
    cur: Cursor
    out: List<Token> = []
    brackets: List<u8> = []          // open `(`, `[` and `{`, innermost last
    interpolations: List<int> = []   // `brackets.len()` when each interpolation opened
    keywords: Map<str, TokenKind>

    fn new(file: FileId) Lexer {
        return Lexer{cur: Cursor.new(file), keywords: keywordTable()}
    }

    // Newlines are tokens except directly inside `(...)` and `[...]` (spec 1.3).
    fn newlinesMatter(self) bool {
        return match self.brackets.last() {
            Option.Some(open) => *open == b'{'
            Option.None => true
        }
    }

    // Handles whitespace or a comment at the current position. Returns false
    // if the current byte starts a token.
    fn skipTrivia(mut self, src: str, diags: mut Diagnostics) bool {
        const start = self.cur.pos
        const c = self.cur.peek(src, 0)
        const next = self.cur.peek(src, 1)
        if c == b' ' || c == b'\t' || c == b'\r' {
            self.cur.pos += 1
        } else if c == b'\n' {
            self.cur.pos += 1
            if self.newlinesMatter() {
                self.out.push(self.cur.token(TokenKind.Newline, start))
            }
        } else if c == b'/' && next == b'/' {
            for !self.cur.atEnd(src) && src[self.cur.pos] != b'\n' {
                self.cur.pos += 1
            }
        } else if c == b'/' && next == b'*' {
            if self.blockComment(src, diags) && self.newlinesMatter() {
                self.out.push(self.cur.token(TokenKind.Newline, start))
            }
        } else {
            return false
        }
        return true
    }

    fn tokenAt(mut self, src: str, names: mut Interner, diags: mut Diagnostics) {
        const start = self.cur.pos
        const c = self.cur.peek(src, 0)
        const next = self.cur.peek(src, 1)
        if c == b'b' && next == b'\'' {
            self.out.push(scanByteLiteral(self.cur, src, diags))
        } else if c == b'b' && next == b'"' {
            self.out.push(scanByteString(self.cur, src, diags))
        } else if c == b'r' && next == b'"' {
            self.out.push(scanRawString(self.cur, src, diags))
        } else if c == b'"' && next == b'"' && self.cur.peek(src, 2) == b'"' {
            self.out.push(scanMultiline(self.cur, src, diags))
        } else if isLetter(c) {
            self.out.push(self.word(src, names))
        } else if isDigit(c) {
            self.out.push(scanNumber(self.cur, src, diags))
        } else if c == b'"' {
            self.cur.pos += 1
            self.stringPart(src, start, true, diags)
        } else {
            self.punct(src, diags)
        }
    }

    fn stringPart(mut self, src: str, start: int, opening: bool, diags: mut Diagnostics) {
        const token = scanStringPart(self.cur, src, start, opening, diags)
        if token.kind == TokenKind.StrStart || token.kind == TokenKind.StrMid {
            self.interpolations.push(self.brackets.len())
        }
        self.out.push(token)
    }

    // -----------------------------------------------------------------------
    // Comments

    // Skips `/* ... */`; `/** ... */` is a documentation comment. Returns
    // true if the comment contained a newline.
    fn blockComment(mut self, src: str, diags: mut Diagnostics) bool {
        const start = self.cur.pos
        const third = self.cur.peek(src, 3)
        const doc = self.cur.peek(src, 2) == b'*' && third != b'/' && third != b'*'
        self.cur.pos += 2
        let newline = false
        for {
            if self.cur.atEnd(src) {
                const message = "unterminated block comment".toOwned()
                diags.error("E0003", self.cur.spanFrom(start), message)
                return newline
            }
            if src[self.cur.pos] == b'*' && self.cur.peek(src, 1) == b'/' {
                self.cur.pos += 2
                if doc {
                    self.docComment(src, start)
                }
                return newline
            }
            if src[self.cur.pos] == b'\n' {
                newline = true
            }
            self.cur.pos += 1
        }
    }

    // `/** ... */` documents the next declaration, or the file when its text
    // starts with `@module` (spec 1.8); the tag is not part of the text.
    fn docComment(mut self, src: str, start: int) {
        const text = docText(src, start + 3, self.cur.pos - 2)
        const module = text.startsWith("@module")
        let from = 0
        if module {
            for from < text.len() && (text[from] == b'@' || text[from] > b' ') {
                from += 1
            }
            for from < text.len() && (text[from] == b'\n' || text[from] == b' ') {
                from += 1
            }
        }
        const kind: TokenKind = if module { TokenKind.ModuleDoc } else { TokenKind.DocComment }
        self.out.push(self.cur.tokenWith(kind, start,
                                         TokenValue.Str(text.sliceFrom(from).toOwned())))
    }

    // -----------------------------------------------------------------------
    // Words and punctuation

    fn word(mut self, src: str, names: mut Interner) Token {
        const start = self.cur.pos
        for !self.cur.atEnd(src) && (isLetter(src[self.cur.pos]) || isDigit(src[self.cur.pos])) {
            self.cur.pos += 1
        }
        const text = src[start..self.cur.pos]
        if const Option.Some(kind) = self.keywords.get(text) {
            return self.cur.token(*kind, start)
        }
        return self.cur.tokenWith(TokenKind.Ident, start, TokenValue.Name(names.intern(text)))
    }

    fn punct(mut self, src: str, diags: mut Diagnostics) {
        const start = self.cur.pos
        const c = src[start]
        self.cur.pos += 1
        if c == b'}' && self.closesInterpolation() {
            self.stringPart(src, start, false, diags)
            return
        }
        if c == b':' && self.atInterpolationDepth() && self.formatSpec(src, start) {
            return
        }
        const kind = self.punctKind(src, c, start, diags)
        self.out.push(self.cur.token(kind, start))
    }

    // `>` is always a single token: the parser joins adjacent ones (spec 1.6).
    fn punctKind(mut self, src: str, c: u8, start: int, diags: mut Diagnostics) TokenKind {
        return match c {
            b'(' => self.open(b'(', TokenKind.LParen)
            b'[' => self.open(b'[', TokenKind.LBracket)
            b'{' => self.open(b'{', TokenKind.LBrace)
            b')' => self.close(TokenKind.RParen)
            b']' => self.close(TokenKind.RBracket)
            b'}' => self.close(TokenKind.RBrace)
            b',' => TokenKind.Comma
            b':' => TokenKind.Colon
            b';' => TokenKind.Semicolon
            b'@' => TokenKind.At
            b'>' => TokenKind.Gt
            b'?' => self.cur.pick(src, b'?', TokenKind.QuestionQuestion, TokenKind.Question)
            b'.' => if self.cur.eat(src, b'.') {
                self.cur.pick(src, b'=', TokenKind.DotDotEq, TokenKind.DotDot)
            } else {
                TokenKind.Dot
            }
            b'=' => if self.cur.eat(src, b'>') {
                TokenKind.FatArrow
            } else {
                self.cur.pick(src, b'=', TokenKind.EqEq, TokenKind.Eq)
            }
            b'+' => self.cur.pick(src, b'=', TokenKind.PlusEq, TokenKind.Plus)
            b'-' => self.cur.pick(src, b'=', TokenKind.MinusEq, TokenKind.Minus)
            b'*' => self.cur.pick(src, b'=', TokenKind.StarEq, TokenKind.Star)
            b'/' => self.cur.pick(src, b'=', TokenKind.SlashEq, TokenKind.Slash)
            b'%' => self.cur.pick(src, b'=', TokenKind.PercentEq, TokenKind.Percent)
            b'^' => self.cur.pick(src, b'=', TokenKind.CaretEq, TokenKind.Caret)
            b'!' => self.cur.pick(src, b'=', TokenKind.Ne, TokenKind.Bang)
            b'&' => if self.cur.eat(src, b'&') {
                TokenKind.AndAnd
            } else {
                self.cur.pick(src, b'=', TokenKind.AmpEq, TokenKind.Amp)
            }
            b'|' => if self.cur.eat(src, b'|') {
                TokenKind.OrOr
            } else {
                self.cur.pick(src, b'=', TokenKind.PipeEq, TokenKind.Pipe)
            }
            b'<' => if self.cur.eat(src, b'<') {
                self.cur.pick(src, b'=', TokenKind.ShlEq, TokenKind.Shl)
            } else {
                self.cur.pick(src, b'=', TokenKind.Le, TokenKind.Lt)
            }
            _ => self.invalidCharacter(src, start, diags)
        }
    }

    // Skips the rest of a multi-byte UTF-8 character so it is reported once.
    fn invalidCharacter(mut self, src: str, start: int, diags: mut Diagnostics) TokenKind {
        for !self.cur.atEnd(src) && src[self.cur.pos] & 0xC0 == 0x80 {
            self.cur.pos += 1
        }
        diags.error("E0001", self.cur.spanFrom(start), "unexpected character".toOwned())
        return TokenKind.Invalid
    }

    fn open(mut self, bracket: u8, kind: TokenKind) TokenKind {
        self.brackets.push(bracket)
        return kind
    }

    // Mismatched brackets are reported by the parser; the lexer only keeps
    // its stack balanced.
    fn close(mut self, kind: TokenKind) TokenKind {
        const _ = self.brackets.pop()
        return kind
    }

    fn atInterpolationDepth(self) bool {
        const Option.Some(depth) = self.interpolations.last() else {
            return false
        }
        return *depth == self.brackets.len()
    }

    // `{x:spec}` (spec 1.7): the text after the `:` up to the `}`, which then
    // closes the interpolation as usual. Text with a blank or a quote before
    // the `}` is not a specifier: the `:` is then an ordinary token.
    fn formatSpec(mut self, src: str, start: int) bool {
        let end = self.cur.pos
        for end < src.len() && src[end] != b'}' && src[end] != b'"' && src[end] != b' ' &&
            src[end] != b'\t' && src[end] != b'\r' && src[end] != b'\n' {
            end += 1
        }
        if end >= src.len() || src[end] != b'}' {
            return false
        }
        const text = src.slice(self.cur.pos, end).toOwned()
        self.cur.pos = end
        self.out.push(self.cur.tokenWith(TokenKind.FormatSpec, start, TokenValue.Str(text)))
        return true
    }

    fn closesInterpolation(mut self) bool {
        const Option.Some(depth) = self.interpolations.last() else {
            return false
        }
        if *depth != self.brackets.len() {
            return false
        }
        self.interpolations.pop()
        return true
    }
}

// The text of a documentation comment (spec 1.8): each line without its
// indentation and leading `*`, blank lines at both ends removed.
fn docText(src: str, start: int, end: int) str {
    let text = ""
    let pos = start
    for pos < end {
        let lineEnd = pos
        for lineEnd < end && src[lineEnd] != b'\n' {
            lineEnd += 1
        }
        let from = pos
        for from < lineEnd && (src[from] == b' ' || src[from] == b'\t') {
            from += 1
        }
        if from < lineEnd && src[from] == b'*' {
            from += if from + 1 < lineEnd && src[from + 1] == b' ' { 2 } else { 1 }
        }
        const line = trimmed(src, from, lineEnd)
        if line.len() > 0 || text.len() > 0 {   // no blank lines at the start
            text.push(line)
            text.push("\n")
        }
        pos = lineEnd + 1
    }
    let keep = text.len()
    for keep > 0 && text[keep - 1] == b'\n' {   // nor at the end
        keep -= 1
    }
    return text.slice(0, keep).toOwned()
}

// `src[start..end]` without spaces and tabs before it, nor spaces and `\r` after.
fn trimmed(src: str, start: int, end: int) str {
    let lo = start
    for lo < end && (src[lo] == b' ' || src[lo] == b'\t') {
        lo += 1
    }
    let hi = end
    for hi > lo && (src[hi - 1] == b' ' || src[hi - 1] == b'\r') {
        hi -= 1
    }
    return src.slice(lo, hi)
}

fn keywordTable() Map<str, TokenKind> {
    let k = Map<str, TokenKind>.new()
    k.insert("as", TokenKind.As)
    k.insert("break", TokenKind.Break)
    k.insert("comptime", TokenKind.Comptime)
    k.insert("const", TokenKind.Const)
    k.insert("continue", TokenKind.Continue)
    k.insert("copy", TokenKind.Copy)
    k.insert("dyn", TokenKind.Dyn)
    k.insert("else", TokenKind.Else)
    k.insert("enum", TokenKind.Enum)
    k.insert("extern", TokenKind.Extern)
    k.insert("false", TokenKind.False)
    k.insert("fn", TokenKind.Fn)
    k.insert("for", TokenKind.For)
    k.insert("if", TokenKind.If)
    k.insert("import", TokenKind.Import)
    k.insert("in", TokenKind.In)
    k.insert("interface", TokenKind.Interface)
    k.insert("let", TokenKind.Let)
    k.insert("match", TokenKind.Match)
    k.insert("mut", TokenKind.Mut)
    k.insert("pub", TokenKind.Pub)
    k.insert("return", TokenKind.Return)
    k.insert("self", TokenKind.SelfValue)
    k.insert("Self", TokenKind.SelfType)
    k.insert("struct", TokenKind.Struct)
    k.insert("true", TokenKind.True)
    k.insert("unsafe", TokenKind.Unsafe)
    return k
}
