// The tests of `syntax.lexer` (spec 12.2).

import base.intern.Interner
import base.span.FileId
import diag.Diagnostics
import std.testing.assert
import syntax.token.TokenKind

fn expectKinds(src: str, expected: [TokenKind]) {
    let names = Interner.new()
    let diags = Diagnostics.new()
    const tokens = tokenize(src, FileId(0), names, diags)
    assert(!diags.hasErrors())
    assert(tokens.len() == expected.len())
    for i, token in tokens {
        assert(token.kind == expected[i])
    }
}

@test
fn genericsCloseWithSingleGtTokens() {
    expectKinds("let b: List<List<u8>>", [
        TokenKind.Let, TokenKind.Ident, TokenKind.Colon, TokenKind.Ident, TokenKind.Lt,
        TokenKind.Ident, TokenKind.Lt, TokenKind.Ident, TokenKind.Gt, TokenKind.Gt, TokenKind.Eof,
    ])
}

@test
fn newlinesAreTokensExceptInParentheses() {
    expectKinds("f(a,\nb)\nx", [
        TokenKind.Ident, TokenKind.LParen, TokenKind.Ident, TokenKind.Comma, TokenKind.Ident,
        TokenKind.RParen, TokenKind.Newline, TokenKind.Ident, TokenKind.Eof,
    ])
}

@test
fn newlinesCountInsideABlockNestedInParentheses() {
    expectKinds("f(fn() \{\na\n\})", [
        TokenKind.Ident, TokenKind.LParen, TokenKind.Fn, TokenKind.LParen, TokenKind.RParen,
        TokenKind.LBrace, TokenKind.Newline,
        TokenKind.Ident, TokenKind.Newline, TokenKind.RBrace, TokenKind.RParen, TokenKind.Eof,
    ])
}

@test
fn interpolationSplitsStrings() {
    expectKinds("\"a \{x\} b \{f(y)\} c\"", [
        TokenKind.StrStart, TokenKind.Ident, TokenKind.StrMid, TokenKind.Ident, TokenKind.LParen,
        TokenKind.Ident, TokenKind.RParen, TokenKind.StrEnd, TokenKind.Eof,
    ])
}

@test
fn rangesAreNotFloats() {
    expectKinds("0..10 1.5 x.0", [
        TokenKind.Int, TokenKind.DotDot, TokenKind.Int, TokenKind.Float, TokenKind.Ident,
        TokenKind.Dot, TokenKind.Int, TokenKind.Eof,
    ])
}

@test
fn contextualKeywordsAreIdentifiers() {
    expectKinds("type move ref where", [TokenKind.Ident, TokenKind.Ident, TokenKind.Ident,
                                        TokenKind.Ident, TokenKind.Eof])
}
