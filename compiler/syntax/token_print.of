/**
 * @module
 * The `--emit=tokens` format of stage 0 (bootstrap/src/syntax/token.c):
 * one token per line, `line:column kind value`.
 */

import base.intern.Interner
import base.span.SourceFile
import syntax.token.Token
import syntax.token.TokenKind
import syntax.token.TokenValue

/**
 * The tokens of a file, one per line, as stage 0's `--emit=tokens` prints
 * them.
 *
 * @param tokens the tokens of `file`
 * @param file the file they come from
 * @param names the interner of their names
 * @returns the text
 */
pub fn printTokens(tokens: List<Token>, file: SourceFile, names: Interner) str {
    let out = ""
    for i in 0..tokens.len() {
        const t = &tokens[i]
        const at = file.lineCol(t.span.start)
        out.push("{at.line}:{at.column} {kindText(t.kind)}")
        out.push(valueText(t, names))
        out.push("\n")
    }
    return out
}

fn valueText(t: &Token, names: Interner) str {
    return match t.value {
        TokenValue.Name(symbol) => " {names.name(symbol)}"
        TokenValue.Int(value) => " {value}"
        TokenValue.Float(value) => " {formatG(value)}"
        TokenValue.Byte(value) => " {value}"
        TokenValue.Str(text) => " {escaped(text)}"
        TokenValue.None => ""
    }
}

fn escaped(text: str) str {
    let out = "\""
    let run = 0   // the start of the ordinary bytes not copied yet
    for i in 0..text.len() {
        const escape = escapeOf(text[i])
        if escape.len() > 0 {
            out.push(text.slice(run, i))   // special bytes are ASCII: `i` is a boundary
            out.push(escape)
            run = i + 1
        }
    }
    out.push(text.sliceFrom(run))
    out.push("\"")
    return out
}

// The escape stage 0 prints for a byte, or "" for a byte printed as is.
fn escapeOf(c: u8) str {
    return match c {
        b'\n' => "\\n"
        b'\t' => "\\t"
        b'\r' => "\\r"
        b'\\' => "\\\\"
        b'"' => "\\\""
        b'{' => "\\\{"
        b'}' => "\\\}"
        _ => if c < 0x20 || c == 0x7F { "\\x{hexDigit(c >> 4)}{hexDigit(c & 0xF)}" } else { "" }
    }
}

fn hexDigit(d: u8) str {
    return "0123456789abcdef".slice(d as int, d as int + 1)
}

/**
 * A float as C's `%.Ng` writes it with the smallest `N` that reads back to
 * the same value, as stage 0 prints float tokens.
 *
 * @param value a finite value
 * @returns the text, such as `1.5`, `2e+10` or `1e-07`
 */
pub fn formatG(value: float) str {
    const shortest = "{value}"   // the shortest round-trip digits, in fixed or exponent form
    let sign = ""
    let text = shortest.sliceFrom(0)
    if text.startsWith("-") {
        sign = "-"
        text = text.sliceFrom(1)
    }
    let exponent = 0
    let mantissa = text.sliceFrom(0)
    if const Option.Some(e) = text.find("e") {
        exponent = int.parse(text.sliceFrom(e + 1)).unwrapOr(0)
        mantissa = text.slice(0, e)
    }
    const point = mantissa.find(".") ?? mantissa.len()
    let digits = ""
    for i in 0..mantissa.len() {
        if i != point {
            digits.pushChar(mantissa[i] as u32)
        }
    }
    let first = 0   // leading zeros are not significant
    for first < digits.len() - 1 && digits[first] == b'0' {
        first += 1
    }
    let last = digits.len()   // nor are trailing zeros
    for last > first + 1 && digits[last - 1] == b'0' {
        last -= 1
    }
    const significant = digits.slice(first, last)
    const power = if significant == "0" { 0 } else { exponent + point - 1 - first }
    return sign + gNotation(significant, power)
}

// `%.Ng` of the digits `d.ddd * 10^power`, where N is the number of digits.
fn gNotation(digits: str, power: int) str {
    const precision = digits.len()
    if power < -4 || power >= precision {
        let out = digits.slice(0, 1)
        if precision > 1 {
            out.push(".")
            out.push(digits.sliceFrom(1))
        }
        const magnitude = if power < 0 { -power } else { power }
        out.push(if power < 0 { "e-" } else { "e+" })
        out.push(if magnitude < 10 { "0{magnitude}" } else { "{magnitude}" })
        return out
    }
    if power < 0 {
        return "0." + "0".repeat(-power - 1) + digits
    }
    if power + 1 >= precision {
        return digits + "0".repeat(power + 1 - precision)
    }
    return digits.slice(0, power + 1) + "." + digits.sliceFrom(power + 1)
}

/**
 * The text of a token kind in `--emit=tokens` and in error messages.
 *
 * @param kind the kind
 * @returns its text, as `ident` or `(`
 */
pub fn kindText(kind: TokenKind) str {
    return match kind {
        TokenKind.Ident => "ident"
        TokenKind.Int => "int"
        TokenKind.Float => "float"
        TokenKind.Byte => "byte"
        TokenKind.Str => "str"
        TokenKind.ByteStr => "byte_str"
        TokenKind.FormatSpec => "format_spec"
        TokenKind.StrStart => "str_start"
        TokenKind.StrMid => "str_mid"
        TokenKind.StrEnd => "str_end"
        TokenKind.DocComment => "doc"
        TokenKind.ModuleDoc => "module_doc"
        TokenKind.Newline => "newline"
        TokenKind.Invalid => "invalid"
        TokenKind.Eof => "eof"
        TokenKind.As => "as"
        TokenKind.Break => "break"
        TokenKind.Comptime => "comptime"
        TokenKind.Const => "const"
        TokenKind.Continue => "continue"
        TokenKind.Copy => "copy"
        TokenKind.Dyn => "dyn"
        TokenKind.Else => "else"
        TokenKind.Enum => "enum"
        TokenKind.Extern => "extern"
        TokenKind.False => "false"
        TokenKind.Fn => "fn"
        TokenKind.For => "for"
        TokenKind.If => "if"
        TokenKind.Import => "import"
        TokenKind.In => "in"
        TokenKind.Interface => "interface"
        TokenKind.Let => "let"
        TokenKind.Match => "match"
        TokenKind.Mut => "mut"
        TokenKind.Pub => "pub"
        TokenKind.Return => "return"
        TokenKind.SelfValue => "self"
        TokenKind.SelfType => "Self"
        TokenKind.Struct => "struct"
        TokenKind.True => "true"
        TokenKind.Unsafe => "unsafe"
        TokenKind.LParen => "("
        TokenKind.RParen => ")"
        TokenKind.LBrace => "\{"
        TokenKind.RBrace => "\}"
        TokenKind.LBracket => "["
        TokenKind.RBracket => "]"
        TokenKind.Comma => ","
        TokenKind.Colon => ":"
        TokenKind.Semicolon => ";"
        TokenKind.Dot => "."
        TokenKind.DotDot => ".."
        TokenKind.DotDotEq => "..="
        TokenKind.FatArrow => "=>"
        TokenKind.Question => "?"
        TokenKind.QuestionQuestion => "??"
        TokenKind.At => "@"
        TokenKind.Plus => "+"
        TokenKind.Minus => "-"
        TokenKind.Star => "*"
        TokenKind.Slash => "/"
        TokenKind.Percent => "%"
        TokenKind.Amp => "&"
        TokenKind.Pipe => "|"
        TokenKind.Caret => "^"
        TokenKind.Shl => "<<"
        TokenKind.Bang => "!"
        TokenKind.Eq => "="
        TokenKind.EqEq => "=="
        TokenKind.Ne => "!="
        TokenKind.Lt => "<"
        TokenKind.Le => "<="
        TokenKind.Gt => ">"
        TokenKind.AndAnd => "&&"
        TokenKind.OrOr => "||"
        TokenKind.PlusEq => "+="
        TokenKind.MinusEq => "-="
        TokenKind.StarEq => "*="
        TokenKind.SlashEq => "/="
        TokenKind.PercentEq => "%="
        TokenKind.AmpEq => "&="
        TokenKind.PipeEq => "|="
        TokenKind.CaretEq => "^="
        TokenKind.ShlEq => "<<="
    }
}
