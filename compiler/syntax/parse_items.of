/**
 * @module
 * Items and modules (spec appendix A.1 and A.3; stage 0:
 * bootstrap/src/syntax/parse_items.c).
 */

import base.intern.Symbol
import base.span.Span
import syntax.ast.Attribute
import syntax.ast.Block
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.FnDecl
import syntax.ast.Item
import syntax.ast.ItemKind
import syntax.ast.Stmt
import syntax.ast.TypeExpr
import syntax.ast.TypeKind
import syntax.ast.WherePred
import syntax.parse_decls.parseEnum
import syntax.parse_decls.parseFn
import syntax.parse_decls.parseInterface
import syntax.parse_decls.parseStruct
import syntax.parse_exprs.parseExpr
import syntax.parse_stmts.parseStmt
import syntax.parse_types.parseType
import syntax.parse_types.parseTypeParams
import syntax.parser.Parser
import syntax.parser.textOf
import std.mem
import syntax.token.TokenKind

/**
 * The attributes and the `pub` before a declaration.
 */
pub struct ItemHeader {
    /** Where the declaration starts. */
    pub span: Span
    /** Its attributes. */
    pub attributes: List<Attribute>
    /** `pub` */
    pub isPub: bool
}

fn attribute(p: mut Parser) Attribute {
    const start = p.advance()   // @
    const name = p.expectName("an attribute name after `@`") ?? Symbol(0)
    let args: List<Expr> = []
    if p.accept(TokenKind.LParen) {
        for !p.at(TokenKind.RParen) && !p.at(TokenKind.Eof) {
            args.push(parseExpr(p))
            if !p.accept(TokenKind.Comma) {
                break
            }
        }
        p.expect(TokenKind.RParen, "`)` to close the attribute arguments")
    }
    const span = p.spanSince(start)
    p.skipNewlines()
    return Attribute{name, args, span}
}

/**
 * The attributes and `pub` of a declaration.
 *
 * @param p the parser
 * @returns them
 */
pub fn parseItemHeader(p: mut Parser) ItemHeader {
    const span = p.here()
    const attributes = parseAttributes(p)
    return ItemHeader{span, attributes, isPub: p.accept(TokenKind.Pub)}
}

/**
 * The attributes `@name(...)` before a declaration or a variant.
 *
 * @param p the parser
 * @returns them, in order
 */
pub fn parseAttributes(p: mut Parser) List<Attribute> {
    let attributes: List<Attribute> = []
    for p.at(TokenKind.At) {
        attributes.push(attribute(p))
    }
    return attributes
}

fn importItem(p: mut Parser) ItemKind {
    let path: List<Symbol> = []
    for {
        const Option.Some(name) = p.expectName("a module name") else {
            break
        }
        path.push(name)
        if !p.accept(TokenKind.Dot) {
            break
        }
    }
    let alias: Option<Symbol> = Option.None
    if p.accept(TokenKind.As) {
        alias = p.expectName("a name after `as`")
    }
    return ItemKind.Import(path, alias)
}

// `const NAME: T = value` and the global `let NAME: T = value`.
fn valueItem(p: mut Parser, isConst: bool) (Symbol, ItemKind) {
    const name = p.expectName("a name") ?? Symbol(0)
    let ty: Option<TypeExpr> = Option.None
    if p.accept(TokenKind.Colon) {
        ty = Option.Some(parseType(p))
    }
    let value = Expr{id: p.newId(), kind: ExprKind.Tuple([]), span: p.here()}
    if p.expect(TokenKind.Eq, "`=` and a value") {
        value = parseExpr(p)
    }
    const kind: ItemKind = if isConst {
        ItemKind.Const(ty, value)
    } else {
        ItemKind.Global(ty, value)
    }
    return (name, kind)
}

fn typeAlias(p: mut Parser) (Symbol, ItemKind) {
    const name = p.expectName("a type name") ?? Symbol(0)
    let bounds: List<WherePred> = []
    const params = parseTypeParams(p, bounds)
    for i in 0..bounds.len() {
        if !keyBounds(&bounds[i].bounds) {
            p.syntaxError(bounds[i].span, "a type alias cannot bound its type parameters".toOwned())
            break
        }
    }
    p.typeBounds = bounds   // key bounds, as `K: keyof T` (spec 16.4)
    p.expect(TokenKind.Eq, "`=` and a type")
    return (name, ItemKind.TypeAlias(params, parseType(p)))
}

// Whether each bound is a key type: `keyof T`, `.x` or `A | B`.
fn keyBounds(bounds: &List<TypeExpr>) bool {
    for i in 0..bounds.len() {
        const isKey = match bounds[i].kind {
            TypeKind.KeyOf(_) |
            TypeKind.Key(_) |
            TypeKind.KeyOp(_, _, _) => true
            _ => false
        }
        if !isKey {
            return false
        }
    }
    return true
}

// `extern "C" { fn ... }` or `extern "C" fn name(...) { body }`.
fn externItem(p: mut Parser, header: move ItemHeader) (Symbol, ItemKind) {
    let abi = "C".toOwned()
    if p.at(TokenKind.Str) {
        abi = textOf(p.token(0)).toOwned()
    }
    p.expect(TokenKind.Str, "the ABI string, as in `extern \"C\"`")
    if p.accept(TokenKind.Fn) {
        let decl = parseFn(p, header, true)
        decl.abi = abi
        return (decl.name, ItemKind.Fn(Box.new(decl)))
    }
    let fns: List<FnDecl> = []
    p.expect(TokenKind.LBrace, "`\{` and the declarations")
    p.skipNewlines()
    for !p.at(TokenKind.RBrace) && !p.at(TokenKind.Eof) && !p.recovering {
        const fnHeader = parseItemHeader(p)
        p.expect(TokenKind.Fn, "`fn`")
        fns.push(parseFn(p, fnHeader, false))
        p.expectTerminator()
    }
    p.expect(TokenKind.RBrace, "`\}` to close the extern block")
    return (Symbol(0), ItemKind.Extern(abi, fns))
}

// The declaration after its header: its name and what it is, or `None`
// after an error.
fn itemBody(p: mut Parser, header: move ItemHeader) Option<(Symbol, ItemKind)> {
    const isCopy = p.accept(TokenKind.Copy)
    const isRef = !isCopy && p.atWord(p.words.ref) && p.peekAt(1) == TokenKind.Struct
    if isRef {
        p.advance()
    }
    const isUnsafe = p.accept(TokenKind.Unsafe)
    const isComptime = p.at(TokenKind.Comptime) && p.peekAt(1) == TokenKind.Fn
    if isComptime {
        p.advance()
    }
    const kind = p.peek()
    if kind == TokenKind.Struct {
        p.advance()
        return Option.Some(parseStruct(p, isCopy, isRef))
    }
    if kind == TokenKind.Enum {
        p.advance()
        return Option.Some(parseEnum(p, isCopy))
    }
    if kind == TokenKind.Fn {
        p.advance()
        let decl = parseFn(p, header, true)
        decl.isUnsafe = isUnsafe
        decl.isComptime = isComptime
        return Option.Some((decl.name, ItemKind.Fn(Box.new(decl))))
    }
    if kind == TokenKind.Import {
        p.advance()
        const imported = importItem(p)
        return Option.Some((Symbol(0), imported))
    }
    if kind == TokenKind.Const || kind == TokenKind.Let {
        p.advance()
        return Option.Some(valueItem(p, kind == TokenKind.Const))
    }
    if kind == TokenKind.Extern {
        p.advance()
        return Option.Some(externItem(p, header))
    }
    if p.atWord(p.words.type) && p.peekAt(1) == TokenKind.Ident {
        p.advance()
        return Option.Some(typeAlias(p))
    }
    if kind == TokenKind.Interface {
        p.advance()
        return Option.Some(parseInterface(p))
    }
    p.unexpected("a declaration (`fn`, `struct`, `enum`, `const`, `import`, ...)")
    return Option.None
}

fn item(p: mut Parser) Option<Item> {
    const header = parseItemHeader(p)
    const start = header.span
    const isPub = header.isPub
    const attributes = header.attributes.clone()
    const found = itemBody(p, header)
    const bounds = mem.replace(p.typeBounds, [])
    const asserts = mem.replace(p.typeAsserts, [])
    const Option.Some(body) = found else {
        return Option.None
    }
    if p.recovering {
        return Option.None   // an incomplete item is left out of the tree
    }
    return Option.Some(Item{kind: body.1, span: p.spanSince(start), name: body.0, attributes, isPub,
                      bounds, asserts})
}

/**
 * The declarations of a file, up to the end.
 *
 * @param p the parser
 * @returns them, without the ones that had errors
 */
pub fn moduleItems(p: mut Parser) List<Item> {
    let items: List<Item> = []
    p.skipNewlines()
    for !p.at(TokenKind.Eof) {
        if const Option.Some(it) = item(p) {
            items.push(it)
            p.expectTerminator()
        }
        if p.recovering {
            p.synchronize()
            p.accept(TokenKind.RBrace)   // a stray `}` at the top level
            p.skipNewlines()
        }
    }
    return items
}

// Whether the next tokens start a declaration rather than a statement:
// `const` and `let` start statements in a doc test.
fn atItem(p: Parser) bool {
    const kind = p.peek()
    if kind == TokenKind.At || kind == TokenKind.Pub || kind == TokenKind.Fn ||
        kind == TokenKind.Struct || kind == TokenKind.Enum || kind == TokenKind.Import ||
        kind == TokenKind.Extern || kind == TokenKind.Interface || kind == TokenKind.Copy {
        return true
    }
    if kind == TokenKind.Unsafe || kind == TokenKind.Comptime {
        return p.peekAt(1) == TokenKind.Fn
    }
    if p.atWord(p.words.ref) {
        return p.peekAt(1) == TokenKind.Struct
    }
    return p.atWord(p.words.type) && p.peekAt(1) == TokenKind.Ident
}

/**
 * The declarations of a doc test (spec 12.5): first the function that
 * runs it, `@test fn name() {}`, then the example, whose declarations stay
 * at the top level and whose statements become that function's body.
 *
 * @param p the parser
 * @returns the declarations, the function first
 */
pub fn docTestItems(p: mut Parser) List<Item> {
    p.skipNewlines()
    const header = parseItemHeader(p)
    const start = header.span
    const attributes = header.attributes.clone()
    p.expect(TokenKind.Fn, "`fn`")
    let decl = parseFn(p, header, true)
    p.expectTerminator()
    let items: List<Item> = []
    let stmts: List<Stmt> = []
    const body = p.here()
    for !p.at(TokenKind.Eof) {
        if atItem(p) {
            if const Option.Some(it) = item(p) {
                items.push(it)
                p.expectTerminator()
            }
        } else {
            stmts.push(parseStmt(p))
            if !p.recovering {
                p.expectTerminator()
            }
        }
        if p.recovering {
            p.synchronize()
            p.accept(TokenKind.RBrace)
            p.skipNewlines()
        }
    }
    decl.body = Option.Some(Block{span: p.spanSince(body), stmts})
    const name = decl.name
    let all = [Item{kind: ItemKind.Fn(Box.new(decl)), span: p.spanSince(start), name, attributes,
                    isPub: false, bounds: [], asserts: []}]
    all.extend(items)
    return all
}
