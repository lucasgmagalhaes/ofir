/**
 * @module
 * Compact, source-like text for types, patterns and literals, used by the
 * AST printer (stage 0: bootstrap/src/syntax/ast_text.c).
 */

import base.intern.Interner
import base.intern.Symbol
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.FieldPattern
import syntax.ast.Mode
import syntax.ast.Op
import syntax.ast.Pattern
import syntax.ast.PatternKind
import syntax.ast.TypeExpr
import syntax.ast.TypeKind
import syntax.token_print.formatG

/**
 * A dotted path: `a.b.C`.
 *
 * @param path the names
 * @param names their interner
 * @returns the text
 */
pub fn symbolsText(path: List<Symbol>, names: Interner) str {
    let out = ""
    for i in 0..path.len() {
        if i > 0 {
            out.push(".")
        }
        out.push(names.name(path[i]))
    }
    return out
}

fn typeListText(types: List<TypeExpr>, names: Interner) str {
    let out = ""
    for i in 0..types.len() {
        if i > 0 {
            out.push(", ")
        }
        out.push(typeText(&types[i], names))
    }
    return out
}

/**
 * The text of a mode before a parameter: `mut `, `move ` or nothing.
 *
 * @param mode the mode
 * @returns the text
 */
pub fn modeText(mode: Mode) str {
    return match mode {
        Mode.Mut => "mut "
        Mode.Move => "move "
        Mode.Borrow => ""
    }
}

/**
 * A type, as written.
 *
 * @param t the type
 * @param names the interner
 * @returns the text
 */
pub fn typeText(t: &TypeExpr, names: Interner) str {
    return match t.kind {
        TypeKind.Path(segments, args) => if args.len() > 0 {
            "{symbolsText(segments, names)}<{typeListText(args, names)}>"
        } else {
            symbolsText(segments, names)
        }
        TypeKind.SelfType => "Self".toOwned()
        TypeKind.Ref(mutable,
                     inner) => "&{if mutable { "mut " } else { "" }}{typeText(&*inner, names)}"
        TypeKind.Ptr(mutable,
                     inner) => "*{if mutable { "mut " } else { "" }}{typeText(&*inner, names)}"
        TypeKind.Slice(elem) => "[{typeText(&*elem, names)}]"
        TypeKind.Array(elem, len) => "[{typeText(&*elem, names)}; {literalText(&*len, names)}]"
        TypeKind.Tuple(items) => {
            "({typeListText(items, names)}{if items.len() == 1 { ",)" } else { ")" }}"
        }
        TypeKind.Fn(params, modes, ret, owned, send) => {
            let out = fnTypeText(params, modes, ret, owned, names)
            if send {
                out.push(" + Send")
            }
            out
        }
        TypeKind.Dyn(inner) => "dyn {typeText(&*inner, names)}"
        TypeKind.Optional(inner) => "{typeText(&*inner, names)}?"
        TypeKind.Never => "!".toOwned()
        TypeKind.KeyOf(inner) => "keyof {typeText(&*inner, names)}"
        TypeKind.Key(name) => ".{names.name(name)}"
        TypeKind.KeyOp(op, left, right) => {
            const symbol = if op == Op.Or {
                "|"
            } else if op == Op.And {
                "&"
            } else {
                "-"
            }
            "({typeText(&*left, names)} {symbol} {typeText(&*right, names)})"
        }
        TypeKind.Index(base, key) => "{typeText(&*base, names)}[{typeText(&*key, names)}]"
        TypeKind.Mapped(param, keys, filter, optional, field) => {
            const cond = match filter {
                Option.Some(f) => " if {typeText(&*f, names)}"
                Option.None => "".toOwned()
            }
            const mark = if optional { "?" } else { "" }
            const head = "[{names.name(param)} in {typeText(&*keys, names)}{cond}]{mark}"
            "\{ {head}: {typeText(&*field, names)} \}"
        }
        TypeKind.Is(left, pattern) => "{typeText(&*left, names)} is {typeText(&*pattern, names)}"
        TypeKind.Cond(test, then, otherwise) => {
            const body = "\{ {typeText(&*then, names)} \}"
            "if {typeText(&*test, names)} {body} else \{ {typeText(&*otherwise, names)} \}"
        }
        TypeKind.Infer(name) => "infer {names.name(name)}"
        TypeKind.Bool(value) => if value { "true".toOwned() } else { "false".toOwned() }
        TypeKind.Const(value) => "{value}"
    }
}

fn fnTypeText(params: List<TypeExpr>, modes: List<Mode>, ret: Option<Box<TypeExpr>>,
              owned: bool, names: Interner) str {
    let out = if owned { "move fn(" } else { "fn(" }
    for i in 0..params.len() {
        if i > 0 {
            out.push(", ")
        }
        out.push(modeText(modes[i]))
        out.push(typeText(&params[i], names))
    }
    out.push(")")
    if const Option.Some(r) = ret {
        out.push(" ")
        out.push(typeText(&*r, names))
    }
    return out
}

/**
 * A string as stage 0 prints it in the AST: quoted, with `\n`, `\"`, `\\`,
 * `{`, `}` and `\xHH` escapes.
 *
 * @param s the string
 * @returns the text
 */
pub fn escapedText(s: str) str {
    let out = "\""
    let run = 0
    for i in 0..s.len() {
        const c = s[i]
        const escape = if c == b'\n' {
            "\\n".toOwned()
        } else if c == b'"' || c == b'\\' || c == b'{' || c == b'}' {
            "\\" + s.slice(i, i + 1)
        } else if c < 0x20 || c == 0x7F {
            "\\x{hex(c >> 4)}{hex(c & 0xF)}"
        } else {
            ""
        }
        if escape.len() > 0 {
            out.push(s.slice(run, i))   // escaped bytes are ASCII: `i` is a boundary
            out.push(escape)
            run = i + 1
        }
    }
    out.push(s.sliceFrom(run))
    out.push("\"")
    return out
}

fn hex(d: u8) str {
    return "0123456789abcdef".slice(d as int, d as int + 1)
}

// The shortest decimal form that reads back as the same value, with `.0`
// when it would look like an integer.
fn floatText(value: float) str {
    let text = formatG(value)
    let plain = true
    for i in 0..text.len() {
        const c = text[i]
        if c == b'.' || c == b'e' || c == b'E' || c == b'n' || c == b'i' {
            plain = false
        }
    }
    if plain {
        text.push(".0")
    }
    return text
}

/**
 * A literal (or a name, or a negated literal) in a pattern, a type or an
 * attribute.
 *
 * @param e the expression
 * @param names the interner
 * @returns the text; `<expr>` for other expressions
 */
pub fn literalText(e: &Expr, names: Interner) str {
    return match e.kind {
        ExprKind.Int(v) => "{v}"
        ExprKind.Float(v) => floatText(v)
        ExprKind.Byte(v) => "b{v}"
        ExprKind.Bool(v) => if v { "true".toOwned() } else { "false".toOwned() }
        ExprKind.Str(text) => escapedText(text)
        ExprKind.ByteStr(text) => "b{escapedText(text)}"
        ExprKind.Ident(name) => names.name(name).toOwned()
        ExprKind.Unary(op, operand) => if op == Op.Neg {
            "-" + literalText(&*operand, names)
        } else {
            "<expr>".toOwned()
        }
        _ => "<expr>".toOwned()
    }
}

fn patternListText(list: List<Pattern>, names: Interner) str {
    let out = ""
    for i in 0..list.len() {
        if i > 0 {
            out.push(", ")
        }
        out.push(patternText(&list[i], names))
    }
    return out
}

/**
 * A pattern, as written.
 *
 * @param p the pattern
 * @param names the interner
 * @returns the text
 */
pub fn patternText(p: &Pattern, names: Interner) str {
    return match p.kind {
        PatternKind.Wildcard => "_".toOwned()
        PatternKind.Binding(name,
                            mutable) => "{if mutable { "mut " } else { "" }}{names.name(name)}"
        PatternKind.Literal(value) => literalText(&*value, names)
        PatternKind.Range(lo, hi, inclusive) => {
            const dots = if inclusive { "..=" } else { ".." }
            literalText(&*lo, names) + dots + literalText(&*hi, names)
        }
        PatternKind.Variant(path, name, args,
                            hasArgs) => "{symbolsText(path, names)}.{names.name(name)}" +
            (if hasArgs { "({patternListText(args, names)})" } else { "".toOwned() })
        PatternKind.Tuple(items) => "({patternListText(items, names)})"
        PatternKind.Struct(path, fields, rest) => structPatternText(path, fields, rest, names)
        PatternKind.TupleStruct(path, args) => {
            "{symbolsText(path, names)}({patternListText(args, names)})"
        }
        PatternKind.Or(alternatives) => orText(alternatives, names)
        PatternKind.TypeTest(name, ty) => {
            const bound = match name {
                Option.Some(n) => names.name(n).toOwned()
                Option.None => "_".toOwned()
            }
            "{bound}: {typeText(&ty, names)}"
        }
        PatternKind.At(name, mutable, pattern) => {
            const prefix = if mutable { "mut " } else { "" }
            "{prefix}{names.name(name)} @ {patternText(&*pattern, names)}"
        }
    }
}

fn orText(alternatives: List<Pattern>, names: Interner) str {
    let out = ""
    for i in 0..alternatives.len() {
        if i > 0 {
            out.push(" | ")
        }
        out.push(patternText(&alternatives[i], names))
    }
    return out
}

fn structPatternText(path: List<Symbol>, fields: List<FieldPattern>, rest: bool,
                     names: Interner) str {
    let out = symbolsText(path, names)
    out.push("\{")
    for i in 0..fields.len() {
        if i > 0 {
            out.push(", ")
        }
        out.push(names.name(fields[i].name))
        if const Option.Some(pattern) = fields[i].pattern {
            out.push(": ")
            out.push(patternText(&pattern, names))
        }
    }
    out.push(if rest { if fields.len() > 0 { ", ..\}" } else { "..\}" } } else { "\}" })
    return out
}
