// The tests of `driver.semver`.

import std.testing.assert

fn v(text: str) Version {
    return parseVersion(text).expect("a version")
}

fn accepts(requirement: str, version: str) bool {
    return parseRequirement(requirement).expect("a requirement").matches(v(version))
}

@test
fn versionsParseAndOrder() {
    assert(v("1.2.3").compare(v("v1.2.3")) == 0)
    assert(v("1.10.0").compare(v("1.9.9")) > 0)
    assert(v("0.0.1").compare(v("0.1.0")) < 0)
    assert(v("2.0.10").text() == "2.0.10")
    assert(parseVersion("1.2").isNone())
    assert(parseVersion("1.2.3.4").isNone())
    assert(parseVersion("1.x.3").isNone())
    assert(parseVersion("").isNone())
}

@test
fn caretKeepsTheLeftmostNonZeroPart() {
    assert(accepts("^1.2", "1.9.0") && accepts("1.2.3", "1.2.4"))
    assert(!accepts("^1.2", "2.0.0") && !accepts("^1.2.3", "1.2.2"))
    assert(accepts("^0.3", "0.3.7") && !accepts("^0.3", "0.4.0"))
    assert(accepts("^0.0.3", "0.0.3") && !accepts("^0.0.3", "0.0.4"))
    assert(accepts("^0", "0.9.0") && accepts("^0.0", "0.0.9"))
}

@test
fn otherOperators() {
    assert(accepts("~1.2.3", "1.2.9") && !accepts("~1.2.3", "1.3.0"))
    assert(accepts("~1", "1.5.0") && !accepts("~1", "2.0.0"))
    assert(accepts("=1.0.0", "1.0.0") && !accepts("=1.0.0", "1.0.1"))
    assert(accepts(">=0.3", "5.0.0") && !accepts(">=0.3", "0.2.9"))
    assert(accepts("*", "0.0.1"))
    assert(parseRequirement("^").isNone() && parseRequirement("~a").isNone())
}

@test
fn requirementsPrintAsWritten() {
    const texts = ["^1.2", "~1.2.3", "=1.0.0", ">=0", "*"]
    for i in 0..texts.len() {
        assert(parseRequirement(texts[i]).expect("a requirement").text() == texts[i])
    }
    assert(parseRequirement("1.2").expect("a requirement").text() == "^1.2")
}
