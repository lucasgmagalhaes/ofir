/**
 * @module
 * The resolution of git and registry dependencies (ADR 0032): one version
 * of each repository, or registry package, for the whole program, the
 * highest that every requirement on it accepts, recomputed until the
 * requirements of the chosen versions agree. There is no backtracking. A
 * locked version is kept while it still fits, unless the package is being
 * updated.
 */

import base.json.JsonDoc
import base.json.JsonKind
import base.json.parseJsonc
import driver.git.checkout
import driver.git.commitOf
import driver.git.hasCommit
import driver.git.hashHex
import driver.git.isAncestor
import driver.git.isCached
import driver.git.repository
import driver.git.tags
import driver.lock.IndexPin
import driver.lock.Locked
import driver.lock.checksum
import driver.lock.readIndexes
import driver.lock.readLock
import driver.lock.sourceOf
import driver.registry.Release
import driver.registry.archive
import driver.registry.defaultIndex
import driver.registry.releasesAt
import driver.semver.Requirement
import driver.semver.Version
import driver.semver.parseRequirement
import driver.semver.parseVersion
import std.fs

/**
 * What a resolution may change.
 */
pub struct Mode {
    /** Whether the lock is resolved again (`ofir update`). */
    pub update: bool
    /** The only package updated, by name; empty for all of them. */
    pub only: str
    /** `--locked`: the lock must not change (E0913). */
    pub locked: bool
    /** `--offline`: only the cache is used. */
    pub offline: bool
    /** Whether the root's `devDependencies` are in the graph (`ofir test`). */
    pub dev: bool
    /** The OS the program is built for; empty for every OS (`ofir fetch`). */
    pub os: str
    /**
     * `ofir update --index-reset`: an index whose history was rewritten is
     * accepted (E0922, ADR 0081).
     */
    pub indexReset: bool
}

/**
 * The version chosen for a repository.
 */
pub struct Pin {
    /**
     * Its URL, or its canonical local path; `<index>#<name>` for a
     * registry package (`registrySource`).
     */
    pub url: str
    /** The index of the registry it comes from; empty for a git package. */
    pub registry: str
    /** The key it is reached by first. */
    pub name: str
    /** Its version; empty when it follows `rev`. */
    pub version: str
    /** The `rev` or `branch` it follows; empty when it has a version. */
    pub rev: str
    /** Its commit; empty for a registry package. */
    pub commit: str
    /** The checksum of its checkout. */
    pub checksum: str
    /** Its checkout. */
    pub dir: str
}

/**
 * A repository that could not be resolved.
 */
pub struct Failure {
    pub url: str
    /**
     * E0911 (it cannot be fetched), E0912 (no version fits), E0914 (its
     * checksum differs from the lock), E0921 (the root does not trust its
     * source) or E0922 (the history of its index was rewritten).
     */
    pub code: str
    pub message: str
    pub notes: List<str>
}

/**
 * The result of a resolution.
 */
pub struct Resolution {
    pub pins: List<Pin>
    pub failures: List<Failure>
    /** Whether the project had a lock. */
    pub hadLock: bool
    /** The root's `overrides` (ADR 0077). */
    pub overrides: List<Override>
    /**
     * Where `ofir.lock` is: the workspace root of the project, or the
     * project itself (ADR 0077).
     */
    pub lockDir: str
    /** The commit of each registry index the pins come from (ADR 0081). */
    pub indexes: List<IndexPin>
}

/**
 * A dependency replaced in the whole graph (ADR 0077).
 */
pub struct Override {
    /** The key it replaces, in every manifest. */
    pub key: str
    /** The directory it is replaced by, canonical when it exists. */
    pub dir: str
}

/**
 * The `overrides` of the root's manifest that have a `path`; the others
 * are left for `driver.packages` to report.
 *
 * @param rootDir the root project's directory
 * @returns the overrides, in the manifest's order
 */
pub fn readOverrides(rootDir: str) List<Override> {
    let out: List<Override> = []
    const Result.Ok(text) = fs.readToString("{rootDir}/ofir.json") else {
        return out
    }
    const Result.Ok(doc) = parseJsonc(text) else {
        return out
    }
    const table = doc.field(0, "overrides")
    if table < 0 || doc.nodes[table].kind != JsonKind.Object {
        return out
    }
    let member = doc.nodes[table].child
    for member >= 0 {
        const isObject = doc.nodes[member].kind == JsonKind.Object
        const pathNode = if isObject { doc.field(member, "path") } else { -1 }
        if pathNode >= 0 && doc.nodes[pathNode].kind == JsonKind.String {
            out.push(Override{key: doc.nodes[member].key.clone(),
                              dir: gitUrl(doc.nodes[pathNode].text, rootDir)})
        }
        member = doc.nodes[member].next
    }
    return out
}

/**
 * The override of a key.
 *
 * @param overrides the root's overrides
 * @param key a key of `dependencies`
 * @returns its index in `overrides`, or -1
 */
pub fn overrideOf(overrides: List<Override>, key: str) int {
    for i in 0..overrides.len() {
        if overrides[i].key == key {
            return i
        }
    }
    return -1
}

/**
 * The sources the root accepts: its `trust` (ADR 0081).
 */
pub struct Trust {
    /** Whether the root has `trust`; without it every source is accepted. */
    pub given: bool
    /** The registry indexes accepted, as `gitUrl` gives them. */
    pub registries: List<str>
    /** The prefixes of the git URLs accepted. */
    pub git: List<str>
}

/**
 * The `trust` of the root's manifest; invalid entries are left for
 * `driver.packages` to report.
 *
 * @param rootDir the root project's directory
 * @returns what it accepts
 */
pub fn readTrust(rootDir: str) Trust {
    let out = Trust{given: false, registries: [], git: []}
    const Result.Ok(text) = fs.readToString("{rootDir}/ofir.json") else {
        return out
    }
    const Result.Ok(doc) = parseJsonc(text) else {
        return out
    }
    const node = doc.field(0, "trust")
    if node < 0 || doc.nodes[node].kind != JsonKind.Object {
        return out
    }
    out.given = true
    for item in doc.elements(doc.field(node, "registries")) {
        out.registries.push(gitUrl(doc.text(item), rootDir))
    }
    for item in doc.elements(doc.field(node, "git")) {
        out.git.push(gitUrl(doc.text(item), rootDir))
    }
    return out
}

// Whether `trust` accepts the source of `need`.
fn trusts(trust: &Trust, need: &Need) bool {
    if !trust.given {
        return true
    }
    if need.registry.len() > 0 {
        return contains(trust.registries, need.registry)
    }
    for i in 0..trust.git.len() {
        if need.url.startsWith(trust.git[i]) {
            return true
        }
    }
    return false
}

// The failure for a source that `trust` does not accept (E0921).
fn untrusted(need: &Need) Failure {
    if need.registry.len() > 0 {
        let message = "`{need.key}` comes from the registry `{need.registry}`, "
        message.push("which `trust.registries` does not list")
        return Failure{url: need.url.clone(), code: "E0921", message,
                       notes: ["add the registry to `trust.registries` to accept it"]}
    }
    let message = "`{need.key}` comes from `{need.url}`, "
    message.push("which no entry of `trust.git` starts")
    return Failure{url: need.url.clone(), code: "E0921", message,
                   notes: ["add a prefix of the URL to `trust.git` to accept it"]}
}

/**
 * The repository a `git` entry names: a URL as it is, a local path made
 * canonical.
 *
 * @param given the entry
 * @param base the directory of the manifest it is in
 * @returns its URL, or path
 */
pub fn gitUrl(given: str, base: str) str {
    if given.contains("://") || given.startsWith("git@") {
        return given.toOwned()
    }
    const joined = if isAbsolutePath(given) { given.toOwned() } else { "{base}/{given}" }
    if const Result.Ok(dir) = fs.canonicalize(joined) {
        return dir
    }
    return joined
}

/**
 * Whether a path in a manifest is absolute: it starts with a separator,
 * or with a drive and a separator (`C:/`, `C:\`).
 *
 * @param given the path
 * @returns true if it does not depend on the manifest's directory
 */
pub fn isAbsolutePath(given: str) bool {
    if given.startsWith("/") || given.startsWith("\\") {
        return true
    }
    const b = given.asBytes()
    return b.len() >= 3 && b[1] == b':' && (b[2] == b'/' || b[2] == b'\\')
}

/**
 * The canonical directories of the members of the workspace whose root
 * is `dir` (ADR 0077); none when its manifest has no `workspace`.
 *
 * @param dir a project's directory
 * @returns the members, in the manifest's order
 */
pub fn workspaceMembers(dir: str) List<str> {
    let out: List<str> = []
    const Result.Ok(text) = fs.readToString("{dir}/ofir.json") else {
        return out
    }
    const Result.Ok(doc) = parseJsonc(text) else {
        return out
    }
    const workspace = doc.field(0, "workspace")
    if workspace < 0 || doc.nodes[workspace].kind != JsonKind.Object {
        return out
    }
    const list = doc.field(workspace, "members")
    if list < 0 || doc.nodes[list].kind != JsonKind.Array {
        return out
    }
    let item = doc.nodes[list].child
    for item >= 0 {
        if doc.nodes[item].kind == JsonKind.String {
            out.push(gitUrl(doc.nodes[item].text, dir))
        }
        item = doc.nodes[item].next
    }
    return out
}

/**
 * The workspace root of the project in `dir`: the nearest directory above
 * it whose manifest lists it as a member, or `dir` itself (ADR 0077).
 *
 * @param dir a project's canonical directory
 * @returns the directory whose lock and overrides the project uses
 */
pub fn workspaceRoot(dir: str) str {
    let at = dir.toOwned()
    for {
        const slash = at.rfind("/") ?? -1
        if slash <= 0 {
            return dir.toOwned()
        }
        at = at.slice(0, slash).toOwned()
        const members = workspaceMembers(at)
        if contains(members, dir) {
            return at
        }
    }
}

/**
 * How a registry package is named among the repositories.
 *
 * @param index the registry's index
 * @param name the package
 * @returns `<index>#<name>`
 */
pub fn registrySource(index: str, name: str) str {
    return "{index}#{name}"
}

/**
 * The pin of a repository.
 *
 * @param r a resolution
 * @param url the repository
 * @returns its index in `r.pins`, or -1
 */
pub fn pinOf(r: &Resolution, url: str) int {
    for i in 0..r.pins.len() {
        if r.pins[i].url == url {
            return i
        }
    }
    return -1
}

/**
 * The failure of a repository.
 *
 * @param r a resolution
 * @param url the repository
 * @returns its index in `r.failures`, or -1
 */
pub fn failureOf(r: &Resolution, url: str) int {
    for i in 0..r.failures.len() {
        if r.failures[i].url == url {
            return i
        }
    }
    return -1
}

/**
 * Resolves the git dependencies of the project in `rootDir`, fetching
 * what is missing.
 *
 * @param rootDir the root project's directory
 * @param mode what may change
 * @returns the pins and the failures
 */
pub fn resolve(project: str, mode: &Mode) Resolution {
    const rootDir = workspaceRoot(project)
    const lock = readLock(rootDir)
    const pinned = readIndexes(rootDir)
    const trust = readTrust(rootDir)
    const index = defaultIndex()
    let r = Resolution{pins: [], failures: [], hadLock: fs.exists("{rootDir}/ofir.lock"),
                       overrides: [], lockDir: rootDir.clone(), indexes: []}
    let repos: List<Repo> = []
    let round = 0
    for round < 16 {
        const needs = collect(rootDir, index, &r)
        let next = Resolution{pins: [], failures: [], hadLock: r.hadLock, overrides: [],
                              lockDir: rootDir.clone(), indexes: []}
        let urls: List<str> = []
        for i in 0..needs.len() {
            if !contains(urls, needs[i].url) {
                urls.push(needs[i].url.clone())
            }
        }
        for i in 0..urls.len() {
            const first = firstNeed(needs, urls[i])
            if !trusts(&trust, &needs[first]) {
                next.failures.push(untrusted(&needs[first]))
                continue
            }
            choose(urls[i], needs, lock, pinned, mode, repos, next)
        }
        const stable = samePins(&r, &next)
        r = next
        if stable {
            verify(r, lock)
            pinIndexes(r, lock, pinned, mode, repos)
            r.overrides = readOverrides(rootDir)
            return r
        }
        round += 1
    }
    r.overrides = readOverrides(rootDir)
    return r
}

// A bare clone of the cache, and whether it was fetched in this run.
struct Repo {
    url: str
    /** Empty when it could not be fetched. */
    dir: str
    fetched: bool
    /** Why it could not be fetched. */
    error: str
}

// A requirement on a repository, or a registry package: `version`, or
// `rev`, by a project.
struct Need {
    url: str
    /** The registry's index; empty for a git repository. */
    registry: str
    key: str
    version: str
    rev: str
    from: str
}

// The requirements of the projects reached from `rootDir` and its
// workspace members, through path dependencies, overrides and the
// checkouts of the pins of `r`, with the dev dependencies of the root and
// the members. Invalid entries are left for `driver.packages` to report.
fn collect(rootDir: str, index: str, r: &Resolution) List<Need> {
    const overrides = readOverrides(rootDir)
    let needs: List<Need> = []
    let dirs = [rootDir.toOwned()]
    const members = workspaceMembers(rootDir)
    for i in 0..members.len() {
        if !contains(dirs, members[i]) {
            dirs.push(members[i].clone())
        }
    }
    const seeds = dirs.len()
    let d = 0
    for d < dirs.len() {   // grows while it is walked
        const dir = dirs[d].clone()
        d += 1
        const Result.Ok(text) = fs.readToString("{dir}/ofir.json") else {
            continue
        }
        const Result.Ok(doc) = parseJsonc(text) else {
            continue
        }
        const from = projectName(&doc, dir)
        const list = doc.field(0, "dependencies")
        collectList(&doc, list, dir, from, index, r, overrides, dirs, needs)
        if d <= seeds {   // the root or a member, whose dev dependencies are locked too
            const dev = doc.field(0, "devDependencies")
            collectList(&doc, dev, dir, from, index, r, overrides, dirs, needs)
        }
    }
    return needs
}

// Adds the requirements of the dependencies `list` of the project in `dir`
// to `needs`, and the directories they reach to `dirs`.
fn collectList(doc: &JsonDoc, list: int, dir: str, from: str, index: str, r: &Resolution,
               overrides: List<Override>, dirs: mut List<str>, needs: mut List<Need>) {
    if list < 0 || doc.nodes[list].kind != JsonKind.Object {
        return
    }
    let member = doc.nodes[list].child
    for member >= 0 {
        const next = doc.nodes[member].next
        const key = doc.nodes[member].key.clone()
        const version = registryVersion(doc, member)
        const o = overrideOf(overrides, key)
        if o >= 0 {   // replaced by a directory (ADR 0077)
            if !contains(dirs, overrides[o].dir) {
                dirs.push(overrides[o].dir.clone())
            }
        } else if parseRequirement(version).isSome() {
            const url = registrySource(index, key)
            const p = pinOf(r, url)
            if p >= 0 && !contains(dirs, r.pins[p].dir) {
                dirs.push(r.pins[p].dir.clone())
            }
            needs.push(Need{url, registry: index.toOwned(), key, version, rev: "",
                            from: from.clone()})
        } else if doc.nodes[member].kind == JsonKind.Object {
            const gitNode = doc.field(member, "git")
            const pathNode = doc.field(member, "path")
            if gitNode >= 0 && doc.nodes[gitNode].kind == JsonKind.String {
                const url = gitUrl(doc.nodes[gitNode].text, dir)
                let rev = doc.text(doc.field(member, "rev"))
                if rev.len() == 0 {
                    rev = doc.text(doc.field(member, "branch"))
                }
                const p = pinOf(r, url)
                if p >= 0 && !contains(dirs, r.pins[p].dir) {
                    dirs.push(r.pins[p].dir.clone())
                }
                needs.push(Need{url, registry: "", key,
                                version: doc.text(doc.field(member, "version")), rev,
                                from: from.clone()})
            } else if pathNode >= 0 && doc.nodes[pathNode].kind == JsonKind.String {
                const path = gitUrl(doc.nodes[pathNode].text, dir)
                if !contains(dirs, path) {
                    dirs.push(path)
                }
            }
        }
        member = next
    }
}

/**
 * The requirement of a registry dependency: the dependency itself when it
 * is a string, or the `version` of an object with no `git` and no `path`.
 *
 * @param doc a manifest
 * @param member a member of its `dependencies`
 * @returns the requirement; empty when it is not a registry dependency
 */
pub fn registryVersion(doc: &JsonDoc, member: int) str {
    if doc.nodes[member].kind == JsonKind.String {
        return doc.nodes[member].text.clone()
    }
    if doc.nodes[member].kind != JsonKind.Object {
        return ""
    }
    if doc.field(member, "git") >= 0 || doc.field(member, "path") >= 0 {
        return ""
    }
    return doc.text(doc.field(member, "version"))
}

// The `name` of a manifest, or the last part of its directory.
fn projectName(doc: &JsonDoc, dir: str) str {
    const name = doc.text(doc.field(0, "name"))
    if name.len() > 0 {
        return name
    }
    let slash = -1
    let i = 0
    for b in dir.bytes() {
        if b == b'/' {
            slash = i
        }
        i += 1
    }
    return dir.sliceFrom(slash + 1).toOwned()
}

// Chooses the commit of `url` for its requirements, into `out`.
fn choose(url: str, needs: List<Need>, lock: List<Locked>, pinned: List<IndexPin>, mode: &Mode,
          repos: mut List<Repo>, out: mut Resolution) {
    let mine: List<int> = []
    for i in 0..needs.len() {
        if needs[i].url == url {
            mine.push(i)
        }
    }
    const first = &needs[mine[0]]
    const name = first.key.clone()
    const updating = mode.update && (mode.only.len() == 0 || mode.only == name)
    if first.registry.len() > 0 {
        const index = first.registry.clone()
        const at = if mode.locked { pinnedCommit(pinned, index) } else { "" }
        chooseRelease(url, index, name, needs, mine, lock, updating, mode.offline, at, repos, out)
        return
    }
    const r = fetched(url, updating, mode.offline, repos)
    if repos[r].dir.len() == 0 {
        const message = "cannot fetch the dependency `{name}`"
        out.failures.push(Failure{url: url.toOwned(), code: "E0911", message,
                                  notes: [repos[r].error.clone()]})
        return
    }
    let locked = -1
    for i in 0..lock.len() {
        if sourceOf(&lock[i]) == url && !updating && hasCommit(repos[r].dir, lock[i].commit) {
            locked = i
        }
    }
    let rev = ""
    let mixed = false
    for k in 0..mine.len() {
        const given = needs[mine[k]].rev.clone()
        if k == 0 {
            rev = given
        } else if given != rev {
            mixed = true
        }
    }
    if mixed {
        conflict(url, name, needs, mine, "the requirements on it differ", out)
        return
    }
    if rev.len() > 0 {
        let commit = ""
        if locked >= 0 && lock[locked].rev == rev {
            commit = lock[locked].commit.clone()
        } else if const Option.Some(c) = commitOf(repos[r].dir, rev) {
            commit = c
        } else {
            conflict(url, name, needs, mine, "it has no revision `{rev}`", out)
            return
        }
        pin(url, name, "", rev, commit, &repos[r], out)
        return
    }
    let reqs: List<Requirement> = []
    for k in 0..mine.len() {
        if const Option.Some(q) = parseRequirement(needs[mine[k]].version) {
            reqs.push(q)
        }
    }
    if locked >= 0 && lock[locked].rev.len() == 0 {
        if const Option.Some(v) = parseVersion(lock[locked].version) {
            if acceptsAll(reqs, v) {
                const version = v.text()
                const commit = lock[locked].commit.clone()
                pin(url, name, version, "", commit, &repos[r], out)
                return
            }
        }
    }
    let best = highest(repos[r].dir, reqs)
    if best < 0 && !repos[r].fetched && !mode.offline {
        if refetch(repos[r]) {
            best = highest(repos[r].dir, reqs)
        }
    }
    if best < 0 {
        conflict(url, name, needs, mine, versionsNote(repos[r].dir), out)
        return
    }
    const found = tags(repos[r].dir)
    const version = found[best].version.text()
    const commit = found[best].commit.clone()
    pin(url, name, version, "", commit, &repos[r], out)
}

// Chooses the version of the registry package `name` for its requirements,
// into `out`: the locked one while it fits, else the highest that is not
// yanked. Its files must have the index's checksum (E0914). The index is
// read at the commit `at` when it is given (`--locked`), else at its head.
fn chooseRelease(url: str, index: str, name: str, needs: List<Need>, mine: List<int>,
                 lock: List<Locked>, updating: bool, offline: bool, at: str,
                 repos: mut List<Repo>, out: mut Resolution) {
    const r = fetched(index, updating, offline, repos)
    if repos[r].dir.len() == 0 {
        out.failures.push(Failure{url: url.toOwned(), code: "E0911",
                                  message: "cannot fetch the dependency `{name}`",
                                  notes: ["cannot fetch the registry `{index}`",
                                          repos[r].error.clone()]})
        return
    }
    if at.len() > 0 && !hasCommit(repos[r].dir, at) && !repos[r].fetched && !offline {
        refetch(repos[r])
    }
    const rev = if at.len() > 0 && hasCommit(repos[r].dir, at) { at.toOwned() } else { "HEAD" }
    let found = releasesAt(repos[r].dir, rev, name)
    if found.isNone() && !repos[r].fetched && !offline && refetch(repos[r]) {
        found = releasesAt(repos[r].dir, rev, name)
    }
    const Option.Some(listed) = found else {
        out.failures.push(Failure{url: url.toOwned(), code: "E0911",
                                  message: "cannot fetch the dependency `{name}`",
                                  notes: ["the registry `{index}` has no package `{name}`"]})
        return
    }
    let reqs: List<Requirement> = []
    for k in 0..mine.len() {
        if const Option.Some(q) = parseRequirement(needs[mine[k]].version) {
            reqs.push(q)
        }
    }
    let locked = ""
    for i in 0..lock.len() {
        if !updating && sourceOf(&lock[i]) == url {
            locked = lock[i].version.clone()
        }
    }
    let known = listed
    let best = latestRelease(known, reqs, locked.clone())
    if best < 0 && !repos[r].fetched && !offline && refetch(repos[r]) {
        known = releasesAt(repos[r].dir, rev, name) ?? []
        best = latestRelease(known, reqs, locked)
    }
    if best < 0 {
        conflict(url, name, needs, mine, releasesNote(known), out)
        return
    }
    const version = known[best].version.text()
    match archive(repos[r].dir, index, name, version, offline) {
        Result.Ok(dir) => {
            const real = fs.canonicalize(dir.clone()).ok() ?? dir
            const sum = checksum(real)
            const expected = known[best].checksum.clone()
            if expected != sum {
                const notes = ["the registry has `{expected}`",
                               "its files at `{real}` have `{sum}`"]
                const message = "the checksum of `{name}` differs from the registry"
                out.failures.push(Failure{url: url.toOwned(), code: "E0914", message, notes})
                return
            }
            out.pins.push(Pin{url: url.toOwned(), registry: index.toOwned(), name: name.toOwned(),
                              version, rev: "", commit: "", checksum: sum, dir: real})
        }
        Result.Err(error) => {
            out.failures.push(Failure{url: url.toOwned(), code: "E0911",
                                      message: "cannot fetch the dependency `{name}`",
                                      notes: [error]})
        }
    }
}

// The index of the release to use: `locked` while every requirement
// accepts it, else the highest accepted that is not yanked; -1 if none.
fn latestRelease(list: List<Release>, reqs: List<Requirement>, locked: str) int {
    let best = -1
    for i in 0..list.len() {
        const v = list[i].version
        if !acceptsAll(reqs, v) {
            continue
        }
        if v.text() == locked {
            return i
        }
        if !list[i].yanked && (best < 0 || v.compare(list[best].version) > 0) {
            best = i
        }
    }
    return best
}

// The note listing the versions of a registry package that are not yanked.
fn releasesNote(list: List<Release>) str {
    let order: List<Version> = []
    for i in 0..list.len() {
        if list[i].yanked {
            continue
        }
        const v = list[i].version
        let at = order.len()
        for at > 0 && v.compare(order[at - 1]) < 0 {
            at -= 1
        }
        order.insert(at, v)
    }
    if order.len() == 0 {
        return "it has no versions that are not yanked"
    }
    let text = "its versions are "
    for i in 0..order.len() {
        if i > 0 {
            text.push(", ")
        }
        text.push(order[i].text())
    }
    return text
}

// The index in the tags of `dir` of the highest version every requirement
// accepts, or -1.
fn highest(dir: str, reqs: List<Requirement>) int {
    const found = tags(dir)
    let best = -1
    for i in 0..found.len() {
        const v = found[i].version
        if acceptsAll(reqs, v) && (best < 0 || v.compare(found[best].version) > 0) {
            best = i
        }
    }
    return best
}

fn acceptsAll(reqs: List<Requirement>, v: Version) bool {
    for i in 0..reqs.len() {
        if !reqs[i].matches(v) {
            return false
        }
    }
    return true
}

// The note listing the versions of a repository.
fn versionsNote(dir: str) str {
    const found = tags(dir)
    if found.len() == 0 {
        return "it has no tags `vX.Y.Z`"
    }
    let order: List<Version> = []
    for i in 0..found.len() {
        const v = found[i].version
        let at = order.len()
        for at > 0 && v.compare(order[at - 1]) < 0 {
            at -= 1
        }
        order.insert(at, v)
    }
    let text = "its versions are "
    for i in 0..order.len() {
        if i > 0 {
            text.push(", ")
        }
        text.push(order[i].text())
    }
    return text
}

// Records that no version of `url` fits (E0912).
fn conflict(url: str, name: str, needs: List<Need>, mine: List<int>, why: str,
            out: mut Resolution) {
    let notes: List<str> = []
    for k in 0..mine.len() {
        const n = &needs[mine[k]]
        const what = if n.rev.len() > 0 { n.rev.clone() } else { n.version.clone() }
        notes.push("`{what}` (from `{n.from}`)")
    }
    notes.push(why.toOwned())
    const message = "no version of `{name}` satisfies every requirement on it"
    out.failures.push(Failure{url: url.toOwned(), code: "E0912", message, notes})
}

// Checks out `commit` and records it.
fn pin(url: str, name: str, version: str, rev: str, commit: str, repo: &Repo,
       out: mut Resolution) {
    const tag = if version.len() > 0 { version.toOwned() } else { commit.slice(0, 12).toOwned() }
    const label = "{name}-{tag}-{hashHex(url).slice(0, 8)}"
    match checkout(repo.dir, commit, label) {
        Result.Ok(dir) => {
            const real = fs.canonicalize(dir.clone()).ok() ?? dir
            out.pins.push(Pin{url: url.toOwned(), registry: "", name: name.toOwned(),
                              version: version.toOwned(),
                              rev: rev.toOwned(), commit: commit.toOwned(), checksum: "",
                              dir: real})
        }
        Result.Err(error) => {
            out.failures.push(Failure{url: url.toOwned(), code: "E0911",
                                      message: "cannot fetch the dependency `{name}`",
                                      notes: [error]})
        }
    }
}

// Computes the checksum of each pin; a pin whose commit is locked with
// another checksum becomes a failure (E0914).
fn verify(r: mut Resolution, lock: List<Locked>) {
    let i = 0
    for i < r.pins.len() {
        const pin = &r.pins[i]
        const sum = if pin.checksum.len() > 0 { pin.checksum.clone() } else { checksum(pin.dir) }
        let expected = ""
        for k in 0..lock.len() {
            const same = lock[k].commit == pin.commit && lock[k].version == pin.version
            if sourceOf(&lock[k]) == pin.url && same {
                expected = lock[k].checksum.clone()
            }
        }
        if expected.len() > 0 && expected != sum {
            const p = r.pins.remove(i)
            const notes = ["`ofir.lock` has `{expected}`", "its files at `{p.dir}` have `{sum}`"]
            r.failures.push(Failure{url: p.url.clone(), code: "E0914",
                                    message: "the checksum of `{p.name}` differs from `ofir.lock`",
                                    notes})
        } else {
            r.pins[i].checksum = sum
            i += 1
        }
    }
}

// Records in `r.indexes` the commit of each index its pins come from: the
// locked one while the index's pins keep their locked versions, else the
// index's head. A head that neither descends from the locked commit nor
// precedes it means the history was rewritten: the index's pins become
// failures (E0922), unless `--index-reset` was given. With `--locked`, an
// index the lock has no commit for is not recorded.
fn pinIndexes(r: mut Resolution, lock: List<Locked>, pinned: List<IndexPin>, mode: &Mode,
              repos: mut List<Repo>) {
    let urls: List<str> = []
    for i in 0..r.pins.len() {
        if r.pins[i].registry.len() > 0 && !contains(urls, r.pins[i].registry) {
            urls.push(r.pins[i].registry.clone())
        }
    }
    for u in 0..urls.len() {
        const index = urls[u].clone()
        const k = fetched(index, false, mode.offline, repos)
        const dir = repos[k].dir.clone()
        const head = commitOf(dir, "HEAD") ?? ""
        const old = pinnedCommit(pinned, index)
        if dir.len() == 0 || head.len() == 0 || (old.len() == 0 && mode.locked) {
            continue
        }
        if old.len() > 0 && !hasCommit(dir, old) && !repos[k].fetched && !mode.offline {
            refetch(repos[k])
        }
        const known = old.len() > 0 && hasCommit(dir, old)
        const kept = old == head || isAncestor(dir, old, head) || isAncestor(dir, head, old)
        const lost = old.len() > 0 && !known && !mode.offline
        if !mode.indexReset && (lost || (known && !kept)) {
            rewritten(r, index, old, head)
            continue
        }
        let keep = old.len() > 0 && !mode.indexReset && !mode.update
        for i in 0..r.pins.len() {
            if r.pins[i].registry == index && !lockedVersion(lock, &r.pins[i]) {
                keep = false
            }
        }
        const commit = if keep { old } else { head }
        r.indexes.push(IndexPin{url: index, commit})
    }
}

// Turns the pins of `index` into failures: its history was rewritten
// (E0922).
fn rewritten(r: mut Resolution, index: str, old: str, head: str) {
    let i = 0
    for i < r.pins.len() {
        if r.pins[i].registry != index {
            i += 1
            continue
        }
        const p = r.pins.remove(i)
        const notes = ["`ofir.lock` has the commit `{old}` of the registry",
                       "its head `{head}` does not descend from it",
                       "`ofir update --index-reset` accepts the new history"]
        r.failures.push(Failure{url: p.url.clone(), code: "E0922",
                                message: "the history of the registry `{index}` was rewritten",
                                notes})
    }
}

// Whether the lock has `pin` at its version.
fn lockedVersion(lock: List<Locked>, pin: &Pin) bool {
    for i in 0..lock.len() {
        if sourceOf(&lock[i]) == pin.url && lock[i].version == pin.version {
            return true
        }
    }
    return false
}

// The commit of `index` in the lock; empty if it has none.
fn pinnedCommit(pinned: List<IndexPin>, index: str) str {
    for i in 0..pinned.len() {
        if pinned[i].url == index {
            return pinned[i].commit.clone()
        }
    }
    return ""
}

// The bare clone of `url`, fetched again if `refresh` (never `offline`):
// its index in `repos`, whose `dir` is empty if it cannot be fetched.
fn fetched(url: str, refresh: bool, offline: bool, repos: mut List<Repo>) int {
    for i in 0..repos.len() {
        if repos[i].url == url {
            if refresh && !offline && !repos[i].fetched && repos[i].dir.len() > 0 {
                refetch(repos[i])
            }
            return i
        }
    }
    if offline && !isCached(url) {
        repos.push(Repo{url: url.toOwned(), dir: "", fetched: true,
                        error: "it is not in the cache, and `--offline` was given"})
        return repos.len() - 1
    }
    match repository(url, refresh && !offline) {
        Result.Ok(dir) => {
            repos.push(Repo{url: url.toOwned(), dir, fetched: refresh, error: ""})
        }
        Result.Err(error) => {
            repos.push(Repo{url: url.toOwned(), dir: "", fetched: true, error})
        }
    }
    return repos.len() - 1
}

// Fetches a clone again; whether it worked.
fn refetch(repo: mut Repo) bool {
    repo.fetched = true
    return repository(repo.url, true).isOk()
}

// The first requirement on `url`.
fn firstNeed(needs: List<Need>, url: str) int {
    for i in 0..needs.len() {
        if needs[i].url == url {
            return i
        }
    }
    return 0
}

fn contains(list: List<str>, text: str) bool {
    for i in 0..list.len() {
        if list[i] == text {
            return true
        }
    }
    return false
}

// Whether two resolutions chose the same commits.
fn samePins(a: &Resolution, b: &Resolution) bool {
    if a.pins.len() != b.pins.len() || a.failures.len() != b.failures.len() {
        return false
    }
    for i in 0..b.pins.len() {
        const p = pinOf(a, b.pins[i].url)
        if p < 0 || a.pins[p].commit != b.pins[i].commit {
            return false
        }
        if a.pins[p].version != b.pins[i].version {
            return false
        }
    }
    return true
}
