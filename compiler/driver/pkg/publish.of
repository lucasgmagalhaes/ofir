/**
 * @module
 * `ofir package`, `ofir publish` and `ofir yank` (ADR 0079): write the
 * archive of the project's package, add its version to a clone of a
 * registry's index, and mark a published version yanked. The index is a
 * git repository: each change is a commit, which the user pushes.
 */

import base.json.jsonString
import base.json.parseJson
import base.json.parseJsonc
import driver.pkg.lock.checksum
import driver.pkg.metadata.metadataError
import driver.pkg.metadata.metadataJson
import driver.pkg.registry.indexPath
import driver.pkg.resolve.registryVersion
import driver.pkg.semver.parseVersion
import driver.pkg.spdx.checkLicense
import std.fs
import std.os

// The package of the project, packaged.
struct Packaged {
    name: str
    version: str
    // The `.tar.gz` of its files.
    archive: str
    // The checksum of its files (`driver.pkg.lock.checksum`).
    sum: str
    // Its registry dependencies, as a JSON object.
    deps: str
    // Its SPDX license expression (ADR 0081).
    license: str
    // Its description, keywords, repository and toolchain, as members of
    // the index line (ADR 0097).
    metadata: str
}

/**
 * Runs `ofir package`.
 *
 * @param args the arguments after the command
 * @returns the exit code
 */
pub fn packageCommand(args: List<str>) int {
    if args.len() > 0 {
        eprintln("error: unexpected argument `{args[0]}` for `package`")
        return 2
    }
    const p = match makePackage() {
        Result.Ok(p) => p,
        Result.Err(message) => {
            eprintln(message)
            return 1
        }
    }
    println("packaged {p.name} {p.version} into {p.archive}")
    println("checksum {p.sum}")
    return 0
}

/**
 * Runs `ofir publish`.
 *
 * @param args the arguments after the command
 * @returns the exit code
 */
pub fn publishCommand(args: List<str>) int {
    let index = ""
    let dryRun = false
    let i = 0
    for i < args.len() {
        if args[i] == "--dry-run" {
            dryRun = true
        } else if args[i] == "--index" && i + 1 < args.len() {
            index = args[i + 1].clone()
            i += 1
        } else if args[i].startsWith("--index=") {
            index = args[i].sliceFrom(8).toOwned()
        } else {
            eprintln("error: unexpected argument `{args[i]}` for `publish`")
            return 2
        }
        i += 1
    }
    const p = match makePackage() {
        Result.Ok(p) => p,
        Result.Err(message) => {
            eprintln(message)
            return 1
        }
    }
    if dryRun {
        println("would publish {p.name} {p.version} (checksum {p.sum})")
        return 0
    }
    const dir = match indexDir(index) {
        Result.Ok(dir) => dir,
        Result.Err(message) => {
            eprintln(message)
            return 2
        }
    }
    const rel = indexPath(p.name)
    const file = "{dir}/{rel}"
    const existing = fs.readToString(file).ok() ?? ""
    for line in existing.lines() {
        const Option.Some(doc) = parseJson(line.trim()) else {
            continue
        }
        if doc.text(doc.field(0, "version")) == p.version {
            eprintln(refusal("`{p.name}` {p.version} is already published, "
                             + "and a version cannot change: publish a new version"))
            return 1
        }
    }
    const download = downloadPath(dir, &p)
    if download.len() > 0 {
        const copied = (fs.createDirAll(parent(download)).isOk()
            && fs.copyFile(p.archive, download).isOk())
        if !copied {
            eprintln("error: cannot copy the archive to `{download}`")
            return 1
        }
    }
    let text = existing.clone()
    if text.len() > 0 && !text.endsWith("\n") {
        text.push("\n")
    }
    text.push("\{\"version\": {jsonString(p.version)}, \"dependencies\": {p.deps}, ")
    text.push("\"checksum\": {jsonString(p.sum)}, \"license\": {jsonString(p.license)}, ")
    text.push(p.metadata)
    text.push("\"yanked\": false\}\n")
    if fs.createDirAll(parent(file)).isErr() || fs.writeString(file, text).isErr() {
        eprintln("error: cannot write `{file}`")
        return 1
    }
    if !commit(dir, rel, "Publish {p.name} {p.version}") {
        return 1
    }
    println("published {p.name} {p.version}; push `{dir}` to make it public")
    if download.len() == 0 {
        println("upload {p.archive} to the registry's download URL")
    }
    return 0
}

/**
 * Runs `ofir yank`.
 *
 * @param args the arguments after the command
 * @returns the exit code
 */
pub fn yankCommand(args: List<str>) int {
    let index = ""
    let version = ""
    let undo = false
    let i = 0
    for i < args.len() {
        if args[i] == "--undo" {
            undo = true
        } else if args[i] == "--index" && i + 1 < args.len() {
            index = args[i + 1].clone()
            i += 1
        } else if args[i].startsWith("--index=") {
            index = args[i].sliceFrom(8).toOwned()
        } else if version.len() > 0 || args[i].startsWith("-") {
            eprintln("error: unexpected argument `{args[i]}` for `yank`")
            return 2
        } else {
            version = args[i].clone()
        }
        i += 1
    }
    if version.len() == 0 {
        eprintln("error: `yank` needs a version")
        return 2
    }
    const name = manifestName()
    if name.len() == 0 {
        eprintln("error: `yank` needs an `ofir.json` with a `name` in the current directory")
        return 2
    }
    const dir = match indexDir(index) {
        Result.Ok(dir) => dir,
        Result.Err(message) => {
            eprintln(message)
            return 2
        }
    }
    const rel = indexPath(name)
    const file = "{dir}/{rel}"
    const existing = fs.readToString(file).ok() ?? ""
    const from = if undo { "true" } else { "false" }
    const to = if undo { "false" } else { "true" }
    let text = ""
    let found = false
    let changed = false
    for line in existing.lines() {
        let out = line.toOwned()
        if const Option.Some(doc) = parseJson(line.trim()) {
            if doc.text(doc.field(0, "version")) == version {
                found = true
                const yank = doc.field(0, "yanked")
                if (yank >= 0 && doc.nodes[yank].text == "true") != !undo {
                    const spaced = line.replace("\"yanked\": {from}", "\"yanked\": {to}")
                    out = spaced.replace("\"yanked\":{from}", "\"yanked\":{to}")
                    changed = true
                }
            }
        }
        text.push(out)
        text.push("\n")
    }
    if !found {
        eprintln(refusal("`{name}` {version} is not in the index `{dir}`"))
        return 1
    }
    const state = if undo { "not yanked" } else { "yanked" }
    if !changed {
        println("`{name}` {version} is already {state}")
        return 0
    }
    // GCOVR_EXCL_START: the index file read above can be written back
    if fs.writeString(file, text).isErr() {
        eprintln("error: cannot write `{file}`")
        return 1
    }
    // GCOVR_EXCL_STOP
    const verb = if undo { "Unyank" } else { "Yank" }
    if !commit(dir, rel, "{verb} {name} {version}") {
        return 1
    }
    println("`{name}` {version} is {state}; push `{dir}` to make it public")
    return 0
}

// Checks the project's package and writes its archive into
// `build/package`; the error line when it cannot be published.
fn makePackage() Result<Packaged, str> {
    const Result.Ok(manifest) = fs.readToString("ofir.json") else {
        return Result.Err("error: this needs an `ofir.json` in the current directory")
    }
    const Result.Ok(doc) = parseJsonc(manifest) else {
        return Result.Err("error[E0910]: `ofir.json` is not valid JSONC")
    }
    const name = doc.text(doc.field(0, "name"))
    if !validName(name) {
        return Result.Err(refusal("the package name `{name}` must be lowercase "
                                  + "letters, digits and `-`, start with a letter and be at most "
                                  + "64 bytes"))
    }
    const version = doc.text(doc.field(0, "version"))
    if version.startsWith("v") || parseVersion(version).isNone() {
        return Result.Err(refusal("the `version` of `{name}` must be `X.Y.Z`, "
                                  + "not `{version}`"))
    }
    const license = doc.text(doc.field(0, "license"))
    if license.len() == 0 {
        return Result.Err(refusal("`{name}` has no `license`: a published package needs "
                                  + "an SPDX license expression, such as `\"MIT\"`"))
    }
    const problem = checkLicense(license)
    if problem.len() > 0 {
        return Result.Err("error[E0910]: `license` is not an SPDX license expression: {problem}")
    }
    for key in ["description", "keywords", "repository"] {
        const wrong = metadataError(&doc, key)
        if wrong.len() > 0 {
            return Result.Err("error[E0910]: {wrong}")
        }
    }
    let deps = "\{"
    const list = doc.field(0, "dependencies")
    if list >= 0 {
        let member = doc.nodes[list].child
        for member >= 0 {
            const key = doc.nodes[member].key.clone()
            const req = registryVersion(&doc, member)
            if req.len() == 0 {
                return Result.Err(refusal("the dependency `{key}` of `{name}` is a "
                                          + "path or git one: a published package can only "
                                          + "depend on registry packages"))
            }
            if deps.len() > 1 {
                deps.push(", ")
            }
            deps.push("{jsonString(key)}: {jsonString(req)}")
            member = doc.nodes[member].next
        }
    }
    deps.push("\}")
    const root = fs.canonicalize(".").ok() ?? "."
    const label = "{name}-{version}"
    const stage = "{root}/build/package/{label}"
    const archive = "{stage}.tar.gz"
    run("rm", ["-rf", stage.clone(), archive.clone()])?
    if !copyTree(root, stage, true) {
        return Result.Err("error: cannot copy the package into `{stage}`")
    }
    run("tar", ["-czf", archive.clone(), "-C", stage.clone(), "."])?
    const sum = checksum(stage)
    const metadata = metadataJson(&doc)
    return Result.Ok(Packaged{name, version, archive, sum, deps, license, metadata})
}

// The error line of a refused publish.
fn refusal(message: str) str {
    const code = "E0919"
    return "error[{code}]: {message}"
}

// Whether `name` can be a package's name.
fn validName(name: str) bool {
    if name.len() == 0 || name.len() > 64 {
        return false
    }
    let first = true
    for b in name.bytes() {
        const lower = b >= b'a' && b <= b'z'
        const digit = b >= b'0' && b <= b'9'
        if first && !lower {
            return false
        }
        if !lower && !digit && b != b'-' {
            return false
        }
        first = false
    }
    return true
}

// The `name` of the manifest in the current directory, or empty.
fn manifestName() str {
    const Result.Ok(manifest) = fs.readToString("ofir.json") else {
        return ""
    }
    const Result.Ok(doc) = parseJsonc(manifest) else {
        return ""
    }
    return doc.text(doc.field(0, "name"))
}

// The work tree of the index: `given`, or `$OFIR_REGISTRY` when it is a
// local path.
fn indexDir(given: str) Result<str, str> {
    let dir = given.clone()
    if dir.len() == 0 {
        const registry = os.env("OFIR_REGISTRY") ?? ""
        if registry.contains("://") || registry.startsWith("git@") {
            return Result.Err("error: `$OFIR_REGISTRY` is a URL: give a clone of it with "
                              + "`--index DIR`")
        }
        dir = registry
    }
    if dir.len() == 0 {
        return Result.Err("error: give a clone of the index with `--index DIR`")
    }
    if !fs.exists("{dir}/.git") {
        return Result.Err("error: `{dir}` is not a clone of an index (it has no `.git`)")
    }
    return Result.Ok(fs.canonicalize(dir.clone()).ok() ?? dir)
}

// Where the archive goes when the index's `download` URL is a `file://`
// one; empty otherwise.
fn downloadPath(dir: str, p: &Packaged) str {
    const config = fs.readToString("{dir}/config.json").ok() ?? ""
    const Result.Ok(doc) = parseJsonc(config) else {
        return ""
    }
    const template = doc.text(doc.field(0, "download"))
    if !template.startsWith("file://") {
        return ""
    }
    return template.sliceFrom(7).replace("\{name\}", p.name).replace("\{version\}", p.version)
}

// The directory of `path`.
fn parent(path: str) str {
    let slash = 0
    let i = 0
    for b in path.bytes() {
        if b == b'/' {
            slash = i
        }
        i += 1
    }
    return path.slice(0, slash).toOwned()
}

// Commits the file `rel` of the index `dir`; prints why it failed.
fn commit(dir: str, rel: str, message: str) bool {
    if const Result.Err(e) = run("git", ["-C", dir.clone(), "add", rel.clone()]) {
        eprintln(e)
        return false
    }
    if const Result.Err(e) = run("git", ["-C", dir.clone(), "commit", "-q", "-m",
                                         message.clone()]) {
        eprintln(e)
        return false
    }
    return true
}

// Copies the files of `from` into `to`; at the root, `.git` and `build`
// are left out.
fn copyTree(from: str, to: str, root: bool) bool {
    if fs.createDirAll(to).isErr() {
        return false
    }
    const entries = fs.readDir(from).ok() ?? []
    for i in 0..entries.len() {
        const e = &entries[i]
        if e.name == ".git" || (root && e.name == "build") {
            continue
        }
        const dest = "{to}/{e.name}"
        if fs.readDir(e.path).isOk() {
            if !copyTree(e.path, dest, false) {
                return false
            }
        } else if fs.copyFile(e.path, dest).isErr() {
            return false
        }
    }
    return true
}

// Runs a program; the error line when it fails.
fn run(program: str, args: [str]) Result<str, str> {
    const Result.Ok(out) = os.run(program, args) else {
        return Result.Err("error: cannot run `{program}`: is it installed?")
    }
    if out.status != 0 {
        return Result.Err("error: `{program}` failed: {out.stderr.trim()}")
    }
    return Result.Ok(out.stdout)
}
