// The tests of `driver.pkg.lock`.

import std.fs
import std.testing.TempDir
import std.testing.assert

@test
fn checksumHashesTheFilesInOrder() {
    const sum = "760fe8af9eedfdbc434b8f6a76014f3d4a399865601f8913928b8d562e30a5c5"
    assert(checksum("tests/git/shade/0.1.0") == sum)
}

@test
fn lockTextIsSortedByName() {
    const packages = [Locked{name: "b", git: "/b", registry: "", version: "1.0.0", rev: "",
                             commit: "c1", checksum: "s1"},
                      Locked{name: "a", git: "/a", registry: "", version: "", rev: "main",
                             commit: "c2", checksum: ""}]
    const text = lockText(packages, [])
    assert(text.find("\"a\"").expect("a") < text.find("\"b\"").expect("b"))
    assert(text.contains("\"rev\": \"main\", \"commit\": \"c2\"\}"))
    assert(text.contains("\"commit\": \"c1\", \"checksum\": \"s1\"\}"))
}

@test
fn registryPackagesHaveNoCommit() {
    const packages = [Locked{name: "json", git: "", registry: "/index", version: "1.2.0", rev: "",
                             commit: "", checksum: "s"}]
    const text = lockText(packages, [])
    const entry = "\"name\": \"json\", \"registry\": \"/index\", \"version\": \"1.2.0\""
    assert(text.contains("{entry}, \"checksum\": \"s\"\}"))
    assert(sourceOf(&packages[0]) == "/index#json")
}

@test
fn indexesFollowThePackages() {
    const packages = [Locked{name: "json", git: "", registry: "/index", version: "1.2.0", rev: "",
                             commit: "", checksum: "s"}]
    const indexes = [IndexPin{url: "/z", commit: "c2"}, IndexPin{url: "/index", commit: "c1"}]
    const text = lockText(packages, indexes)
    assert(text.contains("\"indexes\": [\n    \{\"url\": \"/index\", \"commit\": \"c1\"\},"))
    assert(text.endsWith("\"commit\": \"c2\"\}\n  ]\n\}\n"))
    assert(!lockText(packages, []).contains("indexes"))
}

@test
fn sameNamesSortBySource() {
    const packages = [Locked{name: "a", git: "/z", registry: "", version: "", rev: "main",
                             commit: "c1", checksum: ""},
                      Locked{name: "a", git: "/y", registry: "", version: "", rev: "main",
                             commit: "c2", checksum: ""}]
    const text = lockText(packages, [])
    assert(text.find("\"/y\"").expect("y") < text.find("\"/z\"").expect("z"))
}

@test
fn invalidLocksHoldNothing() {
    const dir = TempDir.create("ofir-lock")
    const root = dir.path()
    for text in ["\{", "\{\"packages\": 1\}", "\{\}"] {
        fs.writeString(dir.join("ofir.lock"), text).expect("the directory is writable")
        assert(readLock(root).isEmpty())
        assert(readIndexes(root).isEmpty())
    }
    assert(checksum(dir.join("missing")) == checksum(dir.join("absent")))
    dir.remove()
}
