/**
 * @module
 * The packages of a program (ADR 0032, roadmap 6.5b): the `dependencies`
 * of the project's `ofir.json`, then theirs, transitively. A package is a
 * project whose `build.kind` is `"lib"`; its modules are found from the
 * directory of its `build.root` file. A `path` dependency is that
 * directory; a `git` one is the checkout of the version `driver.resolve`
 * chose, recorded in `ofir.lock`; a registry one (a version requirement)
 * is the archive of the version it chose, extracted.
 *
 * Each package has one name in the program, the prefix of its modules
 * (`json.parser`): the key it is first reached by, made unique if it is
 * taken. Every key a project declares maps to that name.
 */

import base.span.FileId
import base.span.SourceMap
import base.span.Span
import diag.Diagnostics
import diag.LINT_ALLOW
import diag.LINT_DENY
import diag.LINT_WARN
import diag.lintCodes
import driver.lock.Locked
import driver.lock.lockMatches
import driver.lock.readLock
import driver.lock.sourceOf
import driver.lock.writeLock
import driver.resolve.Mode
import driver.resolve.Resolution
import driver.resolve.failureOf
import driver.resolve.gitUrl
import driver.resolve.pinOf
import driver.resolve.registrySource
import driver.resolve.registryVersion
import driver.resolve.resolve
import driver.registry.defaultIndex
import driver.semver.parseRequirement
import lsp.json.JsonDoc
import lsp.json.JsonKind
import lsp.json.parseJsonc
import std.fs

/**
 * A dependency as a project declares it.
 */
pub struct Dependency {
    /** Its key in `dependencies`: the first segment of its imports there. */
    pub key: str
    /** The package it names, an index into the list of packages. */
    pub package: int
}

/**
 * A project of the program: the root (package 0) or a dependency.
 */
pub struct Package {
    /** The prefix of its modules; empty for the root. */
    pub name: str
    /** Its directory, the one with its `ofir.json`; canonical for a dependency. */
    pub dir: str
    /** The directory its modules are found from. */
    pub srcDir: str
    /** The file of the module named like the package. */
    pub rootFile: str
    /** The packages it declares. */
    pub deps: List<Dependency>
    /** The levels of its manifest's `lints` (ADR 0071). */
    pub lints: List<Lint>
}

/**
 * The level of a warning code in a package's modules.
 */
pub struct Lint {
    /** The code, as `W0008`. */
    pub code: str
    /** `LINT_ALLOW`, `LINT_WARN` or `LINT_DENY`. */
    pub level: int
}

/**
 * Where a package's own name is in the program's: the package whose
 * modules have `name` as their first segment, if any.
 *
 * @param packages the packages
 * @param name a module name's first segment
 * @returns its index, or -1 (the root's own modules, or std)
 */
pub fn packageNamed(packages: &List<Package>, name: str) int {
    for i in 1..packages.len() {
        if packages[i].name == name {
            return i
        }
    }
    return -1
}

/**
 * The dependency `key` of the package `p`.
 *
 * @param packages the packages
 * @param p a package
 * @param key the first segment of an import
 * @returns the package it names, or -1
 */
pub fn dependencyOf(packages: &List<Package>, p: int, key: str) int {
    const deps = &packages[p].deps
    for i in 0..deps.len() {
        if deps[i].key == key {
            return deps[i].package
        }
    }
    return -1
}

/**
 * Reads the packages of the program whose project is in `rootDir`.
 *
 * @param rootDir the root project's directory, where its modules are found
 * @param hasManifest whether it holds an `ofir.json`
 * @param mode what the resolution of git dependencies may change
 * @param map where the manifests go, for the diagnostics
 * @param diags where the errors go
 * @returns the packages, the root first
 */
pub fn readPackages(rootDir: str, hasManifest: bool, mode: &Mode, map: mut SourceMap,
                    diags: mut Diagnostics) List<Package> {
    let packages = [Package{name: "", dir: rootDir.toOwned(), srcDir: rootDir.toOwned(),
                            rootFile: "", deps: [], lints: []}]
    if !hasManifest {
        return packages
    }
    const r = resolve(rootDir, mode)
    let reported: List<str> = []
    let p = 0
    for p < packages.len() {   // grows while it is walked
        const deps = readDependencies(packages, p, &r, reported, map, diags)
        packages[p].deps = deps
        p += 1
    }
    if !diags.hasErrors() && (r.pins.len() > 0 || r.hadLock) {
        let locked: List<Locked> = []
        for i in 0..r.pins.len() {
            const pin = &r.pins[i]
            const git = if pin.registry.len() > 0 { "" } else { pin.url.clone() }
            locked.push(Locked{name: pin.name.clone(), git, registry: pin.registry.clone(),
                               version: pin.version.clone(), rev: pin.rev.clone(),
                               commit: pin.commit.clone(), checksum: pin.checksum.clone()})
        }
        if mode.locked {
            if !lockMatches(rootDir, &locked) {
                staleLock(rootDir, &locked, map, diags)
            }
        } else if !writeLock(rootDir, &locked) {
            eprintln("warning: cannot write `{rootDir}/ofir.lock`")
        }
    }
    return packages
}

// Reports that the lock would change under `--locked` (E0913), at the
// root manifest's `dependencies`, with a note for each package that differs.
fn staleLock(rootDir: str, packages: &List<Locked>, map: mut SourceMap, diags: mut Diagnostics) {
    const path = "{rootDir}/ofir.json"
    let file = FileId(-1)
    for i in 0..map.len() {
        if map.file(FileId(i)).path == path {
            file = FileId(i)
        }
    }
    if file.0 < 0 {
        const text = fs.readToString(path).ok() ?? ""
        file = map.add(path.clone(), text)
    }
    let span = Span{file, start: 0, end: 0}
    if const Result.Ok(doc) = parseJsonc(map.file(file).text.clone()) {
        const deps = doc.field(0, "dependencies")
        if deps >= 0 {
            span = Span{file, start: doc.nodes[deps].start, end: doc.nodes[deps].start + 1}
        }
    }
    diags.error("E0913", span, "`ofir.lock` is out of date and `--locked` was given")
    if !fs.exists("{rootDir}/ofir.lock") {
        diags.note("there is no `ofir.lock`: run `ofir fetch`")
        return
    }
    const old = readLock(rootDir)
    for i in 0..packages.len() {
        const p = &packages[i]
        let found = -1
        for k in 0..old.len() {
            if sourceOf(&old[k]) == sourceOf(p) {
                found = k
            }
        }
        if found < 0 {
            diags.note("`{p.name}` is not in it")
        } else if old[found].commit != p.commit || old[found].version != p.version {
            diags.note("`{p.name}` would move from {lockedText(&old[found])} to {lockedText(p)}")
        } else if old[found].checksum != p.checksum {
            diags.note("`{p.name}` has no checksum in it")
        }
    }
    for k in 0..old.len() {
        let used = false
        for i in 0..packages.len() {
            if sourceOf(&packages[i]) == sourceOf(&old[k]) {
                used = true
            }
        }
        if !used {
            diags.note("`{old[k].name}` is in it but no longer used")
        }
    }
}

// A locked package as `1.2.0 (0123456789ab)`, or `1.2.0` from the registry.
fn lockedText(p: &Locked) str {
    if p.commit.len() == 0 {
        return p.version.clone()
    }
    const what = if p.version.len() > 0 { p.version.clone() } else { p.rev.clone() }
    const n = if p.commit.len() < 12 { p.commit.len() } else { 12 }
    return "{what} ({p.commit.slice(0, n)})"
}

// The manifest in `dir`, parsed. Its file goes in the source map only when
// it can hold an error: it is invalid, or `register` and it has `dependencies`
// (a program without any keeps the file ids it had).
fn readManifest(dir: str, register: bool, map: mut SourceMap,
                diags: mut Diagnostics) Option<(JsonDoc, FileId)> {
    const path = "{dir}/ofir.json"
    const Result.Ok(text) = fs.readToString(path) else {
        return Option.None
    }
    match parseJsonc(text) {
        Result.Ok(doc) => {
            if register && (doc.field(0, "dependencies") >= 0 || doc.field(0, "lints") >= 0) {
                return Option.Some((doc, map.add(path, text.clone())))
            }
            return Option.Some((doc, FileId(-1)))
        }
        Result.Err(at) => {
            const file = map.add(path, text.clone())
            diags.error("E0910", Span{file, start: at, end: at}, "`ofir.json` is not valid JSONC")
            return Option.None
        }
    }
}

fn spanOf(doc: &JsonDoc, file: FileId, node: int) Span {
    return Span{file, start: doc.nodes[node].start, end: doc.nodes[node].end}
}

// The dependencies of package `p`; the packages they name are added.
fn readDependencies(packages: mut List<Package>, p: int, r: &Resolution, reported: mut List<str>,
                    map: mut SourceMap, diags: mut Diagnostics) List<Dependency> {
    let out: List<Dependency> = []
    const dir = packages[p].dir.clone()
    const Option.Some(manifest) = readManifest(dir, true, map, diags) else {
        return out
    }
    const (doc, file) = manifest
    const lints = readLints(&doc, file, diags)
    packages[p].lints = lints
    const list = doc.field(0, "dependencies")
    if list < 0 {
        return out
    }
    if doc.nodes[list].kind != JsonKind.Object {
        diags.error("E0910", spanOf(&doc, file, list), "`dependencies` must be an object")
        return out
    }
    let member = doc.nodes[list].child
    for member >= 0 {
        const key = doc.nodes[member].key.clone()
        const at = spanOf(&doc, file, member)
        const target = dependencyTarget(packages, p, &doc, file, member, r, reported, map, diags)
        if target >= 0 && validKey(&packages, p, key, at, diags) {
            out.push(Dependency{key, package: target})
        }
        member = doc.nodes[member].next
    }
    return out
}

// The levels of the manifest's `"lints": {"<category>": "allow|warn|deny"}`.
fn readLints(doc: &JsonDoc, file: FileId, diags: mut Diagnostics) List<Lint> {
    let out: List<Lint> = []
    const table = doc.field(0, "lints")
    if table < 0 {
        return out
    }
    if doc.nodes[table].kind != JsonKind.Object {
        diags.error("E0910", spanOf(doc, file, table), "`lints` must be an object")
        return out
    }
    let member = doc.nodes[table].child
    for member >= 0 {
        const category = doc.nodes[member].key.clone()
        const name = doc.text(member)
        const level = if name == "allow" {
            LINT_ALLOW
        } else if name == "warn" {
            LINT_WARN
        } else if name == "deny" {
            LINT_DENY
        } else {
            -1
        }
        const codes = lintCodes(category)
        if codes.len() == 0 {
            diags.error("E0910", spanOf(doc, file, member), "unknown lint category `{category}`")
            diags.help("the categories are `unused`, `unreachable`, `deprecated`, `naming` and "
                       + "`suspicious`")
        } else if level < 0 {
            diags.error("E0910", spanOf(doc, file, member),
                        "the level of `{category}` must be \"allow\", \"warn\" or \"deny\"")
        } else {
            for i in 0..codes.len() {
                out.push(Lint{code: codes[i].clone(), level})
            }
        }
        member = doc.nodes[member].next
    }
    return out
}

// Whether `key` can name a dependency of package `p` (E0910, E0915).
fn validKey(packages: &List<Package>, p: int, key: str, at: Span, diags: mut Diagnostics) bool {
    if !isModuleName(key) {
        diags.error("E0910", at, "`{key}` is not a valid package name")
        return false
    }
    const src = &packages[p].srcDir
    if key == "std" || fs.exists("{src}/{key}.of") || fs.exists("{src}/{key}") {
        const what = if key == "std" { "the standard library" } else { "a module of the project" }
        diags.error("E0915", at, "the dependency `{key}` is named like {what}")
        diags.help("rename it: its key in `dependencies` is the name the imports use")
        return false
    }
    return true
}

// An identifier that is not a keyword.
fn isModuleName(key: str) bool {
    if key.len() == 0 {
        return false
    }
    let i = 0
    for b in key.bytes() {
        const letter = (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z') || b == b'_'
        if !letter && (i == 0 || b < b'0' || b > b'9') {
            return false
        }
        i += 1
    }
    return !isKeyword(key)
}

// The reserved keywords (`syntax.lexer`).
fn isKeyword(word: str) bool {
    const words = ["as", "break", "const", "continue", "copy", "dyn", "else", "enum", "extern",
                   "false", "fn", "for", "if", "import", "in", "interface", "let", "match", "mut",
                   "pub", "return", "self", "Self", "struct", "true", "unsafe"]
    for i in 0..words.len() {
        if words[i] == word {
            return true
        }
    }
    return false
}

// The package that the dependency `member` names, read if it is new, or -1.
fn dependencyTarget(packages: mut List<Package>, p: int, doc: &JsonDoc, file: FileId, member: int,
                    r: &Resolution, reported: mut List<str>, map: mut SourceMap,
                    diags: mut Diagnostics) int {
    const key = doc.nodes[member].key.clone()
    const at = spanOf(doc, file, member)
    if registryVersion(doc, member).len() > 0 {
        const Option.Some(dir) = registryTarget(doc, file, member, r, reported, diags) else {
            return -1
        }
        return packageAt(packages, dir, key, at, map, diags)
    }
    if doc.nodes[member].kind != JsonKind.Object {
        diags.error("E0910", at, "the dependency `{key}` must be a version or an object")
        return -1
    }
    if doc.field(member, "git") >= 0 {
        const Option.Some(dir) = gitTarget(doc, file, member, packages[p].dir, r, reported,
                                           diags) else {
            return -1
        }
        if !fs.exists("{dir}/ofir.json") {
            diags.error("E0911", at, "the dependency `{key}` has no `ofir.json`")
            return -1
        }
        return packageAt(packages, dir, key, at, map, diags)
    }
    const pathNode = doc.field(member, "path")
    if pathNode < 0 || doc.nodes[pathNode].kind != JsonKind.String {
        diags.error("E0910", at, "the dependency `{key}` needs a `path`, a `git` URL or a version")
        return -1
    }
    const given = doc.nodes[pathNode].text.clone()
    const base = packages[p].dir.clone()
    const joined = if given.startsWith("/") { given.clone() } else { "{base}/{given}" }
    const Result.Ok(dir) = fs.canonicalize(joined) else {
        diags.error("E0911", spanOf(doc, file, pathNode), "cannot find the dependency `{key}`")
        diags.note("no directory `{given}` next to `ofir.json`")
        return -1
    }
    if !fs.exists("{dir}/ofir.json") {
        diags.error("E0911", spanOf(doc, file, pathNode), "cannot find the dependency `{key}`")
        diags.note("`{given}` has no `ofir.json`")
        return -1
    }
    return packageAt(packages, dir, key, at, map, diags)
}

// The checkout that the git dependency `member` was resolved to.
fn gitTarget(doc: &JsonDoc, file: FileId, member: int, base: str, r: &Resolution,
             reported: mut List<str>, diags: mut Diagnostics) Option<str> {
    const key = doc.nodes[member].key.clone()
    const gitNode = doc.field(member, "git")
    if doc.nodes[gitNode].kind != JsonKind.String {
        diags.error("E0910", spanOf(doc, file, gitNode), "`git` must be a string")
        return Option.None
    }
    let given = 0
    const names = ["version", "rev", "branch"]
    for i in 0..names.len() {
        const node = doc.field(member, names[i])
        if node < 0 {
            continue
        }
        given += 1
        if doc.nodes[node].kind != JsonKind.String {
            diags.error("E0910", spanOf(doc, file, node), "`{names[i]}` must be a string")
            return Option.None
        }
        if names[i] == "version" && parseRequirement(doc.nodes[node].text).isNone() {
            const text = doc.nodes[node].text.clone()
            diags.error("E0910", spanOf(doc, file, node), "`{text}` is not a version requirement")
            diags.note("a requirement is `^1.2.3`, `~1.2.3`, `=1.2.3`, `>=1.2.3` or `*`")
            return Option.None
        }
    }
    if given != 1 {
        diags.error("E0910", spanOf(doc, file, member),
                    "the dependency `{key}` needs one of `version`, `rev` and `branch`")
        return Option.None
    }
    const url = gitUrl(doc.nodes[gitNode].text, base)
    return pinnedDir(doc, file, member, url, r, reported, diags)
}

// The directory that the registry dependency `member` was resolved to.
fn registryTarget(doc: &JsonDoc, file: FileId, member: int, r: &Resolution,
                  reported: mut List<str>, diags: mut Diagnostics) Option<str> {
    const key = doc.nodes[member].key.clone()
    const node = if doc.nodes[member].kind == JsonKind.String {
        member
    } else {
        doc.field(member, "version")
    }
    const text = doc.nodes[node].text.clone()
    if parseRequirement(text).isNone() {
        diags.error("E0910", spanOf(doc, file, node), "`{text}` is not a version requirement")
        diags.note("a requirement is `^1.2.3`, `~1.2.3`, `=1.2.3`, `>=1.2.3` or `*`")
        return Option.None
    }
    return pinnedDir(doc, file, member, registrySource(defaultIndex(), key), r, reported, diags)
}

// The directory of the pin of `url`, or its failure reported once, at `member`.
fn pinnedDir(doc: &JsonDoc, file: FileId, member: int, url: str, r: &Resolution,
             reported: mut List<str>, diags: mut Diagnostics) Option<str> {
    const pin = pinOf(r, url)
    if pin >= 0 {
        return Option.Some(r.pins[pin].dir.clone())
    }
    const f = failureOf(r, url)
    if f >= 0 && !isReported(&reported, url) {
        reported.push(url.clone())
        const failure = &r.failures[f]
        diags.error(failure.code, spanOf(doc, file, member), failure.message.clone())
        for i in 0..failure.notes.len() {
            diags.note(failure.notes[i].clone())
        }
    }
    return Option.None
}

fn isReported(reported: &List<str>, url: str) bool {
    for i in 0..reported.len() {
        if reported[i] == url {
            return true
        }
    }
    return false
}

// The package in the directory `dir`, read if it is new, or -1.
fn packageAt(packages: mut List<Package>, dir: str, key: str, at: Span, map: mut SourceMap,
             diags: mut Diagnostics) int {
    for i in 1..packages.len() {
        if packages[i].dir == dir {
            return i
        }
    }
    const Option.Some(root) = libraryRoot(dir, key, at, map, diags) else {
        return -1
    }
    const slash = lastSlash(root)
    const srcDir = if slash > 0 { root.slice(0, slash).toOwned() } else { dir.clone() }
    const name = uniqueName(&packages, key)
    packages.push(Package{name, dir: dir.toOwned(), srcDir, rootFile: root, deps: [],
                          lints: []})
    return packages.len() - 1
}

// The `build.root` file of the library in `dir`.
fn libraryRoot(dir: str, key: str, at: Span, map: mut SourceMap,
               diags: mut Diagnostics) Option<str> {
    const Option.Some(manifest) = readManifest(dir, false, map, diags) else {
        return Option.None
    }
    const (doc, _) = manifest
    if doc.text(doc.at(["build", "kind"])) != "lib" {
        diags.error("E0911", at, "the dependency `{key}` is not a library")
        diags.note("its `ofir.json` must have `\"build\": \{\"kind\": \"lib\"\}`")
        return Option.None
    }
    const given = doc.text(doc.at(["build", "root"]))
    const root = if given.len() > 0 { given } else { "src/index.of" }
    const file = "{dir}/{root}"
    if !fs.exists(file) {
        diags.error("E0911", at, "cannot find the root file of the dependency `{key}`")
        diags.note("no `{root}` in `{dir}`")
        return Option.None
    }
    return Option.Some(file)
}

// `key`, or `key_2`, `key_3`... when another package has it.
fn uniqueName(packages: &List<Package>, key: str) str {
    let name = key.toOwned()
    let n = 2
    for packageNamed(packages, name) >= 0 || takenByRoot(packages, name) {
        name = "{key}_{n}"
        n += 1
    }
    return name
}

// Whether the root project has a top-level module `name`, or it is std.
fn takenByRoot(packages: &List<Package>, name: str) bool {
    const src = &packages[0].srcDir
    return name == "std" || fs.exists("{src}/{name}.of") || fs.exists("{src}/{name}")
}

fn lastSlash(path: str) int {
    let found = -1
    let i = 0
    for b in path.bytes() {
        if b == b'/' {
            found = i
        }
        i += 1
    }
    return found
}
