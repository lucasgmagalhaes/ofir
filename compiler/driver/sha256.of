/**
 * @module
 * SHA-256 (FIPS 180-4), for the checksums of `ofir.lock` (ADR 0032).
 */

/**
 * A SHA-256 computation, fed in pieces.
 */
pub struct Sha256 {
    state: List<u32>
    /** The bytes not yet hashed: fewer than a block. */
    pending: List<u8>
    /** How many bytes were fed. */
    total: int
    /** The message schedule of a block, reused from block to block. */
    w: List<u32>
    k: List<u32>

    /**
     * A computation that was fed nothing.
     *
     * @returns it
     */
    pub fn new() Sha256 {
        const state: List<u32> = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f,
                                  0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
        const w: List<u32> = [0; 64]
        return Sha256{state, pending: [], total: 0, w, k: roundConstants()}
    }

    /**
     * Feeds bytes.
     *
     * @param data the bytes
     */
    pub fn update(mut self, data: &List<u8>) {
        if data.len() > 0 {
            self.feed(&data[0] as *u8, data.len())
        }
    }

    /**
     * Feeds the bytes of a text.
     *
     * @param text the text
     */
    pub fn updateText(mut self, text: str) {
        self.feed(text.asPtr(), text.len())
    }

    // Feeds the `len` bytes at `data`: whole blocks are hashed where they
    // lie, without a copy.
    fn feed(mut self, data: *u8, len: int) {
        self.total += len
        let i = 0
        if self.pending.len() > 0 {
            for i < len && self.pending.len() < 64 {
                self.pending.push(unsafe { *data.add(i) })
                i += 1
            }
            if self.pending.len() < 64 {
                return
            }
            compress(self.state, self.w, &self.k, &self.pending[0] as *u8)
            self.pending.clear()
        }
        for i + 64 <= len {
            compress(self.state, self.w, &self.k, unsafe { data.add(i) })
            i += 64
        }
        for i < len {
            self.pending.push(unsafe { *data.add(i) })
            i += 1
        }
    }

    /**
     * Ends the computation.
     *
     * @returns the hash, as 64 lowercase hex digits
     */
    pub fn finish(mut self) str {
        const bits = self.total * 8
        let tail: List<u8> = [0x80]
        for (self.pending.len() + tail.len()) % 64 != 56 {
            tail.push(0)
        }
        for i in 0..8 {
            const shift = (7 - i) * 8
            tail.push(((bits >> shift) & 255) as u8)
        }
        self.update(&tail)
        const digits = "0123456789abcdef"
        let out = str.new()
        for i in 0..8 {
            const word = self.state[i]
            for j in 0..8 {
                const shift = ((7 - j) * 4) as u32
                const nibble = ((word >> shift) & 15) as int
                out.push(digits.slice(nibble, nibble + 1))
            }
        }
        return out
    }
}

/**
 * The SHA-256 of a text.
 *
 * @param text the text
 * @returns the hash, as 64 lowercase hex digits
 */
pub fn sha256Hex(text: str) str {
    let h = Sha256.new()
    h.updateText(text)
    return h.finish()
}

// Hashes the block of 64 bytes at `block` into `state`; `w` holds 64 words.
fn compress(state: mut List<u32>, w: mut List<u32>, k: &List<u32>, block: *u8) {
    for i in 0..16 {
        const b0 = unsafe { *block.add(i * 4) } as u32
        const b1 = unsafe { *block.add(i * 4 + 1) } as u32
        const b2 = unsafe { *block.add(i * 4 + 2) } as u32
        const b3 = unsafe { *block.add(i * 4 + 3) } as u32
        w[i] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    }
    for i in 16..64 {
        const a = w[i - 15]
        const b = w[i - 2]
        const s0 = rotr(a, 7) ^ rotr(a, 18) ^ (a >> 3)
        const s1 = rotr(b, 17) ^ rotr(b, 19) ^ (b >> 10)
        w[i] = w[i - 16].wrappingAdd(s0).wrappingAdd(w[i - 7]).wrappingAdd(s1)
    }
    let a = state[0]
    let b = state[1]
    let c = state[2]
    let d = state[3]
    let e = state[4]
    let f = state[5]
    let g = state[6]
    let h = state[7]
    for i in 0..64 {
        const s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
        const ch = (e & f) ^ ((e ^ 0xffffffff) & g)
        const t1 = h.wrappingAdd(s1).wrappingAdd(ch).wrappingAdd(k[i]).wrappingAdd(w[i])
        const s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
        const maj = (a & b) ^ (a & c) ^ (b & c)
        const t2 = s0.wrappingAdd(maj)
        h = g
        g = f
        f = e
        e = d.wrappingAdd(t1)
        d = c
        c = b
        b = a
        a = t1.wrappingAdd(t2)
    }
    state[0] = state[0].wrappingAdd(a)
    state[1] = state[1].wrappingAdd(b)
    state[2] = state[2].wrappingAdd(c)
    state[3] = state[3].wrappingAdd(d)
    state[4] = state[4].wrappingAdd(e)
    state[5] = state[5].wrappingAdd(f)
    state[6] = state[6].wrappingAdd(g)
    state[7] = state[7].wrappingAdd(h)
}

// `x` rotated right by `n` bits (0 < n < 32).
fn rotr(x: u32, n: u32) u32 {
    return (x >> n) | (x << (32 - n))
}

fn roundConstants() List<u32> {
    const k: List<u32> = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,
                          0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
                          0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
                          0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
                          0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
                          0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
                          0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
                          0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
                          0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
                          0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
                          0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]
    return k
}
