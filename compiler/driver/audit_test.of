// The tests of `driver.audit`.

import driver.semver.parseVersion
import std.testing.assert

fn hit(versions: str, version: str) bool {
    const v = parseVersion(version).expect("a version")
    return affects(versions, v) ?? false
}

@test
fn boundsSelectTheAffectedVersions() {
    assert(hit("<1.4.2", "1.4.1") && !hit("<1.4.2", "1.4.2"))
    assert(hit("<=1.4.2", "1.4.2") && !hit(">1.4.2", "1.4.2") && hit(">1.4.2", "1.5.0"))
    assert(hit(">=1.0.0, <1.4.2", "1.2.0") && !hit(">=1.0.0, <1.4.2", "0.9.0"))
    assert(hit("^0.3", "0.3.7") && !hit("^0.3", "0.4.0") && hit("=2.0.0", "2.0.0"))
}

@test
fn alternativesAndInvalidVersions() {
    assert(hit("<1.0.0 || >=2.0.0, <2.1.0", "0.5.0"))
    assert(hit("<1.0.0 || >=2.0.0, <2.1.0", "2.0.3"))
    assert(!hit("<1.0.0 || >=2.0.0, <2.1.0", "1.5.0"))
    const v = parseVersion("1.0.0").expect("a version")
    assert(affects("", v).isNone() && affects("<1.x", v).isNone())
    assert(affects("1.0.0, ", v).isNone())
}
