/**
 * @module
 * `ofir.lock` (ADR 0032): the git packages a program was resolved to,
 * next to its `ofir.json`. It is generated JSON, sorted by name: each
 * package's repository, its version (or the `rev` or `branch` it follows),
 * its commit and the checksum of its files. A registry package has its
 * index and version instead of a repository and a commit. Path dependencies
 * are not in it. `indexes` has the commit of each registry index the
 * resolution read (ADR 0081).
 */

import diag.jsonString
import driver.sha256.Sha256
import lsp.json.JsonKind
import lsp.json.parseJsonc
import std.fs

/**
 * A package of the lock.
 */
pub struct Locked {
    /** The key it is reached by first. */
    pub name: str
    /** Its repository: a URL, or a canonical local path; empty for the registry. */
    pub git: str
    /** The index of the registry it comes from; empty for a git package. */
    pub registry: str
    /** Its version, without `v`; empty when it follows `rev`. */
    pub version: str
    /** The `rev` or `branch` it follows; empty when it has a version. */
    pub rev: str
    /** The commit it is at; empty for a registry package. */
    pub commit: str
    /** The SHA-256 of its files (`checksum`); empty in a lock that has none. */
    pub checksum: str
}

/**
 * The commit of a registry index in the lock.
 */
pub struct IndexPin {
    /** The index: a URL, or a canonical local path. */
    pub url: str
    /** The commit of the index that was read. */
    pub commit: str
}

/**
 * Reads the index commits of the lock of the project in `dir`.
 *
 * @param dir the project's directory
 * @returns them; none when there is no lock, or it has no `indexes`
 */
pub fn readIndexes(dir: str) List<IndexPin> {
    let out: List<IndexPin> = []
    const Result.Ok(text) = fs.readToString("{dir}/ofir.lock") else {
        return out
    }
    const Result.Ok(doc) = parseJsonc(text) else {
        return out
    }
    for node in doc.elements(doc.field(0, "indexes")) {
        const pin = IndexPin{url: doc.text(doc.field(node, "url")),
                             commit: doc.text(doc.field(node, "commit"))}
        if pin.url.len() > 0 && pin.commit.len() > 0 {
            out.push(pin)
        }
    }
    return out
}

/**
 * Reads the lock of the project in `dir`.
 *
 * @param dir the project's directory
 * @returns its packages; none when there is no lock or it is invalid
 */
pub fn readLock(dir: str) List<Locked> {
    let out: List<Locked> = []
    const Result.Ok(text) = fs.readToString("{dir}/ofir.lock") else {
        return out
    }
    const Result.Ok(doc) = parseJsonc(text) else {
        return out
    }
    const list = doc.field(0, "packages")
    if list < 0 || doc.nodes[list].kind != JsonKind.Array {
        return out
    }
    for node in doc.elements(list) {
        const entry = Locked{name: doc.text(doc.field(node, "name")),
                             git: doc.text(doc.field(node, "git")),
                             registry: doc.text(doc.field(node, "registry")),
                             version: doc.text(doc.field(node, "version")),
                             rev: doc.text(doc.field(node, "rev")),
                             commit: doc.text(doc.field(node, "commit")),
                             checksum: doc.text(doc.field(node, "checksum"))}
        const fromGit = entry.git.len() > 0 && entry.commit.len() > 0
        const fromRegistry = entry.registry.len() > 0 && entry.version.len() > 0
        if fromGit || fromRegistry {
            out.push(entry)
        }
    }
    return out
}

/**
 * Where a locked package comes from, as `driver.resolve` names it: its
 * repository, or `<index>#<name>` for the registry.
 *
 * @param p the package
 * @returns its source
 */
pub fn sourceOf(p: &Locked) str {
    if p.registry.len() > 0 {
        return "{p.registry}#{p.name}"
    }
    return p.git.clone()
}

/**
 * The text of a lock.
 *
 * @param packages its packages, in any order
 * @param indexes the commits of the indexes, in any order
 * @returns the JSON, sorted by name, then repository; the indexes by URL
 */
pub fn lockText(packages: List<Locked>, indexes: List<IndexPin>) str {
    let order: List<int> = []
    for i in 0..packages.len() {
        let at = order.len()
        for at > 0 && before(&packages[i], &packages[order[at - 1]]) {
            at -= 1
        }
        order.insert(at, i)
    }
    let out = "// Generated by ofir: do not edit.\n\{\n  \"packages\": ["
    for k in 0..order.len() {
        const p = &packages[order[k]]
        out.push(if k > 0 { ",\n" } else { "\n" })
        out.push("    \{\"name\": {jsonString(p.name)}, ")
        if p.registry.len() > 0 {
            out.push("\"registry\": {jsonString(p.registry)}, ")
            out.push("\"version\": {jsonString(p.version)}")
        } else {
            out.push("\"git\": {jsonString(p.git)}, ")
            if p.version.len() > 0 {
                out.push("\"version\": {jsonString(p.version)}, ")
            } else {
                out.push("\"rev\": {jsonString(p.rev)}, ")
            }
            out.push("\"commit\": {jsonString(p.commit)}")
        }
        if p.checksum.len() > 0 {
            out.push(", \"checksum\": {jsonString(p.checksum)}")
        }
        out.push("\}")
    }
    out.push(if order.len() > 0 { "\n  ]" } else { "]" })
    if indexes.len() > 0 {
        let sorted: List<int> = []
        for i in 0..indexes.len() {
            let at = sorted.len()
            for at > 0 && indexes[i].url < indexes[sorted[at - 1]].url {
                at -= 1
            }
            sorted.insert(at, i)
        }
        out.push(",\n  \"indexes\": [")
        for k in 0..sorted.len() {
            const x = &indexes[sorted[k]]
            out.push(if k > 0 { ",\n" } else { "\n" })
            out.push("    \{\"url\": {jsonString(x.url)}, \"commit\": {jsonString(x.commit)}\}")
        }
        out.push("\n  ]")
    }
    out.push("\n\}\n")
    return out
}

/**
 * Whether the lock of the project in `dir` is the one `packages` make;
 * no lock matches no packages.
 *
 * @param dir the project's directory
 * @param packages its packages
 * @param indexes the commits of the indexes
 * @returns true if it would not change
 */
pub fn lockMatches(dir: str, packages: List<Locked>, indexes: List<IndexPin>) bool {
    if const Result.Ok(old) = fs.readToString("{dir}/ofir.lock") {
        return old == lockText(packages, indexes)
    }
    return packages.len() == 0
}

/**
 * Writes the lock of the project in `dir`, if it changed.
 *
 * @param dir the project's directory
 * @param packages its packages
 * @param indexes the commits of the indexes
 * @returns false if it could not be written
 */
pub fn writeLock(dir: str, packages: List<Locked>, indexes: List<IndexPin>) bool {
    if lockMatches(dir, packages, indexes) {
        return true
    }
    return fs.writeString("{dir}/ofir.lock", lockText(packages, indexes)).isOk()
}

/**
 * The checksum of a package: the SHA-256 of its files, sorted by path,
 * each as its path from `dir`, a NUL, its size, a NUL and its bytes. The
 * `.git` directory is left out.
 *
 * @param dir the package's directory
 * @returns the hash, as 64 hex digits
 */
pub fn checksum(dir: str) str {
    let h = Sha256.new()
    addTree(h, dir, "")
    return h.finish()
}

// Feeds the files under `dir`/`rel` to `h`.
fn addTree(h: mut Sha256, dir: str, rel: str) {
    const path = if rel.len() > 0 { "{dir}/{rel}" } else { dir.toOwned() }
    const Result.Ok(entries) = fs.readDir(path) else {
        return
    }
    for i in 0..entries.len() {
        const name = entries[i].name.clone()
        if rel.len() == 0 && name == ".git" {
            continue
        }
        const sub = if rel.len() > 0 { "{rel}/{name}" } else { name.clone() }
        if fs.readDir(entries[i].path.clone()).isOk() {
            addTree(h, dir, sub)
        } else {
            const data = fs.read(entries[i].path.clone()).ok() ?? []
            h.updateText("{sub}\0{data.len()}\0")
            h.update(&data)
        }
    }
}

// Whether `a` sorts before `b`.
fn before(a: &Locked, b: &Locked) bool {
    if a.name != b.name {
        return a.name < b.name
    }
    return sourceOf(a) < sourceOf(b)
}
