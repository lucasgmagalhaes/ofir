/**
 * @module
 * `ofir doc`: HTML documentation from the documentation comments of the
 * source files (docs/design/toolchain.md). Each file is a module, read on
 * its own: its syntax tree gives the public declarations, and its tokens
 * the comments (`doc.page.comments`).
 */

import base.intern.Interner
import base.span.SourceMap
import diag.Diagnostics
import diag.Format
import doc.page.comments
import doc.page.indexPage
import doc.page.modulePage
import std.fs
import syntax.lexer.tokenize
import syntax.parser.parse

// A file to document and the name of its module.
struct Source {
    path: str
    module: str
}

/**
 * Runs `ofir doc [-o dir] [--stdout] [paths]`: writes a page for the module
 * of each `.of` file of the paths, by default of `src` or else of the
 * current directory, and an index, to `build/doc` or `dir`. `--stdout`
 * prints the pages instead.
 *
 * @param args the arguments after `doc`
 * @returns the exit status: 1 if a file does not parse, 2 for a bad
 *          argument or a path that cannot be read or written
 */
pub fn docCommand(args: List<str>) int {
    let out = "build/doc".toOwned()
    let stdout = false
    let paths: List<str> = []
    let i = 0
    for i < args.len() {
        if args[i] == "--stdout" {
            stdout = true
        } else if args[i] == "-o" {
            if i + 1 == args.len() {
                eprintln("error: `-o` needs a directory")
                return 2
            }
            i += 1
            out = args[i].clone()
        } else if args[i].startsWith("-") {
            eprintln("error: unknown option `{args[i]}` for `doc`")
            return 2
        } else {
            paths.push(args[i].clone())
        }
        i += 1
    }
    if paths.isEmpty() {
        paths.push(if fs.readDir("src").isOk() { "src".toOwned() } else { ".".toOwned() })
    }
    let sources: List<Source> = []
    for k in 0..paths.len() {
        if !collect(paths[k], paths[k], sources) {
            eprintln("error: cannot read `{paths[k]}`")
            return 2
        }
    }
    return document(&sources, out, stdout)
}

// Writes or prints the page of each source, and the index.
fn document(sources: &List<Source>, out: str, stdout: bool) int {
    if !stdout && fs.createDirAll(out).isErr() {
        eprintln("error: cannot create `{out}`")
        return 2
    }
    let status = 0
    let modules: List<str> = []
    let summaries: List<str> = []
    for i in 0..sources.len() {
        const Option.Some(page) = pageOf(&sources[i], modules, summaries) else {
            status = 1
            continue
        }
        if stdout {
            print(page)
        } else if !write("{out}/{sources[i].module}.html", page) {
            return 2
        }
    }
    if !stdout && !write("{out}/index.html", indexPage(&modules, &summaries)) {
        return 2
    }
    return status
}

// Writes a file; false, after an error, if it cannot.
fn write(path: str, text: str) bool {
    if fs.writeString(path, text).isErr() {
        eprintln("error: cannot write `{path}`")
        return false
    }
    return true
}

// The page of a source, its module and its module comment added to
// `modules` and `summaries`; `None`, after its errors, if it does not lex
// or parse.
fn pageOf(source: &Source, modules: mut List<str>, summaries: mut List<str>) Option<str> {
    const Result.Ok(src) = fs.readToString(source.path) else {
        eprintln("error: cannot read `{source.path}`")
        return Option.None
    }
    let map = SourceMap.new()
    const file = map.add(source.path.clone(), src.clone())
    let names = Interner.new()
    let diags = Diagnostics.new()
    const tokens = tokenize(src, file, names, diags)
    const docs = comments(src, &tokens)
    if diags.hasErrors() {
        eprint(diags.render(map, Format.Human))
        return Option.None
    }
    const tree = parse(file, src, tokens, names, diags)
    if tree.diags.hasErrors() {
        eprint(tree.diags.render(map, Format.Human))
        return Option.None
    }
    modules.push(source.module.clone())
    summaries.push(docs.module.clone())
    return Option.Some(modulePage(source.module, src, &tree.module, &tree.names, docs))
}

// The module of the file `path` found under `root`: its path from `root`
// without `.of`, `/` written `.`, and `index` naming its directory. A file
// given by itself (`path == root`) is named after its stem.
fn moduleName(root: str, path: str) str {
    let rel = path.replace("\\", "/")   // Windows paths may use `\`
    if path != root && path.startsWith(root) {
        rel = rel.sliceFrom(root.len()).toOwned()
    }
    for rel.startsWith("./") || rel.startsWith("/") {
        rel = rel.sliceFrom(if rel.startsWith("/") { 1 } else { 2 }).toOwned()
    }
    let parts: List<str> = []
    for part in rel.slice(0, rel.len() - 3).split("/") {
        parts.push(part.toOwned())
    }
    if parts.len() > 1 && parts[parts.len() - 1] == "index" {
        parts.pop()
    }
    if path == root {
        return parts[parts.len() - 1].clone()   // a file given by itself
    }
    let out = ""
    for i in 0..parts.len() {
        if i > 0 {
            out.push(".")
        }
        out.push(parts[i])
    }
    return out
}

// Adds the `.of` files of `path` but the `_test.of` ones (a file, or a
// directory read recursively, leaving out hidden entries) to `sources`,
// with their modules under `root`. False if `path` cannot be read.
fn collect(root: str, path: str, sources: mut List<Source>) bool {
    const Result.Ok(entries) = fs.readDir(path) else {
        if !fs.exists(path) {
            return false
        }
        if path.endsWith(".of") && !path.endsWith("_test.of") {
            sources.push(Source{path: path.toOwned(), module: moduleName(root, path)})
        }
        return true
    }
    let names: List<str> = []
    for i in 0..entries.len() {
        if !entries[i].name.startsWith(".") {
            names.push(entries[i].name.clone())
        }
    }
    names.sort()   // the pages in the same order everywhere
    for i in 0..names.len() {
        collect(root, "{path}/{names[i]}", sources)
    }
    return true
}
