/**
 * @module
 * The HTML page of a module, for `ofir doc` (docs/design/toolchain.md): its
 * comment, then its public declarations with their signatures and comments.
 *
 * The syntax tree has no comments: a comment is found by the position of
 * the token after it, which is where the declaration it documents starts.
 */

import base.intern.Interner
import doc.links.Targets
import doc.links.jsString
import doc.markdown.escape
import doc.markdown.summary
import doc.tags.renderDoc
import syntax.ast.Attribute
import syntax.ast.FieldDecl
import syntax.ast.FnDecl
import syntax.ast.Item
import syntax.ast.ItemKind
import syntax.ast.Module
import syntax.ast.Variant
import syntax.token.Token
import syntax.token.TokenKind

/**
 * The comments of a file.
 */
pub struct Comments {
    /** The text of each documentation comment, by where the token after it starts. */
    pub before: Map<int, str>
    /** The text of the module comment; `""` if there is none. */
    pub module: str
}

// Whether `b` is a space or a tab.
fn isBlank(b: u8) bool {
    return b == b' ' || b == b'\t'
}

// A line of a comment without its indentation, the `*` that starts it and
// the space after that.
fn commentLine(line: str) str {
    let i = 0
    for i < line.len() && isBlank(line[i]) {
        i += 1
    }
    if i < line.len() && line[i] == b'*' {
        i += 1
        if i < line.len() && line[i] == b' ' {
            i += 1
        }
    }
    return line.sliceFrom(i).trimEnd().toOwned()
}

// The text of the comment `src[start..end]`: its lines without `/**`, `*/`
// and the `*` at their start, with no blank lines first or last.
fn commentText(src: str, start: int, end: int, module: bool) str {
    let lines: List<str> = []
    for part in src.slice(start + 3, end - 2).split("\n") {
        lines.push(commentLine(part))
    }
    let lo = 0
    for lo < lines.len() && lines[lo] == "" {
        lo += 1
    }
    if module && lo < lines.len() && lines[lo].startsWith("@module") {
        const rest = lines[lo].sliceFrom(7).trim().toOwned()
        lines[lo] = rest
        if lines[lo] == "" {
            lo += 1
        }
    }
    let hi = lines.len()
    for hi > lo && lines[hi - 1] == "" {
        hi -= 1
    }
    let out = ""
    for i in lo..hi {
        if i > lo {
            out.push("\n")
        }
        out.push(lines[i])
    }
    return out
}

/**
 * The documentation comments of a file.
 *
 * @param src the file's text
 * @param tokens its tokens, with the comments
 * @returns them
 */
pub fn comments(src: str, tokens: &List<Token>) Comments {
    let out = Comments{before: Map.new(), module: ""}
    for t in 0..tokens.len() {
        const kind = tokens[t].kind
        const span = tokens[t].span
        if kind == TokenKind.ModuleDoc {
            out.module = commentText(src, span.start, span.end, true)
            continue
        }
        if kind != TokenKind.DocComment {
            continue
        }
        let next = t + 1
        for next < tokens.len() && tokens[next].kind == TokenKind.Newline {
            next += 1
        }
        if next < tokens.len() {
            out.before.insert(tokens[next].span.start, commentText(src, span.start, span.end,
                                                                   false))
        }
    }
    return out
}


// Source text on one line: each line break and the indentation after it
// become one space, none after an opening bracket or before a closing one.
fn oneLine(text: str) str {
    let out = ""
    for part in text.split("\n") {
        const line = part.trim()
        if line == "" {
            continue
        }
        const last = if out.len() > 0 { out[out.len() - 1] } else { b'(' }
        const first = line[0]
        if last != b'(' && last != b'[' && first != b')' && first != b']' {
            out.push(" ")
        } else if last == b',' {
            out.push(" ")
        }
        out.push(line)
    }
    return out.replace(",)", ")").replace(",]", "]")
}

// Where a declaration's text starts after its attributes.
fn afterAttributes(src: str, start: int, attributes: &List<Attribute>) int {
    if attributes.len() == 0 {
        return start
    }
    let pos = attributes[attributes.len() - 1].span.end
    for pos < src.len() && (src[pos] == b' ' || src[pos] == b'\t' || src[pos] == b'\n') {
        pos += 1
    }
    return pos
}

// The text from `start` up to the first `{` before `end`, or to `end`.
fn header(src: str, start: int, end: int) str {
    let pos = start
    for pos < end && src[pos] != b'{' {
        pos += 1
    }
    return oneLine(src.slice(start, pos))
}

// A page being written: the text of its module, its comments and its HTML.
struct Page {
    src: str
    docs: Comments
    out: str
    module: str
    /** Whether private declarations are documented too (`--private`). */
    all: bool
    /** The entries of `search.js`, one line each. */
    search: str
    /** The anchor of each declaration on the page. */
    anchors: List<str>

    // The comment of the declaration that starts at `start`, as HTML.
    fn doc(self, start: int, headingLevel: int) str {
        if const Option.Some(text) = self.docs.before.get(start) {
            return renderDoc(text, headingLevel)
        }
        return "".toOwned()
    }

    // A declaration: its anchor, signature and comment.
    fn entry(mut self, anchor: str, signature: str, start: int) {
        const level = if anchor.find(".").isSome() { 3 } else { 2 }
        const doc = self.doc(start, level + 1)
        let brief = ""
        if const Option.Some(text) = self.docs.before.get(start) {
            brief = summary(text)
        }
        self.anchors.push(anchor.clone())
        self.search.push("[{jsString(anchor)}, {jsString(self.module)}, {jsString(brief)}],\n")
        self.out.push("<section class=\"decl\" id=\"{escape(anchor)}\">\n")
        self.out.push("<h{level} class=\"decl-title\">{escape(anchor)}</h{level}>\n")
        self.out.push("<pre class=\"signature\"><code>{escape(signature)}</code></pre>\n")
        if doc.len() > 0 {
            self.out.push("<div class=\"doc\">\n{doc}</div>\n")
        }
    }

    fn function(mut self, names: &Interner, decl: &FnDecl, owner: str) {
        const start = afterAttributes(self.src, decl.span.start, &decl.attributes)
        const end = match decl.body {
            Option.Some(body) => body.span.start
            Option.None => decl.span.end
        }
        let anchor = owner.toOwned()
        anchor.push(names.name(decl.name))
        self.entry(anchor, oneLine(self.src.slice(start, end)), decl.span.start)
        self.out.push("</section>\n")
    }

    fn methods(mut self, names: &Interner, methods: &List<FnDecl>, owner: str, all: bool) {
        for i in 0..methods.len() {
            if all || methods[i].isPub {
                self.function(names, &methods[i], owner)
            }
        }
    }

    fn field(mut self, names: &Interner, field: &FieldDecl, owner: str) {
        const Option.Some(name) = field.name else {
            return
        }
        const start = afterAttributes(self.src, field.span.start, &field.attributes)
        let anchor = owner.toOwned()
        anchor.push(names.name(name))
        self.entry(anchor, oneLine(self.src.slice(start, field.span.end)), field.span.start)
        self.out.push("</section>\n")
    }

    fn variant(mut self, names: &Interner, variant: &Variant, owner: str) {
        let anchor = owner.toOwned()
        anchor.push(names.name(variant.name))
        const text = oneLine(self.src.slice(variant.span.start, variant.span.end))
        self.entry(anchor, text, variant.span.start)
        self.out.push("</section>\n")
    }

    fn item(mut self, names: &Interner, item: &Item) {
        const name = names.name(item.name).toOwned()
        const start = afterAttributes(self.src, item.span.start, &item.attributes)
        const owner = "{name}."
        match item.kind {
            ItemKind.Fn(decl) => self.function(names, &*decl, "")
            ItemKind.Struct(_, _, _, _, fields, methods) => {
                self.entry(name, header(self.src, start, item.span.end), item.span.start)
                for i in 0..fields.len() {
                    if self.all || fields[i].isPub {
                        self.field(names, &fields[i], owner)
                    }
                }
                self.methods(names, &methods, owner, self.all)
                self.out.push("</section>\n")
            }
            ItemKind.Enum(_, _, variants, methods) => {
                self.entry(name, header(self.src, start, item.span.end), item.span.start)
                for i in 0..variants.len() {
                    self.variant(names, &variants[i], owner)
                }
                self.methods(names, &methods, owner, self.all)
                self.out.push("</section>\n")
            }
            ItemKind.Interface(_, _, methods) => {
                self.entry(name, header(self.src, start, item.span.end), item.span.start)
                self.methods(names, &methods, owner, true)
                self.out.push("</section>\n")
            }
            ItemKind.Const(_, _) | ItemKind.Global(_, _) | ItemKind.TypeAlias(_, _) => {
                self.entry(name, oneLine(self.src.slice(start, item.span.end)), item.span.start)
                self.out.push("</section>\n")
            }
            _ => {}
        }
    }
}

/**
 * What every page of a documentation site shares.
 */
pub struct Site {
    /** The package's name and version, from its manifest; `""` if there is none. */
    pub label: str
    /** Whether private declarations are documented too (`--private`). */
    pub all: bool
}

// The start of a page, up to its `<body>`, and its navigation: the index,
// the package and the search box.
fn head(title: str, site: &Site) str {
    let out = "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
    out.push("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n")
    out.push("<title>{escape(title)} · Ofir documentation</title>\n<style>\n")
    out.push("* \{ box-sizing: border-box; \}\n")
    out.push(":root \{ color-scheme: light; background: #f7f8f5; color: #202b29; \}\n")
    out.push("body \{ margin: 0; font: 1rem/1.7 system-ui, sans-serif; \}\n")
    out.push("a \{ color: #136257; text-underline-offset: .2em; \}\n")
    out.push("a:hover \{ color: #083f38; \}\n")
    out.push(":focus-visible \{ outline: 3px solid #138577; outline-offset: 3px; \}\n")
    out.push("::selection \{ background: #c7e8df; color: #172b27; \}\n")
    out.push(".skip \{ position: absolute; top: -4rem; left: 1rem; z-index: 3;")
    out.push(" padding: .5rem .8rem; background: #fff; \}\n")
    out.push(".skip:focus \{ top: 1rem; \}\n")
    out.push("nav \{ border-bottom: 1px solid #d8ded9; background: #fff; \}\n")
    out.push(".nav-inner \{ max-width: 76rem; margin: auto; padding: 1rem 2rem;")
    out.push(" display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap; \}\n")
    out.push(".home \{ font-weight: 750; font-size: 1.1rem; text-decoration: none; \}\n")
    out.push(".package \{ color: #53645e; font-size: .9rem; \}\n")
    out.push(".search \{ position: relative; margin-left: auto; width: min(100%, 22rem); \}\n")
    out.push(".search label \{ display: block; font-size: .8rem; font-weight: 650;")
    out.push(" line-height: 1.3; margin-bottom: .3rem; \}\n")
    out.push("#search \{ width: 100%; min-height: 2.75rem; padding: .55rem .8rem;")
    out.push(" border: 1px solid #a9b9b1; border-radius: .4rem; background: #fff;")
    out.push(" color: inherit; font: inherit; \}\n")
    out.push("#results \{ position: absolute; z-index: 2; top: 100%; width: 100%;")
    out.push(" max-height: 22rem; overflow: auto; margin: .35rem 0 0; padding: .4rem;")
    out.push(" list-style: none; background: #fff; border: 1px solid #d8ded9;")
    out.push(" border-radius: .4rem; box-shadow: 0 12px 25px #172b271c; \}\n")
    out.push("#results:empty \{ display: none; \}\n")
    out.push("#results li \{ padding: .5rem .6rem; border-bottom: 1px solid #edf0ec; \}\n")
    out.push("#results li:last-child \{ border: 0; \}\n")
    out.push("#results a \{ font-weight: 650; \}\n")
    out.push("#results span \{ display: block; color: #53645e; font-size: .85rem; \}\n")
    out.push("main \{ max-width: 74ch; margin: 0 auto; padding: 3rem 1.5rem 6rem; \}\n")
    out.push("h1, h2, h3, h4 \{ font-family: Georgia, serif; line-height: 1.2;")
    out.push(" letter-spacing: -.02em; color: #172b27; \}\n")
    out.push("h1 \{ margin: 0 0 1.4rem; font-size: clamp(2rem, 5vw, 3.4rem); \}\n")
    out.push("h2 \{ margin: 2.5rem 0 .8rem; font-size: 1.55rem; \}\n")
    out.push("h3 \{ margin: 1.5rem 0 .5rem; font-size: 1.2rem; \}\n")
    out.push("h4 \{ margin: 1.5rem 0 .5rem; font-size: 1.05rem; \}\n")
    out.push("p, ul, dl \{ margin-top: 0; \}\n")
    out.push("dt \{ font-weight: 650; margin-top: 1.25rem; \}\n")
    out.push("dd \{ margin: .2rem 0 0; color: #42534d; \}\n")
    out.push("code, pre \{ font-family: ui-monospace, Consolas, monospace; \}\n")
    out.push("code \{ font-size: .92em; \}\n")
    out.push("p code, li code, dd code \{ background: #e9efea; padding: .1em .28em;")
    out.push(" border-radius: .2rem; \}\n")
    out.push("pre \{ overflow-x: auto; padding: 1rem 1.2rem; margin: 1.25rem 0;")
    out.push(" background: #eaf0eb; border-radius: .4rem; line-height: 1.55; \}\n")
    out.push(".decl \{ border-top: 1px solid #d8ded9; margin-top: 2.5rem;")
    out.push(" padding-top: 1.1rem; \}\n")
    out.push(".decl-title \{ margin: 0 0 .5rem; \}\n")
    out.push(".decl .decl \{ margin: 1.25rem 0 0 1.25rem; padding-top: .5rem;")
    out.push(" border-color: #e4e9e4; \}\n")
    out.push(".signature \{ background: transparent; padding: 0; margin: 0 0 .7rem;")
    out.push(" color: #164f48; font-weight: 650; \}\n")
    out.push(".doc > :last-child \{ margin-bottom: 0; \}\n")
    out.push(".deprecated \{ background: #fff1d6; padding: .8rem 1rem; border-radius: .4rem; \}\n")
    out.push("@media (max-width: 40rem) \{ .nav-inner \{ padding: 1rem 1.25rem; \}")
    out.push(" .search \{ margin-left: 0; width: 100%; \} main \{ padding-top: 2rem; \}")
    out.push(" .decl .decl \{ margin-left: .6rem; \} \}\n")
    out.push("</style>\n<script src=\"search.js\" defer></script>\n</head>\n<body>\n")
    out.push("<a class=\"skip\" href=\"#content\">Skip to content</a>\n")
    out.push("<nav aria-label=\"Documentation\"><div class=\"nav-inner\">")
    out.push("<a class=\"home\" href=\"index.html\">Ofir documentation</a>")
    if site.label.len() > 0 {
        out.push(" <span class=\"package\">{escape(site.label)}</span>")
    }
    out.push("\n<div class=\"search\"><label for=\"search\">Search documentation</label>")
    out.push("<input id=\"search\" type=\"search\" placeholder=\"Find a declaration\"")
    out.push(" autocomplete=\"off\" aria-controls=\"results\">")
    out.push("<ul id=\"results\" aria-live=\"polite\"></ul></div></div></nav>\n")
    out.push("<main id=\"content\">\n")
    return out
}

/**
 * The page of a module.
 *
 * @param name the module's name
 * @param src its text
 * @param module its syntax tree
 * @param names the interner of the tree's names
 * @param docs its comments (`comments`)
 * @param site what the pages share
 * @param search the entries of `search.js`, to which its declarations are added
 * @param targets the declarations links can reach, to which its declarations are added
 * @returns the HTML page
 */
pub fn modulePage(name: str, src: str, module: &Module, names: &Interner,
                  docs: move Comments, site: &Site, search: mut str, targets: mut Targets) str {
    let page = Page{src: src.toOwned(), docs, out: head(name, site), module: name.toOwned(),
                    all: site.all, search: "", anchors: []}
    page.out.push("<h1>Module <code>{escape(name)}</code></h1>\n")
    if page.docs.module.len() > 0 {
        const text = renderDoc(page.docs.module, 2)
        page.out.push(text)
    }
    for i in 0..module.items.len() {
        if site.all || module.items[i].isPub {
            page.item(names, &module.items[i])
        }
    }
    page.out.push("</main>\n</body>\n</html>\n")
    search.push(page.search)
    for i in 0..page.anchors.len() {
        targets.add(name, page.anchors[i])
    }
    return page.out
}

/**
 * The index page.
 *
 * @param modules the name of each module, in order
 * @param docs the text of each one's module comment
 * @param site what the pages share
 * @returns the HTML page that links to each module's page, with the first
 *          paragraph of its comment
 */
pub fn indexPage(modules: &List<str>, docs: &List<str>, site: &Site) str {
    const title = if site.label.len() > 0 { site.label.clone() } else { "Modules".toOwned() }
    let out = head(title, site)
    out.push("<h1>{escape(title)}</h1>\n<h2>Modules</h2>\n<dl>\n")
    for i in 0..modules.len() {
        const name = escape(modules[i])
        out.push("<dt><a href=\"{name}.html\"><code>{name}</code></a></dt>\n")
        out.push("<dd>{summary(docs[i])}</dd>\n")
    }
    out.push("</dl>\n</main>\n</body>\n</html>\n")
    return out
}
