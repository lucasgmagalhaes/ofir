fn licenseText() str {
    let data = ""
    data.push("Copyright © 2017 IBM Corp. with Reserved Font Name \"Plex\"\n")
    data.push("\n")
    data.push("This Font Software is licensed under the SIL Open Font License, Version 1.1.\n")
    data.push("\n")
    data.push("This license is copied below, and is also available with a FAQ at: ")
    data.push("http://scripts.sil.org/OFL\n")
    data.push("\n")
    data.push("\n")
    data.push("-----------------------------------------------------------\n")
    data.push("SIL OPEN FONT LICENSE Version 1.1 - 26 February 2007\n")
    data.push("-----------------------------------------------------------\n")
    data.push("\n")
    data.push("PREAMBLE\n")
    data.push("The goals of the Open Font License (OFL) are to stimulate worldwide\n")
    data.push("development of collaborative font projects, to support the font creation\n")
    data.push("efforts of academic and linguistic communities, and to provide a free and\n")
    data.push("open framework in which fonts may be shared and improved in partnership\n")
    data.push("with others.\n")
    data.push("\n")
    data.push("The OFL allows the licensed fonts to be used, studied, modified and\n")
    data.push("redistributed freely as long as they are not sold by themselves. The\n")
    data.push("fonts, including any derivative works, can be bundled, embedded, \n")
    data.push("redistributed and/or sold with any software provided that any reserved\n")
    data.push("names are not used by derivative works. The fonts and derivatives,\n")
    data.push("however, cannot be released under any other type of license. The\n")
    data.push("requirement for fonts to remain under this license does not apply\n")
    data.push("to any document created using the fonts or their derivatives.\n")
    data.push("\n")
    data.push("DEFINITIONS\n")
    data.push("\"Font Software\" refers to the set of files released by the Copyright\n")
    data.push("Holder(s) under this license and clearly marked as such. This may\n")
    data.push("include source files, build scripts and documentation.\n")
    data.push("\n")
    data.push("\"Reserved Font Name\" refers to any names specified as such after the\n")
    data.push("copyright statement(s).\n")
    data.push("\n")
    data.push("\"Original Version\" refers to the collection of Font Software components as\n")
    data.push("distributed by the Copyright Holder(s).\n")
    data.push("\n")
    data.push("\"Modified Version\" refers to any derivative made by adding to, deleting,\n")
    data.push("or substituting -- in part or in whole -- any of the components of the\n")
    data.push("Original Version, by changing formats or by porting the Font Software to a\n")
    data.push("new environment.\n")
    data.push("\n")
    data.push("\"Author\" refers to any designer, engineer, programmer, technical\n")
    data.push("writer or other person who contributed to the Font Software.\n")
    data.push("\n")
    data.push("PERMISSION & CONDITIONS\n")
    data.push("Permission is hereby granted, free of charge, to any person obtaining\n")
    data.push("a copy of the Font Software, to use, study, copy, merge, embed, modify,\n")
    data.push("redistribute, and sell modified and unmodified copies of the Font\n")
    data.push("Software, subject to the following conditions:\n")
    data.push("\n")
    data.push("1) Neither the Font Software nor any of its individual components,\n")
    data.push("in Original or Modified Versions, may be sold by itself.\n")
    data.push("\n")
    data.push("2) Original or Modified Versions of the Font Software may be bundled,\n")
    data.push("redistributed and/or sold with any software, provided that each copy\n")
    data.push("contains the above copyright notice and this license. These can be\n")
    data.push("included either as stand-alone text files, human-readable headers or\n")
    data.push("in the appropriate machine-readable metadata fields within text or\n")
    data.push("binary files as long as those fields can be easily viewed by the user.\n")
    data.push("\n")
    data.push("3) No Modified Version of the Font Software may use the Reserved Font\n")
    data.push("Name(s) unless explicit written permission is granted by the corresponding\n")
    data.push("Copyright Holder. This restriction only applies to the primary font name as\n")
    data.push("presented to the users.\n")
    data.push("\n")
    data.push("4) The name(s) of the Copyright Holder(s) or the Author(s) of the Font\n")
    data.push("Software shall not be used to promote, endorse or advertise any\n")
    data.push("Modified Version, except to acknowledge the contribution(s) of the\n")
    data.push("Copyright Holder(s) and the Author(s) or with their explicit written\n")
    data.push("permission.\n")
    data.push("\n")
    data.push("5) The Font Software, modified or unmodified, in part or in whole,\n")
    data.push("must be distributed entirely under this license, and must not be\n")
    data.push("distributed under any other license. The requirement for fonts to\n")
    data.push("remain under this license does not apply to any document created\n")
    data.push("using the Font Software.\n")
    data.push("\n")
    data.push("TERMINATION\n")
    data.push("This license becomes null and void if any of the above conditions are\n")
    data.push("not met.\n")
    data.push("\n")
    data.push("DISCLAIMER\n")
    data.push("THE FONT SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n")
    data.push("EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO ANY WARRANTIES OF\n")
    data.push("MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT\n")
    data.push("OF COPYRIGHT, PATENT, TRADEMARK, OR OTHER RIGHT. IN NO EVENT SHALL THE\n")
    data.push("COPYRIGHT HOLDER BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY,\n")
    data.push("INCLUDING ANY GENERAL, SPECIAL, INDIRECT, INCIDENTAL, OR CONSEQUENTIAL\n")
    data.push("DAMAGES, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING\n")
    data.push("FROM, OUT OF THE USE OR INABILITY TO USE THE FONT SOFTWARE OR FROM\n")
    data.push("OTHER DEALINGS IN THE FONT SOFTWARE.\n")
    return data
}

/** Writes the bundled fonts and license beside generated documentation pages. */
pub fn writeFonts(out: str) bool {
    const dir = "{out}/fonts"
    if fs.createDirAll(dir).isErr() {
        return false
    }
    if !writeAsset("{dir}/plex-sans.woff2", plexsans()) {
        return false
    }
    if !writeAsset("{dir}/plex-mono.woff2", plexmono()) {
        return false
    }
    return fs.writeString("{dir}/OFL.txt", licenseText()).isOk()
}
