/** Self-hosted IBM Plex font assets for offline documentation (SIL OFL 1.1). */

import std.encoding.base64Decode
import std.fs

fn writeAsset(path: str, encoded: str) bool {
    const Result.Ok(bytes) = base64Decode(encoded) else {
        return false
    }
    return fs.write(path, bytes.asSlice()).isOk()
}

