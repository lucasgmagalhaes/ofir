/**
 * @module
 * `ofir lsp`: a language server (Language Server Protocol 3.17) on
 * standard input and output (docs/design/toolchain.md).
 *
 * The server keeps the text of every open document, with full document
 * synchronization, and checks a document each time it is opened or
 * changed, as `ofir build --stop-after=check` would with the open
 * documents read in place of their files. The diagnostics are published
 * for that document; those located in another file are shown at its first
 * line, with the place they point to. Go to definition checks the
 * document again and looks up the name at the position among the uses the
 * resolver and the type checker recorded. Completion checks the document
 * with a probe, a name no program declares, inserted at the position, and
 * offers the names visible where the probe is reported unknown, with the
 * keywords outside a member access (sema/complete.of).
 */

import base.span.FileId
import base.span.SourceFile
import base.span.SourceMap
import diag.Diagnostic
import diag.NoteKind
import diag.Severity
import diag.jsonString
import lsp.check.checkFile
import lsp.json.JsonDoc
import lsp.json.parseJson
import sema.trace.CompletionKind
import std.io
import std.io.Stdin
import std.os
import std.strings

/**
 * Runs the server until the client sends `exit`.
 *
 * @returns the exit status: 0 after `shutdown`, 1 otherwise
 */
pub fn lspCommand() int {
    let server = Server{docs: Map.new(), uris: Map.new(), shutdown: false}
    let input = io.stdin()
    for true {
        const Option.Some(body) = readMessage(input) else {
            return 1   // the input ended without `exit`
        }
        const Option.Some(doc) = parseJson(body) else {
            send(errorResponse("null", -32700, "the message is not valid JSON"))
            continue
        }
        const method = doc.text(doc.field(0, "method"))
        if method == "exit" {
            return if server.shutdown { 0 } else { 1 }
        }
        server.handle(doc, method)
    }
    return 1
}

struct Server {
    // The text of each open document, by path.
    docs: Map<str, str>
    // The URI of each open document, as the client wrote it, by path.
    uris: Map<str, str>
    shutdown: bool

    fn handle(mut self, doc: JsonDoc, method: str) {
        const idNode = doc.field(0, "id")
        const id = doc.raw(idNode)
        const uri = doc.text(doc.at(["params", "textDocument", "uri"]))
        if method == "initialize" {
            send(response(id, capabilities()))
        } else if method == "shutdown" {
            self.shutdown = true
            send(response(id, "null"))
        } else if method == "textDocument/didOpen" {
            const text = doc.text(doc.at(["params", "textDocument", "text"]))
            self.open(uri, text)
        } else if method == "textDocument/didChange" {
            const changes = doc.elements(doc.at(["params", "contentChanges"]))
            if changes.len() > 0 {
                const text = doc.text(doc.field(changes[changes.len() - 1], "text"))
                self.open(uri, text)
            }
        } else if method == "textDocument/didClose" {
            const path = uriToPath(uri)
            const _ = self.docs.remove(path)
            const _ = self.uris.remove(path)
            send(publish(uri, ""))
        } else if method == "textDocument/definition" {
            const line = doc.int(doc.at(["params", "position", "line"]))
            const character = doc.int(doc.at(["params", "position", "character"]))
            send(response(id, self.definition(uri, line, character)))
        } else if method == "textDocument/completion" {
            const line = doc.int(doc.at(["params", "position", "line"]))
            const character = doc.int(doc.at(["params", "position", "character"]))
            send(response(id, self.completion(uri, line, character)))
        } else if idNode >= 0 && doc.field(0, "method") >= 0 {
            send(errorResponse(id, -32601, "`{method}` is not supported"))
        }
    }

    // Stores a document's text and publishes its diagnostics.
    fn open(mut self, uri: str, text: move str) {
        const path = uriToPath(uri)
        self.docs.insert(path.clone(), text)
        self.uris.insert(path.clone(), uri.toOwned())
        const checked = checkFile(path, &self.docs, "")
        let items = ""
        for i in 0..checked.diags.len() {
            if i > 0 {
                items.push(",")
            }
            items.push(lspDiagnostic(&checked.diags[i], checked.map, path))
        }
        send(publish(uri, items))
    }

    // The location of the declaration of the name at a position, or `null`.
    fn definition(self, uri: str, line: int, character: int) str {
        const path = uriToPath(uri)
        const checked = checkFile(path, &self.docs, "")
        let root = -1
        for f in 0..checked.map.len() {
            if root < 0 && checked.map.file(FileId(f)).path == path {
                root = f
            }
        }
        if root < 0 {
            return "null"
        }
        const offset = offsetOf(checked.map.file(FileId(root)).text, line, character)
        let best = -1
        for i in 0..checked.links.len() {
            const name = checked.links[i].name
            const inside = name.file.0 == root && name.start <= offset && offset <= name.end
            if inside && (best < 0 || name.len() < checked.links[best].name.len()) {
                best = i
            }
        }
        if best < 0 {
            return "null"
        }
        const decl = checked.links[best].decl
        const file = checked.map.file(decl.file)
        const start = position(file, decl.start)
        const end = position(file, decl.end)
        const target = match self.uris.get(file.path) {
            Option.Some(known) => known.clone()
            Option.None => pathToUri(file.path)
        }
        const range = "\{\"start\":{start},\"end\":{end}\}"
        return "\{\"uri\":{jsonString(target)},\"range\":{range}\}"
    }

    // The completions at a position of an open document: a CompletionList.
    fn completion(self, uri: str, line: int, character: int) str {
        const path = uriToPath(uri)
        const text = match self.docs.get(path) {
            Option.Some(open) => open.clone()
            Option.None => {
                return "[]"
            }
        }
        const offset = offsetOf(text, line, character)
        let start = offset
        for start > 0 && isNameByte(text[start - 1]) {
            start -= 1
        }
        const prefix = text.slice(start, offset)
        const member = start > 0 && text[start - 1] == b'.'
        let probed = text.slice(0, offset).toOwned()
        probed.push(PROBE)
        probed.push(text.slice(offset, text.len()))
        let overlays = self.docs.clone()
        overlays.insert(path.clone(), probed)
        const checked = checkFile(path, &overlays, PROBE)
        let found: List<str> = []
        for i in 0..checked.completions.len() {
            const c = &checked.completions[i]
            if c.label.startsWith(prefix) {
                found.push("{c.label} {itemKind(c.kind)}")
            }
        }
        if !member {
            const words = keywords()
            for i in 0..words.len() {
                if words[i].startsWith(prefix) {
                    found.push("{words[i]} 14")
                }
            }
        }
        found.sort()
        let items = ""
        let last = ""
        for i in 0..found.len() {
            const space = found[i].find(" ") ?? 0
            const label = found[i].slice(0, space)
            if label != last {
                if items.len() > 0 {
                    items.push(",")
                }
                const kind = found[i].slice(space + 1, found[i].len())
                items.push("\{\"label\":{jsonString(label)},\"kind\":{kind}\}")
                last = label.toOwned()
            }
        }
        return "\{\"isIncomplete\":false,\"items\":[{items}]\}"
    }
}

// The name inserted where a completion is asked for: no program declares it.
const PROBE: str = "ofirCompletionProbe__"

// The keywords offered outside a member access.
fn keywords() List<str> {
    return ["as", "break", "const", "continue", "copy", "dyn", "else", "enum", "extern", "false",
            "fn", "for", "if", "import", "in", "interface", "let", "match", "mut", "pub", "return",
            "self", "Self", "struct", "true", "unsafe"]
}

// Whether a byte can be part of a name.
fn isNameByte(b: u8) bool {
    return (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z') || (b >= b'0' && b <= b'9') ||
        b == b'_'
}

// The LSP CompletionItemKind of a completion.
fn itemKind(kind: CompletionKind) int {
    return match kind {
        CompletionKind.Variable => 6
        CompletionKind.Function => 3
        CompletionKind.Type => 22
        CompletionKind.Interface => 8
        CompletionKind.Constant => 21
        CompletionKind.Module => 9
        CompletionKind.Variant => 20
        CompletionKind.Field => 5
        CompletionKind.Method => 2
    }
}

// The capabilities of `initialize`: full document synchronization, go to
// definition and completion, asked for again after `.`.
fn capabilities() str {
    const sync = "\"textDocumentSync\":\{\"openClose\":true,\"change\":1\}"
    const definition = "\"definitionProvider\":true"
    const completion = "\"completionProvider\":\{\"triggerCharacters\":[\".\"]\}"
    const info = "\"serverInfo\":\{\"name\":\"ofir\"\}"
    return "\{\"capabilities\":\{{sync},{definition},{completion}\},{info}\}"
}

fn response(id: str, result: str) str {
    return "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":{result}\}"
}

fn errorResponse(id: str, code: int, message: str) str {
    const error = "\{\"code\":{code},\"message\":{jsonString(message)}\}"
    return "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"error\":{error}\}"
}

fn publish(uri: str, items: str) str {
    const params = "\{\"uri\":{jsonString(uri)},\"diagnostics\":[{items}]\}"
    const method = "\"method\":\"textDocument/publishDiagnostics\""
    return "\{\"jsonrpc\":\"2.0\",{method},\"params\":{params}\}"
}

// A diagnostic as an LSP `Diagnostic` of the document `path`.
fn lspDiagnostic(d: &Diagnostic, map: SourceMap, path: str) str {
    let message = d.message.clone()
    const origin = "\{\"line\":0,\"character\":0\}"
    let range = "\{\"start\":{origin},\"end\":{origin}\}"
    if d.span.file.0 >= 0 && d.span.file.0 < map.len() {
        const file = map.file(d.span.file)
        if file.path == path {
            const start = position(file, d.span.start)
            const end = position(file, d.span.end)
            range = "\{\"start\":{start},\"end\":{end}\}"
        } else {
            const at = file.lineCol(d.span.start)
            message = "{file.path}:{at.line}:{at.column}: {message}"
        }
    }
    for i in 0..d.notes.len() {
        const kind = if d.notes[i].kind == NoteKind.Help { "help" } else { "note" }
        message.push("\n{kind}: {d.notes[i].message}")
    }
    const severity = if d.severity == Severity.Error { 1 } else { 2 }
    const fields = "\"severity\":{severity},\"code\":{jsonString(d.code)},\"source\":\"ofir\""
    return "\{\"range\":{range},{fields},\"message\":{jsonString(message)}\}"
}

// An offset of a file as an LSP position: a line from 0 and a column in
// UTF-16 code units.
fn position(file: &SourceFile, offset: int) str {
    const at = file.lineCol(offset)
    const lineStart = offset - (at.column - 1)
    let units = 0
    for i in lineStart..offset {
        const b = file.text[i]
        if b & 0xC0 != 0x80 {
            units += if b >= 0xF0 { 2 } else { 1 }
        }
    }
    return "\{\"line\":{at.line - 1},\"character\":{units}\}"
}

// The offset of an LSP position in a text: the end of the line when the
// column is past it, the end of the text when the line is.
fn offsetOf(text: str, line: int, character: int) int {
    let i = 0
    let l = 0
    for l < line && i < text.len() {
        if text[i] == b'\n' {
            l += 1
        }
        i += 1
    }
    let units = 0
    for i < text.len() && text[i] != b'\n' && units < character {
        units += if text[i] >= 0xF0 { 2 } else { 1 }
        i += 1
        for i < text.len() && text[i] & 0xC0 == 0x80 {
            i += 1
        }
    }
    return i
}

// The `file:` URI of a path, made absolute and percent-encoded.
fn pathToUri(path: str) str {
    let full = path.replace("\\", "/")
    if !full.startsWith("/") && !hasDrive(full) {
        if const Result.Ok(dir) = os.currentDir() {
            const base = dir.replace("\\", "/")
            full = "{base}/{full}"
        }
    }
    const hex = "0123456789ABCDEF"
    let out = "file://"
    if hasDrive(full) {
        out.push("/")   // file:///C:/dir on Windows
    }
    for i in 0..full.len() {
        const b = full[i]
        const letter = (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z')
        const plain = (letter || (b >= b'0' && b <= b'9') || b == b'/' || b == b'-' ||
                       b == b'.' || b == b'_' || b == b'~')
        if plain || (i == 1 && hasDrive(full)) {
            out.pushChar(b as u32)
        } else {
            const v = b as int
            out.push("%")
            out.push(hex.slice(v / 16, v / 16 + 1))
            out.push(hex.slice(v % 16, v % 16 + 1))
        }
    }
    return out
}

// The path of a `file:` URI, percent-decoded.
fn uriToPath(uri: str) str {
    const prefix = "file://"
    const skip = if uri.startsWith(prefix) { prefix.len() } else { 0 }
    const rest = uri.sliceFrom(skip)
    let bytes: List<u8> = []
    let i = 0
    for i < rest.len() {
        if rest[i] == b'%' && i + 2 < rest.len() && hexValue(rest[i + 1]) >= 0 &&
            hexValue(rest[i + 2]) >= 0 {
            bytes.push((hexValue(rest[i + 1]) * 16 + hexValue(rest[i + 2])) as u8)
            i += 3
        } else {
            bytes.push(rest[i])
            i += 1
        }
    }
    const path = strings.fromUtf8(bytes).ok() ?? rest.toOwned()
    if path.startsWith("/") && hasDrive(path.sliceFrom(1)) {
        return path.sliceFrom(1).toOwned()   // /C:/dir on Windows
    }
    return path
}

// Whether `path` starts with a Windows drive, as in `C:/dir`.
fn hasDrive(path: str) bool {
    if path.len() < 2 || path[1] != b':' {
        return false
    }
    const b = path[0]
    return (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z')
}

fn hexValue(b: u8) int {
    if b >= b'0' && b <= b'9' {
        return (b - b'0') as int
    } else if b >= b'a' && b <= b'f' {
        return (b - b'a') as int + 10
    } else if b >= b'A' && b <= b'F' {
        return (b - b'A') as int + 10
    }
    return -1
}

// The body of the next message, or `None` at the end of the input.
fn readMessage(input: mut Stdin) Option<str> {
    let length = -1
    for true {
        let line = ""
        const Result.Ok(n) = input.readLine(line) else {
            return Option.None
        }
        if n == 0 {
            return Option.None
        }
        const header = line.trim()
        if header.len() == 0 {
            break
        }
        const name = "content-length:"
        if header.len() > name.len() && header.slice(0, name.len()).toLower() == name {
            length = headerValue(header.sliceFrom(name.len()).trim())
        }
    }
    if length < 0 {
        return Option.Some("")   // no length: not valid JSON, answered as such
    }
    let body = ""
    for body.len() < length {
        const Result.Ok(part) = input.read(length - body.len()) else {
            return Option.None
        }
        if part.len() == 0 {
            return Option.None
        }
        body.push(part)
    }
    return Option.Some(body)
}

fn headerValue(text: str) int {
    let v = 0
    for i in 0..text.len() {
        if text[i] < b'0' || text[i] > b'9' || v > 1000000000 {
            return -1
        }
        v = v * 10 + (text[i] - b'0') as int
    }
    return if text.len() > 0 { v } else { -1 }
}

// Writes a message with its header.
fn send(body: str) {
    print("Content-Length: {body.len()}\r\n\r\n{body}")
    const _ = io.flush()
}
