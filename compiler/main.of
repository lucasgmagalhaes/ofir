/**
 * @module
 * The stage 1 compiler's entry point (roadmap 4.9): the command line of
 * stage 0 (bootstrap/src/main.c, driver.c).
 *
 *     ofir build <file.of>   compile a program
 *     ofir run <file.of>     compile and run a program
 *     ofir test <file.of>    compile and run the `@test` functions
 *     ofir doc [paths]       write HTML documentation (compiler/doc)
 *     ofir lsp               run the language server (compiler/lsp)
 *     ofir version           print the compiler version
 */

import cli.build.build
import cli.explain.explain
import cli.options.parseOptions
import cli.options.printUsage
import cli.repl.replCommand
import cli.watch.wantsWatch
import cli.watch.watchCommand
import doc.docCommand
import driver.pkg.audit.auditCommand
import driver.pkg.fetch.fetchCommand
import driver.pkg.publish.packageCommand
import driver.pkg.publish.publishCommand
import driver.pkg.publish.yankCommand
import driver.pkg.sbom.sbomCommand
import driver.pkg.search.searchCommand
import driver.pkg.toolchain.installPrefix
import driver.pkg.vendor.vendorCommand
import driver.version.VERSION
import fmt.fmtCommand
import lsp.lspCommand
import std.os

fn main() {
    const args = os.args()
    if args.len() < 2 {
        printUsage()
        os.exit(2)
    }
    const command = args[1].clone()
    if command == "version" {
        println("ofir {VERSION} (stage 1)")
        match installPrefix() {
            Option.Some(prefix) => println("prefix: {prefix}")
            Option.None => {}
        }
        return
    }
    if command == "explain" {
        if args.len() != 3 {
            eprintln("error: `explain` needs one code, as `ofir explain E0600`")
            os.exit(2)
        }
        os.exit(explain(args[2]))
    }
    if command == "fmt" {
        let rest: List<str> = []
        for i in 2..args.len() {
            rest.push(args[i].clone())
        }
        os.exit(fmtCommand(rest))
    }
    if command == "doc" {
        let rest: List<str> = []
        for i in 2..args.len() {
            rest.push(args[i].clone())
        }
        os.exit(docCommand(rest))
    }
    if command == "fetch" || command == "update" {
        let rest: List<str> = []
        for i in 2..args.len() {
            rest.push(args[i].clone())
        }
        os.exit(fetchCommand(rest, command == "update"))
    }
    if command == "package" || command == "publish" || command == "yank" {
        let rest: List<str> = []
        for i in 2..args.len() {
            rest.push(args[i].clone())
        }
        if command == "package" {
            os.exit(packageCommand(rest))
        }
        if command == "publish" {
            os.exit(publishCommand(rest))
        }
        os.exit(yankCommand(rest))
    }
    if command == "vendor" {
        let rest: List<str> = []
        for i in 2..args.len() {
            rest.push(args[i].clone())
        }
        os.exit(vendorCommand(rest))
    }
    if command == "audit" {
        let rest: List<str> = []
        for i in 2..args.len() {
            rest.push(args[i].clone())
        }
        os.exit(auditCommand(rest))
    }
    if command == "search" {
        let rest: List<str> = []
        for i in 2..args.len() {
            rest.push(args[i].clone())
        }
        os.exit(searchCommand(rest))
    }
    if command == "sbom" {
        let rest: List<str> = []
        for i in 2..args.len() {
            rest.push(args[i].clone())
        }
        os.exit(sbomCommand(rest, VERSION))
    }
    if command == "lsp" {
        os.exit(lspCommand())
    }
    if command == "repl" {
        os.exit(replCommand())
    }
    if command == "help" {
        printUsage()
        return
    }
    const known = command == "build" || command == "run" || command == "test"
    const service = command == "check" || command == "metadata"
    if !known && command != "bench" && !service {
        eprintln("error: unknown command `{command}`\n")
        printUsage()
        os.exit(2)
    }
    if command != "metadata" && command != "bench" && wantsWatch(args) {
        os.exit(watchCommand(args))
    }
    const Option.Some(opts) = parseOptions(args) else {
        os.exit(2)
    }
    os.exit(build(opts))
}
