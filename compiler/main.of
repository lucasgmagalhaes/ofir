/**
 * @module
 * The stage 1 compiler's entry point (roadmap 4.9): the command line of
 * stage 0 (bootstrap/src/main.c, driver.c).
 *
 *     ofir build <file.of>   compile a program
 *     ofir run <file.of>     compile and run a program
 *     ofir test <file.of>    compile and run the `@test` functions
 *     ofir doc [paths]       write HTML documentation (compiler/doc)
 *     ofir lsp               run the language server (compiler/lsp)
 *     ofir version           print the compiler version
 */

import air.air.AirBody
import air.air_print.AirPrinter
import air.accumulate.accumulate
import air.fold.foldChecks
import air.interp.evalComptimes
import air.lower.lowerProgram
import air.validate.validateBody
import base.intern.Interner
import base.span.SourceMap
import codegen.llvm.generate
import codegen.llvm.generateUnits
import diag.Diagnostics
import diag.Format
import diag.Severity
import diag.jsonNoSource
import doc.docCommand
import driver.cfg.CfgTarget
import driver.explain.explain
import driver.metadata.metadataJson
import driver.fetch.fetchCommand
import fmt.fmtCommand
import driver.modules.Front
import driver.object_cache
import driver.modules.loadProgram
import lsp.lspCommand
import sema.c_symbols.linkLibraries
import sema.check.Checker
import sema.check.checkProgram
import sema.interface_params.desugarInterfaceParams
import sema.program.Program
import sema.resolve.resolveProgram
import sema.type_trace.traceTypes
import std.fs
import std.mem
import std.os
import syntax.ast_print.printModule
import syntax.lexer.tokenize
import syntax.parser.parse
import syntax.token_print.printTokens

extern "C" {
    fn ofir_now_ns() i64
}

const VERSION: str = "0.5.0"

fn printUsage() {
    eprintln("usage: ofir <command> [arguments]\n\ncommands:\n"
             + "  build <file.of>   compile a program\n"
             + "  run <file.of>     compile and run a program\n"
             + "  test <file.of>    compile and run the `@test` functions\n"
             + "  bench <file.of>   compile with optimizations and time the `@bench` functions\n"
             + "  check <file.of>   check a program for errors, without building it\n"
             + "  metadata <file.of>  print the modules of a program as JSON\n"
             + "  explain <code>    explain an error or warning code, as E0600\n"
             + "  fmt [paths]       format the source files (--check: list those that would "
             + "change; --stdout: print them)\n"
             + "  doc [paths]       write HTML documentation to build/doc (-o: another "
             + "directory; --stdout: print it)\n"
             + "  fetch             fetch the git dependencies and write ofir.lock\n"
             + "  update [name]     choose the newest versions of the git dependencies again\n"
             + "  lsp               run the language server on standard input and output\n"
             + "  version           print the compiler version\n\noptions:\n"
             + "  -o <path>                 output path\n"
             + "  --emit=tokens             print the tokens and stop\n"
             + "  --emit=ast                print the syntax tree and stop\n"
             + "  --emit=names              print what the names resolve to and stop\n"
             + "  --emit=types              print the types of declarations and locals and stop\n"
             + "  --emit=air                print the intermediate representation and stop\n"
             + "  --emit=llvm               write <output>.ll and stop\n"
             + "  --release                 optimize the program (as one LLVM module)\n"
             + "  --codegen-units=1         compile the program as one LLVM module\n"
             + "  -j N, --jobs N            run at most N clang processes (default: the cores)\n"
             + "  --test-jobs N             run at most N tests at once (default: up to 4)\n"
             + "  --no-cache                compile every unit, without the object cache\n"
             + "  -g                        write debug info (DWARF: functions, lines)\n"
             + "  --deny-warnings           treat warnings as errors\n"
             + "  --locked                  fail instead of changing ofir.lock (also fetch)\n"
             + "  --offline                 use only the package cache (also fetch, update)\n"
             + "  --message-format=short    one line per diagnostic\n"
             + "  --message-format=json     one JSON object per diagnostic\n"
             + "  --stop-after=PHASE       run the phases up to lex, parse or check, without "
             + "output\n"
             + "  --time-passes             report the time spent in each phase")
}

/** What the command line asks for. */
struct Options {
    /** `build`, `run`, `test` or `bench`. */
    command: str
    /** The root file. */
    input: str
    /** `-o <path>`. */
    output: Option<str>
    /** `--emit=...`: what to print, or "". */
    emit: str
    /** `--stop-after=...`: the last phase, or "". */
    stopAfter: str
    /** `--release`. */
    release: bool
    /** `-g`. */
    debugInfo: bool
    /** `--deny-warnings`. */
    deny: bool
    /** `--locked`. */
    locked: bool
    /** `--offline`. */
    offline: bool
    /** `--codegen-units=1`: one LLVM module instead of one for each module. */
    oneUnit: bool
    /** `-j N` or `--jobs N`: at most N clang processes; 0 is the number of cores. */
    jobs: int
    /** `--test-jobs N`: at most N concurrent tests; 0 uses up to four cores. */
    testJobs: int
    /** `--no-cache`: neither read nor write the object cache. */
    noCache: bool
    /** `--time-passes`: report compilation phase durations. */
    timePasses: bool
    /** `--message-format=human`, `short` or `json`. */
    format: Format
}

fn parseOptions(args: &List<str>) Option<Options> {
    let opts = Options{command: args[1].clone(), input: "", output: Option.None, emit: "",
                       stopAfter: "", release: false, debugInfo: false, deny: false,
                       locked: false, offline: false, oneUnit: false, jobs: 0, testJobs: 0,
                       noCache: false, timePasses: false,
                       format: Format.Human}
    let hasInput = false
    let i = 2
    for i < args.len() {
        const arg = args[i].clone()
        if arg.startsWith("-") {
            if arg == "-o" && i + 1 < args.len() {
                opts.output = Option.Some(args[i + 1].clone())
                i += 1
            } else if arg.startsWith("--emit=") && knownEmit(arg.sliceFrom(7)) {
                opts.emit = arg.sliceFrom(7).toOwned()
            } else if arg == "--deny-warnings" {
                opts.deny = true
            } else if arg == "--locked" {
                opts.locked = true
            } else if arg == "--offline" {
                opts.offline = true
            } else if (arg == "-j" || arg == "--jobs") && i + 1 < args.len() {
                opts.jobs = parseCount(args[i + 1])
                if opts.jobs == 0 {
                    eprintln("error: `{arg}` needs a positive number, not `{args[i + 1]}`")
                    return Option.None
                }
                i += 1
            } else if arg == "--test-jobs" && i + 1 < args.len() {
                opts.testJobs = parseCount(args[i + 1])
                if opts.testJobs == 0 {
                    eprintln("error: `{arg}` needs a positive number, not `{args[i + 1]}`")
                    return Option.None
                }
                i += 1
            } else if arg == "--no-cache" {
                opts.noCache = true
            } else if arg == "--codegen-units=1" {
                opts.oneUnit = true
            } else if arg == "--release" {
                opts.release = true
            } else if arg == "-g" {
                opts.debugInfo = true
            } else if arg == "--message-format=short" {
                opts.format = Format.Short
            } else if arg == "--message-format=json" {
                opts.format = Format.Json
            } else if arg == "--message-format=human" {
                opts.format = Format.Human
            } else if arg.startsWith("--stop-after=") && knownPhase(arg.sliceFrom(13)) {
                opts.stopAfter = arg.sliceFrom(13).toOwned()
            } else if arg == "--time-passes" {
                opts.timePasses = true
            } else {
                eprintln("error: unknown option `{arg}`")
                return Option.None
            }
        } else if !hasInput {
            // The driver splits paths at `/`.
            opts.input = if onWindows() { arg.replace("\\", "/") } else { arg }
            hasInput = true
        } else {
            eprintln("error: unexpected argument `{arg}`")
            return Option.None
        }
        i += 1
    }
    if !hasInput {
        eprintln("error: `{opts.command}` needs an input file")
        return Option.None
    }
    if opts.command == "bench" {
        opts.release = true   // benchmarks are optimized (spec 12.3)
    }
    return Option.Some(opts)
}

fn knownEmit(what: str) bool {
    return what == "tokens" || what == "ast" || what == "names" || what == "types" ||
           what == "air" || what == "llvm"
}

fn knownPhase(what: str) bool {
    return what == "lex" || what == "parse" || what == "check"
}

fn main() {
    const args = os.args()
    if args.len() < 2 {
        printUsage()
        os.exit(2)
    }
    const command = args[1].clone()
    if command == "version" {
        println("ofir {VERSION} (stage 1)")
        return
    }
    if command == "explain" {
        if args.len() != 3 {
            eprintln("error: `explain` needs one code, as `ofir explain E0600`")
            os.exit(2)
        }
        os.exit(explain(args[2]))
    }
    if command == "fmt" {
        let rest: List<str> = []
        for i in 2..args.len() {
            rest.push(args[i].clone())
        }
        os.exit(fmtCommand(rest))
    }
    if command == "doc" {
        let rest: List<str> = []
        for i in 2..args.len() {
            rest.push(args[i].clone())
        }
        os.exit(docCommand(rest))
    }
    if command == "fetch" || command == "update" {
        let rest: List<str> = []
        for i in 2..args.len() {
            rest.push(args[i].clone())
        }
        os.exit(fetchCommand(rest, command == "update"))
    }
    if command == "lsp" {
        os.exit(lspCommand())
    }
    if command == "help" {
        printUsage()
        return
    }
    const known = command == "build" || command == "run" || command == "test"
    const service = command == "check" || command == "metadata"
    if !known && command != "bench" && !service {
        eprintln("error: unknown command `{command}`\n")
        printUsage()
        os.exit(2)
    }
    const Option.Some(opts) = parseOptions(&args) else {
        os.exit(2)
    }
    os.exit(build(opts))
}

// `ofir test a/b_test.of` tests the module `a/b.of`, which loads its test file.
fn testRoot(opts: &Options) str {
    const input = opts.input.clone()
    const suffix = "_test.of"
    if opts.command != "test" || input.len() <= suffix.len() || !input.endsWith(suffix) {
        return input
    }
    const root = "{input.slice(0, input.len() - suffix.len())}.of"
    return if fs.exists(root) { root } else { input }
}

/** A compilation: what it was asked and what it built. */
struct Pipeline {
    /** The options. */
    opts: Options
    /** The executable, or "" when none was built. */
    exe: str
    /** The names of the `@test` (or `@bench`) functions, for `ofir test` (or `bench`). */
    tests: List<str>
    /** Start of compilation, excluding execution of the compiled program. */
    totalStart: i64
}

fn timerStart(enabled: bool) i64 {
    return if enabled { unsafe { ofir_now_ns() } } else { 0 }
}

fn timerReport(enabled: bool, phase: str, start: i64) {
    if enabled {
        timerReportNanos(phase, unsafe { ofir_now_ns() } - start)
    }
}

fn timerReportNanos(phase: str, nanos: i64) {
    eprintln("time: {phase} {nanos / 1_000_000} ms")
}

// Writes the diagnostics in the requested format.
fn render(diags: Diagnostics, map: SourceMap, format: Format) {
    eprint(diags.render(map, format))
}

// An error of the driver, which points at no source.
fn driverError(format: Format, code: str, message: str) {
    if format == Format.Json {
        eprint(jsonNoSource(Severity.Error, code, message))
    } else {
        eprintln("error[{code}]: {message}")
    }
}

// Runs the phases in order, then the program or its tests. Returns the
// exit status.
fn build(given: move Options) int {
    let opts = given
    const totalStart = timerStart(opts.timePasses)
    opts.input = testRoot(&opts)
    let pipeline = Pipeline{opts: opts.clone(), exe: "", tests: [], totalStart: totalStart}
    let front = Front{map: SourceMap.new(), names: Interner.new(), diags: Diagnostics.new(),
                      overlays: Map.new(), locked: opts.locked, offline: opts.offline}
    front.diags.denyWarnings = opts.deny
    let phaseStart = timerStart(opts.timePasses)
    const Option.Some(file) = front.load(opts.input) else {
        driverError(opts.format, "E0900", "cannot read `{opts.input}`")
        timerReport(opts.timePasses, "total", totalStart)
        return 1
    }
    timerReport(opts.timePasses, "load", phaseStart)
    phaseStart = timerStart(opts.timePasses)
    const tokens = tokenize(front.map.file(file).text, file, front.names, front.diags)
    timerReport(opts.timePasses, "lex", phaseStart)
    if opts.emit == "tokens" {
        print(printTokens(tokens, *front.map.file(file), front.names))
    }
    const lexed = opts.emit == "tokens" || opts.stopAfter == "lex"
    if front.diags.hasErrors() || lexed {
        return finish(front.diags, front.map, &pipeline)
    }
    const names = mem.replace(front.names, Interner.new())
    const diags = mem.replace(front.diags, Diagnostics.new())
    phaseStart = timerStart(opts.timePasses)
    const parsed = parse(file, front.map.file(file).text, tokens, names, diags)
    timerReport(opts.timePasses, "parse", phaseStart)
    front.names = parsed.names
    front.diags = parsed.diags
    if opts.emit == "ast" {
        print(printModule(parsed.module, front.names))
    }
    const done = opts.emit == "ast" || opts.stopAfter == "parse"
    if front.diags.hasErrors() || done {
        return finish(front.diags, front.map, &pipeline)
    }
    const testing = opts.command == "test"
    const benching = opts.command == "bench"
    const target = CfgTarget{os: os.name(), arch: os.arch(), debug: !opts.release, test: testing,
                             bench: benching}
    // Doc tests change the program: not under `--emit`, so that it is stage 0's.
    const docTests = testing && opts.emit == ""
    phaseStart = timerStart(opts.timePasses)
    let program = loadProgram(opts.input, parsed.module, front, target, docTests)
    timerReport(opts.timePasses, "modules", phaseStart)
    if front.diags.hasErrors() {
        return finish(front.diags, front.map, &pipeline)
    }
    if opts.command == "metadata" {
        print(metadataJson(&program, &front.map, VERSION))
        return finish(front.diags, front.map, &pipeline)
    }
    phaseStart = timerStart(opts.timePasses)
    let r = resolveProgram(program, front.names, front.diags, front.map, opts.emit == "names",
                           testing || benching, benching, false, "")
    timerReport(opts.timePasses, "resolve", phaseStart)
    if opts.emit == "names" {
        print(r.trace.out)
        return finish(r.diags, r.map, &pipeline)
    }
    if r.diags.hasErrors() {
        return finish(r.diags, r.map, &pipeline)
    }
    phaseStart = timerStart(opts.timePasses)
    desugarInterfaceParams(program, r)
    let c = checkProgram(program, r)
    timerReport(opts.timePasses, "check", phaseStart)
    if opts.emit == "types" {
        print(traceTypes(c, program))
        return finish(c.r.diags, c.r.map, &pipeline)
    }
    if c.r.diags.hasErrors() || opts.stopAfter == "check" || opts.command == "check" {
        return finish(c.r.diags, c.r.map, &pipeline)
    }
    const ok = backend(c, program, pipeline)
    if !ok && !c.r.diags.hasErrors() {
        render(c.r.diags, c.r.map, opts.format)
        timerReport(opts.timePasses, "total", totalStart)
        return 1
    }
    return finish(c.r.diags, c.r.map, &pipeline)
}

// Stops the compiler on a malformed body (air/validate.of), with the body:
// a compiler bug, reported before it reaches LLVM.
fn validateAir(c: Checker, b: &AirBody, pass: str) {
    if const Option.Some(what) = validateBody(b) {
        let printer = AirPrinter{out: ""}
        printer.body(c, b)
        eprint(printer.out)
        eprintln("note: this is a compiler bug; a report needs the AIR above")
        eprintln("ofir: internal error: invalid AIR after {pass}: {what}")
        os.abort()
    }
}

// Lowers the program, then prints its AIR (`--emit=air`), or writes its
// LLVM IR and links it with clang. Returns false if a step failed.
fn backend(c: mut Checker, program: Program, pipeline: mut Pipeline) bool {
    const opts = pipeline.opts.clone()
    let phaseStart = timerStart(opts.timePasses)
    let l = lowerProgram(c, program)
    if l.unsupported {
        driverError(opts.format, "E0901", "stage 1 does not compile {l.missing} yet")
        return false
    }
    evalComptimes(l, c, program)
    if c.r.diags.hasErrors() {
        return false
    }
    for i in 0..l.out.len() {
        validateAir(c, &l.out[i], "lowering")
        foldChecks(c, l.out[i])
        accumulate(c, l.out[i])
        validateAir(c, &l.out[i], "check folding")
    }
    timerReport(opts.timePasses, "lower", phaseStart)
    for i in 0..l.tests.len() {
        const def = c.def(l.tests[i])
        pipeline.tests.push(testName(c.r.moduleNames[def.module], c.text(def.name)))
    }
    if opts.emit == "air" {
        let printer = AirPrinter{out: ""}
        for i in 0..l.out.len() {
            printer.body(c, &l.out[i])
        }
        print(printer.out)
        return true
    }
    const exe = outputPath(&opts)
    let files: List<str> = []
    let cached: List<str> = []   // where the object of each unit is cached
    // Release builds are one unit: units lose inlining across modules (roadmap 6.6f).
    if opts.emit == "llvm" || opts.oneUnit || opts.release {
        const ll = "{exe}.ll"
        files.push(ll.clone())
        phaseStart = timerStart(opts.timePasses)
        const text = generate(c, program, &l.out, opts.debugInfo, opts.release)
        timerReport(opts.timePasses, "codegen", phaseStart)
        phaseStart = timerStart(opts.timePasses)
        const salt = if opts.noCache || opts.emit == "llvm" {
            "".toOwned()
        } else {
            object_cache.cacheSalt(clangPath(), &codegenFlags(&opts))
        }
        if salt.len() > 0 {
            cached.push(object_cache.objectPath(salt, text))
        }
        if fs.writeString(ll, text).isErr() {
            driverError(opts.format, "E0902", "cannot write `{ll}`")
            return false
        }
        timerReport(opts.timePasses, "cache+write", phaseStart)
    } else {   // a module for each codegen unit (ADR 0033)
        phaseStart = timerStart(opts.timePasses)
        const units = generateUnits(c, program, &l.out, opts.debugInfo, opts.release)
        timerReport(opts.timePasses, "codegen", phaseStart)
        phaseStart = timerStart(opts.timePasses)
        let hashNanos: i64 = 0
        let writeNanos: i64 = 0
        const salt = if opts.noCache || opts.emit == "llvm" || units.len() < 2 {
            "".toOwned()
        } else {
            object_cache.cacheSalt(clangPath(), &codegenFlags(&opts))
        }
        for k in 0..units.len() {
            const hashStart = timerStart(opts.timePasses)
            if salt.len() > 0 {
                cached.push(object_cache.objectPath(salt, units[k].text))
            }
            if opts.timePasses {
                hashNanos += unsafe { ofir_now_ns() } - hashStart
            }
            const ll = "{exe}.{k}.ll"
            files.push(ll.clone())
            const writeStart = timerStart(opts.timePasses)
            if fs.writeString(ll, units[k].text).isErr() {
                driverError(opts.format, "E0902", "cannot write `{ll}`")
                removeFiles(&files)
                return false
            }
            if opts.timePasses {
                writeNanos += unsafe { ofir_now_ns() } - writeStart
            }
        }
        timerReport(opts.timePasses, "cache+write", phaseStart)
        if opts.timePasses {
            timerReportNanos("hash", hashNanos)
            timerReportNanos("write", writeNanos)
        }
    }
    if c.r.diags.hasErrors() {   // the lowering reported errors
        removeFiles(&files)
        return true
    }
    if opts.emit == "llvm" {
        return true
    }
    const linked = link(&opts, &files, &cached, exe.clone(), linkLibraries(c.r, program))
    removeFiles(&files)
    if linked {
        pipeline.exe = exe
    }
    return linked
}

fn removeFiles(files: &List<str>) {
    for i in 0..files.len() {
        const _ = fs.removeFile(files[i])
    }
}

// The executable: `-o`, the input's name without `.of`, or for `run` and
// `test` a file in the temporary directory named after the input's path,
// so that parallel runs do not share it.
fn outputPath(opts: &Options) str {
    if const Option.Some(output) = opts.output {
        return output.clone()
    }
    const input = opts.input.clone()
    let slash = -1
    for i in 0..input.len() {
        if input[i] == b'/' {
            slash = i
        }
    }
    let base = input.sliceFrom(slash + 1).toOwned()
    if base.len() > 3 && base.endsWith(".of") {
        base = base.slice(0, base.len() - 3).toOwned()
    }
    if opts.command == "build" {
        return base
    }
    const full = match fs.canonicalize(input) {
        Result.Ok(path) => path
        Result.Err(_) => input.clone()
    }
    let name = ""
    for i in 0..full.len() {
        const b = full[i]
        const letter = (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z')
        const plain = letter || (b >= b'0' && b <= b'9')
        name.push(if plain { full.slice(i, i + 1) } else { "_" })
    }
    return "{tempDir()}/ofir-{opts.command}-{name}"
}

// Windows sets `OS` to `Windows_NT` in every process.
fn onWindows() bool {
    return match os.env("OS") {
        Option.Some(name) => name == "Windows_NT"
        Option.None => false
    }
}

// `TMPDIR`, then `TEMP` (Windows), then `/tmp`.
fn tempDir() str {
    const names = ["TMPDIR", "TEMP"]
    for i in 0..names.len() {
        if const Option.Some(dir) = os.env(names[i]) {
            if dir.len() > 0 {
                return dir.replace("\\", "/")
            }
        }
    }
    return "/tmp".toOwned()
}

// The runtime library: `OFIR_RUNTIME`, or next to the compiler.
fn runtimeLibrary() Option<str> {
    if const Option.Some(path) = os.env("OFIR_RUNTIME") {
        return Option.Some(path)
    }
    const Result.Ok(exe) = os.executablePath() else {
        return Option.None
    }
    let slash = -1
    for i in 0..exe.len() {
        if exe[i] == b'/' {
            slash = i
        }
    }
    const dir = if slash >= 0 { exe.slice(0, slash).toOwned() } else { ".".toOwned() }
    const places = ["{dir}/../libofir_rt.a", "{dir}/../lib/ofir/libofir_rt.a"]
    for i in 0..places.len() {
        if fs.exists(places[i]) {
            return Option.Some(places[i].clone())
        }
    }
    return Option.None
}

// clang compiles the modules and links them with the runtime and the
// `@link` libraries. The modules have no target triple: clang uses its
// default target. `cached` is empty without the object cache, or holds
// where the object of each unit is cached (ADR 0033).
fn link(opts: &Options, files: &List<str>, cached: &List<str>, exe: str,
        libraries: List<str>) bool {
    let phaseStart = timerStart(opts.timePasses)
    const Option.Some(runtime) = runtimeLibrary() else {
        const message = "cannot find the runtime library libofir_rt.a (set OFIR_RUNTIME)"
        driverError(opts.format, "E0902", message)
        return false
    }
    const clang = clangPath()
    let objects: List<str> = []
    let hits: List<int> = []   // the units whose objects came from the cache
    if files.len() > 1 || cached.len() > 0 {   // compiled apart, then linked (ADR 0033)
        const tag = object_cache.tempTag(exe)
        if !compileUnits(opts, clang, files, cached, tag, objects, hits) {
            timerReport(opts.timePasses, "objects", phaseStart)
            removeObjects(&objects, cached)
            driverError(opts.format, "E0902", "clang failed to compile the generated code")
            return false
        }
    }
    timerReport(opts.timePasses, "objects", phaseStart)
    phaseStart = timerStart(opts.timePasses)
    let inputs = if objects.len() > 0 { objects.clone() } else { files.clone() }
    let ok = linkObjects(opts, clang, &inputs, runtime, &libraries, exe, hits.len() > 0)
    if !ok && hits.len() > 0 {   // a cached object may be bad: compile those units again
        let again: List<str> = []
        let fresh: List<str> = []
        for i in 0..hits.len() {
            const _ = fs.removeFile(objects[hits[i]])
            again.push(files[hits[i]].clone())
        }
        const noCache: List<str> = []
        let none: List<int> = []
        ok = compileUnits(opts, clang, &again, &noCache, "", fresh, none)
        for i in 0..hits.len() {
            if i < fresh.len() {
                objects[hits[i]] = fresh[i].clone()
            }
        }
        if ok {
            ok = linkObjects(opts, clang, &objects, runtime, &libraries, exe, false)
        }
        removeFiles(&fresh)
    }
    timerReport(opts.timePasses, "link", phaseStart)
    removeObjects(&objects, cached)
    if !ok {
        driverError(opts.format, "E0902", "clang failed to compile the generated code")
    } else if cached.len() > 0 && hits.len() < cached.len() {   // objects were added
        object_cache.prune()
    }
    return ok
}

// The clang program: `OFIR_CLANG`, or `clang`.
fn clangPath() str {
    if const Option.Some(name) = os.env("OFIR_CLANG") {
        if name.len() > 0 {
            return name
        }
    }
    return "clang".toOwned()
}

// Removes the objects that are not in the cache.
fn removeObjects(objects: &List<str>, cached: &List<str>) {
    for i in 0..objects.len() {
        if i >= cached.len() || objects[i] != cached[i] {
            const _ = fs.removeFile(objects[i])
        }
    }
}

// The final clang call. With `quiet`, a failure prints nothing: the
// caller tries again.
fn linkObjects(opts: &Options, clang: str, inputs: &List<str>, runtime: str,
               libraries: &List<str>, exe: str, quiet: bool) bool {
    let compiles = false
    for i in 0..inputs.len() {
        compiles = compiles || inputs[i].endsWith(".ll")
    }
    // A link of objects only would warn that the code generation flags are unused.
    let args = if compiles { codegenFlags(opts) } else { clangFlags(opts) }
    for i in 0..inputs.len() {
        args.push(inputs[i].clone())
    }
    args.push(runtime.toOwned())
    for i in 0..libraries.len() {
        args.push("-l{libraries[i]}")
    }
    args.push("-lm".toOwned())
    // MinGW keeps the pthread functions in winpthreads.
    if onWindows() {
        args.push("-lpthread".toOwned())
    }
    args.push("-o".toOwned())
    args.push(exe.toOwned())
    // The main thread gets the 8 MiB stack Linux gives it.
    if onWindows() {
        args.push("-Wl,--stack,8388608".toOwned())
    }
    return match os.spawn(clang, args) {
        Result.Ok(child) => finishClang(opts, clang, child, quiet)
        Result.Err(_) => {
            driverError(opts.format, "E0902", "cannot run `{clang}`")
            false
        }
    }
}

// The clang flags of both compiling and linking: the optimization level,
// debug info and, on Windows, MinGW rather than MSVC.
fn clangFlags(opts: &Options) List<str> {
    const level = if opts.release { "-O2" } else { "-O0" }
    let args = [level.toOwned(), "-Wno-override-module".toOwned()]
    if opts.debugInfo {
        args.push("-g".toOwned())
    }
    if onWindows() {
        args.push("--target=x86_64-w64-windows-gnu".toOwned())
    }
    return args
}

// The clang flags of a call that generates code: `clangFlags` and, in a debug
// build, the linear pre-register-allocation scheduler, which is about 40%
// faster at -O0 on large functions (ADR 0054).
fn codegenFlags(opts: &Options) List<str> {
    let args = clangFlags(opts)
    if !opts.release {
        args.push("-mllvm".toOwned())
        args.push("-pre-RA-sched=linearize".toOwned())
    }
    return args
}

// Compiles each unit to its object, with at most `-j N` clang processes
// running, and pushes the objects to `objects`. A unit whose object is in
// the cache is not compiled, and its index goes to `hits`; another is
// compiled to a temporary name in the cache and renamed into place. The
// processes are waited for in the order they started, so their output
// comes in the order of the units. After a failure no more are started,
// and the running ones are waited for.
fn compileUnits(opts: &Options, clang: str, files: &List<str>, cached: &List<str>, tag: str,
                objects: mut List<str>, hits: mut List<int>) bool {
    const jobs = if opts.jobs > 0 { opts.jobs } else { os.cpuCount() }
    let running: List<os.Child> = []
    let units: List<int> = []   // the unit of each running process
    let ok = true
    let next = 0
    for (ok && next < files.len()) || running.len() > 0 {
        if ok && next < files.len() && running.len() < jobs {
            const k = next
            next += 1
            const local = "{files[k].slice(0, files[k].len() - 3)}.o"
            if k >= cached.len() {
                objects.push(local)
            } else if object_cache.useObject(cached[k]) {
                objects.push(cached[k].clone())
                hits.push(k)
                continue
            } else {
                const _ = fs.createDirAll(parentDir(cached[k]))
                objects.push("{cached[k]}.{tag}.tmp")
            }
            let args = codegenFlags(opts)
            args.push("-c".toOwned())
            args.push(files[k].clone())
            args.push("-o".toOwned())
            args.push(objects[k].clone())
            match os.spawn(clang, args) {
                Result.Ok(child) => {
                    running.push(child)
                    units.push(k)
                }
                Result.Err(_) => {
                    driverError(opts.format, "E0902", "cannot run `{clang}`")
                    ok = false
                }
            }
        } else {
            const child = running.remove(0)
            const k = units.remove(0)
            if !finishClang(opts, clang, child, false) {
                ok = false
            } else if k < cached.len() {   // into the cache; the temporary name if that fails
                if fs.rename(objects[k], cached[k]).isOk() {
                    objects[k] = cached[k].clone()
                }
            }
        }
    }
    return ok
}

// The directory of a path: what comes before its last `/`.
fn parentDir(path: str) str {
    let slash = 0
    for i in 0..path.len() {
        if path[i] == b'/' {
            slash = i
        }
    }
    return path.slice(0, slash).toOwned()
}

// Waits for a clang process and passes its output on, unless `quiet`.
fn finishClang(opts: &Options, clang: str, child: move os.Child, quiet: bool) bool {
    return match child.wait() {
        Result.Ok(out) => {
            if !quiet || out.status == 0 {
                print(out.stdout)
                eprint(out.stderr)
            }
            out.status == 0
        }
        Result.Err(_) => {
            driverError(opts.format, "E0902", "cannot run `{clang}`")
            false
        }
    }
}

// A positive count written in decimal, or 0.
fn parseCount(text: str) int {
    if text.isEmpty() || text.len() > 6 {
        return 0
    }
    let n = 0
    for b in text.bytes() {
        if b < 48 || b > 57 {
            return 0
        }
        n = n * 10 + (b as int) - 48
    }
    return n
}

// Runs a program, its output passed on; returns its exit status.
fn runProgram(exe: str, args: [str]) int {
    return match os.run(exe, args) {
        Result.Ok(out) => {
            print(out.stdout)
            eprint(out.stderr)
            const status = if out.status < 0 { 1 } else { out.status }
            status
        }
        Result.Err(_) => {
            eprintln("error[E0902]: cannot run `{exe}`")
            1
        }
    }
}

// What `ofir test` calls a test: `module.name`, or for a doc test
// (`driver.modules.addDocTests`) the module and the line of the block.
fn testName(module: str, name: str) str {
    if !module.startsWith("doc:") {
        return "{module}.{name}"
    }
    const block = module.sliceFrom(4)
    if name == "compiled" {
        return "{block} (doc test, not run)"
    }
    return "{block} (doc test)"
}

// A started test, with its output passed on in test declaration order.
fn waitTest(exe: str, child: move os.Child) int {
    return match child.wait() {
        Result.Ok(out) => {
            print(out.stdout)
            eprint(out.stderr)
            const status = if out.status < 0 { 1 } else { out.status }
            status
        }
        Result.Err(_) => {
            eprintln("error[E0902]: cannot run `{exe}`")
            1
        }
    }
}

// Each test runs in its own process. Up to `jobs` run together, while their
// captured output is reported in declaration order. A `no_run` doc test was
// only compiled.
fn runTests(exe: str, tests: &List<str>, testJobs: int) int {
    const cores = os.cpuCount()
    const jobs = if testJobs > 0 { testJobs } else if cores < 4 { cores } else { 4 }
    let pending: List<Option<os.Child>> = []
    let next = 0
    let failed = 0
    for i in 0..tests.len() {
        for next < tests.len() && pending.len() < jobs {
            if tests[next].endsWith("(doc test, not run)") {
                pending.push(Option.None)
            } else {
                pending.push(match os.spawn(exe, ["{next}"]) {
                    Result.Ok(child) => Option.Some(child)
                    Result.Err(_) => Option.None
                })
            }
            next += 1
        }
        print("test {tests[i]} ... ")
        const child = pending.remove(0)
        if tests[i].endsWith("(doc test, not run)") {
            println("ok")
            continue
        }
        const status = match child {
            Option.Some(started) => waitTest(exe, started)
            Option.None => {
                eprintln("error[E0902]: cannot run `{exe}`")
                1
            }
        }
        if status == 0 {
            println("ok")
        } else {
            println("FAILED (exit status {status})")
            failed += 1
        }
    }
    println("\n{tests.len()} tests: {tests.len() - failed} passed, {failed} failed")
    return if failed > 0 { 1 } else { 0 }
}

// `ofir bench` (spec 12.3): each benchmark in its own process, which prints
// its time.
fn runBenches(exe: str, benches: &List<str>) int {
    let failed = 0
    for i in 0..benches.len() {
        print("bench {benches[i]} ... ")
        const status = runProgram(exe, ["{i}"])
        if status != 0 {
            println("FAILED (exit status {status})")
            failed += 1
        }
    }
    println("\n{benches.len()} benchmarks: {benches.len() - failed} ran, {failed} failed")
    return if failed > 0 { 1 } else { 0 }
}

// The diagnostics, then the program or its tests.
fn finish(diags: Diagnostics, map: SourceMap, pipeline: &Pipeline) int {
    render(diags, map, pipeline.opts.format)
    timerReport(pipeline.opts.timePasses, "total", pipeline.totalStart)
    if diags.hasErrors() {
        return 1
    }
    if pipeline.exe.len() == 0 {
        return 0
    }
    let status = 0
    if pipeline.opts.command == "run" {
        const empty: List<str> = []
        status = runProgram(pipeline.exe, empty)
    } else if pipeline.opts.command == "test" {
        status = runTests(pipeline.exe, &pipeline.tests, pipeline.opts.testJobs)
    } else if pipeline.opts.command == "bench" {
        status = runBenches(pipeline.exe, &pipeline.tests)
    }
    if pipeline.opts.output.isNone() && pipeline.opts.command != "build" {
        const _ = fs.removeFile(pipeline.exe)
    }
    return status
}
