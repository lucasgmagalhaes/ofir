/**
 * Whether a type has values: false for (), ! and the error type.
 *
 * @param ty the type
 * @returns true if it does
 */
pub fn typeIsValue(ty: int) bool {
    return ty != UNIT && ty != NEVER && ty != ERROR
}

fn flagsOf(c: Checker, e: &Expr) int {
    return match c.moveFlags[c.module()].get(e.id.0) {
        Option.Some(f) => *f
        Option.None => 0
    }
}

fn tempValue(l: mut Lowerer, ty: int, value: move Rvalue) Operand {
    return opCopy(emitTemp(l, ty, value), ty)
}

fn unit() Operand {
    return opUnit(UNIT)
}

// ---------------------------------------------------------------------------
// Places

// The field of `a.f`, or -1 for a variant, a constant or an error.
fn fieldOf(c: Checker, e: &Expr) int {
    return match e.kind {
        ExprKind.Field(base, _, _) => {
            if typeNameOf(c, &*base) != 0 {
                -1
            } else {
                c.members[c.module()][e.id.0]
            }
        }
        _ => -1
    }
}

// `m.x`, a declaration of an imported module: the resolver knows it.
fn moduleMember(c: Checker, e: &Expr) bool {
    const Res.Def(id) = c.res(e.id.0) else {
        return false
    }
    return c.def(id).kind != DefKind.Module
}

fn derefCount(c: Checker, e: &Expr) int {
    return match c.derefs[c.module()].get(e.id.0) {
        Option.Some(steps) => steps.len()
        Option.None => 0
    }
}

// The type before the `i`th implicit dereference of `e`.
fn stepType(c: Checker, e: &Expr, i: int) int {
    return match c.derefs[c.module()].get(e.id.0) {
        Option.Some(steps) => steps[i]
        Option.None => c.typeOf(e.id.0)
    }
}

fn coerced(c: Checker, e: &Expr) bool {
    return c.sliceCoercions[c.module()].get(e.id.0).isSome() ||
           c.arrayCoercions[c.module()].get(e.id.0).isSome()
}

fn noPlace() Place {
    return Place{local: 0, fields: [], deref: false}
}

// Stage 0 rewrites `b`, a box, into `b.ptr` where it dereferences it: the
// pointer field of `e` dereferenced `depth` times.
fn boxPointer(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, depth: int) Operand {
    let place = lowerPlaceAt(l, c, p, e, depth)
    place.fields.push(0)
    const ptr = structFieldType(c, p, viewType(c, e, depth), 0)
    return placeOperand(&place, OperandKind.Copy, ptr)
}

// `*e`, the `depth`th implicit dereference of `e`: the value is the address
// of the place.
fn derefPlace(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, depth: int) Place {
    const value = if boxInner(c, stepType(c, e, depth - 1)).isSome() {
        boxPointer(l, c, p, e, depth - 1)
    } else {
        lowerView(l, c, p, e, depth - 1)
    }
    return Place{local: toLocal(l, value), fields: [], deref: true}
}

// The place of `e` dereferenced `depth` times.
fn lowerPlaceAt(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, depth: int) Place {
    if depth > 0 {
        return derefPlace(l, c, p, e, depth)
    }
    if const Res.Def(id) = c.res(e.id.0) {   // `COUNTER` or `lib.COUNTER`
        if c.def(id).kind == DefKind.Global {
            return globalPlace(l, c, id)
        }
    }
    match e.kind {
        ExprKind.Field(base, _, _) => {
            const field = fieldOf(c, e)
            if field >= 0 {
                let place = lowerPlace(l, c, p, &*base)
                place.fields.push(field)
                return place
            }
        }
        ExprKind.TupleField(base, index) => {
            let place = lowerPlace(l, c, p, &*base)
            place.fields.push(index as int)
            return place
        }
        ExprKind.Unary(op, operand) => {
            if op == Op.Deref {   // `*p`: the pointer's value is the address of the place
                const value = if boxInner(c, viewType(c, &*operand, -1)).isSome() {
                    boxPointer(l, c, p, &*operand, derefCount(c, &*operand))
                } else {
                    lowerExpr(l, c, p, &*operand)
                }
                return Place{local: toLocal(l, value), fields: [], deref: true}
            }
        }
        ExprKind.Index(base, index) => {
            if isList(c, viewType(c, &*base, -1)) {   // `l[i].x`: from the element's address
                return listIndexPlace(l, c, p, e, &*base, &*index)
            }
            if isArray(c, viewType(c, &*base, -1)) {
                return arrayIndexPlace(l, c, p, e, &*base, &*index)
            }
            if isKeyIndex(c, &*index) {
                let place = lowerPlace(l, c, p, &*base)
                place.fields.push(keyStep(c, &*base, &*index))
                return place
            }
        }
        ExprKind.Ident(_) | ExprKind.SelfValue => {
            if const Res.Local(id) = c.res(e.id.0) {
                const local = id + 1
                return Place{local: local, fields: [], deref: l.body.locals[local].byRef}
            }
        }
        _ => {}
    }
    const local = toLocal(l, lowerView(l, c, p, e, 0))   // `e` itself, at this depth
    return Place{local: local, fields: [], deref: false}
}

// `value[key]` with a key parameter: a field chosen for each instance.
fn isKeyIndex(c: Checker, index: &Expr) bool {
    return c.types.kind(c.typeOf(index.id.0)) == TyKind.Param
}

fn isList(c: Checker, ty: int) bool {
    const t = c.types.get(ty)
    return t.kind == TyKind.Adt && t.data != 0 && (t.data == c.r.langItems[1] ||
                                             t.data == c.r.langItems[4] ||
                                             t.data == c.r.langItems[7])
}

/**
 * The place of `e`, with its implicit dereferences: a local and a field
 * path. A root that is not a variable, as in `make().x`, is evaluated into
 * a temporary first.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param e the expression
 * @returns its place
 */
pub fn lowerPlace(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr) Place {
    if coerced(c, e) {   // a call: its value is a temporary
        return localPlace(toLocal(l, lowerExpr(l, c, p, e)))
    }
    return lowerPlaceAt(l, c, p, e, derefCount(c, e))
}

// The local and field path of a place expression; -1 if not a local's.
fn placePath(c: mut Checker, e: &Expr, path: mut List<int>) int {
    if derefCount(c, e) > 0 {
        return -1   // a dereference, not a local
    }
    match e.kind {
        ExprKind.Field(base, _, _) => {
            const field = fieldOf(c, e)
            if field < 0 {
                return -1
            }
            const local = placePath(c, &*base, path)
            if path.len() < 7 {
                path.push(field)
            }
            return local
        }
        ExprKind.TupleField(base, index) => {
            const local = placePath(c, &*base, path)
            if path.len() < 7 {
                path.push(index as int)
            }
            return local
        }
        ExprKind.Index(base, index) => {
            if !isKeyIndex(c, &*index) {
                return -1
            }
            const local = placePath(c, &*base, path)
            if path.len() < 7 {
                path.push(keyStep(c, &*base, &*index))
            }
            return local
        }
        ExprKind.Ident(_) | ExprKind.SelfValue => {
            return match c.res(e.id.0) {
                Res.Local(id) => id + 1
                _ => -1
            }
        }
        _ => {
            return -1
        }
    }
}

// Reads a variable now when `next`, evaluated after it, could assign to it
// (a block or an `if`): evaluation is left to right (spec 4.10).
fn settle(l: mut Lowerer, value: move Operand, next: &Expr) Operand {
    const mayAssign = match next.kind {
        ExprKind.Block(_) | ExprKind.If(_, _, _, _) | ExprKind.Unsafe(_) => true
        _ => false
    }
    if !mayAssign || value.kind != OperandKind.Copy {
        return value
    }
    const ty = value.ty
    return opCopy(emitTemp(l, ty, rvUse(value)), ty)
}

// ---------------------------------------------------------------------------
// Temporaries

// The expressions that make a new value (and those that pass on the value
// of their last expression: `if`, `match`, blocks).
fn makesValue(c: Checker, e: &Expr) bool {
    return match e.kind {
        ExprKind.Call(_, _) | ExprKind.Interp(_, _) | ExprKind.Struct(_, _, _) | ExprKind.Array(_) |
        ExprKind.Repeat(_, _) |
        ExprKind.Tuple(_) | ExprKind.Variant(_, _, _) | ExprKind.Try(_) | ExprKind.If(_, _, _, _) |
        ExprKind.Match(_, _) |
        ExprKind.Block(_) | ExprKind.Unsafe(_) => true
        ExprKind.Binary(op, _, _) => op == Op.Add || op == Op.Coalesce
        ExprKind.Index(_, index) => match index.kind {   // `xs[a..b]` is `xs.slice(a, b)`
            ExprKind.Range(_, _, _) => true
            _ => false
        }
        ExprKind.Field(base, _, _) => typeNameOf(c, &*base) != 0
        _ => false
    }
}

// A new value no one consumes: dropped at the end of the full expression.
fn ownTemp(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr,
           value: move Operand) Operand {
    const forwarded = l.forward
    l.forward = false
    const consumed = (flagsOf(c, e) & CONSUMED) != 0
    if forwarded || consumed || !makesValue(c, e) || l.tempScopes.len() == 0 ||
       isGlue(l.body.def) || value.kind == OperandKind.Unit {
        return value
    }
    const ty = concreteType(l, c, c.typeOf(e.id.0))
    if !needsDrop(l, c, p, ty) {
        return value
    }
    const vty = value.ty
    const local = toLocal(l, value)
    l.temps.push(Temp{local: local, ty: ty})
    return opCopy(local, vty)
}

// ---------------------------------------------------------------------------
// Expressions

/**
 * Lowers an expression to an operand.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param e the expression
 * @returns its value
 */
pub fn lowerExpr(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr) Operand {
    if coerced(c, e) {
        return coercion(l, c, p, e)
    }
    if dynSourceType(c, e) >= 0 {
        return dynCoercion(l, c, p, e)
    }
    if unionSourceType(c, e) >= 0 {
        return unionCoercion(l, c, p, e)
    }
    return lowerView(l, c, p, e, derefCount(c, e))
}

// `e` dereferenced `depth` times.
fn lowerView(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, depth: int) Operand {
    if depth > 0 {   // `*e`: a place reached through the pointer
        l.forward = false
        const place = derefPlace(l, c, p, e, depth)
        l.forward = false
        return placeOperand(&place, OperandKind.Copy, viewType(c, e, depth))
    }
    const forwarded = l.forward   // only for `e` itself, not its parts
    l.forward = false
    const value = lowerKind(l, c, p, e)
    if (flagsOf(c, e) & MOVES) != 0 {   // the local's value is moved out: it is not dropped
        let path: List<int> = []
        const local = placePath(c, e, path)
        if local >= 0 {
            noteMoved(l, c, local, &path)
        }
    }
    l.forward = forwarded
    return ownTemp(l, c, p, e, value)
}

fn lowerKind(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr) Operand {
    const ty = c.typeOf(e.id.0)
    return match e.kind {
        ExprKind.Int(value) => {
            const concrete = concreteType(l, c, ty)   // `0` as a narrowed `T` (spec 15.3)
            if c.types.kind(concrete) == TyKind.Float {   // `let x: float = 0`
                opFloat(value as float, concrete)
            } else {
                opInt(value, ty)
            }
        }
        ExprKind.Float(value) => opFloat(value, ty)
        ExprKind.Byte(value) => opInt(value as u64, ty)
        ExprKind.Bool(value) => opBool(value, BOOL)
        ExprKind.Str(value) | ExprKind.ByteStr(value) => opStr(value, ty)
        ExprKind.Interp(parts, specs) => interpolation(l, c, p, &parts, &specs)
        ExprKind.Ident(_) | ExprKind.SelfValue => name(l, c, p, e, ty)
        ExprKind.Unary(op, operand) => unary(l, c, p, e, op, &*operand, ty)
        ExprKind.Binary(op, lhs, rhs) => binary(l, c, p, e, op, &*lhs, &*rhs)
        ExprKind.Cast(value, _) => castExpr(l, c, p, &*value, ty, e.span)
        ExprKind.Call(callee, args) => match comptimeMemberValue(l, c, p, e, ty) {
            Option.Some(value) => value
            Option.None => call(l, c, p, e, &*callee, &args)
        }
        ExprKind.If(_, _, _, _) => lowerIf(l, c, p, e)
        ExprKind.Comptime(inner) => comptimeExpr(l, c, p, e, &*inner)
        ExprKind.Block(block) | ExprKind.Unsafe(block) => lowerBlock(l, c, p, &block,
                                                                     typeIsValue(ty))
        ExprKind.Field(base, member, _) => {
            if const Option.Some(value) = comptimeMemberValue(l, c, p, e, ty) {
                return value   // `field.name`, `field.index`
            }
            if moduleMember(c, e) {   // `u.LIMIT`
                name(l, c, p, e, ty)
            } else if fieldOf(c, e) >= 0 {
                placeOperand(&lowerPlaceAt(l, c, p, e, 0), OperandKind.Copy, ty)
            } else if primitiveName(c, &*base) >= 0 {
                builtinConst(c, ty, member)
            } else {   // `Shape.Empty`
                const none: List<Arg> = []
                buildVariant(l, c, p, ty, c.members[c.module()][e.id.0], &none)
            }
        }
        ExprKind.TupleField(_, _) => placeOperand(&lowerPlaceAt(l, c, p, e, 0), OperandKind.Copy,
                                                  ty)
        ExprKind.Struct(_, fields, base) => structLiteral(l, c, p, e, &fields, base, ty)
        ExprKind.Tuple(elems) => {
            if elems.len() == 0 {
                unit()   // `()`
            } else {
                aggregateOf(l, c, p, &elems, ty)
            }
        }
        ExprKind.Variant(_, args, _) => if c.types.kind(ty) == TyKind.Key {
            opUnit(ty)   // a key has no value (spec 16.2)
        } else {
            buildVariant(l, c, p, ty, c.members[c.module()][e.id.0], &args)
        }
        ExprKind.Array(elems) => if isArray(c, ty) { arrayLiteral(l, c, p, &elems, ty) } else {
            listLiteral(l, c, p, &elems, ty)
        }
        ExprKind.Repeat(value, count) => if isArray(c, ty) {
            arrayRepeat(l, c, p, &*value, ty)
        } else {
            listRepeat(l, c, p, &*value, &*count, ty)
        }
        ExprKind.Try(inner) => lowerTry(l, c, p, &*inner, ty)
        ExprKind.Match(_, _) => lowerMatch(l, c, p, e)
        ExprKind.Index(base, index) => lowerIndex(l, c, p, e, &*base, &*index)
        ExprKind.Closure(params, _, body, isMove) => lowerClosure(l, c, p, e, &params, &*body,
                                                                  isMove, ty)
        _ => {
            l.fail("this expression")
            unit()
        }
    }
}

fn constOperand(c: Checker, id: int, ty: int) Operand {
    return match c.info[id].value {
        Option.Some(v) => match v.kind {
            ConstKind.Int => opInt(v.bits, ty)
            ConstKind.Float => opFloat(v.f, ty)
            ConstKind.Bool => opBool(v.b, BOOL)
            ConstKind.Str => opStr(v.s, ty)
        }
        Option.None => unit()
    }
}

fn name(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, ty: int) Operand {
    if const Option.Some(param) = c.constUses.get(c.module() * 4294967296 + e.id.0) {
        const arg = concreteType(l, c, *param)   // `N` (spec 8.7)
        return opInt(c.types.get(arg).data.wrappingCast<u64>(), ty)
    }
    const Res.Def(id) = c.res(e.id.0) else {
        return placeOperand(&lowerPlaceAt(l, c, p, e, 0), OperandKind.Copy, ty)
    }
    const kind = c.def(id).kind
    if kind == DefKind.Const {   // evaluated by the checker
        if c.info[id].value.isNone() {
            return comptimeConst(l, c, p, id, ty)
        }
        return constOperand(c, id, ty)
    }
    if kind == DefKind.Variant {   // `None`
        const none: List<Arg> = []
        return buildVariant(l, c, p, ty, c.def(id).member, &none)
    }
    if kind == DefKind.Fn {   // a function value with no environment
        let rv = rvalue(RvalueKind.FnValue, Op.Add, unit(), unit())
        rv.flag = id
        return tempValue(l, ty, rv)
    }
    if kind == DefKind.Global {
        return placeOperand(&globalPlace(l, c, id), OperandKind.Copy, ty)
    }
    c.error("E0901", e.span, "global variables are not supported yet".toOwned())
    return unit()
}

// `const X = comptime f()` (spec 15.1): its initializer, run by the
// interpreter at each use, in the constant's module.
fn comptimeConst(l: mut Lowerer, c: mut Checker, p: Program, id: int, ty: int) Operand {
    const saved = c.enter(c.def(id).module)
    let out = unit()
    match itemOf(p, c.loc(id)).kind {
        ItemKind.Const(_, value) => match value.kind {
            ExprKind.Comptime(inner) => {
                out = comptimeExpr(l, c, p, &value, &*inner)
            }
            _ => {}
        }
        _ => {}
    }
    c.enter(saved)
    return out
}

// The mutable global `id`: the place its address points to (spec 11.5).
fn globalPlace(l: mut Lowerer, c: mut Checker, id: int) Place {
    let rv = rvalue(RvalueKind.GlobalAddr, Op.Add, unit(), unit())
    rv.flag = id
    const addr = tempValue(l, c.types.ptr(c.info[id].ty, true), rv)
    return Place{local: toLocal(l, addr), fields: [], deref: true}
}

// ---------------------------------------------------------------------------
// Calls

fn call(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, callee: &Expr,
        args: &List<Arg>) Operand {
    const isName = match callee.kind {
        ExprKind.Ident(_) | ExprKind.Generic(_, _) => true
        _ => false
    }
    if !isName {
        return methodCall(l, c, p, e, callee, args)
    }
    return nameCall(l, c, p, e, callee, args)
}

// A call of a name: a function, a constructor, a variant or a built-in.
fn nameCall(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, callee: &Expr,
            args: &List<Arg>) Operand {
    const Res.Def(id) = c.res(callee.id.0) else {
        return valueCall(l, c, p, e, callee, args)
    }
    const kind = c.def(id).kind
    if kind == DefKind.Struct {
        let values: List<Expr> = []
        for i in 0..args.len() {
            values.push(args[i].value.clone())
        }
        return aggregateOf(l, c, p, &values, c.typeOf(e.id.0))
    }
    if kind == DefKind.Variant {   // `Some(x)`
        return buildVariant(l, c, p, c.typeOf(e.id.0), c.def(id).member, args)
    }
    if kind == DefKind.Builtin {
        const which = c.def(id).primitive
        if which == 2 {
            panicAssert(l, c, p, e, &args[0].value, which == 2)
        } else {
            lowerPrint(l, c, p, &args[0].value, which == 1)
        }
        return unit()
    }
    return emitUserCall(l, c, p, e, id, args, Option.None)
}

// ---------------------------------------------------------------------------
// Intrinsics (stage 0: lower_intrinsic.c), the operations of the
// `extern "intrinsic"` blocks of std (ADR 0019)

fn callTypeArg(c: Checker, e: &Expr) int {
    const targs = match c.callTypeArgs[c.module()].get(e.id.0) {
        Option.Some(t) => *t
        Option.None => UNIT
    }
    return if targs == UNIT { ERROR } else { c.types.get(targs).args[0] }
}

// The operation of a `wrapping_add_i32`, `sqrt_f64`, ... intrinsic.
fn intrinsicOp(name: str) Option<(RvalueKind, Op, FloatFn)> {
    const table = [("wrapping_add_", 0), ("wrapping_sub_", 1), ("wrapping_mul_", 2),
                   ("sqrt_", 3), ("fabs_", 4), ("floor_", 5), ("ceil_", 6), ("minnum_", 7),
                   ("maxnum_", 8)]
    for i in 0..table.len() {
        const prefix = &table[i].0
        if name.len() > prefix.len() && name.startsWith(prefix) {
            return Option.Some(match table[i].1 {
                0 => (RvalueKind.Binary, Op.Add, FloatFn.Sqrt)
                1 => (RvalueKind.Binary, Op.Sub, FloatFn.Sqrt)
                2 => (RvalueKind.Binary, Op.Mul, FloatFn.Sqrt)
                3 => (RvalueKind.FloatFn, Op.Add, FloatFn.Sqrt)
                4 => (RvalueKind.FloatFn, Op.Add, FloatFn.Fabs)
                5 => (RvalueKind.FloatFn, Op.Add, FloatFn.Floor)
                6 => (RvalueKind.FloatFn, Op.Add, FloatFn.Ceil)
                7 => (RvalueKind.FloatFn, Op.Add, FloatFn.Minnum)
                _ => (RvalueKind.FloatFn, Op.Add, FloatFn.Maxnum)
            })
        }
    }
    return Option.None
}

// The atomic intrinsics of std.mem.atomic (ADR 0042), in `AtomicOp` order.
fn atomicOp(name: str) int {
    const names = ["atomicLoad", "atomicStore", "atomicSwap", "atomicFetchAdd", "atomicFetchSub",
                   "atomicCompareExchange", "fence"]
    for i in 0..names.len() {
        if name == names[i] {
            return i
        }
    }
    return -1
}

// The variant an ordering argument names, if it is a constant `Ordering.X`; else -1.
fn constantOrder(c: Checker, e: &Expr) int {
    return match e.kind {
        ExprKind.Variant(_, _, _) => c.members[c.module()][e.id.0]   // `.SeqCst`
        ExprKind.Field(base, _, _) => if typeNameOf(c, &*base) != 0 && !moduleMember(c, e) {
            c.members[c.module()][e.id.0]
        } else {
            -1
        }
        ExprKind.Ident(_) => match c.res(e.id.0) {
            Res.Def(id) => if c.def(id).kind == DefKind.Variant { c.def(id).member } else { -1 }
            _ => -1
        }
        _ => -1
    }
}

// `atomicLoad(p, Ordering.Acquire)`, ...: the ordering is the last argument.
fn lowerAtomic(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, op: int,
               args: &List<Arg>) Operand {
    const order = &args[args.len() - 1].value
    const variant = constantOrder(c, order)
    if variant < 0 {
        c.error("E0820", order.span,
                "the memory ordering of an atomic operation must be a constant".toOwned())
        return unit()
    }
    const allowed = [19, 21, 31, 31, 31, 31, 30]   // bits of the variants each allows
    if (allowed[op] >> variant) & 1 == 0 {
        const names = ["atomicLoad", "atomicStore", "atomicSwap", "atomicFetchAdd",
                       "atomicFetchSub", "atomicCompareExchange", "fence"]
        const orders = ["Relaxed", "Acquire", "Release", "AcqRel", "SeqCst"]
        c.error("E0821", order.span,
                "`{names[op]}` does not allow the ordering `{orders[variant]}`")
        return unit()
    }
    let rv = rvalue(RvalueKind.Atomic, Op.Add, unit(), unit())
    rv.to = op
    rv.flag = variant
    if op != ATOMIC_FENCE {
        rv.a = lowerExpr(l, c, p, &args[0].value)
    }
    if args.len() > 2 {
        rv.b = lowerExpr(l, c, p, &args[1].value)
    }
    if op == ATOMIC_CAS {
        const desired = lowerExpr(l, c, p, &args[2].value)
        rv.items.push(desired)
    }
    const ty = c.typeOf(e.id.0)
    const temp = emitTemp(l, ty, rv)
    return if ty == UNIT { unit() } else { opCopy(temp, ty) }
}

fn lowerIntrinsic(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, id: int,
                  args: &List<Arg>) Operand {
    const name = c.text(fnOf(p, c.loc(id)).name).toOwned()
    const ty = c.typeOf(e.id.0)
    const atomic = atomicOp(name)
    if atomic >= 0 {
        return lowerAtomic(l, c, p, e, atomic, args)
    }
    if metaCall(c, p, e) != "" {
        return metaConstant(l, c, p, e)
    }
    if name == "sizeOf" || name == "alignOf" {
        const kind = if name == "sizeOf" { RvalueKind.SizeOf } else { RvalueKind.AlignOf }
        let rv = rvalue(kind, Op.Add, unit(), unit())
        rv.to = callTypeArg(c, e)
        return tempValue(l, I64, rv)
    }
    if name == "assert" {   // std.testing (ADR 0036)
        panicAssert(l, c, p, e, &args[0].value, false)
        return unit()
    }
    if name == "assertEq" || name == "assertNe" {   // std.testing (ADR 0036)
        assertEqual(l, c, p, e, args, name == "assertEq")
        return unit()
    }
    if name == "dropInPlace" || name == "forget" {
        const value = lowerExpr(l, c, p, &args[0].value)
        if name == "forget" {
            return unit()   // the value is consumed, and nothing runs
        }
        const elem = concreteType(l, c, callTypeArg(c, e))
        if c.types.kind(elem) == TyKind.Dyn {   // through the vtable: the fat pointer itself
            emitCall(l, GLUE_DROP, c.types.tuple([elem]), [value], -1)
            return unit()
        }
        const place = Place{local: toLocal(l, value), fields: [], deref: true}
        emitDrop(l, c, p, &place, elem)
        return unit()
    }
    if name == "debugOf" {
        const value = lowerExpr(l, c, p, &args[0].value)
        const out = placeOperand(&lowerPlace(l, c, p, &args[1].value), OperandKind.Addr, STR)
        debugValue(l, c, p, value, concreteType(l, c, callTypeArg(c, e)), &out)
        return unit()
    }
    if name == "cloneOf" {
        const value = lowerExpr(l, c, p, &args[0].value)
        return cloneValue(l, c, p, value, concreteType(l, c, callTypeArg(c, e)))
    }
    if name == "hashOf" {
        const value = lowerExpr(l, c, p, &args[0].value)
        return hashValue(l, c, p, value, concreteType(l, c, callTypeArg(c, e)))
    }
    const Option.Some(op) = intrinsicOp(name) else {
        c.error("E0805", fnOf(p, c.loc(id)).span, "unknown intrinsic".toOwned())
        return unit()
    }
    const a = lowerExpr(l, c, p, &args[0].value)
    const b = if args.len() > 1 { lowerExpr(l, c, p, &args[1].value) } else { unit() }
    let rv = rvalue(op.0, op.1, a, b)
    rv.floatFn = op.2
    return tempValue(l, ty, rv)
}

// ---------------------------------------------------------------------------
// Clones (stage 0: lower_clone.c) and hashes (lower_hash.c)

/**
 * A clone of a value of a concrete type: its bits when it owns nothing,
 * else a call of its clone glue.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param value the value
 * @param ty its type
 * @returns the clone
 */
pub fn cloneValue(l: mut Lowerer, c: mut Checker, p: Program, value: move Operand,
                  ty: int) Operand {
    let v = value
    v.ty = ty
    if !needsDrop(l, c, p, ty) {
        return v   // nothing owned: the bits are the clone
    }
    const dest = newTemp(l, ty)
    emitCall(l, GLUE_CLONE, c.types.tuple([ty]), [v], dest)
    return opCopy(dest, ty)
}

/**
 * A function of a std module, found by name.
 *
 * @param c the checker
 * @param p the program
 * @param module the module's name, as `std.core.hash`
 * @param name the function's name
 * @returns its `DefId`; panics if the module or the function is missing
 */
pub fn stdFn(c: mut Checker, p: Program, module: str, name: str) int {
    for m in 0..p.modules.len() {
        if p.modules[m].name == module {
            const symbol = c.r.names.intern(name)
            const id = c.r.scope.moduleIn(m, symbol)
            if id != 0 {
                return id
            }
        }
    }
    panic("lowering: the standard library has no `{module}.{name}`")
}

/**
 * A call of a function of `std.core.hash`.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param name the function
 * @param args its arguments
 * @returns the `u64`
 */
pub fn callHash(l: mut Lowerer, c: mut Checker, p: Program, name: str,
                args: move List<Operand>) Operand {
    const dest = newTemp(l, U64)
    emitCall(l, stdFn(c, p, "std.core.hash", name), UNIT, args, dest)
    return opCopy(dest, U64)
}

fn tupleElement(l: mut Lowerer, c: Checker, value: move Operand, ty: int, i: int) Operand {
    const place = Place{local: toLocal(l, value), fields: [i], deref: false}
    return placeOperand(&place, OperandKind.Copy, c.types.get(ty).args[i])
}

/**
 * The hash of a value (spec 9.9): its bits for numbers and `bool`, a call
 * for `str`, the elements combined for tuples, the glue for structs and enums.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param value the value
 * @param ty its type, concrete
 * @returns the `u64`
 */
pub fn hashValue(l: mut Lowerer, c: mut Checker, p: Program, value: move Operand,
                 ty: int) Operand {
    let v = value
    v.ty = ty
    const kind = c.types.kind(ty)
    if kind == TyKind.Adt {
        return adtHash(l, c, v, ty)
    }
    if kind == TyKind.Str {
        return callHash(l, c, p, "hashStr", [v])
    }
    if kind == TyKind.Tuple {
        let h = opInt(0, U64)
        const elems = c.types.get(ty).args.clone()
        for i in 0..elems.len() {
            const element = tupleElement(l, c, v.clone(), ty, i)
            const part = hashValue(l, c, p, element, elems[i])
            h = callHash(l, c, p, "hashCombine", [h, part])
        }
        return h
    }
    let cast = rvalue(RvalueKind.Cast, Op.Add, v, unit())   // ints and bool: their bits, unchecked
    cast.to = U64
    const bits = tempValue(l, U64, cast)
    return callHash(l, c, p, "hashU64", [bits])
}

/**
 * `a == b` (spec 9.9): inline for tuples, a call for structs and enums
 * with payloads or their own `eq`, the operator otherwise.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param a the left value
 * @param b the right value
 * @param ty their type, concrete
 * @returns the bool
 */
pub fn equalValues(l: mut Lowerer, c: mut Checker, p: Program, a: move Operand,
                   b: move Operand, ty: int) Operand {
    let x = a
    let y = b
    x.ty = ty
    y.ty = ty
    if c.types.kind(ty) == TyKind.Adt && equalityCalls(c, p, ty) {
        return adtEqual(l, c, p, x, y, ty)
    }
    if c.types.kind(ty) != TyKind.Tuple {
        return lowerBinaryOp(l, c, Op.Eq, ty, x, y, noSpan())
    }
    let all = opBool(true, BOOL)
    const elems = c.types.get(ty).args.clone()
    for i in 0..elems.len() {
        const ea = tupleElement(l, c, x.clone(), ty, i)
        const eb = tupleElement(l, c, y.clone(), ty, i)
        const same = equalValues(l, c, p, ea, eb, elems[i])
        all = tempValue(l, BOOL, rvalue(RvalueKind.Binary, Op.And, all, same))
    }
    return all
}

// ---------------------------------------------------------------------------
// `for x in it` over a type with `fn next(mut self) Option<T>` (stage 0:
// lower_iter.c)

fn isIterator(l: Lowerer, c: mut Checker, p: Program, ty: int) bool {
    const concrete = concreteType(l, c, ty)
    return c.types.kind(concrete) == TyKind.Adt && typeMethod(c, p, concrete, "next") != 0
}

fn lowerForIter(l: mut Lowerer, c: mut Checker, p: Program, stmt: &Stmt, expr: &Expr,
                body: &Block) {
    const ty = concreteType(l, c, viewType(c, expr, -1))
    const iter = lowerPlace(l, c, p, expr)
    const item = c.localAt(stmt.id.0) + 1
    const option = concreteType(l, c, c.types.adt(c.r.langItems[2], [l.body.locals[item].ty]))
    const header = l.body.newBlock()
    const bodyBlock = l.body.newBlock()
    const latch = l.body.newBlock()
    const exit = l.body.newBlock()
    emitGoto(l, header)
    switchTo(l, header)
    const next = newTemp(l, option)
    const selfRef = c.types.ref(ty, true)
    emitCall(l, typeMethod(c, p, ty, "next"), methodTargs(c, ty),
             [placeOperand(&iter, OperandKind.Addr, selfRef)], next)
    const nextPlace = localPlace(next)
    const some = isVariant(l, c, p, &nextPlace, option, 0)
    terminate(l, branch(some, bodyBlock, exit))
    switchTo(l, bodyBlock)
    const elem = c.types.get(option).args[0]
    emitAssign(l, item, rvUse(payload(&nextPlace, 0, 0, elem)))
    dropScopeEnter(l)   // the item, dropped at the end of each iteration
    ownLocal(l, c, p, item, true)
    l.loops.push(LoopTarget{breakTo: exit, continueTo: latch, scopes: l.scopes.len() - 1,
                            tempScopes: l.tempScopes.len(), label: stmt.label})
    const _ = lowerBlock(l, c, p, body, false)
    const _ = l.loops.pop()
    dropScopeLeave(l, c, p)
    emitGoto(l, latch)
    switchTo(l, latch)
    emitGoto(l, header)
    switchTo(l, exit)
}

// An argument: the address of the place for a `mut` parameter, else the
// value.
fn argument(l: mut Lowerer, c: mut Checker, p: Program, arg: &Expr, byRef: bool,
            next: Option<&Expr>) Operand {
    if byRef {
        return placeOperand(&lowerPlace(l, c, p, arg), OperandKind.Addr, c.typeOf(arg.id.0))
    }
    const value = lowerExpr(l, c, p, arg)
    return match next {
        Option.Some(n) => settle(l, value, n)
        Option.None => value
    }
}

fn isIntrinsic(c: Checker, p: Program, id: int) bool {
    if c.def(id).member < 0 {
        return false
    }
    return match itemOf(p, c.loc(id)).kind {
        ItemKind.Extern(abi, _) => abi == "intrinsic"
        _ => false
    }
}

// The default of parameter `index` of `id`, lowered in its module.
fn defaultArgument(l: mut Lowerer, c: mut Checker, p: Program, id: int, callee: int,
                   index: int) Operand {
    const decl = fnOf(p, c.loc(id))
    const previous = c.enter(c.def(id).module)
    const result = match decl.params[index].defaultValue {
        Option.Some(value) => argument(l, c, p, &value, byAddress(c, p, callee, index),
                                       Option.None)
        Option.None => unit()
    }
    c.enter(previous)
    return result
}

// The arguments of a call that names them or leaves parameters to their
// defaults (spec 3.3): those written, in the order written, then the
// defaults of the others, passed in the order of the parameters.
fn arrangedArguments(l: mut Lowerer, c: mut Checker, p: Program, id: int, callee: int,
                     args: &List<Arg>, slots: &List<int>, operands: mut List<Operand>) {
    let given: List<Operand> = []
    for i in 0..args.len() {
        let next: Option<&Expr> = Option.None
        if i + 1 < args.len() {
            next = Option.Some(&args[i + 1].value)
        }
        given.push(argument(l, c, p, &args[i].value, byAddress(c, p, callee, slots[i]), next))
    }
    const count = fnOf(p, c.loc(id)).params.len()
    for j in 0..count {
        let at = -1
        for i in 0..slots.len() {
            if slots[i] == j {
                at = i
            }
        }
        if at >= 0 {
            operands.push(given[at].clone())
        } else {
            const value = defaultArgument(l, c, p, id, callee, j)
            operands.push(value)
        }
    }
}

// A call of a user function.
fn emitUserCall(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, id: int,
                args: &List<Arg>, receiver: Option<&Expr>) Operand {
    if isIntrinsic(c, p, id) {
        return lowerIntrinsic(l, c, p, e, id, args)
    }
    const decl = fnOf(p, c.loc(id))
    const ownerParams = if c.def(id).member >= 0 {
        itemTypeParams(itemOf(p, c.loc(id))).len()
    } else {
        0
    }
    let targs = UNIT
    if decl.typeParams.len() + ownerParams > 0 {
        targs = match c.callTypeArgs[c.module()].get(e.id.0) {
            Option.Some(t) => *t
            Option.None => UNIT
        }
    }
    let callee = id
    if isInterfaceMethod(c, p, id) {   // static dispatch on the instance's `Self` (spec 9.6)
        const concrete = concreteType(l, c, targs)
        const selfType = c.types.get(concrete).args[0]
        const found = typeMethod(c, p, selfType, c.text(decl.name))
        if found != 0 {
            callee = found
            targs = methodTargs(c, selfType)
        } else {   // the interface's default method, for that `Self`
            targs = concrete
        }
    }
    const paramCount = decl.params.len()
    let operands: List<Operand> = []
    if const Option.Some(recv) = receiver {
        let next: Option<&Expr> = Option.None
        if args.len() > 0 {
            next = Option.Some(&args[0].value)
        }
        operands.push(argument(l, c, p, recv, byAddress(c, p, callee, -1), next))
    }
    match c.argSlots[c.module()].get(e.id.0) {
        Option.Some(slots) => arrangedArguments(l, c, p, id, callee, args, slots, operands)
        Option.None => {
            for i in 0..args.len() {
                let next: Option<&Expr> = Option.None
                if i + 1 < args.len() {
                    next = Option.Some(&args[i + 1].value)
                }
                const byRef = i < paramCount && byAddress(c, p, callee, i)
                operands.push(argument(l, c, p, &args[i].value, byRef, next))
            }
        }
    }
    const ty = c.typeOf(e.id.0)
    let dest = -1
    let result = unit()
    if typeIsValue(ty) {
        dest = newTemp(l, ty)
        result = opCopy(dest, ty)
    }
    emitCall(l, callee, targs, operands, dest)
    if ty == NEVER {
        terminate(l, terminator(TermKind.Unreachable))
    }
    return result
}

fn address(l: mut Lowerer, value: move Operand) Operand {
    const ty = value.ty
    return opAddr(toLocal(l, value), ty)
}

fn panicAssert(l: mut Lowerer, c: mut Checker, p: Program, call: &Expr, arg: &Expr,
               isPanic: bool) {
    const value = lowerExpr(l, c, p, arg)
    if isPanic {
        let t = terminator(TermKind.Panic)
        t.cond = address(l, value)
        t.span = call.span
        terminate(l, t)
        return
    }
    const fails = tempValue(l, BOOL, rvalue(RvalueKind.Unary, Op.Not, value, unit()))
    emitAssert(l, fails, PanicKind.Assert, call.span)
}

// `assertEq(a, b)` and `assertNe(a, b)` (ADR 0036): the values compared
// with `==`; when the assert fails, both in their `Debug` form, at the call.
// The call reads the values and does not move them.
fn assertEqual(l: mut Lowerer, c: mut Checker, p: Program, call: &Expr, args: &List<Arg>,
               equal: bool) {
    const ty = concreteType(l, c, callTypeArg(c, call))
    const first = argument(l, c, p, &args[0].value, false, Option.Some(&args[1].value))
    const left = toLocal(l, first)
    const right = toLocal(l, lowerExpr(l, c, p, &args[1].value))
    const same = equalValues(l, c, p, opCopy(left, ty), opCopy(right, ty), ty)
    const fails = l.body.newBlock()
    const done = l.body.newBlock()
    terminate(l, if equal { branch(same, done, fails) } else { branch(same, fails, done) })
    switchTo(l, fails)
    const message = emitTemp(l, STR, rvUse(opStr("", STR)))
    const out = opAddr(message, STR)
    const op = if equal { "==" } else { "!=" }
    pushText(l, &out, "assertion failed: left {op} right\n  left: ")
    debugValue(l, c, p, opCopy(left, ty), ty, &out)
    pushText(l, &out, "\n right: ")
    debugValue(l, c, p, opCopy(right, ty), ty, &out)
    let t = terminator(TermKind.Panic)
    t.cond = out
    t.span = call.span
    terminate(l, t)
    switchTo(l, done)
}

// `base.name(args)`: a method declared in a type, an associated function, a
// variant, or a built-in method.
fn methodCall(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, callee: &Expr,
              args: &List<Arg>) Operand {
    return match callee.kind {
        ExprKind.Field(base, name, _) => fieldCall(l, c, p, e, callee, &*base, name, args)
        _ => valueCall(l, c, p, e, callee, args)
    }
}

// A call of a function value (spec 10.4): the value, then the arguments.
fn valueCall(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, callee: &Expr,
             args: &List<Arg>) Operand {
    let operands: List<Operand> = []
    let first: Option<&Expr> = Option.None
    if args.len() > 0 {
        first = Option.Some(&args[0].value)
    }
    operands.push(argument(l, c, p, callee, false, first))
    for i in 0..args.len() {
        let next: Option<&Expr> = Option.None
        if i + 1 < args.len() {
            next = Option.Some(&args[i + 1].value)
        }
        operands.push(argument(l, c, p, &args[i].value, false, next))
    }
    const ty = c.typeOf(e.id.0)
    let dest = -1
    let result = unit()
    if typeIsValue(ty) {
        dest = newTemp(l, ty)
        result = opCopy(dest, ty)
    }
    emitCall(l, CALL_VALUE, UNIT, operands, dest)
    if ty == NEVER {
        terminate(l, terminator(TermKind.Unreachable))
    }
    return result
}

fn fieldCall(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, callee: &Expr, base: &Expr,
             name: Symbol, args: &List<Arg>) Operand {
    if c.fieldCalls[c.module()].get(callee.id.0).isSome() {   // `button.onClick()`
        return valueCall(l, c, p, e, callee, args)
    }
    if moduleMember(c, callee) {   // `shapes.area(c)`
        return nameCall(l, c, p, e, callee, args)
    }
    const owner = typeNameOf(c, base)
    if owner != 0 && c.def(owner).kind == DefKind.Enum {
        if enumVariants(c, p, owner) && variantIndex(variantsOf(c, owner), name) >= 0 {
            const index = c.members[c.module()][callee.id.0]   // `Shape.Circle(1.0)`
            return buildVariant(l, c, p, c.typeOf(e.id.0), index, args)
        }
    }
    const member = c.members[c.module()][callee.id.0]
    const dynBase = member > 0 && c.types.kind(adjustedType(c, base)) == TyKind.Dyn
    if dynBase && isInterfaceMethod(c, p, member) {
        return dynCall(l, c, p, e, base, member, args)
    }
    if member > 0 {   // a method declared in a type
        const hasSelf = fnOf(p, c.loc(member)).hasSelf
        return emitUserCall(l, c, p, e, member, args, if hasSelf { Option.Some(base) } else {
            Option.None
        })
    }
    if member == DERIVED_CLONE {   // `x.clone()` of a type without a `clone` method
        const value = lowerExpr(l, c, p, base)
        return cloneValue(l, c, p, value, concreteType(l, c, c.typeOf(e.id.0)))
    }
    if member > BUILTIN_BASE {
        l.fail("this method")
        return unit()
    }
    const ty = c.typeOf(e.id.0)
    const value = lowerExpr(l, c, p, base)
    const which = BUILTIN_BASE - member
    if which == 0 {   // `x.wrappingCast<T>()`
        let rv = rvalue(RvalueKind.Cast, Op.Add, value, unit())
        rv.to = ty
        return tempValue(l, ty, rv)
    }
    if which == 1 {   // `x.saturatingCast<T>()`
        let rv = rvalue(RvalueKind.Saturate, Op.Add, value, unit())
        rv.to = ty
        return tempValue(l, ty, rv)
    }
    if which == 2 {
        return checkedCast(l, c, p, ty, value)
    }
    const offset = lowerExpr(l, c, p, &args[0].value)   // `p.add(n)`
    const vty = value.ty
    return tempValue(l, vty, rvalue(RvalueKind.PtrAdd, Op.Add, value, offset))
}

// `I.MIN`, `I.MAX`, `F.NAN`, `F.INFINITY`, `F.EPSILON`.
fn builtinConst(c: Checker, ty: int, name: Symbol) Operand {
    const t = c.types.get(ty)
    const text = c.text(name)
    if t.kind == TyKind.Int {
        const bits = intBits(t.data)
        const signed = t.data <= 3
        const ones: u64 = 18446744073709551615
        const max = if bits == 64 { ones } else { ((1 as u64) << (bits as u64)) - 1 }
        let value: u64 = 0
        if text == "MAX" {
            value = if signed { max >> 1 } else { max }
        } else if signed {
            value = (1 as u64) << ((bits - 1) as u64)
        }
        return opInt(value, ty)
    }
    if text == "NAN" {
        return opFloat(float.NAN, ty)
    }
    if text == "INFINITY" {
        return opFloat(float.INFINITY, ty)
    }
    return opFloat(if t.data == 32 { 1.1920928955078125e-07 } else { 2.220446049250313e-16 }, ty)
}

// ---------------------------------------------------------------------------
// Structs, tuples, indexing

pub fn aggregate(l: mut Lowerer, ty: int, items: move List<Operand>) Operand {
    let rv = rvalue(RvalueKind.Aggregate, Op.Add, unit(), unit())
    rv.items = items
    return tempValue(l, ty, rv)
}

// A tuple or a tuple struct: the values in order.
fn aggregateOf(l: mut Lowerer, c: mut Checker, p: Program, elems: &List<Expr>, ty: int) Operand {
    let items: List<Operand> = []
    for i in 0..elems.len() {
        let item = lowerExpr(l, c, p, &elems[i])
        if i + 1 < elems.len() {
            item = settle(l, item, &elems[i + 1])
        }
        items.push(item)
    }
    return aggregate(l, ty, items)
}

// The value of a field of a struct literal; the shorthand `x` reads the
// variable.
fn initValue(l: mut Lowerer, c: mut Checker, p: Program, init: &FieldInit) Operand {
    if const Option.Some(value) = init.value {
        return lowerExpr(l, c, p, &value)
    }
    const Res.Local(id) = c.res(init.id.0) else {
        l.fail("this shorthand field")
        return unit()
    }
    const local = id + 1
    const place = Place{local: local, fields: [], deref: l.body.locals[local].byRef}
    const value = placeOperand(&place, OperandKind.Copy, c.typeOf(init.id.0))
    if (c.moveFlags[c.module()].get(init.id.0).isSome() &&
        (*c.moveFlags[c.module()].get(init.id.0).unwrap() & MOVES) != 0) {
        noteMoved(l, c, local, &[])
    }
    return value
}

// Fields are evaluated in source order; omitted ones come from the `..base`
// struct.
fn structLiteral(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, fields: &List<FieldInit>,
                 base: Option<Box<Expr>>, ty: int) Operand {
    const id = c.types.get(ty).data
    structFields(c, p, id)
    const names = fieldsOf(c, id).names.clone()
    const count = names.len()
    let items: List<Operand> = []
    let given: List<bool> = List.filled(false, count)
    for _ in 0..count {
        items.push(unit())
    }
    for i in 0..fields.len() {
        let f = 0
        for k in 0..count {
            if names[k].0 == fields[i].name.0 {
                f = k
            }
        }
        let value = initValue(l, c, p, &fields[i])
        if i + 1 < fields.len() {
            if const Option.Some(next) = fields[i + 1].value {
                value = settle(l, value, &next)
            }
        }
        items[f] = value
        given[f] = true
    }
    let baseLocal = 0
    const hasBase = base.isSome()
    if const Option.Some(b) = base {
        baseLocal = toLocal(l, lowerExpr(l, c, p, &*b))
    }
    for f in 0..count {
        if given[f] {
            continue
        }
        if !hasBase {   // the field's default, evaluated at each use
            items[f] = fieldDefault(l, c, p, id, f)
            continue
        }
        const place = Place{local: baseLocal, fields: [f], deref: false}
        items[f] = placeOperand(&place, OperandKind.Copy, structFieldType(c, p, ty, f))
    }
    return aggregate(l, ty, items)
}

// The default value of field `f` of struct `id`: an expression of the
// struct's module.
fn fieldDefault(l: mut Lowerer, c: mut Checker, p: Program, id: int, f: int) Operand {
    if isMappedStruct(c, p, id) {   // a `?:` field of a mapped type: `None`
        const ty = fieldsOf(c, id).types[f]
        const none: List<Arg> = []
        return buildVariant(l, c, p, ty, variantNamed(c, p, ty, "None"), &none)
    }
    const decl = fieldDeclAt(p, c.loc(id), f)
    const previous = c.enter(c.def(id).module)
    const result = match decl.defaultValue {
        Option.Some(value) => lowerExpr(l, c, p, &value)
        Option.None => unit()
    }
    c.enter(previous)
    return result
}

// An array, or a reference to one, where a `&[T]` is expected:
// `Slice.fromRaw(&a[0], N)`.
fn arrayCoercion(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr) Operand {
    const m = c.module()
    const found = c.arrayCoercions[m].remove(e.id.0).unwrap()
    const ty = c.typeOf(e.id.0)
    const isRef = c.types.kind(found) == TyKind.Ref
    const array = if isRef { c.types.get(found).inner } else { found }
    const elem = c.types.get(array).inner
    const count = c.types.get(array).data
    c.setType(e.id.0, found)
    const place = if isRef {
        Place{local: toLocal(l, lowerExpr(l, c, p, e)), fields: [], deref: true}
    } else {
        lowerPlace(l, c, p, e)
    }
    c.setType(e.id.0, ty)
    c.arrayCoercions[m].insert(e.id.0, found)
    const mutable = isRef && c.types.get(found).data != 0 &&
                    c.types.get(ty).data == c.r.langItems[7]   // `&mut [T]`
    const ptr = c.types.ptr(elem, mutable)
    const owner = if mutable { c.r.langItems[7] } else { c.r.langItems[4] }
    const id = langMethod(c, p, owner, "fromRaw")
    const dest = newTemp(l, ty)
    const args = [placeOperand(&place, OperandKind.Addr, ptr), opInt(count as u64, I64)]
    emitCall(l, id, c.types.tuple([elem]), args, dest)
    return opCopy(dest, ty)
}

// A `List<T>` where a `&[T]` is expected: `list.asSlice()` (stage 0
// rewrites the expression into that call).
fn coercion(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr) Operand {
    if c.arrayCoercions[c.module()].get(e.id.0).isSome() {
        return arrayCoercion(l, c, p, e)
    }
    const elem = *c.sliceCoercions[c.module()].get(e.id.0).unwrap()
    if c.types.get(c.typeOf(e.id.0)).data == c.r.langItems[7] {
        return mutSliceCoercion(l, c, p, e, elem)
    }
    const id = langMethod(c, p, c.r.langItems[1], "asSlice")
    const forwarded = l.forward
    l.forward = false
    // The checker gave `e` the slice type; the expression itself is the list.
    const ty = c.typeOf(e.id.0)
    const list = c.types.adt(c.r.langItems[1], [elem])
    c.setType(e.id.0, list)
    const receiver = if byAddress(c, p, id, -1) {
        placeOperand(&lowerPlaceAt(l, c, p, e, derefCount(c, e)), OperandKind.Addr, viewType(c, e,
                                                                                             -1))
    } else {
        lowerView(l, c, p, e, derefCount(c, e))
    }
    c.setType(e.id.0, ty)
    const dest = newTemp(l, ty)
    emitCall(l, id, c.types.tuple([elem]), [receiver], dest)
    l.forward = false
    const consumed = (flagsOf(c, e) & COERCION_CONSUMED) != 0
    if forwarded || consumed || l.tempScopes.len() == 0 || !needsDrop(l, c, p, ty) {
        return opCopy(dest, ty)
    }
    l.temps.push(Temp{local: dest, ty: ty})
    return opCopy(dest, ty)
}

// `&mut list` where a `&mut [T]` is expected: `list.asMutSlice()` on the
// list the reference points to.
fn mutSliceCoercion(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, elem: int) Operand {
    const id = langMethod(c, p, c.r.langItems[1], "asMutSlice")
    const ty = c.typeOf(e.id.0)
    const list = c.types.adt(c.r.langItems[1], [elem])
    const m = c.module()
    c.sliceCoercions[m].remove(e.id.0)
    c.setType(e.id.0, c.types.ref(list, true))
    const place = Place{local: toLocal(l, lowerExpr(l, c, p, e)), fields: [], deref: true}
    c.setType(e.id.0, ty)
    c.sliceCoercions[m].insert(e.id.0, elem)
    const dest = newTemp(l, ty)
    const receiver = placeOperand(&place, OperandKind.Addr, c.types.ptr(list, true))
    emitCall(l, id, c.types.tuple([elem]), [receiver], dest)
    return opCopy(dest, ty)
}

// A pointer, a box or a borrowed value converted to a `dyn` type (spec
// 9.7): the thin pointer, then the fat pointer with the vtable.
fn dynCoercion(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr) Operand {
    const found = dynSourceType(c, e)
    const ty = c.typeOf(e.id.0)
    c.setType(e.id.0, found)   // the expression itself has the type found
    const borrowed = dynBorrowed(c, e)
    const thin = if borrowed {
        const mutable = c.types.get(ty).data == 1
        placeOperand(&lowerPlace(l, c, p, e), OperandKind.Addr, c.types.ref(found, mutable))
    } else {
        lowerView(l, c, p, e, derefCount(c, e))
    }
    c.setType(e.id.0, ty)
    const target = if borrowed { found } else {
        match boxInner(c, found) {
            Option.Some(inner) => inner
            Option.None => c.types.get(found).inner
        }
    }
    let rv = rvalue(RvalueKind.Unsize, Op.Add, thin, opUnit(target))
    rv.to = ty
    return tempValue(l, ty, rv)
}

// A value widened to a union (spec 17.3): the variant of its type, holding it.
fn unionCoercion(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr) Operand {
    const found = unionSourceType(c, e)
    const ty = c.typeOf(e.id.0)
    c.setType(e.id.0, found)   // the expression itself has the type found
    const value = lowerView(l, c, p, e, derefCount(c, e))
    c.setType(e.id.0, ty)
    if unionMembers(c, found).len() > 0 {
        return widenUnion(l, c, p, value, found, ty)
    }
    return variantValue(l, c, p, ty, memberIndex(c, ty, found), [value])
}

// `base.m(args)` where `base` reaches a `dyn I`: the method is loaded from
// the vtable and called with the data pointer as its `self`.
fn dynCall(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, base: &Expr, id: int,
           args: &List<Arg>) Operand {
    const n = derefCount(c, base)
    if n == 0 {
        l.fail("this `dyn` call")
        return unit()
    }
    const iface = c.types.get(adjustedType(c, base)).data
    const slots = dynMethods(c, p, iface)
    let slot = 0
    for i in 0..slots.len() {
        if slots[i] == id {
            slot = i
        }
    }
    const fat = if boxInner(c, stepType(c, base, n - 1)).isSome() {
        boxPointer(l, c, p, base, n - 1)
    } else {
        lowerView(l, c, p, base, n - 1)
    }
    let rv = rvalue(RvalueKind.DynFn, Op.Add, fat, unit())
    rv.flag = slot
    const method = tempValue(l, fnSignature(c, p, id), rv)
    let operands = [method]
    const paramCount = fnOf(p, c.loc(id)).params.len()
    match c.argSlots[c.module()].get(e.id.0) {
        Option.Some(given) => arrangedArguments(l, c, p, id, id, args, given, operands)
        Option.None => {
            for i in 0..args.len() {
                let next: Option<&Expr> = Option.None
                if i + 1 < args.len() {
                    next = Option.Some(&args[i + 1].value)
                }
                const byRef = i < paramCount && byAddress(c, p, id, i)
                operands.push(argument(l, c, p, &args[i].value, byRef, next))
            }
        }
    }
    const ty = c.typeOf(e.id.0)
    let dest = -1
    let result = unit()
    if typeIsValue(ty) {
        dest = newTemp(l, ty)
        result = opCopy(dest, ty)
    }
    emitCall(l, CALL_VALUE, UNIT, operands, dest)
    if ty == NEVER {
        terminate(l, terminator(TermKind.Unreachable))
    }
    return result
}

// `xs[a..b]`, `xs[a..]`, `xs[..b]`: `xs.slice(a, b)` or `xs.sliceFrom(a)`,
// methods of List, Slice and str; `a..=b` is `a..b + 1`.
fn rangeIndex(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, base: &Expr,
              range: &Expr) Operand {
    return match range.kind {
        ExprKind.Range(lo, hi, inclusive) => sliceCall(l, c, p, e, base, lo, hi, inclusive)
        _ => unit()
    }
}

fn sliceCall(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, base: &Expr,
             lo: Option<Box<Expr>>, hi: Option<Box<Expr>>, inclusive: bool) Operand {
    const id = c.members[c.module()][e.id.0]
    const ty = c.typeOf(e.id.0)
    const recv = viewType(c, base, -1)
    const targs = if c.types.kind(recv) == TyKind.Adt {
        const args = c.types.get(recv).args.clone()
        c.types.tuple(args)
    } else {
        UNIT
    }
    let args: List<Operand> = []
    if byAddress(c, p, id, -1) {
        args.push(placeOperand(&lowerPlace(l, c, p, base), OperandKind.Addr, recv))
    } else {
        args.push(lowerExpr(l, c, p, base))
    }
    match lo {
        Option.Some(low) => args.push(lowerExpr(l, c, p, &*low))
        Option.None => args.push(opInt(0, I64))
    }
    if const Option.Some(high) = hi {
        let end = lowerExpr(l, c, p, &*high)
        if inclusive {
            end = lowerBinaryOp(l, c, Op.Add, c.typeOf(high.id.0), end, opInt(1, I64), high.span)
        }
        args.push(end)
    }
    let dest = -1
    let result = unit()
    if typeIsValue(ty) {
        dest = newTemp(l, ty)
        result = opCopy(dest, ty)
    }
    emitCall(l, id, targs, args, dest)
    return result
}

// `&s` of a str: a copy with `cap == 0`, a view that is never freed and
// that a modification copies first.
fn strView(l: mut Lowerer, c: mut Checker, p: Program, operand: &Expr) Operand {
    let value = lowerExpr(l, c, p, operand)
    value.ty = STR
    const view = emitTemp(l, STR, rvUse(value))
    emitStore(l, &Place{local: view, fields: [2], deref: false}, opInt(0, I64))
    return opCopy(view, STR)
}

// `x.checkedCast<T>()`: `Some(x as T)`, or `None` when x is out of T's range.
fn checkedCast(l: mut Lowerer, c: mut Checker, p: Program, option: int,
               value: move Operand) Operand {
    const to = c.types.get(option).args[0]
    const vty = value.ty
    const v = opCopy(toLocal(l, value), vty)
    let test = rvalue(RvalueKind.CastFails, Op.Add, v.clone(), unit())
    test.to = to
    const fails = tempValue(l, BOOL, test)
    const dest = newTemp(l, option)
    const some = l.body.newBlock()
    const none = l.body.newBlock()
    const join = l.body.newBlock()
    terminate(l, branch(fails, none, some))
    switchTo(l, some)
    let cast = rvalue(RvalueKind.Cast, Op.Add, v, unit())
    cast.to = to
    const converted = tempValue(l, to, cast)
    emitAssign(l, dest, rvUse(variantValue(l, c, p, option, 0, [converted])))   // Some
    emitGoto(l, join)
    switchTo(l, none)
    emitAssign(l, dest, rvUse(variantValue(l, c, p, option, 1, [])))   // None
    emitGoto(l, join)
    switchTo(l, join)
    return opCopy(dest, option)
}

// Panics unless 0 <= index < len. The index is compared as unsigned, so a
// negative one is out of range too (spec 2.1).
fn boundsCheck(l: mut Lowerer, index: move Operand, len: move Operand, span: Span) {
    let toIndex = rvalue(RvalueKind.Cast, Op.Add, index.clone(), unit())
    toIndex.to = U64
    const i = tempValue(l, U64, toIndex)
    let toLen = rvalue(RvalueKind.Cast, Op.Add, len.clone(), unit())
    toLen.to = U64
    const n = tempValue(l, U64, toLen)
    const outside = tempValue(l, BOOL, rvalue(RvalueKind.Binary, Op.Ge, i, n))
    const next = l.body.newBlock()
    let t = terminator(TermKind.Assert)
    t.cond = outside
    t.target = next
    t.panic = PanicKind.Bounds
    t.index = index
    t.len = len
    t.span = span
    l.body.terminate(l.block, t)
    switchTo(l, next)
}

// `s[i]`, a byte of a str.
fn lowerIndex(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, base: &Expr,
              index: &Expr) Operand {
    const isRange = match index.kind {
        ExprKind.Range(_, _, _) => true
        _ => false
    }
    if isRange {
        return rangeIndex(l, c, p, e, base, index)
    }
    if isList(c, viewType(c, base, -1)) {
        const place = listIndexPlace(l, c, p, e, base, index)
        return placeOperand(&place, OperandKind.Copy, c.typeOf(e.id.0))
    }
    if isArray(c, viewType(c, base, -1)) {
        const place = arrayIndexPlace(l, c, p, e, base, index)
        return placeOperand(&place, OperandKind.Copy, c.typeOf(e.id.0))
    }
    if isKeyIndex(c, index) {
        return placeOperand(&lowerPlaceAt(l, c, p, e, 0), OperandKind.Copy, c.typeOf(e.id.0))
    }
    const s = lowerExpr(l, c, p, base)
    const i = opCopy(toLocal(l, lowerExpr(l, c, p, index)), I64)
    const len = tempValue(l, I64, rvalue(RvalueKind.StrLen, Op.Add, s.clone(), unit()))
    boundsCheck(l, i.clone(), len, e.span)
    return tempValue(l, U8, rvalue(RvalueKind.StrByte, Op.Add, s, i))
}

// ---------------------------------------------------------------------------
// Lists (stage 0: lower_list.c)

const LIST_PTR: int = 0
const LIST_LEN: int = 1

fn langMethod(c: Checker, p: Program, owner: int, name: str) int {
    const loc = c.loc(owner)
    for i in 0..methodCount(p, loc) {
        const decl = methodAt(p, loc, i)
        if c.text(decl.name) == name {
            return c.r.tables[c.def(owner).module].fnDefs[decl.id.0]
        }
    }
    panic("lowering: std/core/list.of has no `{name}`")
}

// Calls `List<elem>.name(args)`; `dest` receives the result unless -1.
fn callList(l: mut Lowerer, c: mut Checker, p: Program, name: str, elem: int,
            args: move List<Operand>, dest: int) {
    const id = langMethod(c, p, c.r.langItems[1], name)
    emitCall(l, id, c.types.tuple([elem]), args, dest)
}

// `[a, b, c]`: `withCapacity(3)`, then `push` of each element in order;
// `[]` is `new()`.
fn listLiteral(l: mut Lowerer, c: mut Checker, p: Program, items: &List<Expr>,
               ty: int) Operand {
    const elem = c.types.get(ty).args[0]
    const list = newTemp(l, ty)
    if items.len() == 0 {
        callList(l, c, p, "new", elem, [], list)
        return opCopy(list, ty)
    }
    callList(l, c, p, "withCapacity", elem, [opInt(items.len() as u64, I64)], list)
    for i in 0..items.len() {
        const value = lowerExpr(l, c, p, &items[i])
        callList(l, c, p, "push", elem, [opAddr(list, ty), value], -1)
    }
    return opCopy(list, ty)
}

// `[value; count]`: `filled(value, count)`.
fn listRepeat(l: mut Lowerer, c: mut Checker, p: Program, value: &Expr, count: &Expr,
              ty: int) Operand {
    const first = lowerExpr(l, c, p, value)
    const v = settle(l, first, count)
    const n = lowerExpr(l, c, p, count)
    const list = newTemp(l, ty)
    callList(l, c, p, "filled", c.types.get(ty).args[0], [v, n], list)
    return opCopy(list, ty)
}

fn fieldOfPlace(place: &Place, field: int) Place {
    let fields = place.fields.clone()
    fields.push(field)
    return Place{local: place.local, fields: fields, deref: place.deref}
}

// The address of element `index` of the list at `list`, after the check.
fn element(l: mut Lowerer, c: mut Checker, p: Program, list: &Place, ty: int,
           index: move Operand, span: Span) int {
    const len = placeOperand(&fieldOfPlace(list, LIST_LEN), OperandKind.Copy, I64)
    boundsCheck(l, index.clone(), len, span)
    const ptr = structFieldType(c, p, ty, LIST_PTR)
    const base = placeOperand(&fieldOfPlace(list, LIST_PTR), OperandKind.Copy, ptr)
    return emitTemp(l, ptr, rvalue(RvalueKind.PtrAdd, Op.Add, base, index))
}

// The place of `l[i]`: from the element's address, bounds checked.
fn listIndexPlace(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, base: &Expr,
                  index: &Expr) Place {
    const list = lowerPlace(l, c, p, base)
    const i = opCopy(toLocal(l, lowerExpr(l, c, p, index)), I64)
    const at = element(l, c, p, &list, viewType(c, base, -1), i, e.span)
    return Place{local: at, fields: [], deref: true}
}

// ---------------------------------------------------------------------------
// Fixed arrays (spec 2.7): `[N x T]` values; an element is reached from the
// array's address, as a list's from its buffer.

fn isArray(c: Checker, ty: int) bool {
    return c.types.kind(ty) == TyKind.Array
}

// The address of element `index` of the array at `place`, bounds checked.
fn arrayElement(l: mut Lowerer, c: mut Checker, place: &Place, ty: int, index: move Operand,
                span: Span) int {
    const t = c.types.get(concreteType(l, c, ty)).clone()   // `[T; N]` has a length here
    boundsCheck(l, index.clone(), opInt(t.data as u64, I64), span)
    const ptr = c.types.ptr(t.inner, true)
    const base = placeOperand(place, OperandKind.Addr, ptr)
    return emitTemp(l, ptr, rvalue(RvalueKind.PtrAdd, Op.Add, base, index))
}

// The place of `a[i]` for an array `a`.
fn arrayIndexPlace(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, base: &Expr,
                   index: &Expr) Place {
    const array = lowerPlace(l, c, p, base)
    const i = opCopy(toLocal(l, lowerExpr(l, c, p, index)), I64)
    const at = arrayElement(l, c, &array, viewType(c, base, -1), i, e.span)
    return Place{local: at, fields: [], deref: true}
}

// `[a, b, c]` as an array: each element stored at its position.
fn arrayLiteral(l: mut Lowerer, c: mut Checker, p: Program, items: &List<Expr>,
                ty: int) Operand {
    const array = newTemp(l, ty)
    for i in 0..items.len() {
        const value = lowerExpr(l, c, p, &items[i])
        emitStore(l, &fieldOfPlace(&localPlace(array), i), value)
    }
    return opCopy(array, ty)
}

// `[value; N]` as an array: a loop that stores the value N times.
fn arrayRepeat(l: mut Lowerer, c: mut Checker, p: Program, value: &Expr, ty: int) Operand {
    const array = newTemp(l, ty)
    const t = c.types.get(concreteType(l, c, ty)).clone()
    const item = opCopy(toLocal(l, lowerExpr(l, c, p, value)), t.inner)
    const counter = emitTemp(l, I64, rvUse(opInt(0, I64)))
    const header = l.body.newBlock()
    const bodyBlock = l.body.newBlock()
    const exit = l.body.newBlock()
    emitGoto(l, header)
    switchTo(l, header)
    const go = compare(l, Op.Lt, opCopy(counter, I64), opInt(t.data as u64, I64))
    terminate(l, branch(go, bodyBlock, exit))
    switchTo(l, bodyBlock)
    const ptr = c.types.ptr(t.inner, true)
    const base = placeOperand(&localPlace(array), OperandKind.Addr, ptr)
    const at = emitTemp(l, ptr, rvalue(RvalueKind.PtrAdd, Op.Add, base, opCopy(counter, I64)))
    emitStore(l, &Place{local: at, fields: [], deref: true}, item)
    emitAssign(l, counter, rvalue(RvalueKind.Binary, Op.Add, opCopy(counter, I64), opInt(1, I64)))
    emitGoto(l, header)
    switchTo(l, exit)
    return opCopy(array, ty)
}

fn isMap(c: Checker, ty: int) bool {
    const t = c.types.get(ty)
    return t.kind == TyKind.Adt && t.data != 0 && t.data == c.r.langItems[5]
}

// `for x in list`, `for i, x in list` and `for key, value in map`: a hidden
// counter over the list (a map's list of entries); its length and buffer
// are read at each iteration.
fn lowerForList(l: mut Lowerer, c: mut Checker, p: Program, stmt: &Stmt, expr: &Expr,
                body: &Block) {
    let list = lowerPlace(l, c, p, expr)
    let ty = viewType(c, expr, -1)
    const array = isArray(c, ty)
    const map = isMap(c, ty)
    const mapType = ty
    if map {   // field 0 of a Map is its list of entries
        list = fieldOfPlace(&list, 0)
        ty = structFieldType(c, p, ty, 0)
    }
    const counter = emitTemp(l, I64, rvUse(opInt(0, I64)))
    const header = l.body.newBlock()
    const bodyBlock = l.body.newBlock()
    const latch = l.body.newBlock()
    const exit = l.body.newBlock()
    emitGoto(l, header)
    switchTo(l, header)
    const len = if array { opInt(c.types.get(concreteType(l, c, ty)).data as u64, I64) } else {
        placeOperand(&fieldOfPlace(&list, LIST_LEN), OperandKind.Copy, I64)
    }
    const go = compare(l, Op.Lt, opCopy(counter, I64), len)
    terminate(l, branch(go, bodyBlock, exit))
    switchTo(l, bodyBlock)
    const ptr = if array { c.types.ptr(c.types.get(ty).inner, true) } else {
        structFieldType(c, p, ty, LIST_PTR)
    }
    const base = if array { placeOperand(&list, OperandKind.Addr, ptr) } else {
        placeOperand(&fieldOfPlace(&list, LIST_PTR), OperandKind.Copy, ptr)
    }
    const at = emitTemp(l, ptr, rvalue(RvalueKind.PtrAdd, Op.Add, base, opCopy(counter, I64)))
    const current = Place{local: at, fields: [], deref: true}
    const first = c.localAt(stmt.id.0) + 1
    let two = false
    let mutable = false
    if const StmtKind.For(_, isMut, _, second, _, _) = stmt.kind {
        two = second.isSome()
        mutable = isMut
    }
    if map {
        const args = c.types.get(mapType).args.clone()
        const key = placeOperand(&fieldOfPlace(&current, 0), OperandKind.Copy, args[0])
        emitAssign(l, first, rvUse(key))
        if mutable {   // `for mut key, value`: `value` is the entry's value itself
            l.body.locals[first + 1].byRef = true
        }
        bindPlace(l, c, first + 1, &fieldOfPlace(&current, 1), args[1])
    } else {
        const elem = if array { c.types.get(ty).inner } else { c.types.get(ty).args[0] }
        const target = if two { first + 1 } else { first }
        if mutable {   // `for mut x`: `x` is the element itself
            l.body.locals[target].byRef = true
        }
        if l.body.locals[target].byRef {   // a value with interior mutability
            bindPlace(l, c, target, &current, elem)
        } else {
            emitAssign(l, target, rvUse(placeOperand(&current, OperandKind.Copy, elem)))
        }
        if two {
            emitAssign(l, first, rvUse(opCopy(counter, I64)))
        }
    }
    lowerLoopBody(l, c, p, body, latch, exit, stmt.label)
    switchTo(l, latch)   // counter < len: the increment cannot overflow
    emitAssign(l, counter, rvalue(RvalueKind.Binary, Op.Add, opCopy(counter, I64), opInt(1, I64)))
    emitGoto(l, header)
    switchTo(l, exit)
}

// ---------------------------------------------------------------------------
// `?` and `??` (stage 0: lower_option.c)

pub fn variantNamed(c: mut Checker, p: Program, ty: int, name: str) int {
    const id = c.types.get(ty).data
    enumVariants(c, p, id)
    const count = variantsOf(c, id).variants.len()
    for i in 0..count {
        if c.text(variantsOf(c, id).variants[i].name) == name {
            return i
        }
    }
    panic("lowering: std defines no variant `{name}`")
}

fn payload(place: &Place, variant: int, field: int, ty: int) Operand {
    let fields = place.fields.clone()
    fields.push(VARIANT_STEP + variant)
    fields.push(field)
    return placeOperand(&Place{local: place.local, fields: fields, deref: place.deref},
                        OperandKind.Copy, ty)
}

// `e?`: the value of `Some`/`Ok`, or returns `None`/`Err(e)`.
fn lowerTry(l: mut Lowerer, c: mut Checker, p: Program, inner: &Expr, ty: int) Operand {
    const innerType = c.typeOf(inner.id.0)
    const option = c.types.get(innerType).data == c.r.langItems[2]
    const value = localPlace(toLocal(l, lowerExpr(l, c, p, inner)))
    const good = variantNamed(c, p, innerType, if option { "Some" } else { "Ok" })
    const bad = variantNamed(c, p, innerType, if option { "None" } else { "Err" })
    const fail = l.body.newBlock()
    const next = l.body.newBlock()
    const is = isVariant(l, c, p, &value, innerType, good)
    terminate(l, branch(is, next, fail))
    switchTo(l, fail)
    const ret = l.body.locals[0].ty
    const args = c.types.get(innerType).args.clone()
    const error = if args.len() > 1 { args[1] } else { UNIT }
    let fields: List<Operand> = []
    if !option {
        const target = c.types.get(ret).args[1]
        const member = if compatible(error, target) { -1 } else { memberIndex(c, target, error) }
        const sub = unionMembers(c, error).len() > 0 && widens(c, error, target)
        const from = if compatible(error, target) || member >= 0 || sub { 0 } else {
            fromMethod(c, p, target, error)
        }
        if sub {
            const held = payload(&value, bad, 0, error)
            fields.push(widenUnion(l, c, p, held, error, target))
        } else if member >= 0 {
            const widened = variantValue(l, c, p, target, member, [payload(&value, bad, 0, error)])
            fields.push(widened)
        } else if from == 0 {
            fields.push(payload(&value, bad, 0, error))
        } else {
            const converted = newTemp(l, target)
            emitCall(l, from, methodTargs(c, target), [payload(&value, bad, 0, error)], converted)
            fields.push(opCopy(converted, target))
        }
    }
    const returnedVariant = variantNamed(c, p, ret, if option { "None" } else { "Err" })
    const returned = variantValue(l, c, p, ret, returnedVariant, fields)
    emitAssign(l, 0, rvUse(returned))
    dropTemps(l, c, p, 0)
    dropScopes(l, c, p, 0)
    terminate(l, terminator(TermKind.Return))
    switchTo(l, next)
    return payload(&value, good, 0, ty)
}

// `a ?? b`: the value of `Some(x)`, or `b`, evaluated only then.
fn lowerCoalesce(l: mut Lowerer, c: mut Checker, p: Program, lhs: &Expr, rhs: &Expr,
                 ty: int) Operand {
    const lhsType = c.typeOf(lhs.id.0)
    const value = localPlace(toLocal(l, lowerExpr(l, c, p, lhs)))
    const some = variantNamed(c, p, lhsType, "Some")
    const dest = newTemp(l, ty)
    const then = l.body.newBlock()
    const other = l.body.newBlock()
    const join = l.body.newBlock()
    const is = isVariant(l, c, p, &value, lhsType, some)
    terminate(l, branch(is, then, other))
    switchTo(l, then)
    const content = if ty == lhsType { placeOperand(&value, OperandKind.Copy, lhsType) } else {
        payload(&value, some, 0, ty)
    }
    emitAssign(l, dest, rvUse(content))
    emitGoto(l, join)
    switchTo(l, other)
    tempScopeEnter(l)   // evaluated on one path only
    emitAssign(l, dest, rvUse(lowerExpr(l, c, p, rhs)))
    tempScopeLeave(l, c, p)
    emitGoto(l, join)
    switchTo(l, join)
    return opCopy(dest, ty)
}

// ---------------------------------------------------------------------------
// `if`, `&&`, `||`

// Assigns `value` to `dest` when the expression has a value.
fn store(l: mut Lowerer, dest: int, hasDest: bool, value: move Operand) {
    if hasDest && value.kind != OperandKind.Unit {
        emitAssign(l, dest, rvUse(value))
    }
}

/**
 * A condition, whose temporaries end with it.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param e the condition
 * @returns its value, in a local
 */
pub fn lowerCondition(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr) Operand {
    tempScopeEnter(l)
    const cond = lowerExpr(l, c, p, e)
    const ty = cond.ty
    const result = opCopy(toLocal(l, cond), ty)
    tempScopeLeave(l, c, p)
    return result
}

// ---------------------------------------------------------------------------
// Compile-time code (spec 15, ADR 0035)

// The concrete type of a type parameter narrowed by `comptime if` (spec
// 15.3), whose operations take the instance's type; other types as they are.
fn narrowedType(l: Lowerer, c: mut Checker, ty: int) int {
    if c.types.kind(ty) != TyKind.Param {
        return ty
    }
    return concreteType(l, c, ty)
}

// The type arguments of the instance being lowered.
fn instanceArgs(l: Lowerer, c: Checker) List<int> {
    if isGlue(l.body.def) || l.body.targs == UNIT {
        return []
    }
    return c.types.get(l.body.targs).args.clone()
}

// A `std.meta` call: a constant of the instance.
fn metaConstant(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr) Operand {
    if metaCall(c, p, e) == "nameOf" {
        return opStr(c.typeName(concreteType(l, c, callTypeArg(c, e))), STR)
    }
    const targs = instanceArgs(l, c)
    return opBool(comptimeValue(c, p, e, &targs) == 1, BOOL)
}

// The branch of a `comptime if` the instance keeps: 1 `then`, 0 `else`, or
// -1 for an `if` that is not `comptime`.
fn comptimeBranch(l: Lowerer, c: mut Checker, p: Program, e: &Expr) int {
    return match e.kind {
        ExprKind.If(_, cond, _, _) => match cond.kind {
            ExprKind.Comptime(inner) => {
                const targs = instanceArgs(l, c)
                comptimeValue(c, p, &*inner, &targs)
            }
            _ => -1
        }
        _ => -1
    }
}

// Lowers only the branch of a `comptime if` that the instance keeps.
fn lowerComptimeIf(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, taken: int,
                   hasValue: bool) Operand {
    return match e.kind {
        ExprKind.If(_, _, then, otherwise) => {
            if taken == 1 {
                lowerBlock(l, c, p, &then, hasValue)
            } else {
                match otherwise {
                    Option.Some(branchBox) => match branchBox.kind {
                        ExprKind.If(_, _, _, _) => lowerIf(l, c, p, &*branchBox)
                        ExprKind.Block(block) => lowerBlock(l, c, p, &block, hasValue)
                        _ => unit()
                    }
                    Option.None => unit()
                }
            }
        }
        _ => unit()
    }
}

const DEFAULT_BUDGET: int = 10000000   // spec 15.5

// The step budget of compile-time code in the function being lowered:
// `@comptimeBudget(n)` on it, else the default.
fn comptimeBudget(c: mut Checker, p: Program, def: int) int {
    if def <= 0 {
        return DEFAULT_BUDGET
    }
    const decl = fnOf(p, c.loc(def))
    const Option.Some(at) = findAttribute(c.r, decl.attributes, "comptimeBudget") else {
        return DEFAULT_BUDGET
    }
    return match decl.attributes[at].args[0].kind {
        ExprKind.Int(value) => value.wrappingCast<i64>()
        _ => DEFAULT_BUDGET
    }
}

// `comptime e` (spec 15.1): its value is computed in blocks of its own,
// which `air.interp` runs once lowering is done and replaces with the
// constant.
fn comptimeExpr(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, inner: &Expr) Operand {
    if panicMessage(c, inner).isSome() {
        return comptimePanic(l, c, p, e, inner)
    }
    const ty = concreteType(l, c, c.typeOf(e.id.0))
    const start = l.body.newBlock()
    emitGoto(l, start)
    switchTo(l, start)
    const dest = newTemp(l, ty)
    tempScopeEnter(l)
    l.forward = true
    const value = lowerExpr(l, c, p, inner)
    emitAssign(l, dest, rvUse(value))
    tempScopeLeave(l, c, p)
    const after = l.body.newBlock()
    emitGoto(l, after)
    switchTo(l, after)
    let closure = -1
    match l.body.closure.take() {
        Option.Some(body) => {
            closure = body.id
            l.body.closure = Option.Some(body)
        }
        Option.None => {}
    }
    const budget = comptimeBudget(c, p, l.fnDef)
    l.comptimes.push(ComptimeRegion{def: l.body.def, targs: l.body.targs, closure: closure,
                                    start: start, after: after, dest: dest,
                                    budget: budget, span: e.span})
    return opCopy(dest, ty)
}

// `comptime panic(message)` kept by an instance: E0814 at the call that
// created the instance, with the message.
fn comptimePanic(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, inner: &Expr) Operand {
    let text = ""
    match panicMessage(c, inner) {
        Option.Some(message) => match message.kind {
            ExprKind.Str(value) => {
                text = value.toOwned()
            }
            ExprKind.Interp(parts, _) => {
                for i in 0..parts.len() {
                    match parts[i].kind {
                        ExprKind.Str(value) => {
                            text = text + value
                        }
                        _ => {
                            text = text + c.typeName(concreteType(l, c, callTypeArg(c, &parts[i])))
                        }
                    }
                }
            }
            _ => {}
        }
        Option.None => {}
    }
    const key = l.body.def * 4294967296 + l.body.targs
    const span = match l.origins.get(key) {
        Option.Some(origin) => *origin
        Option.None => e.span
    }
    c.error("E0814", span, text)
    terminate(l, terminator(TermKind.Unreachable))
    return unit()
}

fn lowerIf(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr) Operand {
    const ty = c.typeOf(e.id.0)
    const taken = comptimeBranch(l, c, p, e)
    if taken >= 0 {
        return lowerComptimeIf(l, c, p, e, taken, typeIsValue(ty))
    }
    const hasValue = typeIsValue(ty)
    const dest = if hasValue { newTemp(l, ty) } else { 0 }
    match e.kind {
        ExprKind.If(letPattern, condBox, then, otherwise) => {
            const inPlace = match letPattern {
                Option.Some(pattern) => bindsAddress(l, c, &pattern)
                Option.None => false
            }
            let scrutinee = localPlace(0)
            const cond = if inPlace {
                scrutinee = lowerPlace(l, c, p, &*condBox)
                opUnit(UNIT)
            } else if letPattern.isSome() {
                lowerExpr(l, c, p, &*condBox)
            } else {
                lowerCondition(l, c, p, &*condBox)
            }
            const thenBlock = l.body.newBlock()
            const other = l.body.newBlock()
            const join = l.body.newBlock()
            let place = localPlace(0)
            const owned = letPattern.isSome() && ownsBox(c, &*condBox)
            const boxType = c.typeOf(condBox.id.0)
            match letPattern {
                Option.Some(pattern) => {   // the pattern's tests jump to `else` on a mismatch
                    place = if inPlace { scrutinee.clone() } else { localPlace(toLocal(l, cond)) }
                    lowerPattern(l, c, p, &pattern, &place, other)
                    emitGoto(l, thenBlock)
                }
                Option.None => terminate(l, branch(cond, thenBlock, other))
            }
            switchTo(l, thenBlock)
            // A consumed value: its unbound parts end with `then`, all of it with `else`.
            const keep = letPattern.isSome() && !owned &&
                         (flagsOf(c, &*condBox) & (MOVES | CONSUMED)) != 0
            tempScopeEnter(l)
            if keep {
                if const Option.Some(pattern) = letPattern {
                    keepUnbound(l, c, p, &pattern, &place)
                }
            }
            dropScopeEnter(l)   // the bindings of `if const` live in the `then` block
            if const Option.Some(pattern) = letPattern {
                ownBindings(l, c, p, &pattern)
                if owned {
                    boxRest(l, c, p, Option.Some(&pattern), &place, boxType)
                }
            }
            const thenValue = lowerBlock(l, c, p, &then, hasValue)
            store(l, dest, hasValue, thenValue)
            dropScopeLeave(l, c, p)
            tempScopeLeave(l, c, p)
            emitGoto(l, join)
            switchTo(l, other)
            if owned {   // `if const c: T = box` failed: the box is dropped with its value
                boxRest(l, c, p, Option.None, &place, boxType)
            }
            tempScopeEnter(l)
            if keep {
                if const Option.Some(pattern) = letPattern {
                    keepPlace(l, c, p, &place, concreteType(l, c, c.typeOf(pattern.id.0)))
                }
            }
            if const Option.Some(branchBox) = otherwise {
                const other = &*branchBox
                const value = match other.kind {
                    ExprKind.If(_, _, _, _) => lowerIf(l, c, p, other)
                    ExprKind.Block(block) => lowerBlock(l, c, p, &block, hasValue)
                    _ => unit()
                }
                store(l, dest, hasValue, value)
            }
            tempScopeLeave(l, c, p)
            emitGoto(l, join)
            switchTo(l, join)
        }
        _ => {}
    }
    return if hasValue { opCopy(dest, ty) } else { unit() }
}

// `a && b` and `a || b` evaluate `b` only when needed.
fn logical(l: mut Lowerer, c: mut Checker, p: Program, isAnd: bool, lhs: &Expr,
           rhs: &Expr) Operand {
    const dest = newTemp(l, BOOL)
    emitAssign(l, dest, rvUse(lowerExpr(l, c, p, lhs)))
    const rhsBlock = l.body.newBlock()
    const join = l.body.newBlock()
    const whenTrue = if isAnd { rhsBlock } else { join }
    const whenFalse = if isAnd { join } else { rhsBlock }
    terminate(l, branch(opCopy(dest, BOOL), whenTrue, whenFalse))
    switchTo(l, rhsBlock)
    tempScopeEnter(l)   // evaluated on one path only
    emitAssign(l, dest, rvUse(lowerExpr(l, c, p, rhs)))
    tempScopeLeave(l, c, p)
    emitGoto(l, join)
    switchTo(l, join)
    return opCopy(dest, BOOL)
}

fn binary(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, op: Op, lhs: &Expr,
          rhs: &Expr) Operand {
    if op == Op.LogicalAnd || op == Op.LogicalOr {
        return logical(l, c, p, op == Op.LogicalAnd, lhs, rhs)
    }
    if op == Op.Coalesce {
        return lowerCoalesce(l, c, p, lhs, rhs, c.typeOf(e.id.0))
    }
    const first = lowerExpr(l, c, p, lhs)
    const a = settle(l, first, rhs)
    const b = lowerExpr(l, c, p, rhs)
    const ty = c.typeOf(lhs.id.0)
    const concrete = concreteType(l, c, ty)   // a bounded parameter (spec 8.1)
    const equality = op == Op.Eq || op == Op.Ne
    const order = op == Op.Lt || op == Op.Le || op == Op.Gt || op == Op.Ge
    if order && orderCalls(c, concrete) {   // derived or declared `cmp` (spec 9.9)
        return orderedBy(l, c, p, op, a, b, concrete)
    }
    const calls = equality && equalityCalls(c, p, concrete)
    if !calls && !c.types.get(ty).hasParam {
        return lowerBinaryOp(l, c, op, ty, a, b, e.span)
    }
    if !calls {
        let x = a
        let y = b
        x.ty = concrete
        y.ty = concrete
        return lowerBinaryOp(l, c, op, concrete, x, y, e.span)
    }
    const same = equalValues(l, c, p, a, b, concrete)
    if op == Op.Eq {
        return same
    }
    return tempValue(l, BOOL, rvalue(RvalueKind.Unary, Op.Not, same, unit()))
}

// ---------------------------------------------------------------------------
// Operators

fn intBits(data: int) int {
    return match data % 4 {
        0 => 8
        1 => 16
        2 => 32
        _ => 64
    }
}

fn isSigned(c: Checker, ty: int) bool {
    return c.types.get(ty).data <= 3
}

fn compare(l: mut Lowerer, op: Op, a: move Operand, b: move Operand) Operand {
    return tempValue(l, BOOL, rvalue(RvalueKind.Binary, op, a, b))
}

fn checked(l: mut Lowerer, op: Op, ty: int, a: move Operand, b: move Operand, span: Span) Operand {
    const flag = newTemp(l, BOOL)
    let rv = rvalue(RvalueKind.Checked, op, a, b)
    rv.flag = flag
    const result = tempValue(l, ty, rv)
    emitAssert(l, opCopy(flag, BOOL), PanicKind.Overflow, span)
    return result
}

// Division and remainder panic on a zero divisor and on MIN / -1.
fn divide(l: mut Lowerer, c: Checker, op: Op, ty: int, a: move Operand, b: move Operand,
          span: Span) Operand {
    const zero = compare(l, Op.Eq, b.clone(), opInt(0, ty))
    emitAssert(l, zero, PanicKind.DivZero, span)
    if isSigned(c, ty) {
        const bits = intBits(c.types.get(ty).data)
        const min = opInt((1 as u64) << ((bits - 1) as u64), ty)   // the bit pattern of MIN
        const aMin = compare(l, Op.Eq, a.clone(), min)
        const ones: u64 = 18446744073709551615
        const bNeg = compare(l, Op.Eq, b.clone(), opInt(ones >> ((64 - bits) as u64), ty))
        const both = tempValue(l, BOOL, rvalue(RvalueKind.Binary, Op.And, aMin, bNeg))
        emitAssert(l, both, PanicKind.Overflow, span)
    }
    return tempValue(l, ty, rvalue(RvalueKind.Binary, op, a, b))
}

// A shift by the bit width or more panics; a negative amount, seen as
// unsigned, is out of range too.
fn shift(l: mut Lowerer, c: Checker, op: Op, ty: int, a: move Operand, b: move Operand,
         span: Span) Operand {
    let cast = rvalue(RvalueKind.Cast, Op.Add, b.clone(), unit())
    cast.to = U64
    const amount = tempValue(l, U64, cast)
    const bits = opInt(intBits(c.types.get(ty).data) as u64, U64)
    const fails = compare(l, Op.Ge, amount, bits)
    emitAssert(l, fails, PanicKind.Shift, span)
    return tempValue(l, ty, rvalue(RvalueKind.Binary, op, a, b))
}

fn strOp(l: mut Lowerer, op: Op, a: move Operand, b: move Operand) Operand {
    const equality = op == Op.Eq || op == Op.Ne
    const result = if op == Op.Add { STR } else if equality { BOOL } else { I32 }
    const dest = newTemp(l, result)
    const callee = if op == Op.Add {   // std/core/str.of
        l.strConcat
    } else if equality {
        l.strEq
    } else {
        l.strCmp
    }
    let x = a
    let y = b
    x.ty = STR
    y.ty = STR
    emitCall(l, callee, UNIT, [x, y], dest)
    if op == Op.Eq || op == Op.Add {
        return opCopy(dest, result)
    }
    if op == Op.Ne {
        return tempValue(l, result, rvalue(RvalueKind.Unary, Op.Not, opCopy(dest, result), unit()))
    }
    return compare(l, op, opCopy(dest, result), opInt(0, result))   // cmp(a, b) < 0, ...
}

/**
 * `a op b` on values of type `ty`.
 *
 * @param l the lowering
 * @param c the checker
 * @param op the operator
 * @param ty the type of both operands
 * @param a the left operand
 * @param b the right operand
 * @param span where a failed check is reported
 * @returns the result
 */
pub fn lowerBinaryOp(l: mut Lowerer, c: Checker, op: Op, ty: int, a: move Operand,
                     b: move Operand, span: Span) Operand {
    const kind = c.types.kind(ty)
    if kind == TyKind.Str {
        return strOp(l, op, a, b)
    }
    if kind == TyKind.Adt {   // == and != on enums without payloads
        return enumEquality(l, op, a, b)
    }
    const comparison = op == Op.Eq || op == Op.Ne || op == Op.Lt || op == Op.Le || op == Op.Gt ||
                       op == Op.Ge
    if comparison {
        return compare(l, op, a, b)
    }
    if kind == TyKind.Int {
        if op == Op.Add || op == Op.Sub || op == Op.Mul {
            return checked(l, op, ty, a, b, span)
        }
        if op == Op.Div || op == Op.Rem {
            return divide(l, c, op, ty, a, b, span)
        }
        if op == Op.Shl || op == Op.Shr {
            return shift(l, c, op, ty, a, b, span)
        }
    }
    return tempValue(l, ty, rvalue(RvalueKind.Binary, op, a, b))
}

fn unary(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, op: Op, operand: &Expr,
         ty: int) Operand {
    if op == Op.Deref {
        return placeOperand(&lowerPlace(l, c, p, e), OperandKind.Copy,
                            ty)   // reached through the pointer
    }
    if op == Op.Ref || op == Op.RefMut {
        if concreteType(l, c, ty) == STR {
            return strView(l, c, p, operand)
        }
        return placeOperand(&lowerPlace(l, c, p, operand), OperandKind.Addr, ty)
    }
    let value = lowerExpr(l, c, p, operand)
    const concrete = concreteType(l, c, ty)   // a narrowed parameter (spec 15.3)
    if op == Op.Neg && c.types.kind(concrete) == TyKind.Int {
        if value.kind == OperandKind.Int {   // a negative literal, already range checked
            value.bits = (0 as u64).wrappingSub(value.bits)
            return value
        }
        value.ty = concrete
        return checked(l, Op.Sub, concrete, opInt(0, concrete), value, e.span)
    }
    if op == Op.Neg && c.types.kind(concrete) == TyKind.Float {
        value.ty = concrete
        return tempValue(l, concrete, rvalue(RvalueKind.Unary, op, value, unit()))
    }
    return tempValue(l, ty, rvalue(RvalueKind.Unary, op, value, unit()))
}

// Integer conversions that can lose information, and float to integer
// conversions, check that the value fits (spec 2.1).
fn castNeedsCheck(c: Checker, from: int, to: int) bool {
    const f = c.types.get(from)
    const t = c.types.get(to)
    if t.kind != TyKind.Int || f.kind == TyKind.Ptr {
        return false
    }
    if f.kind == TyKind.Float {
        return true
    }
    if f.kind != TyKind.Int || f.data == t.data {
        return false
    }
    const sameSign = (f.data <= 3) == (t.data <= 3)
    const fromBits = intBits(f.data)
    const toBits = intBits(t.data)
    return if sameSign { toBits < fromBits } else { !(t.data <= 3 && toBits > fromBits) }
}

/**
 * `value as to`, checked when the value may not fit.
 *
 * @param l the lowering
 * @param c the checker
 * @param value the value
 * @param to the target type
 * @param span where a failed check is reported
 * @returns the converted value
 */
// `value as T`. `&s as *str` is the address of `s`, not a view of it.
fn castExpr(l: mut Lowerer, c: mut Checker, p: Program, value: &Expr, ty: int,
            span: Span) Operand {
    if c.types.kind(ty) == TyKind.Ptr {
        if const ExprKind.Unary(op, operand) = value.kind {
            const isRef = op == Op.Ref || op == Op.RefMut
            if isRef && concreteType(l, c, c.typeOf(operand.id.0)) == STR {
                const refType = c.typeOf(value.id.0)   // `&str` is `str`: a view
                const from = if concreteType(l, c, refType) == STR { ty } else { refType }
                const addr = placeOperand(&lowerPlace(l, c, p, &*operand), OperandKind.Addr, from)
                return lowerCast(l, c, addr, ty, span)
            }
        }
    }
    let v = lowerExpr(l, c, p, value)
    v.ty = narrowedType(l, c, v.ty)
    return lowerCast(l, c, v, narrowedType(l, c, ty), span)
}

pub fn lowerCast(l: mut Lowerer, c: Checker, value: move Operand, to: int, span: Span) Operand {
    if value.ty == to {
        return value
    }
    if castNeedsCheck(c, value.ty, to) {
        let fails = rvalue(RvalueKind.CastFails, Op.Add, value.clone(), unit())
        fails.to = to
        const check = tempValue(l, BOOL, fails)
        emitAssert(l, check, PanicKind.Cast, span)
    }
    let rv = rvalue(RvalueKind.Cast, Op.Add, value, unit())
    rv.to = to
    return tempValue(l, to, rv)
}

// ---------------------------------------------------------------------------
// Interpolation and printing

// The runtime function for one part, with the part widened to its argument
// type (int64_t, uint64_t, double, float, bool or a str pointer).
fn partFn(l: mut Lowerer, c: Checker, part: mut Operand, print: bool) RuntimeFn {
    const t = c.types.get(part.ty)
    if t.kind == TyKind.Int {
        const signed = t.data <= 3
        const widened = lowerCast(l, c, part.clone(), if signed { I64 } else { U64 }, noSpan())
        part.kind = widened.kind
        part.ty = widened.ty
        part.local = widened.local
        part.bits = widened.bits
        part.path = widened.path
        if signed {
            return if print { RuntimeFn.PrintInt } else { RuntimeFn.StrPushInt }
        }
        return if print { RuntimeFn.PrintUint } else { RuntimeFn.StrPushUint }
    }
    if t.kind == TyKind.Float {
        if t.data == 32 {
            return if print { RuntimeFn.PrintF32 } else { RuntimeFn.StrPushF32 }
        }
        return if print { RuntimeFn.PrintFloat } else { RuntimeFn.StrPushFloat }
    }
    if t.kind == TyKind.Bool {
        return if print { RuntimeFn.PrintBool } else { RuntimeFn.StrPushBool }
    }
    const addr = address(l, part.clone())
    part.kind = addr.kind
    part.local = addr.local
    part.path = addr.path
    return if print { RuntimeFn.PrintStr } else { RuntimeFn.StrPushStr }
}

// The value of "a {x} b": an empty str that each part is appended to.
fn interpolation(l: mut Lowerer, c: mut Checker, p: Program, parts: &List<Expr>,
                 specs: &List<str>) Operand {
    const dest = emitTemp(l, STR, rvUse(opStr("", STR)))
    for i in 0..parts.len() {
        let part = lowerExpr(l, c, p, &parts[i])
        part.ty = narrowedType(l, c, part.ty)
        if specs[i].len() == 0 && unionMembers(c, part.ty).len() > 0 {
            pushUnion(l, c, p, dest, part, false)
        } else if specs[i].len() == 0 {
            const f = partFn(l, c, part, false)
            emitRuntime(l, f, [opAddr(dest, STR), part], -1)
        } else {
            pushFormatted(l, c, p, dest, part, parseFormatSpec(specs[i]))
        }
    }
    return opCopy(dest, STR)
}

// `"{x}"` on a union (spec 17.5): the member it holds, as it interpolates;
// appended to `dest`, or printed.
fn pushUnion(l: mut Lowerer, c: mut Checker, p: Program, dest: int, value: move Operand,
             print: bool) {
    const ty = value.ty
    const source = localPlace(toLocal(l, value))
    const members = unionMembers(c, ty)
    const done = l.body.newBlock()
    for k in 0..members.len() {
        const body = l.body.newBlock()
        const next = l.body.newBlock()
        const is = isVariant(l, c, p, &source, ty, k)
        terminate(l, branch(is, body, next))
        switchTo(l, body)
        const member = placeChild(&placeChild(&source, VARIANT_STEP + k), 0)
        let held = placeOperand(&member, OperandKind.Copy, members[k])
        const f = partFn(l, c, held, print)
        emitRuntime(l, f, if print { [held] } else { [opAddr(dest, STR), held] }, -1)
        emitGoto(l, done)
        switchTo(l, next)
    }
    emitGoto(l, done)
    switchTo(l, done)
}

// `{x:spec}` (spec 1.7): a padded part is formatted into a str of its own,
// which is then appended with its padding.
fn pushFormatted(l: mut Lowerer, c: mut Checker, p: Program, dest: int, part: move Operand,
                 f: FormatSpec) {
    const target = if f.width > 0 { emitTemp(l, STR, rvUse(opStr("", STR))) } else { dest }
    let value = part
    if f.debug {
        const ty = concreteType(l, c, value.ty)
        debugValue(l, c, p, value, ty, &opAddr(target, STR))
    } else if f.precision >= 0 {
        const wide = lowerCast(l, c, value, F64, noSpan())
        const digits = opInt(f.precision as u64, I64)
        emitRuntime(l, RuntimeFn.StrPushFixed, [opAddr(target, STR), wide, digits], -1)
    } else if f.radix != 10 {
        const t = c.types.get(value.ty)
        const format = opInt(radixBits(f, intBits(t.data)) as u64, I64)
        const wide = lowerCast(l, c, value, if t.data <= 3 { I64 } else { U64 }, noSpan())
        emitRuntime(l, RuntimeFn.StrPushRadix, [opAddr(target, STR), wide, format], -1)
    } else {
        const push = partFn(l, c, value, false)
        emitRuntime(l, push, [opAddr(target, STR), value], -1)
    }
    if f.width > 0 {
        const padding = opInt(paddingBits(f) as u64, I64)
        emitRuntime(l, RuntimeFn.StrPushPadded, [opAddr(dest, STR), opAddr(target, STR), padding],
                    -1)
        emitDrop(l, c, p, &localPlace(target), STR)
    }
}

/**
 * Appends the debug representation of a value (`{x:?}`, spec 9.9): numbers
 * and `bool` as they print, a `str` quoted, through a reference its target,
 * anything else through its debug glue.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param value the value
 * @param ty its type
 * @param out the address of the str written to
 */
pub fn debugValue(l: mut Lowerer, c: mut Checker, p: Program, value: move Operand, ty: int,
                  out: &Operand) {
    const kind = c.types.kind(ty)
    if kind == TyKind.Int || kind == TyKind.Float || kind == TyKind.Bool {
        let part = value
        part.ty = ty
        const push = partFn(l, c, part, false)
        emitRuntime(l, push, [out.clone(), part], -1)
    } else if kind == TyKind.Str {
        let text = value
        text.ty = STR
        const addr = address(l, text)
        emitRuntime(l, RuntimeFn.StrPushDebug, [out.clone(), addr], -1)
    } else if kind == TyKind.Unit {
        pushText(l, out, "()")
    } else if kind == TyKind.Ref {
        const inner = c.types.get(ty).inner
        const place = Place{local: toLocal(l, value), fields: [], deref: true}
        debugValue(l, c, p, placeOperand(&place, OperandKind.Copy, inner), inner, out)
    } else if kind != TyKind.Never && kind != TyKind.Error {
        let arg = value
        arg.ty = ty
        emitCall(l, GLUE_DEBUG, c.types.tuple([ty]), [arg, out.clone()], -1)
    }
}

/**
 * Appends a constant text.
 *
 * @param l the lowering
 * @param out the address of the str written to
 * @param text the text
 */
pub fn pushText(l: mut Lowerer, out: &Operand, text: str) {
    const addr = address(l, opStr(text, STR))
    emitRuntime(l, RuntimeFn.StrPushStr, [out.clone(), addr], -1)
}

fn hasSpec(specs: &List<str>) bool {
    for i in 0..specs.len() {
        if specs[i].len() > 0 {
            return true
        }
    }
    return false
}

// print("a {x}") writes each part directly, without building the string;
// with a format specifier, it prints the built string.
fn lowerPrint(l: mut Lowerer, c: mut Checker, p: Program, arg: &Expr, newline: bool) {
    match arg.kind {
        ExprKind.Interp(parts, specs) => {
            if hasSpec(&specs) {
                const text = interpolation(l, c, p, &parts, &specs)
                emitRuntime(l, RuntimeFn.PrintStr, [opAddr(text.local, STR)], -1)
                emitDrop(l, c, p, &localPlace(text.local), STR)
                if newline {
                    emitRuntime(l, RuntimeFn.PrintNewline, [], -1)
                }
                return
            }
            for i in 0..parts.len() {
                let part = lowerExpr(l, c, p, &parts[i])
                if unionMembers(c, part.ty).len() > 0 {
                    pushUnion(l, c, p, -1, part, true)
                    continue
                }
                const f = partFn(l, c, part, true)
                emitRuntime(l, f, [part], -1)
            }
        }
        _ => {
            let part = lowerExpr(l, c, p, arg)
            const f = partFn(l, c, part, true)
            emitRuntime(l, f, [part], -1)
        }
    }
    if newline {
        emitRuntime(l, RuntimeFn.PrintNewline, [], -1)
    }
}

// ---------------------------------------------------------------------------
// Statements

pub fn assignOperand(l: mut Lowerer, dest: int, value: move Operand) {
    if value.kind != OperandKind.Unit {
        emitAssign(l, dest, rvUse(value))
    }
}

/**
 * The innermost scope owns the bindings of a pattern.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param pattern the pattern
 */
pub fn ownBindings(l: mut Lowerer, c: mut Checker, p: Program, pattern: &Pattern) {
    match pattern.kind {
        PatternKind.Binding(_, _) | PatternKind.TypeTest(_, _) | PatternKind.At(_, _, _) => {
            const local = c.localAt(pattern.id.0)
            if local >= 0 {
                ownLocal(l, c, p, local + 1, true)
            }
        }
        PatternKind.Variant(_, _, args, _) | PatternKind.TupleStruct(_, args) |
        PatternKind.Tuple(args) => {
            for i in 0..args.len() {
                ownBindings(l, c, p, &args[i])
            }
        }
        PatternKind.Or(alternatives) => ownBindings(l, c, p, &alternatives[0])   // same locals
        PatternKind.Struct(_, fields, _) => {
            for i in 0..fields.len() {
                match fields[i].pattern {
                    Option.Some(inner) => ownBindings(l, c, p, &inner)
                    Option.None => {
                        const local = c.localAt(fields[i].id.0)
                        if local >= 0 {
                            ownLocal(l, c, p, local + 1, true)
                        }
                    }
                }
            }
        }
        _ => {}
    }
}

fn lowerLet(l: mut Lowerer, c: mut Checker, p: Program, pattern: &Pattern, value: &Expr,
            otherwise: Option<&Block>) {
    const v = lowerExpr(l, c, p, value)
    match pattern.kind {
        PatternKind.Binding(_, _) => assignOperand(l, c.localAt(pattern.id.0) + 1, v)
        PatternKind.Wildcard => {}
        _ => {
            if v.kind != OperandKind.Unit {
                // On a mismatch: the `else` block, which cannot fall through; without
                // `else` the pattern always matches (checked).
                // A consumed value: what the bindings leave ends with the statement,
                // all of it on a mismatch.
                const consumed = (flagsOf(c, value) & (MOVES | CONSUMED)) != 0
                const fail = l.body.newBlock()
                const place = localPlace(toLocal(l, v))
                lowerPattern(l, c, p, pattern, &place, fail)
                const next = l.body.newBlock()
                emitGoto(l, next)
                switchTo(l, fail)
                if const Option.Some(block) = otherwise {
                    if consumed {
                        emitDrop(l, c, p, &place, concreteType(l, c, c.typeOf(pattern.id.0)))
                    }
                    const _ = lowerBlock(l, c, p, block, false)
                }
                terminate(l, terminator(TermKind.Unreachable))
                switchTo(l, next)
                if consumed {
                    keepUnbound(l, c, p, pattern, &place)
                }
            }
        }
    }
    ownBindings(l, c, p, pattern)
}

// Whether `target` is written through a raw pointer: no old value is
// dropped, as by `ptr.write`.
fn throughRawPointer(c: Checker, target: &Expr) bool {
    if derefCount(c, target) > 0 {
        return false   // through a reference or a box
    }
    return match target.kind {
        ExprKind.Field(base, _, _) | ExprKind.TupleField(base, _) => throughRawPointer(c, &*base)
        ExprKind.Unary(op, operand) => {
            op == Op.Deref && c.types.kind(viewType(c, &*operand, -1)) == TyKind.Ptr
        }
        _ => false
    }
}

// `place = value` drops the value the place held (spec 5.2): through the
// drop flag for a local, at once for a field or `*r`. The new value is read
// first.
fn dropOldValue(l: mut Lowerer, c: mut Checker, p: Program, target: &Expr, place: &Place,
                value: move Operand) Operand {
    const whole = place.fields.len() == 0 && !place.deref
    const ty = concreteType(l, c, c.typeOf(target.id.0))
    if throughRawPointer(c, target) || !needsDrop(l, c, p, ty) {
        return value
    }
    const vty = value.ty
    const settled = opCopy(toLocal(l, value), vty)
    let path: List<int> = []
    const local = placePath(c, target, path)
    if local >= 0 && assignPart(l, c, p, local, &path, place, ty) {
        return settled   // a part with its own drop flag
    }
    if (flagsOf(c, target) & MOVES) != 0 {
        return settled   // the old value may have been moved out
    }
    if whole {
        dropBeforeAssign(l, c, p, place.local)
    } else {
        emitDrop(l, c, p, place, ty)
    }
    return settled
}

fn lowerAssign(l: mut Lowerer, c: mut Checker, p: Program, stmt: &Stmt, op: Op, target: &Expr,
               valueExpr: &Expr) {
    const place = lowerPlace(l, c, p, target)
    let value = lowerExpr(l, c, p, valueExpr)
    const ty = c.typeOf(target.id.0)
    if op == Op.Add && ty == STR {   // s += t appends in place
        const vty = value.ty
        const part = opAddr(toLocal(l, value), vty)
        emitRuntime(l, RuntimeFn.StrPushStr, [placeOperand(&place, OperandKind.Addr, ty), part], -1)
        return
    }
    if op != Op.Assign {   // x op= y is x = x op y
        const current = placeOperand(&place, OperandKind.Copy, ty)
        value = lowerBinaryOp(l, c, op, ty, current, value, stmt.span)
    }
    if value.kind == OperandKind.Unit {
        return
    }
    const stored = dropOldValue(l, c, p, target, &place, value)
    emitStore(l, &place, stored)
    if place.fields.len() == 0 && !place.deref {
        assignDone(l, place.local)
    }
}

/**
 * The body of a loop; `latch` is where `continue` goes.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param body the body
 * @param latch where `continue` goes
 * @param exit where `break` goes
 * @param label the loop's label
 */
pub fn lowerLoopBody(l: mut Lowerer, c: mut Checker, p: Program, body: &Block, latch: int,
                     exit: int, label: Option<Symbol>) {
    l.loops.push(LoopTarget{breakTo: exit, continueTo: latch, scopes: l.scopes.len(),
                            tempScopes: l.tempScopes.len(), label: label})
    const _ = lowerBlock(l, c, p, body, false)
    const _ = l.loops.pop()
    emitGoto(l, latch)
}

// `for { }` and `for cond { }`.
fn lowerWhile(l: mut Lowerer, c: mut Checker, p: Program, cond: Option<&Expr>, body: &Block,
              label: Option<Symbol>) {
    const header = l.body.newBlock()
    const bodyBlock = l.body.newBlock()
    const exit = l.body.newBlock()
    emitGoto(l, header)
    switchTo(l, header)
    match cond {
        Option.Some(e) => {
            tempScopeEnter(l)   // evaluated at each iteration
            const value = lowerExpr(l, c, p, e)
            const ty = value.ty
            const test = opCopy(toLocal(l, value), ty)
            tempScopeLeave(l, c, p)
            terminate(l, branch(test, bodyBlock, exit))
        }
        Option.None => emitGoto(l, bodyBlock)
    }
    switchTo(l, bodyBlock)
    lowerLoopBody(l, c, p, body, header, exit, label)
    switchTo(l, exit)
}

// `for i in lo..hi`: a hidden counter, copied into `i` at each iteration so
// that `for mut i` cannot change the iteration. The increment cannot
// overflow: it happens only while the counter is below `hi`.
fn lowerForRange(l: mut Lowerer, c: mut Checker, p: Program, stmt: &Stmt, range: &Expr,
                 body: &Block) {
    const ty = c.typeOf(range.id.0)
    match range.kind {
        ExprKind.Range(lo, hi, inclusive) => {
            if lo.isNone() || hi.isNone() {
                l.fail("open ranges")
                return
            }
            let counter = 0
            let end = 0
            if const Option.Some(low) = lo {
                counter = emitTemp(l, ty, rvUse(lowerExpr(l, c, p, &*low)))
            }
            if const Option.Some(high) = hi {
                end = emitTemp(l, ty, rvUse(lowerExpr(l, c, p, &*high)))
            }
            const header = l.body.newBlock()
            const bodyBlock = l.body.newBlock()
            const latch = l.body.newBlock()
            const exit = l.body.newBlock()
            emitGoto(l, header)
            switchTo(l, header)   // inclusive: enter if lo <= hi; exclusive: while i < hi
            const go = compare(l, if inclusive { Op.Le } else { Op.Lt }, opCopy(counter, ty),
                               opCopy(end, ty))
            terminate(l, branch(go, bodyBlock, exit))
            switchTo(l, bodyBlock)
            emitAssign(l, c.localAt(stmt.id.0) + 1, rvUse(opCopy(counter, ty)))
            lowerLoopBody(l, c, p, body, latch, exit, stmt.label)
            switchTo(l, latch)
            const step = l.body.newBlock()
            if inclusive {   // stop at hi itself, before an increment that could overflow
                const done = compare(l, Op.Eq, opCopy(counter, ty), opCopy(end, ty))
                terminate(l, branch(done, exit, step))
            } else {
                emitGoto(l, step)
            }
            switchTo(l, step)
            emitAssign(l, counter, rvalue(RvalueKind.Binary, Op.Add, opCopy(counter, ty),
                                          opInt(1, ty)))
            emitGoto(l, if inclusive { bodyBlock } else { header })
            switchTo(l, exit)
        }
        _ => {}
    }
}

fn lowerJump(l: mut Lowerer, c: mut Checker, p: Program, stmt: &Stmt, isBreak: bool) {
    const loop = l.loops[jumpTarget(l, stmt)]
    dropTemps(l, c, p, loop.tempScopes)
    dropScopes(l, c, p, loop.scopes)
    emitGoto(l, if isBreak { loop.breakTo } else { loop.continueTo })
}

// The loop a `break` or `continue` leaves: the innermost, or the one with
// its label (the checker made sure there is one).
fn jumpTarget(l: Lowerer, stmt: &Stmt) int {
    let i = l.loops.len()
    const label = match stmt.label {
        Option.Some(name) => name
        Option.None => {
            return i - 1
        }
    }
    for i > 0 {
        i -= 1
        if const Option.Some(name) = l.loops[i].label {
            if name.0 == label.0 {
                return i
            }
        }
    }
    return l.loops.len() - 1
}

fn lowerStmt(l: mut Lowerer, c: mut Checker, p: Program, stmt: &Stmt) {
    match stmt.kind {
        StmtKind.Let(pattern, _, value, otherwise) => {
            match otherwise {
                Option.Some(block) => lowerLet(l, c, p, &pattern, &value, Option.Some(&block))
                Option.None => lowerLet(l, c, p, &pattern, &value, Option.None)
            }
        }
        StmtKind.Var(_, _, value) => {
            const local = c.localAt(stmt.id.0) + 1
            if const Option.Some(v) = value {
                assignOperand(l, local, lowerExpr(l, c, p, &v))
            }
            ownLocal(l, c, p, local, value.isSome())
        }
        StmtKind.Assign(op, target, value) => lowerAssign(l, c, p, stmt, op, &target, &value)
        StmtKind.For(kind, _, _, _, expr, body) => {
            if kind == ForKind.In {
                match expr {
                    Option.Some(e) => {
                        const isRange = match e.kind {
                            ExprKind.Range(_, _, _) => true
                            _ => false
                        }
                        if isRange {
                            lowerForRange(l, c, p, stmt, &e, &body)
                        } else if isIterator(l, c, p, viewType(c, &e, -1)) {
                            lowerForIter(l, c, p, stmt, &e, &body)
                        } else {
                            lowerForList(l, c, p, stmt, &e, &body)
                        }
                    }
                    Option.None => {}
                }
            } else if kind == ForKind.Comptime {
                lowerComptimeFor(l, c, p, stmt, &body)
            } else if kind == ForKind.Cond {
                match expr {
                    Option.Some(e) => lowerWhile(l, c, p, Option.Some(&e), &body, stmt.label)
                    Option.None => {}
                }
            } else {
                lowerWhile(l, c, p, Option.None, &body, stmt.label)
            }
        }
        StmtKind.Return(value) => {
            if const Option.Some(v) = value {
                assignOperand(l, 0, lowerExpr(l, c, p, &v))
            }
            dropTemps(l, c, p, 0)
            dropScopes(l, c, p, 0)
            terminate(l, terminator(TermKind.Return))
        }
        StmtKind.Break => lowerJump(l, c, p, stmt, true)
        StmtKind.Continue => lowerJump(l, c, p, stmt, false)
        StmtKind.ExprStmt(e) => {
            const _ = lowerExpr(l, c, p, &e)
        }
    }
}

// The last expression of a block or a `match` arm, whose value is the
// block's: it is not a temporary of the block, but its own temporaries
// are dropped before the block ends. Its value is read before that.
/**
 * The last expression of a block or of a `match` arm.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param e the expression
 * @returns its value, read before its temporaries are dropped
 */
pub fn lowerTail(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr) Operand {
    tempScopeEnter(l)
    l.forward = true
    let result = lowerExpr(l, c, p, e)
    if result.kind == OperandKind.Copy {
        const ty = result.ty
        result = opCopy(emitTemp(l, ty, rvUse(result)), ty)
    }
    tempScopeLeave(l, c, p)
    return result
}

/**
 * Lowers a block; as a value, a block is worth its last expression
 * statement.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param block the block
 * @param asValue whether its value is used
 * @returns its value
 */
pub fn lowerBlock(l: mut Lowerer, c: mut Checker, p: Program, block: &Block,
                  asValue: bool) Operand {
    let result = unit()
    dropScopeEnter(l)
    const count = block.stmts.len()
    const outer = l.body.at
    for i in 0..count {
        const s = &block.stmts[i]
        l.body.at = s.span   // what the statement emits is at its line (debug info)
        let tail = false
        if asValue && i + 1 == count {
            if const StmtKind.ExprStmt(e) = s.kind {
                result = lowerTail(l, c, p, &e)
                tail = true
            }
        }
        if tail {
            break
        }
        tempScopeEnter(l)   // a statement's temporaries end with it
        lowerStmt(l, c, p, s)
        tempScopeLeave(l, c, p)
    }
    l.body.at = closingBrace(block)   // the drops at its end
    dropScopeLeave(l, c, p)
    l.body.at = outer
    return result
}

/**
 * Where a block ends, for the debug info of what runs there.
 *
 * @param block the block
 * @returns its `}`
 */
pub fn closingBrace(block: &Block) Span {
    return Span{file: block.span.file, start: block.span.end - 1, end: block.span.end}
}
