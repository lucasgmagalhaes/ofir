/**
 * @module
 * The text of AIR bodies, for `main air` (stage 0: `--emit=air`,
 * bootstrap/src/air/air_print.c).
 */

import air.air.AirBody
import air.air.AirStmt
import air.air.ATOMIC_CAS
import air.air.ATOMIC_FENCE
import air.air.ATOMIC_LOAD
import air.air.CALL_VALUE
import air.air.FloatFn
import air.air.Operand
import air.air.OperandKind
import air.air.PanicKind
import air.air.Rvalue
import air.air.RvalueKind
import air.air.StmtKind
import air.air.TermKind
import air.air.Terminator
import air.air.glueName
import air.air.isGlue
import air.air.runtimeName
import sema.check.Checker
import sema.types.UNIT
import syntax.ast.Op

fn opName(op: Op) str {
    return match op {
        Op.Add => "add"
        Op.Sub => "sub"
        Op.Mul => "mul"
        Op.Div => "div"
        Op.Rem => "rem"
        Op.And => "and"
        Op.Or => "or"
        Op.Xor => "xor"
        Op.Shl => "shl"
        Op.Shr => "shr"
        Op.Eq => "eq"
        Op.Ne => "ne"
        Op.Lt => "lt"
        Op.Le => "le"
        Op.Gt => "gt"
        Op.Ge => "ge"
        Op.Neg => "neg"
        Op.Not => "not"
        _ => "?"
    }
}

fn panicName(kind: PanicKind) str {
    return match kind {
        PanicKind.Overflow => "overflow"
        PanicKind.DivZero => "div_zero"
        PanicKind.Shift => "shift"
        PanicKind.Cast => "cast"
        PanicKind.Bounds => "bounds"
        PanicKind.Assert => "assert"
    }
}

fn floatFnName(f: FloatFn) str {
    return match f {
        FloatFn.Sqrt => "sqrt"
        FloatFn.Fabs => "fabs"
        FloatFn.Floor => "floor"
        FloatFn.Ceil => "ceil"
        FloatFn.Minnum => "minnum"
        FloatFn.Maxnum => "maxnum"
    }
}

const HEX: str = "0123456789abcdef"

fn stringLiteral(out: mut str, text: str) {
    out.push("\"")
    for i in 0..text.len() {
        const c = text[i]
        if c < 0x20 || c == b'"' || c == b'\\' || c >= 0x7f {
            out.push("\\x")
            out.push(HEX.slice((c >> 4) as int, (c >> 4) as int + 1))
            out.push(HEX.slice((c & 15) as int, (c & 15) as int + 1))
        } else {
            out.push(text.slice(i, i + 1))
        }
    }
    out.push("\"")
}

// The decimal digits of a float's shortest form, without leading zeros, and
// the exponent of the first: 1.5e-7 is ("15", -7).
fn decimalDigits(text: str) (str, int) {
    let mantissa = text.clone()
    let exponent = 0
    if const Option.Some(e) = text.find("e") {
        mantissa = text.slice(0, e).toOwned()
        exponent = match int.parse(text.sliceFrom(e + 1)) {
            Result.Ok(n) => n
            Result.Err(_) => 0
        }
    }
    let digits = ""
    let point = -1
    for i in 0..mantissa.len() {
        if mantissa[i] == b'.' {
            point = digits.len()
        } else {
            digits.push(mantissa.slice(i, i + 1))
        }
    }
    if point < 0 {
        point = digits.len()
    }
    let lead = 0
    for lead < digits.len() - 1 && digits[lead] == b'0' {
        lead += 1
    }
    return (digits.sliceFrom(lead).toOwned(), exponent + point - lead - 1)
}

// Rounds a digit string to `n` digits, half up; the exponent grows on a carry.
fn roundDigits(digits: str, exponent: int, n: int) (str, int) {
    if digits.len() <= n {
        return (digits.toOwned(), exponent)
    }
    let kept: List<u8> = []
    for i in 0..n {
        kept.push(digits[i])
    }
    if digits[n] >= b'5' {
        let i = n - 1
        for i >= 0 && kept[i] == b'9' {
            kept[i] = b'0'
            i -= 1
        }
        if i < 0 {
            kept.insert(0, b'1')
            const _ = kept.pop()
            let out = ""
            for j in 0..kept.len() {
                out.push(HEX.slice((kept[j] - b'0') as int, (kept[j] - b'0') as int + 1))
            }
            return (out, exponent + 1)
        }
        kept[i] += 1
    }
    let out = ""
    for j in 0..kept.len() {
        out.push(HEX.slice((kept[j] - b'0') as int, (kept[j] - b'0') as int + 1))
    }
    return (out, exponent)
}

fn trimZeros(digits: str) str {
    let end = digits.len()
    for end > 1 && digits[end - 1] == b'0' {
        end -= 1
    }
    return digits.slice(0, end).toOwned()
}

/**
 * A float as C's `printf("%g")` writes it: 6 significant digits, fixed
 * notation for exponents from -4 to 5, trailing zeros removed.
 *
 * @param value the float
 * @returns its text
 */
pub fn formatG(value: float) str {
    const text = "{value}"
    if text == "NaN" {   // C writes the sign of a NaN too
        return if value.isSignNegative() { "-nan" } else { "nan" }
    }
    if text == "inf" || text == "-inf" {
        return text.toOwned()
    }
    const negative = text.startsWith("-")
    const body = if negative { text.sliceFrom(1) } else { text.sliceFrom(0) }
    let out = if negative { "-" } else { "" }
    const parts = decimalDigits(body)
    if parts.0 == "0" {
        out.push("0")
        return out
    }
    const rounded = roundDigits(parts.0, parts.1, 6)
    const digits = trimZeros(rounded.0)
    const x = rounded.1
    if x < -4 || x >= 6 {
        out.push(digits.slice(0, 1))
        if digits.len() > 1 {
            out.push(".")
            out.push(digits.sliceFrom(1))
        }
        out.push(if x < 0 { "e-" } else { "e+" })
        const magnitude = if x < 0 { -x } else { x }
        if magnitude < 10 {
            out.push("0")
        }
        out.push("{magnitude}")
        return out
    }
    if x < 0 {
        out.push("0.")
        for _ in 0..(-x - 1) {
            out.push("0")
        }
        out.push(digits)
        return out
    }
    if digits.len() <= x + 1 {
        out.push(digits)
        for _ in 0..(x + 1 - digits.len()) {
            out.push("0")
        }
        return out
    }
    out.push(digits.slice(0, x + 1))
    out.push(".")
    out.push(digits.sliceFrom(x + 1))
    return out
}

/** Writes AIR bodies as text. */
pub struct AirPrinter {
    /** The text so far. */
    pub out: str

    /**
     * `<int, str>` for an instance; nothing when `targs` is ().
     *
     * @param c the checker
     * @param targs the type arguments, a tuple
     */
    pub fn typeArgs(mut self, c: Checker, targs: int) {
        if targs == UNIT {
            return
        }
        const args = c.types.get(targs).args.clone()
        for i in 0..args.len() {
            self.out.push(if i > 0 { ", " } else { "<" })
            self.out.push(c.typeName(args[i]))
        }
        self.out.push(">")
    }

    fn operand(mut self, c: Checker, o: &Operand) {
        match o.kind {
            OperandKind.Copy | OperandKind.Addr => {
                if o.kind == OperandKind.Addr {
                    self.out.push("&")
                }
                if o.path.deref {
                    self.out.push("*")
                }
                self.out.push("_{o.local}")
                for i in 0..o.path.fields.len() {
                    self.out.push(".{o.path.fields[i] as u64 & 4294967295}")
                }
            }
            OperandKind.Int => self.out.push("{o.bits}_{c.typeName(o.ty)}")
            OperandKind.Float => self.out.push("{formatG(o.float)}_{c.typeName(o.ty)}")
            OperandKind.Bool => self.out.push(if o.truth { "true" } else { "false" })
            OperandKind.Str => stringLiteral(self.out, o.text)
            OperandKind.Unit => self.out.push("()")
        }
    }

    fn operands(mut self, c: Checker, name: str, a: &Operand, b: Option<&Operand>) {
        self.out.push(name)
        self.out.push(" ")
        self.operand(c, a)
        if const Option.Some(second) = b {
            self.out.push(", ")
            self.operand(c, second)
        }
    }

    // `atomic_cas seq_cst _1, _2, _3`, `fence acquire`.
    fn atomic(mut self, c: Checker, rv: &Rvalue) {
        const ops = ["atomic_load", "atomic_store", "atomic_swap", "atomic_add", "atomic_sub",
                     "atomic_cas", "fence"]
        const orders = ["relaxed", "acquire", "release", "acq_rel", "seq_cst"]
        self.out.push("{ops[rv.to]} {orders[rv.flag]}")
        if rv.to == ATOMIC_FENCE {
            return
        }
        self.out.push(" ")
        self.operand(c, &rv.a)
        if rv.to != ATOMIC_LOAD {
            self.out.push(", ")
            self.operand(c, &rv.b)
        }
        if rv.to == ATOMIC_CAS {
            self.out.push(", ")
            self.operand(c, &rv.items[0])
        }
    }

    fn rvalue(mut self, c: Checker, rv: &Rvalue) {
        match rv.kind {
            RvalueKind.StrLen => self.operands(c, "str_len", &rv.a, Option.None)
            RvalueKind.PtrAdd => self.operands(c, "ptr_add", &rv.a, Option.Some(&rv.b))
            RvalueKind.SizeOf => self.out.push("size_of {c.typeName(rv.to)}")
            RvalueKind.AlignOf => self.out.push("align_of {c.typeName(rv.to)}")
            RvalueKind.FnValue => self.operands(c, "fn_value {c.text(c.def(rv.flag).name)}", &rv.a,
                                                Option.None)
            RvalueKind.Closure => self.operands(c, "closure c{rv.flag}", &rv.a, Option.None)
            RvalueKind.Unsize => self.operands(c, "unsize {c.typeName(rv.to)}", &rv.a,
                                               Option.Some(&rv.b))
            RvalueKind.DynFn => self.operands(c, "dyn_fn {rv.flag}", &rv.a, Option.None)
            RvalueKind.TypeId => self.operands(c, "type_id", &rv.a, Option.None)
            RvalueKind.GlobalAddr => self.out.push("global_addr {c.text(c.def(rv.flag).name)}")
            RvalueKind.Atomic => self.atomic(c, rv)
            RvalueKind.Aggregate => {
                self.out.push("\{")
                for i in 0..rv.items.len() {
                    if i > 0 {
                        self.out.push(", ")
                    }
                    self.operand(c, &rv.items[i])
                }
                self.out.push("\}")
            }
            RvalueKind.StrByte => self.operands(c, "str_byte", &rv.a, Option.Some(&rv.b))
            RvalueKind.FloatFn => {
                const two = rv.floatFn == FloatFn.Minnum || rv.floatFn == FloatFn.Maxnum
                self.operands(c, floatFnName(rv.floatFn), &rv.a, if two { Option.Some(&rv.b) }
                              else { Option.None })
            }
            RvalueKind.Saturate => {
                self.operands(c, "saturate", &rv.a, Option.None)
                self.out.push(" to {c.typeName(rv.to)}")
            }
            RvalueKind.Use => self.operand(c, &rv.a)
            RvalueKind.Unary => {
                self.out.push("{opName(rv.op)} ")
                self.operand(c, &rv.a)
            }
            RvalueKind.Cast | RvalueKind.CastFails => {
                self.out.push(if rv.kind == RvalueKind.Cast { "cast " } else { "cast_fails " })
                self.operand(c, &rv.a)
                self.out.push(" to {c.typeName(rv.to)}")
            }
            RvalueKind.Binary | RvalueKind.Checked => {
                if rv.kind == RvalueKind.Checked {
                    self.out.push("checked ")
                }
                self.out.push("{opName(rv.op)} ")
                self.operand(c, &rv.a)
                self.out.push(", ")
                self.operand(c, &rv.b)
                if rv.kind == RvalueKind.Checked {
                    self.out.push(" (overflow: _{rv.flag})")
                }
            }
        }
    }

    fn statement(mut self, c: Checker, s: &AirStmt) {
        self.out.push("    ")
        if s.hasDest {
            self.out.push("_{s.dest}")
            for i in 0..s.destPath.fields.len() {
                self.out.push(".{s.destPath.fields[i] as u64 & 4294967295}")
            }
            self.out.push(" = ")
        }
        if s.kind == StmtKind.Assign {
            self.rvalue(c, &s.value)
        } else {
            if s.runtime {
                self.out.push("call {runtimeName(s.rt)}(")
            } else {
                const name = if isGlue(s.callee) {
                    glueName(s.callee)
                } else if s.callee == CALL_VALUE {
                    "value"
                } else {
                    c.text(c.def(s.callee).name)
                }
                self.out.push("call {name}")
                self.typeArgs(c, s.targs)
                self.out.push("(")
            }
            for i in 0..s.args.len() {
                if i > 0 {
                    self.out.push(", ")
                }
                self.operand(c, &s.args[i])
            }
            self.out.push(")")
        }
        self.out.push("\n")
    }

    fn terminator(mut self, c: Checker, t: &Terminator) {
        self.out.push("    ")
        match t.kind {
            TermKind.None => self.out.push("<unterminated>")
            TermKind.Goto => self.out.push("goto bb{t.target}")
            TermKind.Branch => {
                self.out.push("branch ")
                self.operand(c, &t.cond)
                self.out.push(", bb{t.target}, bb{t.other}")
            }
            TermKind.Assert => {
                self.out.push("assert not ")
                self.operand(c, &t.cond)
                self.out.push(", {panicName(t.panic)} -> bb{t.target}")
            }
            TermKind.Return => self.out.push("return")
            TermKind.Panic => self.operands(c, "panic", &t.cond, Option.None)
            TermKind.Unreachable => self.out.push("unreachable")
        }
        self.out.push("\n")
    }

    /**
     * Writes a body.
     *
     * @param c the checker
     * @param b the body
     */
    pub fn body(mut self, c: Checker, b: &AirBody) {
        const name = if isGlue(b.def) { "" } else { c.text(b.name) }
        self.out.push("fn {name}")
        self.typeArgs(c, b.targs)
        if const Option.Some(closure) = b.closure {
            self.out.push(".c{closure.id}")
            if closure.drop {
                self.out.push(".drop")
            }
        }
        self.out.push(if b.isMain { " (entry) \{\n" } else { " \{\n" })
        for i in 0..b.locals.len() {
            const local = &b.locals[i]
            const role = if i == 0 { "return" } else if i <= b.paramCount { "param" } else { "let" }
            self.out.push("    {role} _{i}: {c.typeName(local.ty)}")
            if const Option.Some(name) = local.name {
                self.out.push("   // {c.text(name)}")
            }
            self.out.push("\n")
        }
        for i in 0..b.blocks.len() {
            self.out.push("  bb{i}:\n")
            const block = &b.blocks[i]
            for j in 0..block.stmts.len() {
                self.statement(c, &block.stmts[j])
            }
            self.terminator(c, &block.term)
        }
        self.out.push("\}\n\n")
    }
}
