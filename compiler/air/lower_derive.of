import sema.types.U64
import sema.types.UNIT
import std.mem
import syntax.ast.Op

const LESS: u64 = 0
const EQUAL: u64 = 1
const GREATER: u64 = 2

fn temp(l: mut Lowerer, ty: int, value: move Rvalue) Operand {
    return opCopy(emitTemp(l, ty, value), ty)
}

fn isEnum(c: Checker, ty: int) bool {
    return c.types.kind(ty) == TyKind.Adt && c.def(c.types.get(ty).data).kind == DefKind.Enum
}

/**
 * Whether `==` on a type is a call (of its `eq` method or of the glue):
 * tuples, structs, enums with payloads, and types that declare `eq`.
 *
 * @param c the checker
 * @param p the program
 * @param ty the type, concrete
 * @returns true if it is
 */
pub fn equalityCalls(c: mut Checker, p: Program, ty: int) bool {
    const kind = c.types.kind(ty)
    if kind == TyKind.Tuple || kind == TyKind.Array {
        return true
    }
    if kind != TyKind.Adt {
        return false
    }
    if comparisonMethod(c, p, ty, BOUND_EQ) != 0 || !isEnum(c, ty) {
        return true
    }
    const id = c.types.get(ty).data
    enumVariants(c, p, id)
    return variantsOf(c, id).hasPayload
}

/**
 * Whether `<` on a type is a call: tuples, structs and enums.
 *
 * @param c the checker
 * @param ty the type, concrete
 * @returns true if it is
 */
pub fn orderCalls(c: Checker, ty: int) bool {
    const kind = c.types.kind(ty)
    return kind == TyKind.Tuple || kind == TyKind.Adt
}

/**
 * `a == b` on a struct or an enum: its `eq` method, or the glue.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param a the left value
 * @param b the right value
 * @param ty their type, concrete
 * @returns the bool
 */
pub fn adtEqual(l: mut Lowerer, c: mut Checker, p: Program, a: move Operand, b: move Operand,
                ty: int) Operand {
    const dest = newTemp(l, BOOL)
    const method = comparisonMethod(c, p, ty, BOUND_EQ)
    if method != 0 {
        emitCall(l, method, methodTargs(c, ty), [a, b], dest)
    } else {
        emitCall(l, GLUE_EQ, c.types.tuple([ty]), [a, b], dest)
    }
    return opCopy(dest, BOOL)
}

/**
 * The hash of a struct or an enum: the glue.
 *
 * @param l the lowering
 * @param c the checker
 * @param value the value
 * @param ty its type, concrete
 * @returns the `u64`
 */
pub fn adtHash(l: mut Lowerer, c: mut Checker, value: move Operand, ty: int) Operand {
    const dest = newTemp(l, U64)
    emitCall(l, GLUE_HASH, c.types.tuple([ty]), [value], dest)
    return opCopy(dest, U64)
}

/**
 * How two values compare, as the tag of an `Ordering`: a call of the
 * type's `cmp` method or of the glue, or for numbers and `str`, `<` and
 * `>`.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param a the left value
 * @param b the right value
 * @param ty their type, concrete
 * @returns the `i32`
 */
pub fn orderOf(l: mut Lowerer, c: mut Checker, p: Program, a: move Operand, b: move Operand,
               ty: int) Operand {
    let x = a
    let y = b
    x.ty = ty
    y.ty = ty
    if orderCalls(c, ty) {
        const method = comparisonMethod(c, p, ty, BOUND_ORD)
        if method == 0 {
            const dest = newTemp(l, I32)
            emitCall(l, GLUE_CMP, c.types.tuple([ty]), [x, y], dest)
            return opCopy(dest, I32)
        }
        const ordering = c.types.get(fnSignature(c, p, method)).inner
        const result = newTemp(l, ordering)
        emitCall(l, method, methodTargs(c, ty), [x, y], result)
        const tag = Place{local: result, fields: [0], deref: false}
        return placeOperand(&tag, OperandKind.Copy, I32)
    }
    const dest = emitTemp(l, I32, rvUse(opInt(EQUAL, I32)))
    const less = l.body.newBlock()
    const notLess = l.body.newBlock()
    const greater = l.body.newBlock()
    const done = l.body.newBlock()
    const lt = lowerBinaryOp(l, c, Op.Lt, ty, x.clone(), y.clone(), noSpan())
    terminate(l, branch(lt, less, notLess))
    switchTo(l, less)
    emitAssign(l, dest, rvUse(opInt(LESS, I32)))
    emitGoto(l, done)
    switchTo(l, notLess)
    const gt = lowerBinaryOp(l, c, Op.Gt, ty, x, y, noSpan())
    terminate(l, branch(gt, greater, done))
    switchTo(l, greater)
    emitAssign(l, dest, rvUse(opInt(GREATER, I32)))
    emitGoto(l, done)
    switchTo(l, done)
    return opCopy(dest, I32)
}

/**
 * `a op b` for `<`, `<=`, `>` and `>=` from how the values compare.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param op the operator
 * @param a the left value
 * @param b the right value
 * @param ty their type, concrete
 * @returns the bool
 */
pub fn orderedBy(l: mut Lowerer, c: mut Checker, p: Program, op: Op, a: move Operand,
                 b: move Operand, ty: int) Operand {
    const order = orderOf(l, c, p, a, b, ty)
    return temp(l, BOOL, rvalue(RvalueKind.Binary, op, order, opInt(EQUAL, I32)))
}

// ---------------------------------------------------------------------------
// The glue bodies

// The parts of a struct or a tuple: their places in `value` and types.
fn partCount(c: mut Checker, ty: int) int {
    return if c.types.kind(ty) == TyKind.Tuple {
        c.types.get(ty).args.len()
    } else {
        fieldsOf(c, c.types.get(ty).data).types.len()
    }
}

fn partType(c: mut Checker, p: Program, ty: int, i: int) int {
    return if c.types.kind(ty) == TyKind.Tuple {
        c.types.get(ty).args[i]
    } else {
        structFieldType(c, p, ty, i)
    }
}

fn part(place: &Place, ty: int) Operand {
    return placeOperand(place, OperandKind.Copy, ty)
}

fn startGlue(l: mut Lowerer, c: mut Checker, glue: int, targs: int, ret: int, params: int) {
    const ty = c.types.get(targs).args[0]
    l.body = AirBody{def: glue, targs: targs, name: Symbol(0), isMain: false,
                     paramCount: params, locals: [], blocks: [],
                     closure: Option.None, span: noSpan(), at: noSpan()}
    l.body.newLocal(ret, Option.None, noSpan())
    for _ in 0..params {
        l.body.newLocal(ty, Option.None, noSpan())
    }
    l.fnDef = 0
    l.flags = []
    l.block = l.body.newBlock()
}

fn finishGlue(l: mut Lowerer, c: mut Checker, p: Program) {
    l.body.terminate(l.block, terminator(TermKind.Return))
    monoBody(l, c, p)
    l.out.push(mem.replace(l.body, emptyBody()))
}

// Each pair of fields, in `a` and `b` at `step`: `same` stays true while they
// are equal.
fn equalFields(l: mut Lowerer, c: mut Checker, p: Program, ty: int, variant: int) Operand {
    const a = localPlace(1)
    const b = localPlace(2)
    const count = if variant < 0 { partCount(c, ty) } else {
        variantsOf(c, c.types.get(ty).data).variants[variant].types.len()
    }
    let all = opBool(true, BOOL)
    for i in 0..count {
        const step = if variant < 0 { 0 } else { VARIANT_STEP + variant }
        const field = if variant < 0 { partType(c, p, ty, i) } else {
            variantFieldType(c, p, ty, variant, i)
        }
        const fa = part(&fieldPlace(&a, step, i), field)
        const fb = part(&fieldPlace(&b, step, i), field)
        const same = equalValues(l, c, p, fa, fb, field)
        all = temp(l, BOOL, rvalue(RvalueKind.Binary, Op.And, all, same))
    }
    return all
}

/**
 * Lowers `eq<T>(a: T, b: T) bool`.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param targs `(T,)`
 */
pub fn lowerEqGlue(l: mut Lowerer, c: mut Checker, p: Program, targs: int) {
    startGlue(l, c, GLUE_EQ, targs, BOOL, 2)
    const ty = c.types.get(targs).args[0]
    if !isEnum(c, ty) {
        emitAssign(l, 0, rvUse(equalFields(l, c, p, ty, -1)))
        finishGlue(l, c, p)
        return
    }
    const id = c.types.get(ty).data
    enumVariants(c, p, id)
    emitAssign(l, 0, rvUse(opBool(false, BOOL)))
    const tagA = part(&Place{local: 1, fields: [0], deref: false}, I32)
    const tagB = part(&Place{local: 2, fields: [0], deref: false}, I32)
    const sameTag = temp(l, BOOL, rvalue(RvalueKind.Binary, Op.Eq, tagA.clone(), tagB))
    const done = l.body.newBlock()
    const fields = l.body.newBlock()
    terminate(l, branch(sameTag, fields, done))
    switchTo(l, fields)
    const count = variantsOf(c, id).variants.len()
    for v in 0..count {
        if variantsOf(c, id).variants[v].types.len() == 0 {
            continue
        }
        const body = l.body.newBlock()
        const next = l.body.newBlock()
        const is = isVariant(l, c, p, &localPlace(1), ty, v)
        terminate(l, branch(is, body, next))
        switchTo(l, body)
        emitAssign(l, 0, rvUse(equalFields(l, c, p, ty, v)))
        emitGoto(l, done)
        switchTo(l, next)
    }
    emitAssign(l, 0, rvUse(opBool(true, BOOL)))   // a variant without fields
    emitGoto(l, done)
    switchTo(l, done)
    finishGlue(l, c, p)
}

fn hashFields(l: mut Lowerer, c: mut Checker, p: Program, ty: int, variant: int,
              start: move Operand) Operand {
    const value = localPlace(1)
    const count = if variant < 0 { partCount(c, ty) } else {
        variantsOf(c, c.types.get(ty).data).variants[variant].types.len()
    }
    let h = start
    for i in 0..count {
        const step = if variant < 0 { 0 } else { VARIANT_STEP + variant }
        const field = if variant < 0 { partType(c, p, ty, i) } else {
            variantFieldType(c, p, ty, variant, i)
        }
        const one = hashValue(l, c, p, part(&fieldPlace(&value, step, i), field), field)
        h = combine(l, c, p, h, one)
    }
    return h
}

fn combine(l: mut Lowerer, c: mut Checker, p: Program, h: move Operand,
           one: move Operand) Operand {
    return callHash(l, c, p, "hashCombine", [h, one])
}

/**
 * Lowers `hash<T>(value: T) u64`: the fields' hashes combined in order,
 * after the tag of an enum.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param targs `(T,)`
 */
pub fn lowerHashGlue(l: mut Lowerer, c: mut Checker, p: Program, targs: int) {
    startGlue(l, c, GLUE_HASH, targs, U64, 1)
    const ty = c.types.get(targs).args[0]
    if !isEnum(c, ty) {
        emitAssign(l, 0, rvUse(hashFields(l, c, p, ty, -1, opInt(0, U64))))
        finishGlue(l, c, p)
        return
    }
    const id = c.types.get(ty).data
    enumVariants(c, p, id)
    const tag = part(&Place{local: 1, fields: [0], deref: false}, I32)
    const start = toLocal(l, hashValue(l, c, p, tag.clone(), I32))
    emitAssign(l, 0, rvUse(opCopy(start, U64)))
    const done = l.body.newBlock()
    const count = variantsOf(c, id).variants.len()
    for v in 0..count {
        if variantsOf(c, id).variants[v].types.len() == 0 {
            continue
        }
        const body = l.body.newBlock()
        const next = l.body.newBlock()
        const is = isVariant(l, c, p, &localPlace(1), ty, v)
        terminate(l, branch(is, body, next))
        switchTo(l, body)
        emitAssign(l, 0, rvUse(hashFields(l, c, p, ty, v, opCopy(start, U64))))
        emitGoto(l, done)
        switchTo(l, next)
    }
    emitGoto(l, done)
    switchTo(l, done)
    finishGlue(l, c, p)
}

// Compares the fields in order: the first that differ decide, into local 0.
fn cmpFields(l: mut Lowerer, c: mut Checker, p: Program, ty: int, variant: int, done: int) {
    const a = localPlace(1)
    const b = localPlace(2)
    const count = if variant < 0 { partCount(c, ty) } else {
        variantsOf(c, c.types.get(ty).data).variants[variant].types.len()
    }
    for i in 0..count {
        const step = if variant < 0 { 0 } else { VARIANT_STEP + variant }
        const field = if variant < 0 { partType(c, p, ty, i) } else {
            variantFieldType(c, p, ty, variant, i)
        }
        const fa = part(&fieldPlace(&a, step, i), field)
        const fb = part(&fieldPlace(&b, step, i), field)
        const order = orderOf(l, c, p, fa, fb, field)
        decide(l, order, done)
    }
}

// `order` into local 0; on to `done` unless it is `Equal`.
fn decide(l: mut Lowerer, order: move Operand, done: int) {
    emitAssign(l, 0, rvUse(order))
    const equal = temp(l, BOOL, rvalue(RvalueKind.Binary, Op.Eq, opCopy(0, I32),
                                       opInt(EQUAL, I32)))
    const next = l.body.newBlock()
    terminate(l, branch(equal, next, done))
    switchTo(l, next)
}

/**
 * Lowers `cmp<T>(a: T, b: T) i32`.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param targs `(T,)`
 */
pub fn lowerCmpGlue(l: mut Lowerer, c: mut Checker, p: Program, targs: int) {
    startGlue(l, c, GLUE_CMP, targs, I32, 2)
    const ty = c.types.get(targs).args[0]
    emitAssign(l, 0, rvUse(opInt(EQUAL, I32)))
    const done = l.body.newBlock()
    if !isEnum(c, ty) {
        cmpFields(l, c, p, ty, -1, done)
    } else {
        const id = c.types.get(ty).data
        enumVariants(c, p, id)
        const tagA = part(&Place{local: 1, fields: [0], deref: false}, I32)
        const tagB = part(&Place{local: 2, fields: [0], deref: false}, I32)
        decide(l, orderOf(l, c, p, tagA.clone(), tagB, I32), done)
        const count = variantsOf(c, id).variants.len()
        for v in 0..count {
            if variantsOf(c, id).variants[v].types.len() == 0 {
                continue
            }
            const body = l.body.newBlock()
            const next = l.body.newBlock()
            const is = isVariant(l, c, p, &localPlace(1), ty, v)
            terminate(l, branch(is, body, next))
            switchTo(l, body)
            cmpFields(l, c, p, ty, v, done)
            emitGoto(l, done)
            switchTo(l, next)
        }
    }
    emitGoto(l, done)
    switchTo(l, done)
    finishGlue(l, c, p)
}

// The fields of a struct, a tuple or a variant: `{ a: 1, b: 2 }` for a
// struct with named fields, `(1, 2)` otherwise (as a variant is built).
fn debugFields(l: mut Lowerer, c: mut Checker, p: Program, ty: int, variant: int,
               out: &Operand) {
    const value = localPlace(1)
    const isTuple = c.types.kind(ty) == TyKind.Tuple
    let names: List<str> = []
    let count = 0
    if variant >= 0 {
        count = variantsOf(c, c.types.get(ty).data).variants[variant].types.len()
    } else if isTuple {
        count = partCount(c, ty)
    } else {
        const info = fieldsOf(c, c.types.get(ty).data)
        count = info.types.len()
        if !info.isTuple {
            for i in 0..count {
                names.push(c.text(info.names[i]).toOwned())
            }
        }
    }
    const named = names.len() == count && count > 0
    if count == 0 {
        if isTuple {
            pushText(l, out, "()")
        } else if variant < 0 {
            pushText(l, out, " \{\}")
        }
        return
    }
    pushText(l, out, if named { " \{ " } else { "(" })
    for i in 0..count {
        if i > 0 {
            pushText(l, out, ", ")
        }
        if named {
            pushText(l, out, "{names[i]}: ")
        }
        const step = if variant < 0 { 0 } else { VARIANT_STEP + variant }
        const field = if variant < 0 { partType(c, p, ty, i) } else {
            variantFieldType(c, p, ty, variant, i)
        }
        debugValue(l, c, p, part(&fieldPlace(&value, step, i), field), field, out)
    }
    if isTuple && count == 1 {
        pushText(l, out, ",")
    }
    pushText(l, out, if named { " \}" } else { ")" })
}

/**
 * Lowers `debug<T>(value: T, out: mut str)`: the debug representation of a
 * value (spec 9.9), its `debug` method or its fields.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param targs `(T,)`
 */
pub fn lowerDebugGlue(l: mut Lowerer, c: mut Checker, p: Program, targs: int) {
    startGlue(l, c, GLUE_DEBUG, targs, UNIT, 2)
    l.body.locals[2].ty = STR
    l.body.locals[2].byRef = true
    const ty = c.types.get(targs).args[0]
    const out = placeOperand(&Place{local: 2, fields: [], deref: true}, OperandKind.Addr, STR)
    const kind = c.types.kind(ty)
    const method = if kind == TyKind.Adt { debugMethod(c, p, ty) } else { 0 }
    if method != 0 {
        emitCall(l, method, methodTargs(c, ty), [opCopy(1, ty), out], -1)
    } else if kind == TyKind.Tuple {
        debugFields(l, c, p, ty, -1, &out)
    } else if !isEnum(c, ty) && kind == TyKind.Adt {
        pushText(l, &out, c.text(c.def(c.types.get(ty).data).name))
        debugFields(l, c, p, ty, -1, &out)
    } else if kind == TyKind.Adt {
        const id = c.types.get(ty).data
        enumVariants(c, p, id)
        const done = l.body.newBlock()
        const count = variantsOf(c, id).variants.len()
        for v in 0..count {
            const body = l.body.newBlock()
            const next = l.body.newBlock()
            const is = isVariant(l, c, p, &localPlace(1), ty, v)
            terminate(l, branch(is, body, next))
            switchTo(l, body)
            if c.isUnion(id) {   // the member it holds (spec 17.5)
                const member = variantFieldType(c, p, ty, v, 0)
                const held = part(&fieldPlace(&localPlace(1), VARIANT_STEP + v, 0), member)
                debugValue(l, c, p, held, member, &out)
            } else {
                pushText(l, &out, c.text(variantsOf(c, id).variants[v].name))
                debugFields(l, c, p, ty, v, &out)
            }
            emitGoto(l, done)
            switchTo(l, next)
        }
        emitGoto(l, done)
        switchTo(l, done)
    } else {
        debugValue(l, c, p, opCopy(1, ty), ty, &out)
    }
    finishGlue(l, c, p)
}
