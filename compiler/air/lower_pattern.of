/**
 * A place one step further: a field, or a variant's payload.
 *
 * @param place the place
 * @param step the field, or `VARIANT_STEP + v`
 * @returns the new place
 */
pub fn placeChild(place: &Place, step: int) Place {
    let fields = place.fields.clone()
    fields.push(step)
    return Place{local: place.local, fields: fields, deref: place.deref}
}

fn tagOf(place: &Place) Operand {
    return placeOperand(&placeChild(place, 0), OperandKind.Copy, I32)
}

fn discriminant(c: mut Checker, p: Program, ty: int, index: int) Operand {
    const id = c.types.get(ty).data
    enumVariants(c, p, id)
    return opInt(variantsOf(c, id).variants[index].discriminant as u64, I32)
}

/**
 * A variant value from its fields.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param ty the enum type
 * @param index the variant
 * @param fields the values of its fields
 * @returns the value
 */
pub fn variantValue(l: mut Lowerer, c: mut Checker, p: Program, ty: int, index: int,
                    fields: move List<Operand>) Operand {
    const dest = newTemp(l, ty)
    const place = localPlace(dest)
    const payload = placeChild(&place, VARIANT_STEP + index)
    for i in 0..fields.len() {
        emitStore(l, &placeChild(&payload, i), fields[i].clone())
    }
    emitStore(l, &placeChild(&place, 0), discriminant(c, p, ty, index))
    return opCopy(dest, ty)
}

/**
 * Widens a union to a larger one (spec 17.3): each member moves to its
 * variant in the larger union.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param value the smaller union
 * @param found its type
 * @param ty the larger union
 * @returns the value
 */
pub fn widenUnion(l: mut Lowerer, c: mut Checker, p: Program, value: move Operand, found: int,
                  ty: int) Operand {
    const source = localPlace(toLocal(l, value))
    const dest = newTemp(l, ty)
    const members = unionMembers(c, found)
    const done = l.body.newBlock()
    for k in 0..members.len() {
        const last = k + 1 == members.len()
        const next = if last { done } else { l.body.newBlock() }
        if !last {
            const is = compare(l, c, p, Op.Eq, I32, tagOf(&source), discriminant(c, p, found, k))
            test(l, is, next)
        }
        const member = placeChild(&placeChild(&source, VARIANT_STEP + k), 0)
        const held = placeOperand(&member, OperandKind.Copy, members[k])
        emitStore(l, &localPlace(dest), variantValue(l, c, p, ty, memberIndex(c, ty, members[k]),
                                                     [held]))
        emitGoto(l, done)
        if !last {
            switchTo(l, next)
        }
    }
    switchTo(l, done)
    return opCopy(dest, ty)
}

/**
 * Builds variant `index` of `ty` from the arguments of a call.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param ty the enum type
 * @param index the variant
 * @param args the arguments
 * @returns the value
 */
pub fn buildVariant(l: mut Lowerer, c: mut Checker, p: Program, ty: int, index: int,
                    args: &List<Arg>) Operand {
    const id = c.types.get(ty).data
    enumVariants(c, p, id)
    let count = variantsOf(c, id).variants[index].types.len()
    if args.len() < count {
        count = args.len()
    }
    let fields: List<Operand> = []
    for i in 0..count {
        fields.push(lowerExpr(l, c, p, &args[i].value))
    }
    return variantValue(l, c, p, ty, index, fields)
}

/**
 * `a == b` and `a != b` on enums without payloads: their tags.
 *
 * @param l the lowering
 * @param op the operator
 * @param a the left value
 * @param b the right value
 * @returns the result
 */
pub fn enumEquality(l: mut Lowerer, op: Op, a: move Operand, b: move Operand) Operand {
    const pa = localPlace(toLocal(l, a))
    const pb = localPlace(toLocal(l, b))
    const dest = newTemp(l, BOOL)
    emitAssign(l, dest, rvalue(RvalueKind.Binary, op, tagOf(&pa), tagOf(&pb)))
    return opCopy(dest, BOOL)
}

fn test(l: mut Lowerer, cond: move Operand, fail: int) {
    const next = l.body.newBlock()
    terminate(l, branch(cond, next, fail))
    switchTo(l, next)
}

fn compare(l: mut Lowerer, c: mut Checker, p: Program, op: Op, ty: int, a: move Operand,
           b: move Operand) Operand {
    return lowerBinaryOp(l, c, op, ty, a, b, noSpan())
}

fn orPattern(l: mut Lowerer, c: mut Checker, p: Program, alternatives: &List<Pattern>,
             place: &Place, fail: int) {
    const ok = l.body.newBlock()
    const count = alternatives.len()
    for i in 0..count {
        const next = if i + 1 < count { l.body.newBlock() } else { fail }
        lowerPattern(l, c, p, &alternatives[i], place, next)
        emitGoto(l, ok)
        if i + 1 < count {
            switchTo(l, next)
        }
    }
    switchTo(l, ok)
}

fn bind(l: mut Lowerer, c: mut Checker, local: int, place: &Place, ty: int) {
    if local < 0 {
        l.fail("this pattern")
        return
    }
    bindPlace(l, c, local + 1, place, ty)
}

/**
 * Tests a pattern against the value at `place`: jumps to `fail` if it
 * does not match, else continues in the current block with the bindings
 * assigned.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param pattern the pattern
 * @param place the value
 * @param fail where a mismatch goes
 */
pub fn lowerPattern(l: mut Lowerer, c: mut Checker, p: Program, pattern: &Pattern,
                    place: &Place, fail: int) {
    const ty = c.typeOf(pattern.id.0)
    match pattern.kind {
        PatternKind.Wildcard => {}
        PatternKind.Binding(_, _) => {
            if c.localAt(pattern.id.0) < 0 && isEnum(c, ty) {   // `None`: a unit variant
                variantTest(l, c, p, pattern, place, ty, &[], fail)
            } else {
                bind(l, c, c.localAt(pattern.id.0), place, ty)
            }
        }
        PatternKind.Literal(value) => {
            const v = lowerExpr(l, c, p, &*value)
            const eq = compare(l, c, p, Op.Eq, ty, placeOperand(place, OperandKind.Copy, ty), v)
            test(l, eq, fail)
        }
        PatternKind.Range(lo, hi, inclusive) => {
            const low = lowerExpr(l, c, p, &*lo)
            const ge = compare(l, c, p, Op.Ge, ty, placeOperand(place, OperandKind.Copy, ty), low)
            test(l, ge, fail)
            const high = lowerExpr(l, c, p, &*hi)
            const op = if inclusive { Op.Le } else { Op.Lt }
            const below = compare(l, c, p, op, ty, placeOperand(place, OperandKind.Copy, ty), high)
            test(l, below, fail)
        }
        PatternKind.Tuple(items) => lowerPatterns(l, c, p, &items, place, fail)
        PatternKind.TupleStruct(_, args) => {
            if isEnum(c, ty) {   // `Some(x)`
                variantTest(l, c, p, pattern, place, ty, &args, fail)
            } else {
                lowerPatterns(l, c, p, &args, place, fail)
            }
        }
        PatternKind.Struct(_, fields, _) => {
            const id = c.types.get(ty).data
            structFields(c, p, id)
            const names = fieldsOf(c, id).names.clone()
            for i in 0..fields.len() {
                let index = 0
                for index + 1 < names.len() && names[index].0 != fields[i].name.0 {
                    index += 1
                }
                const at = placeChild(place, index)
                match fields[i].pattern {
                    Option.Some(inner) => lowerPattern(l, c, p, &inner, &at, fail)
                    Option.None => bind(l, c, c.localAt(fields[i].id.0), &at,
                                        c.typeOf(fields[i].id.0))
                }
            }
        }
        PatternKind.Variant(_, _, args, _) => variantTest(l, c, p, pattern, place, ty, &args, fail)
        PatternKind.Or(alternatives) => orPattern(l, c, p, &alternatives, place, fail)
        PatternKind.TypeTest(_, _) => typeTest(l, c, p, pattern, place, ty, fail)
        PatternKind.At(_, _, inner) => {
            lowerPattern(l, c, p, &*inner, place, fail)   // binds nothing (E0502)
            bind(l, c, c.localAt(pattern.id.0), place, ty)
        }
    }
}

// The fat pointer to the `dyn I` value at `place`: the place's value, or
// the pointer field of a `Box<dyn I>`.
fn fatPointer(c: mut Checker, p: Program, place: &Place, ty: int) Operand {
    if boxesDyn(c, ty) {
        return placeOperand(&placeChild(place, 0), OperandKind.Copy, structFieldType(c, p, ty, 0))
    }
    return placeOperand(place, OperandKind.Copy, ty)
}

// The data pointer of the `dyn I` value at `place`, as a `*T`.
fn dataPointer(l: mut Lowerer, c: mut Checker, p: Program, place: &Place, ty: int,
               target: int) int {
    let cast = rvalue(RvalueKind.Cast, Op.Add, fatPointer(c, p, place, ty), opUnit(UNIT))
    const thin = c.types.ptr(target, true)
    cast.to = thin
    return emitTemp(l, thin, cast)
}

// `c: Circle` (spec 9.8): the type id in the vtable is that of `Circle`,
// whose value the binding takes from the data pointer.
fn typeTest(l: mut Lowerer, c: mut Checker, p: Program, pattern: &Pattern, place: &Place,
            ty: int, fail: int) {
    const target = concreteType(l, c, c.members[c.module()][pattern.id.0])
    const union = concreteType(l, c, ty)   // `Option<T> | int` in a generic body
    if unionMembers(c, union).len() > 0 {
        unionTest(l, c, p, pattern, place, union, target, fail)
        return
    }
    const id = emitTemp(l, I64, rvalue(RvalueKind.TypeId, Op.Add, fatPointer(c, p, place, ty),
                                       opUnit(UNIT)))
    const is = compare(l, c, p, Op.Eq, I64, opCopy(id, I64), opInt(target as u64, I64))
    test(l, is, fail)
    const local = c.localAt(pattern.id.0)
    if local >= 0 {
        const data = dataPointer(l, c, p, place, ty, target)
        bind(l, c, local, &Place{local: data, fields: [], deref: true}, target)
    }
}

// `e: IoError` on a union (spec 17.4): the tag is that of the member, whose
// value the binding takes. `e: (IoError | NetError)` takes any of the
// members and rebuilds the smaller union around it.
fn unionTest(l: mut Lowerer, c: mut Checker, p: Program, pattern: &Pattern, place: &Place,
             ty: int, target: int, fail: int) {
    const local = c.localAt(pattern.id.0)
    const tested = unionMembers(c, target)
    if tested.len() == 0 {
        const index = memberIndex(c, ty, target)
        const is = compare(l, c, p, Op.Eq, I32, tagOf(place), discriminant(c, p, ty, index))
        test(l, is, fail)
        if local >= 0 {
            bind(l, c, local, &placeChild(&placeChild(place, VARIANT_STEP + index), 0), target)
        }
        return
    }
    if local >= 0 && l.body.locals[local + 1].byRef {
        l.fail("a type test that borrows a union of members")
        return
    }
    const ok = l.body.newBlock()
    for k in 0..tested.len() {
        const next = if k + 1 < tested.len() { l.body.newBlock() } else { fail }
        const index = memberIndex(c, ty, tested[k])
        const is = compare(l, c, p, Op.Eq, I32, tagOf(place), discriminant(c, p, ty, index))
        test(l, is, next)
        if local >= 0 {
            const member = placeChild(&placeChild(place, VARIANT_STEP + index), 0)
            const value = placeOperand(&member, OperandKind.Copy, tested[k])
            const widened = variantValue(l, c, p, target, k, [value])
            emitStore(l, &localPlace(local + 1), widened)
        }
        emitGoto(l, ok)
        if k + 1 < tested.len() {
            switchTo(l, next)
        }
    }
    switchTo(l, ok)
}

/**
 * Whether a `match` or `if const` takes ownership of a `Box<dyn I>` it
 * matches: the box is then freed or dropped in each arm (spec 9.8).
 *
 * @param c the checker
 * @param scrutinee the matched value
 * @returns true if it does
 */
pub fn ownsBox(c: Checker, scrutinee: &Expr) bool {
    if !boxesDyn(c, c.typeOf(scrutinee.id.0)) {
        return false
    }
    return match c.moveFlags[c.module()].get(scrutinee.id.0) {
        Option.Some(f) => (*f & (MOVES | CONSUMED)) != 0
        Option.None => false
    }
}

/**
 * What is left of an owned `Box<dyn I>` once an arm matched: a type test
 * that took the value frees the memory; an arm that bound nothing drops
 * the box.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param pattern the arm's pattern, or `None` for an `else`
 * @param place the box
 * @param ty its type
 */
pub fn boxRest(l: mut Lowerer, c: mut Checker, p: Program, pattern: Option<&Pattern>,
               place: &Place, ty: int) {
    if const Option.Some(pat) = pattern {
        const tookValue = match pat.kind {
            PatternKind.TypeTest(_, _) => c.localAt(pat.id.0) >= 0
            _ => false
        }
        if tookValue {
            const data = dataPointer(l, c, p, place, ty, U8)
            emitRuntime(l, RuntimeFn.Free, [opCopy(data, c.types.ptr(U8, true))], -1)
            return
        }
        let locals: List<int> = []
        patternLocals(c, pat, locals)
        if locals.len() > 0 {
            return   // the binding owns the box
        }
    }
    emitDrop(l, c, p, place, ty)
}

fn isEnum(c: Checker, ty: int) bool {
    const t = c.types.get(ty)
    return t.kind == TyKind.Adt && c.def(t.data).kind == DefKind.Enum
}

/**
 * Whether the enum value at `place` is variant `index`: a bool.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param place the value
 * @param ty its enum type
 * @param index the variant
 * @returns the bool
 */
pub fn isVariant(l: mut Lowerer, c: mut Checker, p: Program, place: &Place, ty: int,
                 index: int) Operand {
    const tag = tagOf(place)
    return compare(l, c, p, Op.Eq, I32, tag, discriminant(c, p, ty, index))
}

fn variantTest(l: mut Lowerer, c: mut Checker, p: Program, pattern: &Pattern, place: &Place,
               ty: int, args: &List<Pattern>, fail: int) {
    const index = c.members[c.module()][pattern.id.0]
    const tag = tagOf(place)
    const is = compare(l, c, p, Op.Eq, I32, tag, discriminant(c, p, ty, index))
    test(l, is, fail)
    const payload = placeChild(place, VARIANT_STEP + index)
    lowerPatterns(l, c, p, args, &payload, fail)
}

// Sub-patterns of positional fields.
fn lowerPatterns(l: mut Lowerer, c: mut Checker, p: Program, list: &List<Pattern>,
                 base: &Place, fail: int) {
    for i in 0..list.len() {
        lowerPattern(l, c, p, &list[i], &placeChild(base, i), fail)
    }
}

// Whether a binding of `pattern` takes a part that needs dropping.
fn bindsOwned(l: mut Lowerer, c: mut Checker, p: Program, pattern: &Pattern) bool {
    return match pattern.kind {
        PatternKind.Binding(_, _) | PatternKind.At(_, _, _) => {
            c.localAt(pattern.id.0) >= 0 &&
                needsDrop(l, c, p, concreteType(l, c, c.typeOf(pattern.id.0)))
        }
        PatternKind.TypeTest(_, _) => c.localAt(pattern.id.0) >= 0
        PatternKind.Variant(_, _, args, _) | PatternKind.TupleStruct(_, args) |
        PatternKind.Tuple(args) | PatternKind.Or(args) => anyOwned(l, c, p, &args)
        PatternKind.Struct(_, fields, _) => fieldsOwned(l, c, p, &fields)
        _ => false
    }
}

fn fieldsOwned(l: mut Lowerer, c: mut Checker, p: Program, fields: &List<FieldPattern>) bool {
    for i in 0..fields.len() {
        const owned = match fields[i].pattern {
            Option.Some(inner) => bindsOwned(l, c, p, &inner)
            Option.None => {
                const ty = concreteType(l, c, c.typeOf(fields[i].id.0))
                needsDrop(l, c, p, ty)
            }
        }
        if owned {
            return true
        }
    }
    return false
}

fn anyOwned(l: mut Lowerer, c: mut Checker, p: Program, list: &List<Pattern>) bool {
    for i in 0..list.len() {
        if bindsOwned(l, c, p, &list[i]) {
            return true
        }
    }
    return false
}

/**
 * Makes `place` a temporary of the innermost full expression.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param place the value
 * @param ty its concrete type
 */
pub fn keepPlace(l: mut Lowerer, c: mut Checker, p: Program, place: &Place, ty: int) {
    if !needsDrop(l, c, p, ty) || l.tempScopes.len() == 0 || isGlue(l.body.def) {
        return
    }
    let local = place.local
    if place.fields.len() > 0 || place.deref {
        local = newTemp(l, ty)
        emitStore(l, &localPlace(local), placeOperand(place, OperandKind.Copy, ty))
    }
    l.temps.push(Temp{local: local, ty: ty})
}

fn keepList(l: mut Lowerer, c: mut Checker, p: Program, list: &List<Pattern>, base: &Place) {
    for i in 0..list.len() {
        keepUnbound(l, c, p, &list[i], &placeChild(base, i))
    }
}

fn keepFields(l: mut Lowerer, c: mut Checker, p: Program, fields: &List<FieldPattern>,
              place: &Place, ty: int) {
    const id = c.types.get(ty).data
    structFields(c, p, id)
    const names = fieldsOf(c, id).names.clone()
    for index in 0..names.len() {
        let field = -1
        for i in 0..fields.len() {
            if field < 0 && fields[i].name.0 == names[index].0 {
                field = i
            }
        }
        const at = placeChild(place, index)
        if field < 0 {
            const fty = concreteType(l, c, structFieldType(c, p, ty, index))
            keepPlace(l, c, p, &at, fty)
        } else if const Option.Some(inner) = fields[field].pattern {
            keepUnbound(l, c, p, &inner, &at)
        }
    }
}

/**
 * The parts of a consumed value that `pattern` does not move into its
 * bindings become temporaries, dropped with the innermost full
 * expression (spec 5.2). The parts left by an or-pattern whose
 * alternatives bind differently are not tracked.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param pattern the pattern, which matched
 * @param place the value
 */
pub fn keepUnbound(l: mut Lowerer, c: mut Checker, p: Program, pattern: &Pattern,
                   place: &Place) {
    const ty = concreteType(l, c, c.typeOf(pattern.id.0))
    if !bindsOwned(l, c, p, pattern) {
        keepPlace(l, c, p, place, ty)
        return
    }
    match pattern.kind {
        PatternKind.Variant(_, _, args, _) => keepVariant(l, c, p, pattern, &args, place)
        PatternKind.TupleStruct(_, args) => {
            if isEnum(c, ty) {
                keepVariant(l, c, p, pattern, &args, place)
            } else {
                keepList(l, c, p, &args, place)
            }
        }
        PatternKind.Tuple(items) => keepList(l, c, p, &items, place)
        PatternKind.Struct(_, fields, _) => keepFields(l, c, p, &fields, place, ty)
        _ => {}
    }
}

fn keepVariant(l: mut Lowerer, c: mut Checker, p: Program, pattern: &Pattern,
               args: &List<Pattern>, place: &Place) {
    const index = c.members[c.module()][pattern.id.0]
    keepList(l, c, p, args, &placeChild(place, VARIANT_STEP + index))
}

fn armValue(l: mut Lowerer, c: mut Checker, p: Program, body: &Expr, asValue: bool) Operand {
    return match body.kind {
        ExprKind.Block(block) | ExprKind.Unsafe(block) => lowerBlock(l, c, p, &block, asValue)
        _ => lowerTail(l, c, p, body)
    }
}

// Whether an arm binds a local that holds an address: the scrutinee, a
// borrowed place, is then matched where it is.
fn matchesInPlace(l: Lowerer, c: Checker, arms: &List<MatchArm>) bool {
    for i in 0..arms.len() {
        if bindsAddress(l, c, &arms[i].pattern) {
            return true
        }
    }
    return false
}

/**
 * `match value { arms }`.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param e the `match`
 * @returns its value
 */
pub fn lowerMatch(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr) Operand {
    const ty = c.typeOf(e.id.0)
    const asValue = typeIsValue(ty)
    const dest = if asValue { newTemp(l, ty) } else { 0 }
    match e.kind {
        ExprKind.Match(scrutinee, arms) => {
            const inPlace = matchesInPlace(l, c, &arms)
            const place = if inPlace {
                lowerPlace(l, c, p, &*scrutinee)
            } else {
                localPlace(toLocal(l, lowerExpr(l, c, p, &*scrutinee)))
            }
            const owned = ownsBox(c, &*scrutinee)
            const flags = match c.moveFlags[c.module()].get(scrutinee.id.0) {
                Option.Some(f) => *f
                Option.None => 0
            }
            const keep = !owned && (flags & (MOVES | CONSUMED)) != 0
            const boxType = c.typeOf(scrutinee.id.0)
            const join = l.body.newBlock()
            for i in 0..arms.len() {
                const next = l.body.newBlock()
                lowerPattern(l, c, p, &arms[i].pattern, &place, next)
                if const Option.Some(guard) = arms[i].guard {
                    tempScopeEnter(l)
                    const value = lowerExpr(l, c, p, &guard)
                    const gty = value.ty
                    const cond = opCopy(toLocal(l, value), gty)
                    tempScopeLeave(l, c, p)
                    test(l, cond, next)
                }
                tempScopeEnter(l)   // the rest of a consumed value ends with the arm
                if keep {
                    keepUnbound(l, c, p, &arms[i].pattern, &place)
                }
                dropScopeEnter(l)   // the arm's bindings own what they took
                ownBindings(l, c, p, &arms[i].pattern)
                if owned {
                    boxRest(l, c, p, Option.Some(&arms[i].pattern), &place, boxType)
                }
                const value = armValue(l, c, p, &arms[i].body, asValue)
                if asValue && value.kind != OperandKind.Unit {
                    emitStore(l, &localPlace(dest), value)
                }
                dropScopeLeave(l, c, p)
                tempScopeLeave(l, c, p)
                emitGoto(l, join)
                switchTo(l, next)
            }
            terminate(l, terminator(TermKind.Unreachable))   // the match is exhaustive
            switchTo(l, join)
        }
        _ => {}
    }
    return if asValue { opCopy(dest, ty) } else { opUnit(UNIT) }
}
