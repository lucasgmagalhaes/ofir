/** Where `break` and `continue` go in a loop. */
pub copy struct LoopTarget {
    /** The block after the loop. */
    pub breakTo: int
    /** The block `continue` goes to. */
    pub continueTo: int
    /** The drop scopes open outside the loop. */
    pub scopes: int
    /** The temporary scopes open outside the loop. */
    pub tempScopes: int
    /** The label of `name: for`. */
    pub label: Option<Symbol>
}

/** The drop flag of a part of a local that is moved out somewhere. */
pub struct PartFlag {
    /** The part; its `local` is the AIR local. */
    pub part: Part
    /** The flag. */
    pub flag: int
}

/** A temporary to drop at the end of its full expression. */
pub copy struct Temp {
    /** The local holding it. */
    pub local: int
    /** Its type. */
    pub ty: int
}

/** A place: a local and a field path. */
pub struct Place {
    /** The local. */
    pub local: int
    /** The fields from it. */
    pub fields: List<int>
    /** The local holds the address of the value. */
    pub deref: bool
}

/** A function to compile: not generic (targs `()`), an instance, or glue. */
pub copy struct Instance {
    /** The function's `DefId`, or 0 for glue. */
    pub def: int
    /** Its type arguments, a tuple; `()` if not generic. */
    pub targs: int
    /** `GLUE_DROP` or `GLUE_CLONE` when `def` is 0. */
    pub glue: int
}

/**
 * A `comptime` expression (spec 15.1): blocks `start` up to `after` of a
 * body compute its value into `dest`; the interpreter runs them and
 * replaces them with the constant (`air.interp`).
 */
pub struct ComptimeRegion {
    /** The body's function, as `AirBody.def`. */
    pub def: int
    /** The body's type arguments, as `AirBody.targs`. */
    pub targs: int
    /** The body's closure, or -1. */
    pub closure: int
    /** The first block of the expression. */
    pub start: int
    /** The block after it. */
    pub after: int
    /** The local that receives the value. */
    pub dest: int
    /** The budget of steps (`@comptimeBudget`). */
    pub budget: int
    /** The expression. */
    pub span: Span
}

/** The state of the lowering. */
pub struct Lowerer {
    /** The body being built. */
    pub body: AirBody
    /** Where the next statement goes. */
    pub block: int
    /** The open loops. */
    pub loops: List<LoopTarget>
    /** The functions reached by a call, in order. */
    pub pending: List<Instance>
    /** By `DefId`: a function that is not generic was reached. */
    pub reached: List<bool>
    /** The generic instances reached: `def * 2^32 + targs`. */
    pub instances: Map<int, bool>
    /** By instance, `def * 2^32 + targs`: the call that first reached it (E0814). */
    pub origins: Map<int, Span>
    /** The locals to drop at the end of their scope, in order. */
    pub owned: List<int>
    /** Per open block: its first entry in `owned`. */
    pub scopes: List<int>
    /** Per local of the function: its drop flag, or 0. */
    pub flags: List<int>
    /** Per AST local: it borrows a place (the move analysis). */
    pub borrowed: List<bool>
    /** The parts the move analysis saw moved out (AST locals). */
    pub movedParts: List<Part>
    /** The flags of the parts of this function's partially moved locals. */
    pub partFlags: List<PartFlag>
    /** By type: 0 unknown, 1 no drop, 2 drop, 3 computing. */
    pub dropCache: List<int>
    /** New values no one consumed, to drop. */
    pub temps: List<Temp>
    /** Per open full expression: its first temporary. */
    pub tempScopes: List<int>
    /** The next expression's value is the value of an `if`, `match` or block. */
    pub forward: bool
    /** E0331 was reported. */
    pub tooDeep: bool
    /** The function being lowered, or 0 for glue. */
    pub fnDef: int
    /** `strEq`, `strCmp` and `strConcat` of std/core/str.of: `==`, `<` and `+` on strings. */
    pub strEq: int
    pub strCmp: int
    pub strConcat: int
    /** `strPushStr` and `strPushBool` of std/core/str.of: `{t}` and `{b}` parts. */
    pub strPushStr: int
    pub strPushBool: int
    /** A construct stage 1 does not lower yet was met. */
    pub unsupported: bool
    /** What it was. */
    pub missing: str
    /** The bodies lowered. */
    pub out: List<AirBody>
    /** `ofir test`: the `@test` functions, by `DefId`. */
    pub tests: List<int>
    /** The `comptime` expressions lowered, in order. */
    pub comptimes: List<ComptimeRegion>

    /**
     * Notes a construct stage 1 does not lower yet.
     *
     * @param what the construct
     */
    pub fn fail(mut self, what: str) {
        if !self.unsupported {
            self.unsupported = true
            self.missing = what.toOwned()
        }
    }
}

// ---------------------------------------------------------------------------
// Building blocks and statements

/**
 * A new temporary.
 *
 * @param l the lowering
 * @param ty its type
 * @returns its local
 */
pub fn newTemp(l: mut Lowerer, ty: int) int {
    return l.body.newLocal(ty, Option.None, noSpan())
}

fn stmt(kind: StmtKind) AirStmt {
    return AirStmt{kind: kind, dest: 0, destPath: noPath(), hasDest: false,
                   value: rvUse(opUnit(UNIT)), runtime: false, rt: RuntimeFn.PrintStr, callee: 0,
                   targs: UNIT, args: [], span: noSpan()}
}

/**
 * `dest = value`.
 *
 * @param l the lowering
 * @param dest the local
 * @param value the value
 */
pub fn emitAssign(l: mut Lowerer, dest: int, value: move Rvalue) {
    let s = stmt(StmtKind.Assign)
    s.dest = dest
    s.hasDest = true
    s.value = value
    l.body.push(l.block, s)
}

/**
 * A new temporary holding a value.
 *
 * @param l the lowering
 * @param ty its type
 * @param value the value
 * @returns its local
 */
pub fn emitTemp(l: mut Lowerer, ty: int, value: move Rvalue) int {
    const temp = newTemp(l, ty)
    emitAssign(l, temp, value)
    return temp
}

/**
 * A call of a runtime function.
 *
 * @param l the lowering
 * @param f the function
 * @param args its arguments
 * @param dest the local receiving the result, or -1
 */
pub fn emitRuntime(l: mut Lowerer, f: RuntimeFn, args: move List<Operand>, dest: int) {
    if f == RuntimeFn.StrPushStr || f == RuntimeFn.StrPushBool {   // std/core/str.of
        let parts = args
        if f == RuntimeFn.StrPushStr {   // the part is passed by value
            parts[1].kind = OperandKind.Copy
        }
        const callee = if f == RuntimeFn.StrPushStr { l.strPushStr } else { l.strPushBool }
        emitCall(l, callee, UNIT, parts, dest)
        return
    }
    let s = stmt(StmtKind.Call)
    s.hasDest = dest >= 0
    s.dest = if dest >= 0 { dest } else { 0 }
    s.runtime = true
    s.rt = f
    s.args = args
    l.body.push(l.block, s)
}

/**
 * A call of a user function or of glue.
 *
 * @param l the lowering
 * @param callee its `DefId`, or a glue constant
 * @param targs its type arguments, a tuple, or ()
 * @param args its arguments
 * @param dest the local receiving the result, or -1
 */
pub fn emitCall(l: mut Lowerer, callee: int, targs: int, args: move List<Operand>, dest: int) {
    let s = stmt(StmtKind.Call)
    s.hasDest = dest >= 0
    s.dest = if dest >= 0 { dest } else { 0 }
    s.callee = callee
    s.targs = targs
    s.args = args
    l.body.push(l.block, s)
}

/**
 * Continues in `block`. The block left behind was opened by `terminate`
 * and nothing jumps to it: it ends as unreachable.
 *
 * @param l the lowering
 * @param block the block
 */
pub fn switchTo(l: mut Lowerer, block: int) {
    if l.body.blocks[l.block].term.kind == TermKind.None {
        l.body.blocks[l.block].term.kind = TermKind.Unreachable
    }
    l.block = block
}

/**
 * Ends the block and continues in a new one, unreachable until something
 * jumps there.
 *
 * @param l the lowering
 * @param t how the block ends
 */
pub fn terminate(l: mut Lowerer, t: move Terminator) {
    l.body.terminate(l.block, t)
    l.block = l.body.newBlock()
}

/**
 * `goto target`.
 *
 * @param l the lowering
 * @param target the block
 */
pub fn emitGoto(l: mut Lowerer, target: int) {
    terminate(l, jump(target))
}

/**
 * Panics with `panic` if `fails`, else continues in a new block.
 *
 * @param l the lowering
 * @param fails the condition
 * @param panic why
 * @param span where
 */
pub fn emitAssert(l: mut Lowerer, fails: move Operand, panic: PanicKind, span: Span) {
    const next = l.body.newBlock()
    let t = terminator(TermKind.Assert)
    t.cond = fails
    t.target = next
    t.panic = panic
    t.span = span
    l.body.terminate(l.block, t)
    l.block = next
}

/**
 * A local holding the operand: itself if it is a whole local.
 *
 * @param l the lowering
 * @param operand the operand
 * @returns the local
 */
pub fn toLocal(l: mut Lowerer, operand: move Operand) int {
    if operand.kind == OperandKind.Copy && operand.path.fields.len() == 0 && !operand.path.deref {
        return operand.local
    }
    const ty = operand.ty
    return emitTemp(l, ty, rvUse(operand))
}

/**
 * The operand of a place.
 *
 * @param place the place
 * @param kind `Copy` or `Addr`
 * @param ty the type of the value
 * @returns the operand
 */
pub fn placeOperand(place: &Place, kind: OperandKind, ty: int) Operand {
    let o = opCopy(place.local, ty)
    o.kind = kind
    o.path.fields = place.fields.clone()
    o.path.deref = place.deref
    return o
}

/**
 * The place of a whole local.
 *
 * @param local the local
 * @returns the place
 */
pub fn localPlace(local: int) Place {
    return Place{local: local, fields: [], deref: false}
}

/**
 * `place = value`.
 *
 * @param l the lowering
 * @param place the place
 * @param value the value
 */
pub fn emitStore(l: mut Lowerer, place: &Place, value: move Operand) {
    let s = stmt(StmtKind.Assign)
    s.dest = place.local
    s.destPath.fields = place.fields.clone()
    s.destPath.deref = place.deref
    s.hasDest = true
    s.value = rvUse(value)
    l.body.push(l.block, s)
}

// ---------------------------------------------------------------------------
// Drops (spec 5.2)

/**
 * A type with the instance's type arguments.
 *
 * @param l the lowering
 * @param c the checker
 * @param ty a type of the body
 * @returns the concrete type
 */
pub fn concreteType(l: Lowerer, c: mut Checker, ty: int) int {
    if isGlue(l.body.def) || l.body.targs == UNIT {
        return ty
    }
    const args = c.types.get(l.body.targs).args.clone()
    return substType(c, ty, args)
}

/**
 * The method `name` (with `self`) declared by a type, or 0.
 *
 * @param c the checker
 * @param p the program
 * @param ty the type
 * @param name the method
 * @returns its `DefId`, or 0
 */
pub fn typeMethod(c: Checker, p: Program, ty: int, name: str) int {
    const t = c.types.get(ty)
    let owner = 0
    if t.kind == TyKind.Adt {
        owner = t.data
    } else if ty < c.r.lang.len() {
        owner = c.r.lang[ty]
    }
    if owner == 0 || c.def(owner).item < 0 {
        return 0
    }
    const loc = c.loc(owner)
    for i in 0..methodCount(p, loc) {
        const decl = methodAt(p, loc, i)
        if decl.hasSelf && c.text(decl.name) == name {
            return c.r.tables[c.def(owner).module].fnDefs[decl.id.0]
        }
    }
    return 0
}

fn fieldsNeedDrop(l: mut Lowerer, c: mut Checker, p: Program, ty: int) bool {
    const t = c.types.get(ty)
    if t.kind == TyKind.Tuple {
        const args = t.args.clone()
        for i in 0..args.len() {
            if needsDrop(l, c, p, args[i]) {
                return true
            }
        }
        return false
    }
    if t.kind != TyKind.Adt {
        return false
    }
    const id = t.data
    if c.def(id).kind == DefKind.Struct {
        if !structFields(c, p, id) {
            return false
        }
        const count = fieldsOf(c, id).types.len()
        for i in 0..count {
            if needsDrop(l, c, p, structFieldType(c, p, ty, i)) {
                return true
            }
        }
        return false
    }
    if !enumVariants(c, p, id) {
        return false
    }
    const variants = variantsOf(c, id).variants.len()
    for v in 0..variants {
        const count = variantsOf(c, id).variants[v].types.len()
        for i in 0..count {
            if needsDrop(l, c, p, variantFieldType(c, p, ty, v, i)) {
                return true
            }
        }
    }
    return false
}

fn computeNeedsDrop(l: mut Lowerer, c: mut Checker, p: Program, ty: int) bool {
    const kind = c.types.kind(ty)
    if kind == TyKind.Ref || kind == TyKind.Ptr || kind == TyKind.Param || kind == TyKind.Int ||
       kind == TyKind.Float ||
       kind == TyKind.Bool {
        return false
    }
    if kind == TyKind.Fn {   // a `move fn` owns its environment
        return c.types.get(ty).data & FN_OWNED != 0
    }
    if kind == TyKind.Dyn {   // dropped through its vtable
        return true
    }
    return typeMethod(c, p, ty, "drop") != 0 || fieldsNeedDrop(l, c, p, ty)
}

/**
 * Whether dropping a value of a concrete type does something: it has a
 * `drop` method, or a field that needs drop.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param ty the type
 * @returns true if it does
 */
pub fn needsDrop(l: mut Lowerer, c: mut Checker, p: Program, ty: int) bool {
    for l.dropCache.len() <= ty {
        l.dropCache.push(0)
    }
    if l.dropCache[ty] == 0 {
        l.dropCache[ty] = 3   // in progress: no drop through itself
        // Computed first: the computation grows the cache, which moves its elements.
        const result = if computeNeedsDrop(l, c, p, ty) { 2 } else { 1 }
        l.dropCache[ty] = result
    }
    return l.dropCache[ty] == 2
}

/**
 * Drops the value at `place`, of the concrete type `ty`.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param place the place
 * @param ty its type
 */
pub fn emitDrop(l: mut Lowerer, c: mut Checker, p: Program, place: &Place, ty: int) {
    if !needsDrop(l, c, p, ty) {
        return
    }
    const arg = placeOperand(place, OperandKind.Addr, c.types.ref(ty, true))
    emitCall(l, GLUE_DROP, c.types.tuple([ty]), [arg], -1)
}

// ---------------------------------------------------------------------------
// Drop scopes and drop flags

/**
 * Opens a drop scope (a block).
 *
 * @param l the lowering
 */
pub fn dropScopeEnter(l: mut Lowerer) {
    l.scopes.push(l.owned.len())
}

fn localType(l: Lowerer, c: mut Checker, local: int) int {
    return concreteType(l, c, l.body.locals[local].ty)
}

fn samePath(a: &List<int>, b: &List<int>) bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// The flag of a part moved out somewhere, or 0.
fn partFlag(l: Lowerer, local: int, path: &List<int>) int {
    for i in 0..l.partFlags.len() {
        const part = &l.partFlags[i].part
        if part.local == local && samePath(&part.fields, path) {
            return l.partFlags[i].flag
        }
    }
    return 0
}

// Whether some moved part lies strictly inside `path`.
fn partInside(l: Lowerer, local: int, path: &List<int>) bool {
    for i in 0..l.partFlags.len() {
        const part = &l.partFlags[i].part
        if part.local == local && part.fields.len() > path.len() {
            let prefix = true
            for j in 0..path.len() {
                if part.fields[j] != path[j] {
                    prefix = false
                }
            }
            if prefix {
                return true
            }
        }
    }
    return false
}

// Branches on `flag`: the code emitted until `ifDone` runs only if set.
fn ifSet(l: mut Lowerer, flag: int) int {
    const then = l.body.newBlock()
    const next = l.body.newBlock()
    terminate(l, branch(opCopy(flag, BOOL), then, next))
    switchTo(l, then)
    return next
}

fn ifDone(l: mut Lowerer, next: int) {
    emitGoto(l, next)
    switchTo(l, next)
}

fn subPlace(place: &Place, field: int) Place {
    let fields = place.fields.clone()
    fields.push(field)
    return Place{local: place.local, fields: fields, deref: place.deref}
}

// Drops what is left of a partially moved value: each field, except the
// moved parts, whose flags decide.
fn dropRest(l: mut Lowerer, c: mut Checker, p: Program, local: int, path: &List<int>,
            place: &Place, ty: int) {
    const t = c.types.get(ty)
    const isTuple = t.kind == TyKind.Tuple
    const count = if isTuple { t.args.len() } else { fieldsOf(c, t.data).types.len() }
    for i in 0..count {
        if path.len() >= 7 {
            break
        }
        let here = path.clone()
        here.push(i)
        const field = if isTuple { c.types.get(ty).args[i] } else { structFieldType(c, p, ty, i) }
        const at = subPlace(place, i)
        const flag = partFlag(l, local, &here)
        if flag != 0 {
            const next = ifSet(l, flag)
            emitDrop(l, c, p, &at, field)
            ifDone(l, next)
        } else if partInside(l, local, &here) {
            dropRest(l, c, p, local, &here, &at, field)
        } else {
            emitDrop(l, c, p, &at, field)
        }
    }
}

// `if flag { drop(local) }`, part by part if parts may have been moved out.
fn dropIfSet(l: mut Lowerer, c: mut Checker, p: Program, local: int) {
    const next = ifSet(l, l.flags[local])
    const place = Place{local: local, fields: [], deref: l.body.locals[local].byRef}
    const empty: List<int> = []
    const ty = localType(l, c, local)
    if partInside(l, local, &empty) {
        dropRest(l, c, p, local, &empty, &place, ty)
    } else {
        emitDrop(l, c, p, &place, ty)
    }
    ifDone(l, next)
}

/**
 * Drops the locals owned by the scopes from `first` on, the latest first,
 * without closing the scopes: for the jumps that leave them.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param first the first scope
 */
pub fn dropScopes(l: mut Lowerer, c: mut Checker, p: Program, first: int) {
    if first >= l.scopes.len() {
        return
    }
    let i = l.owned.len()
    for i > l.scopes[first] {
        dropIfSet(l, c, p, l.owned[i - 1])
        i -= 1
    }
}

/**
 * Closes the innermost drop scope, dropping its locals.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 */
pub fn dropScopeLeave(l: mut Lowerer, c: mut Checker, p: Program) {
    dropScopes(l, c, p, l.scopes.len() - 1)
    const first = l.scopes[l.scopes.len() - 1]
    l.owned.truncate(first)
    const _ = l.scopes.pop()
}

fn setFlagOf(l: mut Lowerer, flag: int, value: bool) {
    emitAssign(l, flag, rvUse(opBool(value, BOOL)))
}

// Sets the local's flag and the flags of its parts: all have a value or none.
fn setFlag(l: mut Lowerer, local: int, value: bool) {
    setFlagOf(l, l.flags[local], value)
    for i in 0..l.partFlags.len() {
        if l.partFlags[i].part.local == local {
            setFlagOf(l, l.partFlags[i].flag, value)
        }
    }
}

// Whether no step of a path waits for a `comptime for` key.
fn resolved(fields: &List<int>) bool {
    for i in 0..fields.len() {
        if keyFieldType(fields[i]) >= 0 {
            return false
        }
    }
    return true
}

// Flags for the parts of `local` that the move analysis saw moved out.
pub fn flagParts(l: mut Lowerer, c: mut Checker, local: int) {
    for i in 0..l.movedParts.len() {
        const ast = l.movedParts[i].clone()
        const fields = concretePath(l, c, &ast.fields)
        if ast.local + 1 == local && resolved(&fields) && partFlag(l, local, &fields) == 0 {
            const part = Part{local: local, fields: fields}
            const flag = newTemp(l, BOOL)
            l.partFlags.push(PartFlag{part: part, flag: flag})
        }
    }
}

/**
 * The innermost scope owns `local`: it is dropped at the scope's end.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param local the AIR local
 * @param initialized whether it holds a value now
 */
pub fn ownLocal(l: mut Lowerer, c: mut Checker, p: Program, local: int, initialized: bool) {
    if local >= l.flags.len() || isGlue(l.body.def) ||
       !needsDrop(l, c, p, localType(l, c, local)) {
        return
    }
    if local > 0 && local - 1 < l.borrowed.len() && l.borrowed[local - 1] {
        return   // a `for` variable or a binding of a borrowed place
    }
    if l.flags[local] == 0 {
        l.flags[local] = newTemp(l, BOOL)
        flagParts(l, c, local)
    }
    setFlag(l, local, initialized)
    l.owned.push(local)
}

/**
 * The value of a local was moved out: its flag is cleared.
 *
 * @param l the lowering
 * @param local the AIR local
 */
pub fn dropMoved(l: mut Lowerer, local: int) {
    if local < l.flags.len() && l.flags[local] != 0 {
        setFlag(l, local, false)
    }
}

/**
 * Before `local = value`: the old value is dropped.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param local the AIR local
 */
pub fn dropBeforeAssign(l: mut Lowerer, c: mut Checker, p: Program, local: int) {
    if local < l.flags.len() && l.flags[local] != 0 {
        dropIfSet(l, c, p, local)
    }
}

/**
 * After `local = value`: the flag is set.
 *
 * @param l the lowering
 * @param local the AIR local
 */
pub fn assignDone(l: mut Lowerer, local: int) {
    if local < l.flags.len() && l.flags[local] != 0 {
        setFlag(l, local, true)
    }
}

/**
 * The value of a part is moved out: the flag of the part, or of the whole
 * local, is cleared.
 *
 * @param l the lowering
 * @param c the checker
 * @param local the AIR local
 * @param path the fields
 */
pub fn noteMoved(l: mut Lowerer, c: mut Checker, local: int, path: &List<int>) {
    const flag = if path.len() > 0 { partFlag(l, local, &concretePath(l, c, path)) } else { 0 }
    if flag != 0 {
        setFlagOf(l, flag, false)
    } else {
        dropMoved(l, local)
    }
}

/**
 * `p.a = v` for a part that may have been moved out: dropped only if its
 * flag is set, which the assignment then sets.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param local the AIR local of the target
 * @param path its fields
 * @param place the target's place
 * @param ty its type
 * @returns false if the part has no flag
 */
pub fn assignPart(l: mut Lowerer, c: mut Checker, p: Program, local: int, path: &List<int>,
                  place: &Place, ty: int) bool {
    if path.len() == 0 {
        return false
    }
    const flag = partFlag(l, local, &concretePath(l, c, path))
    if flag == 0 {
        return false
    }
    const next = ifSet(l, flag)
    emitDrop(l, c, p, place, ty)
    ifDone(l, next)
    setFlagOf(l, flag, true)
    return true
}

/**
 * Opens a full expression: its temporaries are dropped at its end.
 *
 * @param l the lowering
 */
pub fn tempScopeEnter(l: mut Lowerer) {
    l.tempScopes.push(l.temps.len())
}

/**
 * Drops the temporaries of the full expressions from `first` on: for the
 * jumps that leave them.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param first the first scope
 */
pub fn dropTemps(l: mut Lowerer, c: mut Checker, p: Program, first: int) {
    if first >= l.tempScopes.len() {
        return
    }
    let i = l.temps.len()
    for i > l.tempScopes[first] {
        const t = l.temps[i - 1]
        emitDrop(l, c, p, &localPlace(t.local), t.ty)
        i -= 1
    }
}

/**
 * Closes the innermost full expression, dropping its temporaries.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 */
pub fn tempScopeLeave(l: mut Lowerer, c: mut Checker, p: Program) {
    dropTemps(l, c, p, l.tempScopes.len() - 1)
    const first = l.tempScopes[l.tempScopes.len() - 1]
    l.temps.truncate(first)
    const _ = l.tempScopes.pop()
}

// ---------------------------------------------------------------------------
// Functions

/**
 * Whether parameter `index` of a function (-1 for `self`) is passed by
 * address: a `mut` parameter, the borrowed value a returned reference
 * points into, or a borrowed value with interior mutability.
 *
 * @param c the checker
 * @param p the program
 * @param id the function's `DefId`
 * @param index the parameter
 * @returns true if it is
 */
pub fn byAddress(c: Checker, p: Program, id: int, index: int) bool {
    const decl = fnOf(p, c.loc(id))
    const mode = if index < 0 { decl.selfMode } else { decl.params[index].mode }
    const info = &c.info[id]
    const dynParam = index >= 0 && match decl.params[index].ty.kind {
        TypeKind.Dyn(_) => true   // `s: mut dyn I` is a `&mut dyn I` already
        _ => false
    }
    return (mode == Mode.Mut && !dynParam) || (info.returnsBorrow && info.sourceByRef &&
                                info.borrowSource == index) ||
           info.cellParams & (1 << (index + 1)) != 0
}

// Bindings and `for` variables that borrow a value with interior
// mutability hold its address, so that changes through them reach it
// (spec 5.8); parameters follow `byAddress`.
fn markCellBindings(l: mut Lowerer, c: mut Checker, p: Program, decl: &FnDecl) {
    let params: List<bool> = List.filled(false, l.borrowed.len())
    if decl.hasSelf && params.len() > 0 {
        params[0] = true
    }
    for i in 0..decl.params.len() {
        const local = c.localAt(decl.params[i].id.0)
        if local >= 0 && local < params.len() {
            params[local] = true
        }
    }
    for i in 0..l.borrowed.len() {
        if l.borrowed[i] && !params[i] && i + 1 < l.body.locals.len() {
            const ty = localType(l, c, i + 1)
            if hasInteriorMutability(c, p, ty) {
                l.body.locals[i + 1].byRef = true
            }
        }
    }
}

/**
 * Assigns a binding the value at `place`, or its address when the binding
 * holds one (`markCellBindings`).
 *
 * @param l the lowering
 * @param c the checker
 * @param local the AIR local
 * @param place the value
 * @param ty its type
 */
pub fn bindPlace(l: mut Lowerer, c: mut Checker, local: int, place: &Place, ty: int) {
    if l.body.locals[local].byRef {
        const address = placeOperand(place, OperandKind.Addr, c.types.ref(ty, false))
        emitStore(l, &localPlace(local), address)
        return
    }
    emitStore(l, &localPlace(local), placeOperand(place, OperandKind.Copy, ty))
}

/**
 * Whether a pattern binds a local that holds an address
 * (`markCellBindings`): its value must then be matched in place.
 *
 * @param l the lowering
 * @param c the checker
 * @param pattern the pattern
 * @returns true if it does
 */
pub fn bindsAddress(l: Lowerer, c: Checker, pattern: &Pattern) bool {
    let locals: List<int> = []
    patternLocals(c, pattern, locals)
    for i in 0..locals.len() {
        if locals[i] >= 0 && l.body.locals[locals[i] + 1].byRef {
            return true
        }
    }
    return false
}

const DEPTH_LIMIT: int = 64   // spec 8.6

/**
 * Queues a function with its type arguments to be lowered: only the
 * functions reachable from the roots are.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param id the function's `DefId`
 * @param targs its type arguments, a tuple, `()` if it is not generic
 */
pub fn reach(l: mut Lowerer, c: mut Checker, p: Program, id: int, targs: int) {
    const decl = fnOf(p, c.loc(id))
    if decl.body.isNone() {
        return
    }
    if targs == UNIT {   // not generic: a flag per DefId is enough
        for l.reached.len() <= id {
            l.reached.push(false)
        }
        if l.reached[id] {
            return
        }
        l.reached[id] = true
    } else {
        const key = id * 4294967296 + targs
        if l.instances.get(key).isSome() {
            return
        }
        l.instances.insert(key, true)
        if c.types.depth(targs) > DEPTH_LIMIT + 1 {   // + 1: the tuple
            if !l.tooDeep {
                c.error("E0331", decl.span, "instantiating `{c.text(decl.name)}` nests types "
                        + "more than {DEPTH_LIMIT} levels deep: does it call itself with a "
                        + "larger type?")
            }
            l.tooDeep = true
            return
        }
    }
    l.pending.push(Instance{def: id, targs: targs, glue: 0})
}

fn reachGlue(l: mut Lowerer, glue: int, targs: int) {
    const key = glue * 4294967296 + targs
    if l.instances.get(key).isSome() {
        return
    }
    l.instances.insert(key, true)
    l.pending.push(Instance{def: 0, targs: targs, glue: glue})
}

fn substOperand(c: mut Checker, o: mut Operand, args: &List<int>) {
    o.ty = substType(c, o.ty, args.clone())
    substPath(c, o.path, args)
}

fn substPath(c: mut Checker, path: mut FieldPath, args: &List<int>) {
    resolveKeys(c, path.fields, args)
}

// The fields of `value[key]` chosen for an instance (spec 16.2).
fn resolveKeys(c: mut Checker, fields: mut List<int>, args: &List<int>) {
    for i in 0..fields.len() {
        const index = keyFieldType(fields[i])
        if index >= 0 {
            const base = substType(c, c.types.get(index).inner, args.clone())
            const key = substType(c, c.types.get(index).args[0], args.clone())
            if !c.types.get(key).hasParam {   // a `comptime for` key: per iteration
                fields[i] = c.types.keyPosition(base, key)
            }
        }
    }
}

// A path of this instance, with the fields of its `value[key]` steps.
fn concretePath(l: Lowerer, c: mut Checker, path: &List<int>) List<int> {
    let fields = path.clone()
    if !isGlue(l.body.def) && l.body.targs != UNIT {
        const args = c.types.get(l.body.targs).args.clone()
        resolveKeys(c, fields, &args)
    }
    return fields
}

// The body of an instance of a generic function, with its type arguments.
fn substBody(l: mut Lowerer, c: mut Checker) {
    const args = c.types.get(l.body.targs).args.clone()
    substFrom(l, c, &args, AirRange{local: 0, block: 0, open: -1, stmt: 0})
}

/** What a body gained since some point: locals, blocks and statements of the open block. */
pub copy struct AirRange {
    /** The first new local. */
    pub local: int
    /** The first new block. */
    pub block: int
    /** The block open at that point, or -1. */
    pub open: int
    /** Its first new statement. */
    pub stmt: int
}

/**
 * The range of what the body gains from now on.
 *
 * @param l the lowering
 * @returns the range
 */
pub fn airRangeNow(l: Lowerer) AirRange {
    return AirRange{local: l.body.locals.len(), block: l.body.blocks.len(), open: l.block,
                    stmt: l.body.blocks[l.block].stmts.len()}
}

/**
 * Substitutes type arguments into what a body gained (a `comptime for`
 * iteration, or the whole body).
 *
 * @param l the lowering
 * @param c the checker
 * @param args the type arguments
 * @param range what to substitute
 */
pub fn substFrom(l: mut Lowerer, c: mut Checker, args: &List<int>, range: AirRange) {
    for i in range.local..l.body.locals.len() {
        l.body.locals[i].ty = substType(c, l.body.locals[i].ty, args.clone())
    }
    if range.open >= 0 {
        substBlock(l, c, args, range.open, range.stmt)
    }
    for b in range.block..l.body.blocks.len() {
        substBlock(l, c, args, b, 0)
    }
}

fn substBlock(l: mut Lowerer, c: mut Checker, args: &List<int>, b: int, first: int) {
    for i in first..l.body.blocks[b].stmts.len() {
        const s = &mut l.body.blocks[b].stmts[i]
        substPath(c, s.destPath, args)
        if s.kind == StmtKind.Assign {
            substOperand(c, s.value.a, args)
            substOperand(c, s.value.b, args)
            s.value.to = substType(c, s.value.to, args.clone())
            for k in 0..s.value.items.len() {
                substOperand(c, s.value.items[k], args)
            }
        } else {
            for k in 0..s.args.len() {
                substOperand(c, s.args[k], args)
            }
            s.targs = substType(c, s.targs, args.clone())
        }
    }
    substOperand(c, l.body.blocks[b].term.cond, args)
    substOperand(c, l.body.blocks[b].term.index, args)
    substOperand(c, l.body.blocks[b].term.len, args)
}

// Substitutes an instance's type arguments into its lowered body, then
// reaches the functions it calls.
pub fn monoBody(l: mut Lowerer, c: mut Checker, p: Program) {
    if l.body.targs != UNIT && !isGlue(l.body.def) {
        substBody(l, c)
    }
    for i in 0..l.body.locals.len() {
        if c.types.get(l.body.locals[i].ty).hasParam {
            l.body.locals[i].ty = UNIT   // of a `comptime for` the instance does not keep
        }
    }
    for b in 0..l.body.blocks.len() {
        for i in 0..l.body.blocks[b].stmts.len() {
            const s = &l.body.blocks[b].stmts[i]
            if s.kind == StmtKind.Call && !s.runtime {
                const callee = s.callee
                const targs = s.targs
                if isGlue(callee) {
                    reachGlue(l, callee, targs)
                } else if callee != CALL_VALUE {
                    if targs != UNIT && l.origins.get(callee * 4294967296 + targs).isNone() {
                        const span = s.span
                        l.origins.insert(callee * 4294967296 + targs, span)
                    }
                    reach(l, c, p, callee, targs)
                }
            } else if s.kind == StmtKind.Assign && s.value.kind == RvalueKind.FnValue {
                const fnDef = s.value.flag
                reach(l, c, p, fnDef, UNIT)
            } else if s.kind == StmtKind.Assign && s.value.kind == RvalueKind.Unsize {
                const concrete = s.value.b.ty
                const iface = c.types.get(dynObject(c, s.value.to)).data
                const slots = dynMethods(c, p, iface)
                for k in 0..slots.len() {
                    if isAnyMethod(c, slots[k]) {
                        continue   // `typeName`: the compiler provides it
                    }
                    const target = dynSlotTarget(c, p, concrete, slots[k])
                    reach(l, c, p, target.def, target.targs)
                }
                const drops = needsDrop(l, c, p, concrete)
                if drops {
                    reachGlue(l, GLUE_DROP, c.types.tuple([concrete]))
                }
                l.body.blocks[b].stmts[i].value.flag = if drops { 1 } else { 0 }
            }
        }
    }
}

/**
 * The `dyn I` that a fat pointer or a `Box<dyn I>` points to.
 *
 * @param c the checker
 * @param ty `&dyn I`, `*dyn I` or `Box<dyn I>`
 * @returns the `dyn I` type
 */
pub fn dynObject(c: Checker, ty: int) int {
    return match boxInner(c, ty) {
        Option.Some(inner) => inner
        Option.None => c.types.get(ty).inner
    }
}

/**
 * The function a vtable slot calls for a concrete type: the type's own
 * method, or the interface's default method for that `Self`.
 *
 * @param c the checker
 * @param p the program
 * @param ty the concrete type
 * @param id the interface method's `DefId`
 * @returns the function and its type arguments
 */
pub fn dynSlotTarget(c: mut Checker, p: Program, ty: int, id: int) Instance {
    const found = typeMethod(c, p, ty, c.text(c.def(id).name))
    if found != 0 {
        return Instance{def: found, targs: methodTargs(c, ty), glue: 0}
    }
    return Instance{def: id, targs: c.types.tuple([ty]), glue: 0}
}

fn isMainFn(c: Checker, p: Program, id: int) bool {
    const def = c.def(id)
    if c.r.testing || def.module != 0 || def.item < 0 || def.member >= 0 {
        return false
    }
    const isFn = match itemOf(p, c.loc(id)).kind {
        ItemKind.Fn(_) => true
        _ => false
    }
    return isFn && c.text(def.name) == "main"
}

// The function's scope owns its `move` parameters (spec 5.3).
fn ownParams(l: mut Lowerer, c: mut Checker, p: Program, id: int, localCount: int) {
    const decl = fnOf(p, c.loc(id))
    l.flags = List.filled(0, localCount + 1)
    l.partFlags = []
    l.owned = []
    l.scopes = []
    l.temps = []
    l.tempScopes = []
    l.forward = false
    match c.fnMoves.get(id) {
        Option.Some(found) => {
            l.borrowed = found.borrowed.clone()
            l.movedParts = found.parts.clone()
        }
        Option.None => {
            l.borrowed = []
            l.movedParts = []
        }
    }
    dropScopeEnter(l)
    if decl.hasSelf && decl.selfMode == Mode.Move {
        ownLocal(l, c, p, 1, true)
    }
    for i in 0..decl.params.len() {
        if decl.params[i].mode == Mode.Move {
            ownLocal(l, c, p, c.localAt(decl.params[i].id.0) + 1, true)
        }
    }
}

fn lowerFn(l: mut Lowerer, c: mut Checker, p: Program, inst: Instance) {
    const id = inst.def
    const decl = fnOf(p, c.loc(id))
    const module = c.def(id).module
    if moduleInStd(p, module) {
        checkLate(c, p, id)   // a std body is checked when it is reached
    }
    const sig = c.info[id].ty
    let body = AirBody{def: id, targs: inst.targs, name: decl.name, isMain: isMainFn(c, p, id),
                       paramCount: decl.params.len() + if decl.hasSelf { 1 } else { 0 },
                       locals: [], blocks: [],
                       closure: Option.None, span: decl.span, at: decl.span}
    body.newLocal(c.types.get(sig).inner, Option.None, decl.span)   // the return value
    const locals: List<Local> = match c.r.tables[module].fnLocals.get(decl.id.0) {
        Option.Some(list) => list.clone()
        Option.None => []
    }
    const types: List<int> = match c.localTypesOf[module].get(decl.id.0) {
        Option.Some(list) => list.clone()
        Option.None => []
    }
    for i in 0..locals.len() {
        body.newLocal(types[i], Option.Some(locals[i].name), locals[i].span)
    }
    // `mut self`, `mut` parameters and the source of a returned borrow are
    // passed by address (spec 5.3, 5.6).
    if decl.hasSelf && byAddress(c, p, id, -1) {
        body.locals[1].byRef = true
        body.locals[1].exclusive = decl.selfMode == Mode.Mut
    }
    for i in 0..decl.params.len() {
        if byAddress(c, p, id, i) {
            const local = c.localAt(decl.params[i].id.0) + 1
            body.locals[local].byRef = true
            body.locals[local].exclusive = decl.params[i].mode == Mode.Mut
        }
    }
    l.body = body
    l.fnDef = id
    l.block = l.body.newBlock()
    ownParams(l, c, p, id, locals.len())
    markCellBindings(l, c, p, decl)
    match decl.body {
        Option.Some(block) => {
            const _ = lowerBlock(l, c, p, &block, false)
            l.body.at = closingBrace(&block)
        }
        Option.None => {}
    }
    // Falling off the end returns (); other functions were checked to return.
    const end = if c.types.get(sig).inner == UNIT { TermKind.Return } else { TermKind.Unreachable }
    dropScopeLeave(l, c, p)   // the `move` parameters
    l.body.terminate(l.block, terminator(end))
    monoBody(l, c, p)
    l.out.push(mem.replace(l.body, emptyBody()))
}

pub fn emptyBody() AirBody {
    return AirBody{def: 0, targs: UNIT, name: Symbol(0), isMain: false, paramCount: 0,
                   locals: [], blocks: [],
                   closure: Option.None, span: noSpan(), at: noSpan()}
}

// ---------------------------------------------------------------------------
// Drop glue

/**
 * The type arguments of a method of `ty`: those of the type.
 *
 * @param c the checker
 * @param ty the type
 * @returns a tuple, or ()
 */
pub fn methodTargs(c: mut Checker, ty: int) int {
    const t = c.types.get(ty)
    if t.kind != TyKind.Adt {
        return UNIT
    }
    const args = t.args.clone()
    return c.types.tuple(args)
}

pub fn fieldPlace(base: &Place, step: int, field: int) Place {
    let fields = base.fields.clone()
    if step != 0 {
        fields.push(step)
    }
    fields.push(field)
    return Place{local: base.local, fields: fields, deref: base.deref}
}

// Drops the fields of the active variant of an enum.
fn dropVariants(l: mut Lowerer, c: mut Checker, p: Program, value: &Place, ty: int) {
    const id = c.types.get(ty).data
    enumVariants(c, p, id)
    const count = variantsOf(c, id).variants.len()
    for v in 0..count {
        const fields = variantsOf(c, id).variants[v].types.len()
        let any = false
        for i in 0..fields {
            any = any || needsDrop(l, c, p, variantFieldType(c, p, ty, v, i))
        }
        if !any {
            continue
        }
        const drop = l.body.newBlock()
        const next = l.body.newBlock()
        const is = isVariant(l, c, p, value, ty, v)
        terminate(l, branch(is, drop, next))
        switchTo(l, drop)
        for i in 0..fields {
            emitDrop(l, c, p, &fieldPlace(value, VARIANT_STEP + v, i),
                     variantFieldType(c, p, ty, v, i))
        }
        emitGoto(l, next)
        switchTo(l, next)
    }
}

// The body of `drop<T>(p)`: T's `drop` method, then its fields.
fn glueBody(l: mut Lowerer, c: mut Checker, p: Program, ty: int) {
    const value = Place{local: 1, fields: [], deref: true}
    const method = typeMethod(c, p, ty, "drop")
    if method != 0 {
        const targs = methodTargs(c, ty)
        const selfRef = c.types.ref(ty, true)
        emitCall(l, method, targs, [opCopy(1, selfRef)], -1)
    }
    const t = c.types.get(ty)
    const isStruct = t.kind == TyKind.Adt && c.def(t.data).kind == DefKind.Struct
    if t.kind == TyKind.Tuple || isStruct {
        const count = if t.kind == TyKind.Tuple {
            t.args.len()
        } else {
            fieldsOf(c, t.data).types.len()
        }
        for i in 0..count {
            const field = if c.types.kind(ty) == TyKind.Tuple { c.types.get(ty).args[i] } else {
                structFieldType(c, p, ty, i)
            }
            emitDrop(l, c, p, &fieldPlace(&value, 0, i), field)
        }
    } else if t.kind == TyKind.Adt {
        dropVariants(l, c, p, &value, ty)
    }
}

fn lowerGlue(l: mut Lowerer, c: mut Checker, p: Program, targs: int) {
    const ty = c.types.get(targs).args[0]
    l.body = AirBody{def: GLUE_DROP, targs: targs, name: Symbol(0), isMain: false,
                     paramCount: 1, locals: [], blocks: [],
                     closure: Option.None, span: noSpan(), at: noSpan()}
    l.body.newLocal(UNIT, Option.None, noSpan())
    l.body.newLocal(c.types.ref(ty, true), Option.None, noSpan())
    l.fnDef = 0
    l.flags = []
    l.block = l.body.newBlock()
    glueBody(l, c, p, ty)
    l.body.terminate(l.block, terminator(TermKind.Return))
    monoBody(l, c, p)
    l.out.push(mem.replace(l.body, emptyBody()))
}

// ---------------------------------------------------------------------------
// Clone glue: `clone<T>(value: T) T` for the types without a `clone` method

fn clonePart(l: mut Lowerer, c: mut Checker, p: Program, place: &Place, ty: int) Operand {
    return cloneValue(l, c, p, placeOperand(place, OperandKind.Copy, ty), ty)
}

fn cloneFields(l: mut Lowerer, c: mut Checker, p: Program, ty: int) {
    const isTuple = c.types.kind(ty) == TyKind.Tuple
    const count = if isTuple { c.types.get(ty).args.len() } else {
        fieldsOf(c, c.types.get(ty).data).types.len()
    }
    let items: List<Operand> = []
    for i in 0..count {
        const field = if isTuple { c.types.get(ty).args[i] } else { structFieldType(c, p, ty, i) }
        items.push(clonePart(l, c, p, &Place{local: 1, fields: [i], deref: false}, field))
    }
    let rv = rvUse(opUnit(UNIT))
    rv.kind = RvalueKind.Aggregate
    rv.items = items
    emitAssign(l, 0, rv)
}

fn cloneVariants(l: mut Lowerer, c: mut Checker, p: Program, ty: int) {
    const id = c.types.get(ty).data
    enumVariants(c, p, id)
    const value = localPlace(1)
    const join = l.body.newBlock()
    const count = variantsOf(c, id).variants.len()
    for v in 0..count {
        const build = l.body.newBlock()
        const next = l.body.newBlock()
        const is = isVariant(l, c, p, &value, ty, v)
        terminate(l, branch(is, build, next))
        switchTo(l, build)
        const fieldCount = variantsOf(c, id).variants[v].types.len()
        let fields: List<Operand> = []
        for i in 0..fieldCount {
            const at = fieldPlace(&value, VARIANT_STEP + v, i)
            fields.push(clonePart(l, c, p, &at, variantFieldType(c, p, ty, v, i)))
        }
        emitAssign(l, 0, rvUse(variantValue(l, c, p, ty, v, fields)))
        emitGoto(l, join)
        switchTo(l, next)
    }
    terminate(l, terminator(TermKind.Unreachable))
    switchTo(l, join)
}

fn lowerCloneGlue(l: mut Lowerer, c: mut Checker, p: Program, targs: int) {
    const ty = c.types.get(targs).args[0]
    l.body = AirBody{def: GLUE_CLONE, targs: targs, name: Symbol(0), isMain: false,
                     paramCount: 1, locals: [], blocks: [],
                     closure: Option.None, span: noSpan(), at: noSpan()}
    l.body.newLocal(ty, Option.None, noSpan())
    l.body.newLocal(ty, Option.None, noSpan())
    l.fnDef = 0
    l.flags = []
    l.block = l.body.newBlock()
    const method = typeMethod(c, p, ty, "clone")
    const t = c.types.get(ty)
    const isStruct = t.kind == TyKind.Adt && c.def(t.data).kind == DefKind.Struct
    if method != 0 {
        emitCall(l, method, methodTargs(c, ty), [opCopy(1, ty)], 0)
    } else if t.kind == TyKind.Tuple || isStruct {
        cloneFields(l, c, p, ty)
    } else {
        cloneVariants(l, c, p, ty)
    }
    l.body.terminate(l.block, terminator(TermKind.Return))
    monoBody(l, c, p)
    l.out.push(mem.replace(l.body, emptyBody()))
}

// ---------------------------------------------------------------------------
// `ofir test` (stage 0: lower_test.c)

// The `@test` functions of a module that this build compiles.
fn findTests(l: mut Lowerer, c: mut Checker, p: Program, m: int) {
    const items = &p.modules[m].module.items
    for i in 0..items.len() {
        if const ItemKind.Fn(decl) = items[i].kind {
            const attribute = if c.r.benching { "bench" } else { "test" }
            const test = findAttribute(c.r, items[i].attributes, attribute).isSome()
            if decl.body.isSome() && test && !skippedTest(c, p, &items[i]) {
                l.tests.push(c.r.tables[m].fnDefs[decl.id.0])
            }
        }
    }
}

// The entry point of `ofir test` and `ofir bench`: it calls the test (or
// benchmark) the runtime was asked for (`ofir_test_index`).
fn lowerTestMain(l: mut Lowerer, c: mut Checker, p: Program) {
    l.body = AirBody{def: GLUE_DROP, targs: UNIT, name: Symbol(0), isMain: true, paramCount: 0,
                     locals: [], blocks: [],
                     closure: Option.None, span: noSpan(), at: noSpan()}
    l.body.newLocal(UNIT, Option.None, noSpan())
    l.fnDef = 0
    l.flags = []
    l.block = l.body.newBlock()
    const index = newTemp(l, I64)
    emitRuntime(l, RuntimeFn.TestIndex, [], index)
    const done = l.body.newBlock()
    for k in 0..l.tests.len() {
        const test = rvalue(RvalueKind.Binary, Op.Eq, opCopy(index, I64), opInt(k as u64, I64))
        const chosen = emitTemp(l, BOOL, test)
        const run = l.body.newBlock()
        const next = l.body.newBlock()
        terminate(l, branch(opCopy(chosen, BOOL), run, next))
        switchTo(l, run)
        if c.r.benching {   // `bench(&mut startBench())`
            const start = stdFn(c, p, "std.testing", "startBench")
            const ty = c.types.get(fnSignature(c, p, start)).inner
            const bencher = newTemp(l, ty)
            emitCall(l, start, UNIT, [], bencher)
            emitCall(l, l.tests[k], UNIT, [opAddr(bencher, ty)], -1)
        } else {
            emitCall(l, l.tests[k], UNIT, [], -1)
        }
        emitGoto(l, done)
        switchTo(l, next)
    }
    emitGoto(l, done)
    switchTo(l, done)
    l.body.terminate(l.block, terminator(TermKind.Return))
    monoBody(l, c, p)
    l.out.push(mem.replace(l.body, emptyBody()))
}

// The root module must declare `fn main()`.
fn checkMain(c: mut Checker, p: Program) {
    let id = 0
    if const Option.Some(name) = c.r.names.find("main") {
        id = c.r.scope.moduleIn(0, name)
    }
    let ok = id > 0 && c.def(id).kind == DefKind.Fn && c.def(id).module == 0
    if ok {
        ok = fnOf(p, c.loc(id)).body.isSome()
    }
    if !ok {
        const file = p.modules[0].module.file
        c.error("E0203", Span{file: file, start: 0, end: 0},
                "the program has no `main` function".toOwned())
        return
    }
    const decl = fnOf(p, c.loc(id))
    if decl.params.len() > 0 || decl.ret.isSome() {
        c.error("E0203", c.def(id).span, "`main` takes no parameters and returns nothing: "
                + "`fn main() \{ ... \}`")
    }
}

// The roots: `main` and the `extern "C" fn` functions, which C may call.
fn findRoots(l: mut Lowerer, c: mut Checker, p: Program, m: int) {
    const items = &p.modules[m].module.items
    for i in 0..items.len() {
        match items[i].kind {
            ItemKind.Fn(decl) => {
                const id = c.r.tables[m].fnDefs[decl.id.0]
                const isMain = !c.r.testing && m == 0 && c.text(decl.name) == "main"
                if id != 0 && decl.body.isSome() && (isMain || decl.abi.len() > 0) {
                    reach(l, c, p, id, UNIT)
                }
            }
            _ => {}
        }
    }
}

/**
 * Lowers the functions reachable from the roots, in the order they are
 * reached, so that the output is deterministic.
 *
 * @param c the checker, after a check without errors
 * @param p the program
 * @returns the lowering, with the bodies or `unsupported`
 */
pub fn lowerProgram(c: mut Checker, p: Program) Lowerer {
    let l = Lowerer{body: emptyBody(), block: 0, loops: [], pending: [], reached: [],
                    instances: Map.new(), origins: Map.new(), owned: [], scopes: [], flags: [],
                    borrowed: [],
                    movedParts: [], partFlags: [], dropCache: [], temps: [], tempScopes: [],
                    forward: false, tooDeep: false, fnDef: 0,
                    strEq: stdFn(c, p, "std.core.str", "strEq"),
                    strCmp: stdFn(c, p, "std.core.str", "strCmp"),
                    strConcat: stdFn(c, p, "std.core.str", "strConcat"),
                    strPushStr: stdFn(c, p, "std.core.str", "strPushStr"),
                    strPushBool: stdFn(c, p, "std.core.str", "strPushBool"), unsupported: false,
                    missing: "", out: [], tests: [], comptimes: []}
    if !c.r.testing {
        checkMain(c, p)
    }
    for m in 0..p.modules.len() {
        c.enter(m)
        findRoots(l, c, p, m)
        if c.r.testing {
            findTests(l, c, p, m)
        }
    }
    if c.r.testing {
        c.enter(0)
        lowerTestMain(l, c, p)
    }
    let next = 0
    for next < l.pending.len() && !l.unsupported {
        const inst = l.pending[next]
        next += 1
        if inst.def == 0 {
            c.enter(0)
            if inst.glue == GLUE_DROP {
                lowerGlue(l, c, p, inst.targs)
            } else if inst.glue == GLUE_CLONE {
                lowerCloneGlue(l, c, p, inst.targs)
            } else if inst.glue == GLUE_EQ {
                lowerEqGlue(l, c, p, inst.targs)
            } else if inst.glue == GLUE_HASH {
                lowerHashGlue(l, c, p, inst.targs)
            } else if inst.glue == GLUE_DEBUG {
                lowerDebugGlue(l, c, p, inst.targs)
            } else {
                lowerCmpGlue(l, c, p, inst.targs)
            }
            continue
        }
        c.enter(c.def(inst.def).module)
        lowerFn(l, c, p, inst)
    }
    c.enter(0)
    return l
}
